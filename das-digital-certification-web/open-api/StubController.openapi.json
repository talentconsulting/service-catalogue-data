{
  "openapi": "3.1.0",
  "info": {
    "title": "StubController API",
    "version": "1.0.0"
  },
  "paths": {
    "/stub/sign-in-stub": {
      "get": {
        "operationId": "SignInStubGet",
        "summary": "Render the sign-in page with stub data",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful rendering of the sign-in page"
          }
        }
      },
      "post": {
        "operationId": "SignInStubPost",
        "summary": "Submit sign-in stub data",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInStubViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to another URL (sign-in stub or signed-in stub)"
          }
        }
      }
    },
    "/stub/signed-in-stub": {
      "get": {
        "operationId": "SignedInStubGet",
        "summary": "Render the signed-in stub page",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully renders the signed-in stub page"
          },
          "401": {
            "description": "Unauthorized access"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignInStubViewModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "nullable": true
          },
          "Email": {
            "type": "string",
            "nullable": true
          },
          "Phone": {
            "type": "string",
            "nullable": true
          },
          "UserFile": {
            "type": "string",
            "format": "binary",
            "nullable": true
          },
          "ReturnUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": []
      },
      "Name": {
        "type": "object",
        "properties": {
          "ValidSince": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ValidUntil": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "FamilyName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          }
        },
        "required": [
          "FamilyName",
          "GivenNames"
        ]
      }
    }
  }
}
