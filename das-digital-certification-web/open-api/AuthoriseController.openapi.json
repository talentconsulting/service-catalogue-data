{
  "openapi": "3.1.0",
  "info": {
    "title": "Authorise Controller API",
    "version": "1.0.0"
  },
  "paths": {
    "/authorise/need-more-information": {
      "get": {
        "operationId": "NeedMoreInformationRouteGet",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the need more information page."
          }
        }
      },
      "post": {
        "operationId": "NeedMoreInformationContinueRoutePost",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the know your ULN route."
          }
        }
      }
    },
    "/authorise/know-your-uln": {
      "get": {
        "operationId": "KnowYourUlnRouteGet",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the know your ULN page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowYourUlnViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "KnowYourUlnRoutePost",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowYourUlnViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the next appropriate route based on match outcome."
          }
        }
      }
    },
    "/authorise/select-course": {
      "get": {
        "operationId": "SelectCourseRouteGet",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the select course page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectCourseViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "SelectCourseRoutePost",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the next appropriate route based on match outcome."
          }
        }
      }
    },
    "/authorise/select-provider": {
      "get": {
        "operationId": "SelectProviderRouteGet",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the select provider page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "SelectProviderRoutePost",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the check answers route."
          }
        }
      }
    },
    "/authorise/check-answers": {
      "get": {
        "operationId": "CheckAnswersRouteGet",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the check answers page."
          }
        }
      },
      "post": {
        "operationId": "CheckAnswersRoutePost",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the certificates list or another matching route."
          }
        }
      }
    },
    "/authorise/know-year": {
      "get": {
        "operationId": "KnowYearRouteGet",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the know year page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KnowYearViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "KnowYearRoutePost",
        "security": [
          {
            "VerifiedAndNotUlnAuthorised": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KnowYearViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the check answers or select provider route."
          }
        }
      }
    },
    "/authorise/cannot-match": {
      "get": {
        "operationId": "CannotMatchRouteGet",
        "responses": {
          "200": {
            "description": "Returns the cannot match page."
          }
        }
      }
    },
    "/authorise/not-found": {
      "get": {
        "operationId": "NotFoundRouteGet",
        "responses": {
          "200": {
            "description": "Returns the not found page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "KnowYourUlnViewModel": {
        "type": "object",
        "properties": {
          "KnowUln": {
            "type": "boolean",
            "nullable": true
          },
          "Uln": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "IsReturningToCheck": {
            "type": "boolean"
          },
          "IsShortJourney": {
            "type": "boolean"
          }
        }
      },
      "SelectCourseViewModel": {
        "type": "object",
        "properties": {
          "SelectedCourseCode": {
            "type": "string",
            "nullable": true
          },
          "Courses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "CourseCode": {
                  "type": "string",
                  "required": true
                },
                "CourseName": {
                  "type": "string",
                  "required": true
                },
                "CourseLevel": {
                  "type": "string",
                  "nullable": true
                },
                "CertificateType": {
                  "type": "string",
                  "enum": [
                    "Unknown",
                    "Standard",
                    "Framework"
                  ]
                }
              }
            },
            "nullable": true
          },
          "IsReturningToCheck": {
            "type": "boolean"
          },
          "IsShortJourney": {
            "type": "boolean"
          }
        }
      },
      "SelectProviderViewModel": {
        "type": "object",
        "properties": {
          "SelectedProviderName": {
            "type": "string",
            "nullable": true
          },
          "SelectedProviderUnknown": {
            "type": "boolean",
            "nullable": true
          },
          "Providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Ukprn": {
                  "type": "integer",
                  "format": "int64",
                  "nullable": true
                },
                "ProviderName": {
                  "type": "string",
                  "required": true
                }
              }
            },
            "nullable": true
          },
          "IsReturningToCheck": {
            "type": "boolean"
          },
          "IsShortJourney": {
            "type": "boolean"
          }
        }
      },
      "KnowYearViewModel": {
        "type": "object",
        "properties": {
          "KnowYear": {
            "type": "boolean",
            "nullable": true
          },
          "YearCompleted": {
            "type": "integer",
            "nullable": true
          },
          "ProviderSelected": {
            "type": "boolean"
          },
          "IsReturningToCheck": {
            "type": "boolean"
          },
          "IsShortJourney": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "VerifiedAndNotUlnAuthorised": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "VerifiedAndNotUlnAuthorised": "Verified and not ULN authorised policy"
            }
          }
        }
      }
    }
  }
}
