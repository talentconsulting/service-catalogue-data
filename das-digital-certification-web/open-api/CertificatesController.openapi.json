          },
          "CourseName": {
            "type": "string",
            "nullable": true
          },
          "GivenNames": {
            "type": "string",
            "nullable": true
          },
          "FamilyName": {
            "type": "string",
            "nullable": true
          },
          "BackRoute": {
            "type": "string",
            "nullable": true
          },
          "Organisation": {
