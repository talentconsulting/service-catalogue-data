{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0",
    "description": "API Endpoints related to digital certificates and their associated functionality."
  },
  "paths": {
    "/certificates/list": {
      "get": {
        "operationId": "CertificatesList",
        "summary": "Retrieve a list of certificates",
        "security": [
          {
            "IsUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/certificates/{certificateId}/delivery-request/add-address": {
      "get": {
        "operationId": "AddAddress",
        "summary": "Retrieve form to add a delivery address for a certificate",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "backRoute",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      },
      "post": {
        "operationId": "AddAddressPost",
        "summary": "Submit a new address for certificate delivery",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAddressManualViewModel"
              }
            }
          }
        },
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/certificates/{certificateId}/delivery-request/select-address": {
      "get": {
        "operationId": "SelectAddress",
        "summary": "Retrieve possible addresses for certificate delivery",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      },
      "post": {
        "operationId": "SelectAddressPost",
        "summary": "Select from predefined addresses for certificate delivery",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectAddressViewModel"
              }
            }
          }
        },
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/certificates/{certificateId}/delivery-request/check-and-submit": {
      "get": {
        "operationId": "CheckAndSubmit",
        "summary": "View and confirm certificate delivery request",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      },
      "post": {
        "operationId": "CheckAndSubmitPost",
        "summary": "Submit the certificate delivery request",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/certificates/{certificateId}/delivery-request/confirmation": {
      "get": {
        "operationId": "PrintRequestConfirmation",
        "summary": "View the confirmation of the certificate delivery request",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/certificates/contact": {
      "get": {
        "operationId": "ContactUs",
        "summary": "View the contact us page",
        "security": [
          {
            "IsUlnAuthorised": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/certificates/{certificateId}/contact": {
      "get": {
        "operationId": "ContactUsForCertificate",
        "summary": "View the contact us page for a specific certificate",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": [
          {
            "IsCertificateOwner": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddAddressManualViewModel": {
        "type": "object",
        "properties": {
          "CertificateId": {
            "type": "string",
            "format": "uuid"
          },
          "CourseName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          },
          "FamilyName": {
            "type": "string"
          },
          "BackRoute": {
            "type": "string"
          },
          "Organisation": {
            "type": "string"
          },
          "AddressLine1": {
            "type": "string"
          },
          "AddressLine2": {
            "type": "string"
          },
          "TownOrCity": {
            "type": "string"
          },
          "County": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          }
        },
        "required": [
          "CertificateId"
        ]
      },
      "SelectAddressViewModel": {
        "type": "object",
        "properties": {
          "CertificateId": {
            "type": "string",
            "format": "uuid"
          },
          "CourseName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          },
          "FamilyName": {
            "type": "string"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SelectedAddress": {
            "type": "string"
          }
        },
        "required": [
          "CertificateId"
        ]
      }
    },
    "securitySchemes": {
      "IsUlnAuthorised": {
        "type": "oauth2",
        "description": "Requires the user to be ULN authorised."
      },
      "IsCertificateOwner": {
        "type": "oauth2",
        "description": "Requires the user to be the owner of the certificate."
      }
    }
  }
}
