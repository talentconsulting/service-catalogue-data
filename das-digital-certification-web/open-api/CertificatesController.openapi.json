{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certifications API",
    "version": "1.0.0",
    "description": "API for managing digital certifications, certificate sharing, and delivery requests."
  },
  "paths": {
    "/certificates/list": {
      "get": {
        "operationId": "CertificatesList",
        "summary": "Retrieve a list of certificates.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/certificates/{certificateId}/standard": {
      "get": {
        "operationId": "CertificateStandard",
        "summary": "Retrieve details of a standard certificate.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the certificate."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/certificates/{certificateId}/framework": {
      "get": {
        "operationId": "CertificateFramework",
        "summary": "Retrieve details of a framework certificate.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the certificate."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/certificates/{certificateId}/standard/download": {
      "get": {
        "operationId": "DownloadCertificateStandardPdf",
        "summary": "Download a standard certificate as a PDF.",
        "parameters": [
          {
            "name": "certificateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the certificate."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/certificates/{certificateId}/framework/download": {
      "get": {
        "operationId": "DownloadCertificateFrameworkPdf",
