{
  "openapi": "3.1.0",
  "info": {
    "title": "Locations API",
    "version": "1.0.0"
  },
  "paths": {
    "/locations": {
      "get": {
        "summary": "Get locations",
        "description": "Retrieve a list of locations matching a search term.",
        "operationId": "getLocations",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The term to search for locations."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "locations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ]
                      }
                    }
                  },
                  "required": [
                    "locations"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "IsVerified": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "IsVerified": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires the user to be verified according to the IsVerified policy."
      }
    }
  }
}
