{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Redirect to the start page.",
        "responses": {
          "302": {
            "description": "Redirects to /start-page."
          }
        }
      }
    },
    "/{controller}/{action}/{id}": {
      "get": {
        "summary": "Default route for controllers.",
        "parameters": [
          {
            "name": "controller",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          },
          "404": {
            "description": "Not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
