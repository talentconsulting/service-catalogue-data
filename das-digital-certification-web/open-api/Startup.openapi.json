{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0",
    "description": "API endpoints for managing digital certificates."
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "RedirectToStartPage",
        "summary": "Redirect to Start Page",
        "responses": {
          "302": {
            "description": "Redirects to the start page"
          }
        }
      }
    },
    "/{controller}/{action}/{id}": {
      "get": {
        "operationId": "DynamicRoute",
        "summary": "Dynamic Controller Action Route",
        "parameters": [
          {
            "name": "controller",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
