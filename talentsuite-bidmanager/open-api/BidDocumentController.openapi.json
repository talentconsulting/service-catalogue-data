{
  "openapi": "3.1.0",
  "info": {
    "title": "Bid Document Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/document": {
      "post": {
        "summary": "Ingest a bid document",
        "description": "Uploads and parses a bid document.",
        "tags": [
          "Document"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The document file to be uploaded."
                  },
                  "stage": {
                    "$ref": "#/components/schemas/BidStage"
                  }
                },
                "required": [
                  "file",
                  "stage"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully ingested document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParsedDocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - file missing or invalid."
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    },
    "/api/document/jobs": {
      "post": {
        "summary": "Start a document ingestion job",
        "description": "Starts an asynchronous ingestion job for a bid document.",
        "tags": [
          "Jobs"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The document file to be uploaded."
                  },
                  "stage": {
                    "$ref": "#/components/schemas/BidStage"
                  }
                },
                "required": [
                  "file",
                  "stage"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Job accepted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentIngestionJobCreatedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - file missing or invalid."
          },
          "401": {
            "description": "Unauthorized."
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      },
      "get": {
        "summary": "List ingestion jobs",
        "description": "Retrieves a list of ingestion jobs for the current user.",
        "tags": [
          "Jobs"
        ],
        "responses": {
          "200": {
            "description": "A list of job statuses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DocumentIngestionJobStatusResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized."
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    },
    "/api/document/jobs/{jobId}": {
      "get": {
        "summary": "Get ingestion job details",
        "description": "Retrieves details of an ingestion job by its ID.",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentIngestionJobStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized."
          },
          "404": {
            "description": "Job not found."
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    },
    "/api/document/jobs/{jobId}/stream": {
      "get": {
        "summary": "Stream ingestion job updates",
        "description": "Streams real-time updates for an ingestion job.",
        "tags": [
          "Jobs"
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Stream is opened successfully.",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized."
          },
          "404": {
            "description": "Job not found."
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BidStage": {
        "type": "string",
        "enum": [
          "Stage1",
          "Stage2"
        ]
      },
      "DocumentIngestionJobCreatedResponse": {
        "type": "object",
        "properties": {
          "JobId": {
            "type": "string",
            "example": "12345"
          }
        }
      },
      "DocumentIngestionJobStatusResponse": {
        "type": "object",
        "properties": {
          "JobId": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "Stage": {
            "$ref": "#/components/schemas/BidStage"
          },
          "Status": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          },
          "IsComplete": {
            "type": "boolean"
          },
          "IsError": {
            "type": "boolean"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "CompletedAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Result": {
            "$ref": "#/components/schemas/ParsedDocumentResponse"
          }
        }
      },
      "ParsedDocumentResponse": {
        "type": "object",
        "properties": {
          "UniqueReference": {
            "type": "string",
            "nullable": true
          },
          "Company": {
            "type": "string",
            "nullable": true
          },
          "Summary": {
            "type": "string",
            "nullable": true
          },
          "KeyInformation": {
            "type": "string",
            "nullable": true
          },
          "Budget": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForQualifying": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForSubmission": {
            "type": "string",
            "nullable": true
          },
          "LengthOfContract": {
            "type": "string",
            "nullable": true
          },
          "Questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParsedQuestionResponse"
            }
          }
        }
      },
      "ParsedQuestionResponse": {
        "type": "object",
        "properties": {
          "QuestionOrderIndex": {
            "type": "integer"
          },
          "Category": {
            "type": "string"
          },
          "Number": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Length": {
            "type": "string"
          },
          "Weighting": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "Required": {
            "type": "boolean"
          },
          "NiceToHave": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {}
          }
        }
      }
    }
  }
}
