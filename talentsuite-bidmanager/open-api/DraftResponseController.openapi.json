{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Response Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/drafts": {
      "post": {
        "summary": "Add a new draft response to a question.",
        "operationId": "AddResponse",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAssetResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      },
      "get": {
        "summary": "Retrieve all draft responses for a question.",
        "operationId": "GetAllResponses",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of draft responses.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DraftResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      },
      "delete": {
        "summary": "Remove a draft response.",
        "operationId": "RemoveResponse",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "responseId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Response successfully deleted."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}": {
      "put": {
        "summary": "Update a specific draft response.",
        "operationId": "UpdateResponse",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft successfully updated."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}/comments": {
      "get": {
        "summary": "Retrieve comments on a draft response.",
        "operationId": "GetComments",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of comments.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DraftCommentResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      },
      "post": {
        "summary": "Add a comment to a draft response.",
        "operationId": "AddComment",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment successfully added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}/comments/{commentId}": {
      "patch": {
        "summary": "Mark a comment's completion status.",
        "operationId": "SetCommentCompletion",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment status updated."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DraftRequest": {
        "type": "object",
        "properties": {
          "Response": {
            "type": "string"
          }
        },
        "required": [
          "Response"
        ]
      },
      "UpdateDraftRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Response": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Response"
        ]
      },
      "AddDraftCommentRequest": {
        "type": "object",
        "properties": {
          "Comment": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "MentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        },
        "required": [
          "Comment",
          "UserId",
          "AuthorName"
        ]
      },
      "SetCommentCompletionRequest": {
        "type": "object",
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "IsComplete"
        ]
      },
      "CreateAssetResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "DraftResponse": {
        "type": "object",
        "properties": {}
      },
      "DraftCommentResponse": {
        "type": "object",
        "properties": {}
      }
    },
    "securitySchemes": {
      "RequireBidAccess": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
