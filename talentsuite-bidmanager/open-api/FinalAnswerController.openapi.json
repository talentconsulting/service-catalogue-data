{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Bid Manager API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/final-answer": {
      "get": {
        "summary": "Retrieve the final answer for a question.",
        "operationId": "GetFinalAnswer",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Final answer retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalAnswerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Final answer not found."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      },
      "put": {
        "summary": "Update the final answer for a question.",
        "operationId": "SetFinalAnswer",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFinalAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Final answer updated successfully."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments": {
      "post": {
        "summary": "Add a draft comment to a final answer.",
        "operationId": "AddDraftComment",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft comment added successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or empty comment."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments/{commentId}": {
      "patch": {
        "summary": "Set the completion status of a comment.",
        "operationId": "SetCommentCompletion",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment completion status updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or invalid comment ID."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "FinalAnswerResponse": {
        "type": "object",
        "properties": {
          "QuestionId": {
            "type": "string"
          },
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          },
          "Comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftCommentResponse"
            }
          }
        }
      },
      "UpdateFinalAnswerRequest": {
        "type": "object",
        "properties": {
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          }
        },
        "required": [
          "AnswerText",
          "ReadyForSubmission"
        ]
      },
      "AddDraftCommentRequest": {
        "type": "object",
        "properties": {
          "Comment": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "MentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        },
        "required": [
          "Comment",
          "UserId",
          "AuthorName"
        ]
      },
      "DraftCommentResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "IsComplete": {
            "type": "boolean"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        }
      },
      "SetCommentCompletionRequest": {
        "type": "object",
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "IsComplete"
        ]
      }
    },
    "securitySchemes": {
      "RequireBidAccess": {
        "type": "oauth2",
        "description": "Access requires the 'RequireBidAccess' policy.",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "RequireBidAccess": "Access to bid-related resources"
            }
          }
        }
      }
    }
  }
}
