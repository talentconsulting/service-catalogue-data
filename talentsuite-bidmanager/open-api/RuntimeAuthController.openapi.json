{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Bid Manager API",
    "description": "API for managing bids and user authentication within the TalentSuite platform.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/runtime/auth": {
      "get": {
        "operationId": "getRuntimeAuth",
        "summary": "Retrieve Keycloak Authority URL",
        "responses": {
          "200": {
            "description": "Successful response containing the Keycloak Authority URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeAuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/accept-invite/validate": {
      "get": {
        "operationId": "validateInviteToken",
        "summary": "Validate an invitation token",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the validation status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteValidationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired token."
          }
        }
      }
    },
    "/api/users/accept-invite": {
      "post": {
        "operationId": "acceptInvite",
        "summary": "Accept an invitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInviteRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Invitation accepted successfully."
          },
          "400": {
            "description": "Invalid or expired token."
          }
        }
      }
    },
    "/api/users/accept-invite/register": {
      "post": {
        "operationId": "registerInvite",
        "summary": "Register a user from an invitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInviteRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "User registration successful."
          },
          "400": {
            "description": "Invalid or expired token."
          }
        }
      }
    },
    "/api/bids/{bidId}/files": {
      "get": {
        "operationId": "getBidFiles",
        "summary": "Retrieve bid files",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing a list of bid files.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BidFileResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "uploadBidFile",
        "summary": "Upload a bid file",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bid file uploaded successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidFileResponse"
                }
              }
            }
          },
          "400": {
            "description": "File upload failed."
          }
        }
      }
    },
    "/api/bids/{bidId}/files/{fileId}": {
      "get": {
        "operationId": "downloadBidFile",
        "summary": "Download a bid file",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bid file downloaded successfully.",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found."
          }
        }
      },
      "delete": {
        "operationId": "deleteBidFile",
        "summary": "Delete a bid file",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "File deleted successfully."
          },
          "404": {
            "description": "File not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RuntimeAuthResponse": {
        "type": "object",
        "properties": {
          "KeycloakAuthority": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "InviteValidationResponse": {
        "type": "object",
        "properties": {
          "Status": {
            "type": "string"
          }
        }
      },
      "AcceptInviteRequest": {
        "type": "object",
        "properties": {
          "InvitationToken": {
            "type": "string"
          }
        },
        "required": [
          "InvitationToken"
        ]
      },
      "RegisterInviteRequest": {
        "type": "object",
        "properties": {
          "InvitationToken": {
            "type": "string"
          },
          "Username": {
            "type": "string"
          },
          "Password": {
            "type": "string"
          }
        },
        "required": [
          "InvitationToken",
          "Username",
          "Password"
        ]
      },
      "BidFileResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "BidId": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "SizeBytes": {
            "type": "integer",
            "format": "int64"
          },
          "UploadedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
