{
  "openapi": "3.1.0",
  "info": {
    "title": "Health API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealthStatus",
        "summary": "Get health status of the application",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Health check results indicating success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Health check results indicating failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean",
            "description": "Indicates whether all health checks passed."
          },
          "Checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheckResult"
            },
            "description": "List of individual health check results."
          }
        },
        "required": [
          "Success",
          "Checks"
        ]
      },
      "HealthCheckResult": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Name of the health check probe."
          },
          "Success": {
            "type": "boolean",
            "description": "Indicates whether the health check passed."
          },
          "Description": {
            "type": "string",
            "description": "Additional information about the health check."
          }
        },
        "required": [
          "Name",
          "Success",
          "Description"
        ]
      }
    }
  }
}
