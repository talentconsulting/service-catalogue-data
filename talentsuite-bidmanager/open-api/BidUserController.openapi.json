{
  "openapi": "3.1.0",
  "info": {
    "title": "Bid User API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids/{bidId}/users": {
      "get": {
        "summary": "Get Users for a Bid",
        "description": "Retrieve all users associated with a bid.",
        "operationId": "GetBidUsers",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the bid to retrieve users for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BidUserResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "summary": "Add a User to a Bid",
        "description": "Assign a user to a bid.",
        "operationId": "AddBidUser",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the bid to which the user will be added."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAssignmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User successfully added to the bid."
          },
          "400": {
            "description": "Invalid input. Unable to process the request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "delete": {
        "summary": "Remove a User from a Bid",
        "description": "Remove an assigned user from a bid.",
        "operationId": "RemoveBidUser",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the bid from which the user will be removed."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAssignmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User successfully removed from the bid."
          },
          "400": {
            "description": "Invalid input. Unable to process the request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserAssignmentRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "UserId"
        ]
      },
      "BidUserResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Name"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "Admin",
          "BidManager",
          "User"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {
              "RequireBidAccess": "Access bids.",
              "RequireBidManagementRole": "Manage bids."
            }
          }
        }
      }
    }
  }
}
