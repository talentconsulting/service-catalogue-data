{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Final Answer API",
    "version": "1.0.0",
    "description": "Endpoints related to managing final answers and comments for bids."
  },
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/final-answer": {
      "get": {
        "summary": "Get Final Answer",
        "description": "Retrieve the final answer for a specific bid and question.",
        "operationId": "getFinalAnswer",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the bid."
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the question."
          }
        ],
        "responses": {
          "200": {
            "description": "Final answer retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalAnswerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Final answer not found."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "put": {
        "summary": "Set Final Answer",
        "description": "Update the final answer for a specific bid and question.",
        "operationId": "setFinalAnswer",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the bid."
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the question."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFinalAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Final answer updated successfully."
          },
          "400": {
            "description": "Invalid request."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments": {
      "post": {
        "summary": "Add Final Answer Comment",
        "description": "Add a comment to the final answer for a specific bid and question.",
        "operationId": "addFinalAnswerComment",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the bid."
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the question."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment added successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments/{commentId}": {
      "patch": {
        "summary": "Set Comment Completion Status",
        "description": "Update the completion status of a comment for a specific bid and question.",
        "operationId": "setCommentCompletion",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the bid."
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the question."
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the comment."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment completion status updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftCommentRequest": {
        "type": "object",
        "properties": {
          "Comment": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "MentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        },
        "required": [
          "Comment",
          "UserId",
          "AuthorName"
        ]
      },
      "DraftCommentResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "IsComplete": {
            "type": "boolean"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Comment",
          "IsComplete",
          "UserId",
          "AuthorName",
          "CreatedAtUtc"
        ]
      },
      "FinalAnswerResponse": {
        "type": "object",
        "properties": {
          "QuestionId": {
            "type": "string"
          },
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          },
          "Comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftCommentResponse"
            }
          }
        },
        "required": [
          "QuestionId",
          "AnswerText",
          "ReadyForSubmission",
          "Comments"
        ]
      },
      "UpdateFinalAnswerRequest": {
        "type": "object",
        "properties": {
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          }
        },
        "required": [
          "AnswerText",
          "ReadyForSubmission"
        ]
      },
      "SetCommentCompletionRequest": {
        "type": "object",
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "IsComplete"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
