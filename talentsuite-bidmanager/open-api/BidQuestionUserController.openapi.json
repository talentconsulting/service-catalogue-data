{
  "openapi": "3.1.0",
  "info": {
    "title": "Bid Question User API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/users": {
      "get": {
        "summary": "Get users assigned to a bid question",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BidUserResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      },
      "post": {
        "summary": "Assign a user to a bid question",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionUserAssignmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User successfully assigned"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ]
      },
      "put": {
        "summary": "Update a user's role in a bid question",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionUserAssignmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User role successfully updated"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ]
      },
      "delete": {
        "summary": "Remove a user from a bid question",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAssignmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User successfully removed"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BidUserResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Name"
        ]
      },
      "QuestionUserAssignmentRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/QuestionUserRole"
          }
        },
        "required": [
          "UserId",
          "Role"
        ]
      },
      "QuestionUserRole": {
        "type": "string",
        "enum": [
          "Owner",
          "Reviewer",
          "Support"
        ]
      },
      "UserAssignmentRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "UserId"
        ]
      }
    },
    "securitySchemes": {
      "RequireBidAccess": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires authorization to access bid"
      },
      "RequireBidManagementRole": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires the user to have a Bid Management Role"
      }
    }
  }
}
