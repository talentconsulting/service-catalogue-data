{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Tasks API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tasks/my": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get tasks mentioning the current user",
        "operationId": "GetMyTasks",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of tasks mentioning the current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MentionTaskResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - User is not authenticated"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/tasks/my-question-assignments": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Get tasks assigned to the current user for questions",
        "operationId": "GetMyQuestionAssignments",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of question assignments for the current user",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssignedQuestionTaskResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - User is not authenticated"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MentionTaskResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "Identifier of the task"
          },
          "BidId": {
            "type": "string",
            "description": "Identifier of the associated bid"
          },
          "BidTitle": {
            "type": "string",
            "description": "Title of the associated bid"
          },
          "QuestionId": {
            "type": "string",
            "description": "Identifier of the associated question"
          },
          "QuestionTitle": {
            "type": "string",
            "description": "Title of the associated question"
          },
          "CommentId": {
            "type": "string",
            "description": "Identifier of the associated comment"
          },
          "AssignedUserId": {
            "type": "string",
            "description": "Identifier of the user assigned to the task"
          },
          "CommentText": {
            "type": "string",
            "description": "Text of the comment"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time",
            "description": "UTC timestamp of task creation"
          }
        },
        "required": [
          "Id",
          "BidId",
          "BidTitle",
          "QuestionId",
          "QuestionTitle",
          "CommentId",
          "AssignedUserId",
          "CommentText",
          "CreatedAtUtc"
        ]
      },
      "AssignedQuestionTaskResponse": {
        "type": "object",
        "properties": {
          "BidId": {
            "type": "string",
            "description": "Identifier of the associated bid"
          },
          "BidTitle": {
            "type": "string",
            "description": "Title of the associated bid"
          },
          "QuestionId": {
            "type": "string",
            "description": "Identifier of the associated question"
          },
          "QuestionNumber": {
            "type": "string",
            "description": "Number of the question"
          },
          "QuestionTitle": {
            "type": "string",
            "description": "Title of the associated question"
          },
          "Role": {
            "$ref": "#/components/schemas/QuestionUserRole",
            "description": "Role of the assigned user for the question"
          },
          "NiceToHave": {
            "type": "boolean",
            "description": "Indicates if the task is a 'nice to have'"
          }
        },
        "required": [
          "BidId",
          "BidTitle",
          "QuestionId",
          "QuestionNumber",
          "QuestionTitle",
          "Role",
          "NiceToHave"
        ]
      },
      "QuestionUserRole": {
        "type": "string",
        "enum": [
          "Owner",
          "Reviewer",
          "Support"
        ],
        "description": "Role of a user in the context of a question"
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
