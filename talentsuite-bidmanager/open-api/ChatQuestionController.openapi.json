{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Bid Manager API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/ai/questions/{questionId}": {
      "post": {
        "summary": "Ask a question about a bid",
        "description": "Submit a question related to a bid and get an answer from the AI.",
        "tags": [
          "AI Questions"
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatQuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully retrieved the AI response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatQuestionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The requestor is forbidden from managing the bid."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/ai/questions/{questionId}/messages": {
      "get": {
        "summary": "Get AI chat messages",
        "description": "Retrieve AI chat messages for a specific bid and question.",
        "tags": [
          "AI Questions"
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bidId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of chat messages.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatMessageResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid bidId parameter.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The requestor is forbidden from managing the bid."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/ai/questions/{questionId}/stream": {
      "post": {
        "summary": "Stream question responses",
        "description": "Stream responses to the provided question in NDJSON format.",
        "tags": [
          "AI Questions"
        ],
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatQuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The response is streamed in NDJSON format."
          },
          "400": {
            "description": "Invalid request payload or parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The requestor is forbidden from managing the bid."
          },
          "401": {
            "description": "Unauthorized request."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChatQuestionRequest": {
        "type": "object",
        "properties": {
          "BidId": {
            "type": "string"
          },
          "QuestionId": {
            "type": "string"
          },
          "FreeTextQuestion": {
            "type": "string"
          },
          "ThreadId": {
            "type": "string",
            "nullable": true
          },
          "BidFileIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "BidId",
          "QuestionId",
          "FreeTextQuestion"
        ]
      },
      "ChatQuestionResponse": {
        "type": "object",
        "properties": {
          "Response": {
            "type": "string"
          },
          "ThreadId": {
            "type": "string",
            "nullable": true
          },
          "Sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatSourceReferenceResponse"
            }
          },
          "UsedSourcesOutsideBidLibrary": {
            "type": "boolean"
          }
        }
      },
      "ChatMessageResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Role": {
            "type": "string"
          },
          "Content": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "Sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatSourceReferenceResponse"
            }
          },
          "UsedSourcesOutsideBidLibrary": {
            "type": "boolean"
          }
        }
      },
      "ChatSourceReferenceResponse": {
        "type": "object",
        "properties": {
          "Kind": {
            "type": "string"
          },
          "FileId": {
            "type": "string",
            "nullable": true
          },
          "FileName": {
            "type": "string",
            "nullable": true
          },
          "Uri": {
            "type": "string",
            "nullable": true
          },
          "Title": {
            "type": "string",
            "nullable": true
          },
          "Quote": {
            "type": "string",
            "nullable": true
          },
          "IsFromBidLibrary": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
