{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/employerfeedback/": {
      "get": {
        "description": "Retrieve the latest employer feedback results for the specified account ID and user reference.",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID of the employer."
          },
          {
            "name": "userRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The user reference (UUID)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the latest employer feedback results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLatestEmployerFeedbackResultsResponse"
                }
              }
            }
          },
          "500": {
            "description": "An unexpected server error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                },
                "example": "An unexpected error occurred."
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetLatestEmployerFeedbackResultsResponse": {
        "type": "object",
        "description": "The payload containing the latest employer feedback results.",
        "additionalProperties": true
      }
    }
  }
}
