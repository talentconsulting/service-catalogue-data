{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0",
    "description": "API for managing Employer Feedback results."
  },
  "paths": {
    "/api/EmployerFeedbackResult": {
      "post": {
        "summary": "Submit Employer Feedback",
        "operationId": "SubmitEmployerFeedback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitEmployerFeedbackRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content - Feedback submitted successfully."
          },
          "400": {
            "description": "Bad Request - Validation failed.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error occurred.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/EmployerFeedbackResult/{ukprn}": {
      "get": {
        "summary": "Get Overall Employer Feedback Result",
        "operationId": "GetOverallEmployerFeedbackResult",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "UK Provider Reference Number."
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Overall Employer Feedback Results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error occurred.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/EmployerFeedbackResult/{ukprn}/annual": {
      "get": {
        "summary": "Get Yearly Employer Feedback Result",
        "operationId": "GetYearlyEmployerFeedbackResult",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "UK Provider Reference Number."
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Yearly Employer Feedback Results.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error occurred.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/EmployerFeedbackResult/{ukprn}/annual/{year}": {
      "get": {
        "summary": "Get Employer Feedback Result for Academic Year",
        "operationId": "GetEmployerFeedbackResultForAcademicYear",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "UK Provider Reference Number."
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Academic year identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Employer Feedback Results for Academic Year.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error occurred.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/EmployerFeedbackResult/reviews": {
      "get": {
        "summary": "Get Employer Feedback Ratings Result",
        "operationId": "GetEmployerFeedbackRatingsResult",
        "parameters": [
          {
            "name": "timePeriod",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Time period identifier for feedback ratings."
          }
        ],
        "responses": {
          "200": {
            "description": "OK - Employer Feedback Ratings.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation failed.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error occurred.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitEmployerFeedbackRequest": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderRating": {
            "$ref": "#/components/schemas/OverallRating"
          },
          "FeedbackSource": {
            "type": "integer"
          },
          "ProviderAttributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAttributeDto"
            }
          }
        },
        "required": [
          "UserRef",
          "Ukprn",
          "AccountId",
          "ProviderRating"
        ]
      },
      "OverallRating": {
        "type": "string",
        "enum": [
          "VeryPoor",
          "Poor",
          "Good",
          "Excellent"
        ]
      },
      "ProviderAttributeDto": {
        "type": "object",
        "properties": {
          "AttributeId": {
            "type": "integer",
            "format": "int64"
          },
          "AttributeValue": {
            "type": "integer"
          }
        },
        "required": [
          "AttributeId",
          "AttributeValue"
        ]
      }
    }
  }
}
