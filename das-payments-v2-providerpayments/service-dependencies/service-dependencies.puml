@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_payments_v2_providerpayments, "SFA.DAS.Payments.ProviderPayments") {
  Container(c_provider_payments_application, "Provider Payments Application", "Component")
  Container(c_provider_payments_legacy_export_service, "Provider Payments Legacy Export Service", "Background Job")
  Container(c_provider_payments_provider_payments_service, "Provider Payments Provider Payments Service", "Background Job")
  Container(c_sfa_das_payments_providerpayments_specs, "SFA.DAS.Payments.ProviderPayments Specs", "Component")
}

SystemDb_Ext(d_database_sql_server, "SQL Server", "EF Core")

Rel(c_sfa_das_payments_providerpayments_specs, d_database_sql_server, "Reads from and writes to", "EF Core")
Rel(c_provider_payments_application, d_database_sql_server, "Reads from and writes to", "SQL Server")

@enduml
