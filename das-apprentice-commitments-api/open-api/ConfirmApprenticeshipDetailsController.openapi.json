{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Commitments API",
    "description": "API for confirming apprenticeship details",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions/{revisionId}/ApprenticeshipDetailsConfirmation": {
      "post": {
        "deprecated": true,
        "summary": "Confirm apprenticeship details",
        "description": "Confirms apprenticeship details for the provided apprentice and revision. Deprecated in favor of another PATCH endpoint.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the apprentice",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the revision",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "The confirmation details for the apprenticeship",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmApprenticeshipDetailsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmation was successful"
          },
          "400": {
            "description": "Invalid request data"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmApprenticeshipDetailsRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipDetailsCorrect": {
            "type": "boolean",
            "description": "Indicates if the apprenticeship details are correct"
          }
        },
        "required": [
          "ApprenticeshipDetailsCorrect"
        ]
      }
    }
  }
}
