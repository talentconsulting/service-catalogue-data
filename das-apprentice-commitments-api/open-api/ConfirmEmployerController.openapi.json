{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions/{revisionId}/EmployerConfirmation": {
      "post": {
        "deprecated": true,
        "operationId": "ConfirmTrainingProvider",
        "summary": "Confirm an apprentice's employer is correct.",
        "tags": [
          "ConfirmEmployer"
        ],
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier of the apprentice."
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The unique identifier of the apprenticeship."
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The unique identifier of the revision."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmEmployerRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "The confirmation was successfully processed."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmEmployerRequest": {
        "type": "object",
        "properties": {
          "EmployerCorrect": {
            "type": "boolean",
            "description": "Indicates if the employer is confirmed as correct."
          }
        },
        "required": [
          "EmployerCorrect"
        ]
      }
    }
  }
}
