{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/approvals": {
      "post": {
        "summary": "Apprenticeship Created",
        "operationId": "ApprenticeshipCreated",
        "requestBody": {
          "description": "Create a new apprenticeship registration.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRegistrationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship successfully created."
          }
        }
      },
      "put": {
        "summary": "Change of Circumstances",
        "operationId": "ChangeOfCircumstances",
        "requestBody": {
          "description": "Update an apprenticeship registration due to a change of circumstances.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeRegistrationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship registration successfully updated."
          }
        }
      }
    },
    "/approvals/stopped": {
      "post": {
        "summary": "Stopped Apprenticeship",
        "operationId": "StoppedApprenticeship",
        "requestBody": {
          "description": "Mark an apprenticeship as stopped.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoppedApprenticeshipCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship successfully marked as stopped."
          }
        }
      }
    },
    "/approvals/{commitmentsApprenticeshipId}/registration": {
      "get": {
        "summary": "Get Approvals Registration",
        "operationId": "GetApprovalsRegistration",
        "parameters": [
          {
            "name": "commitmentsApprenticeshipId",
            "in": "path",
            "required": true,
            "description": "ID of the commitments apprenticeship.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approvals registration successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalsRegistrationQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Approvals registration not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRegistrationCommand": {
        "type": "object",
        "properties": {
          "RegistrationId": {
            "type": "string",
            "format": "uuid"
          },
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CommitmentsApprovedOn": {
            "type": "string",
            "format": "date-time"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "EmployerName": {
            "type": "string"
          },
          "EmployerAccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderName": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "CourseName": {
            "type": "string"
          },
          "CourseLevel": {
            "type": "integer"
          },
          "CourseDuration": {
            "type": "integer"
          },
          "CourseOption": {
            "type": "string",
            "nullable": true
          },
          "PlannedStartDate": {
            "type": "string",
            "format": "date"
          },
          "PlannedEndDate": {
            "type": "string",
            "format": "date"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "RecognisePriorLearning": {
            "type": "boolean",
            "nullable": true
          },
          "DurationReducedByHours": {
            "type": "integer",
            "nullable": true
          },
          "DurationReducedBy": {
            "type": "integer",
            "nullable": true
          },
          "ApprenticeshipType": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "ChangeRegistrationCommand": {
        "type": "object",
        "properties": {
          "CommitmentsContinuedApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CommitmentsApprovedOn": {
            "type": "string",
            "format": "date-time"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "EmployerName": {
            "type": "string"
          },
          "EmployerAccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingProviderName": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "CourseName": {
            "type": "string"
          },
          "CourseLevel": {
            "type": "integer"
          },
          "CourseDuration": {
            "type": "integer"
          },
          "CourseOption": {
            "type": "string",
            "nullable": true
          },
          "PlannedStartDate": {
            "type": "string",
            "format": "date"
          },
          "PlannedEndDate": {
            "type": "string",
            "format": "date"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "RecognisePriorLearning": {
            "type": "boolean",
            "nullable": true
          },
          "DurationReducedByHours": {
            "type": "integer",
            "nullable": true
          },
          "DurationReducedBy": {
            "type": "integer",
            "nullable": true
          },
          "ApprenticeshipType": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "StoppedApprenticeshipCommand": {
        "type": "object",
        "properties": {
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CommitmentsStoppedOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApprovalsRegistrationQueryResponse": {
        "type": "object",
        "properties": {}
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
