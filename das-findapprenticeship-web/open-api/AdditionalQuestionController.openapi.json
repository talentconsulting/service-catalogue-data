{
  "openapi": "3.1.0",
  "info": {
    "title": "AdditionalQuestion API",
    "version": "1.0.0",
    "description": "API for managing additional questions in the application process."
  },
  "paths": {
    "/apply/{applicationId}/additional-question/{additionalQuestion}/{additionalQuestionId}": {
      "get": {
        "operationId": "getAdditionalQuestion",
        "summary": "Retrieve an additional question for an application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the application."
          },
          {
            "name": "additionalQuestion",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Numeric identifier for the additional question."
          },
          {
            "name": "additionalQuestionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the additional question."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the additional question.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddAdditionalQuestionViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "operationId": "addAdditionalQuestion",
        "summary": "Submit an answer for an additional question.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the application."
          },
          {
            "name": "additionalQuestion",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Numeric identifier for the additional question."
          },
          {
            "name": "additionalQuestionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the additional question."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAdditionalQuestionViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection to the application summary page."
          },
          "400": {
            "description": "Validation errors in the submitted answer."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddAdditionalQuestionViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the application."
          },
          "AdditionalQuestionLabel": {
            "type": "string",
            "nullable": true,
            "description": "Label or text for the additional question."
          },
          "AdditionalQuestionAnswer": {
            "type": "string",
            "nullable": true,
            "description": "Answer provided for the additional question."
          },
          "IsSectionCompleted": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates if the section is completed."
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "/oauth/authorize",
            "tokenUrl": "/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
