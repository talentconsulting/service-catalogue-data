{
  "openapi": "3.1.0",
  "info": {
    "title": "TrainingCourses API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/training-courses/": {
      "get": {
        "summary": "Retrieve training courses for an application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training courses retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrainingCoursesViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      },
      "post": {
        "summary": "Submit training courses for an application",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainingCoursesViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Submission successful, no content returned"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      }
    },
    "/apply/{applicationId}/trainingcourses/add": {
      "get": {
        "summary": "Initiate adding a new training course",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Add training course page loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddTrainingCourseViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      },
      "post": {
        "summary": "Add a new training course",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTrainingCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Training course added successfully"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      }
    },
    "/apply/{applicationId}/trainingcourses/{trainingCourseId}": {
      "get": {
        "summary": "Edit an existing training course",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "trainingCourseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training course details loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditTrainingCourseViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      },
      "post": {
        "summary": "Update an existing training course",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditTrainingCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Training course updated successfully"
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      }
    },
    "/apply/{applicationId}/trainingcourses/{trainingCourseId}/delete": {
      "get": {
        "summary": "Delete a training course",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "trainingCourseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training course loaded for deletion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteTrainingCourseViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      },
      "post": {
        "summary": "Confirm deletion of a training course",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteTrainingCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Training course deleted successfully"
          },
          "400": {
            "description": "Error occurred during deletion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.IsFaaUser": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TrainingCoursesViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "doYouWantToAddAnyTrainingCourses": {
            "type": "boolean",
            "nullable": true
          },
          "showTrainingCoursesAchieved": {
            "type": "boolean"
          },
          "trainingCourses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingCourse"
            }
          },
          "isSectionComplete": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "TrainingCourse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string"
          },
          "yearAchieved": {
            "type": "integer"
          }
        }
      },
      "AddTrainingCourseViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string"
          },
          "yearAchieved": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "EditTrainingCourseViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "trainingCourseId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string"
          },
          "yearAchieved": {
            "type": "string"
          }
        }
      },
      "DeleteTrainingCourseViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "trainingCourseId": {
            "type": "string",
            "format": "uuid"
          },
          "courseName": {
            "type": "string"
          },
          "yearAchieved": {
            "type": "integer"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
