{
  "openapi": "3.1.0",
  "info": {
    "title": "Employment Locations API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/employmentLocations": {
      "get": {
        "operationId": "GetEmploymentLocations",
        "tags": [
          "Employment Locations"
        ],
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employment locations retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddEmploymentLocationsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "UpdateEmploymentLocations",
        "tags": [
          "Employment Locations"
        ],
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddEmploymentLocationsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection to summary view"
          },
          "400": {
            "description": "Validation errors"
          }
        }
      }
    },
    "/apply/{applicationId}/employmentLocations/summary": {
      "get": {
        "operationId": "GetEmploymentLocationsSummary",
        "tags": [
          "Employment Locations Summary"
        ],
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Summary of employment locations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmploymentLocationsSummaryViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "UpdateEmploymentLocationsSummary",
        "tags": [
          "Employment Locations Summary"
        ],
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmploymentLocationsSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection to application view"
          },
          "400": {
            "description": "Validation errors"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddEmploymentLocationsViewModel": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmploymentLocationViewModel"
            }
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "selectedAddressIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "EmploymentLocationsSummaryViewModel": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmploymentLocationViewModel"
            }
          },
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "backLinkUrl": {
            "type": "string",
            "format": "uri"
          },
          "isSectionCompleted": {
            "type": "boolean"
          }
        }
      },
      "EmploymentLocationViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "fullAddress": {
            "type": "string"
          },
          "isSelected": {
            "type": "boolean"
          },
          "addressOrder": {
            "type": "integer",
            "format": "int16"
          }
        }
      }
    }
  }
}
