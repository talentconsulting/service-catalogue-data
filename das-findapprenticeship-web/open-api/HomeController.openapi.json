{
  "openapi": "3.1.0",
  "info": {
    "title": "FAA Web Application API",
    "version": "1.0.0"
  },
  "paths": {
    "/home/cookies": {
      "get": {
        "operationId": "getCookies",
        "summary": "Retrieve cookie consent preferences",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "HTML View of Cookie Consent Preferences"
          }
        }
      }
    },
    "/home/accessibility-statement": {
      "get": {
        "operationId": "getAccessibilityStatement",
        "summary": "Retrieve accessibility statement",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "HTML View of Accessibility Statement"
          }
        }
      }
    },
    "/home/terms-and-conditions": {
      "get": {
        "operationId": "getTermsAndConditions",
        "summary": "Retrieve terms and conditions",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "HTML View of Terms and Conditions"
          }
        }
      }
    },
    "/home/get-help": {
      "get": {
        "operationId": "getHelp",
        "summary": "Retrieve help information",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "HTML View of Help Information"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CookiesViewModel": {
        "type": "object",
        "properties": {
          "PreviousPageUrl": {
            "type": "string"
          },
          "ShowBannerMessage": {
            "type": "boolean"
          },
          "ConsentAnalyticsCookie": {
            "type": "boolean"
          },
          "ConsentFunctionalCookie": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "Address": {
        "type": "object",
        "properties": {
          "AddressLine1": {
            "type": "string",
            "nullable": true
          },
          "AddressLine2": {
            "type": "string",
            "nullable": true
          },
          "AddressLine3": {
            "type": "string",
            "nullable": true
          },
          "AddressLine4": {
            "type": "string",
            "nullable": true
          },
          "Postcode": {
            "type": "string",
            "nullable": true
          },
          "Latitude": {
            "type": "number",
            "nullable": true
          },
          "Longitude": {
            "type": "number",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LocationDto": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Addresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressDto"
            }
          },
          "EmployerLocationOption": {
            "$ref": "#/components/schemas/AvailableWhere"
          },
          "EmploymentLocationInformation": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FullAddress": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          },
          "AddressOrder": {
            "type": "integer",
            "format": "int16"
          }
        },
        "additionalProperties": false
      },
      "AvailableWhere": {
        "type": "string",
        "enum": [
          "OneLocation",
          "MultipleLocations",
          "AcrossEngland"
        ]
      }
    }
  }
}
