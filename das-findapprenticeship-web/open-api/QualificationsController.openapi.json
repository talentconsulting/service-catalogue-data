{
  "openapi": "3.1.0",
  "info": {
    "title": "Qualifications API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/qualifications": {
      "get": {
        "operationId": "getQualifications",
        "summary": "Retrieve qualifications list for an application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QualificationsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "updateQualifications",
        "summary": "Update qualifications for an application.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QualificationsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualifications updated successfully."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    },
    "/apply/{applicationId}/qualifications/add/select-type": {
      "get": {
        "operationId": "getQualificationTypes",
        "summary": "Retrieve qualification types for adding new qualifications.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddQualificationSelectTypeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "selectQualificationType",
        "summary": "Select qualification type for new qualifications.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQualificationSelectTypeViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualification type selected successfully."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    },
    "/apply/{applicationId}/qualifications/{qualificationReferenceId}/modify": {
      "get": {
        "operationId": "getQualificationToModify",
        "summary": "Retrieve information for modifying a qualification.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "qualificationReferenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddQualificationViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "modifyQualification",
        "summary": "Modify an existing qualification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQualificationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualification modified successfully."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    },
    "/apply/{applicationId}/qualifications/delete/{qualificationReferenceId}": {
      "get": {
        "operationId": "getQualificationsForDeletion",
        "summary": "Retrieve qualifications details for deletion.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "qualificationReferenceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteQualificationsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "deleteQualifications",
        "summary": "Delete qualifications.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteQualificationsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Qualifications deleted successfully."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "QualificationsViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QualificationGroup"
            }
          },
          "ShowQualifications": {
            "type": "boolean"
          },
          "DoYouWantToAddAnyQualifications": {
            "type": "boolean"
          }
        }
      },
      "QualificationGroup": {
        "type": "object",
        "properties": {
          "QualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          },
          "Qualifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Qualification"
            }
          }
        }
      },
      "Qualification": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Subject": {
            "type": "string"
          },
          "Grade": {
            "type": "string"
          },
          "AdditionalInformation": {
            "type": "string"
          }
        }
      },
      "AddQualificationSelectTypeViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "Qualifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QualificationType"
            }
          },
          "QualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "QualificationType": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "AddQualificationViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          },
          "Subjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SubjectViewModel"
            }
          },
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseDataListItem"
            }
          }
        }
      },
      "SubjectViewModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Grade": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          }
        }
      },
      "CourseDataListItem": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          }
        }
      },
      "DeleteQualificationsViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationReferenceId": {
            "type": "string",
            "format": "uuid"
          },
          "DisplayName": {
            "type": "string"
          },
          "Qualifications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeleteQualification"
            }
          }
        }
      },
      "DeleteQualification": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Subject": {
            "type": "string"
          },
          "Grade": {
            "type": "string"
          },
          "AdditionalInformation": {
            "type": "string"
          }
        }
      }
    }
  }
}
