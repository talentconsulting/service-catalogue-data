{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Application API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship applications."
  },
  "paths": {
    "/apply/{applicationId}/what-interests-you": {
      "get": {
        "tags": [
          "Apply"
        ],
        "summary": "Retrieve 'What Interests You' section details",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhatInterestsYouViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Apply"
        ],
        "summary": "Update 'What Interests You' section details",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WhatInterestsYouViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful update",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "200 OK"
                }
              }
            }
          },
          "400": {
            "description": "Validation errors in request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "WhatInterestsYouViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "StandardName": {
            "type": "string",
            "nullable": true
          },
          "EmployerName": {
            "type": "string",
            "nullable": true
          },
          "AnswerText": {
            "type": "string",
            "nullable": true
          },
          "IsSectionCompleted": {
            "type": "boolean",
            "nullable": true
          },
          "AutoSave": {
            "type": "boolean"
          }
        },
        "required": [
          "ApplicationId",
          "AutoSave"
        ]
      }
    }
  }
}
