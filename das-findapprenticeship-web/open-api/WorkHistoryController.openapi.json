{
  "openapi": "3.1.0",
  "info": {
    "title": "Find an Apprenticeship Work History API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/jobs": {
      "get": {
        "summary": "Get Work History Jobs",
        "description": "Retrieve the list of jobs for an application.",
        "operationId": "getWorkHistoryJobs",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of jobs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobsViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      },
      "post": {
        "summary": "Submit Work History Jobs",
        "description": "Submit changes to jobs in the work history section for an application.",
        "operationId": "submitWorkHistoryJobs",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful job submission"
          },
          "400": {
            "description": "Validation errors"
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      }
    },
    "/apply/{applicationId}/jobs/add": {
      "get": {
        "summary": "Get Add Job",
        "description": "Retrieve the view model for adding a job.",
        "operationId": "getAddJob",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddJobViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      },
      "post": {
        "summary": "Submit Add Job",
        "description": "Submit data for adding a job.",
        "operationId": "postAddJob",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddJobViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job successfully added"
          },
          "400": {
            "description": "Validation errors"
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      }
    },
    "/apply/{applicationId}/jobs/{jobId}": {
      "get": {
        "summary": "Get a Job",
        "description": "Retrieve the view model for editing a specific job.",
        "operationId": "getJob",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditJobViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      },
      "post": {
        "summary": "Submit Job Changes",
        "description": "Submit changes for a specific job.",
        "operationId": "postJobChanges",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditJobViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job changes successfully submitted"
          },
          "400": {
            "description": "Validation errors"
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      }
    },
    "/apply/{applicationId}/jobs/{jobId}/delete": {
      "get": {
        "summary": "Get Delete Job View",
        "description": "Retrieve the view model for deleting a specific job.",
        "operationId": "getDeleteJobView",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteJobViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      },
      "post": {
        "summary": "Delete a Job",
        "description": "Submit deletion for a specific job.",
        "operationId": "postDeleteJob",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteJobViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job successfully deleted"
          },
          "400": {
            "description": "Validation errors"
          }
        },
        "security": [
          {
            "faaUserAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "JobsViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Job"
            }
          },
          "showJobHistory": {
            "type": "boolean"
          },
          "isSectionCompleted": {
            "type": "boolean"
          },
          "doYouWantToAddAnyJobs": {
            "type": "boolean"
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employer": {
            "type": "string"
          },
          "jobTitle": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "jobDates": {
            "type": "string"
          }
        }
      },
      "AddJobViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "jobDescription": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "isCurrentRole": {
            "type": "boolean"
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "EditJobViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "jobTitle": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "jobDescription": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "isCurrentRole": {
            "type": "boolean"
          }
        },
        "required": [
          "applicationId",
          "jobId"
        ]
      },
      "DeleteJobViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "applicationId",
          "jobId"
        ]
      }
    },
    "securitySchemes": {
      "faaUserAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
