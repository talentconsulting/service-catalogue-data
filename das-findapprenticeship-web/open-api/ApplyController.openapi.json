{
  "openapi": "3.1.0",
  "info": {
    "title": "Apply Controller",
    "version": "1.0.0"
  },
  "paths": {
    "/applications/{applicationId}": {
      "get": {
        "operationId": "GetIndex",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "PostIndex",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to application submitted route"
          }
        }
      }
    },
    "/applications/{applicationId}/preview": {
      "get": {
        "operationId": "GetPreview",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "302": {
            "description": "Redirection to Apply route"
          }
        }
      },
      "post": {
        "operationId": "PostPreview",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to application submission or application summary based on data"
          }
        }
      }
    },
    "/applications/{applicationId}/application-submitted": {
      "get": {
        "operationId": "GetApplicationSubmitted",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "PostApplicationSubmitted",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApplicationSubmittedViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to equality questions flow or applications view"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationSubmittedViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "VacancyInfo": {
            "$ref": "#/components/schemas/ApplicationSubmittedVacancyInfo"
          },
          "AnswerEqualityQuestions": {
            "type": "boolean"
          },
          "IsVacancyClosedEarly": {
            "type": "boolean"
          },
          "ClosedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApplicationSubmittedVacancyInfo": {
        "type": "object",
        "properties": {
          "VacancyTitle": {
            "type": "string"
          },
          "EmployerName": {
            "type": "string"
          },
          "HasAnsweredEqualityQuestions": {
            "type": "boolean"
          }
        }
      },
      "ApplicationSummaryViewModel": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "IsConsentProvided": {
            "type": "boolean"
          },
          "IsDisabilityConfident": {
            "type": "boolean"
          },
          "IsApplicationComplete": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
