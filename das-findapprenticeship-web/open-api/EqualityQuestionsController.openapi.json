{
  "openapi": "3.1.0",
  "info": {
    "title": "Equality Questions API",
    "version": "1.0.0",
    "description": "API for managing equality-related questions within the application process."
  },
  "paths": {
    "/equality-questions/gender": {
      "get": {
        "summary": "Get gender question",
        "operationId": "getGenderQuestion",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID for the gender question."
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates whether the question is being edited."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of gender question.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EqualityQuestionsGenderViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit gender question answer",
        "operationId": "postGenderQuestion",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID for the gender question."
          }
        ],
        "requestBody": {
          "description": "Gender question answer submission.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EqualityQuestionsGenderViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful submission of gender question answer."
          }
        }
      }
    },
    "/equality-questions/ethnic-group": {
      "get": {
        "summary": "Get ethnic group",
        "operationId": "getEthnicGroup",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID for the ethnic group question."
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates whether the question is being edited."
          },
          {
            "name": "clear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicates whether to clear the selection."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of ethnic group.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EqualityQuestionsEthnicGroupViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit ethnic group answer",
        "operationId": "postEthnicGroup",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID for the ethnic group question."
          }
        ],
        "requestBody": {
          "description": "Ethnic group answer submission.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EqualityQuestionsEthnicGroupViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful submission of ethnic group answer."
          }
        }
      }
    },
    "/equality-questions/edit": {
      "get": {
        "summary": "Edit Equality Questions",
        "operationId": "editEqualityQuestions",
        "responses": {
          "302": {
            "description": "Redirects to the Equality Question summary."
          }
        }
      }
    },
    "/equality-questions/summary": {
      "get": {
        "summary": "Get summary of equality questions",
        "operationId": "getEqualityQuestionsSummary",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID for the summary question."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EqualityQuestionsSummaryViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit equality questions summary",
        "operationId": "postEqualityQuestionsSummary",
        "parameters": [
          {
            "name": "applicationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID for the summary question."
          }
        ],
        "requestBody": {
          "description": "Submit the summary of equality questions.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EqualityQuestionsSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful submission of summary."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EqualityQuestionsGenderViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "isEdit": {
            "type": "boolean"
          },
          "sex": {
            "type": "string",
            "nullable": true
          },
          "isGenderIdentifySameSexAtBirth": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EqualityQuestionsEthnicGroupViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "ethnicGroup": {
            "type": "string",
            "nullable": true
          },
          "isEdit": {
            "type": "boolean"
          }
        }
      },
      "EqualityQuestionsSummaryViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "sex": {
            "type": "string",
            "nullable": true
          },
          "isGenderIdentifySameSexAtBirth": {
            "type": "string",
            "nullable": true
          },
          "ethnicGroup": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
