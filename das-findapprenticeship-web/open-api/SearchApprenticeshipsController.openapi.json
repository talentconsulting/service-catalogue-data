{
  "openapi": "3.1.0",
  "info": {
    "title": "Find Apprenticeships API",
    "version": "1.0.0",
    "description": "API for searching and managing apprenticeship data."
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "SearchApprenticeshipsController_Index",
        "summary": "Search apprenticeships index page.",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search page rendered."
          }
        }
      }
    },
    "/apprenticeshipsearch": {
      "get": {
        "operationId": "SearchApprenticeshipsController_Index_ApprenticeshipSearch",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search page rendered."
          }
        }
      }
    },
    "/browse-by-interests": {
      "get": {
        "operationId": "SearchApprenticeshipsController_BrowseByInterests_Get",
        "summary": "Browse apprenticeships by interests.",
        "parameters": [
          {
            "name": "routeIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "A list of route IDs to filter interests."
          }
        ],
        "responses": {
          "200": {
            "description": "Interests page rendered."
          }
        }
      },
      "post": {
        "operationId": "SearchApprenticeshipsController_BrowseByInterests_Post",
        "summary": "Submit selected interests.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BrowseByInterestViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirected after selecting interests."
          }
        }
      }
    },
    "/location": {
      "get": {
        "operationId": "SearchApprenticeshipsController_Location_Get",
        "summary": "Set location search parameters.",
        "parameters": [
          {
            "name": "routeIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Rendered location search page."
          }
        }
      },
      "post": {
        "operationId": "SearchApprenticeshipsController_Location_Post",
        "summary": "Submit location search parameters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirect after submitting location."
          }
        }
      }
    },
    "/apprenticeships": {
      "get": {
        "operationId": "SearchApprenticeshipsController_SearchResults",
        "summary": "Perform search and return results.",
        "parameters": [
          {
            "name": "RouteIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "LevelIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "Location",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Distance",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results rendered."
          }
        }
      }
    },
    "/map-search-results": {
      "get": {
        "operationId": "SearchApprenticeshipsController_MapSearchResults",
        "summary": "Retrieve map-based search results.",
        "parameters": [
          {
            "name": "RouteIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "LevelIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "Distance",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved map search results."
          }
        }
      }
    },
    "/search-results/save/{vacancyId}": {
      "post": {
        "operationId": "SearchApprenticeshipsController_SearchResults_SaveVacancy",
        "summary": "Save a vacancy from search results.",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vacancy saved."
          }
        }
      }
    },
    "/search-results/delete/{vacancyId}": {
      "post": {
        "operationId": "SearchApprenticeshipsController_SearchResults_DeleteSavedVacancy",
        "summary": "Delete a saved vacancy from search results.",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Vacancy deleted."
          }
        }
      }
    },
    "/apprenticeships/save-search": {
      "post": {
        "operationId": "SearchApprenticeshipsController_SaveSearch",
        "summary": "Save search for apprenticeships.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSearchRequest"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "redirect",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search saved."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BrowseByInterestViewModel": {
        "type": "object",
        "properties": {
          "SelectedRouteIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "Routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteViewModel"
            }
          },
          "BusinessFinanceAndPublicServicesDictionary": {
            "type": "object"
          },
          "CreativeAndServiceIndustriesDictionary": {
            "type": "object"
          },
          "EnvironmentAndAgricultureDictionary": {
            "type": "object"
          },
          "PeopleAndCareDictionary": {
            "type": "object"
          },
          "TechnicalAndEngineeringDictionary": {
            "type": "object"
          }
        }
      },
      "RouteViewModel": {
        "type": "object",
        "properties": {
          "Selected": {
            "type": "boolean"
          },
          "Name": {
            "type": "string"
          },
          "Id": {
            "type": "integer"
          }
        }
      },
      "LocationViewModel": {
        "type": "object",
        "properties": {
          "NationalSearch": {
            "type": "boolean",
            "nullable": true
          },
          "SearchTerm": {
            "type": "string",
            "nullable": true
          },
          "Distance": {
            "type": "integer",
            "nullable": true
          },
          "SuggestedLocationSelected": {
            "type": "boolean"
          },
          "SelectedRouteIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "SaveSearchRequest": {
        "type": "object",
        "properties": {
          "Data": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
