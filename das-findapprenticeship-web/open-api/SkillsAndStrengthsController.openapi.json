{
  "openapi": "3.1.0",
  "info": {
    "title": "Skills and Strengths API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/skillsandstrengths/": {
      "get": {
        "summary": "Retrieve expected skills and strengths for an application",
        "operationId": "getSkillsAndStrengths",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Skills and strengths retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillsAndStrengthsViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      },
      "post": {
        "summary": "Update skills and strengths for an application",
        "operationId": "postSkillsAndStrengths",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SkillsAndStrengthsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Skills and strengths updated successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SkillsAndStrengthsViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "isSectionComplete": {
            "type": "boolean",
            "nullable": true
          },
          "skillsAndStrengths": {
            "type": "string",
            "nullable": true
          },
          "employer": {
            "type": "string",
            "nullable": true
          },
          "expectedSkillsAndStrengths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "autoSave": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
