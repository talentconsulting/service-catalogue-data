{
  "openapi": "3.1.0",
  "info": {
    "title": "LocationsController API",
    "version": "1.0.0"
  },
  "paths": {
    "/locations": {
      "get": {
        "operationId": "LocationsBySearch",
        "summary": "Get locations by search term",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The term to search for locations"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocationViewModel": {
        "type": "object",
        "properties": {
          "Locations": {
            "$ref": "#/components/schemas/LocationsBySearchViewModel"
          }
        }
      },
      "LocationsBySearchViewModel": {
        "type": "object",
        "properties": {
          "Locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LocationBySearchViewModel"
            }
          }
        }
      },
      "LocationBySearchViewModel": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
