{
  "openapi": "3.1.0",
  "info": {
    "title": "Saved Searches API",
    "version": "1.0.0"
  },
  "paths": {
    "/saved-searches/unsubscribe": {
      "get": {
        "operationId": "GetSavedSearchesUnsubscribe",
        "summary": "Get unsubscribe saved searches",
        "tags": [
          "Saved Searches"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched unsubscribe saved searches",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnsubscribeSavedSearchesViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to default service start route"
          }
        }
      },
      "post": {
        "operationId": "PostSavedSearchesUnsubscribe",
        "summary": "Unsubscribe from saved searches",
        "tags": [
          "Saved Searches"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnsubscribeSavedSearchesModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to unsubscribe complete route"
          }
        }
      }
    },
    "/saved-searches/unsubscribe-complete": {
      "get": {
        "operationId": "GetUnsubscribeComplete",
        "summary": "Get unsubscribe complete",
        "tags": [
          "Saved Searches"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched unsubscribe completion details"
          },
          "302": {
            "description": "Redirect to default service start route"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnsubscribeSavedSearchesModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string",
            "maxLength": 250
          }
        },
        "required": [
          "Id",
          "Title"
        ]
      },
      "UnsubscribeSavedSearchesViewModel": {
        "type": "object",
        "properties": {
          "SavedSearch": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
