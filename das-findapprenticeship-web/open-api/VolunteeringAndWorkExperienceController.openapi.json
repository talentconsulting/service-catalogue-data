  "components": {
    "schemas": {
      "VolunteeringAndWorkExperienceViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "backLinkUrl": {
            "type": "string",
            "nullable": true
          },
          "doYouWantToAddAnyVolunteeringOrWorkExperience": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "AddVolunteeringAndWorkExperienceViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isCurrentRole": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "VolunteeringAndWorkExperienceSummaryViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "backLinkUrl": {
            "type": "string",
            "nullable": true
          },
          "addAnotherVolunteeringAndWorkExperienceLinkUrl": {
            "type": "string",
            "nullable": true
          },
          "isSectionCompleted": {
            "type": "boolean",
            "nullable": true
          },
          "workHistories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkHistoryViewModel"
            }
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "EditVolunteeringAndWorkExperienceViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "volunteeringOrWorkExperienceId": {
            "type": "string",
            "format": "uuid"
          },
          "companyName": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isCurrentRole": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "applicationId",
          "volunteeringOrWorkExperienceId"
        ]
      },
      "DeleteVolunteeringOrWorkExperienceViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "volunteeringWorkExperienceId": {
            "type": "string",
            "format": "uuid"
          },
          "dates": {
            "type": "string",
            "nullable": true
          },
          "organisation": {
            "type": "string",
            "nullable": true
          },
          "description": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "applicationId",
          "volunteeringWorkExperienceId"
        ]
      },
      "WorkHistoryViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "employer": {
            "type": "string",
            "nullable": true
