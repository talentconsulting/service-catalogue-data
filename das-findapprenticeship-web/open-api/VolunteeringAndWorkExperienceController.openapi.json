{
  "openapi": "3.1.0",
  "info": {
    "title": "Volunteering and Work Experience API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/volunteering-and-work-experience": {
      "get": {
        "summary": "Retrieve volunteering and work experience information",
        "operationId": "getVolunteeringAndWorkExperience",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Volunteering and Work Experience information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolunteeringAndWorkExperienceViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update whether to add volunteering and work experience",
        "operationId": "postVolunteeringAndWorkExperience",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VolunteeringAndWorkExperienceViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Update successful"
          }
        }
      }
    },
    "/apply/{applicationId}/volunteering-and-work-experience/add": {
      "get": {
        "summary": "Get view for adding a new work experience entry",
        "operationId": "getAddVolunteeringAndWorkExperience",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View for adding a volunteering or work experience",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddVolunteeringAndWorkExperienceViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a new volunteering or work experience entry",
        "operationId": "postAddVolunteeringAndWorkExperience",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddVolunteeringAndWorkExperienceViewModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Volunteering or work experience added successfully"
          }
        }
      }
    },
    "/apply/{applicationId}/volunteering-and-work-experience/summary": {
      "get": {
        "summary": "Retrieve summary information of volunteering and work experiences",
        "operationId": "getVolunteeringAndWorkExperienceSummary",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Summary of volunteering and work experience retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VolunteeringAndWorkExperienceSummaryViewModel"
