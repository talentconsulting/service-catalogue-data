            }
          },
          {
            "name": "volunteeringWorkExperienceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Volunteering/work experience details retrieved for deletion",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteVolunteeringOrWorkExperienceViewModel"
