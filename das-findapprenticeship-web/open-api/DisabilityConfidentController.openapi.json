          },
          "applyUnderDisabilityConfidentScheme": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "applicationId"
        ]
      },
      "DisabilityConfidentSummaryViewModel": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          },
          "backLinkUrl": {
            "type": "string",
            "nullable": true
          },
          "isApplyUnderDisabilityConfidentSchemeRequired": {
            "type": "boolean"
          },
          "isSectionCompleted": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "applicationId",
          "isApplyUnderDisabilityConfidentSchemeRequired"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
