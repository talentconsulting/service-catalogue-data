{
  "openapi": "3.1.0",
  "info": {
    "title": "Disability Confident API",
    "version": "1.0.0"
  },
  "paths": {
    "/apply/{applicationId}/disability-confident": {
      "get": {
        "tags": [
          "Disability Confident"
        ],
        "summary": "Get Disability Confident details",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disability Confident details",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect if not in edit mode"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "tags": [
          "Disability Confident"
        ],
        "summary": "Update Disability Confident details",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisabilityConfidentViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation failed and returns updated view",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect on successful update"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/apply/{applicationId}/disability-confident/confirm": {
      "get": {
        "tags": [
          "Disability Confident Confirmation"
        ],
        "summary": "Get Disability Confident confirmation details",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Disability Confident summary",
            "content": {
              "text/html": {}
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "tags": [
          "Disability Confident Confirmation"
        ],
        "summary": "Confirm and save Disability Confident section",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "isEdit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DisabilityConfidentSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation failed and returns updated view",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect on successful confirmation"
          }
        },
        "security": [
          {
            "OAuth2": []
