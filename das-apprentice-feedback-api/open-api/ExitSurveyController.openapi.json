{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback Exit Survey API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/ExitSurvey/": {
      "post": {
        "summary": "Create Exit Survey",
        "operationId": "CreateExitSurvey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExitSurveyCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateExitSurveyCommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateExitSurveyCommand": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          },
          "AllowContact": {
            "type": "boolean"
          },
          "DidNotCompleteApprenticeship": {
            "type": "boolean"
          },
          "AttributeIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "PrimaryReason": {
            "type": "integer"
          }
        },
        "required": [
          "ApprenticeFeedbackTargetId",
          "AllowContact",
          "DidNotCompleteApprenticeship",
          "AttributeIds",
          "PrimaryReason"
        ]
      },
      "CreateExitSurveyCommandResponse": {
        "type": "object",
        "properties": {
          "ApprenticeExitSurveyId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "ApprenticeExitSurveyId"
        ]
      }
    }
  }
}
