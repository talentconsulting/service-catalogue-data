{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/FeedbackTargetVariant/process-variants": {
      "post": {
        "summary": "Process Feedback Target Variants",
        "operationId": "ProcessVariants",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessFeedbackTargetVariantsCommand"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request accepted and queued for processing."
          },
          "400": {
            "description": "Bad Request, error encountered while processing the request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProcessFeedbackTargetVariantsCommand": {
        "type": "object",
        "properties": {
          "ClearStaging": {
            "type": "boolean"
          },
          "MergeStaging": {
            "type": "boolean"
          },
          "FeedbackTargetVariants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackTargetVariant"
            }
          }
        },
        "required": [
          "ClearStaging",
          "MergeStaging",
          "FeedbackTargetVariants"
        ]
      },
      "FeedbackTargetVariant": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "Variant": {
            "type": "string"
          }
        },
        "required": [
          "ApprenticeshipId",
          "Variant"
        ]
      }
    }
  }
}
