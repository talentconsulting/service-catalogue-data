{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/attributes/{attributeType}": {
      "get": {
        "summary": "Get Attributes",
        "operationId": "GetAttributes",
        "parameters": [
          {
            "name": "attributeType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The type of attributes to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of attributes for the specified type.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderAttribute"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. The attributeType parameter is invalid."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderAttribute": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
