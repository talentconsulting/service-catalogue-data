{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments Profile API",
    "version": "1.0.0"
  },
  "paths": {
    "/profile/{clientId}/changeemail/confirm": {
      "get": {
        "operationId": "ConfirmChangeEmail",
        "summary": "Confirm email change",
        "description": "Redirects to the authentication service to confirm email change.",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "description": "The unique identifier for the client.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "description": "The new email address to confirm.",
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "description": "The confirmation token.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the authentication service to confirm the email change."
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
