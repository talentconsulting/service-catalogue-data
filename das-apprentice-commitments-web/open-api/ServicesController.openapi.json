{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/account-details": {
      "get": {
        "summary": "Retrieve account details view",
        "operationId": "accountDetailsGet",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Resource environment is production (PRD) or resource not found"
          },
          "200": {
            "description": "View for account details retrieved successfully"
          }
        }
      },
      "post": {
        "summary": "Sign in using stub account details",
        "operationId": "accountDetailsPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StubAuthenticationViewModel"
              }
            }
          }
        },
        "responses": {
          "404": {
            "description": "Resource environment is production (PRD) or resource not found"
          },
          "302": {
            "description": "User successfully signed in and redirected to stub signed-in route"
          }
        }
      }
    },
    "/Stub-Auth": {
      "get": {
        "summary": "View for signed-in stub authentication details",
        "operationId": "stubSignedInGet",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Resource environment is production (PRD) or resource not found"
          },
          "200": {
            "description": "Stub signed-in view returned successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StubAuthenticationViewModel": {
        "type": "object",
        "properties": {
          "ReturnUrl": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
