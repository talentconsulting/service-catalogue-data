{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/register/{registrationCode}": {
      "get": {
        "summary": "Start registration with a registration code",
        "operationId": "RegisterWithCode",
        "parameters": [
          {
            "name": "registrationCode",
            "in": "path",
            "required": true,
            "description": "The registration code used for initialization",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to registration action"
          }
        }
      }
    },
    "/register": {
      "get": {
        "summary": "Complete registration for authenticated users",
        "operationId": "CompleteRegistration",
        "responses": {
          "302": {
            "description": "Redirect based on the registration and user state"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
