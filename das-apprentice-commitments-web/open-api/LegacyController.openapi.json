{
  "openapi": "3.1.0",
  "info": {
    "title": "Legacy Controller API",
    "version": "1.0.0"
  },
  "paths": {
    "/account": {
      "get": {
        "summary": "Redirect to Personal Details",
        "operationId": "getAccount",
        "parameters": [
          {
            "name": "registrationCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional parameter for account registration code."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the Personal Details section."
          }
        }
      }
    },
    "/termsofuse": {
      "get": {
        "summary": "Redirect to Terms of Use",
        "operationId": "getTermsOfUse",
        "parameters": [
          {
            "name": "registrationCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional parameter for account registration code."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the Terms of Use section."
          }
        }
      }
    }
  },
  "components": {}
}
