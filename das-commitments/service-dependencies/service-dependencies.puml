@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_commitments, "Commitments") {
  Container(c_commitments, "Commitments", "API")
  Container(c_commitments_external_handlers, "Commitments External Handlers", "Background Job")
  Container(c_commitments_jobs, "Commitments Jobs", "Background Job")
  Container(c_commitments_message_handlers, "Commitments Message Handlers", "Background Job")
}

SystemDb_Ext(d_cache_cache_storage, "Cache Storage")
SystemDb_Ext(d_cache_redis, "Redis", "Redis")
System_Ext(d_cloud_service_authentication_service, "Authentication Service")
System_Ext(d_cloud_service_encoding_service, "Encoding Service")
SystemDb_Ext(d_database_provider_commitments, "Provider Commitments", "Entity Framework Core (ProviderCommitmentsDbContext)")
System_Ext(d_grpc_service_reservations_api, "Reservations API", "gRPC")
System_Ext(d_http_api_account, "Account", "HttpClient")
System_Ext(d_http_api_approvals_outer, "Approvals Outer")
