Rel(c_commitments, d_cloud_service_authentication_service, "Uses")
Rel(c_commitments, d_cloud_service_encoding_service, "Uses")
Rel(c_commitments_message_handlers, d_database_provider_commitments, "Reads from and writes to", "Entity Framework Core (ProviderCommitmentsDbContext)")
Rel(c_commitments, d_database_provider_commitments, "Reads from and writes to", "Entity Framework Core")
Rel(c_commitments_jobs, d_database_provider_commitments, "Reads from and writes to", "Entity Framework")
