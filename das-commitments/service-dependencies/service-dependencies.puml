Rel(c_commitments, d_http_api_levy_transfer_matching, "Calls the API of", "HttpClient")
Rel(c_commitments_jobs, d_http_api_provider_relationships, "Calls the API of", "HttpClient")
Rel(c_commitments_jobs, d_http_api_reservations, "Calls the API of")
Rel(c_commitments, d_http_api_reservations, "Calls the API of", "HttpClient")
Rel(c_commitments, d_message_broker_nservicebus, "Publishes messages to and consumes messages from", "NServiceBus")
Rel(c_commitments_external_handlers, d_message_broker_nservicebus, "Publishes messages to and consumes messages from", "NServiceBus")
Rel(c_commitments, d_object_storage_azure_blob_storage, "Stores objects in", "Azure Blob Storage")

@enduml
