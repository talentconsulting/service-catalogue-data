System_Ext(d_http_api_provider_relationships, "Provider Relationships", "HttpClient")
System_Ext(d_http_api_reservations, "Reservations")
SystemQueue_Ext(d_message_broker_nservicebus, "NServiceBus", "NServiceBus")
SystemDb_Ext(d_object_storage_azure_blob_storage, "Azure Blob Storage", "Azure Blob Storage")

Rel(c_commitments, d_cache_cache_storage, "Caches data in")
