{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Updates API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship updates, including retrieval, acceptance, rejection, and undo operations."
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/updates": {
      "get": {
        "summary": "Get Apprenticeship Updates",
        "description": "Retrieve updates for an apprenticeship based on its status.",
        "operationId": "getApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship."
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipUpdateStatus"
            },
            "description": "Filter updates by their status."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of apprenticeship updates.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Apprenticeship Updates"
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/accept-apprenticeship-update": {
      "post": {
        "summary": "Accept Apprenticeship Update",
        "description": "Accept a specific apprenticeship update.",
        "operationId": "acceptApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully accepted the apprenticeship update."
          }
        },
        "tags": [
          "Apprenticeship Updates"
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/reject-apprenticeship-update": {
      "post": {
        "summary": "Reject Apprenticeship Update",
        "description": "Reject a specific apprenticeship update.",
        "operationId": "rejectApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully rejected the apprenticeship update."
          }
        },
        "tags": [
          "Apprenticeship Updates"
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/undo-apprenticeship-update": {
      "post": {
        "summary": "Undo Apprenticeship Update",
        "description": "Undo a specific apprenticeship update.",
        "operationId": "undoApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UndoApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully undone the apprenticeship update."
          }
        },
        "tags": [
          "Apprenticeship Updates"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipUpdateStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected",
          "Deleted",
          "Superceded",
          "Expired"
        ],
        "description": "Status of the apprenticeship update."
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "description": "User details associated with the operation."
      },
      "SaveDataRequest": {
        "type": "object",
        "properties": {
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "description": "Base class for requests that include user information."
      },
      "AcceptApprenticeshipUpdatesRequest": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/SaveDataRequest"
          }
        ],
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "Request schema for accepting apprenticeship updates."
      },
      "RejectApprenticeshipUpdatesRequest": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/SaveDataRequest"
          }
        ],
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "Request schema for rejecting apprenticeship updates."
      },
      "UndoApprenticeshipUpdatesRequest": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/SaveDataRequest"
          }
        ],
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "Request schema for undoing apprenticeship updates."
      },
      "GetApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ApprenticeshipUpdateStatus"
          }
        },
        "description": "Request schema for retrieving apprenticeship updates."
      },
      "GetApprenticeshipUpdatesResponse": {
        "type": "object",
        "description": "Response schema for retrieving apprenticeship updates.",
        "properties": {
          "updates": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "The updates retrieved."
          }
        }
      }
    }
  }
}
