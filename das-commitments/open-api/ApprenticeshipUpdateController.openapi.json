{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Update Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/updates": {
      "get": {
        "summary": "Get Apprenticeship Updates",
        "operationId": "GetApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipUpdateStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved apprenticeship updates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/accept-apprenticeship-update": {
      "post": {
        "summary": "Accept Apprenticeship Updates",
        "operationId": "AcceptApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully accepted apprenticeship updates"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/reject-apprenticeship-update": {
      "post": {
        "summary": "Reject Apprenticeship Updates",
        "operationId": "RejectApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully rejected apprenticeship updates"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/undo-apprenticeship-update": {
      "post": {
        "summary": "Undo Apprenticeship Updates",
        "operationId": "UndoApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UndoApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully undid apprenticeship updates"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/ApprenticeshipUpdateStatus"
          }
        }
      },
      "AcceptApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "accountId",
          "userInfo"
        ]
      },
      "RejectApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "accountId",
          "userInfo"
        ]
      },
      "UndoApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "accountId",
          "userInfo"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ApprenticeshipUpdateStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected",
          "Deleted",
          "Superceded",
          "Expired"
        ]
      },
      "GetApprenticeshipUpdatesResponse": {
        "type": "object",
        "properties": {
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
