{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/updates": {
      "get": {
        "summary": "Get Apprenticeship Updates",
        "operationId": "GetApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Status",
            "in": "query",
            "required": false,
            "description": "The status of the apprenticeship update",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipUpdateStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of apprenticeship updates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/accept-apprenticeship-update": {
      "post": {
        "summary": "Accept Apprenticeship Updates",
        "operationId": "AcceptApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update successfully accepted"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/reject-apprenticeship-update": {
      "post": {
        "summary": "Reject Apprenticeship Updates",
        "operationId": "RejectApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update successfully rejected"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/updates/undo-apprenticeship-update": {
      "post": {
        "summary": "Undo Apprenticeship Updates",
        "operationId": "UndoApprenticeshipUpdates",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UndoApprenticeshipUpdatesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update successfully undone"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "AccountId",
          "ApprenticeshipId",
          "UserInfo"
        ]
      },
      "RejectApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "AccountId",
          "ApprenticeshipId",
          "UserInfo"
        ]
      },
      "UndoApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "AccountId",
          "ApprenticeshipId",
          "UserInfo"
        ]
      },
      "GetApprenticeshipUpdatesResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetApprenticeshipUpdatesRequest": {
        "type": "object",
        "properties": {
          "Status": {
            "$ref": "#/components/schemas/ApprenticeshipUpdateStatus"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      },
      "ApprenticeshipUpdateStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected",
          "Deleted",
          "Superceded",
          "Expired"
        ]
      }
    }
  }
}
