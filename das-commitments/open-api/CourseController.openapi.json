{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/courses": {
      "get": {
        "operationId": "GetAllCourses",
        "summary": "Retrieve all courses",
        "responses": {
          "200": {
            "description": "A list of all available courses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ]
          },
          "MaxFunding": {
            "type": "integer",
            "format": "int32"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "LarsCode",
          "Title",
          "Level",
          "LearningType",
          "MaxFunding"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
