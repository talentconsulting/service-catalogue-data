{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/courses": {
      "get": {
        "summary": "Retrieve all courses",
        "operationId": "getAllCourses",
        "tags": [
          "Courses"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "MaxFunding": {
            "type": "integer"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      }
    }
  }
}
