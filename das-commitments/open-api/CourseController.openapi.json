{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "description": "API for managing apprenticeship commitments.",
    "version": "2.0.0"
  },
  "paths": {
    "/api/courses": {
      "get": {
        "summary": "Get all courses",
        "operationId": "GetAllCourses",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "larsCode": {
            "type": "string",
            "description": "The Learning Aim Reference Service (LARS) code for the course."
          },
          "title": {
            "type": "string",
            "description": "The title of the course."
          },
          "level": {
            "type": "string",
            "description": "The education level of the course."
          },
          "learningType": {
            "type": "string",
            "description": "Type of learning associated with the course."
          },
          "maxFunding": {
            "type": "integer",
            "description": "The maximum funding for the course."
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "The date from which the course is effective."
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time",
            "description": "The date to which the course is effective."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
