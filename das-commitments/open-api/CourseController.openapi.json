{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0",
    "description": "API for managing course commitments."
  },
  "paths": {
    "/api/courses": {
      "get": {
        "summary": "Retrieve all courses",
        "responses": {
          "200": {
            "description": "List of courses successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        },
        "required": [
          "Courses"
        ]
      },
      "Course": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ]
          },
          "MaxFunding": {
            "type": "integer"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "LarsCode",
          "Title",
          "Level",
          "LearningType",
          "MaxFunding"
        ]
      }
    }
  }
}
