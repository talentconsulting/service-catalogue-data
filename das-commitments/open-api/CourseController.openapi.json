{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/courses": {
      "get": {
        "operationId": "CourseController_GetAll",
        "summary": "Retrieve all available courses.",
        "responses": {
          "200": {
            "description": "A list of all available courses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCoursesResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllCoursesResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "Courses"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
