{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/providers": {
      "get": {
        "summary": "Get all providers",
        "operationId": "GetAllProviders",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/providers/{providerId}": {
      "get": {
        "summary": "Get a specific provider",
        "operationId": "GetProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider not found"
          }
        }
      }
    },
    "/api/providers/{providerId}/commitmentagreements": {
      "get": {
        "summary": "Get commitment agreements for a provider",
        "operationId": "GetCommitmentAgreements",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider whose commitment agreements to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderCommitmentAgreementResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllProvidersResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Provider"
            }
          }
        }
      },
      "Provider": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "GetProviderResponse": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "GetProviderCommitmentAgreementResponse": {
        "type": "object",
        "properties": {
          "ProviderCommitmentAgreement": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderCommitmentAgreement"
            }
          }
        }
      },
      "ProviderCommitmentAgreement": {
        "type": "object",
        "properties": {
          "LegalEntityName": {
            "type": "string"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          }
        }
      }
    }
  }
}
