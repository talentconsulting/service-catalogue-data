{
  "openapi": "3.1.0",
  "info": {
    "title": "Data Locks API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/datalocks": {
      "get": {
        "operationId": "GetDataLocks",
        "summary": "Retrieve data locks for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing data locks.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLocksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocksummaries": {
      "get": {
        "operationId": "GetDataLockSummaries",
        "summary": "Retrieve data lock summaries for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing data lock summaries.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockSummariesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/accept-changes": {
      "post": {
        "operationId": "AcceptDataLockChanges",
        "summary": "Accept data lock changes for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgment that the accept operation was successful."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/reject-changes": {
      "post": {
        "operationId": "RejectDataLockChanges",
        "summary": "Reject data lock changes for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgment that the reject operation was successful."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/triage": {
      "post": {
        "operationId": "TriageDataLocks",
        "summary": "Perform triage on data locks for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageDataLocksRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgment that the triage operation was successful."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLocksResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetDataLockSummariesResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "AcceptDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "RejectDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "TriageDataLocksRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "TriageStatus": {
            "$ref": "#/components/schemas/TriageStatus"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "TriageStatus": {
        "type": "string",
        "enum": [
          "Unknown",
          "Change",
          "Restart",
          "FixIlr"
        ]
      }
    }
  }
}
