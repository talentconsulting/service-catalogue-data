{
  "openapi": "3.1.0",
  "info": {
    "title": "Data Locks API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship data locks."
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/datalocks": {
      "get": {
        "summary": "Get Data Locks",
        "operationId": "GetDataLocks",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLocksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocksummaries": {
      "get": {
        "summary": "Get Data Lock Summaries",
        "operationId": "GetDataLockSummaries",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockSummariesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/accept-changes": {
      "post": {
        "summary": "Accept Data Lock Changes",
        "operationId": "AcceptDataLockChanges",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/reject-changes": {
      "post": {
        "summary": "Reject Data Lock Changes",
        "operationId": "RejectDataLockChanges",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/triage": {
      "post": {
        "summary": "Triage Data Locks",
        "operationId": "TriageDataLocks",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageDataLocksRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLocksResponse": {
        "type": "object",
        "properties": {
          "dataLocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataLockStatus"
            }
          }
        }
      },
      "GetDataLockSummariesResponse": {
        "type": "object",
        "properties": {
          "summaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DataLockStatus"
            }
          }
        }
      },
      "AcceptDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "UserInfo"
        ]
      },
      "RejectDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "UserInfo"
        ]
      },
      "TriageDataLocksRequest": {
        "type": "object",
        "properties": {
          "TriageStatus": {
            "$ref": "#/components/schemas/TriageStatus"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "TriageStatus",
          "UserInfo"
        ]
      },
      "DataLockStatus": {
        "type": "object",
        "properties": {
          "DataLockEventId": {
            "type": "integer",
            "format": "int64"
          },
          "DataLockEventDatetime": {
            "type": "string",
            "format": "date-time"
          },
          "PriceEpisodeIdentifier": {
            "type": "string"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "IlrTrainingCourseCode": {
            "type": "string"
          },
          "IlrTrainingType": {
            "$ref": "#/components/schemas/TrainingType"
          },
          "IlrActualStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "IlrEffectiveFromDate": {
            "type": "string",
            "format": "date-time"
          },
          "IlrPriceEffectiveToDate": {
            "type": "string",
            "format": "date-time"
          },
          "IlrTotalCost": {
            "type": "number",
            "format": "decimal"
          },
          "Status": {
            "$ref": "#/components/schemas/Status"
          },
          "TriageStatus": {
            "$ref": "#/components/schemas/TriageStatus"
          },
          "ErrorCode": {
            "$ref": "#/components/schemas/DataLockErrorCode"
          },
          "ApprenticeshipUpdateId": {
            "type": "integer",
            "format": "int64"
          },
          "IsResolved": {
            "type": "boolean"
          },
          "EventStatus": {
            "$ref": "#/components/schemas/EventStatus"
          },
          "IsExpired": {
            "type": "boolean"
          },
          "Expired": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "TriageStatus": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "description": "The triage status for a data lock."
      },
      "DataLockErrorCode": {
        "type": "integer",
        "description": "The error codes for data locks."
      },
      "Status": {
        "type": "integer",
        "enum": [
          0,
          1,
          2
        ],
        "description": "The status of a data lock."
      },
      "TrainingType": {
        "type": "integer",
        "enum": [
          0,
          1
        ],
        "description": "The type of training associated with the apprenticeship."
      },
      "EventStatus": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "description": "The event status of the data lock."
      }
    }
  }
}
