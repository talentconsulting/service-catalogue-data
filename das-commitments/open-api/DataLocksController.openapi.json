{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 Data Locks API",
    "version": "1.0.0",
    "description": "API for managing data locks in apprenticeship commitments."
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/datalocks": {
      "get": {
        "summary": "Get Data Locks",
        "description": "Retrieve data locks for a given apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "responses": {
          "200": {
            "description": "Data locks retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLocksResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocksummaries": {
      "get": {
        "summary": "Get Data Lock Summaries",
        "description": "Retrieve summaries of data locks for a given apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "responses": {
          "200": {
            "description": "Data lock summaries retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockSummariesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/accept-changes": {
      "post": {
        "summary": "Accept Data Lock Changes",
        "description": "Accept changes to data locks for a given apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data lock changes accepted successfully."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/reject-changes": {
      "post": {
        "summary": "Reject Data Lock Changes",
        "description": "Reject changes to data locks for a given apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RejectDataLocksRequestChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data lock changes rejected successfully."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/datalocks/triage": {
      "post": {
        "summary": "Triage Data Locks",
        "description": "Triage data locks for a given apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the apprenticeship."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriageDataLocksRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Data locks triaged successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLocksResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetDataLockSummariesResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "AcceptDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "RejectDataLocksRequestChangesRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "TriageDataLocksRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "TriageStatus": {
            "$ref": "#/components/schemas/TriageStatus"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "TriageStatus": {
        "type": "string",
        "enum": [
          "Unknown",
          "Change",
          "Restart",
          "FixIlr"
        ]
      }
    }
  }
}
