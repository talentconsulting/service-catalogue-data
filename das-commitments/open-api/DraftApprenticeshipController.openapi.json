{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/cohorts/{cohortId}/draft-apprenticeships": {
      "get": {
        "operationId": "GetAllDraftApprenticeships",
        "summary": "Retrieve all draft apprenticeships for a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of draft apprenticeships.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "No draft apprenticeships found in the cohort."
          }
        }
      },
      "post": {
        "operationId": "AddDraftApprenticeship",
        "summary": "Add a draft apprenticeship to a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The draft apprenticeship was successfully added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "get": {
        "operationId": "GetDraftApprenticeship",
        "summary": "Retrieve a specific draft apprenticeship by ID.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The draft apprenticeship.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "The requested apprenticeship was not found."
          }
        }
      },
      "put": {
        "operationId": "UpdateDraftApprenticeship",
        "summary": "Update a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The draft apprenticeship was successfully updated."
          }
        }
      },
      "post": {
        "operationId": "DeleteDraftApprenticeship",
        "summary": "Delete a draft apprenticeship from a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The draft apprenticeship was successfully deleted."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-summary": {
      "get": {
        "operationId": "GetPriorLearningSummary",
        "summary": "Retrieve prior learning summary for a specific draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The prior learning summary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipPriorLearningSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "The prior learning summary was not found."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/recognise-prior-learning": {
      "post": {
        "operationId": "RecognisePriorLearning",
        "summary": "Set recognition of prior learning for a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecognisePriorLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The prior learning recognition was successfully updated."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-data": {
      "post": {
        "operationId": "UpdatePriorLearningData",
        "summary": "Update prior learning data for a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorLearningDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The prior learning data was successfully updated."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/email": {
      "put": {
        "operationId": "AddApprenticeshipEmail",
        "summary": "Add an email to a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipAddEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The email was added successfully."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{draftApprenticeshipId}/reference": {
      "put": {
        "operationId": "SetApprenticeshipReference",
        "summary": "Set a reference for a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipSetReferenceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reference was set successfully for the draft apprenticeship."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer",
            "format": "int32"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "EmploymentPrice": {
            "type": "integer",
            "format": "int32"
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32"
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AddDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DeleteDraftApprenticeshipRequest": {
        "type": "object"
      },
      "DraftApprenticeshipAddEmailRequest": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Party": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
