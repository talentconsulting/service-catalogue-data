        "responses": {
          "200": {
            "description": "Draft apprenticeship retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "The apprenticeship was not found"
          }
