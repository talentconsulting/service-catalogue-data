{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship API",
    "version": "1.0.0",
    "description": "API for handling cohort-based draft apprenticeships."
  },
  "paths": {
    "/api/cohorts/{cohortId}/draft-apprenticeships": {
      "get": {
        "summary": "Get all draft apprenticeships in a cohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched all draft apprenticeships",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "No draft apprenticeships found"
          }
        }
      },
      "post": {
        "summary": "Add a new draft apprenticeship to a cohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully added a new draft apprenticeship",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get a specific draft apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched the draft apprenticeship",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft apprenticeship not found"
          }
        }
      },
      "put": {
        "summary": "Update a specific draft apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated the draft apprenticeship"
          }
        }
      },
      "post": {
        "summary": "Delete a specific draft apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully deleted the draft apprenticeship"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-summary": {
      "get": {
        "summary": "Get prior learning summary for a draft apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched prior learning summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipPriorLearningSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Prior learning summary not found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/recognise-prior-learning": {
      "post": {
        "summary": "Recognise prior learning for an apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecognisePriorLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated prior learning recognition"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-data": {
      "post": {
        "summary": "Update prior learning data for an apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorLearningDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated prior learning data"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/email": {
      "put": {
        "summary": "Add apprenticeship email",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipAddEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully added apprenticeship email"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{draftApprenticeshipId}/reference": {
      "put": {
        "summary": "Set apprenticeship reference",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipSetReferenceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully set apprenticeship reference"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "EndPointAssessmentPrice": {
            "type": "integer"
          },
          "LearnerDataId": {
            "type": "integer"
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer"
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer"
          }
        }
      },
      "AddDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer"
          }
        }
      },
      "GetDraftApprenticeshipPriorLearningSummaryResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "CohortId": {
            "type": "integer"
          },
          "TrainingTotalHours": {
            "type": "integer"
          },
          "DurationReducedByHours": {
            "type": "integer"
          },
          "PriceReducedBy": {
            "type": "integer"
          },
          "FundingBandMaximum": {
            "type": "integer"
          },
          "PercentageOfPriorLearning": {
            "type": "number"
          },
          "MinimumPercentageReduction": {
            "type": "number"
          },
          "MinimumPriceReduction": {
            "type": "integer"
          },
          "RplPriceReductionError": {
            "type": "boolean"
          }
        }
      },
      "GetDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {}
      },
      "GetDraftApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDraftApprenticeshipResponse"
            }
          }
        }
      },
      "DeleteDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {}
      },
      "UpdateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "CourseOption": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "Cost": {
            "type": "integer"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "EndPointAssessmentPrice": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Reference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer"
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer"
          },
          "HasLearnerDataChanges": {
            "type": "boolean"
          },
          "LastLearnerDataSync": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DraftApprenticeshipAddEmailRequest": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Party": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "DraftApprenticeshipSetReferenceRequest": {
        "type": "object",
        "properties": {
          "Reference": {
            "type": "string"
          },
          "Party": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "RecognisePriorLearningRequest": {
        "type": "object",
        "properties": {
          "RecognisePriorLearning": {
            "type": "boolean"
          }
        }
      },
      "PriorLearningDataRequest": {
        "type": "object",
        "properties": {
          "TrainingTotalHours": {
            "type": "integer"
          },
          "DurationReducedByHours": {
            "type": "integer"
          },
          "IsDurationReducedByRpl": {
            "type": "boolean"
          },
          "DurationReducedBy": {
            "type": "integer"
          },
          "PriceReducedBy": {
            "type": "integer"
          },
          "MinimumOffTheJobTrainingHoursRequired": {
            "type": "integer"
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "Employer",
          "Provider",
          "TransferSender",
          "None"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
