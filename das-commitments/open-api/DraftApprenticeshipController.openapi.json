      },
      "put": {
        "summary": "Update a draft apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship updated successfully"
          }
        }
      },
      "post": {
        "summary": "Delete a draft apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship deleted successfully"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-summary": {
