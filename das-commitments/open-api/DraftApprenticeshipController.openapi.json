          },
          "CourseCode": {
            "type": "string"
          },
          "CourseOption": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "Cost": {
            "type": "integer"
          },
          "TrainingPrice": {
