            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "GetDraftApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeships": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetDraftApprenticeshipResponse": {
        "type": "object"
      },
      "GetDraftApprenticeshipPriorLearningSummaryResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingTotalHours": {
            "type": "integer",
            "format": "int32"
          },
          "DurationReducedByHours": {
            "type": "integer",
            "format": "int32"
          },
          "PriceReducedBy": {
            "type": "integer",
            "format": "int32"
          },
          "PercentageOfPriorLearning": {
            "type": "number",
            "format": "float"
          },
          "MinimumPercentageReduction": {
            "type": "number",
            "format": "float"
          },
          "MinimumPriceReduction": {
            "type": "integer",
            "format": "int32"
          },
          "RplPriceReductionError": {
            "type": "boolean"
          },
          "FundingBandMaximum": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RecognisePriorLearningRequest": {
        "type": "object",
        "properties": {
          "RecognisePriorLearning": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "PriorLearningDataRequest": {
        "type": "object",
        "properties": {
          "TrainingTotalHours": {
            "type": "integer",
            "format": "int32"
          },
          "DurationReducedByHours": {
            "type": "integer",
            "format": "int32"
          },
          "IsDurationReducedByRpl": {
            "type": "boolean"
          },
          "DurationReducedBy": {
            "type": "integer",
            "format": "int32"
          },
          "PriceReducedBy": {
            "type": "integer",
            "format": "int32"
          },
          "MinimumOffTheJobTrainingHoursRequired": {
            "type": "integer",
            "format": "int32"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UpdateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "CourseOption": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "Cost": {
            "type": "integer",
            "format": "int32"
          },
          "TrainingPrice": {
            "type": "integer",
            "format": "int32"
          },
          "EndPointAssessmentPrice": {
            "type": "integer",
            "format": "int32"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Reference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32"
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32"
          },
          "HasLearnerDataChanges": {
            "type": "boolean"
          },
          "LastLearnerDataSync": {
