{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.CommitmentsV2 API",
    "version": "1.0.0",
    "description": "API for managing draft apprenticeships within cohorts."
  },
  "paths": {
    "/api/cohorts/{cohortId}/draft-apprenticeships": {
      "get": {
        "summary": "Get all draft apprenticeships in a cohort",
        "operationId": "GetAllDraftApprenticeships",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Add a draft apprenticeship to a cohort",
        "operationId": "AddDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get a specific draft apprenticeship",
        "operationId": "GetDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft apprenticeship not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "summary": "Update a specific draft apprenticeship",
        "operationId": "UpdateDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship updated successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Delete a draft apprenticeship",
        "operationId": "DeleteDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship to delete"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship deleted successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-summary": {
      "get": {
        "summary": "Get prior learning summary of a draft apprenticeship",
        "operationId": "GetDraftApprenticeshipPriorLearningSummary",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipPriorLearningSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft apprenticeship or prior learning data not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/recognise-prior-learning": {
      "post": {
        "summary": "Update recognition of prior learning for a draft apprenticeship",
        "operationId": "RecognisePriorLearning",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecognisePriorLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prior learning recognition updated successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-data": {
      "post": {
        "summary": "Update prior learning data for a draft apprenticeship",
        "operationId": "UpdatePriorLearningData",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorLearningDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prior learning data updated successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{draftApprenticeshipId}/reference": {
      "put": {
        "summary": "Set the reference for a draft apprenticeship",
        "operationId": "SetApprenticeshipReference",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipSetReferenceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference updated successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/email": {
      "put": {
        "summary": "Add email for a draft apprenticeship",
        "operationId": "AddApprenticeshipEmail",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the cohort"
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the apprenticeship"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipAddEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email added successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
