{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeships API",
    "version": "1.0.0",
    "description": "API for managing draft apprenticeships within a cohort."
  },
  "paths": {
    "/api/cohorts/{cohortId}/draft-apprenticeships": {
      "get": {
        "summary": "Get all draft apprenticeships in a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the draft apprenticeships.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cohort or draft apprenticeships not found."
          }
        }
      },
      "post": {
        "summary": "Add a draft apprenticeship to a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get a specific draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft apprenticeship details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Draft apprenticeship not found."
          }
        }
      },
      "put": {
        "summary": "Update a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship updated successfully."
          }
        }
      },
      "post": {
        "summary": "Delete a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship deleted successfully."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-summary": {
      "get": {
        "summary": "Get prior learning summary for a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prior learning summary retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDraftApprenticeshipPriorLearningSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Prior learning summary not found."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/prior-learning-data": {
      "post": {
        "summary": "Update prior learning data for a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PriorLearningDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prior learning data updated successfully."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/recognise-prior-learning": {
      "post": {
        "summary": "Recognise prior learning for a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecognisePriorLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Prior learning recognition updated successfully."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}/email": {
      "put": {
        "summary": "Add apprenticeship email.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipAddEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email added successfully to the apprenticeship."
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/draft-apprenticeships/{draftApprenticeshipId}/reference": {
      "put": {
        "summary": "Set reference for a draft apprenticeship.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftApprenticeshipSetReferenceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reference set successfully for the draft apprenticeship."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDraftApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeships": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {}
      },
      "GetDraftApprenticeshipPriorLearningSummaryResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "TrainingTotalHours": {
            "type": "integer"
          },
          "DurationReducedByHours": {
            "type": "integer"
          },
          "PriceReducedBy": {
            "type": "integer"
          },
          "PercentageOfPriorLearning": {
            "type": "number",
            "format": "float"
          },
          "MinimumPercentageReduction": {
            "type": "number",
            "format": "float"
          },
          "MinimumPriceReduction": {
            "type": "integer"
          },
          "RplPriceReductionError": {
            "type": "boolean"
          },
          "FundingBandMaximum": {
            "type": "integer"
          }
        }
      },
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "EndPointAssessmentPrice": {
            "type": "integer"
          },
          "LearnerDataId": {
            "type": "integer",
            "format": "int64"
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer"
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer"
          }
        }
      },
      "AddDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UpdateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
        }
      },
      "PriorLearningDataRequest": {
        "type": "object",
        "properties": {
          "TrainingTotalHours": {
            "type": "integer"
          },
          "DurationReducedByHours": {
            "type": "integer"
          },
          "IsDurationReducedByRpl": {
            "type": "boolean"
          },
          "DurationReducedBy": {
            "type": "integer"
          },
          "PriceReducedBy": {
            "type": "integer"
          },
          "MinimumOffTheJobTrainingHoursRequired": {
            "type": "integer"
          }
        }
      },
      "RecognisePriorLearningRequest": {
        "type": "object",
        "properties": {
          "RecognisePriorLearning": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "DeleteDraftApprenticeshipRequest": {
        "type": "object"
      },
      "DraftApprenticeshipAddEmailRequest": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Party": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "DraftApprenticeshipSetReferenceRequest": {
        "type": "object",
        "properties": {
          "Reference": {
            "type": "string"
          },
          "Party": {
            "$ref": "#/components/schemas/Party"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
