{
  "openapi": "3.1.0",
  "info": {
    "title": "CommitmentsV2 Apprenticeship API",
    "description": "API for managing apprenticeships in the CommitmentsV2 project.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "tags": [
          "Apprenticeship"
        ],
        "description": "Gets the details of a specific apprenticeship by ID.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Apprenticeship not found."
          }
        }
      }
    },
    "/api/apprenticeships": {
      "get": {
        "tags": [
          "Apprenticeship"
        ],
        "description": "Retrieves a list of apprenticeships with optional filtering and pagination.",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageItemCount",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 10
            }
          },
          {
            "name": "sortField",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "reverseSort",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "employerName",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "providerName",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "courseName",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipStatus"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date",
              "nullable": true
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of apprenticeships retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "No apprenticeships found."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/stop": {
      "post": {
        "tags": [
          "Apprenticeship"
        ],
        "description": "Stops an apprenticeship identified by ID.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship stopped successfully."
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/declined-changes": {
      "get": {
        "tags": [
          "Apprenticeship"
        ],
        "description": "Gets details for declined changes of a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Declined changes retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "details": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No declined changes found."
          }
        }
      },
      "post": {
        "tags": [
          "Apprenticeship"
        ],
        "description": "Acknowledges declined changes for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeInvalidIlrChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Declined changes acknowledged successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "GetApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "apprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetApprenticeshipResponse"
            }
          }
        }
      },
      "StopApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "stopDate": {
            "type": "string",
            "format": "date"
          },
          "madeRedundant": {
            "type": "boolean"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "accountId",
          "stopDate",
          "madeRedundant"
        ]
      },
      "AcknowledgeInvalidIlrChangesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "acknowledgements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvalidIlrChangeAcknowledgement"
            }
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "providerId",
          "acknowledgements"
        ]
      },
      "InvalidIlrChangeAcknowledgement": {
        "type": "object",
        "properties": {
          "approvalRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "deleteAlert": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ApprenticeshipStatus": {
        "type": "string",
        "enum": [
          "WaitingToStart",
          "Live",
          "Paused",
          "Stopped",
          "Completed",
          "Unknown"
        ]
      }
    }
  }
}
