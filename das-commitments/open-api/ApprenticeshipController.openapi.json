{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get Apprenticeship Details",
        "operationId": "getApprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Apprenticeship not found"
          }
        }
      }
    },
    "/api/apprenticeships": {
      "get": {
        "summary": "Get Apprenticeships",
        "operationId": "getApprenticeships",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageItemCount",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of apprenticeships",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Apprenticeships not found"
          }
        }
      }
    },
    "/api/apprenticeships/details/editenddate": {
      "post": {
        "summary": "Edit Apprenticeship End Date",
        "operationId": "editEndDate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditEndDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "End date edited successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/stop": {
      "post": {
        "summary": "Stop Apprenticeship",
        "operationId": "stopApprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship stopped successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/payments": {
      "patch": {
        "summary": "Patch Apprenticeship Payments",
        "operationId": "patchPayments",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchApprenticeshipPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payments patched successfully"
          }
        }
      }
    },
    "/api/apprenticeships/details/pause": {
      "post": {
        "summary": "Pause Apprenticeship",
        "operationId": "pauseApprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship paused successfully"
          }
        }
      }
    },
    "/api/apprenticeships/details/resume": {
      "post": {
        "summary": "Resume Apprenticeship",
        "operationId": "resumeApprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship resumed successfully"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/declined-changes": {
      "get": {
        "summary": "Get Declined Changes",
        "operationId": "getDeclinedChanges",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Declined changes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeclinedChangesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Declined changes not found"
          }
        }
      },
      "post": {
        "summary": "Acknowledge Declined Changes",
        "operationId": "acknowledgeDeclinedChanges",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeInvalidIlrChangesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Declined changes acknowledged successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GetApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "apprenticeships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "apprenticeshipId": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        }
      },
      "EditEndDateRequest": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "StopApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "stopDate": {
            "type": "string",
            "format": "date-time"
          },
          "madeRedundant": {
            "type": "boolean"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "PatchApprenticeshipPaymentsRequest": {
        "type": "object",
        "properties": {
          "paymentFreezeDate": {
            "type": "string",
            "format": "date-time"
          },
          "freezePaymentsReason": {
            "type": "string"
          },
          "party": {
            "type": "integer"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "PauseApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ResumeApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "DeclinedChangesResponse": {
        "type": "object",
        "properties": {}
      },
      "AcknowledgeInvalidIlrChangesRequest": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "format": "int64"
          },
          "acknowledgements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "approvalRequestId": {
                  "type": "string",
                  "format": "uuid"
                },
                "deleteAlert": {
                  "type": "boolean"
                }
              }
            }
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
