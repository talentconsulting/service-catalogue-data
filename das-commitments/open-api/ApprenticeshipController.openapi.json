{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 Apprenticeship API",
    "description": "API for managing apprenticeships such as retrieval, updates, and validation of apprenticeship data.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get Apprenticeship Details",
        "operationId": "getApprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/apprenticeships": {
      "get": {
        "summary": "Get Apprenticeships",
        "operationId": "getApprenticeships",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageItemCount",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "EmployerName",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "ProviderName",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "CourseName",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "Status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipStatus"
            }
          },
          {
            "name": "StartDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "EndDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "AccountLegalEntityId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          },
          {
            "name": "StartDateRangeFrom",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "StartDateRangeTo",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "Alert",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Alerts"
            }
          },
          {
            "name": "ApprenticeConfirmationStatus",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ConfirmationStatus"
            }
          },
          {
            "name": "DeliveryModel",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/DeliveryModel"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/apprenticeships/filters": {
      "get": {
        "summary": "Get Apprenticeship Filters",
        "operationId": "getApprenticeshipsFilterValues",
        "parameters": [
          {
            "name": "ProviderId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          },
          {
            "name": "EmployerAccountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipResponse": {
        "type": "object",
        "properties": {}
      },
      "GetApprenticeshipsResponse": {
        "type": "object",
        "properties": {}
      },
      "ApprenticeshipStatus": {
        "type": "string",
        "enum": [
          "WaitingToStart",
          "Live",
          "Paused",
          "Stopped",
          "Completed",
          "Unknown"
        ]
      },
      "Alerts": {
        "type": "string",
        "enum": [
          "IlrDataMismatch",
          "ChangesPending",
          "ChangesRequested",
          "ChangesForReview",
          "ConfirmDates"
        ]
      },
      "ConfirmationStatus": {
        "type": "string",
        "enum": [
          "NA",
          "Overdue",
          "Unconfirmed",
          "Confirmed"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
