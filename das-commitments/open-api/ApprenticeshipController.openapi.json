{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get Apprenticeship by ID",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The apprenticeship.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships": {
      "get": {
        "summary": "Get Apprenticeships",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageItemCount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeships found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/filters": {
      "get": {
        "summary": "Get Apprenticeship Filters",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Filters found.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/details/editenddate": {
      "post": {
        "summary": "Edit Apprenticeship End Date",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditEndDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "End date updated successfully."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/stop": {
      "post": {
        "summary": "Stop Apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship stopped successfully."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/payments": {
      "patch": {
        "summary": "Patch Apprenticeship Payments",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchApprenticeshipPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payments patched successfully."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipResponse": {
        "type": "object",
        "properties": {}
      },
      "GetApprenticeshipsResponse": {
        "type": "object",
        "properties": {}
      },
      "EditEndDateRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "StopApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "StopDate": {
            "type": "string",
            "format": "date-time"
          },
          "MadeRedundant": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "PatchApprenticeshipPaymentsRequest": {
        "type": "object",
        "properties": {
          "PaymentFreezeDate": {
            "type": "string",
            "format": "date-time"
          },
          "FreezePaymentsReason": {
            "$ref": "#/components/schemas/FreezePaymentsReason"
          },
          "Party": {
            "type": "integer"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "FreezePaymentsReason": {
        "type": "string",
        "enum": [
          "LearnerOnBreak",
          "LearnerWithdrawn",
          "ChangeToTrainingDetails",
          "DisagreeWithAutoApprovedChange"
        ]
      }
    }
  }
}
