{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get details of an apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Apprenticeship not found"
          }
        }
      }
    },
    "/api/apprenticeships": {
      "get": {
        "summary": "Get apprenticeships",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageItemCount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Apprenticeships not found"
          }
        }
      }
    },
