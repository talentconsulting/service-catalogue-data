{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Commitments V2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get Apprenticeship by ID",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/apprenticeships": {
      "get": {
        "summary": "Get Apprenticeships",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/apprenticeships/filters": {
      "get": {
        "summary": "Get Apprenticeship Filters",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/apprenticeships/details/editenddate": {
      "post": {
        "summary": "Edit Apprenticeship End Date",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditEndDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/stop": {
      "post": {
        "summary": "Stop Apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/payments": {
      "patch": {
        "summary": "Patch Apprenticeship Payments",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchApprenticeshipPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/details/pause": {
      "post": {
        "summary": "Pause Apprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/details/resume": {
      "post": {
        "summary": "Resume Apprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/resendinvitation": {
      "post": {
        "summary": "Resend Apprenticeship Invitation",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDataRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    },
    "/api/apprenticeships/edit/validate": {
      "post": {
        "summary": "Validate Apprenticeship for Edit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateApprenticeshipForEditRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "GetApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "Apprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetApprenticeshipResponse"
            }
          }
        },
        "additionalProperties": false
      },
      "EditEndDateRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "additionalProperties": false
      },
      "StopApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "StopDate": {
            "type": "string",
            "format": "date-time"
          },
          "MadeRedundant": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "additionalProperties": false
      },
      "PatchApprenticeshipPaymentsRequest": {
        "type": "object",
        "properties": {
          "PaymentFreezeDate": {
            "type": "string",
            "format": "date-time"
          },
          "FreezePaymentsReason": {
            "type": "string",
            "enum": [
              "LearnerOnBreak",
              "LearnerWithdrawn",
              "ChangeToTrainingDetails",
              "DisagreeWithAutoApprovedChange"
            ]
          },
          "Party": {
            "type": "integer"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "additionalProperties": false
      },
      "PauseApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "additionalProperties": false
      },
      "ResumeApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "additionalProperties": false
      },
      "SaveDataRequest": {
        "type": "object",
        "properties": {
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "additionalProperties": true
      },
      "ValidateApprenticeshipForEditRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "EmployerAccountId": {
            "type": "integer"
          },
          "ProviderId": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Cost": {
            "type": "number"
          },
          "EmployerReference": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "ULN": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "string",
            "enum": [
              "Regular",
              "PortableFlexiJob",
              "FlexiJobAgency"
            ]
          },
          "Email": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
