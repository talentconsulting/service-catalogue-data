{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get an apprenticeship by ID",
        "tags": [
          "Apprenticeships"
        ],
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships": {
      "get": {
        "summary": "Get apprenticeships",
        "tags": [
          "Apprenticeships"
        ],
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "PageItemCount",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "EmployerName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ProviderName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CourseName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "WaitingToStart",
                "Live",
                "Paused",
                "Stopped",
                "Completed",
                "Unknown"
              ]
            }
          },
          {
            "name": "StartDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "EndDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "AccountLegalEntityId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "StartDateRangeFrom",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "StartDateRangeTo",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "Alert",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "IlrDataMismatch",
                "ChangesPending",
                "ChangesRequested",
                "ChangesForReview",
                "ConfirmDates"
              ]
            }
          },
          {
            "name": "ApprenticeConfirmationStatus",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "NA",
                "Overdue",
                "Unconfirmed",
                "Confirmed"
              ]
            }
          },
          {
            "name": "DeliveryModel",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "Regular",
                "PortableFlexiJob",
                "FlexiJobAgency"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships/filters": {
      "get": {
        "summary": "Get apprenticeship filters",
        "tags": [
          "Apprenticeships"
        ],
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/apprenticeships/details/editenddate": {
      "post": {
        "summary": "Edit apprenticeship end date",
        "tags": [
          "Apprenticeships"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditEndDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/stop": {
      "post": {
        "summary": "Stop an apprenticeship",
        "tags": [
          "Apprenticeships"
        ],
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/payments": {
      "patch": {
        "summary": "Update apprenticeship payments",
        "tags": [
          "Apprenticeships"
        ],
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchApprenticeshipPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/details/pause": {
      "post": {
        "summary": "Pause apprenticeship",
        "tags": [
          "Apprenticeships"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PauseApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/apprenticeships/details/resume": {
      "post": {
        "summary": "Resume apprenticeship",
        "tags": [
          "Apprenticeships"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResumeApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipResponse": {
        "type": "object",
        "properties": {}
      },
      "GetApprenticeshipsResponse": {
        "type": "object",
        "properties": {}
      },
      "EditEndDateRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "StopApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "StopDate": {
            "type": "string",
            "format": "date-time"
          },
          "MadeRedundant": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "PatchApprenticeshipPaymentsRequest": {
        "type": "object",
        "properties": {
          "PaymentFreezeDate": {
            "type": "string",
            "format": "date-time"
          },
          "FreezePaymentsReason": {
            "type": "string",
            "enum": [
              "LearnerOnBreak",
              "LearnerWithdrawn",
              "ChangeToTrainingDetails",
              "DisagreeWithAutoApprovedChange"
            ]
          },
          "Party": {
            "type": "integer",
            "format": "int32"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "PauseApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ResumeApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      }
    }
  }
}
