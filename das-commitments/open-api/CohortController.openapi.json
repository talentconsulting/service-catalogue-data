{
  "openapi": "3.1.0",
  "info": {
    "title": "Cohort Management API",
    "version": "1.0.0",
    "description": "API for managing cohorts in the SFA DAS Commitments platform."
  },
  "paths": {
    "/api/cohorts": {
      "get": {
        "summary": "Retrieve cohorts",
        "operationId": "getCohorts",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of cohorts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new cohort",
        "operationId": "createCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-with-other-party": {
      "post": {
        "summary": "Create a new cohort with the other party",
        "operationId": "createCohortWithOtherParty",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortWithOtherPartyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-empty-cohort": {
      "post": {
        "summary": "Create an empty cohort",
        "operationId": "createEmptyCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmptyCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Empty cohort created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}": {
      "get": {
        "summary": "Retrieve a cohort by ID",
        "operationId": "getCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/email-overlaps": {
      "get": {
        "summary": "Retrieve email overlap checks for a cohort",
        "operationId": "getEmailOverlapChecks",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email overlaps retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmailOverlapsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/accountIds": {
      "get": {
        "summary": "Retrieve all cohort account IDs",
        "operationId": "getAllCohortAccountIds",
        "responses": {
          "200": {
            "description": "Account IDs retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCohortAccountIdsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/send": {
      "post": {
        "summary": "Send a cohort",
        "operationId": "sendCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort sent successfully"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approve": {
      "post": {
        "summary": "Approve a cohort",
        "operationId": "approveCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort approved successfully"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/delete": {
      "post": {
        "summary": "Delete a cohort",
        "operationId": "deleteCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInfo"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cohort deleted successfully"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/prior-learning-errors": {
      "get": {
        "summary": "Retrieve prior learning errors for a cohort",
        "operationId": "getCohortPriorLearningErrors",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prior learning errors retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortPriorLearningErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/support-status": {
      "get": {
        "summary": "Retrieve support status for a cohort",
        "operationId": "getSupportStatus",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Support status retrieved",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approved-apprenticeships": {
      "get": {
        "summary": "Retrieve approved apprenticeships for a cohort",
        "operationId": "getCohortApprovedApprenticeships",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved apprenticeships retrieved",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproveCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "type": "string",
            "nullable": true
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "type": "string",
            "nullable": true
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "string",
            "nullable": true
          },
          "Cost": {
            "type": "integer",
            "nullable": true
          },
          "TrainingPrice": {
            "type": "integer",
            "nullable": true
          },
          "EndPointAssessmentPrice": {
            "type": "integer",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "TransferSenderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "PledgeApplicationId": {
            "type": "integer",
            "nullable": true
          },
          "EmploymentPrice": {
            "type": "integer",
            "nullable": true
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "LearnerDataId": {
            "type": "integer",
            "nullable": true
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer"
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer"
          }
        }
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortReference": {
            "type": "string"
          }
        }
      },
      "CreateCohortWithOtherPartyRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "Message": {
            "type": "string"
          },
          "TransferSenderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "PledgeApplicationId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "CreateEmptyCohortRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GetCohortsResponse": {
        "type": "object",
        "properties": {
          "Cohorts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CohortSummary"
            }
          }
        }
      },
      "GetEmailOverlapsResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipEmailOverlaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipEmailOverlap"
            }
          }
        }
      },
      "GetAllCohortAccountIdsResponse": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "GetCohortPriorLearningErrorResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "SendCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "type": "string",
            "nullable": true
          },
          "Message": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "CohortSummary": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          }
        }
      },
      "GetCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "TransferSenderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "PledgeApplicationId": {
            "type": "integer",
            "nullable": true
          },
          "WithParty": {
            "type": "string"
          },
          "LatestMessageCreatedByEmployer": {
            "type": "string",
            "nullable": true
          },
          "LatestMessageCreatedByProvider": {
            "type": "string",
            "nullable": true
          },
          "IsApprovedByEmployer": {
            "type": "boolean"
          },
          "IsApprovedByProvider": {
            "type": "boolean"
          },
          "IsCompleteForEmployer": {
            "type": "boolean"
          },
          "IsCompleteForProvider": {
            "type": "boolean"
          },
          "LevyStatus": {
            "type": "string"
          },
          "ChangeOfPartyRequestId": {
            "type": "integer",
            "nullable": true
          },
          "LastAction": {
            "type": "string"
          },
          "TransferApprovalStatus": {
            "type": "string",
            "nullable": true
          },
          "ApprenticeEmailIsRequired": {
            "type": "boolean"
          }
        }
      },
      "ApprenticeshipEmailOverlap": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "ErrorMessage": {
            "type": "string"
          }
        }
      }
    }
  }
}
