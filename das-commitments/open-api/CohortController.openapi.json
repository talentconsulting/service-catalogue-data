{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments API",
    "version": "2.0.0"
  },
  "paths": {
    "/api/cohorts": {
      "get": {
        "operationId": "getCohorts",
        "description": "Retrieve all cohorts for an account or provider.",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCohort",
        "description": "Create a new cohort.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-with-other-party": {
      "post": {
        "operationId": "createCohortWithOtherParty",
        "description": "Create a new cohort involving another party.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortWithOtherPartyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-empty-cohort": {
      "post": {
        "operationId": "createEmptyCohort",
        "description": "Create an empty cohort.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmptyCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}": {
      "get": {
        "operationId": "getCohortById",
        "description": "Retrieve details of a specific cohort by ID.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cohort Not Found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/email-overlaps": {
      "get": {
        "operationId": "getEmailOverlapChecks",
        "description": "Get email overlap checks for a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmailOverlapsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/accountIds": {
      "get": {
        "operationId": "getAllAccountIds",
        "description": "Retrieve all cohort account IDs.",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCohortAccountIdsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/send": {
      "post": {
        "operationId": "sendCohort",
        "description": "Send a cohort to the next party.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approve": {
      "post": {
        "operationId": "approveCohort",
        "description": "Approve a specific cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/delete": {
      "post": {
        "operationId": "deleteCohort",
        "description": "Delete a specific cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInfo"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/prior-learning-errors": {
      "get": {
        "operationId": "getPriorLearningErrors",
        "description": "Retrieve prior learning errors for a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortPriorLearningErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/support-status": {
      "get": {
        "operationId": "getSupportStatus",
        "description": "Retrieve support status for a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "404": {
            "description": "Support Status Not Found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approved-apprenticeships": {
      "get": {
        "operationId": "getApprovedApprenticeships",
        "description": "Retrieve approved apprenticeships for a cohort.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCohortsResponse": {
        "type": "object",
        "properties": {
          "Cohorts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CohortSummary"
            }
          }
        }
      },
      "CohortSummary": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string"
          }
        }
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortReference": {
            "type": "string"
          }
        }
      },
      "CreateCohortWithOtherPartyRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "CreateEmptyCohortRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GetEmailOverlapsResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipEmailOverlaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipEmailOverlap"
            }
          }
        }
      },
      "ApprenticeshipEmailOverlap": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "ErrorMessage": {
            "type": "string"
          }
        }
      },
      "SendCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "ApproveCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "Employer",
          "Provider",
          "TransferSender"
        ]
      },
      "GetCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          }
        }
      },
      "GetAllCohortAccountIdsResponse": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "GetCohortPriorLearningErrorResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      }
    }
  }
}
