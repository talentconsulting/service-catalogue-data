              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/support-status": {
      "get": {
        "summary": "Get support status",
        "operationId": "GetSupportStatus",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Support status not found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approved-apprenticeships": {
      "get": {
        "summary": "Get all approved apprenticeships in cohort",
        "operationId": "GetApprovedApprenticeships",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCohortsRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GetCohortsResponse": {
        "type": "object",
        "properties": {
          "Cohorts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "AccountId": {
                  "type": "integer",
                  "format": "int64"
                },
                "LegalEntityName": {
                  "type": "string"
                },
                "ProviderId": {
                  "type": "integer",
                  "format": "int64"
                },
                "ProviderName": {
                  "type": "string"
                },
                "CohortId": {
                  "type": "integer",
                  "format": "int64"
                }
              },
              "additionalProperties": true
            }
          }
        }
      },
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "type": "string",
            "nullable": true
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "Cost": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": true
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortReference": {
            "type": "string"
          }
        }
      },
      "CreateCohortWithOtherPartyRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "Message": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "CreateEmptyCohortRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": true
      },
      "GetCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "WithParty": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "GetEmailOverlapsResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipEmailOverlaps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "integer",
                  "format": "int64"
                },
                "ErrorMessage": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "GetAllCohortAccountIdsResponse": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "SendCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "type": "string",
            "nullable": true
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "ApproveCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "type": "string",
            "nullable": true
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
