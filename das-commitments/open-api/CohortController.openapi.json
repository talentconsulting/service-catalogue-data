{
  "openapi": "3.1.0",
  "info": {
    "title": "Cohort API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/cohorts": {
      "get": {
        "summary": "Get a list of cohorts",
        "operationId": "GetCohorts",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new cohort",
        "operationId": "CreateCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-with-other-party": {
      "post": {
        "summary": "Create a cohort with another party",
        "operationId": "CreateCohortWithOtherParty",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortWithOtherPartyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-empty-cohort": {
      "post": {
        "summary": "Create an empty cohort",
        "operationId": "CreateEmptyCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmptyCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}": {
      "get": {
        "summary": "Get details of a specific cohort",
        "operationId": "GetCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort details retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/email-overlaps": {
      "get": {
        "summary": "Get email overlap checks for a cohort",
        "operationId": "GetEmailOverlapChecks",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email overlaps retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmailOverlapsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/accountIds": {
      "get": {
        "summary": "Get all cohort account IDs",
        "operationId": "GetAllCohortAccountIds",
        "responses": {
          "200": {
            "description": "Account IDs retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCohortAccountIdsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/send": {
      "post": {
        "summary": "Send a cohort",
        "operationId": "SendCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort sent"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approve": {
      "post": {
        "summary": "Approve a cohort",
        "operationId": "ApproveCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort approved"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/delete": {
      "post": {
        "summary": "Delete a cohort",
        "operationId": "DeleteCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInfo"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cohort deleted"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/prior-learning-errors": {
      "get": {
        "summary": "Get prior learning errors for a cohort",
        "operationId": "GetCohortPriorLearningErrors",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Prior learning errors retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortPriorLearningErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/support-status": {
      "get": {
        "summary": "Get cohort support status",
        "operationId": "GetSupportStatus",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Support status retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approved-apprenticeships": {
      "get": {
        "summary": "Get approved apprenticeships for a cohort",
        "operationId": "GetCohortApprovedApprenticeships",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved apprenticeships retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCohortsResponse": {
        "type": "object",
        "properties": {
          "Cohorts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortReference": {
            "type": "string"
          }
        }
      },
      "CreateCohortWithOtherPartyRequest": {
        "type": "object"
      },
      "CreateEmptyCohortRequest": {
        "type": "object"
      },
      "GetCohortResponse": {
        "type": "object"
      },
      "GetEmailOverlapsResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipEmailOverlaps": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetAllCohortAccountIdsResponse": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "SendCohortRequest": {
        "type": "object"
      },
      "ApproveCohortRequest": {
        "type": "object"
      },
      "GetCohortPriorLearningErrorResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "Employer",
          "Provider",
          "TransferSender"
        ]
      }
    }
  }
}
