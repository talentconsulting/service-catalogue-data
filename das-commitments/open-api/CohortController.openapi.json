{
  "openapi": "3.1.0",
  "info": {
    "title": "CommitmentsV2 Cohort API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/cohorts": {
      "get": {
        "summary": "Get all cohorts",
        "operationId": "GetCohorts",
        "parameters": [
          {
            "name": "AccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ProviderId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortsResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a cohort",
        "operationId": "CreateCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-with-other-party": {
      "post": {
        "summary": "Create a cohort with other party",
        "operationId": "CreateCohortWithOtherParty",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortWithOtherPartyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/create-empty-cohort": {
      "post": {
        "summary": "Create an empty cohort",
        "operationId": "CreateEmptyCohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmptyCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}": {
      "get": {
        "summary": "Get cohort details",
        "operationId": "GetCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortResponse"
                }
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/email-overlaps": {
      "get": {
        "summary": "Get cohort email overlaps",
        "operationId": "GetCohortEmailOverlaps",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmailOverlapsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/accountIds": {
      "get": {
        "summary": "Get all cohort account IDs",
        "operationId": "GetAllCohortAccountIds",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllCohortAccountIdsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/send": {
      "post": {
        "summary": "Send and approve cohort",
        "operationId": "SendCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/approve": {
      "post": {
        "summary": "Approve cohort",
        "operationId": "ApproveCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApproveCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/delete": {
      "post": {
        "summary": "Delete a cohort",
        "operationId": "DeleteCohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInfo"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cohort successfully deleted"
          }
        }
      }
    },
    "/api/cohorts/{cohortId}/prior-learning-errors": {
      "get": {
        "summary": "Get cohort prior learning errors",
        "operationId": "GetCohortPriorLearningErrors",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortPriorLearningErrorResponse"
