{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0",
    "description": "API for managing overlapping training date requests."
  },
  "paths": {
    "/api/overlapping-training-date-request/{providerId}/create": {
      "post": {
        "summary": "Creates an overlapping training date request.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOverlappingTrainingDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validate": {
      "post": {
        "summary": "Validates draft apprenticeship details.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful."
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateChangeOfEmployerOverlap": {
      "post": {
        "summary": "Validates change of employer overlap.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateChangeOfEmployerOverlapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful."
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateUlnOverlap": {
      "get": {
        "summary": "Validates ULN overlap for start date.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateUlnOverlapOnStartDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{draftApprenticeshipId}/getOverlapRequest": {
      "get": {
        "summary": "Retrieves pending overlapping training date requests.",
        "parameters": [
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending overlap request details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOverlapRequestsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{apprenticeshipId}": {
      "get": {
        "summary": "Retrieves overlapping training date request details.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Overlapping training date request details or null if not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOverlappingTrainingDateRequestResponce"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/resolve": {
      "post": {
        "summary": "Resolves an overlapping training date request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveApprenticeshipOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully resolved."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "CreateOverlappingTrainingDateResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ValidateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ValidateChangeOfEmployerOverlapRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ValidateUlnOverlapOnStartDateResponse": {
        "type": "object",
        "properties": {
          "HasOverlapWithApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "HasStartDateOverlap": {
            "type": "boolean"
          },
          "HasOverlapWithIlrWithdrawnApprenticeship": {
            "type": "boolean"
          }
        }
      },
      "GetOverlapRequestsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "PreviousApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ResolveApprenticeshipOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ResolutionType": {
            "$ref": "#/components/schemas/OverlappingTrainingDateRequestResolutionType"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "OverlappingTrainingDateRequestResolutionType": {
        "type": "string",
        "enum": [
          "CompletionDateEvent",
          "ApprenticeshipUpdate",
          "StopDateUpdate",
          "ApprenticeshipStopped",
          "DraftApprenticeshipUpdated",
          "DraftApprenticeshipDeleted",
          "ApprenticeshipIsStillActive",
          "ApprenticeshipEndDateUpdate",
          "ApprenticeshipStopDateIsCorrect",
          "ApprenticeshipEndDateIsCorrect",
          "CohortDeleted"
        ]
      }
    }
  }
}
