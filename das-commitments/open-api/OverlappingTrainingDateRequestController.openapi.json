{
  "openapi": "3.1.0",
  "info": {
    "title": "Overlapping Training Date API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/overlapping-training-date-request/{providerId}/create": {
      "post": {
        "summary": "Create an overlapping training date request.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOverlappingTrainingDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validate": {
      "post": {
        "summary": "Validate draft apprenticeship details.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateChangeOfEmployerOverlap": {
      "post": {
        "summary": "Validate change of employer overlap.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateChangeOfEmployerOverlapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateUlnOverlap": {
      "get": {
        "summary": "Validate ULN overlap for a given start and end date.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "description": "The Unique Learner Number (ULN)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "description": "The start date",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "description": "The end date",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateUlnOverlapOnStartDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{draftApprenticeshipId}/getOverlapRequest": {
      "get": {
        "summary": "Get pending overlap requests.",
        "parameters": [
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The draft apprenticeship ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOverlapRequestsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{apprenticeshipId}": {
      "get": {
        "summary": "Get overlapping training date request details.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The apprenticeship ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/resolve": {
      "post": {
        "summary": "Resolve an overlapping training date request.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveApprenticeshipOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "DraftApprenticeshipId",
          "UserInfo"
        ]
      },
      "CreateOverlappingTrainingDateResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Id"
        ]
      },
      "ValidateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "string",
            "enum": [
              "Regular",
              "PortableFlexiJob",
              "FlexiJobAgency"
            ],
            "nullable": true
          },
          "Cost": {
            "type": "integer",
            "nullable": true
          },
          "TrainingPrice": {
            "type": "integer",
            "nullable": true
          },
          "EndPointAssessmentPrice": {
            "type": "integer",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "nullable": true
          },
          "EmploymentPrice": {
            "type": "integer",
            "nullable": true
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "UserId",
          "ProviderId",
          "FirstName",
          "LastName",
          "Uln",
          "CourseCode"
        ]
      },
      "ValidateChangeOfEmployerOverlapRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Uln",
          "StartDate",
          "EndDate"
        ]
      },
      "ValidateUlnOverlapOnStartDateResponse": {
        "type": "object",
        "properties": {
          "HasOverlapWithApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "HasStartDateOverlap": {
            "type": "boolean"
          },
          "HasOverlapWithIlrWithdrawnApprenticeship": {
            "type": "boolean"
          }
        },
        "required": [
          "HasStartDateOverlap",
          "HasOverlapWithIlrWithdrawnApprenticeship"
        ]
      },
      "GetOverlapRequestsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "PreviousApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ResolveApprenticeshipOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "ResolutionType": {
            "type": "string",
            "enum": [
              "CompletionDateEvent",
              "ApprenticeshipUpdate",
              "StopDateUpdate",
              "ApprenticeshipStopped",
              "DraftApprenticeshipUpdated",
              "DraftApprenticeshipDeleted",
              "ApprenticeshipIsStillActive",
              "ApprenticeshipEndDateUpdate",
              "ApprenticeshipStopDateIsCorrect",
              "ApprenticeshipEndDateIsCorrect",
              "CohortDeleted"
            ],
            "nullable": true
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      }
    }
  }
}
