{
  "openapi": "3.1.0",
  "info": {
    "title": "Overlapping Training Date Request API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/overlapping-training-date-request/{providerId}/create": {
      "post": {
        "summary": "Create Overlapping Training Date Request",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created overlapping training date request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateOverlappingTrainingDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validate": {
      "post": {
        "summary": "Validate Draft Apprenticeship",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully validated draft apprenticeship"
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateChangeOfEmployerOverlap": {
      "post": {
        "summary": "Validate Change of Employer Overlap",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateChangeOfEmployerOverlapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully validated change of employer overlap"
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{providerId}/validateUlnOverlap": {
      "get": {
        "summary": "Validate ULN Overlap on Start Date",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully validated ULN overlap",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateUlnOverlapOnStartDateResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{draftApprenticeshipId}/getOverlapRequest": {
      "get": {
        "summary": "Get Pending Overlapping Training Date Request",
        "parameters": [
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved pending overlapping training date request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOverlapRequestsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/{apprenticeshipId}": {
      "get": {
        "summary": "Get Overlapping Training Date Request",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved overlapping training date request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/overlapping-training-date-request/resolve": {
      "post": {
        "summary": "Resolve Apprenticeship Overlapping Training Date",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResolveApprenticeshipOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully resolved overlapping training date request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "CreateOverlappingTrainingDateResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ValidateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          }
        }
      },
      "ValidateChangeOfEmployerOverlapRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ValidateUlnOverlapOnStartDateResponse": {
        "type": "object",
        "properties": {
          "HasOverlapWithApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "HasStartDateOverlap": {
            "type": "boolean"
          },
          "HasOverlapWithIlrWithdrawnApprenticeship": {
            "type": "boolean"
          }
        }
      },
      "GetOverlapRequestsResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "PreviousApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ResolveApprenticeshipOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ResolutionType": {
            "$ref": "#/components/schemas/OverlappingTrainingDateRequestResolutionType"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "OverlappingTrainingDateRequestResolutionType": {
        "type": "string",
        "enum": [
          "CompletionDateEvent",
          "ApprenticeshipUpdate",
          "StopDateUpdate",
          "ApprenticeshipStopped",
          "DraftApprenticeshipUpdated",
          "DraftApprenticeshipDeleted",
          "ApprenticeshipIsStillActive",
          "ApprenticeshipEndDateUpdate",
          "ApprenticeshipStopDateIsCorrect",
          "ApprenticeshipEndDateIsCorrect",
          "CohortDeleted"
        ]
      }
    }
  }
}
