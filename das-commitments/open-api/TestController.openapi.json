{
  "openapi": "3.1.0",
  "info": {
    "title": "Funding Agency Commitments API",
    "version": "1.0.0",
    "description": "API for managing commitments."
  },
  "paths": {
    "/api/test/provider": {
      "get": {
        "summary": "Get Provider Endpoint",
        "operationId": "GetProvider",
        "security": [
          {
            "ProviderAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Provider Secure Endpoint reached",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/test/employer": {
      "get": {
        "summary": "Get Employer Endpoint",
        "operationId": "GetEmployer",
        "security": [
          {
            "EmployerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Employer Secure Endpoint reached",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/test/{id}": {
      "get": {
        "summary": "Get Secure Endpoint",
        "operationId": "GetSecure",
        "security": [
          {
            "DefaultAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Secure Endpoint reached",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Provider": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "GetAllProvidersResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Provider"
            }
          }
        }
      },
      "ChangeOfPartyRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "ChangeOfPartyType": {
            "type": "string",
            "enum": [
              "ChangeEmployer",
              "ChangeProvider"
            ]
          },
          "OriginatingParty": {
            "type": "string",
            "enum": [
              "None",
              "Employer",
              "Provider",
              "TransferSender"
            ]
          },
          "Status": {
            "type": "string",
            "enum": [
              "Pending",
              "Approved",
              "Rejected",
              "Withdrawn"
            ]
          },
          "EmployerName": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Price": {
            "type": "integer"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "WithParty": {
            "type": "string",
            "enum": [
              "None",
              "Employer",
              "Provider",
              "TransferSender"
            ]
          },
          "NewApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GetChangeOfPartyRequestsResponse": {
        "type": "object",
        "properties": {
          "ChangeOfPartyRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeOfPartyRequest"
            }
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ProviderAuth": {
        "type": "oauth2",
        "description": "Authorization scope for Providers."
      },
      "EmployerAuth": {
        "type": "oauth2",
        "description": "Authorization scope for Employers."
      },
      "DefaultAuth": {
        "type": "oauth2",
        "description": "General authorization scope."
      }
    }
  }
}
