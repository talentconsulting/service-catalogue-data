{
  "openapi": "3.1.0",
  "info": {
    "title": "CommitmentsV2 API",
    "version": "1.0.0",
    "description": "API documentation for CommitmentsV2."
  },
  "paths": {
    "/api/test/provider": {
      "get": {
        "summary": "Get Provider Secure Endpoint",
        "operationId": "GetProvider",
        "security": [
          {
            "ProviderAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Provider Secure Endpoint reached",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/test/employer": {
      "get": {
        "summary": "Get Employer Secure Endpoint",
        "operationId": "GetEmployer",
        "security": [
          {
            "EmployerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Employer Secure Endpoint reached",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/test/{id}": {
      "get": {
        "summary": "Get Secure Endpoint by Id",
        "operationId": "GetSecureEndpoint",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "DefaultAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Secure Endpoint reached",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ProviderAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization required for provider access."
      },
      "EmployerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization required for employer access."
      },
      "DefaultAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Default authorization required."
      }
    }
  }
}
