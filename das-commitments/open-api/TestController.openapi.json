{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Test/provider": {
      "get": {
        "summary": "Get Provider Secure Endpoint",
        "description": "Retrieves a secure provider endpoint message.",
        "operationId": "getProvider",
        "security": [
          {
            "ProviderAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/Test/employer": {
      "get": {
        "summary": "Get Employer Secure Endpoint",
        "description": "Retrieves a secure employer endpoint message.",
        "operationId": "getEmployer",
        "security": [
          {
            "EmployerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/Test": {
      "get": {
        "summary": "Get Secure Endpoint",
        "description": "Retrieves a secure endpoint message.",
        "operationId": "getSecureEndpoint",
        "security": [
          {
            "DefaultAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ProviderAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization scheme for providers"
      },
      "EmployerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization scheme for employers"
      },
      "DefaultAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Default authorization scheme"
      }
    }
  }
