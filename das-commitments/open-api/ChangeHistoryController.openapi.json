{
  "openapi": "3.1.0",
  "info": {
    "title": "Change History API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/change-history/{ApprenticeshipId}": {
      "get": {
        "summary": "Get change history for a specific apprenticeship",
        "operationId": "GetChangeHistory",
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/change-history/{providerId}/Get-all-change-history": {
      "get": {
        "summary": "Get change history for all learners of a provider",
        "operationId": "GetChangeHistoryForAllLearnersOfProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history for provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllChangeHistoryForProviderQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/change-history/employer/{accountId}/change-history": {
      "get": {
        "summary": "Get change history for all learners of an employer",
        "operationId": "GetChangeHistoryForEmployer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history for employer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryForEmployerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetChangeHistoryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetAllChangeHistoryForProviderQueryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetChangeHistoryForEmployerResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "ChangeHistory": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "ChangeType": {
            "type": "integer",
            "format": "int32"
          },
          "Description": {
            "type": "string"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "LearnerName": {
            "type": "string"
          },
          "AppliedDate": {
            "type": "string",
            "format": "date-time"
          },
          "Created": {
            "type": "string",
            "format": "date-time"
          },
          "EmployerName": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
