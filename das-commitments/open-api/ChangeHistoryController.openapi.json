{
  "openapi": "3.1.0",
  "info": {
    "title": "Change History API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/change-history/{apprenticeshipId}": {
      "get": {
        "summary": "Get change history for a specific apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship to retrieve change history for"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    },
    "/api/change-history/{providerId}/Get-all-change-history": {
      "get": {
        "summary": "Get change history for all learners of a specific provider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider to retrieve change history for all learners"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history for all learners of the provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllChangeHistoryForProviderQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    },
    "/api/change-history/employer/{accountId}/change-history": {
      "get": {
        "summary": "Get change history for all learners of a specific employer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID of the employer to retrieve change history for all learners"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history for all learners of the employer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryForEmployerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetChangeHistoryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetAllChangeHistoryForProviderQueryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetChangeHistoryForEmployerResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "ChangeHistory": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "ChangeType": {
            "type": "integer",
            "format": "int32"
          },
          "Description": {
            "type": "string"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "LearnerName": {
            "type": "string"
          },
          "AppliedDate": {
            "type": "string",
            "format": "date-time"
          },
          "Created": {
            "type": "string",
            "format": "date-time"
          },
          "EmployerName": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "ChangeType",
          "Description",
          "ApprenticeshipId",
          "LearnerName",
          "AppliedDate",
          "Created",
          "EmployerName",
          "ProviderName"
        ]
      }
    }
  }
}
