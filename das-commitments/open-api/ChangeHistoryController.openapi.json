{
  "openapi": "3.1.0",
  "info": {
    "title": "Change History API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/change-history/{ApprenticeshipId}": {
      "get": {
        "summary": "Get Change History for a Specific Apprenticeship",
        "description": "Retrieve change history for a specific apprenticeship by its ID.",
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship to retrieve change history for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; bad model state."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/api/change-history/{providerId}/Get-all-change-history": {
      "get": {
        "summary": "Get Change History for All Learners of a Provider",
        "description": "Retrieve change history for all learners associated with a specific provider ID.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the provider to retrieve change history for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllChangeHistoryForProviderQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; bad model state."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/api/change-history/employer/{accountId}/change-history": {
      "get": {
        "summary": "Get Change History for an Employer",
        "description": "Retrieve change history for all learners associated with a specific employer account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The Account ID of the employer to retrieve change history for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryForEmployerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request; bad model state."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetChangeHistoryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetAllChangeHistoryForProviderQueryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetChangeHistoryForEmployerResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
