{
  "openapi": "3.1.0",
  "info": {
    "title": "Change History API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/change-history/{ApprenticeshipId}": {
      "get": {
        "summary": "Get change history for an apprenticeship",
        "description": "Retrieves change history for a specific apprenticeship by ID.",
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/api/change-history/{providerId}/Get-all-change-history": {
      "get": {
        "summary": "Get all change history for provider learners",
        "description": "Retrieves change history for all learners associated with a specific provider by ID.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of all change history for provider learners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllChangeHistoryForProviderQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/api/change-history/employer/{accountId}/change-history": {
      "get": {
        "summary": "Get change history for employer learners",
        "description": "Retrieves change history for all learners associated with a specific employer account by ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of change history for employer learners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryForEmployerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeHistory": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "ChangeType": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "LearnerName": {
            "type": "string"
          },
          "AppliedDate": {
            "type": "string",
            "format": "date-time"
          },
          "Created": {
            "type": "string",
            "format": "date-time"
          },
          "EmployerName": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          }
        }
      },
      "GetChangeHistoryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetAllChangeHistoryForProviderQueryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetChangeHistoryForEmployerResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
