{
  "openapi": "3.1.0",
  "info": {
    "title": "Change History API",
    "version": "1.0.0",
    "description": "API for managing and retrieving change history for apprenticeships, providers, and employers."
  },
  "paths": {
    "/api/change-history/{apprenticeshipId}": {
      "get": {
        "tags": [
          "ChangeHistory"
        ],
        "summary": "Get Change History",
        "description": "Retrieves the change history for a specific apprenticeship.",
        "operationId": "getChangeHistory",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship to retrieve change history for.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request due to bad input parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/change-history/{providerId}/Get-all-change-history": {
      "get": {
        "tags": [
          "ChangeHistory"
        ],
        "summary": "Get Change History for Provider",
        "description": "Retrieves the change history for all learners associated with a specific provider.",
        "operationId": "getChangeHistoryForAllLearnersOfProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The ID of the provider to retrieve change history for.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history for provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllChangeHistoryForProviderQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request due to bad input parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/change-history/employer/{accountId}/change-history": {
      "get": {
        "tags": [
          "ChangeHistory"
        ],
        "summary": "Get Change History for Employer",
        "description": "Retrieves the change history for all learners associated with a specific employer account.",
        "operationId": "getChangeHistoryForEmployer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the employer account to retrieve change history for.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history for employer account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryForEmployerResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request due to bad input parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetChangeHistoryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetAllChangeHistoryForProviderQueryResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "GetChangeHistoryForEmployerResponse": {
        "type": "object",
        "properties": {
          "ChangeHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChangeHistory"
            }
          }
        }
      },
      "ChangeHistory": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "ChangeType": {
            "type": "integer",
            "format": "int32"
          },
          "Description": {
            "type": "string"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "LearnerName": {
            "type": "string"
          },
          "AppliedDate": {
            "type": "string",
            "format": "date-time"
          },
          "Created": {
            "type": "string",
            "format": "date-time"
          },
          "EmployerName": {
            "type": "string"
          },
          "ProviderName": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "Errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
