{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/price-episodes": {
      "get": {
        "summary": "Get price episodes for an apprenticeship",
        "operationId": "getPriceEpisodes",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the apprenticeship"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPriceEpisodesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPriceEpisodesResponse": {
        "type": "object",
        "description": "Response containing price episodes",
        "properties": {
          "priceEpisodes": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Details of a price episode"
            }
          }
        }
      }
    }
  }
}
