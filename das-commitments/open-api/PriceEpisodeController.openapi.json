{
  "openapi": "3.1.0",
  "info": {
    "title": "Price Episode API",
    "description": "API for managing price episodes of apprenticeships.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/price-episodes": {
      "get": {
        "summary": "Get Price Episodes",
        "operationId": "GetPriceEpisodes",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "description": "The ID of the apprenticeship.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of price episodes for the apprenticeship.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPriceEpisodesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPriceEpisodesResponse": {
        "type": "object",
        "description": "Represents the response containing price episodes.",
        "properties": {}
      }
    }
  }
}
