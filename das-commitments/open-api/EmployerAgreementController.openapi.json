{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreement API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/employer-agreements/{AccountLegalEntityId}/signed": {
      "get": {
        "summary": "Check if agreement is signed for specific features",
        "operationId": "IsAgreementSignedForFeature",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "agreementFeatures",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgreementFeature"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreement signed status for features",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/employer-agreements/{AccountLegalEntityId}/latest-id": {
      "get": {
        "summary": "Get the latest agreement ID",
        "operationId": "GetLatestAgreementId",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest agreement ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgreementFeature": {
        "type": "string",
        "enum": [
          "Transfers"
        ]
      }
    }
  }
}
