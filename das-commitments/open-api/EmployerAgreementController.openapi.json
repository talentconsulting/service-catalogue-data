{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreements API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/employer-agreements/{accountLegalEntityId}/signed": {
      "get": {
        "summary": "Check if agreements are signed for specific features",
        "parameters": [
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account legal entity."
          },
          {
            "name": "agreementFeatures",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgreementFeature"
              }
            },
            "description": "List of agreement features to check if signed."
          }
        ],
        "responses": {
          "200": {
            "description": "Agreement signed status returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/employer-agreements/{accountLegalEntityId}/latest-id": {
      "get": {
        "summary": "Get the latest agreement ID",
        "parameters": [
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account legal entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Latest agreement ID returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgreementFeature": {
        "type": "integer",
        "enum": [
          1
        ],
        "description": "Agreement features, with enum values."
      }
    }
  }
}
