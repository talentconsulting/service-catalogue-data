{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreement API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/employer-agreements/{AccountLegalEntityId}/signed": {
      "get": {
        "summary": "Check if the agreement is signed for specified features",
        "operationId": "IsAgreementSignedForFeature",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the Account Legal Entity."
          },
          {
            "name": "agreementFeatures",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgreementFeature"
              }
            },
            "description": "A list of agreement features to check."
          }
        ],
        "responses": {
          "200": {
            "description": "A boolean indicating whether the agreement is signed for all specified features.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/employer-agreements/{AccountLegalEntityId}/latest-id": {
      "get": {
        "summary": "Get the latest agreement ID for an account legal entity",
        "operationId": "GetLatestAgreementId",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the Account Legal Entity."
          }
        ],
        "responses": {
          "200": {
            "description": "The latest agreement ID.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgreementFeature": {
        "type": "string",
        "enum": [
          "Transfers"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
