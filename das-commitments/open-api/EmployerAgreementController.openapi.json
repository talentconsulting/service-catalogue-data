{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreement API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/employer-agreements/{AccountLegalEntityId}/signed": {
      "get": {
        "summary": "Check if agreement is signed for specified feature(s)",
        "operationId": "IsAgreementSignedForFeature",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "description": "The ID of the account legal entity",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "agreementFeatures",
            "in": "query",
            "required": false,
            "description": "The features of the agreement to check",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgreementFeature"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Indicates if the agreement is signed for the specified features",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/employer-agreements/{AccountLegalEntityId}/latest-id": {
      "get": {
        "summary": "Get the latest agreement ID for an account legal entity",
        "operationId": "GetLatestAgreementId",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "description": "The ID of the account legal entity",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The latest agreement ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AgreementFeature": {
        "type": "string",
        "enum": [
          "Transfers"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
