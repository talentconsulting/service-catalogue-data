{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/approvals/{learningKey}": {
      "put": {
        "summary": "Approves or creates a change-of-circumstance (Coc) request.",
        "operationId": "PutApprovals",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier for the learning to be approved."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The approval was completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "201": {
            "description": "The approval request was created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. For example, learningKey in the route does not match learningKey in the body."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CocApprovalRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier for the learning entity."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the apprenticeship."
          },
          "LearningType": {
            "type": "string",
            "description": "The type of learning associated with the request."
          },
          "UKPRN": {
            "type": "string",
            "description": "The UK Provider Reference Number."
          },
          "ULN": {
            "type": "string",
            "description": "The Unique Learner Number."
          },
          "ApprovedUri": {
            "type": "string",
            "description": "The URI pointing to the approval documentation."
          },
          "Changes": {
            "type": "array",
            "description": "The list of field changes for the approval.",
            "items": {
              "$ref": "#/components/schemas/CocApprovalFieldChange"
            }
          }
        },
        "required": [
          "LearningKey",
          "ApprenticeshipId",
          "LearningType"
        ]
      },
      "CocApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string",
            "description": "The type of the change being requested (e.g., title, duration)."
          },
          "Data": {
            "$ref": "#/components/schemas/CocData"
          }
        }
      },
      "CocData": {
        "type": "object",
        "properties": {
          "Old": {
            "type": "string",
            "description": "The old value before the change."
          },
          "New": {
            "type": "string",
            "description": "The new value to apply."
          },
          "EffectiveFromDate": {
            "type": "string",
            "format": "date",
            "description": "The date from which the change is effective."
          }
        }
      },
      "ApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string",
            "description": "The type of the change being approved."
          },
          "ApprovalStatus": {
            "type": "string",
            "description": "The approval status for the field change."
          },
          "Reason": {
            "type": "string",
            "description": "An optional reason for the approval decision."
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "approvals:write": "Allows writing approvals."
            }
          }
        }
      }
    }
  }
}
