{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 Approvals API",
    "description": "API for managing approvals within the Commitments V2 project.",
    "version": "1.0.0"
  },
  "paths": {
    "/approvals/{learningKey}": {
      "post": {
        "summary": "Create an approval",
        "description": "Creates an approval request based on the provided learningKey and approval details.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "description": "The unique key identifying the learning.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Approval created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request, learningKey mismatch or validation error"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "delete": {
        "summary": "Delete an approval",
        "description": "Deletes an existing approval based on the learning key.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "description": "The unique key identifying the learning.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approval deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request, validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Approval not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "put": {
        "summary": "Update an approval",
        "description": "Updates an existing approval based on the provided learning key.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "description": "The unique key identifying the learning.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Approval updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Approval not found."
          },
          "400": {
            "description": "Bad request, validation error."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CocApprovalRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeshipId": {
            "type": "integer"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "UKPRN": {
            "type": "string"
          },
          "ULN": {
            "type": "string"
          },
          "ApprovedUri": {
            "type": "string"
          },
          "Changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CocApprovalFieldChange"
            }
          }
        },
        "required": [
          "LearningKey",
          "ApprenticeshipId",
          "LearningType",
          "Changes"
        ]
      },
      "CocApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string"
          },
          "Data": {
            "$ref": "#/components/schemas/CocData"
          }
        },
        "required": [
          "ChangeType",
          "Data"
        ]
      },
      "CocData": {
        "type": "object",
        "properties": {
          "Old": {
            "type": "string"
          },
          "New": {
            "type": "string"
          },
          "EffectiveFromDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string"
          },
          "ApprovalStatus": {
            "type": "string"
          },
          "Reason": {
            "type": "string"
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://auth.skillsfundingagency.gov.uk/oauth/authorize",
            "tokenUrl": "https://auth.skillsfundingagency.gov.uk/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
