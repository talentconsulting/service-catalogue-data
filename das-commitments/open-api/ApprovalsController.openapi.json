{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/approvals/{learningKey}": {
      "put": {
        "summary": "Create or update approvals",
        "operationId": "putApprovals",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "description": "Unique identifier for learning",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Approval has been created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "200": {
            "description": "Approval has been updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - LearningKey in route does not match LearningKey in body"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CocApprovalRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "LearningType": {
            "type": "string"
          },
          "UKPRN": {
            "type": "string"
          },
          "ULN": {
            "type": "string"
          },
          "ApprovedUri": {
            "type": "string",
            "format": "uri"
          },
          "Changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CocApprovalFieldChange"
            }
          }
        },
        "required": [
          "LearningKey",
          "ApprenticeshipId",
          "LearningType",
          "UKPRN",
          "ULN",
          "ApprovedUri",
          "Changes"
        ]
      },
      "CocApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string"
          },
          "Data": {
            "$ref": "#/components/schemas/CocData"
          }
        },
        "required": [
          "ChangeType",
          "Data"
        ]
      },
      "CocData": {
        "type": "object",
        "properties": {
          "Old": {
            "type": "string"
          },
          "New": {
            "type": "string"
          },
          "EffectiveFromDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string"
          },
          "ApprovalStatus": {
            "type": "string"
          },
          "Reason": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "ChangeType",
          "ApprovalStatus"
        ]
      }
    }
  }
}
