{
  "openapi": "3.1.0",
  "info": {
    "title": "CommitmentsV2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/approvals/{learningKey}": {
      "post": {
        "summary": "Create an approval",
        "operationId": "PostApprovals",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Approval created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "400": {
            "description": "LearningKey mismatch or bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "delete": {
        "summary": "Delete an approval",
        "operationId": "DeleteApprovals",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approval deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Approval not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid approval state",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "put": {
        "summary": "Update an approval",
        "operationId": "PutApprovals",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CocApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Approval updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprovalFieldChange"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pending approval not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "LearningKey mismatch or bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CocApprovalRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeshipId": {
            "type": "integer"
          },
          "LearningType": {
            "type": "string"
          },
          "UKPRN": {
            "type": "string"
          },
          "ULN": {
            "type": "string"
          },
          "ApprovedUri": {
            "type": "string",
            "format": "uri"
          },
          "Changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CocApprovalFieldChange"
            }
          }
        }
      },
      "CocApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string"
          },
          "Data": {
            "$ref": "#/components/schemas/CocData"
          }
        }
      },
      "CocData": {
        "type": "object",
        "properties": {
          "Old": {
            "type": "string"
          },
          "New": {
            "type": "string"
          },
          "EffectiveFromDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ApprovalFieldChange": {
        "type": "object",
        "properties": {
          "ChangeType": {
            "type": "string"
          },
          "ApprovalStatus": {
            "type": "string"
          },
          "Reason": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
