{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/learners": {
      "get": {
        "summary": "Get all learners",
        "description": "Retrieves a list of learners based on optional filters.",
        "operationId": "GetAllLearners",
        "parameters": [
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Optional filter to retrieve learners updated since the given time."
          },
          {
            "name": "batch_number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "The batch number to retrieve."
          },
          {
            "name": "batch_size",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "default": 1000,
              "minimum": 1
            },
            "description": "The number of learners in a batch."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with all learners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllLearnersResponse": {
        "type": "object",
        "properties": {
          "BatchNumber": {
            "type": "integer",
            "description": "The current batch number."
          },
          "BatchSize": {
            "type": "integer",
            "description": "The size of the batch."
          },
          "TotalNumberOfBatches": {
            "type": "integer",
            "description": "The total number of batches available."
          },
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Learner"
            },
            "description": "The list of learners in the batch."
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "description": "Unique ID of the apprenticeship."
          },
          "FirstName": {
            "type": "string",
            "description": "First name of the learner."
          },
          "LastName": {
            "type": "string",
            "description": "Last name of the learner."
          },
          "ULN": {
            "type": "string",
            "description": "Unique Learner Number."
          },
          "TrainingCode": {
            "type": "string",
            "description": "Code of the training the learner is pursuing."
          },
          "TrainingCourseVersion": {
            "type": "string",
            "description": "Version of the training course."
          },
          "TrainingCourseVersionConfirmed": {
            "type": "boolean",
            "description": "Indicates whether the course version is confirmed."
          },
          "TrainingCourseOption": {
            "type": "string",
            "description": "Optional field specifying the training course option."
          },
          "StandardUId": {
            "type": "string",
            "description": "Standard UID of the training."
          },
          "StartDate": {
            "type": "string",
            "format": "date",
            "description": "Start date of the training."
          },
          "EndDate": {
            "type": "string",
            "format": "date",
            "description": "End date of the training."
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the record was created."
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the record was last updated."
          },
          "StopDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the training was stopped."
          },
          "PauseDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the training was paused."
          },
          "CompletionDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the training was completed."
          },
          "UKPRN": {
            "type": "integer",
            "description": "UK Provider Reference Number."
          },
          "LearnRefNumber": {
            "type": "string",
            "description": "Learner Reference Number."
          },
          "PaymentStatus": {
            "type": "integer",
            "description": "The payment status of the apprenticeship.",
            "enum": [
              1,
              2,
              3,
              4
            ]
          },
          "EmployerAccountId": {
            "type": "integer",
            "description": "Account ID of the employer associated with the apprenticeship."
          },
          "EmployerName": {
            "type": "string",
            "description": "Name of the employer."
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
