{
  "openapi": "3.1.0",
  "info": {
    "title": "Learners API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/learners": {
      "get": {
        "summary": "Get all learners",
        "operationId": "GetAllLearners",
        "parameters": [
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter learners since the specified time."
          },
          {
            "name": "batch_number",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The specific batch number to retrieve."
          },
          {
            "name": "batch_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "description": "The size of each batch to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllLearnersResponse": {
        "type": "object",
        "properties": {
          "BatchNumber": {
            "type": "integer"
          },
          "BatchSize": {
            "type": "integer"
          },
          "TotalNumberOfBatches": {
            "type": "integer"
          },
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Learner"
            }
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "ULN": {
            "type": "string"
          },
          "TrainingCode": {
            "type": "string"
          },
          "TrainingCourseVersion": {
            "type": "string"
          },
          "TrainingCourseVersionConfirmed": {
            "type": "boolean"
          },
          "TrainingCourseOption": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "StopDate": {
            "type": "string",
            "format": "date-time"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "UKPRN": {
            "type": "integer",
            "format": "int64"
          },
          "LearnRefNumber": {
            "type": "string"
          },
          "PaymentStatus": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "EmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerName": {
            "type": "string"
          }
        }
      },
      "PaymentStatus": {
        "type": "string",
        "enum": [
          "Active",
          "Paused",
          "Withdrawn",
          "Completed"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
