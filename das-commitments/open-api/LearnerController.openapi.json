{
  "openapi": "3.1.0",
  "info": {
    "title": "Learner API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/learners": {
      "get": {
        "summary": "Get all learners",
        "operationId": "GetAllLearners",
        "parameters": [
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Optional datetime to fetch learners modified since that time."
          },
          {
            "name": "batch_number",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1,
              "minimum": 1
            },
            "description": "Batch number for paginated results."
          },
          {
            "name": "batch_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1000,
              "minimum": 1
            },
            "description": "Number of records per batch."
          }
        ],
        "responses": {
          "200": {
            "description": "A successful response with a list of learners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllLearnersResponse": {
        "type": "object",
        "properties": {
          "BatchNumber": {
            "type": "integer",
            "format": "int32"
          },
          "BatchSize": {
            "type": "integer",
            "format": "int32"
          },
          "TotalNumberOfBatches": {
            "type": "integer",
            "format": "int32"
          },
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Learner"
            }
          }
        },
        "required": [
          "BatchNumber",
          "BatchSize",
          "TotalNumberOfBatches",
          "Learners"
        ]
      },
      "Learner": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "ULN": {
            "type": "string"
          },
          "TrainingCode": {
            "type": "string"
          },
          "TrainingCourseVersion": {
            "type": "string"
          },
          "TrainingCourseVersionConfirmed": {
            "type": "boolean"
          },
          "TrainingCourseOption": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "StopDate": {
            "type": "string",
            "format": "date-time"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "UKPRN": {
            "type": "integer",
            "format": "int64"
          },
          "LearnRefNumber": {
            "type": "string"
          },
          "PaymentStatus": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "EmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerName": {
            "type": "string"
          }
        },
        "required": [
          "ApprenticeshipId",
          "FirstName",
          "LastName",
          "ULN",
          "TrainingCode",
          "TrainingCourseVersion",
          "TrainingCourseVersionConfirmed",
          "CreatedOn",
          "UKPRN",
          "LearnRefNumber",
          "PaymentStatus",
          "EmployerAccountId",
          "EmployerName"
        ]
      },
      "PaymentStatus": {
        "type": "string",
        "enum": [
          "Active",
          "Paused",
          "Withdrawn",
          "Completed"
        ]
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
