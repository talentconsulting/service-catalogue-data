{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS CommitmentsV2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/whoami": {
      "get": {
        "operationId": "WhoAmI_Get",
        "summary": "Retrieve the current user's roles",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmIResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "WhoAmIResponse": {
        "type": "object",
        "properties": {
          "Roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "Roles"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
