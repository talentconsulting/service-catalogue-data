{
  "openapi": "3.1.0",
  "info": {
    "title": "WhoAmI API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/whoami": {
      "get": {
        "summary": "Retrieve information about the current user",
        "operationId": "WhoAmI",
        "responses": {
          "200": {
            "description": "Successfully retrieved user roles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmIResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "WhoAmIResponse": {
        "type": "object",
        "properties": {
          "Roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "Roles"
        ]
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
