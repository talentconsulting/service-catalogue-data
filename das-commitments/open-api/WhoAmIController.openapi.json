{
  "openapi": "3.1.0",
  "info": {
    "title": "Commitments V2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/whoami": {
      "get": {
        "summary": "Retrieve the current user's roles",
        "operationId": "GetWhoAmI",
        "responses": {
          "200": {
            "description": "User roles retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WhoAmIResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "azureAd": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "WhoAmIResponse": {
        "type": "object",
        "properties": {
          "Roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "Roles"
        ]
      }
    },
    "securitySchemes": {
      "azureAd": {
        "type": "oauth2",
        "description": "Azure AD authentication",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://login.microsoftonline.com/common/oauth2/authorize",
            "tokenUrl": "https://login.microsoftonline.com/common/oauth2/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
