{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Programme API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/TrainingProgramme/all": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Retrieve all training programmes",
        "responses": {
          "200": {
            "description": "Returns all training programmes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/TrainingProgramme/standards": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Retrieve all training programme standards",
        "responses": {
          "200": {
            "description": "Returns all training programme standards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammeStandardsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Retrieve a specific training programme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the training programme",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/version": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Retrieve the version of a specific training programme",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the training programme version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{courseCode}/version/{version}": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Retrieve a specific version of a training programme",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the training programme version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}/versions": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Retrieve all versions of a specific training programme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns all versions of the training programme",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/newer-versions": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Retrieve newer versions of a specific training programme",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns newer versions of the training programme",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNewerTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/TrainingProgramme/calculate-version/{courseCode}": {
      "get": {
        "tags": [
          "TrainingProgramme"
        ],
        "summary": "Calculate the version of a training programme based on the course code and start date",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "StartDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the calculated training programme version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllTrainingProgrammesResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetAllTrainingProgrammeStandardsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetTrainingProgrammeResponse": {
        "type": "object",
        "properties": {
          "TrainingProgramme": {
            "$ref": "#/components/schemas/TrainingProgramme"
          }
        }
      },
      "GetTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammeVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetNewerTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "NewerVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "TrainingProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "Version": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "ProgrammeType": {
            "type": "string",
            "enum": [
              "Standard",
              "Framework"
            ]
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "StandardPageUrl": {
            "type": "string"
          },
          "Options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "FundingPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgrammeFundingPeriod"
            }
          },
          "VersionEarliestStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "VersionLatestStartDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrainingProgrammeFundingPeriod": {
        "type": "object",
        "properties": {
          "FundingCap": {
            "type": "integer"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
