{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Programme API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/TrainingProgramme/all": {
      "get": {
        "summary": "Get all training programmes",
        "operationId": "getAllTrainingProgrammes",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/TrainingProgramme/standards": {
      "get": {
        "summary": "Get all training programme standards",
        "operationId": "getAllTrainingProgrammeStandards",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammeStandardsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}": {
      "get": {
        "summary": "Get training programme by ID",
        "operationId": "getTrainingProgramme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/version": {
      "get": {
        "summary": "Get specific version of a training programme by StandardUId",
        "operationId": "getTrainingProgrammeVersionByStandardUId",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{courseCode}/version/{version}": {
      "get": {
        "summary": "Get specific version of a training programme by course code and version",
        "operationId": "getTrainingProgrammeVersionByCourseCodeAndVersion",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}/versions": {
      "get": {
        "summary": "Get available versions of a training programme",
        "operationId": "getTrainingProgrammeVersions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/newer-versions": {
      "get": {
        "summary": "Get newer versions of a training programme by StandardUId",
        "operationId": "getNewerTrainingProgrammeVersions",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNewerTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/TrainingProgramme/calculate-version/{courseCode}": {
      "get": {
        "summary": "Calculate the appropriate version of a training programme for a course",
        "operationId": "getCalculatedTrainingProgrammeVersion",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "queryParameters": [
          {
            "name": "StartDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllTrainingProgrammesResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetAllTrainingProgrammeStandardsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetTrainingProgrammeResponse": {
        "type": "object",
        "properties": {
          "TrainingProgramme": {
            "$ref": "#/components/schemas/TrainingProgramme"
          }
        }
      },
      "GetTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammeVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetNewerTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "NewerVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "TrainingProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "Version": {
            "type": "string"
          },
          "Level": {
            "type": "integer",
            "nullable": true
          },
          "ProgrammeType": {
            "type": "string",
            "enum": [
              "Standard",
              "Framework"
            ]
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "StandardPageUrl": {
            "type": "string"
          },
          "Options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "FundingPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgrammeFundingPeriod"
            }
          },
          "VersionEarliestStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "VersionLatestStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TrainingProgrammeFundingPeriod": {
        "type": "object",
        "properties": {
          "FundingCap": {
            "type": "integer"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  }
}
