{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Programme API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/TrainingProgramme/all": {
      "get": {
        "summary": "Get all training programmes",
        "operationId": "getAllTrainingProgrammes",
        "responses": {
          "200": {
            "description": "A list of all training programmes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/TrainingProgramme/standards": {
      "get": {
        "summary": "Get all training programme standards",
        "operationId": "getAllTrainingProgrammeStandards",
        "responses": {
          "200": {
            "description": "A list of all training programme standards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammeStandardsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}": {
      "get": {
        "summary": "Get a specific training programme by ID",
        "operationId": "getTrainingProgramme",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the training programme",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training programme details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/version": {
      "get": {
        "summary": "Get the version details for a specific training programme by StandardUId",
        "operationId": "getTrainingProgrammeVersionByStandardUId",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "description": "StandardUId of the training programme",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Version details of the training programme",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{courseCode}/version/{version}": {
      "get": {
        "summary": "Get the version details for a specific training programme by courseCode and version",
        "operationId": "getTrainingProgrammeVersionByCourseCodeAndVersion",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "description": "Course code of the training programme",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "description": "Version of the training programme",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Version details of the training programme",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}/versions": {
      "get": {
        "summary": "Get all versions of a specific training programme by ID",
        "operationId": "getTrainingProgrammeVersionsById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the training programme",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training programme versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme versions not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/newer-versions": {
      "get": {
        "summary": "Get newer versions of a training programme by StandardUId",
        "operationId": "getNewerTrainingProgrammeVersions",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "description": "StandardUId of the training programme",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Newer versions of the training programme",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNewerTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/TrainingProgramme/calculate-version/{courseCode}": {
      "get": {
        "summary": "Calculate a version for a training programme by course code and start date",
        "operationId": "calculateTrainingProgrammeVersion",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "description": "Course code of the training programme",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "description": "Start date of the training programme",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Calculated version details of the training programme",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Calculated training programme not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllTrainingProgrammeStandardsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetAllTrainingProgrammesResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetNewerTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "NewerVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetTrainingProgrammeResponse": {
        "type": "object",
        "properties": {
          "TrainingProgramme": {
            "$ref": "#/components/schemas/TrainingProgramme"
          }
        }
      },
      "GetTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammeVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "TrainingProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "Version": {
            "type": "string"
          },
          "Level": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "ProgrammeType": {
            "type": "string",
            "enum": [
              "Standard",
              "Framework"
            ]
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "StandardPageUrl": {
            "type": "string",
            "nullable": true
          },
          "Options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "FundingPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgrammeFundingPeriod"
            }
          },
          "VersionEarliestStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "VersionLatestStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "TrainingProgrammeFundingPeriod": {
        "type": "object",
        "properties": {
          "FundingCap": {
            "type": "integer",
            "format": "int32"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      }
    }
  }
}
