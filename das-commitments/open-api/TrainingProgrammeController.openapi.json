{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Programme API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/TrainingProgramme/all": {
      "get": {
        "summary": "Retrieve all training programmes.",
        "operationId": "getAllTrainingProgrammes",
        "responses": {
          "200": {
            "description": "Successful retrieval of all training programmes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/TrainingProgramme/standards": {
      "get": {
        "summary": "Retrieve all training programme standards.",
        "operationId": "getAllTrainingProgrammeStandards",
        "responses": {
          "200": {
            "description": "Successful retrieval of all training programme standards.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllTrainingProgrammeStandardsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}": {
      "get": {
        "summary": "Retrieve details of a specific training programme.",
        "operationId": "getTrainingProgrammeById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the training programme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the training programme.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/version": {
      "get": {
        "summary": "Retrieve version details of a specific training programme.",
        "operationId": "getTrainingProgrammeVersion",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The Standard UID of the training programme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the training programme version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme version not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/TrainingProgramme/{courseCode}/version/{version}": {
      "get": {
        "summary": "Retrieve a specific training programme version by course code and version.",
        "operationId": "getSpecificTrainingProgrammeVersion",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The course code of the training programme."
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The version of the training programme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the training programme version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme version not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/TrainingProgramme/{id}/versions": {
      "get": {
        "summary": "Retrieve all versions of a specific training programme.",
        "operationId": "getTrainingProgrammeVersions",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the training programme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of training programme versions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/TrainingProgramme/{standardUId}/newer-versions": {
      "get": {
        "summary": "Retrieve newer versions of a training programme standard by UID.",
        "operationId": "getNewerTrainingProgrammeVersions",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The Standard UID of the training programme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of newer training programme versions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNewerTrainingProgrammeVersionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/api/TrainingProgramme/calculate-version/{courseCode}": {
      "get": {
        "summary": "Get calculated version of a training programme.",
        "operationId": "getCalculatedTrainingProgrammeVersion",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The course code of the training programme."
          },
          {
            "name": "StartDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "The start date parameter."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of calculated training programme version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTrainingProgrammeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Training programme version not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllTrainingProgrammesResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetAllTrainingProgrammeStandardsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetTrainingProgrammeResponse": {
        "type": "object",
        "properties": {
          "TrainingProgramme": {
            "$ref": "#/components/schemas/TrainingProgramme"
          }
        }
      },
      "GetTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "TrainingProgrammeVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "GetNewerTrainingProgrammeVersionsResponse": {
        "type": "object",
        "properties": {
          "NewerVersions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgramme"
            }
          }
        }
      },
      "TrainingProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "Version": {
            "type": "string"
          },
          "Level": {
            "type": "integer",
            "nullable": true
          },
          "ProgrammeType": {
            "type": "string",
            "enum": [
              "Standard",
              "Framework"
            ]
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "StandardPageUrl": {
            "type": "string"
          },
          "Options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "FundingPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProgrammeFundingPeriod"
            }
          },
          "VersionEarliestStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "VersionLatestStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "TrainingProgrammeFundingPeriod": {
        "type": "object",
        "properties": {
          "FundingCap": {
            "type": "integer"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    }
  }
}
