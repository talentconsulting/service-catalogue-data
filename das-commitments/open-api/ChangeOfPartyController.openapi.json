{
  "openapi": "3.1.0",
  "info": {
    "title": "Change Of Party API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/change-of-party-requests": {
      "get": {
        "summary": "Retrieve all change of party requests",
        "operationId": "getChangeOfPartyRequests",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new change of party request",
        "operationId": "createChangeOfPartyRequest",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChangeOfPartyRequestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created"
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-provider-chain": {
      "get": {
        "summary": "Retrieve the change of provider chain",
        "operationId": "getChangeOfProviderChain",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-employer-chain": {
      "get": {
        "summary": "Retrieve the change of employer chain",
        "operationId": "getChangeOfEmployerChain",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateChangeOfPartyRequestRequest": {
        "type": "object",
        "properties": {
          "ChangeOfPartyRequestType": {
            "$ref": "#/components/schemas/ChangeOfPartyRequestType"
          },
          "NewPartyId": {
            "type": "integer",
            "format": "int64"
          },
          "NewPrice": {
            "type": "integer",
            "nullable": true
          },
          "NewStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEmploymentPrice": {
            "type": "integer",
            "nullable": true
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "HasOverlappingTrainingDates": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ChangeOfPartyRequestType",
          "NewPartyId",
          "HasOverlappingTrainingDates",
          "UserInfo"
        ]
      },
      "ChangeOfPartyRequestType": {
        "type": "string",
        "enum": [
          "ChangeEmployer",
          "ChangeProvider"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      }
    }
  }
}
