{
  "openapi": "3.1.0",
  "info": {
    "title": "Change of Party API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/change-of-party-requests": {
      "get": {
        "summary": "Get all Change of Party Requests",
        "operationId": "getChangeOfPartyRequests",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfPartyRequestsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create a Change of Party Request",
        "operationId": "createChangeOfPartyRequest",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChangeOfPartyRequestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request created successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-provider-chain": {
      "get": {
        "summary": "Get Change of Provider Chain",
        "operationId": "getChangeOfProviderChain",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfProviderChainResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-employer-chain": {
      "get": {
        "summary": "Get Change of Employer Chain",
        "operationId": "getChangeOfEmployerChain",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfEmployerChainResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateChangeOfPartyRequestRequest": {
        "type": "object",
        "properties": {
          "ChangeOfPartyRequestType": {
            "$ref": "#/components/schemas/ChangeOfPartyRequestType"
          },
          "NewPartyId": {
            "type": "integer",
            "format": "int64"
          },
          "NewPrice": {
            "type": "integer",
            "nullable": true
          },
          "NewStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "NewEmploymentPrice": {
            "type": "integer",
            "nullable": true
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "HasOverlappingTrainingDates": {
            "type": "boolean",
            "default": false
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ChangeOfPartyRequestType",
          "NewPartyId",
          "HasOverlappingTrainingDates",
          "UserInfo"
        ]
      },
      "ChangeOfPartyRequestType": {
        "type": "string",
        "enum": [
          "ChangeEmployer",
          "ChangeProvider"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      },
      "GetChangeOfPartyRequestsResponse": {
        "type": "object"
      },
      "GetChangeOfProviderChainResponse": {
        "type": "object"
      },
      "GetChangeOfEmployerChainResponse": {
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
