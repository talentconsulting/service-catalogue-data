{
  "openapi": "3.1.0",
  "info": {
    "title": "Change of Party API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/change-of-party-requests": {
      "get": {
        "summary": "Get all change of party requests for an apprenticeship",
        "operationId": "getChangeOfPartyRequests",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfPartyRequestsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create a new change of party request for an apprenticeship",
        "operationId": "createChangeOfPartyRequest",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChangeOfPartyRequestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-provider-chain": {
      "get": {
        "summary": "Get the change of provider chain for an apprenticeship",
        "operationId": "getChangeOfProviderChain",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfProviderChainResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/apprenticeships/{apprenticeshipId}/change-of-employer-chain": {
      "get": {
        "summary": "Get the change of employer chain for an apprenticeship",
        "operationId": "getChangeOfEmployerChain",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeOfEmployerChainResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateChangeOfPartyRequestRequest": {
        "type": "object",
        "properties": {
          "ChangeOfPartyRequestType": {
            "$ref": "#/components/schemas/ChangeOfPartyRequestType"
          },
          "NewPartyId": {
            "type": "integer",
            "format": "int64"
          },
          "NewPrice": {
            "type": "integer",
            "nullable": true,
            "format": "int32"
          },
          "NewStartDate": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "NewEndDate": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "NewEmploymentEndDate": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "NewEmploymentPrice": {
            "type": "integer",
            "nullable": true,
            "format": "int32"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "HasOverlappingTrainingDates": {
            "type": "boolean",
            "default": false
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "ChangeOfPartyRequestType": {
        "type": "string",
        "enum": [
          "ChangeEmployer",
          "ChangeProvider"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "GetChangeOfPartyRequestsResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetChangeOfProviderChainResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetChangeOfEmployerChainResponse": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
