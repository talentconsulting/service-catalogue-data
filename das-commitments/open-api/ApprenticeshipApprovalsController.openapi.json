{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/apprenticeships/{apprenticeshipId}/approvals/{approvalRequestId}": {
      "get": {
        "operationId": "getApprenticeshipApproval",
        "summary": "Get a specific apprenticeship approval",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "approvalRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Approval not found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "operationId": "postApprenticeshipApproval",
        "summary": "Process an apprenticeship approval",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "approvalRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessApprenticeshipApprovalRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approval processed successfully"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProcessApprenticeshipApprovalRequest": {
        "type": "object",
        "properties": {
          "applyChanges": {
            "type": "boolean"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "applyChanges",
          "userInfo"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "userDisplayName",
          "userEmail"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
