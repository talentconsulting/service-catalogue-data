{
  "openapi": "3.1.0",
  "info": {
    "title": "BulkUpload API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/{providerId}/bulkupload": {
      "post": {
        "summary": "Add draft apprenticeships for bulk upload",
        "operationId": "AddDraftApprenticeships",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/addandapprove": {
      "post": {
        "summary": "Add and approve draft apprenticeships for bulk upload",
        "operationId": "AddAndApproveDraftApprenticeships",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddAndApproveDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/validate": {
      "post": {
        "summary": "Validate the bulk upload request",
        "operationId": "Validate",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadValidateApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation Successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/logs": {
      "post": {
        "summary": "Add a file upload log entry",
        "operationId": "AddLog",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddFileUploadLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Log successfully added",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/logs/{logId}/error": {
      "put": {
        "summary": "Update log error content",
        "operationId": "UpdateLogErrorContent",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadLogUpdateWithErrorContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Log error content successfully updated"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkUploadAddDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        }
      },
      "BulkUploadAddAndApproveDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadAddAndApproveDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        }
      },
      "BulkUploadAddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "LegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "AgreementId": {
            "type": "string",
            "nullable": true
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CohortRef": {
            "type": "string",
            "nullable": true
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string"
          },
          "StartDateAsString": {
            "type": "string",
            "nullable": true
          },
          "EndDateAsString": {
            "type": "string",
            "nullable": true
          },
          "OriginatorReference": {
            "type": "string",
            "nullable": true
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "DateOfBirthAsString": {
            "type": "string",
            "nullable": true
          },
          "Uln": {
            "type": "string"
          },
          "ProviderRef": {
            "type": "string",
            "nullable": true
          },
          "RowNumber": {
            "type": "integer"
          },
          "CostAsString": {
            "type": "string",
            "nullable": true
          },
          "EPAOrgId": {
            "type": "string",
            "nullable": true
          },
          "RecognisePriorLearningAsString": {
            "type": "string",
            "nullable": true
          },
          "DurationReducedByAsString": {
            "type": "string",
            "nullable": true
          },
          "PriceReducedByAsString": {
            "type": "string",
            "nullable": true
          },
          "TrainingTotalHoursAsString": {
            "type": "string",
            "nullable": true
          },
          "TrainingHoursReductionAsString": {
            "type": "string",
            "nullable": true
          },
          "IsDurationReducedByRPLAsString": {
            "type": "string",
            "nullable": true
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer",
            "nullable": true
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "BulkUploadValidateApiRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CsvRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "BulkReservationValidationResults": {
            "type": "object",
            "nullable": true
          },
          "ProviderStandardsData": {
            "type": "object",
            "nullable": true
          },
          "OtjTrainingHours": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "nullable": true
            }
          }
        }
      },
      "AddFileUploadLogRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "FileName": {
            "type": "string"
          },
          "RplCount": {
            "type": "integer",
            "nullable": true
          },
          "RowCount": {
            "type": "integer",
            "nullable": true
          },
          "FileContent": {
            "type": "string"
          }
        }
      },
      "FileUploadLogUpdateWithErrorContentRequest": {
        "type": "object",
        "properties": {
          "ErrorContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string",
            "nullable": true
          },
          "UserEmail": {
            "type": "string",
            "format": "email",
            "nullable": true
          }
        }
      }
    }
  }
}
