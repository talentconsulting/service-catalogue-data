{
  "openapi": "3.1.0",
  "info": {
    "title": "Bulk Upload API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/{providerId}/bulkupload": {
      "post": {
        "summary": "Add draft apprenticeships via bulk upload.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships successfully added."
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/addandapprove": {
      "post": {
        "summary": "Add and approve draft apprenticeships via bulk upload.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddAndApproveDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships added and approved successfully."
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/validate": {
      "post": {
        "summary": "Validate bulk upload request.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadValidateApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk upload request validated successfully."
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/logs": {
      "post": {
        "summary": "Add a file upload log.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddFileUploadLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File upload log added successfully."
          }
        }
      }
    },
    "/api/{providerId}/bulkupload/logs/{logId}/error": {
      "put": {
        "summary": "Update error content of a file upload log.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadLogUpdateWithErrorContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Error content updated successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkUploadAddDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        }
      },
      "BulkUploadAddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "LegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "AgreementId": {
            "type": "string",
            "nullable": true
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CohortRef": {
            "type": "string",
            "nullable": true
          },
          "UserId": {
            "type": "string",
            "nullable": true
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "OriginatorReference": {
            "type": "string",
            "nullable": true
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "FirstName": {
            "type": "string",
            "nullable": true
          },
          "LastName": {
            "type": "string",
            "nullable": true
          },
          "Email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "Uln": {
            "type": "string",
            "nullable": true
          },
          "ProviderRef": {
            "type": "string",
            "nullable": true
          },
          "RowNumber": {
            "type": "integer"
          },
          "Cost": {
            "type": "integer",
            "nullable": true
          },
          "EPAOrgId": {
            "type": "string",
            "nullable": true
          },
          "RecognisePriorLearning": {
            "type": "boolean",
            "nullable": true
          },
          "DurationReducedBy": {
            "type": "integer",
            "nullable": true
          },
          "PriceReducedBy": {
            "type": "integer",
            "nullable": true
          },
          "TrainingTotalHours": {
            "type": "integer",
            "nullable": true
          },
          "TrainingHoursReduction": {
            "type": "integer",
            "nullable": true
          },
          "IsDurationReducedByRPL": {
            "type": "boolean",
            "nullable": true
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer",
            "nullable": true
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "BulkUploadAddAndApproveDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadAddAndApproveDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        }
      },
      "BulkUploadValidateApiRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CsvRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "BulkReservationValidationResults": {
            "$ref": "#/components/schemas/BulkReservationValidationResults"
          },
          "ProviderStandardsData": {
            "$ref": "#/components/schemas/ProviderStandardResults"
          },
          "OtjTrainingHours": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "nullable": true
            }
          }
        }
      },
      "AddFileUploadLogRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "FileName": {
            "type": "string",
            "nullable": true
          },
          "RplCount": {
            "type": "integer",
            "nullable": true
          },
          "RowCount": {
            "type": "integer",
            "nullable": true
          },
          "FileContent": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "FileUploadLogUpdateWithErrorContentRequest": {
        "type": "object",
        "properties": {
          "ErrorContent": {
            "type": "string",
            "nullable": true
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "BulkReservationValidationResults": {
        "type": "object",
        "properties": {
          "ValidationErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkReservationValidation"
            }
          }
        }
      },
      "BulkReservationValidation": {
        "type": "object",
        "properties": {
          "Reason": {
            "type": "string",
            "nullable": true
          },
          "RowNumber": {
            "type": "integer"
          }
        }
      },
      "ProviderStandardResults": {
        "type": "object",
        "properties": {
          "IsMainProvider": {
            "type": "boolean"
          },
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderStandard"
            }
          }
        }
      },
      "ProviderStandard": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Level": {
            "type": "integer",
            "nullable": true
          }
        }
      }
    }
  }
}
