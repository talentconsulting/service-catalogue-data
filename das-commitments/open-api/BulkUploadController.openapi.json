{
  "openapi": "3.1.0",
  "info": {
    "title": "Bulk Upload API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/{providerId}/bulkupload": {
      "post": {
        "operationId": "AddDraftApprenticeships",
        "summary": "Create draft apprenticeships using bulk upload",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Bulk upload request for creating draft apprenticeships",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/addandapprove": {
      "post": {
        "operationId": "AddAndApproveDraftApprenticeships",
        "summary": "Create and approve draft apprenticeships using bulk upload",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Bulk upload request for creating and approving draft apprenticeships",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddAndApproveDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/validate": {
      "post": {
        "operationId": "ValidateBulkUpload",
        "summary": "Validate bulk upload data",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Request to validate bulk upload data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadValidateApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkReservationValidationResults"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/logs": {
      "post": {
        "operationId": "AddFileUploadLog",
        "summary": "Add a file upload log record",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "File upload log request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddFileUploadLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/{providerId}/bulkupload/logs/{logId}/error": {
      "put": {
        "operationId": "UpdateFileUploadLogErrorContent",
        "summary": "Update file upload log with error content",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Provider ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "description": "Log ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Error content update request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FileUploadLogUpdateWithErrorContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddFileUploadLogRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "FileName": {
            "type": "string"
          },
          "RplCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "RowCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "FileContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "BulkUploadAddAndApproveDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadAddAndApproveDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "BulkUploadAddDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "LogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "BulkUploadAddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "LegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "AgreementId": {
            "type": "string"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CohortRef": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string"
          },
          "StartDateAsString": {
            "type": "string",
            "format": "date"
          },
          "EndDateAsString": {
            "type": "string",
            "format": "date"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "DateOfBirthAsString": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "ProviderRef": {
            "type": "string"
          },
          "RowNumber": {
            "type": "integer",
            "format": "int32"
          },
          "CostAsString": {
            "type": "string"
          },
          "EPAOrgId": {
            "type": "string"
          },
          "RecognisePriorLearningAsString": {
            "type": "string"
          },
          "DurationReducedByAsString": {
            "type": "string"
          },
          "PriceReducedByAsString": {
            "type": "string"
          },
          "TrainingTotalHoursAsString": {
            "type": "string"
          },
          "TrainingHoursReductionAsString": {
            "type": "string"
          },
          "IsDurationReducedByRPLAsString": {
            "type": "string"
          },
          "MinimumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "MaximumAgeAtApprenticeshipStart": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "BulkUploadValidateApiRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CsvRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "BulkReservationValidationResults": {
            "$ref": "#/components/schemas/BulkReservationValidationResults"
          },
          "ProviderStandardsData": {
            "$ref": "#/components/schemas/ProviderStandardResults"
          },
          "OtjTrainingHours": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "nullable": true
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "FileUploadLogUpdateWithErrorContentRequest": {
        "type": "object",
        "properties": {
          "ErrorContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "BulkReservationValidationResults": {
        "type": "object",
        "properties": {
          "ValidationErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkReservationValidation"
            }
          }
        }
      },
      "BulkReservationValidation": {
        "type": "object",
        "properties": {
          "Reason": {
            "type": "string"
          },
          "RowNumber": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProviderStandardResults": {
        "type": "object",
        "properties": {
          "IsMainProvider": {
            "type": "boolean"
          },
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderStandard"
            }
          }
        }
      },
      "ProviderStandard": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Level": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
