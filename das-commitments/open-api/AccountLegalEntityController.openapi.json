{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Legal Entity API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AccountLegalEntity/{AccountLegalEntityId}": {
      "get": {
        "operationId": "GetAccountLegalEntity",
        "summary": "Retrieve details of a specific Account Legal Entity.",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the Account Legal Entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLegalEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Validation errors occurred."
          },
          "404": {
            "description": "Account Legal Entity not found."
          }
        },
        "security": [
          {
            "type": "http",
            "scheme": "bearer"
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLegalEntityResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "The Account ID associated with the legal entity."
          },
          "MaLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "description": "The MA Legal Entity ID."
          },
          "AccountName": {
            "type": "string",
            "description": "The account's name."
          },
          "LegalEntityName": {
            "type": "string",
            "description": "The name of the legal entity."
          },
          "LevyStatus": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType",
            "description": "The Levy status of the employer."
          }
        },
        "required": [
          "AccountId",
          "MaLegalEntityId",
          "AccountName",
          "LegalEntityName",
          "LevyStatus"
        ]
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "description": "The type of apprenticeship employer.",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      }
    }
  }
}
