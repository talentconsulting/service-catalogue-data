{
  "openapi": "3.1.0",
  "info": {
    "title": "AccountLegalEntity API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AccountLegalEntity/{AccountLegalEntityId}": {
      "get": {
        "summary": "Get account legal entity details",
        "operationId": "GetAccountLegalEntity",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the account legal entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Account legal entity details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLegalEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, validation error."
          },
          "404": {
            "description": "Account legal entity not found."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLegalEntityResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the account owning the legal entity."
          },
          "MaLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the legal entity."
          },
          "AccountName": {
            "type": "string",
            "description": "Name of the account owning the legal entity."
          },
          "LegalEntityName": {
            "type": "string",
            "description": "Name of the legal entity."
          },
          "LevyStatus": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType",
            "description": "Levy status of the legal entity."
          }
        }
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "description": "Type of apprenticeship employer.",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      }
    }
  }
}
