{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Legal Entity API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AccountLegalEntity/{AccountLegalEntityId}": {
      "get": {
        "summary": "Get account legal entity details",
        "operationId": "GetAccountLegalEntity",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "description": "The ID of the Account Legal Entity",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with account legal entity details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLegalEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - The request contains invalid data"
          },
          "404": {
            "description": "Not Found - AccountLegalEntityId does not exist"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLegalEntityResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "MaLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountName": {
            "type": "string"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "LevyStatus": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType"
          }
        },
        "required": [
          "AccountId",
          "MaLegalEntityId",
          "AccountName",
          "LegalEntityName",
          "LevyStatus"
        ]
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ],
        "description": "The type of apprenticeship employer. Can be 'NonLevy' or 'Levy'."
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
