{
  "openapi": "3.1.0",
  "info": {
    "title": "CommitmentsV2 API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AccountLegalEntity/{AccountLegalEntityId}": {
      "get": {
        "summary": "Fetch Account Legal Entity Details",
        "description": "Retrieves details of the specified account legal entity by ID.",
        "operationId": "GetAccountLegalEntity",
        "parameters": [
          {
            "name": "AccountLegalEntityId",
            "in": "path",
            "required": true,
            "description": "The ID of the account legal entity.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account Legal Entity Details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLegalEntityResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLegalEntityResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the account."
          },
          "MaLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the legal entity associated with the account."
          },
          "AccountName": {
            "type": "string",
            "description": "The name of the account."
          },
          "LegalEntityName": {
            "type": "string",
            "description": "The name of the legal entity."
          },
          "LevyStatus": {
            "type": "string",
            "enum": [
              "NonLevy",
              "Levy"
            ],
            "description": "The levy status of the legal entity."
          }
        },
        "required": [
          "AccountId",
          "MaLegalEntityId",
          "AccountName",
          "LegalEntityName",
          "LevyStatus"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
