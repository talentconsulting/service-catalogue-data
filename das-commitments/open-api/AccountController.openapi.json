{
  "openapi": "3.1.0",
  "info": {
    "title": "Account API",
    "version": "1.0.0",
    "description": "API for managing accounts and provider payments priority within the apprenticeship system."
  },
  "paths": {
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Get Account",
        "description": "Retrieve an account summary for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/transfer-status": {
      "get": {
        "summary": "Get Account Transfer Status",
        "description": "Retrieve the transfer status of a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountTransferStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/status": {
      "get": {
        "summary": "Get Account Status",
        "description": "Retrieve the status of a specific account with optional parameters.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "completionLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "newStartWindow",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/providers/approved": {
      "get": {
        "summary": "Get Approved Providers",
        "description": "Retrieve a list of approved providers for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved providers retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprovedProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/provider-payments-priority": {
      "get": {
        "summary": "Get Provider Payments Priority",
        "description": "Retrieve the provider payments priority for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider payments priority retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderPaymentsPriorityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/summary": {
      "get": {
        "summary": "Get Employer Account Summary",
        "description": "Retrieve the apprenticeship status summary for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship status summary retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipStatusSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Summary not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/pending-apprentice-changes": {
      "get": {
        "summary": "Get Pending Apprentice Changes",
        "description": "Retrieve pending apprentice changes for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending apprentice changes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Changes not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/pending-learner-change-counts": {
      "get": {
        "summary": "Get Pending Learner Change Counts",
        "description": "Retrieve pending learner change counts for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending learner change counts retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPendingLearnerChangeCountsForEmployerQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Counts not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/update-provider-payments-priority": {
      "post": {
        "summary": "Update Provider Payments Priority",
        "description": "Update the provider payments priority for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderPaymentsPriorityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider payments priority updated successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "HasCohorts": {
            "type": "boolean"
          },
          "HasApprenticeships": {
            "type": "boolean"
          },
          "LevyStatus": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType"
          }
        }
      },
      "AccountTransferStatusResponse": {
        "type": "object",
        "properties": {
          "IsTransferSender": {
            "type": "boolean"
          },
          "IsTransferReceiver": {
            "type": "boolean"
          }
        }
      },
      "AccountStatusResponse": {
        "type": "object",
        "properties": {
          "Active": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "Completed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "NewStart": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          }
        }
      },
      "AccountStatusProviderCourse": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "CourseCode": {
            "type": "string"
          }
        }
      },
      "GetApprovedProvidersResponse": {
        "type": "object",
        "properties": {
          "ProviderIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "GetPendingLearnerChangeCountsForEmployerQueryResponse": {
        "type": "object",
        "properties": {
          "ManualPendingChangeCount": {
            "type": "integer"
          },
          "IlrPendingChangeCount": {
            "type": "integer"
          }
        }
      },
      "UpdateProviderPaymentsPriorityRequest": {
        "type": "object",
        "properties": {
          "ProviderPriorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderPaymentPriorityUpdateItem"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ProviderPaymentPriorityUpdateItem": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "PriorityOrder": {
            "type": "integer"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      }
    }
  }
}
