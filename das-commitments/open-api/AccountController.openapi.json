{
  "openapi": "3.1.0",
  "info": {
    "title": "Account API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Get account summary",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/transfer-status": {
      "get": {
        "summary": "Get account transfer status",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountTransferStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/status": {
      "get": {
        "summary": "Get account status",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "completionLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "newStartWindow",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/providers/approved": {
      "get": {
        "summary": "Get approved providers for an account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprovedProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/provider-payments-priority": {
      "get": {
        "summary": "Get provider payments priority",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderPaymentsPriorityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/summary": {
      "get": {
        "summary": "Get employer account summary",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipStatusSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/pending-apprentice-changes": {
      "get": {
        "summary": "Get pending apprentice changes",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/pending-learner-change-counts": {
      "get": {
        "summary": "Get pending learner change counts for employer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPendingLearnerChangeCountsForEmployerQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/update-provider-payments-priority": {
      "post": {
        "summary": "Update provider payments priority",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderPaymentsPriorityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "LevyStatus": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType"
          }
        },
        "required": [
          "AccountId",
          "LevyStatus"
        ]
      },
      "AccountTransferStatusResponse": {
        "type": "object",
        "properties": {
          "IsTransferSender": {
            "type": "boolean"
          },
          "IsTransferReceiver": {
            "type": "boolean"
          }
        },
        "required": [
          "IsTransferSender",
          "IsTransferReceiver"
        ]
      },
      "AccountStatusResponse": {
        "type": "object",
        "properties": {
          "Active": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "Completed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "NewStart": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          }
        },
        "required": [
          "Active",
          "Completed",
          "NewStart"
        ]
      },
      "AccountStatusProviderCourse": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string"
          }
        },
        "required": [
          "Ukprn",
          "CourseCode"
        ]
      },
      "GetApprovedProvidersResponse": {
        "type": "object",
        "properties": {
          "ProviderIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        "required": [
          "ProviderIds"
        ]
      },
      "GetProviderPaymentsPriorityResponse": {
        "type": "object",
        "description": "The response type for provider payments priority."
      },
      "GetApprenticeshipStatusSummaryResponse": {
        "type": "object",
        "description": "The response type for apprenticeship status summary."
      },
      "GetApprenticeshipUpdatesResponse": {
        "type": "object",
        "description": "The response type for pending apprentice changes."
      },
      "GetPendingLearnerChangeCountsForEmployerQueryResponse": {
        "type": "object",
        "properties": {
          "ManualPendingChangeCount": {
            "type": "integer"
          },
          "IlrPendingChangeCount": {
            "type": "integer"
          }
        },
        "required": [
          "ManualPendingChangeCount",
          "IlrPendingChangeCount"
        ]
      },
      "UpdateProviderPaymentsPriorityRequest": {
        "type": "object",
        "properties": {
          "ProviderPriorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderPaymentPriorityUpdateItem"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderPriorities",
          "UserInfo"
        ]
      },
      "ProviderPaymentPriorityUpdateItem": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "PriorityOrder": {
            "type": "integer"
          }
        },
        "required": [
          "ProviderId",
          "PriorityOrder"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      }
    }
  }
}
