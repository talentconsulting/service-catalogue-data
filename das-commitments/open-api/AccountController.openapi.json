{
  "openapi": "3.1.0",
  "info": {
    "title": "Account API",
    "version": "1.0.0",
    "description": "API for managing account-related operations."
  },
  "paths": {
    "/api/accounts/{accountId}": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get account information",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account information retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/transfer-status": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get account transfer status",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountTransferStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/status": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get account status",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "completionLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "startLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "newStartWindow",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/providers/approved": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get approved providers",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved providers retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprovedProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/provider-payments-priority": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get provider payments priority",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider payments priority retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprovedProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/summary": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get employer account summary",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account summary retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/pending-apprentice-changes": {
      "get": {
        "tags": [
          "Account"
        ],
        "summary": "Get pending apprentice changes",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pending apprentice changes retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/update-provider-payments-priority": {
      "post": {
        "tags": [
          "Account"
        ],
        "summary": "Update provider payments priority",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderPaymentsPriorityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Provider payments priority updated successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "HasCohorts": {
            "type": "boolean"
          },
          "HasApprenticeships": {
            "type": "boolean"
          },
          "LevyStatus": {
            "type": "string",
            "enum": [
              "NonLevy",
              "Levy"
            ]
          }
        }
      },
      "AccountStatusResponse": {
        "type": "object",
        "properties": {
          "Active": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "Completed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          },
          "NewStart": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountStatusProviderCourse"
            }
          }
        }
      },
      "AccountStatusProviderCourse": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "CourseCode": {
            "type": "string"
          }
        }
      },
      "AccountTransferStatusResponse": {
        "type": "object",
        "properties": {
          "IsTransferSender": {
            "type": "boolean"
          },
          "IsTransferReceiver": {
            "type": "boolean"
          }
        }
      },
      "GetApprovedProvidersResponse": {
        "type": "object",
        "properties": {
          "ProviderIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "UpdateProviderPaymentsPriorityRequest": {
        "type": "object",
        "properties": {
          "ProviderPriorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderPaymentPriorityUpdateItem"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ProviderPaymentPriorityUpdateItem": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "PriorityOrder": {
            "type": "integer"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
