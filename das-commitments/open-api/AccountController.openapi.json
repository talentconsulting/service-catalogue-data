{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Retrieve employer account details",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/transfer-status": {
      "get": {
        "summary": "Retrieve account transfer status",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountTransferStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/status": {
      "get": {
        "summary": "Retrieve account status summary",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "completionLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "startLag",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "newStartWindow",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountStatusResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/providers/approved": {
      "get": {
        "summary": "Retrieve approved providers for the account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprovedProvidersResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/provider-payments-priority": {
      "get": {
        "summary": "Retrieve priority payments for providers",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderPaymentsPriorityResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/summary": {
      "get": {
        "summary": "Retrieve apprenticeship status summary",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipStatusSummaryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/pending-apprentice-changes": {
      "get": {
        "summary": "Retrieve pending apprentice changes",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipUpdatesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/update-provider-payments-priority": {
      "post": {
        "summary": "Update priority payments for providers",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderPaymentsPriorityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountResponse": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "LevyStatus": {
            "type": "string"
          }
        }
      },
      "AccountTransferStatusResponse": {
        "type": "object",
        "properties": {
          "IsTransferReceiver": {
            "type": "boolean"
          },
          "IsTransferSender": {
            "type": "boolean"
          }
        }
      },
      "AccountStatusResponse": {
        "type": "object",
        "properties": {
          "Active": {
            "type": "integer",
            "format": "int64"
          },
          "Completed": {
            "type": "integer",
            "format": "int64"
          },
          "NewStart": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "GetApprovedProvidersResponse": {
        "type": "object",
        "properties": {
          "ProviderIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "GetProviderPaymentsPriorityResponse": {
        "type": "object",
        "properties": {
          "ProviderPriorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderPaymentPriorityUpdateItem"
            }
          }
        }
      },
      "GetApprenticeshipStatusSummaryResponse": {
        "type": "object",
        "properties": {
          "ApprenticeshipStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "GetApprenticeshipUpdatesResponse": {
        "type": "object",
        "properties": {
          "Updates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "UpdateProviderPaymentsPriorityRequest": {
        "type": "object",
        "properties": {
          "ProviderPriorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderPaymentPriorityUpdateItem"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ProviderPaymentPriorityUpdateItem": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "PriorityOrder": {
            "type": "integer"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
