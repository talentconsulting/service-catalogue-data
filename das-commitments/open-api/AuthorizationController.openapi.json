{
  "openapi": "3.1.0",
  "info": {
    "title": "Authorization API",
    "version": "1.0.0",
    "description": "API for managing authorization aspects for cohorts and apprenticeships."
  },
  "paths": {
    "/api/authorization/access-cohort": {
      "get": {
        "operationId": "CanAccessCohort",
        "summary": "Determine if a party can access a cohort.",
        "parameters": [
          {
            "name": "CohortId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation was successful.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/authorization/access-apprenticeship": {
      "get": {
        "operationId": "CanAccessApprenticeship",
        "summary": "Determine if a party can access an apprenticeship.",
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation was successful.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/authorization/features/providers/{providerId}/apprentice-email-required": {
      "get": {
        "operationId": "ApprenticeEmailRequired",
        "summary": "Check if the 'apprentice-email-required' feature is enabled for a provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The feature is enabled for the provider."
          },
          "404": {
            "description": "The feature is disabled for the provider."
          }
        }
      }
    },
    "/api/authorization/email-optional": {
      "get": {
        "operationId": "OptionalEmail",
        "summary": "Check if optional email is enabled.",
        "parameters": [
          {
            "name": "employerid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Optional email is enabled."
          },
          "404": {
            "description": "Optional email is disabled."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Party": {
        "type": "string",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ]
      }
    }
  }
}
