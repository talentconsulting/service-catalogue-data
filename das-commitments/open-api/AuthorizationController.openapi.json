{
  "openapi": "3.1.0",
  "info": {
    "title": "Authorization API",
    "description": "API for managing authorization, cohort, and apprenticeship accesses.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/authorization/access-cohort": {
      "get": {
        "operationId": "canAccessCohort",
        "summary": "Verify access to a cohort",
        "tags": [
          "Authorization"
        ],
        "parameters": [
          {
            "name": "CohortId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/authorization/access-apprenticeship": {
      "get": {
        "operationId": "canAccessApprenticeship",
        "summary": "Verify if user can access an apprenticeship",
        "tags": [
          "Authorization"
        ],
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/authorization/features/providers/{providerId}/apprentice-email-required": {
      "get": {
        "operationId": "apprenticeEmailRequired",
        "summary": "Check if email is required for an apprentice under a provider",
        "tags": [
          "Authorization"
        ],
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email required",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Email not required"
          }
        }
      }
    },
    "/api/authorization/email-optional": {
      "get": {
        "operationId": "optionalEmail",
        "summary": "Check if email is optional for a given employer and provider combination",
        "tags": [
          "Authorization"
        ],
        "parameters": [
          {
            "name": "employerid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Email optional",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Email not optional"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Party": {
        "type": "string",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ]
      }
    }
  }
}
