{
  "openapi": "3.1.0",
  "info": {
    "title": "Authorization API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/authorization/access-cohort": {
      "get": {
        "operationId": "CanAccessCohort",
        "summary": "Determine if a party can access a cohort",
        "parameters": [
          {
            "name": "CohortId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/authorization/access-apprenticeship": {
      "get": {
        "operationId": "CanAccessApprenticeship",
        "summary": "Determine if a party can access an apprenticeship",
        "parameters": [
          {
            "name": "ApprenticeshipId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "Party",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          },
          {
            "name": "PartyId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {}
            }
          }
        }
      }
    },
    "/api/authorization/features/providers/{providerId}/apprentice-email-required": {
      "get": {
        "operationId": "ApprenticeEmailRequired",
        "summary": "Check if the 'apprentice-email-required' feature is enabled for a specific provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The feature is enabled for the provider.",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "The feature is disabled for the provider."
          }
        }
      }
    },
    "/api/authorization/email-optional": {
      "get": {
        "operationId": "OptionalEmail",
        "summary": "Check if emails are optional for apprenticeship accounts.",
        "parameters": [
          {
            "name": "employerid",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Emails are optional for the given employer and provider.",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Emails are required for the given employer and provider."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Party": {
        "type": "string",
        "description": "An enumeration representing the type of a party (Employer, Provider, TransferSender)",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ]
      }
    }
  }
}
