{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Progress API",
    "version": "1.0.0"
  },
  "paths": {
    "/notifications/apprenticeship-progress/{apprenticeIdentifier}/": {
      "post": {
        "summary": "Create Apprenticeship Progress",
        "operationId": "CreateApprenticeshipProgress",
        "parameters": [
          {
            "name": "apprenticeIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddApprenticeshipProgressResult"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/apprenticeship-progress/{apprenticeIdentifier}": {
      "get": {
        "summary": "Get Apprentice Progress by Apprentice Identifier",
        "operationId": "GetApprenticeProgressByApprenticeId",
        "parameters": [
          {
            "name": "apprenticeIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipProgressNotificationsByIdResult"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/progress-notification/{notificationId}": {
      "get": {
        "summary": "Get Progress Notification by ID",
        "operationId": "GetProgressNotificationById",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProgressNotificationsByIdResult"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/progress-notification-to-check": {
      "get": {
        "summary": "Get Progress Notifications to Check",
        "operationId": "GetProgressNotificationsToCheck",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProgressNotificationsToCheckResult"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/updateProgressNotificationStatus/{notificationId}/{apprenticeProgressId}": {
      "patch": {
        "summary": "Update Progress Notification Status",
        "operationId": "UpdateProgressNotificationStatus",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeProgressId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddApprenticeshipProgressResult": {
        "type": "object",
        "additionalProperties": true
      },
      "GetApprenticeshipProgressNotificationsByIdResult": {
        "type": "object",
        "additionalProperties": true
      },
      "GetProgressNotificationsByIdResult": {
        "type": "object",
        "additionalProperties": true
      },
      "GetProgressNotificationsToCheckResult": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
