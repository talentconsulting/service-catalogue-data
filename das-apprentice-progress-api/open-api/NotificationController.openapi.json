{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Progress API",
    "version": "1.0.0"
  },
  "paths": {
    "/notifications/apprenticeship-progress/{apprenticeIdentifier}/": {
      "post": {
        "operationId": "createApprenticeshipProgress",
        "parameters": [
          {
            "name": "apprenticeIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/apprenticeship-progress/{apprenticeIdentifier}": {
      "get": {
        "operationId": "getApprenticeProgressByApprenticeId",
        "parameters": [
          {
            "name": "apprenticeIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/progress-notification/{notificationId}": {
      "get": {
        "operationId": "getProgressNotificationById",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/progress-notification-to-check": {
      "get": {
        "operationId": "getProgressNotificationsToCheck",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/notifications/updateProgressNotificationStatus/{notificationId}/{apprenticeProgressId}": {
      "patch": {
        "operationId": "updateProgressNotificationStatus",
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeProgressId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Task": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "DueDate": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          },
          "ApprenticeshipCategoryId": {
            "type": "integer",
            "nullable": true
          },
          "Note": {
            "type": "string"
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CreatedDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "TaskFiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskFile"
            }
          },
          "TaskReminders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskReminder"
            }
          },
          "TaskLinkedKsbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskKSBs"
            }
          }
        }
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "Todo",
          "Done"
        ]
      },
      "TaskFile": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "TaskFileId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "FileType": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "FileContents": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "TaskReminder": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "ReminderId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "ReminderValue": {
            "type": "integer",
            "nullable": true
          },
          "ReminderUnit": {
            "$ref": "#/components/schemas/ReminderUnit"
          },
          "Status": {
            "$ref": "#/components/schemas/ReminderStatus"
          }
        }
      },
      "ReminderUnit": {
        "type": "string",
        "enum": [
          "Minutes",
          "Hours",
          "Days"
        ]
      },
      "ReminderStatus": {
        "type": "string",
        "enum": [
          "NotSent",
          "Sent",
          "Dismissed"
        ]
      },
      "TaskKSBs": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "KSBProgressId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        }
      },
      "ApprenticeshipCategory": {
        "type": "object",
        "properties": {
          "CategoryId": {
            "type": "integer",
            "format": "int32"
          },
          "Title": {
            "type": "string"
          }
        }
      }
    }
  }
}
