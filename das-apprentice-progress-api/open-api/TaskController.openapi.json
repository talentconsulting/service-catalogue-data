{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Progress API",
    "version": "1.0"
  },
  "paths": {
    "/apprenticeships/{apprenticeshipIdentifier}/taskCategories": {
      "get": {
        "summary": "Retrieve all task categories for an apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of categories.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeshipCategory"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Categories not found."
          }
        }
      },
      "post": {
        "summary": "Add a new task category to an apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "categoryId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Category successfully added."
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/taskCategories/{taskCategoryId}": {
      "get": {
        "summary": "Retrieve specific task category details.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskCategoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of task category details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Task category not found."
          }
        }
      },
      "delete": {
        "summary": "Delete a specific task category.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskCategoryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task category successfully deleted."
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/fromDate/{fromDate}/toDate/{toDate}/status/{status}": {
      "get": {
        "summary": "Retrieve tasks by apprenticeship ID and status within date range.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fromDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of tasks.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Task"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Tasks not found."
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/tasks": {
      "post": {
        "summary": "Add a new task to an apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeTaskDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task successfully added."
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/tasks/{taskId}/changestatus/{status}": {
      "post": {
        "summary": "Change the status of a task.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task status successfully updated."
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/tasks/{taskId}": {
      "get": {
        "summary": "Retrieve task details using apprenticeship ID and task ID.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of task details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "404": {
            "description": "Task not found."
          }
        }
      },
      "post": {
        "summary": "Update task details.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeTaskDataRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task successfully updated."
          }
        }
      },
      "delete": {
        "summary": "Remove a task from an apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task successfully removed."
          }
        }
      }
    },
    "/gettaskreminders": {
      "get": {
        "summary": "Retrieve all task reminders.",
        "responses": {
          "200": {
            "description": "Successful retrieval of task reminders.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskReminder"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Task reminders not found."
          }
        }
      }
    },
    "/updatetaskreminders/tasks/{taskId}/status/{statusId}": {
      "post": {
        "summary": "Update a task reminder's status.",
        "parameters": [
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "statusId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task reminder successfully updated."
          }
        }
      }
    },
    "/apprenticeships/{apprenticeshipIdentifier}/taskreminders": {
      "get": {
        "summary": "Retrieve task reminders for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of task reminders.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskReminder"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Task reminders not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeTaskDataRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "TaskId": {
            "type": "integer"
          },
          "DueDate": {
            "type": "string",
            "format": "date-time"
          },
          "ApprenticeAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "ApprenticeshipCategoryId": {
            "type": "integer"
          },
          "Note": {
            "type": "string"
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "CategoryId": {
            "type": "integer"
          },
          "Status": {
            "type": "integer"
          },
          "Files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskFile"
            }
          },
          "ReminderUnit": {
            "type": "integer"
          },
          "ReminderValue": {
            "type": "integer"
          },
          "ReminderStatus": {
            "type": "integer"
          },
          "KsbsLinked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "TaskFile": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "TaskFileId": {
            "type": "integer"
          },
          "FileType": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "FileContents": {
            "type": "string",
            "format": "binary"
          }
        }
      },
      "TaskReminder": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "ReminderId": {
            "type": "integer"
          },
          "ReminderValue": {
            "type": "integer"
          },
          "ReminderUnit": {
            "type": "integer"
          },
          "Status": {
            "type": "integer"
          }
        }
      },
      "TaskKSBs": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "KSBProgressId": {
            "type": "integer"
          }
        }
      },
      "Task": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "ApprenticeshipId": {
            "type": "integer"
          },
          "ApprenticeAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "DueDate": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          },
          "ApprenticeshipCategoryId": {
            "type": "integer"
          },
          "Note": {
            "type": "string"
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "integer"
          }
        }
      },
      "ApprenticeshipCategory": {
        "type": "object",
        "properties": {
          "CategoryId": {
            "type": "integer"
          },
          "Title": {
            "type": "string"
          }
        }
      }
    }
  }
}
