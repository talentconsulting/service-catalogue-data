{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/ops/dataload": {
      "post": {
        "operationId": "queueDataLoad",
        "summary": "Queue a data load operation",
        "responses": {
          "202": {
            "description": "Data load operation successfully queued",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": {
                      "type": "string"
                    },
                    "RequestId": {
                      "type": "string"
                    },
                    "QueuedAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "Message",
                    "RequestId",
                    "QueuedAt"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflict occurred while queuing the operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "Message"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/ops/dataload/clear-cache": {
      "post": {
        "operationId": "clearCoursesCache",
        "summary": "Clear courses cache",
        "parameters": [
          {
            "name": "cancellationToken",
            "in": "query",
            "required": false,
            "description": "Cancellation token",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Cache cleared successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ImportDataCommand": {
        "type": "object",
        "additionalProperties": false
      },
      "ImportDataCommandResult": {
        "type": "object",
        "properties": {
          "ValidationMessages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "StandardsLoadedSuccessfully": {
            "type": "boolean"
          }
        },
        "required": [
          "ValidationMessages",
          "StandardsLoadedSuccessfully"
        ]
      },
      "ClearCoursesCacheCommand": {
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
