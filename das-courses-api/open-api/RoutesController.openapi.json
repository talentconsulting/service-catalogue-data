{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Courses API",
    "description": "An API for managing course information, routes, and related data.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/courses/routes": {
      "get": {
        "summary": "Get the list of routes",
        "operationId": "getRoutesList",
        "tags": [
          "Routes"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRoutesListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRoutesListResponse": {
        "type": "object",
        "properties": {
          "routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetRouteResponse"
            }
          }
        },
        "required": [
          "routes"
        ]
      },
      "GetRouteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "active"
        ]
      }
    }
  }
}
