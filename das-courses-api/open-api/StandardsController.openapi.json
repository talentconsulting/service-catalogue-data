{
  "openapi": "3.1.0",
  "info": {
    "title": "Courses API Standards",
    "version": "1.0.0",
    "description": "API for interacting with courses standards."
  },
  "paths": {
    "/api/courses/standards": {
      "get": {
        "description": "Retrieve a list of standards based on filters and keyword search.",
        "operationId": "GetStandardsList",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search keyword for filtering standards."
          },
          {
            "name": "routeIds",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Filter by specific route IDs."
          },
          {
            "name": "levels",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "description": "Filter by specific levels."
          },
          {
            "name": "apprenticeshipType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipType"
            },
            "description": "Filter by type of apprenticeship."
          },
          {
            "name": "orderBy",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OrderBy"
            },
            "description": "Ordering preference for the standards list."
          },
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/StandardFilter"
            },
            "description": "Filter applied to standards, e.g., active or available."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of standards list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesSearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameter format."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "deprecated": true
      }
    },
    "/api/courses/standards/{id}": {
      "get": {
        "description": "Retrieve detailed information about a specific standard by ID.",
        "operationId": "GetStandardById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the standard."
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed information of the standard.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "deprecated": true
      }
    },
    "/api/courses/standards/{id}/options/{option}/ksbs": {
      "get": {
        "description": "Retrieve knowledge, skills, and behaviors (KSBs) for a specific option of a standard.",
        "operationId": "GetStandardOptionKsbs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the standard."
          },
          {
            "name": "option",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Specific option identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Knowledge, skills, and behaviors (KSBs) for the option.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseOptionKsbsResult"
                }
              }
            }
          },
          "404": {
            "description": "Option not found for the given standard."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "deprecated": true
      }
    },
    "/api/courses/standards/versions/{iFateReferenceNumber}": {
      "get": {
        "description": "Retrieve versions for a standard based on its iFate reference number.",
        "operationId": "GetStandardVersions",
        "parameters": [
          {
            "name": "iFateReferenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "iFate reference number for the standard."
          }
        ],
        "responses": {
          "200": {
            "description": "Standard versions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseVersionsListResponse"
                }
              }
            }
          },
          "404": {
            "description": "No versions found for the standard."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "deprecated": true
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "OrderBy": {
        "type": "string",
        "enum": [
          "Score",
          "Title"
        ]
      },
      "StandardFilter": {
        "type": "string",
        "enum": [
          "None",
          "Active",
          "ActiveAvailable",
          "NotYetApproved",
          "ClosedToNewStarts"
        ]
      },
      "GetCoursesSearchResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "totalFiltered": {
            "type": "integer"
          },
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseResponse"
            }
          }
        }
      },
      "GetCourseResponse": {
        "type": "object",
        "properties": {
          "standardUId": {
            "type": "string"
          },
          "ifateReferenceNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "route": {
            "type": "string"
          },
          "routeCode": {
            "type": "integer"
          }
        }
      },
      "GetCourseDetailResponse": {
        "type": "object",
        "properties": {
          "standardUId": {
            "type": "string"
          },
          "ifateReferenceNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "overviewOfRole": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "routeCode": {
            "type": "integer"
          },
          "keywords": {
            "type": "string"
          },
          "typicalJobTitles": {
            "type": "string"
          }
        }
      },
      "GetCourseOptionKsbsResult": {
        "type": "object",
        "properties": {
          "ksbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KSB"
            }
          }
        }
      },
      "KSB": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "Knowledge",
              "Skill",
              "Behaviour",
              "TechnicalKnowledge",
              "TechnicalSkill",
              "EmployabilitySkillsAndBehaviour"
            ]
          }
        }
      },
      "GetCourseVersionsListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseDetailResponse"
            }
          }
        }
      }
    }
  }
}
