{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Courses API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship standards and frameworks"
  },
  "paths": {
    "/api/courses/standards": {
      "get": {
        "deprecated": true,
        "summary": "Retrieve a list of standards",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false
          },
          {
            "name": "routeIds",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false
          },
          {
            "name": "levels",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            },
            "required": false
          },
          {
            "name": "apprenticeshipType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipType"
            },
            "required": false
          },
          {
            "name": "orderBy",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OrderBy"
            },
            "required": false
          },
          {
            "name": "filter",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/StandardFilter"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/standards/{id}": {
      "get": {
        "deprecated": true,
        "summary": "Retrieve standard detail by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found"
          }
        }
      }
    },
    "/api/courses/standards/{id}/options/{option}/ksbs": {
      "get": {
        "deprecated": true,
        "summary": "Retrieve knowledge, skills, and behaviors for a specific option",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "option",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseOptionKsbsResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/courses/standards/versions/{iFateReferenceNumber}": {
      "get": {
        "deprecated": true,
        "summary": "Retrieve all versions of a standard by IFate reference number",
        "parameters": [
          {
            "name": "iFateReferenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseVersionsListResponse"
                }
              }
            }
          },
          "404": {
            "description": "No versions found for the given IFate reference number"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "OrderBy": {
        "type": "string",
        "enum": [
          "Score",
          "Title"
        ]
      },
      "StandardFilter": {
        "type": "string",
        "enum": [
          "None",
          "Active",
          "ActiveAvailable",
          "NotYetApproved",
          "ClosedToNewStarts"
        ]
      },
      "GetCoursesSearchResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "totalFiltered": {
            "type": "integer"
          },
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseResponse"
            }
          }
        },
        "required": [
          "total",
          "totalFiltered",
          "courses"
        ]
      },
      "GetCourseResponse": {
        "type": "object",
        "properties": {
          "standardUId": {
            "type": "string"
          },
          "ifateReferenceNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "searchScore": {
            "type": "number"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "coronationEmblem": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "overviewOfRole": {
            "type": "string"
          },
          "keywords": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "routeCode": {
            "type": "integer"
          },
          "typicalJobTitles": {
            "type": "string"
          },
          "standardPageUrl": {
            "type": "string"
          },
          "integratedDegree": {
            "type": "string"
          },
          "sectorSubjectAreaTier2": {
            "type": "number"
          },
          "sectorSubjectAreaTier2Description": {
            "type": "string"
          },
          "sectorSubjectAreaTier1": {
            "type": "integer"
          },
          "sectorSubjectAreaTier1Description": {
            "type": "string"
          },
          "otherBodyApprovalRequired": {
            "type": "boolean"
          },
          "approvalBody": {
            "type": "string"
          },
          "duties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "coreAndOptions": {
            "type": "boolean"
          },
          "coreDuties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "integratedApprenticeship": {
            "type": "boolean"
          },
          "sectorCode": {
            "type": "integer"
          },
          "epaoMustBeApprovedByRegulatorBody": {
            "type": "boolean"
          },
          "apprenticeshipStandardTypeCode": {
            "type": "string"
          },
          "isLatestVersion": {
            "type": "boolean"
          },
          "isRegulatedForProvider": {
            "type": "boolean"
          },
          "isRegulatedForEPAO": {
            "type": "boolean"
          },
          "apprenticeshipFunding": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseApprenticeshipFundingResponse"
            }
          },
          "learningType": {
            "$ref": "#/components/schemas/ApprenticeshipType"
          },
          "courseType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "ShortCourse"
            ]
          },
          "larsCode": {
            "type": "string"
          },
          "courseDates": {
            "$ref": "#/components/schemas/CourseDatesResponse"
          }
        },
        "required": [
          "standardUId",
          "title",
          "level",
          "route",
          "status"
        ]
      },
      "GetCourseDetailResponse": {
        "type": "object",
        "properties": {
          "standardUId": {
            "type": "string"
          },
          "ifateReferenceNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "integratedDegree": {
            "type": "string"
          },
          "overviewOfRole": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "routeCode": {
            "type": "integer"
          },
          "assessmentPlanUrl": {
            "type": "string"
          },
          "sectorCode": {
            "type": "integer"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "standardUId",
          "title",
          "level",
          "route",
          "status"
        ]
      },
      "GetCourseOptionKsbsResult": {
        "type": "object",
        "properties": {
          "ksbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ksb"
            }
          }
        },
        "required": [
          "ksbs"
        ]
      },
      "Ksb": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "Knowledge",
              "Skill",
              "Behaviour",
              "TechnicalKnowledge",
              "TechnicalSkill",
              "EmployabilitySkillsAndBehaviour"
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "id",
          "detail"
        ]
      },
      "GetCourseVersionsListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseDetailResponse"
            }
          }
        },
        "required": [
          "courses"
        ]
      },
      "CourseApprenticeshipFundingResponse": {
        "type": "object",
        "properties": {
          "maxEmployerLevyCap": {
            "type": "integer"
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "duration": {
            "type": "integer"
          },
          "durationUnits": {
            "type": "string",
            "enum": [
              "Months",
              "Hours"
            ]
          }
        },
        "required": [
          "maxEmployerLevyCap",
          "effectiveFrom",
          "duration",
          "durationUnits"
        ]
      },
      "CourseDatesResponse": {
        "type": "object",
        "properties": {
          "lastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "effectiveFrom"
        ]
      }
    }
  }
}
