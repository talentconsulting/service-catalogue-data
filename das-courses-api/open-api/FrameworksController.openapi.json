{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Courses API",
    "description": "API for accessing and managing courses and frameworks.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/courses/frameworks/{id}": {
      "get": {
        "summary": "Get Framework by ID",
        "description": "Retrieves a specific framework by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the framework to retrieve.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworkResponse"
                }
              }
            }
          },
          "404": {
            "description": "Framework not found."
          }
        }
      }
    },
    "/api/courses/frameworks/": {
      "get": {
        "summary": "List Frameworks",
        "description": "Retrieves a list of frameworks.",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworksResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetFrameworkResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "frameworkName": {
            "type": "string"
          },
          "pathwayName": {
            "type": "string"
          },
          "progType": {
            "type": "integer"
          },
          "frameworkCode": {
            "type": "integer"
          },
          "pathwayCode": {
            "type": "integer"
          },
          "level": {
            "type": "integer"
          },
          "typicalLength": {
            "$ref": "#/components/schemas/TypicalLengthResponse"
          },
          "duration": {
            "type": "integer"
          },
          "currentFundingCap": {
            "type": "integer"
          },
          "maxFunding": {
            "type": "integer"
          },
          "ssa1": {
            "type": "number"
          },
          "ssa2": {
            "type": "number"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "isActiveFramework": {
            "type": "boolean"
          },
          "fundingPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrameworkFundingResponse"
            }
          },
          "programmeType": {
            "type": "integer"
          },
          "hasSubGroups": {
            "type": "boolean"
          },
          "extendedTitle": {
            "type": "string"
          }
        }
      },
      "TypicalLengthResponse": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string"
          },
          "from": {
            "type": "integer"
          },
          "to": {
            "type": "integer"
          }
        }
      },
      "FrameworkFundingResponse": {
        "type": "object",
        "properties": {
          "fundingCap": {
            "type": "integer"
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetFrameworksResponse": {
        "type": "object",
        "properties": {
          "frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetFrameworkResponse"
            }
          }
        }
      }
    }
  }
}
