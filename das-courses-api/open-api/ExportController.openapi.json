{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/ops/export": {
      "get": {
        "summary": "Export Standards List",
        "operationId": "ExportController_Index",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsExportResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsExportResponse": {
        "type": "object",
        "properties": {
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardDetailResponse"
            }
          }
        },
        "additionalProperties": false
      },
      "GetStandardDetailResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
