{
  "openapi": "3.1.0",
  "info": {
    "title": "Courses API",
    "version": "1.0"
  },
  "paths": {
    "/api/courses/levels": {
      "get": {
        "summary": "Get a list of levels",
        "operationId": "getLevelsList",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLevelsListResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetLevelsListResponse": {
        "type": "object",
        "properties": {
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetLevelResponse"
            }
          }
        }
      },
      "GetLevelResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ]
      }
    }
  }
}
