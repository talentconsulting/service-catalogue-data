{
  "openapi": "3.1.0",
  "info": {
    "title": "Courses API",
    "version": "1.0"
  },
  "paths": {
    "/api/Courses/search": {
      "get": {
        "summary": "Search for courses",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "routeIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "levels",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "learningTypes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ApprenticeshipType"
              }
            }
          },
          {
            "name": "courseType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrderBy",
              "default": "Score"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/StandardFilter",
              "default": "ActiveAvailable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Courses/lookup/{id}": {
      "get": {
        "summary": "Get course details by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/api/Courses/lookup/{id}/options/{option}/ksbs": {
      "get": {
        "summary": "Get knowledge, skills, and behaviors for course option",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "option",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseOptionKsbsResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/Courses/lookup/versions/{iFateReferenceNumber}": {
      "get": {
        "summary": "Get courses by iFATE reference number",
        "parameters": [
          {
            "name": "iFateReferenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseVersionsListResponse"
                }
              }
            }
          },
          "404": {
            "description": "No courses found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "OrderBy": {
        "type": "string",
        "enum": [
          "Score",
          "Title"
        ]
      },
      "StandardFilter": {
        "type": "string",
        "enum": [
          "None",
          "Active",
          "ActiveAvailable",
          "NotYetApproved",
          "ClosedToNewStarts"
        ]
      },
      "GetCoursesSearchResponse": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "totalFiltered": {
            "type": "integer"
          },
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseResponse"
            }
          }
        }
      },
      "GetCourseResponse": {
        "type": "object",
        "properties": {
          "standardUId": {
            "type": "string"
          },
          "ifateReferenceNumber": {
            "type": "string"
          },
          "larsCode": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "searchScore": {
            "type": "number",
            "format": "float"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "coronationEmblem": {
            "type": "boolean"
          },
          "version": {
            "type": "string"
          },
          "overviewOfRole": {
            "type": "string"
          },
          "keywords": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "routeCode": {
            "type": "integer"
          },
          "typicalJobTitles": {
            "type": "string"
          },
          "standardPageUrl": {
            "type": "string"
          },
          "integratedDegree": {
            "type": "string"
          },
          "apprenticeshipFunding": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseApprenticeshipFundingResponse"
            }
          },
          "courseDates": {
            "$ref": "#/components/schemas/CourseDatesResponse"
          },
          "sectorSubjectAreaTier2": {
            "type": "number"
          },
          "sectorSubjectAreaTier2Description": {
            "type": "string"
          },
          "sectorSubjectAreaTier1": {
            "type": "integer"
          },
          "sectorSubjectAreaTier1Description": {
            "type": "string"
          },
          "otherBodyApprovalRequired": {
            "type": "boolean"
          },
          "approvalBody": {
            "type": "string"
          },
          "duties": {
            "type": "array",
