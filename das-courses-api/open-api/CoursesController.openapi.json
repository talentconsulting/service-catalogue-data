          }
        }
      },
      "KsbType": {
        "type": "string",
        "enum": [
          "Knowledge",
          "Skill",
          "Behaviour",
          "TechnicalKnowledge",
          "TechnicalSkill",
          "EmployabilitySkillsAndBehaviour"
        ]
      },
      "GetCourseVersionsListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
