          },
          "duration": {
            "type": "integer"
          },
          "incentive1618": {
            "type": "integer",
            "nullable": true
          },
          "providerAdditionalPayment1618": {
            "type": "integer",
            "nullable": true
          },
          "employerAdditionalPayment1618": {
            "type": "integer",
