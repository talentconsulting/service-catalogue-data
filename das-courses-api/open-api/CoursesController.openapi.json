{
  "openapi": "3.1.0",
  "info": {
    "title": "Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Courses/search": {
      "get": {
        "operationId": "searchCourses",
        "summary": "Search for courses based on various query parameters.",
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "routeIds",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "levels",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "learningTypes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/ApprenticeshipType"
              }
            }
          },
          {
            "name": "courseType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            }
          },
          {
            "name": "orderBy",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrderBy",
              "default": "Score"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/StandardFilter",
              "default": "ActiveAvailable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of courses matching the search criteria.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesSearchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Courses/lookup/{id}": {
      "get": {
        "operationId": "getCourseById",
        "summary": "Retrieve detailed information about a course by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed information about the requested course.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Course not found."
          }
        }
      }
    },
    "/api/Courses/lookup/{id}/options/{option}/ksbs": {
      "get": {
        "operationId": "getCourseOptionKsbs",
        "summary": "Get the KSBs (Knowledge, Skills, Behaviors) for a specific course option.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "option",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The KSBs for the specified course option.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseOptionKsbsResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/Courses/lookup/versions/{iFateReferenceNumber}": {
      "get": {
        "operationId": "getCoursesByIFateReferenceNumber",
        "summary": "Retrieve all versions of a course based on its iFate reference number.",
        "parameters": [
          {
            "name": "iFateReferenceNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "All versions of the course.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseVersionsListResponse"
                }
              }
            }
          },
          "404": {
            "description": "No versions found for the specified iFate reference number."
          }
        }
      }
    }
  },
