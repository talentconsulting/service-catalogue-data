          },
          "foundationAppSecondEmpPayment": {
            "type": "integer",
            "nullable": true
          },
          "foundationAppThirdEmpPayment": {
            "type": "integer",
            "nullable": true
          },
          "durationUnits": {
            "$ref": "#/components/schemas/DurationUnits"
          }
        }
      },
      "DurationUnits": {
        "type": "string",
        "enum": [
          "Months",
          "Hours"
        ]
      },
      "CourseDatesResponse": {
        "type": "object",
        "properties": {
          "lastDateStarts": {
