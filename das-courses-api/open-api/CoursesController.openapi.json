          },
          "isRegulatedForProvider": {
            "type": "boolean"
          },
          "isRegulatedForEPAO": {
            "type": "boolean"
          },
          "apprenticeshipStandardTypeCode": {
            "type": "string"
          },
          "relatedOccupations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RelatedOccupation"
            }
          },
          "learningType": {
            "$ref": "#/components/schemas/ApprenticeshipType"
          },
          "apprenticeshipFunding": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseApprenticeshipFundingResponse"
            }
          },
          "courseDates": {
            "$ref": "#/components/schemas/CourseDatesResponse"
          },
          "courseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "larsCode": {
            "type": "string"
          }
        }
      },
      "EqaProviderResponse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "contactName": {
            "type": "string",
            "nullable": true
          },
          "contactEmail": {
