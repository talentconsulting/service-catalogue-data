{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/upsert": {
      "put": {
        "summary": "Upsert Registered User",
        "operationId": "UpsertRegisteredUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRegisteredUserCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UpsertRegisteredUserCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmailAddress": {
            "type": "string",
            "format": "email"
          },
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "UserRef",
          "FirstName",
          "LastName",
          "EmailAddress",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "ReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
