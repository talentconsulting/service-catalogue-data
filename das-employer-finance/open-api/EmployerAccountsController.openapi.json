{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/balances": {
      "post": {
        "summary": "Get account balances",
        "operationId": "GetAccountBalances",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Account balances retrieved successfully"
          },
          "404": {
            "description": "Balances not found"
          }
        }
      }
    },
    "/api/accounts/{hashedAccountId}/transferAllowance": {
      "get": {
        "summary": "Get transfer allowance by hashed account ID",
        "operationId": "GetTransferAllowance",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer allowance retrieved successfully"
          },
          "404": {
            "description": "Transfer allowance not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/transferAllowanceByAccountId": {
      "get": {
        "summary": "Get transfer allowance by numeric account ID",
        "operationId": "GetTransferAllowanceByAccountId",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer allowance retrieved successfully"
          },
          "404": {
            "description": "Transfer allowance not found"
          }
        }
      }
    },
    "/api/accounts": {
      "get": {
        "summary": "Get a list of accounts",
        "operationId": "GetAccounts",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accounts retrieved successfully"
          },
          "404": {
            "description": "Accounts not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Get account by ID",
        "operationId": "GetAccountById",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account retrieved successfully"
          },
          "404": {
            "description": "Account not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/payments/ids": {
      "get": {
        "summary": "Get account payment IDs",
        "operationId": "GetAccountPaymentIds",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment IDs retrieved successfully"
          },
          "404": {
            "description": "Payment IDs not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/paye-schemes": {
      "get": {
        "summary": "Get PAYE schemes for an account",
        "operationId": "GetPayeSchemes",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PAYE schemes retrieved successfully"
          },
          "404": {
            "description": "PAYE schemes not found"
          }
        }
      }
    },
    "/api/accounts/{accountId}/expire-funds": {
      "post": {
        "summary": "Expire funds for an account",
        "operationId": "ExpireFunds",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExpireFundsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Funds expired successfully"
          },
          "400": {
            "description": "Invalid payload"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExpireFundsRequest": {
        "type": "object",
        "properties": {
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
