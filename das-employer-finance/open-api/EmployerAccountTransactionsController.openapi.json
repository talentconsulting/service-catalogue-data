{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Account Transactions API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/finance/provider/summary": {
      "get": {
        "summary": "Get Provider Payment Summary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider payment summary view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance": {
      "get": {
        "summary": "Finance Dashboard or Index View",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Finance dashboard or index view",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to another URL",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/downloadtransactions": {
      "get": {
        "summary": "Get Transactions Download View",
        "responses": {
          "200": {
            "description": "Transactions download form",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "summary": "Download Transactions",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionDownloadViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File download",
            "content": {
              "application/octet-stream": {}
            }
          },
          "400": {
            "description": "Validation errors",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/{year}/{month}": {
      "get": {
        "summary": "View Transactions",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction view",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to access denied page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/levyDeclaration/details": {
      "get": {
        "summary": "View Levy Declaration Details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Levy declaration detail view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/course/standard/summary": {
      "get": {
        "summary": "Get Course Standard Payment Summary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "courseLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course standard payment summary view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/course/framework/summary": {
      "get": {
        "summary": "Get Course Framework Payment Summary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "courseLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pathwayCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course framework payment summary view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/transfer/details": {
      "get": {
        "summary": "Get Transfer Details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer details view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/expiredfunds/details": {
      "get": {
        "summary": "Get Expired Funds Details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Expired funds detail view",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionDownloadViewModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "$ref": "#/components/schemas/MonthYear"
          },
          "EndDate": {
            "$ref": "#/components/schemas/MonthYear"
          },
          "DownloadFormat": {
            "type": "string",
            "enum": [
              "CSV",
              "Excel"
            ]
          },
          "Version": {
            "type": "string"
          }
        },
        "required": [
          "StartDate",
          "EndDate",
          "DownloadFormat",
          "Version"
        ]
      },
      "MonthYear": {
        "type": "object",
        "properties": {
          "Month": {
            "type": "string"
          },
          "Year": {
            "type": "string"
          },
          "Day": {
            "type": "string",
            "default": "1"
          }
        },
        "required": [
          "Month",
          "Year",
          "Day"
        ]
      }
    }
  }
}
