{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Account Transactions API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/finance/provider/summary": {
      "get": {
        "summary": "Get provider payment summary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance": {
      "get": {
        "summary": "View finance index",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/downloadtransactions": {
      "get": {
        "summary": "View transactions download page",
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "summary": "Download transactions",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionDownloadViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File successfully downloaded"
          },
          "400": {
            "description": "Validation error"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/{year}/{month}": {
      "get": {
        "summary": "View transactions by month and year",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "302": {
            "description": "Redirect to access denied"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/levyDeclaration/details": {
      "get": {
        "summary": "Get levy declaration details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/course/standard/summary": {
      "get": {
        "summary": "Get course standard payment summary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "courseLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/course/framework/summary": {
      "get": {
        "summary": "Get course framework payment summary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "courseLevel",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pathwayCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/transfer/details": {
      "get": {
        "summary": "Get transfer transaction details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/finance/expiredfunds/details": {
      "get": {
        "summary": "Get expired funds details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionDownloadViewModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "$ref": "#/components/schemas/MonthYear"
          },
          "EndDate": {
            "$ref": "#/components/schemas/MonthYear"
          },
          "DownloadFormat": {
            "enum": [
              "CSV",
              "Excel"
            ]
          },
          "Version": {
            "type": "string"
          }
        },
        "required": [
          "StartDate",
          "EndDate",
          "DownloadFormat",
          "Version"
        ]
      },
      "MonthYear": {
        "type": "object",
        "properties": {
          "Month": {
            "type": "string"
          },
          "Year": {
            "type": "string"
          }
        }
      }
    }
  }
}
