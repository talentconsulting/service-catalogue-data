{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/levy": {
      "get": {
        "operationId": "GetLevy",
        "summary": "Retrieve levy data for an employer account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier for the employer"
          }
        ],
        "responses": {
          "200": {
            "description": "Levy data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevyData"
                }
              }
            }
          },
          "404": {
            "description": "Levy data not found"
          }
        },
        "security": [
          {
            "AuthorizationPolicy": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/{payrollYear}/{payrollMonth}": {
      "get": {
        "operationId": "GetLevyForPeriod",
        "summary": "Retrieve levy data for a specific payroll period",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier for the employer"
          },
          {
            "name": "payrollYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The payroll year for which to retrieve levy data"
          },
          {
            "name": "payrollMonth",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            },
            "description": "The payroll month for which to retrieve levy data"
          }
        ],
        "responses": {
          "200": {
            "description": "Levy data retrieved successfully for the payroll period",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevyData"
                }
              }
            }
          },
          "404": {
            "description": "Levy data not found for the specified payroll period"
          }
        },
        "security": [
          {
            "AuthorizationPolicy": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-history": {
      "get": {
        "operationId": "GetEnglishFractionHistory",
        "summary": "Retrieve English fraction history for an employer account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier for the employer"
          },
          {
            "name": "empRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The employer reference"
          }
        ],
        "responses": {
          "200": {
            "description": "English fraction history retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnglishFractionHistory"
                }
              }
            }
          },
          "404": {
            "description": "English fraction history not found"
          }
        },
        "security": [
          {
            "AuthorizationPolicy": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-current": {
      "get": {
        "operationId": "GetEnglishFractionCurrent",
        "summary": "Retrieve current English fractions for an employer account",
        "parameters": [
          {
            "name": "empRefs",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "The employer references"
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account identifier for the employer"
          }
        ],
        "responses": {
          "200": {
            "description": "Current English fractions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnglishFractionCurrent"
                }
              }
            }
          },
          "404": {
            "description": "Current English fractions not found"
          }
        },
        "security": [
          {
            "AuthorizationPolicy": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LevyData": {
        "type": "object",
        "additionalProperties": true
      },
      "EnglishFractionHistory": {
        "type": "object",
        "additionalProperties": true
      },
      "EnglishFractionCurrent": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "AuthorizationPolicy": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
