{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/levy": {
      "get": {
        "operationId": "GetLevy",
        "summary": "Retrieves all levy data for the provided account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Levy data retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Levy data not found for the given account."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/{payrollYear}/{payrollMonth}": {
      "get": {
        "operationId": "GetLevyForPeriod",
        "summary": "Retrieves levy data for a specific payroll year and month.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account identifier."
          },
          {
            "name": "payrollYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Payroll year to retrieve levy data for."
          },
          {
            "name": "payrollMonth",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            },
            "description": "Payroll month to retrieve levy data for."
          }
        ],
        "responses": {
          "200": {
            "description": "Levy data retrieved successfully for the specified period.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LevyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Levy data not found for the given account, year, and month."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-history": {
      "get": {
        "operationId": "GetEnglishFractionHistory",
        "summary": "Retrieves the English fraction history for the given account and employer reference.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account identifier."
          },
          {
            "name": "empRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference to retrieve English fraction history for."
          }
        ],
        "responses": {
          "200": {
            "description": "English fraction history retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnglishFractionHistoryResponse"
                }
              }
            }
          },
          "404": {
            "description": "English fraction history not found for the given account and employer reference."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/levy/english-fraction-current": {
      "get": {
        "operationId": "GetEnglishFractionCurrent",
        "summary": "Retrieves the current English fraction for multiple employer references.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account identifier."
          },
          {
            "name": "empRefs",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Employer references to retrieve current English fractions for."
          }
        ],
        "responses": {
          "200": {
            "description": "Current English fraction data retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnglishFractionCurrentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Current English fraction data not found for the given account and employer references."
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "LevyResponse": {
        "type": "object",
        "properties": {}
      },
      "EnglishFractionHistoryResponse": {
        "type": "object",
        "properties": {}
      },
      "EnglishFractionCurrentResponse": {
        "type": "object",
        "properties": {}
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Requires the ReadAllEmployerAccountBalances policy."
      }
    }
  }
}
