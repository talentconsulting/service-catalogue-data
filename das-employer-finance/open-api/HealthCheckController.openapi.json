{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Health Check API",
    "version": "1.0.0"
  },
  "paths": {
    "/healthcheck": {
      "get": {
        "summary": "Get Health Check Status",
        "operationId": "getHealthCheck",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Health check status retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Run Health Check",
        "operationId": "runHealthCheck",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunHealthCheckCommand"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected to health check status view."
          }
        }
      }
    },
    "/Content/lib/govuk-frontend/dist/assets/images/favicon.ico": {
      "get": {
        "summary": "Health Check Static File",
        "operationId": "fileCheck",
        "responses": {
          "200": {
            "description": "The static file check passed."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthCheckViewModel": {
        "type": "object",
        "properties": {
          "healthCheck": {
            "$ref": "#/components/schemas/HealthCheckDto"
          }
        }
      },
      "RunHealthCheckCommand": {
        "type": "object",
        "properties": {
          "userRef": {
            "type": "string",
            "format": "uuid",
            "nullable": false
          }
        },
        "required": [
          "userRef"
        ]
      },
      "HealthCheckDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "sentRequest": {
            "type": "string",
            "format": "date-time"
          },
          "receivedResponse": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "publishedEvent": {
            "type": "string",
            "format": "date-time"
          },
          "receivedEvent": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "sentRequest",
          "publishedEvent"
        ]
      }
    },
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
