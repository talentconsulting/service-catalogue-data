{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/paye-schemes/last-submission-date": {
      "get": {
        "summary": "Get last PAYE scheme submission date",
        "operationId": "getLastSubmissionDate",
        "parameters": [
          {
            "name": "empRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference used to identify the PAYE scheme."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation errors encountered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrors"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ValidationErrors": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization policy for reading all employer account balances."
      }
    }
  }
}
