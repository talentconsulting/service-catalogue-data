{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/paye-schemes/last-submission-date": {
      "get": {
        "summary": "Get Last Submission Date",
        "description": "Retrieve the last submission date for a PAYE scheme.",
        "parameters": [
          {
            "name": "empRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The employer reference number (empRef) of the PAYE scheme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the last submission date.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to validation error.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Validation": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
