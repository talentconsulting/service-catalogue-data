{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "operationId": "GetTransferConnections",
        "summary": "Retrieve transfer connections for the given hashed account ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed ID of the account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesAuthorization": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/transfers/connections": {
      "get": {
        "operationId": "InternalGetTransferConnections",
        "summary": "Retrieve transfer connections for the given internal account ID with an optional status filter.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The internal account ID."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TransferConnectionInvitationStatus"
            },
            "description": "The status of the transfer connections to filter by."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesAuthorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferConnection": {
        "type": "object",
        "additionalProperties": true
      },
      "TransferConnectionInvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected"
        ]
      }
    },
    "securitySchemes": {
      "ApiRolesAuthorization": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "read:userAccounts": "Read access to user accounts"
            }
          }
        }
      }
    }
  }
}
