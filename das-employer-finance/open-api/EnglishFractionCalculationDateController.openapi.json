{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fraction-calculation-date/{empRef}": {
      "get": {
        "summary": "Get Last Calculation Date",
        "operationId": "GetLastCalculationDate",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "description": "The employer reference",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the last calculation date",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/english-fraction-calculation-date": {
      "post": {
        "summary": "Persist Calculation Date",
        "operationId": "PersistCalculationDate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionCalculationDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully persisted the calculation date"
          },
          "400": {
            "description": "Invalid request payload"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionCalculationDateRequest": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the fraction was calculated"
          }
        },
        "required": [
          "DateCalculated"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Access required to read all employer account balances"
            }
          }
        }
      }
    }
  }
}
