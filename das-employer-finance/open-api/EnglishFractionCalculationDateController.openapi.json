{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fraction-calculation-date/{empRef}": {
      "get": {
        "summary": "Get the last English fraction calculation date",
        "operationId": "GetLastCalculationDate",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/english-fraction-calculation-date": {
      "post": {
        "summary": "Persist English fraction calculation date",
        "operationId": "PersistCalculationDate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionCalculationDateRequest"
              }
            }
          },
          "description": "The calculation date to persist"
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Validation error or invalid request payload"
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionCalculationDateRequest": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date of the English fraction calculation"
          }
        },
        "required": [
          "DateCalculated"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires the ReadAllEmployerAccountBalances role"
      }
    }
  }
}
