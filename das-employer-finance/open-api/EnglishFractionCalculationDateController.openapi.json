{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0",
    "description": "API for managing English Fraction Calculation Date"
  },
  "paths": {
    "/api/english-fraction-calculation-date/{empRef}": {
      "get": {
        "operationId": "GetLastCalculationDate",
        "summary": "Gets the last English fraction calculation date for an employer",
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The employer reference ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/english-fraction-calculation-date": {
      "post": {
        "operationId": "Persist",
        "summary": "Persists the English fraction calculation date",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionCalculationDateRequest"
              }
            }
          },
          "description": "Request payload containing the calculation date"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionCalculationDateRequest": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date calculated for the English fraction"
          }
        },
        "required": [
          "DateCalculated"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "oauth2",
        "description": "Requires the ReadAllEmployerAccountBalances role"
      }
    }
  }
}
