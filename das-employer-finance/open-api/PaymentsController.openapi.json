{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/staging": {
      "post": {
        "operationId": "BulkPaymentsIngest",
        "summary": "Bulk Payments Ingest",
        "description": "Ingest bulk payments data into staging.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string",
                      "description": "Explanation of validation errors."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "description": "List of conflicting payment IDs."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "Unexpected error staging payments."
                }
              }
            }
          },
          "201": {
            "description": "Payments successfully staged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer",
                      "description": "Number of payments successfully inserted.",
                      "example": 123
                    },
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "description": "List of successfully inserted payment IDs."
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkPaymentsRequest": {
        "type": "object",
        "properties": {
          "Payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentStagingModel"
            },
            "description": "List of payments to ingest."
          }
        },
        "required": [
          "Payments"
        ]
      },
      "PaymentStagingModel": {
        "type": "object",
        "properties": {
          "PaymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the payment."
          },
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the account associated with the payment."
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64",
            "description": "UK provider reference number."
          },
          "Uln": {
            "type": "integer",
            "format": "int64",
            "description": "Unique learner number."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the apprenticeship associated with the payment."
          },
          "CollectionPeriodId": {
            "type": "string",
            "description": "Unique ID representing the collection period.",
            "example": "2022-Q4"
          },
          "DeliveryPeriodMonth": {
            "type": "integer",
            "description": "Month of the delivery period."
          },
          "DeliveryPeriodYear": {
            "type": "integer",
            "description": "Year of the delivery period."
          },
          "CollectionPeriodMonth": {
            "type": "integer",
            "description": "Month of the collection period."
          },
          "CollectionPeriodYear": {
            "type": "integer",
            "description": "Year of the collection period."
          },
          "FundingSource": {
            "type": "string",
            "description": "Funding source of the payment."
          },
          "TransactionType": {
            "type": "string",
            "description": "Type of transaction associated with the payment."
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "Amount of the payment."
          },
          "EvidenceSubmittedOn": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when evidence was submitted."
          },
          "EmployerAccountVersion": {
            "type": "string",
            "description": "Version of the employer account associated with the payment."
          },
          "ApprenticeshipVersion": {
            "type": "string",
            "description": "Version of the apprenticeship associated with the payment."
          }
        },
        "required": [
          "PaymentId",
          "AccountId",
          "Ukprn",
          "Uln",
          "ApprenticeshipId",
          "CollectionPeriodId",
          "DeliveryPeriodMonth",
          "DeliveryPeriodYear",
          "CollectionPeriodMonth",
          "CollectionPeriodYear",
          "FundingSource",
          "TransactionType",
          "Amount",
          "EvidenceSubmittedOn",
          "EmployerAccountVersion",
          "ApprenticeshipVersion"
        ]
      }
    }
  }
}
