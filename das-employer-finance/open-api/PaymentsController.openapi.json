{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/staging": {
      "post": {
        "operationId": "BulkPaymentsIngest",
        "summary": "Ingest bulk payment records into the staging area.",
        "tags": [
          "Payments"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bulk payment records successfully ingested.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer",
                      "description": "The number of records inserted."
                    },
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Unique identifiers of the staged payment records."
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation errors occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "string",
                      "example": "Payments payload is required."
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "example": [
                        "Validation error 1",
                        "Validation error 2"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflicting payment records detected.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Identifiers of payment records causing conflicts."
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error during payment staging.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "example": "Unexpected error staging payments."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkPaymentsRequest": {
        "type": "object",
        "properties": {
          "Payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentStagingModel"
            }
          }
        },
        "required": [
          "Payments"
        ]
      },
      "PaymentStagingModel": {
        "type": "object",
        "properties": {
          "PaymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the payment record."
          },
          "AccountId": {
            "type": "integer",
            "description": "The account identifier associated with the payment."
          },
          "Ukprn": {
            "type": "integer",
            "description": "The unique provider reference number."
          },
          "Uln": {
            "type": "integer",
            "description": "The unique learner number."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "description": "The apprenticeship identifier associated with the payment."
          },
          "CollectionPeriodId": {
            "type": "string",
            "description": "The identifier for the collection period."
          },
          "DeliveryPeriodMonth": {
            "type": "integer",
            "description": "The month of the delivery period."
          },
          "DeliveryPeriodYear": {
            "type": "integer",
            "description": "The year of the delivery period."
          },
          "CollectionPeriodMonth": {
            "type": "integer",
            "description": "The month of the collection period."
          },
          "CollectionPeriodYear": {
            "type": "integer",
            "description": "The year of the collection period."
          },
          "FundingSource": {
            "type": "string",
            "description": "The funding source for the payment."
          },
          "TransactionType": {
            "type": "string",
            "description": "The type of transaction being staged."
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "The amount of the payment."
          },
          "EvidenceSubmittedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time evidence for the payment was submitted."
          },
          "EmployerAccountVersion": {
            "type": "string",
            "description": "The version of the employer account."
          },
          "ApprenticeshipVersion": {
            "type": "string",
            "description": "The version of the apprenticeship record."
          }
        },
        "required": [
          "PaymentId",
          "AccountId",
          "Ukprn",
          "Uln",
          "ApprenticeshipId",
          "CollectionPeriodId",
          "DeliveryPeriodMonth",
          "DeliveryPeriodYear",
          "CollectionPeriodMonth",
          "CollectionPeriodYear",
          "FundingSource",
          "TransactionType",
          "Amount",
          "EvidenceSubmittedOn",
          "EmployerAccountVersion",
          "ApprenticeshipVersion"
        ]
      }
    }
  }
}
