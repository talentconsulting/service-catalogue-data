{
  "openapi": "3.1.0",
  "info": {
    "title": "Transfer Connections API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "operationId": "getTransferConnectionsIndex",
        "summary": "Retrieve transfer connections index data for a specified account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed ID of the account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferViewModel"
                }
              }
            }
          }
        },
        "tags": [
          "TransferConnections"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferViewModel": {
        "type": "object",
        "properties": {
          "ApprenticeshipEmployerType": {
            "type": "string",
            "nullable": true
          },
          "TransferAllowanceViewModel": {
            "$ref": "#/components/schemas/TransferAllowanceViewModel"
          },
          "TransferConnectionInvitationAuthorizationViewModel": {
            "$ref": "#/components/schemas/TransferConnectionInvitationAuthorizationViewModel"
          },
          "TransferConnectionInvitationsViewModel": {
            "$ref": "#/components/schemas/TransferConnectionInvitationsViewModel"
          },
          "TransferRequest": {
            "$ref": "#/components/schemas/TransferRequestsViewModel"
          }
        }
      },
      "TransferAllowanceViewModel": {
        "type": "object",
        "properties": {
          "RemainingTransferAllowance": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "TotalTransferAllowance": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          }
        }
      },
      "TransferConnectionInvitationAuthorizationViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string",
            "nullable": true
          },
          "IsAuthorized": {
            "type": "boolean"
          }
        }
      },
      "TransferConnectionInvitationsViewModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "number",
            "format": "int64"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "TransferSenderConnectionInvitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationDto"
            }
          },
          "TransferReceiverConnectionInvitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationDto"
            }
          }
        }
      },
      "TransferConnectionInvitationDto": {
        "type": "object",
        "properties": {
          "Changes": {
            "type": "string",
            "nullable": true
          },
          "Id": {
            "type": "number",
            "format": "int64"
          },
          "Status": {
            "type": "string"
          },
          "CreatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "ReceiverAccount": {
            "type": "object",
            "nullable": true
          },
          "SenderAccount": {
            "type": "object",
            "nullable": true
          },
          "HashedId": {
            "type": "string"
          }
        }
      },
      "TransferRequestsViewModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "number",
            "format": "int64"
          },
          "TransferRequests": {
            "type": "array",
            "items": {
              "type": "object",
              "nullable": true
            }
          }
        }
      }
    }
  }
}
