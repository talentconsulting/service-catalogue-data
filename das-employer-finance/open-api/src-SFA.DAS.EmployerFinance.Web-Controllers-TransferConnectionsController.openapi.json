{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "operationId": "TransferConnections_Index",
        "summary": "Get transfer connections for a specific employer account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed identifier of the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apprenticeshipEmployerType": {
                      "type": "string"
                    },
                    "transferAllowanceViewModel": {
                      "$ref": "#/components/schemas/TransferAllowanceViewModel"
                    },
                    "transferConnectionInvitationAuthorizationViewModel": {
                      "$ref": "#/components/schemas/TransferConnectionInvitationAuthorizationViewModel"
                    },
                    "transferConnectionInvitationsViewModel": {
                      "$ref": "#/components/schemas/TransferConnectionInvitationsViewModel"
                    },
                    "transferRequest": {
                      "$ref": "#/components/schemas/TransferRequestsViewModel"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferAllowanceViewModel": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "remainingTransferAllowance": {
            "type": "number",
            "format": "decimal"
          },
          "transferAllowanceUsed": {
            "type": "number",
            "format": "decimal"
          }
        },
        "description": "Details about the transfer allowance for an employer account."
      },
      "TransferConnectionInvitationAuthorizationViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "canSendTransfers": {
            "type": "boolean"
          }
        },
        "description": "Authorization details for transfer connections."
      },
      "TransferConnectionInvitationsViewModel": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "transferSenderConnectionInvitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationDto"
            }
          },
          "transferReceiverConnectionInvitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferConnectionInvitationDto"
            }
          }
        },
        "description": "View model containing details about transfer connection invitations."
      },
      "TransferConnectionInvitationDto": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "string"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "receiverAccount": {
            "type": "object",
            "additionalProperties": true
          },
          "senderAccount": {
            "type": "object",
            "additionalProperties": true
          },
          "hashedId": {
            "type": "string"
          }
        },
        "description": "Details of a single transfer connection invitation."
      },
      "TransferRequestsViewModel": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "transferRequests": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "description": "View model containing transfer requests for an employer account."
      }
    }
  }
}
