{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fractions": {
      "post": {
        "summary": "Persist English Fractions Data",
        "description": "Persists English fractions data for an employer account.",
        "operationId": "PersistEnglishFractions",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully persisted English fractions data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Generic response for successful operation."
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionsRequest": {
        "type": "object",
        "properties": {
          "EmpRef": {
            "type": "string",
            "description": "Employer reference."
          },
          "UpdateRequired": {
            "type": "boolean",
            "description": "Indicates whether an update is required."
          },
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the fractions were calculated."
          },
          "Fractions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishFractionItem"
            },
            "description": "List of English fraction items."
          }
        },
        "required": [
          "EmpRef",
          "UpdateRequired",
          "DateCalculated",
          "Fractions"
        ]
      },
      "EnglishFractionItem": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the fraction was calculated."
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "The fraction amount."
          }
        },
        "required": [
          "DateCalculated",
          "Amount"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "API key required for accessing functionality protected by the ReadAllEmployerAccountBalances role."
      }
    }
  }
}
