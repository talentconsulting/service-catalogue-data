{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fractions": {
      "post": {
        "summary": "Persist English Fractions",
        "description": "Persists English fractions data provided in the request body.",
        "operationId": "PersistEnglishFractions",
        "tags": [
          "EnglishFractions"
        ],
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "English fractions persisted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionsRequest": {
        "type": "object",
        "required": [
          "EmpRef",
          "UpdateRequired",
          "DateCalculated",
          "Fractions"
        ],
        "properties": {
          "EmpRef": {
            "type": "string",
            "example": "123/AB45678"
          },
          "UpdateRequired": {
            "type": "boolean",
            "example": true
          },
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "example": "2023-10-01T00:00:00Z"
          },
          "Fractions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishFractionItem"
            }
          }
        }
      },
      "EnglishFractionItem": {
        "type": "object",
        "required": [
          "DateCalculated",
          "Amount"
        ],
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "example": "2023-10-01T00:00:00Z"
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "example": 123.45
          }
        }
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  }
}
