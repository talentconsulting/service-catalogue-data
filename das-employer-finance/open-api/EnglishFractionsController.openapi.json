{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fractions": {
      "post": {
        "summary": "Persist English Fractions",
        "description": "Persists English fractions data.",
        "operationId": "persistEnglishFractions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "English fractions persisted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Request payload is required."
          }
        },
        "security": [
          {
            "OAuth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionsRequest": {
        "type": "object",
        "properties": {
          "EmpRef": {
            "type": "string",
            "description": "The employer reference."
          },
          "UpdateRequired": {
            "type": "boolean",
            "description": "Indicates whether an update is required."
          },
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the fractions were calculated."
          },
          "Fractions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishFractionItem"
            },
            "description": "List of English fractions."
          }
        },
        "required": [
          "EmpRef",
          "UpdateRequired",
          "DateCalculated",
          "Fractions"
        ]
      },
      "EnglishFractionItem": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the fraction was calculated."
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "The fraction amount."
          }
        },
        "required": [
          "DateCalculated",
          "Amount"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Access to read all employer account balances"
            }
          }
        }
      }
    }
  }
}
