{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/english-fractions": {
      "post": {
        "summary": "Persist English Fractions",
        "operationId": "persistEnglishFractions",
        "description": "Persist English fractions for the given request payload.",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnglishFractionsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully persisted English fractions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request due to invalid payload or validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EnglishFractionsRequest": {
        "type": "object",
        "properties": {
          "EmpRef": {
            "type": "string",
            "description": "Employer reference."
          },
          "UpdateRequired": {
            "type": "boolean",
            "description": "Indicates whether an update is required."
          },
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the fractions were calculated."
          },
          "Fractions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishFractionItem"
            },
            "description": "List of English fractions."
          }
        },
        "required": [
          "EmpRef",
          "UpdateRequired",
          "DateCalculated",
          "Fractions"
        ]
      },
      "EnglishFractionItem": {
        "type": "object",
        "properties": {
          "DateCalculated": {
            "type": "string",
            "format": "date-time",
            "description": "The date when this fraction was calculated."
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "The amount of the fraction."
          }
        },
        "required": [
          "DateCalculated",
          "Amount"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "API role required to authorize actions related to employer account balances."
      }
    }
  }
}
