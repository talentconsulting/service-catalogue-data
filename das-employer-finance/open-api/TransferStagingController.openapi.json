{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transfers/staging": {
      "post": {
        "summary": "Stage Transfers",
        "description": "Stages transfers provided in the request.",
        "operationId": "stageTransfers",
        "security": [
          {
            "apiKey": []
          }
        ],
        "tags": [
          "Transfers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StageTransfersRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfers successfully staged.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer",
                      "description": "The number of transfers successfully inserted."
                    },
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "description": "IDs of the successfully inserted transfers."
                    }
                  },
                  "required": [
                    "insertedCount",
                    "transferIds"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid request payload or validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Error message describing the issue."
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Conflicting transfer IDs detected.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "description": "IDs of the conflicting transfers."
                    }
                  },
                  "required": [
                    "transferIds"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Error message describing the issue."
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StageTransfersRequest": {
        "type": "object",
        "properties": {
          "Transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferStaging"
            },
            "description": "List of transfers to be staged."
          }
        },
        "required": [
          "Transfers"
        ]
      },
      "TransferStaging": {
        "type": "object",
        "properties": {
          "TransferId": {
            "type": "integer",
            "description": "Unique identifier of the transfer."
          },
          "SenderAccountId": {
            "type": "integer",
            "description": "ID of the sender's account."
          },
          "SenderAccountName": {
            "type": "string",
            "description": "Name of the sender's account."
          },
          "ReceiverAccountId": {
            "type": "integer",
            "description": "ID of the receiver's account."
          },
          "ReceiverAccountName": {
            "type": "string",
            "description": "Name of the receiver's account."
          },
          "Amount": {
            "type": "number",
            "format": "decimal",
            "description": "Amount of the transfer."
          },
          "TransferDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date of the transfer."
          },
          "PeriodEnd": {
            "type": "string",
            "description": "Period end identifier."
          },
          "CollectionPeriodMonth": {
            "type": "integer",
            "description": "Collection period month."
          },
          "CollectionPeriodYear": {
            "type": "integer",
            "description": "Collection period year."
          },
          "Ukprn": {
            "type": "integer",
            "description": "UKPRN of the training provider."
          },
          "CourseName": {
            "type": "string",
            "description": "Name of the course associated with the transfer."
          },
          "CourseLevel": {
            "type": "integer",
            "description": "Level of the course (if applicable)."
          },
          "LearningType": {
            "type": "string",
            "description": "Type of learning."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "description": "ID of the apprenticeship."
          },
          "Type": {
            "type": "string",
            "description": "Type of transfer."
          },
          "RequiredPaymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the required payment."
          },
          "CreatedBy": {
            "type": "string",
            "description": "User who created the transfer."
          },
          "CorrelationId": {
            "type": "string",
            "description": "Correlation ID for tracking purposes."
          }
        },
        "required": [
          "TransferId",
          "SenderAccountId",
          "SenderAccountName",
          "ReceiverAccountId",
          "ReceiverAccountName",
          "Amount",
          "TransferDate",
          "PeriodEnd",
          "CollectionPeriodMonth",
          "CollectionPeriodYear",
          "Ukprn",
          "CourseName",
          "ApprenticeshipId",
          "Type",
          "RequiredPaymentId",
          "CreatedBy"
        ]
      }
    }
  }
}
