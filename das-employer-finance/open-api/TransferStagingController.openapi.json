{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transfers/staging": {
      "post": {
        "summary": "Stage Transfers",
        "description": "Stages employer account transfers.",
        "operationId": "StageTransfers",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StageTransfersRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "examples": {
                  "Payload Missing": {
                    "summary": "Transfers payload is required.",
                    "value": "Transfers payload is required."
                  },
                  "Validation Errors": {
                    "value": {
                      "validationErrors": "List of validation errors."
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "examples": {
                  "Conflicting Transfers": {
                    "value": {
                      "transferIds": [
                        "ConflictingTransferId1",
                        "ConflictingTransferId2"
                      ]
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer",
                      "description": "Number of transfers staged."
                    },
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      },
                      "description": "IDs of staged transfers."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "examples": {
                  "Unexpected Error": {
                    "value": "An unexpected error occurred while staging transfers."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StageTransfersRequest": {
        "type": "object",
        "properties": {
          "Transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferStaging"
            }
          }
        },
        "required": [
          "Transfers"
        ]
      },
      "TransferStaging": {
        "type": "object",
        "properties": {
          "TransferId": {
            "type": "integer",
            "description": "Unique identifier for the transfer."
          },
          "SenderAccountId": {
            "type": "integer",
            "description": "ID of the sender account."
          },
          "SenderAccountName": {
            "type": "string",
            "description": "Name of the sender account."
          },
          "ReceiverAccountId": {
            "type": "integer",
            "description": "ID of the receiver account."
          },
          "ReceiverAccountName": {
            "type": "string",
            "description": "Name of the receiver account."
          },
          "Amount": {
            "type": "number",
            "description": "Transfer amount."
          },
          "TransferDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date of transfer."
          },
          "PeriodEnd": {
            "type": "string",
            "description": "Period end identifier."
          },
          "CollectionPeriodMonth": {
            "type": "integer",
            "description": "Collection period month."
          },
          "CollectionPeriodYear": {
            "type": "integer",
            "description": "Collection period year."
          },
          "Ukprn": {
            "type": "integer",
            "description": "UK provider reference number."
          },
          "CourseName": {
            "type": "string",
            "description": "Name of the course."
          },
          "CourseLevel": {
            "type": "integer",
            "nullable": true,
            "description": "Level of the course, if applicable."
          },
          "LearningType": {
            "type": "string",
            "description": "Type of learning."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "description": "ID of the apprenticeship."
          },
          "Type": {
            "type": "string",
            "description": "Type of transfer."
          },
          "RequiredPaymentId": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the required payment."
          },
          "CreatedBy": {
            "type": "string",
            "description": "User who created the transfer."
          },
          "CorrelationId": {
            "type": "string",
            "description": "Correlation ID for tracking."
          }
        },
        "required": [
          "TransferId",
          "SenderAccountId",
          "SenderAccountName",
          "ReceiverAccountId",
          "ReceiverAccountName",
          "Amount",
          "TransferDate",
          "PeriodEnd",
          "CollectionPeriodMonth",
          "CollectionPeriodYear",
          "Ukprn",
          "CourseName",
          "ApprenticeshipId",
          "Type",
          "RequiredPaymentId",
          "CreatedBy",
          "CorrelationId"
        ]
      }
    }
  }
}
