{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transfers/staging": {
      "post": {
        "summary": "Stage Transfers",
        "operationId": "StageTransfers",
        "tags": [
          "Transfers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StageTransfersRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transfers successfully staged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer",
                      "example": 10
                    },
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "example": [
                          1,
                          2,
                          3
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Validation errors in the transfer payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Conflicting transfer IDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "example": [
                          1,
                          2
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error while staging transfers."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "StageTransfersRequest": {
        "type": "object",
        "properties": {
          "transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferStaging"
            }
          }
        },
        "required": [
          "transfers"
        ]
      },
      "TransferStaging": {
        "type": "object",
        "properties": {
          "transferId": {
            "type": "integer",
            "format": "int64"
          },
          "senderAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "senderAccountName": {
            "type": "string"
          },
          "receiverAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "receiverAccountName": {
            "type": "string"
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "transferDate": {
            "type": "string",
            "format": "date-time"
          },
          "periodEnd": {
            "type": "string"
          },
          "collectionPeriodMonth": {
            "type": "integer"
          },
          "collectionPeriodYear": {
            "type": "integer"
          },
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "courseName": {
            "type": "string"
          },
          "courseLevel": {
            "type": "integer",
            "nullable": true
          },
          "learningType": {
            "type": "string"
          },
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "requiredPaymentId": {
            "type": "string",
            "format": "uuid"
          },
          "createdBy": {
            "type": "string"
          },
          "correlationId": {
            "type": "string"
          }
        },
        "required": [
          "transferId",
          "senderAccountId",
          "senderAccountName",
          "receiverAccountId",
          "receiverAccountName",
          "amount",
          "transferDate",
          "periodEnd",
          "collectionPeriodMonth",
          "collectionPeriodYear",
          "ukprn",
          "courseName",
          "learningType",
          "apprenticeshipId",
          "type",
          "requiredPaymentId",
          "createdBy",
          "correlationId"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Requires 'ReadAllEmployerAccountBalances' role."
      }
    }
  }
}
