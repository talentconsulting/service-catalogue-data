{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transfers/staging": {
      "post": {
        "description": "Stage employer finance transfers.",
        "operationId": "stageTransfers",
        "security": [
          {
            "Authorization": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StageTransfersRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad Request - Invalid payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "Conflict - Conflicting transfer IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "format": "int64"
                      }
                    }
                  },
                  "required": [
                    "transferIds"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error - Unexpected error occurred during transfer staging.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "201": {
            "description": "Created - Transfers staged successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "insertedCount": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "transferIds": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "format": "int64"
                      }
                    }
                  },
                  "required": [
                    "insertedCount",
                    "transferIds"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StageTransfersRequest": {
        "type": "object",
        "properties": {
          "transfers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransferStaging"
            }
          }
        },
        "required": [
          "transfers"
        ]
      },
      "TransferStaging": {
        "type": "object",
        "properties": {
          "TransferId": {
            "type": "integer",
            "format": "int64"
          },
          "SenderAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "SenderAccountName": {
            "type": "string"
          },
          "ReceiverAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ReceiverAccountName": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          },
          "TransferDate": {
            "type": "string",
            "format": "date-time"
          },
          "PeriodEnd": {
            "type": "string"
          },
          "CollectionPeriodMonth": {
            "type": "integer",
            "format": "int32"
          },
          "CollectionPeriodYear": {
            "type": "integer",
            "format": "int32"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "CourseName": {
            "type": "string"
          },
          "CourseLevel": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "LearningType": {
            "type": "string"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "Type": {
            "type": "string"
          },
          "RequiredPaymentId": {
            "type": "string",
            "format": "uuid"
          },
          "CreatedBy": {
            "type": "string"
          },
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "TransferId",
          "SenderAccountId",
          "SenderAccountName",
          "ReceiverAccountId",
          "ReceiverAccountName",
          "Amount",
          "TransferDate",
          "PeriodEnd",
          "CollectionPeriodMonth",
          "CollectionPeriodYear",
          "Ukprn",
          "CourseName",
          "LearningType",
          "ApprenticeshipId",
          "Type",
          "RequiredPaymentId",
          "CreatedBy",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
