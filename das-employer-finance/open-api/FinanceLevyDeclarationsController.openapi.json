{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0",
    "description": "API for managing employer finance levy declarations."
  },
  "paths": {
    "/api/levy-declarations": {
      "post": {
        "summary": "Persist Levy Declarations",
        "operationId": "PersistLevyDeclarations",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "description": "Request payload for persisting levy declarations.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersistLevyDeclarationRequestData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully persisted levy declarations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or request payload is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/period-12-declarations": {
      "get": {
        "summary": "Get Period 12 Levy Declarations",
        "operationId": "GetExistingPeriod12LevyDeclarations",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved period 12 levy declarations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/submission-ids": {
      "get": {
        "summary": "Get Submission IDs",
        "operationId": "GetSubmissionIds",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved submission IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/last-submission-date": {
      "get": {
        "summary": "Get Last Submission Date",
        "operationId": "GetLastSubmissionDate",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the last submission date.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PersistLevyDeclarationRequestData": {
        "type": "object",
        "properties": {
          "CorrelationId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "EmpRef": {
            "type": "string"
          },
          "Declarations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NormalizedLevyDeclaration"
            }
          },
          "GenerateTransactions": {
            "type": "boolean"
          }
        },
        "required": [
          "CorrelationId",
          "AccountId",
          "EmpRef",
          "Declarations",
          "GenerateTransactions"
        ]
      },
      "NormalizedLevyDeclaration": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "LevyDueYtd": {
            "type": "number",
            "format": "decimal"
          },
          "SubmissionDate": {
            "type": "string",
            "format": "date-time"
          },
          "SubmissionType": {
            "type": "string"
          },
          "LevyAllowanceForFullYear": {
            "type": "number",
            "format": "decimal"
          },
          "PayrollYear": {
            "type": "string"
          },
          "PayrollMonth": {
            "type": "integer",
            "format": "int16"
          },
          "NoPaymentForPeriod": {
            "type": "boolean"
          },
          "DateCeased": {
            "type": "string",
            "format": "date-time"
          },
          "InactiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "InactiveTo": {
            "type": "string",
            "format": "date-time"
          },
          "EndOfYearAdjustment": {
            "type": "boolean"
          },
          "EndOfYearAdjustmentAmount": {
            "type": "number",
            "format": "decimal"
          },
          "SubmissionId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Id",
          "SubmissionDate",
          "SubmissionType",
          "LevyAllowanceForFullYear",
          "PayrollYear",
          "NoPaymentForPeriod",
          "EndOfYearAdjustment",
          "EndOfYearAdjustmentAmount",
          "SubmissionId"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
