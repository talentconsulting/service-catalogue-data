{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/levy-declarations": {
      "post": {
        "summary": "Persist Levy Declarations",
        "description": "Persists levy declaration data.",
        "operationId": "PersistLevyDeclarations",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersistLevyDeclarationRequestData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Levy declaration persisted successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Validation errors or missing payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/period-12-declarations": {
      "get": {
        "summary": "Get Period 12 Declarations",
        "description": "Retrieves existing Period 12 levy declarations for the specified employer reference.",
        "operationId": "GetPeriod12Declarations",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference."
          }
        ],
        "responses": {
          "200": {
            "description": "Period 12 declarations retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/submission-ids": {
      "get": {
        "summary": "Get Submission IDs",
        "description": "Retrieves submission IDs for the specified employer reference.",
        "operationId": "GetSubmissionIds",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference."
          }
        ],
        "responses": {
          "200": {
            "description": "Submission IDs retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/levy-declarations/{empRef}/last-submission-date": {
      "get": {
        "summary": "Get Last Submission Date",
        "description": "Retrieves the last submission date for the specified employer reference.",
        "operationId": "GetLastSubmissionDate",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer reference."
          }
        ],
        "responses": {
          "200": {
            "description": "Last submission date retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PersistLevyDeclarationRequestData": {
        "type": "object",
        "properties": {
          "CorrelationId": {
            "type": "string",
            "description": "Correlation ID for tracking."
          },
          "AccountId": {
            "type": "integer",
            "description": "The account ID associated with the levy declarations."
          },
          "EmpRef": {
            "type": "string",
            "description": "Employer reference."
          },
          "Declarations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NormalizedLevyDeclaration"
            },
            "description": "List of levy declarations."
          },
          "GenerateTransactions": {
            "type": "boolean",
            "description": "Flag indicating whether transactions should be generated."
          }
        },
        "required": [
          "CorrelationId",
          "AccountId",
          "EmpRef",
          "Declarations",
          "GenerateTransactions"
        ]
      },
      "NormalizedLevyDeclaration": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "Unique identifier for the levy declaration."
          },
          "LevyDueYtd": {
            "type": "number",
            "format": "decimal",
            "description": "Total levy due year-to-date."
          },
          "SubmissionDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date the submission was made."
          },
          "SubmissionType": {
            "type": "string",
            "description": "Type of the submission."
          },
          "LevyAllowanceForFullYear": {
            "type": "number",
            "format": "decimal",
            "description": "Annual levy allowance."
          },
          "PayrollYear": {
            "type": "string",
            "description": "Payroll year."
          },
          "PayrollMonth": {
            "type": "integer",
            "description": "Payroll month."
          },
          "NoPaymentForPeriod": {
            "type": "boolean",
            "description": "Indicates whether there is no payment for the period."
          },
          "DateCeased": {
            "type": "string",
            "format": "date-time",
            "description": "Date the account ceased."
          },
          "InactiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "Start date of inactivity."
          },
          "InactiveTo": {
            "type": "string",
            "format": "date-time",
            "description": "End date of inactivity."
          },
          "EndOfYearAdjustment": {
            "type": "boolean",
            "description": "Indicates whether this is an end-of-year adjustment."
          },
          "EndOfYearAdjustmentAmount": {
            "type": "number",
            "format": "decimal",
            "description": "Amount for the end-of-year adjustment."
          },
          "SubmissionId": {
            "type": "integer",
            "description": "Unique identifier for the submission."
          }
        },
        "required": [
          "Id",
          "SubmissionDate",
          "SubmissionType",
          "LevyAllowanceForFullYear",
          "PayrollYear",
          "NoPaymentForPeriod",
          "EndOfYearAdjustment",
          "EndOfYearAdjustmentAmount",
          "SubmissionId"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "oauth2",
        "description": "Requires the ReadAllEmployerAccountBalances role.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Allows reading all employer account balances."
            }
          }
        }
      }
    }
  }
}
