{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "summary": "Get transfer connections by hashed account ID",
        "operationId": "GetTransferConnectionsByHashedAccountId",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID to decode and fetch transfer connections for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/transfers/connections": {
      "get": {
        "summary": "Get internal transfer connections by account ID",
        "operationId": "GetInternalTransferConnectionsByAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID to fetch transfer connections for."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TransferConnectionInvitationStatus"
            },
            "description": "Filter connections by their invitation status. Defaults to Approved."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferConnectionInvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected"
        ],
        "description": "The status of a transfer connection invitation."
      },
      "TransferConnection": {
        "type": "object",
        "description": "Details of a transfer connection.",
        "properties": {},
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Access token required to authorize API requests."
      }
    }
  }
}
