{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerFinance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transfers/connections": {
      "get": {
        "summary": "Get transfer connections by hashed account ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer connections successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/internal/{accountId}/transfers/connections": {
      "get": {
        "summary": "Get transfer connections by account ID with optional status filter",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Account ID"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TransferConnectionInvitationStatus"
            },
            "description": "Filter transfer connections by invitation status"
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer connections successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TransferConnection"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferConnection": {
        "type": "object",
        "additionalProperties": true
      },
      "TransferConnectionInvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Approved",
          "Rejected"
        ]
      }
    }
  }
}
