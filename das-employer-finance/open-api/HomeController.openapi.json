{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.EmployerFinance.Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/service": {
      "get": {
        "operationId": "Home_Index",
        "responses": {
          "302": {
            "description": "Redirect to legacy EAS action."
          }
        }
      }
    },
    "/service/{HashedAccountId}/privacy": {
      "get": {
        "operationId": "Home_Privacy",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Render the Privacy page."
          }
        }
      }
    },
    "/service/privacy": {
      "get": {
        "operationId": "Home_Privacy_NoAccountId",
        "responses": {
          "200": {
            "description": "Render the Privacy page."
          }
        }
      }
    },
    "/service/{HashedAccountId}/cookieConsent": {
      "get": {
        "operationId": "Home_CookieConsent",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Employer Accounts Cookie Consent page."
          }
        }
      }
    },
    "/service/cookieConsent": {
      "get": {
        "operationId": "Home_CookieConsent_NoAccountId",
        "responses": {
          "302": {
            "description": "Redirect to Employer Accounts Cookie Consent page."
          }
        }
      }
    },
    "/service/signOut": {
      "get": {
        "operationId": "Home_SignOutUser",
        "responses": {
          "200": {
            "description": "Signs out the current user."
          }
        }
      }
    },
    "/service/SignOutCleanup": {
      "get": {
        "operationId": "Home_SignOutCleanup",
        "responses": {
          "204": {
            "description": "Performs cleanup actions after user sign-out."
          }
        }
      }
    },
    "/service/help": {
      "get": {
        "operationId": "Home_Help",
        "responses": {
          "301": {
            "description": "Redirect permanently to ZenDesk help center."
          }
        }
      }
    },
    "/service/signIn": {
      "get": {
        "operationId": "Home_SignIn",
        "responses": {
          "302": {
            "description": "Redirects to sign-in action."
          }
        }
      }
    },
    "/service/SignIn-Stub": {
      "get": {
        "operationId": "Home_SigninStub",
        "responses": {
          "200": {
            "description": "Renders the stub sign-in page."
          }
        }
      },
      "post": {
        "operationId": "Home_SigninStubPost",
        "responses": {
          "302": {
            "description": "Signs in using stub authentication and redirects."
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "Home_SignedInStub",
        "responses": {
          "200": {
            "description": "Renders the signed-in stub view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StubAuthUserDetails": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        }
      }
    }
  }
}
