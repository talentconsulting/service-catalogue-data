{
  "openapi": "3.1.0",
  "info": {
    "title": "HomeController API",
    "version": "1.0.0"
  },
  "paths": {
    "/service": {
      "get": {
        "operationId": "HomeController_Index",
        "responses": {
          "302": {
            "description": "Redirect to the legacy EAS action."
          }
        }
      }
    },
    "/service/{HashedAccountId}/privacy": {
      "get": {
        "operationId": "HomeController_Privacy",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the privacy view."
          }
        }
      }
    },
    "/service/privacy": {
      "get": {
        "operationId": "HomeController_Privacy_Alternative",
        "responses": {
          "200": {
            "description": "Returns the privacy view."
          }
        }
      }
    },
    "/service/{HashedAccountId}/cookieConsent": {
      "get": {
        "operationId": "HomeController_CookieConsent",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the cookie consent page."
          }
        }
      }
    },
    "/service/cookieConsent": {
      "get": {
        "operationId": "HomeController_CookieConsent_Alternative",
        "responses": {
          "302": {
            "description": "Redirect to the cookie consent page."
          }
        }
      }
    },
    "/service/signOut": {
      "get": {
        "operationId": "HomeController_SignOutUser",
        "responses": {
          "302": {
            "description": "Signs out the user and performs required authentication cleanup."
          }
        }
      }
    },
    "/service/SignOutCleanup": {
      "get": {
        "operationId": "HomeController_SignOutCleanup",
        "responses": {
          "200": {
            "description": "Performs cleanup for sign-out by removing session cookies."
          }
        }
      }
    },
    "/service/help": {
      "get": {
        "operationId": "HomeController_Help",
        "responses": {
          "301": {
            "description": "Permanently redirects to the Zendesk help center URL."
          }
        }
      }
    },
    "/service/signIn": {
      "get": {
        "operationId": "HomeController_SignIn",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the index action for signing in."
          }
        }
      }
    },
    "/service/SignIn-Stub": {
      "get": {
        "operationId": "HomeController_SigninStub",
        "responses": {
          "200": {
            "description": "Displays the sign-in stub view for development."
          }
        }
      },
      "post": {
        "operationId": "HomeController_SigninStubPost",
        "responses": {
          "302": {
            "description": "Signs in using the stub authentication service and redirects."
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "HomeController_SignedInStub",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Displays the signed-in stub view for development."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "This policy is used to authorize access to routes that require employer viewer, transactor, or owner account privileges."
      },
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
