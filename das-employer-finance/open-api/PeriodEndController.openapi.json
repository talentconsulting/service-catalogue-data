{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/period-ends": {
      "get": {
        "summary": "Get all period ends",
        "operationId": "getAllPeriodEnds",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of all period ends",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PeriodEnd"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No period ends found"
          }
        }
      },
      "post": {
        "summary": "Create a new period end",
        "operationId": "createPeriodEnd",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "description": "The period end to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeriodEnd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The created period end",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/period-ends/{periodEndId}": {
      "get": {
        "summary": "Get a specific period end by ID",
        "operationId": "getPeriodEndById",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "periodEndId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the period end"
          }
        ],
        "responses": {
          "200": {
            "description": "The requested period end",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "404": {
            "description": "Period end not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PeriodEnd": {
        "type": "object",
        "properties": {
          "periodEndId": {
            "type": "string"
          },
          "calendarPeriodMonth": {
            "type": "integer",
            "format": "int32"
          },
          "calendarPeriodYear": {
            "type": "integer",
            "format": "int32"
          },
          "accountDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "commitmentDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "paymentsForPeriod": {
            "type": "string"
          }
        },
        "required": [
          "periodEndId",
          "calendarPeriodMonth",
          "calendarPeriodYear",
          "completionDateTime",
          "paymentsForPeriod"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Requires the 'ReadAllEmployerAccountBalances' policy for access"
      }
    }
  }
}
