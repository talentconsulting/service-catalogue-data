{
  "openapi": "3.1.0",
  "info": {
    "title": "Period End API",
    "description": "API for managing period ends in employer finance.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/period-ends": {
      "get": {
        "operationId": "getAllPeriodEnds",
        "summary": "Get All Period Ends",
        "description": "Retrieve all period ends.",
        "responses": {
          "200": {
            "description": "List of period ends retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PeriodEnd"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No period ends found."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      },
      "post": {
        "operationId": "createPeriodEnd",
        "summary": "Create Period End",
        "description": "Create a new period end.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeriodEnd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Period end created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body."
          },
          "500": {
            "description": "Could not create period end."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/period-ends/{periodEndId}": {
      "get": {
        "operationId": "getPeriodEndById",
        "summary": "Get Period End by ID",
        "description": "Retrieve a period end by its ID.",
        "parameters": [
          {
            "name": "periodEndId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the period end."
          }
        ],
        "responses": {
          "200": {
            "description": "Period end retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "404": {
            "description": "Period end not found."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PeriodEnd": {
        "type": "object",
        "properties": {
          "PeriodEndId": {
            "type": "string"
          },
          "CalendarPeriodMonth": {
            "type": "integer",
            "format": "int32"
          },
          "CalendarPeriodYear": {
            "type": "integer",
            "format": "int32"
          },
          "AccountDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CommitmentDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "PaymentsForPeriod": {
            "type": "string"
          }
        },
        "required": [
          "PeriodEndId",
          "CalendarPeriodMonth",
          "CalendarPeriodYear",
          "CompletionDateTime",
          "PaymentsForPeriod"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "API key for accessing endpoints that require the ReadAllEmployerAccountBalances role."
      }
    }
  }
}
