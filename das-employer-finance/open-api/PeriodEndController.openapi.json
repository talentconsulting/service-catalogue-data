{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/period-ends": {
      "get": {
        "summary": "Get all period ends",
        "operationId": "getAllPeriodEnds",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PeriodEnd"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "post": {
        "summary": "Create a new period end",
        "operationId": "createPeriodEnd",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeriodEnd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/period-ends/{periodEndId}": {
      "get": {
        "summary": "Get period end by ID",
        "operationId": "getPeriodEndById",
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "periodEndId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the period end"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PeriodEnd": {
        "type": "object",
        "properties": {
          "PeriodEndId": {
            "type": "string"
          },
          "CalendarPeriodMonth": {
            "type": "integer"
          },
          "CalendarPeriodYear": {
            "type": "integer"
          },
          "AccountDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CommitmentDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "PaymentsForPeriod": {
            "type": "string"
          }
        },
        "required": [
          "PeriodEndId",
          "CalendarPeriodMonth",
          "CalendarPeriodYear",
          "CompletionDateTime",
          "PaymentsForPeriod"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
