{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/period-ends": {
      "get": {
        "summary": "Get all period ends",
        "operationId": "GetAllPeriodEnds",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of period ends",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PeriodEnd"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No period ends found"
          }
        }
      },
      "post": {
        "summary": "Create a new period end",
        "operationId": "CreatePeriodEnd",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PeriodEnd"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created period end",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "400": {
            "description": "Bad request, invalid input data"
          },
          "500": {
            "description": "Internal server error, could not create period end"
          }
        }
      }
    },
    "/api/period-ends/{periodEndId}": {
      "get": {
        "summary": "Get details of a specific period end",
        "operationId": "GetPeriodEndById",
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "parameters": [
          {
            "name": "periodEndId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with period end details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PeriodEnd"
                }
              }
            }
          },
          "404": {
            "description": "Period end not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PeriodEnd": {
        "type": "object",
        "properties": {
          "PeriodEndId": {
            "type": "string"
          },
          "CalendarPeriodMonth": {
            "type": "integer",
            "format": "int32"
          },
          "CalendarPeriodYear": {
            "type": "integer",
            "format": "int32"
          },
          "AccountDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CommitmentDataValidAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "PaymentsForPeriod": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization using the ReadAllEmployerAccountBalances policy"
      }
    }
  }
}
