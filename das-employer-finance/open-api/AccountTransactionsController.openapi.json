{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0",
    "description": "API for managing employer finance transactions."
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transactions": {
      "get": {
        "operationId": "GetTransactionSummary",
        "summary": "Fetch transaction summary for an account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account identifier."
          },
          {
            "name": "transactionType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Transaction type filter."
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Period end to filter transactions."
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction summary retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionSummary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters."
          },
          "404": {
            "description": "Transaction summary not found."
          }
        },
        "security": [
          {
            "ApiRolesReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/{year}/{month}": {
      "get": {
        "operationId": "GetTransactions",
        "summary": "Retrieve account transactions for a specific year and month.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account identifier."
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Year to filter transactions."
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Month to filter transactions."
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "404": {
            "description": "Transactions not found."
          }
        },
        "security": [
          {
            "ApiRolesReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/query": {
      "get": {
        "operationId": "QueryAccountTransactions",
        "summary": "Query transactions within a specific date range.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account identifier."
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Start date for transaction query."
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "End date for transaction query."
          }
        ],
        "responses": {
          "200": {
            "description": "Query results retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResults"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters."
          },
          "404": {
            "description": "Query results not found."
          }
        },
        "security": [
          {
            "ApiRolesReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiRolesReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization required with the ReadAllEmployerAccountBalances policy."
      }
    },
    "schemas": {
      "TransactionSummary": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          },
          "href": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "year",
          "month",
          "href"
        ]
      },
      "Transactions": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer"
          },
          "month": {
            "type": "integer"
          },
          "hasPreviousTransactions": {
            "type": "boolean"
          },
          "previousMonthUri": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "year",
          "month",
          "hasPreviousTransactions"
        ]
      },
      "QueryResults": {
        "type": "object",
        "properties": {
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionSummary"
            }
          }
        },
        "required": [
          "transactions"
        ]
      }
    }
  }
}
