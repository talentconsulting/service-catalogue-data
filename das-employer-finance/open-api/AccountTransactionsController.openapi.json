{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerFinance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transactions": {
      "get": {
        "operationId": "GetTransactionSummary",
        "summary": "Retrieve transaction summary for an account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transactionType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transaction summary or existing transactions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing or invalid query parameters"
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/{year}/{month}": {
      "get": {
        "operationId": "GetTransactions",
        "summary": "Get transactions for a specific year and month",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with transactions data for the specified period",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "404": {
            "description": "Transactions not found for the specified period"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/query": {
      "get": {
        "operationId": "QueryAccountTransactions",
        "summary": "Query account transactions based on date range",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with queried transaction data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing or invalid query parameters"
          },
          "404": {
            "description": "No transactions found for the specified date range"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionSummary": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "Year": {
              "type": "integer"
            },
            "Month": {
              "type": "integer"
            },
            "Href": {
              "type": "string"
            }
          }
        }
      },
      "Transactions": {
        "type": "object",
        "properties": {
          "Year": {
            "type": "integer"
          },
          "Month": {
            "type": "integer"
          },
          "HasPreviousTransactions": {
            "type": "boolean"
          },
          "PreviousMonthUri": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "scopes": {
              "ReadAllEmployerAccountBalances": "Access employer account balances"
            }
          }
        }
      }
    }
  }
}
