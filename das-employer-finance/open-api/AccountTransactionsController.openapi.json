{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/transactions": {
      "get": {
        "operationId": "GetTransactionSummary",
        "summary": "Retrieve account transaction summary",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transactionType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "responses": {
          "200": {
            "description": "Transaction summary retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Summary not found"
          }
        }
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/{year}/{month}": {
      "get": {
        "operationId": "GetTransactions",
        "summary": "Retrieve transactions for a specific year and month",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "404": {
            "description": "Transactions not found"
          }
        }
      }
    },
    "/api/accounts/{hashedAccountId}/transactions/query": {
      "get": {
        "operationId": "QueryAccountTransactions",
        "summary": "Query account transactions within a date range",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transactions"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Transactions not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionSummary": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "month": {
            "type": "integer",
            "format": "int32"
          },
          "href": {
            "type": "string"
          }
        }
      },
      "Transactions": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "month": {
            "type": "integer",
            "format": "int32"
          },
          "hasPreviousTransactions": {
            "type": "boolean"
          },
          "previousMonthUri": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
