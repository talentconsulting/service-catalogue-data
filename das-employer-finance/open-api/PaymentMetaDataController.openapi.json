{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/{paymentId}/metadata/staging": {
      "put": {
        "summary": "Update Payment Metadata Staging",
        "operationId": "updatePaymentMetaDataStaging",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the payment."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentMetaDataStaging"
              }
            }
          },
          "description": "The metadata details to be updated."
        },
        "responses": {
          "200": {
            "description": "Payment metadata updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "upserted": {
                      "type": "boolean",
                      "description": "Indicates if the record was inserted or updated."
                    },
                    "metadataId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "The metadata ID of the updated record."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Payment metadata not found."
          },
          "500": {
            "description": "Server error occurred while updating metadata staging."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentMetaDataStaging": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The metadata ID."
          },
          "providerName": {
            "type": "string",
            "description": "The name of the provider."
          },
          "standardCode": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "The standard code for the apprenticeship."
          },
          "frameworkCode": {
            "type": "integer",
            "nullable": true,
            "description": "The framework code for the apprenticeship."
          },
          "programmeType": {
            "type": "integer",
            "nullable": true,
            "description": "The programme type code."
          },
          "pathwayCode": {
            "type": "integer",
            "nullable": true,
            "description": "The pathway code."
          },
          "pathwayName": {
            "type": "string",
            "description": "The name of the pathway."
          },
          "apprenticeshipCourseName": {
            "type": "string",
            "description": "The name of the apprenticeship course."
          },
          "apprenticeshipCourseStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "The start date of the apprenticeship course."
          },
          "apprenticeshipCourseLevel": {
            "type": "integer",
            "nullable": true,
            "description": "The level of the apprenticeship course."
          },
          "apprenticeName": {
            "type": "string",
            "description": "The name of the apprentice."
          },
          "apprenticeNINumber": {
            "type": "string",
            "description": "The National Insurance number of the apprentice."
          },
          "isHistoricProviderName": {
            "type": "boolean",
            "description": "Indicates if the provider name is historic."
          },
          "learningType": {
            "type": "string",
            "description": "The type of learning."
          },
          "courseCode": {
            "type": "string",
            "description": "The code of the course."
          },
          "cohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "The cohort ID."
          },
          "createdBy": {
            "type": "string",
            "description": "The user who created the metadata."
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Correlation ID for tracking the request."
          },
          "paymentId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the payment."
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
