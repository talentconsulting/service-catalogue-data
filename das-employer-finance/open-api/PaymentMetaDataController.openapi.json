{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment MetaData API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/{paymentId}/metadata/staging": {
      "put": {
        "summary": "Update Payment MetaData Staging",
        "operationId": "updatePaymentMetaDataStaging",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "description": "The ID of the payment to update metadata for.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentMetaDataStaging"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated payment metadata staging.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "upserted": {
                      "type": "boolean",
                      "description": "Indicates whether the metadata was upserted."
                    },
                    "metadataId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "The unique ID of the updated metadata."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request, typically due to validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "example": {
                    "error": "Request body is required."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Payment not found."
          },
          "500": {
            "description": "Internal server error, could not update payment metadata staging."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentMetaDataStaging": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "providerName": {
            "type": "string"
          },
          "standardCode": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "frameworkCode": {
            "type": "integer",
            "nullable": true
          },
          "programmeType": {
            "type": "integer",
            "nullable": true
          },
          "pathwayCode": {
            "type": "integer",
            "nullable": true
          },
          "pathwayName": {
            "type": "string"
          },
          "apprenticeshipCourseName": {
            "type": "string"
          },
          "apprenticeshipCourseStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "apprenticeshipCourseLevel": {
            "type": "integer",
            "nullable": true
          },
          "apprenticeName": {
            "type": "string"
          },
          "apprenticeNINumber": {
            "type": "string"
          },
          "isHistoricProviderName": {
            "type": "boolean"
          },
          "learningType": {
            "type": "string"
          },
          "courseCode": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "createdBy": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "paymentId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "id",
          "providerName",
          "pathwayName",
          "apprenticeshipCourseName",
          "apprenticeName",
          "apprenticeNINumber",
          "isHistoricProviderName",
          "learningType",
          "courseCode",
          "createdBy",
          "paymentId"
        ]
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
