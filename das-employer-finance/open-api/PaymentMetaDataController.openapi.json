{
  "openapi": "3.1.0",
  "info": {
    "title": "Payment Metadata API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/{paymentId}/metadata/staging": {
      "put": {
        "summary": "Update Payment Metadata Staging",
        "description": "Updates the metadata associated with a specific payment in staging.",
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the payment to update."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentMetaDataStaging"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment metadata was successfully updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "upserted": {
                      "type": "boolean",
                      "description": "Indicates whether the metadata was upserted."
                    },
                    "metadataId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "The identifier of the updated metadata."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to validation errors or missing body.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "404": {
            "description": "The specified payment ID was not found."
          },
          "500": {
            "description": "Internal server error. Could not update Payment Metadata Staging."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentMetaDataStaging": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "providerName": {
            "type": "string"
          },
          "standardCode": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "frameworkCode": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "programmeType": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pathwayCode": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pathwayName": {
            "type": "string"
          },
          "apprenticeshipCourseName": {
            "type": "string"
          },
          "apprenticeshipCourseStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "apprenticeshipCourseLevel": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "apprenticeName": {
            "type": "string"
          },
          "apprenticeNINumber": {
            "type": "string"
          },
          "isHistoricProviderName": {
            "type": "boolean"
          },
          "learningType": {
            "type": "string"
          },
          "courseCode": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "createdBy": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "paymentId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
