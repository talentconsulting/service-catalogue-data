{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/payments/{paymentId}/metadata/staging": {
      "put": {
        "summary": "Update Payment Metadata Staging",
        "operationId": "updatePaymentMetaDataStaging",
        "responses": {
          "200": {
            "description": "Successfully updated the Payment Metadata Staging.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "upserted": {
                      "type": "boolean",
                      "description": "Indicates if metadata was created or updated."
                    },
                    "metadataId": {
                      "type": "string",
                      "format": "uuid",
                      "description": "Unique identifier for the metadata."
                    }
                  },
                  "required": [
                    "upserted",
                    "metadataId"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Validation errors occurred or request body is missing."
          },
          "404": {
            "description": "Not Found. The specified payment metadata was not found."
          },
          "500": {
            "description": "Internal Server Error. Could not update Payment Metadata Staging."
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the payment."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PaymentMetaDataStaging"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentMetaDataStaging": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the metadata staging entity."
          },
          "providerName": {
            "type": "string",
            "description": "Name of the provider."
          },
          "standardCode": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Standard code of the apprenticeship course."
          },
          "frameworkCode": {
            "type": "integer",
            "nullable": true,
            "description": "Framework code."
          },
          "programmeType": {
            "type": "integer",
            "nullable": true,
            "description": "Type of programme."
          },
          "pathwayCode": {
            "type": "integer",
            "nullable": true,
            "description": "Pathway code."
          },
          "pathwayName": {
            "type": "string",
            "description": "Name of the pathway."
          },
          "apprenticeshipCourseName": {
            "type": "string",
            "description": "Name of the apprenticeship course."
          },
          "apprenticeshipCourseStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Start date of the apprenticeship course."
          },
          "apprenticeshipCourseLevel": {
            "type": "integer",
            "nullable": true,
            "description": "Level of the apprenticeship course."
          },
          "apprenticeName": {
            "type": "string",
            "description": "Name of the apprentice."
          },
          "apprenticeNINumber": {
            "type": "string",
            "description": "National Insurance number of the apprentice."
          },
          "isHistoricProviderName": {
            "type": "boolean",
            "description": "Indicates if the provider name is historic."
          },
          "learningType": {
            "type": "string",
            "description": "Type of learning."
          },
          "courseCode": {
            "type": "string",
            "description": "Code of the course."
          },
          "cohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Unique identifier for the cohort."
          },
          "createdBy": {
            "type": "string",
            "description": "User who created the metadata."
          },
          "correlationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Correlation identifier for tracing."
          },
          "paymentId": {
            "type": "string",
            "format": "uuid",
            "description": "Payment ID associated with the metadata."
          }
        },
        "required": [
          "id",
          "providerName",
          "paymentId"
        ]
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
