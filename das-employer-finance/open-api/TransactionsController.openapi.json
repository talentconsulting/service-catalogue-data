{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "description": "API for handling transaction line staging operations.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/transaction-lines/staging": {
      "post": {
        "summary": "Bulk Ingest Transaction Lines",
        "operationId": "BulkTransactionLineStagingIngest",
        "requestBody": {
          "description": "Payload containing transaction lines to ingest.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionLineStagingRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Transaction lines successfully ingested.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "insertedCount": {
                      "type": "integer",
                      "format": "int32"
                    }
                  },
                  "required": [
                    "isSuccess",
                    "message",
                    "insertedCount"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "validationErrors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "isSuccess",
                    "message"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Server error during ingestion.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "isSuccess",
                    "message"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransactionLineStagingRequest": {
        "type": "object",
        "properties": {
          "transactionLines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TransactionLineStagingModel"
            }
          }
        },
        "required": [
          "transactionLines"
        ]
      },
      "TransactionLineStagingModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          },
          "submissionId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "transactionDate": {
            "type": "string",
            "format": "date-time"
          },
          "transactionType": {
            "type": "integer",
            "format": "int32"
          },
          "levyDeclared": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "amount": {
            "type": "number",
            "format": "decimal"
          },
          "empRef": {
            "type": "string",
            "nullable": true
          },
          "periodEnd": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "sfaCoInvestmentAmount": {
            "type": "number",
            "format": "decimal"
          },
          "employerCoInvestmentAmount": {
            "type": "number",
            "format": "decimal"
          },
          "englishFraction": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "transferSenderAccountId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "transferSenderAccountName": {
            "type": "string",
            "nullable": true
          },
          "transferReceiverAccountId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "transferReceiverAccountName": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "accountId",
          "dateCreated",
          "transactionDate",
          "transactionType",
          "amount",
          "periodEnd",
          "sfaCoInvestmentAmount",
          "employerCoInvestmentAmount"
        ]
      }
    }
  }
}
