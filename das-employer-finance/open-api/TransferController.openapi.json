{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/transfer/connections": {
      "get": {
        "summary": "Get Transfers by Period End",
        "description": "Fetch transfers for a specific account during a specified period end.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "Account ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": true,
            "description": "Period end identifier",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing account transfers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request when the periodEnd parameter is missing or invalid.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Not found when no transfers exist for the given accountId and periodEnd.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferResponse": {
        "type": "object",
        "properties": {
          "accountTransfers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token required to verify ReadAllEmployerAccountBalances policy."
      }
    }
  }
}
