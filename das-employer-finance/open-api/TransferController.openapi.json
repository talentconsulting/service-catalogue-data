{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/transfer/connections": {
      "get": {
        "summary": "Get transfers by period end",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account."
          },
          {
            "name": "periodEnd",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The period end to filter transfers."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the account's transfers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransferResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - 'periodEnd' query parameter is required."
          },
          "404": {
            "description": "Not found - no transfers found for the specified account and period."
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "TransferResponse": {
        "type": "object",
        "properties": {
          "AccountTransfers": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "A minimal schema for transfer objects."
            }
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization based on the ReadAllEmployerAccountBalances policy."
      }
    }
  }
}
