{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/jobs": {
      "post": {
        "operationId": "CreateJob",
        "summary": "Create a new audit job.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuditJobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload."
          }
        }
      },
      "get": {
        "operationId": "GetJobs",
        "summary": "Retrieve a paginated list of audit jobs.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 10,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of audit jobs retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateAuditJobRequest"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging parameters."
          }
        }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "operationId": "GetJob",
        "summary": "Retrieve a specific audit job by ID.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Audit job retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAuditJobRequest"
                }
              }
            }
          },
          "404": {
            "description": "Audit job not found."
          }
        }
      }
    },
    "/jobs/{jobId}/logs": {
      "get": {
        "operationId": "GetJobLogs",
        "summary": "Retrieve paginated logs for a specific audit job.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 10,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Logs retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateWorkflowLogRequest"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging parameters."
          }
        }
      }
    },
    "/jobs/{jobId}/workflows/{workflowId}/logs": {
      "post": {
        "operationId": "CreateWorkflowLog",
        "summary": "Create a workflow log for a specific job and workflow.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkflowLogRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workflow log created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid workflow log payload."
          }
        }
      },
      "get": {
        "operationId": "GetWorkflowLogs",
        "summary": "Retrieve paginated workflow logs for a specific job and workflow.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 10,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow logs retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CreateWorkflowLogRequest"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid paging parameters."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAuditJobRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "DateStarted": {
            "type": "string",
            "format": "date-time"
          },
          "NumRecords": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "Id",
          "Description",
          "DateStarted",
          "NumRecords"
        ]
      },
      "CreateResourceResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Message"
        ]
      },
      "CreateWorkflowLogRequest": {
        "type": "object",
        "properties": {
          "Sequence": {
            "type": "integer",
            "minimum": 1
          },
          "SpanId": {
            "type": "string"
          },
          "Stage": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "Data": {
            "type": "object",
            "nullable": true
          },
          "Error": {
            "$ref": "#/components/schemas/AuditErrorDetails"
          }
        },
        "required": [
          "Sequence",
          "SpanId",
          "Stage",
          "Description",
          "Status"
        ]
      },
      "AuditErrorDetails": {
        "type": "object",
        "properties": {
          "Code": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        },
        "required": [
          "Code",
          "Message"
        ]
      }
    }
  }
}
