{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Audit Log API",
    "version": "1.0.0"
  },
  "paths": {
    "/jobs": {
      "post": {
        "summary": "Create a new audit job",
        "operationId": "CreateJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAuditJobRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid job payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Retrieve a list of audit jobs",
        "operationId": "GetJobs",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Page number, must be 1 or greater"
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 10,
              "maximum": 100
            },
            "description": "Page size, between 10 and 100"
          }
        ],
        "responses": {
          "200": {
            "description": "List of audit jobs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid page or pagesize parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}": {
      "get": {
        "summary": "Retrieve a specific audit job",
        "operationId": "GetJob",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the audit job"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit job retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Audit job not found"
          }
        }
      }
    },
    "/jobs/{jobId}/logs": {
      "get": {
        "summary": "Retrieve logs for a specific audit job",
        "operationId": "GetJobLogs",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the audit job"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Page number, must be 1 or greater"
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 10,
              "maximum": 100
            },
            "description": "Page size, between 10 and 100"
          }
        ],
        "responses": {
          "200": {
            "description": "Logs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid page or pagesize parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{jobId}/workflows/{workflowId}/logs": {
      "post": {
        "summary": "Create a new workflow log for a specific audit job and workflow",
        "operationId": "CreateWorkflowLog",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the audit job"
          },
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the workflow"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkflowLogRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Workflow log created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateResourceResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid workflow log payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Retrieve workflow logs for a specific audit job and workflow",
        "operationId": "GetWorkflowLogs",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the audit job"
          },
          {
            "name": "workflowId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the workflow"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "Page number, must be 1 or greater"
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 10,
              "maximum": 100
            },
            "description": "Page size, between 10 and 100"
          }
        ],
        "responses": {
          "200": {
            "description": "Workflow logs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid page or pagesize parameters",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditErrorDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAuditJobRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "DateStarted": {
            "type": "string",
            "format": "date-time"
          },
          "NumRecords": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "Id",
          "Description",
          "DateStarted",
          "NumRecords"
        ]
      },
      "CreateResourceResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        }
      },
      "CreateWorkflowLogRequest": {
        "type": "object",
        "properties": {
          "Sequence": {
            "type": "integer",
            "minimum": 1
          },
          "SpanId": {
            "type": "string"
          },
          "Stage": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "Data": {
            "type": "object",
            "nullable": true
          },
          "Error": {
            "$ref": "#/components/schemas/AuditErrorDetails"
          }
        },
        "required": [
          "Sequence",
          "SpanId",
          "Stage",
          "Description",
          "Status"
        ]
      },
      "AuditErrorDetails": {
        "type": "object",
        "properties": {
          "Code": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          }
        }
      }
    }
  }
}
