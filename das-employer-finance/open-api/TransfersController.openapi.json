{
  "openapi": "3.1.0",
  "info": {
    "title": "Transfers API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/transfers": {
      "get": {
        "summary": "Get Transfers Index",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML view of the transfers index"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/transfers/financial-breakdown": {
      "get": {
        "summary": "Redirect to Error Page",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "Resource not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
