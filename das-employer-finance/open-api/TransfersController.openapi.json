{
  "openapi": "3.1.0",
  "info": {
    "title": "Transfers API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/transfers": {
      "get": {
        "operationId": "getTransfersIndex",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID for the employer."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/html": {}
            }
          },
          "default": {
            "description": "Unexpected error"
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/transfers/financial-breakdown": {
      "get": {
        "operationId": "getTransfersFinancialBreakdown",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID for the employer."
          }
        ],
        "responses": {
          "404": {
            "description": "Not Found",
            "content": {
              "text/html": {
                "examples": {
                  "errorPage": {
                    "description": "Redirects to an error page.",
                    "value": "<html><body><h1>404</h1><p>Page not found.</p></body></html>"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error"
          }
        }
      }
    }
  },
  "components": {}
}
