{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0",
    "description": "API for employer finance statistics."
  },
  "paths": {
    "/api/financestatistics": {
      "get": {
        "summary": "Get finance statistics",
        "operationId": "getStatistics",
        "responses": {
          "200": {
            "description": "Statistics data retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Statistics": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
