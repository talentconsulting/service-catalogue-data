{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/financestatistics": {
      "get": {
        "operationId": "GetStatistics",
        "summary": "Retrieve Finance Statistics",
        "responses": {
          "200": {
            "description": "Successful response with finance statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Statistics": {
        "type": "object",
        "description": "Statistics data object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRolesReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
