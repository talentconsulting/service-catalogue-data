{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/staging/staged-to-operational": {
      "post": {
        "summary": "Transfer from staged to operational",
        "description": "Transfers data from staged to operational.",
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "requestBody": {
          "description": "Payload to transfer staged data to operational.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferStagedToOperationalRequest"
              }
            }
          }
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string"
                    },
                    "processedCount": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string"
                    },
                    "processedCount": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferStagedToOperationalRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "description": "The ID of the account."
          },
          "PeriodEnd": {
            "type": "string",
            "description": "The period end identifier."
          },
          "CorrelationId": {
            "type": "string",
            "description": "Correlation ID for tracking purposes."
          }
        },
        "required": [
          "AccountId",
          "PeriodEnd",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Requires the ReadAllEmployerAccountBalances policy."
      }
    }
  }
}
