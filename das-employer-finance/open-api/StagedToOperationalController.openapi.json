{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/staging/staged-to-operational": {
      "post": {
        "summary": "Transfer staged to operational",
        "description": "Transfers staged data to operational for a given account and period end.",
        "operationId": "stagedToOperational",
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransferStagedToOperationalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully transferred staged data to operational.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "processedCount": {
                      "type": "integer",
                      "format": "int32"
                    }
                  },
                  "required": [
                    "isSuccess",
                    "message",
                    "processedCount"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. The payload is missing or contains validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "string",
                      "description": "Validation error message."
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error. An error occurred during the operation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "isSuccess": {
                      "type": "boolean",
                      "enum": [
                        false
                      ]
                    },
                    "message": {
                      "type": "string"
                    },
                    "processedCount": {
                      "type": "integer",
                      "format": "int32"
                    }
                  },
                  "required": [
                    "isSuccess",
                    "message",
                    "processedCount"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TransferStagedToOperationalRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "PeriodEnd": {
            "type": "string"
          },
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "AccountId",
          "PeriodEnd",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
