{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Transfer Connection Invitations API",
    "description": "API for managing transfer connection invitations in the employer finance system.",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/transfers/connections/requests": {
      "get": {
        "summary": "Display Transfer Connection Invitations Index",
        "operationId": "GetTransferConnectionInvitationsIndex",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
