            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartTransferConnectionInvitationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to Send Transfer Connection Invitation"
          },
          "400": {
            "description": "Validation Error"
          }
        }
      }
    },
