          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/remove": {
      "post": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "postRemovePaye",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemovePayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect"
          }
        }
      }
    }
