{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Account PAYE Controller API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/schemes": {
      "get": {
        "operationId": "GetPayeSchemes",
        "summary": "Get PAYE schemes for an employer account.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of PAYE schemes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewModelBase"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/schemes/next": {
      "get": {
        "operationId": "GetPayeNextSteps",
        "summary": "Get PAYE Next Steps view model.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of next steps view model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewModelBase"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostPayeNextSteps",
        "summary": "Select action based on PAYE next steps.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                },
                "required": [
                  "choice"
                ]
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect based on action choice."
          },
          "400": {
            "description": "Invalid choice submitted."
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/schemes/{empRef}/details": {
      "get": {
        "operationId": "GetPayeDetails",
        "summary": "Get details for a specific PAYE scheme.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          },
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reference for the PAYE scheme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of PAYE scheme details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewModelBase"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/schemes/gatewayInform": {
      "get": {
        "operationId": "GetGatewayInform",
        "summary": "Check if the user is the owner through gateway inform.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful user ownership check.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewModelBase"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/schemes/gateway": {
      "get": {
        "operationId": "GetGateway",
        "summary": "Get gateway URL for PAYE scheme confirmation.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to gateway URL."
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/schemes/confirm": {
      "get": {
        "operationId": "ConfirmPayeScheme",
        "summary": "Confirm adding a new PAYE scheme.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Show confirmation page for PAYE scheme.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddNewPayeSchemeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostConfirmPayeScheme",
        "summary": "Submit confirmation to add a new PAYE scheme.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddNewPayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect after confirmation."
          },
          "400": {
            "description": "Invalid data submitted."
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/schemes/{empRef}/remove": {
      "get": {
        "operationId": "GetRemovePayeScheme",
        "summary": "Get removal view for PAYE scheme.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          },
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reference for the PAYE scheme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of PAYE scheme removal view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovePayeSchemeViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/schemes/remove": {
      "post": {
        "operationId": "PostRemovePayeScheme",
        "summary": "Submit removal of a PAYE scheme.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier for the employer account."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemovePayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect after removal."
          },
          "400": {
            "description": "Invalid data submitted."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ViewModelBase": {
        "type": "object",
        "properties": {
          "PublicHashedAccountId": {
            "type": "string"
          },
          "UserId": {
            "type": "integer"
          },
          "Valid": {
            "type": "boolean"
          },
          "ErrorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "AddNewPayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "PayeScheme": {
            "type": "string"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          },
          "AccessToken": {
            "type": "string"
          },
          "RefreshToken": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "EmprefNotFound": {
            "type": "boolean"
          },
          "PayeName": {
            "type": "string"
          }
        }
      },
      "RemovePayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "PayeRef": {
            "type": "string"
          },
          "PayeSchemeName": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "RemoveScheme": {
            "type": "integer"
          },
          "RemoveSchemeErrorMessage": {
            "type": "string"
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "Agreements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agreement"
            }
          },
          "Code": {
            "type": "string"
          },
          "DasAccountId": {
            "type": "string"
          },
          "DateOfInception": {
            "type": "string",
            "format": "date-time"
          },
          "Address": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "PublicSectorDataSource": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "Source": {
            "type": "string"
          },
          "SourceNumeric": {
            "type": "integer"
          },
          "Status": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          }
        }
      },
      "Agreement": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "SignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "SignedByName": {
            "type": "string"
          },
          "SignedById": {
            "type": "integer"
          },
          "SignedByEmail": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "TemplateVersionNumber": {
            "type": "integer"
          },
          "AgreementType": {
            "type": "string"
          }
        }
      }
    }
  }
}
