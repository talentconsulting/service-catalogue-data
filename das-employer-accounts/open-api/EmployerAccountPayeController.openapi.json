{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Account PAYE API",
    "version": "1.0.0",
    "description": "API endpoints for managing PAYE schemes within employer accounts."
  },
  "paths": {
    "/accounts/{HashedAccountId}/schemes": {
      "get": {
        "summary": "Get PAYE schemes",
        "description": "Returns a view model with information about PAYE schemes for a specified employer account.",
        "operationId": "GetPayeSchemes",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/accounts/{HashedAccountId}/schemes/next": {
      "get": {
        "summary": "Get next steps",
        "description": "Returns a view model with information about the next steps for managing PAYE schemes.",
        "operationId": "GetNextSteps",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      },
      "post": {
        "summary": "Post next steps choice",
        "description": "Handles the user's choice for the next steps in managing PAYE schemes.",
        "operationId": "PostNextStepsChoice",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirection based on choice."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/accounts/{HashedAccountId}/schemes/{empRef}/details": {
      "get": {
        "summary": "Get scheme details",
        "description": "Returns details for a specific PAYE scheme within an employer account.",
        "operationId": "GetPayeSchemeDetails",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          },
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reference for the PAYE scheme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/accounts/{HashedAccountId}/schemes/gatewayInform": {
      "get": {
        "summary": "Inform of gateway",
        "description": "Checks if the user is the owner of the account and prepares data to inform of gateway.",
        "operationId": "GetGatewayInform",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/accounts/{HashedAccountId}/schemes/gateway": {
      "get": {
        "summary": "Gateway redirect",
        "description": "Redirects to the gateway URL for adding a PAYE scheme.",
        "operationId": "GetGatewayRedirect",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the gateway URL."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/accounts/{HashedAccountId}/schemes/confirm": {
      "get": {
        "summary": "Confirm PAYE scheme",
        "description": "Displays confirmation for adding a PAYE scheme to an employer account.",
        "operationId": "GetConfirmPayeScheme",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      },
      "post": {
        "summary": "Add PAYE scheme to account",
        "description": "Confirms and adds a new PAYE scheme to the account.",
        "operationId": "PostConfirmPayeScheme",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddNewPayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/accounts/{HashedAccountId}/schemes/{empRef}/remove": {
      "get": {
        "summary": "Remove PAYE scheme confirmation",
        "description": "Displays removal confirmation for a specific PAYE scheme.",
        "operationId": "GetRemovePayeSchemeConfirm",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          },
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reference for the PAYE scheme."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    },
    "/accounts/{HashedAccountId}/schemes/remove": {
      "post": {
        "summary": "Remove PAYE scheme",
        "description": "Removes the specified PAYE scheme from an employer account.",
        "operationId": "PostRemovePayeScheme",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed ID of the employer account."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemovePayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response."
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddNewPayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "PayeScheme": {
            "type": "string"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          },
          "AccessToken": {
            "type": "string"
          },
          "RefreshToken": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "EmprefNotFound": {
            "type": "boolean"
          },
          "PayeName": {
            "type": "string"
          }
        }
      },
      "RemovePayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "PayeRef": {
            "type": "string"
          },
          "PayeSchemeName": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "RemoveScheme": {
            "type": "integer"
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "Code": {
            "type": "string"
          },
          "DasAccountId": {
            "type": "string"
          },
          "DateOfInception": {
            "type": "string",
            "format": "date-time"
          },
          "Address": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "PublicSectorDataSource": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "Source": {
            "type": "string"
          },
          "SourceNumeric": {
            "type": "integer"
          },
          "Status": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          }
        }
      }
    }
  }
}
