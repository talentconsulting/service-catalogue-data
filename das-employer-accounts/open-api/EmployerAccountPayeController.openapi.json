{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Account PAYE Management API",
    "version": "1.0.0",
    "description": "API for managing Employer Account PAYE schemes."
  },
  "paths": {
    "/accounts/{hashedAccountId}/schemes": {
      "get": {
        "summary": "Get PAYE schemes",
        "operationId": "getPayeSchemes",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/next": {
      "get": {
        "summary": "Get next steps for PAYE schemes",
        "operationId": "getNextSteps",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "summary": "Post next steps for PAYE schemes",
        "operationId": "postNextSteps",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Next steps choice",
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/{empRef}/details": {
      "get": {
        "summary": "Get details of a PAYE scheme",
        "operationId": "getPayeSchemeDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/gatewayInform": {
      "get": {
        "summary": "Inform user about the PAYE gateway",
        "operationId": "getGatewayInform",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/gateway": {
      "get": {
        "summary": "Get gateway URL for PAYE scheme",
        "operationId": "getGatewayUrl",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to gateway URL"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/confirm": {
      "get": {
        "summary": "Confirm the PAYE scheme",
        "operationId": "getConfirmPayeScheme",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "summary": "Confirm and add a new PAYE scheme",
        "operationId": "postConfirmPayeScheme",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "New PAYE scheme details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddNewPayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/{empRef}/remove": {
      "get": {
        "summary": "Get PAYE scheme removal confirmation",
        "operationId": "getRemovePayeScheme",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/remove": {
      "post": {
        "summary": "Remove a PAYE scheme",
        "operationId": "postRemovePayeScheme",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "PAYE scheme removal details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemovePayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddNewPayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "PayeScheme": {
            "type": "string"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          },
          "AccessToken": {
            "type": "string"
          },
          "RefreshToken": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "EmprefNotFound": {
            "type": "boolean"
          },
          "PayeName": {
            "type": "string"
          }
        }
      },
      "RemovePayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "PayeRef": {
            "type": "string"
          },
          "PayeSchemeName": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "RemoveScheme": {
            "type": "integer"
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "Agreements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agreement"
            }
          },
          "Code": {
            "type": "string"
          },
          "DasAccountId": {
            "type": "string"
          },
          "DateOfInception": {
            "type": "string",
            "format": "date-time"
          },
          "Address": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "PublicSectorDataSource": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "Source": {
            "type": "string"
          },
          "SourceNumeric": {
            "type": "integer"
          },
          "Status": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "AgreementSignedByName": {
            "type": "string"
          },
          "AgreementSignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "AgreementStatus": {
            "$ref": "#/components/schemas/EmployerAgreementStatus"
          }
        }
      },
      "Agreement": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "SignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "SignedByName": {
            "type": "string"
          },
          "SignedById": {
            "type": "integer"
          },
          "SignedByEmail": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/EmployerAgreementStatus"
          },
          "TemplateVersionNumber": {
            "type": "integer"
          },
          "AgreementType": {
            "type": "string"
          }
        }
      },
      "EmployerAgreementStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Signed",
          "Expired",
          "Superseded",
          "Removed"
        ]
      }
    }
  }
}
