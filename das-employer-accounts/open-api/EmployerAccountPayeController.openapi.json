  "components": {
    "schemas": {
      "AddNewPayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "payeScheme": {
            "type": "string"
          },
          "legalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "emprefNotFound": {
            "type": "boolean"
          },
          "payeName": {
            "type": "string"
          }
        }
      },
      "RemovePayeSchemeViewModel": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "payeRef": {
            "type": "string"
          },
          "payeSchemeName": {
            "type": "string"
          },
          "accountName": {
            "type": "string"
          },
          "removeScheme": {
            "type": "integer"
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "dasAccountId": {
            "type": "string"
          },
          "dateOfInception": {
            "type": "string",
            "format": "date-time"
          },
          "address": {
            "type": "string"
          },
          "legalEntityId": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "publicSectorDataSource": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "accountLegalEntityId": {
            "type": "integer"
          },
          "accountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "accountName": {
            "type": "string"
          }
        }
      }
    }
  }
}
