{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts PAYE Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/schemes": {
      "get": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "getPayeSchemes",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/next": {
      "get": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "getNextSteps",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "postNextSteps",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/{empRef}/details": {
      "get": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "getPayeDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "empRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/gatewayInform": {
      "get": {
        "tags": [
          "EmployerAccountPaye"
        ],
