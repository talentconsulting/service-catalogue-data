            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/gateway": {
      "get": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "getGateway",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/confirm": {
      "get": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "getConfirmPayeScheme",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "postConfirmPayeScheme",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddNewPayeSchemeViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/schemes/{empRef}/remove": {
      "get": {
        "tags": [
          "EmployerAccountPaye"
        ],
        "operationId": "getRemovePayeScheme",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "empRef",
            "in": "path",
