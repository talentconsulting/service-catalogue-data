{
  "openapi": "3.1.0",
  "info": {
    "title": "Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/settings/notifications": {
      "get": {
        "operationId": "getNotificationSettings",
        "summary": "Retrieve notification settings.",
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notification settings retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettingsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "updateNotificationSettings",
        "summary": "Update notification settings.",
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettingsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Notification settings updated. Redirect to notification settings page."
          }
        }
      }
    },
    "/settings/notifications/unsubscribe/{hashedAccountId}": {
      "get": {
        "operationId": "unsubscribeNotifications",
        "summary": "Unsubscribe from notifications.",
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Unsubscribe confirmation screen.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationSettingsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string"
          },
          "NotificationSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserNotificationSetting"
            }
          },
          "PublicHashedAccountId": {
            "type": "string"
          },
          "UserId": {
            "type": "integer",
            "format": "int64"
          },
          "Valid": {
            "type": "boolean"
          },
          "ErrorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "UserNotificationSetting": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "UserId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
