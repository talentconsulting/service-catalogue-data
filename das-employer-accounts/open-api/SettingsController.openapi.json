{
  "openapi": "3.1.0",
  "info": {
    "title": "Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/settings/notifications": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Get notification settings for the authenticated user.",
        "operationId": "getNotificationSettings",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Notification settings retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettingsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Settings"
        ],
        "summary": "Update notification settings for the authenticated user.",
        "operationId": "updateNotificationSettings",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettingsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected to the notification settings page."
          }
        }
      }
    },
    "/settings/notifications/unsubscribe/{hashedAccountId}": {
      "get": {
        "tags": [
          "Settings"
        ],
        "summary": "Unsubscribe from notifications for a specific account.",
        "operationId": "unsubscribeNotification",
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID to unsubscribe from notifications."
          }
        ],
        "responses": {
          "200": {
            "description": "Unsubscribed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationSettingsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string",
            "nullable": true
          },
          "NotificationSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserNotificationSetting"
            },
            "nullable": true
          },
          "PublicHashedAccountId": {
            "type": "string",
            "nullable": true
          },
          "UserId": {
            "type": "integer",
            "format": "int64"
          },
          "Valid": {
            "type": "boolean"
          },
          "ErrorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": []
      },
      "UserNotificationSetting": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "HashedAccountId": {
            "type": "string",
            "nullable": true
          },
          "UserId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string",
            "nullable": true
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        },
        "required": []
      }
    },
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "API key for accessing restricted resources."
      }
    }
  }
}
