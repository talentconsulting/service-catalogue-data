{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/settings/notifications": {
      "get": {
        "summary": "Retrieve notification settings",
        "operationId": "getNotificationSettings",
        "security": [
          {
            "Policy": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Notification settings view model returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettingsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update notification settings",
        "operationId": "updateNotificationSettings",
        "security": [
          {
            "Policy": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettingsViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Notification settings updated successfully"
          }
        }
      }
    },
    "/settings/notifications/unsubscribe/{hashedAccountId}": {
      "get": {
        "summary": "Unsubscribe from notifications",
        "operationId": "unsubscribeNotifications",
        "security": [
          {
            "Policy": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID to unsubscribe from notifications"
          }
        ],
        "responses": {
          "200": {
            "description": "Unsubscribe view model returned",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationSettingsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string"
          },
          "NotificationSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserNotificationSetting"
            }
          }
        }
      },
      "UserNotificationSetting": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "UserId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
