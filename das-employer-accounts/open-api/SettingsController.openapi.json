{
  "openapi": "3.1.0",
  "info": {
    "title": "SettingsController API",
    "version": "1.0.0"
  },
  "paths": {
    "/settings/notifications": {
      "get": {
        "operationId": "getNotificationSettings",
        "summary": "Get the user's notification settings.",
        "responses": {
          "200": {
            "description": "Successful response with notification settings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationSettingsViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "updateNotificationSettings",
        "summary": "Update the user's notification settings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettingsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection to the notification settings page after an update."
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/settings/notifications/unsubscribe/{hashedAccountId}": {
      "get": {
        "operationId": "unsubscribeNotifications",
        "summary": "Unsubscribe from notifications for a given account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID for which notifications should be unsubscribed."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response after unsubscribing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ViewModelBase"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationSettingsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string"
          },
          "NotificationSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserNotificationSetting"
            }
          }
        },
        "required": [
          "HashedId",
          "NotificationSettings"
        ]
      },
      "UserNotificationSetting": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "UserId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "AccountId",
          "HashedAccountId",
          "UserId",
          "Name",
          "ReceiveNotifications"
        ]
      },
      "ViewModelBase": {
        "type": "object",
        "properties": {
          "PublicHashedAccountId": {
            "type": "string"
          },
          "UserId": {
            "type": "integer",
            "format": "int64"
          },
          "Valid": {
            "type": "boolean"
          },
          "ErrorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "PolicyNames.HasEmployerViewerTransactorOwnerAccount": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization policy for accessing settings features."
      }
    }
  }
}
