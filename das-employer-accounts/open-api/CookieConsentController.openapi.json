      "get": {
        "operationId": "GetCookieConsentDetailsDefault",
        "summary": "Retrieve default detailed cookie consent settings",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
