{
  "openapi": "3.1.0",
  "info": {
    "title": "Cookie Consent API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/cookieConsent": {
      "get": {
        "operationId": "getCookieConsentSettingsWithAccount",
        "summary": "Retrieve cookie consent settings for a specific account.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/cookieConsent": {
      "get": {
        "operationId": "getCookieConsentSettings",
        "summary": "Retrieve cookie consent settings (general).",
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/cookieConsent/details": {
      "get": {
        "operationId": "getCookieConsentDetailsWithAccount",
        "summary": "Retrieve detailed cookie consent information for a specific account.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    },
    "/cookieConsent/details": {
      "get": {
        "operationId": "getCookieConsentDetails",
        "summary": "Retrieve detailed cookie consent information (general).",
        "responses": {
          "200": {
            "description": "Successful response."
          }
        }
      }
    }
  },
  "components": {}
}
