{
  "openapi": "3.1.0",
  "info": {
    "title": "CookieConsentController API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/cookieConsent": {
      "get": {
        "operationId": "getCookieConsentSettings",
        "summary": "Display the Cookie Consent Settings page.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response displaying the Cookie Consent Settings page."
          }
        }
      }
    },
    "/cookieConsent": {
      "get": {
        "operationId": "getCookieConsentSettingsWithoutAccount",
        "summary": "Display the Cookie Consent Settings page without an account identifier.",
        "responses": {
          "200": {
            "description": "Successful response displaying the Cookie Consent Settings page."
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/cookieConsent/details": {
      "get": {
        "operationId": "getCookieConsentDetails",
        "summary": "Display the Cookie Consent Details page.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response displaying the Cookie Consent Details page."
          }
        }
      }
    },
    "/cookieConsent/details": {
      "get": {
        "operationId": "getCookieConsentDetailsWithoutAccount",
        "summary": "Display the Cookie Consent Details page without an account identifier.",
        "responses": {
          "200": {
            "description": "Successful response displaying the Cookie Consent Details page."
          }
        }
      }
    }
  },
  "components": {}
}
