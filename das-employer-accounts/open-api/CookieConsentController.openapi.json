{
  "openapi": "3.1.0",
  "info": {
    "title": "Cookie Consent API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/cookieConsent": {
      "get": {
        "operationId": "Settings",
        "summary": "Displays the cookie consent settings.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the cookie consent settings view."
          }
        }
      }
    },
    "/cookieConsent": {
      "get": {
        "operationId": "SettingsAlternate",
        "summary": "Displays the cookie consent settings (alternate route).",
        "responses": {
          "200": {
            "description": "Successful response rendering the cookie consent settings view."
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/cookieConsent/details": {
      "get": {
        "operationId": "Details",
        "summary": "Displays detailed cookie consent information.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response rendering the cookie consent details view."
          }
        }
      }
    },
    "/cookieConsent/details": {
      "get": {
        "operationId": "DetailsAlternate",
        "summary": "Displays detailed cookie consent information (alternate route).",
        "responses": {
          "200": {
            "description": "Successful response rendering the cookie consent details view."
          }
        }
      }
    }
  },
  "components": {}
}
