{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/legalEntities/{hashedlegalEntityId}/agreements/{agreementId}": {
      "get": {
        "operationId": "GetAgreementById",
        "summary": "Retrieve agreement by ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedlegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Agreement not found"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/minimum-signed-agreement-version": {
      "get": {
        "operationId": "InternalGetMinimumSignedAgreementVersion",
        "summary": "Retrieve minimum signed agreement version for an account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimum signed agreement version retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/signed-agreement-version": {
      "get": {
        "operationId": "GetMinimumSignedAgreementVersionByHashedId",
        "summary": "Retrieve minimum signed agreement version by hashed account ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimum signed agreement version retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinimumSignedAgreementResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/agreements": {
      "get": {
        "operationId": "GetAgreements",
        "summary": "Retrieve all agreements for an account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreements retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {}
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAgreements": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MinimumSignedAgreementResponse": {
        "type": "object",
        "properties": {
          "MinimumSignedAgreementVersion": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadAllEmployerAgreements": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
