{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreements API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/legalEntities/{hashedlegalEntityId}/agreements/{agreementId}": {
      "get": {
        "operationId": "GetAgreement",
        "summary": "Retrieve an agreement by its ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedlegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreement found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Agreement not found"
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/minimum-signed-agreement-version": {
      "get": {
        "operationId": "GetMinimumSignedAgreementVersionInternal",
        "summary": "Retrieve the internal minimum signed agreement version",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimum signed agreement version retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/signed-agreement-version": {
      "get": {
        "operationId": "GetMinimumSignedAgreementVersionByHashedId",
        "summary": "Retrieve minimum signed agreement version using hashed account ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimum signed agreement version retrieval successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinimumSignedAgreementResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/agreements": {
      "get": {
        "operationId": "GetAgreements",
        "summary": "Retrieve all agreements for an account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreements retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MinimumSignedAgreementResponse": {
        "type": "object",
        "properties": {
          "MinimumSignedAgreementVersion": {
            "type": "integer"
          }
        },
        "required": [
          "MinimumSignedAgreementVersion"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAgreements": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
