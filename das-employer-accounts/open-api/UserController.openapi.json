{
  "openapi": "3.1.0",
  "info": {
    "title": "User API",
    "description": "API for managing user accounts in the system.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user": {
      "get": {
        "summary": "Get user by email",
        "operationId": "GetUserByEmail",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "404": {
            "description": "User not found."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/user/by-ref/{userRef}": {
      "get": {
        "summary": "Get user by reference",
        "operationId": "GetUserByRef",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "404": {
            "description": "User not found."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/user/upsert": {
      "put": {
        "summary": "Upsert a registered user",
        "operationId": "UpsertRegisteredUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRegisteredUserCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered or updated successfully."
          },
          "500": {
            "description": "Internal Server Error."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UpsertRegisteredUserCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmailAddress": {
            "type": "string",
            "format": "email"
          },
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "UserRef",
          "FirstName",
          "LastName",
          "EmailAddress",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Authorization based on the ApiRoles.ReadUserAccounts policy"
      }
    }
  }
}
