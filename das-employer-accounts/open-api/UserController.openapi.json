{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts User API",
    "version": "1.0.0",
    "description": "API for managing user accounts in the Employer Accounts system."
  },
  "paths": {
    "/api/user": {
      "get": {
        "summary": "Get user information by email",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "The email address of the user to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with user data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "ReadUserAccounts"
            ]
          }
        ]
      }
    },
    "/api/user/by-ref/{userRef}": {
      "get": {
        "summary": "Get user information by reference",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique reference of the user to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with user data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "oauth2": [
              "ReadUserAccounts"
            ]
          }
        ]
      }
    },
    "/api/user/upsert": {
      "put": {
        "summary": "Upsert user information",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRegisteredUserCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "oauth2": [
              "ReadUserAccounts"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UpsertRegisteredUserCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string",
            "description": "The unique reference of the user."
          },
          "FirstName": {
            "type": "string",
            "description": "The first name of the user."
          },
          "LastName": {
            "type": "string",
            "description": "The last name of the user."
          },
          "EmailAddress": {
            "type": "string",
            "format": "email",
            "description": "The email address of the user."
          },
          "CorrelationId": {
            "type": "string",
            "description": "A correlation identifier for tracking purposes."
          }
        },
        "required": [
          "UserRef",
          "FirstName",
          "LastName",
          "EmailAddress",
          "CorrelationId"
        ]
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "ReadUserAccounts": "Read access to user accounts"
            }
          }
        }
      }
    }
  }
}
