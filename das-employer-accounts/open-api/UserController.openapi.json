{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing registered user accounts."
  },
  "paths": {
    "/api/user": {
      "get": {
        "summary": "Get user by email",
        "operationId": "GetUserByEmail",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/user/by-ref/{userRef}": {
      "get": {
        "summary": "Get user by reference",
        "operationId": "GetUserByRef",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/user/upsert": {
      "put": {
        "summary": "Upsert a registered user",
        "operationId": "UpsertRegisteredUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertRegisteredUserCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User upserted successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UpsertRegisteredUserCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmailAddress": {
            "type": "string"
          },
          "CorrelationId": {
            "type": "string"
          }
        },
        "required": [
          "UserRef",
          "EmailAddress"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmailAddress": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
