{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer User API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/{userRef}/accounts": {
      "get": {
        "operationId": "GetUserAccounts",
        "summary": "Retrieve user accounts",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of user accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccountsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserAccountsResponse": {
        "type": "object",
        "description": "A minimal schema representation for user accounts.",
        "properties": {}
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization scheme requiring the 'ReadUserAccounts' role."
      }
    }
  }
}
