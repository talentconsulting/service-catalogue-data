{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/{userRef}/accounts": {
      "get": {
        "operationId": "GetUserAccounts",
        "summary": "Retrieve user accounts by user reference",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "description": "The reference of the user whose accounts are being retrieved",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserAccountsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetUserAccountsResponse": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
