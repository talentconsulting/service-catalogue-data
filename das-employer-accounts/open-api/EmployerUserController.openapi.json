{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/{userRef}/accounts": {
      "get": {
        "operationId": "GetUserAccounts",
        "summary": "Retrieve user accounts",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The reference of the user whose accounts are being retrieved"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccountsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadUserAccounts"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserAccountsResponse": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Use the `Authorization` header with the policy role `ReadUserAccounts`."
      }
    }
  }
}
