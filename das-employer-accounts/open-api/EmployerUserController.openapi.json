{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/{userRef}/accounts": {
      "get": {
        "operationId": "GetUserAccounts",
        "summary": "Get accounts associated with a user.",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The reference ID of the user."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccountsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserAccountsResponse": {
        "type": "object",
        "description": "Represents the accounts associated with a given user."
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires the `ReadUserAccounts` role."
      }
    }
  }
}
