{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/{userRef}/accounts": {
      "get": {
        "operationId": "GetUserAccounts",
        "summary": "Retrieve accounts associated with a user",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The reference identifier of the user."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with user accounts data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccounts"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserAccounts": {
        "type": "object",
        "description": "The user accounts data.",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires the ReadUserAccounts authorization role."
      }
    }
  }
}
