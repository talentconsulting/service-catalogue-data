{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer User API",
    "description": "API for managing employer user accounts",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/{userRef}/accounts": {
      "get": {
        "tags": [
          "EmployerUser"
        ],
        "summary": "Get user accounts",
        "description": "Retrieve a list of accounts for a given user reference.",
        "operationId": "getUserAccounts",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "description": "The reference ID of the user",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of accounts associated with the user reference",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAccounts"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadUserAccounts"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserAccounts": {
        "type": "object",
        "description": "A minimal schema representing user accounts",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
