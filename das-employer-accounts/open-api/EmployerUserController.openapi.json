{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user/{userRef}/accounts": {
      "get": {
        "summary": "Get user accounts",
        "description": "Retrieve accounts associated with a specific user reference.",
        "operationId": "getUserAccounts",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "description": "The reference for the user.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User accounts retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinimalSchema"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MinimalSchema": {
        "type": "object",
        "description": "Placeholder schema for response data."
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "API key or token with 'ReadUserAccounts' role."
      }
    }
  }
}
