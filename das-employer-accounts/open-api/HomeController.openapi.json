{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerAccounts Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Index",
        "parameters": [
          {
            "name": "redirectUri",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redirect or View",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/termsAndConditions/overview": {
      "get": {
        "summary": "Terms and Conditions Overview",
        "responses": {
          "200": {
            "description": "Terms and Conditions Overview Page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/termsAndConditions": {
      "get": {
        "summary": "View Terms and Conditions",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Terms and Conditions View",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "summary": "Update Terms and Conditions Acceptance",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TermsAndConditionsNewViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirect",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accessibility-statement": {
      "get": {
        "summary": "Accessibility Statement",
        "responses": {
          "200": {
            "description": "Accessibility Statement View",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "summary": "View Accounts",
        "responses": {
          "200": {
            "description": "Accounts Page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/register/new/{correlationId}": {
      "get": {
        "summary": "Handle New Registration",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect"
          }
        }
      }
    },
