{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing employer accounts and related functionalities."
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "getIndex",
        "summary": "Default Index Page",
        "parameters": [
          {
            "name": "redirectUri",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "302": {
            "description": "Redirects to another URI"
          }
        }
      }
    },
    "/termsAndConditions/overview": {
      "get": {
        "operationId": "getTermsAndConditionsOverview",
        "summary": "View Terms and Conditions Overview",
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/termsAndConditions": {
      "get": {
        "operationId": "getTermsAndConditions",
        "summary": "View Terms and Conditions",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "policyNames": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      },
      "post": {
        "operationId": "postTermsAndConditions",
        "summary": "Accept Terms and Conditions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TermsAndConditionsNewViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Terms and conditions accepted"
          },
          "302": {
            "description": "Redirects based on the return URL"
          }
        },
        "security": [
          {
            "policyNames": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/accessibility-statement": {
      "get": {
        "operationId": "getAccessibilityStatement",
        "summary": "Accessibility Statement",
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/accounts": {
      "get": {
        "operationId": "getViewAccounts",
        "summary": "View employer accounts",
        "responses": {
          "200": {
            "description": "Returns the accounts view"
          }
        },
        "security": [
          {
            "policyNames": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/register/new/{correlationId}": {
      "get": {
        "operationId": "getHandleNewRegistration",
        "summary": "Handle new registration",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to index page"
          }
        },
        "security": [
          {
            "policyNames": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/register": {
      "get": {
        "operationId": "getRegisterUser",
        "summary": "Register user",
        "responses": {
          "302": {
            "description": "Redirects to user registration"
          }
        }
      }
    },
    "/password/change": {
      "get": {
        "operationId": "getHandlePasswordChanged",
        "summary": "Handle password change",
        "parameters": [
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to index page"
          }
        },
        "security": [
          {
            "policyNames": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/email/change": {
      "get": {
        "operationId": "getHandleEmailChanged",
        "summary": "Handle email change",
        "parameters": [
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to index page"
          }
        },
        "security": [
          {
            "policyNames": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/signIn": {
      "get": {
        "operationId": "getSignIn",
        "summary": "Redirect to sign-in",
        "responses": {
          "302": {
            "description": "Redirects to index page"
          }
        }
      }
    },
    "/signout": {
      "get": {
        "operationId": "signOutUser",
        "summary": "Sign out user",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects user to signed out page"
          }
        }
      }
    },
    "/signoutcleanup": {
      "get": {
        "operationId": "signOutCleanup",
        "summary": "Sign out cleanup",
        "responses": {
          "204": {
            "description": "Successfully signed out"
          }
        }
      }
    },
    "/signed-out": {
      "get": {
        "operationId": "getSignedOut",
        "summary": "View signed out page",
        "responses": {
          "200": {
            "description": "View signed out page"
          }
        }
      }
    },
    "/{hashedAccountId}/privacy": {
      "get": {
        "operationId": "getPrivacyForAccount",
        "summary": "Privacy policy",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns privacy policy"
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "operationId": "getPrivacy",
        "summary": "Privacy policy",
        "responses": {
          "200": {
            "description": "Returns privacy policy"
          }
        }
      }
    },
    "/help": {
      "get": {
        "operationId": "getHelp",
        "summary": "Help page",
        "responses": {
          "308": {
            "description": "Redirects to external help center"
          }
        }
      }
    },
    "/start": {
      "get": {
        "operationId": "getServiceStartPage",
        "summary": "Service start page",
        "responses": {
          "200": {
            "description": "Returns the service start page"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TermsAndConditionsNewViewModel": {
        "type": "object",
        "properties": {
          "ReturnUrl": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          }
        },
        "required": [
          "ReturnUrl",
          "HashedAccountId"
        ]
      }
    },
    "securitySchemes": {
      "policyNames": {
        "type": "apiKey",
        "name": "PolicyNames",
        "in": "header"
      }
    }
  }
}
