      "get": {
        "summary": "Sign Out",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "SignOut Initiated"
