    "/privacy": {
      "get": {
        "summary": "Privacy View",
        "responses": {
          "200": {
            "description": "Privacy Page View",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/help": {
      "get": {
        "summary": "Help Redirect",
        "responses": {
          "301": {
            "description": "Permanent Redirect"
          }
        }
      }
    },
    "/start": {
      "get": {
        "summary": "Service Start Page",
        "responses": {
          "200": {
            "description": "Service Start Page View",
            "content": {
              "text/html": {}
            }
          }
        }
      }
