{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounthistories": {
      "get": {
        "operationId": "GetAccountHistoryByRef",
        "summary": "Retrieve account history by PAYE reference.",
        "parameters": [
          {
            "name": "payeRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account history retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountHistory"
                }
              }
            }
          },
          "404": {
            "description": "Account history not found."
          }
        },
        "security": [
          {
            "ApiRole_ReadAllEmployerAccountBalances": []
          }
        ],
        "tags": [
          "AccountHistories"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountHistory": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "string"
          },
          "AddedDate": {
            "type": "string",
            "format": "date-time"
          },
          "RemovedDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "AccountId",
          "AddedDate",
          "RemovedDate"
        ]
      }
    },
    "securitySchemes": {
      "ApiRole_ReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "API role required: ReadAllEmployerAccountBalances"
      }
    }
  }
}
