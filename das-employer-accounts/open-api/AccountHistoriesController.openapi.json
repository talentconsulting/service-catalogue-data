{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounthistories": {
      "get": {
        "summary": "Get Account History by PAYE Reference",
        "operationId": "GetAccountHistoryByRef",
        "parameters": [
          {
            "name": "payeRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The PAYE reference for which account history is requested."
          }
        ],
        "responses": {
          "200": {
            "description": "Account history retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountHistory"
                }
              }
            }
          },
          "404": {
            "description": "Account history not found."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountHistory": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "string",
            "nullable": true
          },
          "AddedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "RemovedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization policy requiring ReadAllEmployerAccountBalances role."
      }
    }
  }
}
