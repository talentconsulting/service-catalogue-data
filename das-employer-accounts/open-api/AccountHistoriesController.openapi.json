{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounthistories": {
      "get": {
        "summary": "Get account history by PAYE reference",
        "operationId": "GetAccountHistoryByRef",
        "parameters": [
          {
            "name": "payeRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with account history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountHistory"
                }
              }
            }
          },
          "404": {
            "description": "PAYE reference not found"
          }
        },
        "security": [
          {
            "ReadAllEmployerAccountBalances": []
          }
        ],
        "tags": [
          "AccountHistories"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountHistory": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int32"
          },
          "AddedDate": {
            "type": "string",
            "format": "date-time"
          },
          "RemovedDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "AccountId",
          "AddedDate",
          "RemovedDate"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization required with the 'ReadAllEmployerAccountBalances' role"
      }
    }
  }
}
