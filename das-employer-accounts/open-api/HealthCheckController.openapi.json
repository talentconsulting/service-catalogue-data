{
  "openapi": "3.1.0",
  "info": {
    "title": "HealthCheck API",
    "version": "1.0.0"
  },
  "paths": {
    "/healthcheck": {
      "get": {
        "summary": "Run health check query",
        "operationId": "GetHealthCheck",
        "responses": {
          "200": {
            "description": "Health check query response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Run health check command",
        "operationId": "RunHealthCheck",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunHealthCheckCommand"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to health check page"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RunHealthCheckCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "UserRef"
        ]
      },
      "HealthCheckViewModel": {
        "type": "object"
      }
    }
  }
}
