{
  "openapi": "3.1.0",
  "info": {
    "title": "HealthCheck API",
    "version": "1.0.0"
  },
  "paths": {
    "/healthcheck": {
      "get": {
        "operationId": "getHealthCheck",
        "summary": "Retrieve health check information",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Health check data successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "runHealthCheck",
        "summary": "Run health check operation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunHealthCheckCommand"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Health check operation executed successfully, redirecting to index"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RunHealthCheckCommand": {
        "type": "object",
        "required": [
          "UserRef"
        ],
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "HealthCheckViewModel": {
        "type": "object"
      }
    }
  }
}
