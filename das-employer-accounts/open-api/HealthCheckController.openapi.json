{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts HealthCheck API",
    "version": "1.0.0"
  },
  "paths": {
    "/healthcheck": {
      "get": {
        "operationId": "getHealthCheck",
        "summary": "Retrieve the health check status.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Health check status retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "runHealthCheck",
        "summary": "Run a health check.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunHealthCheckCommand"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the health check page after running the health check."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RunHealthCheckCommand": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Reference to the user initiating the health check."
          }
        },
        "required": [
          "UserRef"
        ]
      },
      "HealthCheckViewModel": {
        "type": "object",
        "description": "Placeholder for the health check response model."
      }
    }
  }
}
