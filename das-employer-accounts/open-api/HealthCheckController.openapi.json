{
  "openapi": "3.1.0",
  "info": {
    "title": "HealthCheckController API",
    "version": "1.0.0"
  },
  "paths": {
    "/healthcheck": {
      "get": {
        "operationId": "getHealthCheck",
        "summary": "Retrieve health check information.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response containing health check information.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "HealthCheckViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "runHealthCheck",
        "summary": "Trigger a new health check.",
        "requestBody": {
          "description": "Command to trigger a health check.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunHealthCheckCommand"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the health check index after execution."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RunHealthCheckCommand": {
        "type": "object",
        "required": [
          "UserRef"
        ],
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier of the user requesting the health check."
          }
        }
      }
    }
  }
}
