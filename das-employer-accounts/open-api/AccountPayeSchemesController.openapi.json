{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/payeschemes": {
      "get": {
        "operationId": "GetPayeSchemes",
        "summary": "Retrieve all PAYE schemes for a specific account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved PAYE schemes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceList"
                }
              }
            }
          },
          "404": {
            "description": "PAYE schemes not found for the account"
          }
        },
        "security": [
          {
            "Authorization": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{accountId}/payeschemes/scheme": {
      "get": {
        "operationId": "GetPayeScheme",
        "summary": "Retrieve a specific PAYE scheme for an account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "payeSchemeRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved PAYE scheme details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          },
          "404": {
            "description": "PAYE scheme not found"
          }
        },
        "security": [
          {
            "Authorization": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Href": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Allows reading all employer account balances"
            }
          }
        }
      }
    }
  }
}
