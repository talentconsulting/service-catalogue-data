{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/payeschemes": {
      "get": {
        "operationId": "GetPayeSchemes",
        "summary": "Get PAYE schemes for an account",
        "description": "Retrieves a list of PAYE schemes associated with a specified employer account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the employer account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing the list of PAYE schemes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceList"
                }
              }
            }
          },
          "404": {
            "description": "No PAYE schemes found for the specified account."
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{accountId}/payeschemes/scheme": {
      "get": {
        "operationId": "GetPayeScheme",
        "summary": "Get a specific PAYE scheme for an account",
        "description": "Retrieves details of a specific PAYE scheme associated with a specified employer account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the employer account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "payeSchemeRef",
            "in": "query",
            "required": true,
            "description": "The reference identifier of the PAYE scheme.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing the PAYE scheme details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "The PAYE scheme was not found for the specified account and reference."
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "The identifier of the resource."
          },
          "Href": {
            "type": "string",
            "description": "The URI of the resource."
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://your-auth-server/authorize",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Permission to read all employer account balances."
            }
          }
        }
      }
    }
  }
}
