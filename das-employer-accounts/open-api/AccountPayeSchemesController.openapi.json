{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/payeschemes": {
      "get": {
        "operationId": "GetPayeSchemes",
        "summary": "Retrieve PAYE schemes for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of PAYE schemes for the specified account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceList"
                }
              }
            }
          },
          "404": {
            "description": "No PAYE schemes were found for the specified account."
          }
        },
        "security": [
          {
            "ApiRolesAuthorization": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{accountId}/payeschemes/scheme": {
      "get": {
        "operationId": "GetPayeScheme",
        "summary": "Retrieve a specific PAYE scheme for an account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account."
          },
          {
            "name": "payeSchemeRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The reference for the PAYE scheme (URL-encoded)."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the specified PAYE scheme.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "The specified PAYE scheme was not found."
          }
        },
        "security": [
          {
            "ApiRolesAuthorization": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Href": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      }
    },
    "securitySchemes": {
      "ApiRolesAuthorization": {
        "type": "http",
        "scheme": "bearer",
        "description": "API roles-based authorization."
      }
    }
  }
}
