{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/payeschemes": {
      "get": {
        "operationId": "GetPayeSchemes",
        "summary": "Get PAYE schemes for an account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account"
          }
        ],
        "responses": {
          "200": {
            "description": "List of PAYE schemes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceList"
                }
              }
            }
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRolesReadAllEmployerAccountBalances": []
          }
        ],
        "tags": [
          "PAYE Schemes"
        ]
      }
    },
    "/api/accounts/{accountId}/payeschemes/scheme": {
      "get": {
        "operationId": "GetPayeScheme",
        "summary": "Get a specific PAYE scheme by reference",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account"
          },
          {
            "name": "payeSchemeRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The reference of the PAYE scheme"
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the requested PAYE scheme",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "PAYE scheme not found"
          }
        },
        "security": [
          {
            "ApiRolesReadAllEmployerAccountBalances": []
          }
        ],
        "tags": [
          "PAYE Schemes"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "href": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      }
    },
    "securitySchemes": {
      "ApiRolesReadAllEmployerAccountBalances": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
