{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing employer account PAYE schemes."
  },
  "paths": {
    "/api/accounts/{accountId}/payeschemes": {
      "get": {
        "summary": "Get PAYE schemes for an account",
        "operationId": "GetPayeSchemes",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the account to retrieve PAYE schemes for."
          }
        ],
        "responses": {
          "200": {
            "description": "List of PAYE schemes.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResourceList"
                }
              }
            }
          },
          "404": {
            "description": "No PAYE schemes found for the specified account."
          }
        },
        "security": [
          {
            "ApiRolesAuth": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{accountId}/payeschemes/scheme": {
      "get": {
        "summary": "Get details of a specific PAYE scheme",
        "operationId": "GetPayeScheme",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the account to retrieve the PAYE scheme for."
          },
          {
            "name": "payeSchemeRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Reference of the PAYE scheme to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the PAYE scheme.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resource"
                }
              }
            }
          },
          "404": {
            "description": "PAYE scheme not found for the specified account."
          }
        },
        "security": [
          {
            "ApiRolesAuth": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "ID of the resource."
          },
          "Href": {
            "type": "string",
            "description": "URL of the resource."
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        },
        "description": "A list of resource objects."
      }
    },
    "securitySchemes": {
      "ApiRolesAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Role-based authentication with API roles."
      }
    }
  }
}
