{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API - LegalEntities",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/legalentities": {
      "get": {
        "operationId": "GetLegalEntities",
        "summary": "Retrieve legal entities associated with an account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the account."
          },
          {
            "name": "includeDetails",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Whether to include detailed legal entity information."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of resources or detailed legal entities.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ResourceList"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LegalEntity"
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No legal entities found for the provided account ID."
          }
        }
      }
    },
    "/api/accounts/{accountId}/legalentities/{legalEntityId}": {
      "get": {
        "operationId": "GetLegalEntity",
        "summary": "Retrieve a specific legal entity by ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the account."
          },
          {
            "name": "legalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the legal entity."
          },
          {
            "name": "includeAllAgreements",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            },
            "description": "Whether to include all agreements for the legal entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Detailed information on the specified legal entity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalEntity"
                }
              }
            }
          },
          "404": {
            "description": "The specified legal entity was not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "The unique identifier for the resource."
          },
          "Href": {
            "type": "string",
            "description": "The hyperlink to the resource."
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      },
      "LegalEntity": {
        "type": "object",
        "description": "A representation of a legal entity."
      }
    }
  }
}
