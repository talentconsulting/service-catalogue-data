{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/legalentities": {
      "get": {
        "summary": "Get legal entities for an account",
        "operationId": "GetLegalEntities",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID."
          },
          {
            "name": "includeDetails",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Whether to include details of legal entities."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with legal entities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/LegalEntity"
                      },
                      {
                        "$ref": "#/components/schemas/ResourceList"
                      }
                    ]
                  }
                }
              }
            }
          },
          "404": {
            "description": "Legal entities not found"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/legalentities/{legalEntityId}": {
      "get": {
        "summary": "Get a specific legal entity by ID",
        "operationId": "GetLegalEntity",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID."
          },
          {
            "name": "legalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The legal entity ID."
          },
          {
            "name": "includeAllAgreements",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Whether to include all agreements for the legal entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with legal entity details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalEntity"
                }
              }
            }
          },
          "404": {
            "description": "Legal entity not found"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Href": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      },
      "LegalEntity": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization"
      }
    }
  }
}
