{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/legalentities": {
      "get": {
        "operationId": "GetLegalEntities",
        "summary": "Retrieve legal entities for a given account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "includeDetails",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of legal entities.",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ResourceList"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LegalEntity"
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No legal entities found or invalid request."
          }
        },
        "security": [
          {
            "ApiRoles": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/legalentities/{legalEntityId}": {
      "get": {
        "operationId": "GetLegalEntity",
        "summary": "Retrieve a specific legal entity for a given account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "legalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "includeAllAgreements",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the legal entity.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalEntity"
                }
              }
            }
          },
          "404": {
            "description": "Legal entity not found."
          }
        },
        "security": [
          {
            "ApiRoles": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Href": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      },
      "LegalEntity": {
        "type": "object",
        "description": "A placeholder for the legal entity object. Exact structure unknown from the source."
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
