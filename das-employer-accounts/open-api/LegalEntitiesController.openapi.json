{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts LegalEntities API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/legalentities": {
      "get": {
        "summary": "Get Legal Entities for an Account",
        "description": "Returns a list of legal entities associated with a specified account.",
        "operationId": "GetLegalEntities",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "includeDetails",
            "in": "query",
            "required": false,
            "description": "Indicates whether to include detailed information.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with legal entities information.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ResourceList"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LegalEntity"
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No legal entities were found for the specified account."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "tags": [
          "Legal Entities"
        ]
      }
    },
    "/api/accounts/{accountId}/legalentities/{legalEntityId}": {
      "get": {
        "summary": "Get a Specific Legal Entity",
        "description": "Returns detailed information about a specific legal entity associated with a specified account.",
        "operationId": "GetLegalEntity",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "legalEntityId",
            "in": "path",
            "required": true,
            "description": "The ID of the legal entity.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "includeAllAgreements",
            "in": "query",
            "required": false,
            "description": "Indicates whether to include all agreements for the legal entity.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with detailed legal entity information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalEntity"
                }
              }
            }
          },
          "404": {
            "description": "The specified legal entity was not found."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAccountBalances": []
          }
        ],
        "tags": [
          "Legal Entities"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "The unique identifier for the resource."
          },
          "Href": {
            "type": "string",
            "description": "The hyperlink to the resource."
          }
        },
        "required": [
          "Id",
          "Href"
        ]
      },
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      },
      "LegalEntity": {
        "type": "object",
        "description": "Represents a legal entity. The exact structure depends on internal mappings.",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
