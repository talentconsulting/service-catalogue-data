{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Legal Entities API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{accountId}/legalentities": {
      "get": {
        "operationId": "GetLegalEntities",
        "summary": "Retrieve legal entities associated with an account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the account for which legal entities are retrieved"
          },
          {
            "name": "includeDetails",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Flag to include detailed information about legal entities"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/ResourceList"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LegalEntity"
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "No legal entities found for the given account ID"
          }
        },
        "security": [
          {
            "ApiRoles": []
          }
        ],
        "tags": [
          "LegalEntities"
        ]
      }
    },
    "/api/accounts/{accountId}/legalentities/{legalEntityId}": {
      "get": {
        "operationId": "GetLegalEntity",
        "summary": "Retrieve a specific legal entity by ID",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the account to which the legal entity belongs"
          },
          {
            "name": "legalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The ID of the legal entity to retrieve"
          },
          {
            "name": "includeAllAgreements",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Flag to include all agreements associated with the legal entity"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LegalEntity"
                }
              }
            }
          },
          "404": {
            "description": "Specified legal entity not found"
          }
        },
        "security": [
          {
            "ApiRoles": []
          }
        ],
        "tags": [
          "LegalEntities"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ResourceList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Resource"
        }
      },
      "Resource": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "Identifier for the resource"
          },
          "Href": {
            "type": "string",
            "description": "URL of the resource"
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "LegalEntityId": {
            "type": "integer",
            "description": "Unique ID for the legal entity"
          },
          "Name": {
            "type": "string",
            "description": "Name of the legal entity"
          },
          "Code": {
            "type": "string",
            "description": "Code associated with the legal entity"
          },
          "Status": {
            "type": "string",
            "description": "Status of the legal entity"
          },
          "AgreementDetails": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            },
            "description": "Details of associated agreements"
          }
        },
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
