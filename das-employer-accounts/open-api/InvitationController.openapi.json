{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Invitations API",
    "version": "1.0.0"
  },
  "paths": {
    "/invitations/invite": {
      "get": {
        "tags": [
          "Invitations"
        ],
        "summary": "View the invite page",
        "responses": {
          "200": {
            "description": "Invite page displayed"
          },
          "302": {
            "description": "Redirect to Home Index page"
          }
        }
      }
    },
    "/invitations": {
      "get": {
        "tags": [
          "Invitations"
        ],
        "summary": "Get all invitations for a user",
        "security": [
          {
            "authorization": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of invitations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInvitationsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to Home Index page"
          }
        }
      }
    },
    "/invitations/view": {
      "get": {
        "tags": [
          "Invitations"
        ],
        "summary": "View details of a specific invitation",
        "security": [
          {
            "authorization": []
          }
        ],
        "parameters": [
          {
            "name": "invitationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationView"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to Home Index page"
          }
        }
      }
    },
    "/invitations/accept": {
      "post": {
        "tags": [
          "Invitations"
        ],
        "summary": "Accept an invitation",
        "security": [
          {
            "authorization": []
          }
        ],
        "parameters": [
          {
            "name": "invitation",
            "in": "formData",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInvitationsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation accepted"
          },
          "302": {
            "description": "Redirect to Home Index page"
          }
        }
      },
      "get": {
        "tags": [
          "Invitations"
        ],
        "summary": "Accept invitation for an existing user",
        "responses": {
          "302": {
            "description": "Redirect to Home Index page"
          }
        }
      }
    },
    "/invitations/create": {
      "post": {
        "tags": [
          "Invitations"
        ],
        "summary": "Create a new invitation",
        "security": [
          {
            "authorization": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation created"
          },
          "302": {
            "description": "Redirect to Home Index page"
          }
        }
      }
    },
    "/invitations/register-and-accept": {
      "get": {
        "tags": [
          "Invitations"
        ],
        "summary": "Accept invitation for a new user",
        "responses": {
          "302": {
            "description": "Redirect to Home Index page"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "UserInvitationsViewModel": {
        "type": "object",
        "properties": {
          "Invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvitationView"
            }
          },
          "ShowBreadCrumbs": {
            "type": "boolean"
          }
        }
      },
      "InvitationView": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          },
          "AccountId": {
            "type": "integer"
          },
          "AccountName": {
            "type": "string"
          },
          "ExpiryDate": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "$ref": "#/components/schemas/InvitationStatus"
          },
          "InternalUserId": {
            "type": "integer"
          },
          "ExternalUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      },
      "InvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Accepted",
          "Expired",
          "Deleted"
        ]
      }
    }
  }
}
