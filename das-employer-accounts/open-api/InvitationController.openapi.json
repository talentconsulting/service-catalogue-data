{
  "openapi": "3.1.0",
  "info": {
    "title": "Invitation API",
    "version": "1.0.0",
    "description": "API for handling team member invitations for employer accounts."
  },
  "paths": {
    "/invitations/invite": {
      "get": {
        "operationId": "InviteUser",
        "summary": "Invites a user.",
        "responses": {
          "200": {
            "description": "Invitation form view."
          },
          "302": {
            "description": "Redirects to home if the user is authenticated."
          }
        }
      }
    },
    "/invitations": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "operationId": "GetAllInvitations",
        "summary": "Gets all invitations for the authenticated user.",
        "responses": {
          "200": {
            "description": "Successful retrieval of all invitations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInvitationsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to home if the user is not authenticated."
          }
        }
      }
    },
    "/invitations/view": {
      "get": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "operationId": "GetInvitationDetails",
        "summary": "Gets details of a specific invitation.",
        "parameters": [
          {
            "name": "invitationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of invitation details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationView"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to home if the user is not authenticated."
          }
        }
      }
    },
    "/invitations/accept": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "operationId": "AcceptInvitation",
        "summary": "Accepts an invitation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "invitation": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "model": {
                    "$ref": "#/components/schemas/UserInvitationsViewModel"
                  }
                },
                "required": [
                  "invitation",
                  "model"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to home after successfully accepting the invitation."
          }
        }
      },
      "get": {
        "operationId": "AcceptInvitationExistingUser",
        "summary": "Handles invitation acceptance for an existing user.",
        "responses": {
          "302": {
            "description": "Redirects to home."
          }
        }
      }
    },
    "/invitations/create": {
      "post": {
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "operationId": "CreateInvitation",
        "summary": "Creates an invitation for a team member.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to home after successfully creating an invitation."
          }
        }
      }
    },
    "/invitations/register-and-accept": {
      "get": {
        "operationId": "AcceptInvitationNewUser",
        "summary": "Handles invitation acceptance for a new user.",
        "responses": {
          "302": {
            "description": "Redirects to home."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "Name",
          "Email",
          "Role"
        ]
      },
      "UserInvitationsViewModel": {
        "type": "object",
        "properties": {
          "Invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvitationView"
            }
          },
          "ShowBreadCrumbs": {
            "type": "boolean"
          }
        }
      },
      "InvitationView": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountName": {
            "type": "string"
          },
          "ExpiryDate": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "$ref": "#/components/schemas/InvitationStatus"
          }
        },
        "required": [
          "Id",
          "Name",
          "Email",
          "Role",
          "AccountId",
          "AccountName",
          "ExpiryDate",
          "Status"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ],
        "description": "Role assigned to the user."
      },
      "InvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Accepted",
          "Expired",
          "Deleted"
        ],
        "description": "Status of the invitation."
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
