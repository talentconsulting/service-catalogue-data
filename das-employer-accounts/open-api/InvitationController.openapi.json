{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Invitation API",
    "version": "1.0.0",
    "description": "API for managing employer accounts invitations."
  },
  "paths": {
    "/invitations/invite": {
      "get": {
        "description": "Displays the invitation page or redirects to the home page based on user authentication.",
        "responses": {
          "200": {
            "description": "Invitation page displayed."
          },
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    },
    "/invitations": {
      "get": {
        "security": [
          {
            "OAuth2": []
          }
        ],
        "description": "Gets all invitations for the authenticated user.",
        "responses": {
          "200": {
            "description": "List of invitations returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInvitationsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to the home page if authentication fails."
          }
        }
      }
    },
    "/invitations/view": {
      "get": {
        "security": [
          {
            "OAuth2": []
          }
        ],
        "description": "Gets details of a specific invitation.",
        "parameters": [
          {
            "name": "invitationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the invitation to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation details returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationView"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to the home page if authentication fails."
          }
        }
      }
    },
    "/invitations/accept": {
      "post": {
        "security": [
          {
            "OAuth2": []
          }
        ],
        "description": "Accepts an invitation for a specified user.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInvitationsViewModel"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "invitation",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the invitation to accept."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the home page after accepting the invitation."
          }
        }
      },
      "get": {
        "description": "Redirects existing users to accept an invitation.",
        "responses": {
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    },
    "/invitations/create": {
      "post": {
        "security": [
          {
            "OAuth2": []
          }
        ],
        "description": "Creates a new invitation for a team member.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the home page after creating the invitation."
          }
        }
      }
    },
    "/invitations/register-and-accept": {
      "get": {
        "description": "Redirects new users to accept an invitation.",
        "responses": {
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "type": "string",
            "enum": [
              "None",
              "Owner",
              "Transactor",
              "Viewer"
            ]
          }
        },
        "required": [
          "HashedAccountId",
          "Name",
          "Email",
          "Role"
        ]
      },
      "UserInvitationsViewModel": {
        "type": "object",
        "properties": {
          "Invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvitationView"
            }
          },
          "ShowBreadCrumbs": {
            "type": "boolean"
          }
        }
      },
      "InvitationView": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "type": "string",
            "enum": [
              "None",
              "Owner",
              "Transactor",
              "Viewer"
            ]
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountName": {
            "type": "string"
          },
          "ExpiryDate": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "string",
            "enum": [
              "Pending",
              "Accepted",
              "Expired",
              "Deleted"
            ]
          },
          "InternalUserId": {
            "type": "integer",
            "format": "int64"
          },
          "ExternalUserId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "Id",
          "Name",
          "Email",
          "Role",
          "AccountId",
          "AccountName",
          "ExpiryDate",
          "Status"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
