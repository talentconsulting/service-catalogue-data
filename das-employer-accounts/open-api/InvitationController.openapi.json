{
  "openapi": "3.1.0",
  "info": {
    "title": "Invitation API",
    "version": "1.0.0"
  },
  "paths": {
    "/invitations/invite": {
      "get": {
        "summary": "Redirect or display invitation view.",
        "operationId": "invite",
        "responses": {
          "200": {
            "description": "OK"
          },
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    },
    "/invitations/all": {
      "get": {
        "summary": "Get all invitations for current user.",
        "operationId": "getAllInvitations",
        "security": [
          {
            "authorization": []
          }
        ],
        "responses": {
          "200": {
            "description": "A list of invitations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserInvitationsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    },
    "/invitations/view": {
      "get": {
        "summary": "Get details for a specific invitation.",
        "operationId": "getInvitationDetails",
        "parameters": [
          {
            "name": "invitationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "authorization": []
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the invitation details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvitationView"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    },
    "/invitations/accept": {
      "post": {
        "summary": "Accept an invitation.",
        "operationId": "acceptInvitation",
        "parameters": [
          {
            "name": "invitation",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInvitationsViewModel"
              }
            }
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the home page."
          }
        }
      },
      "get": {
        "summary": "Redirects existing users to accept an invitation.",
        "operationId": "acceptInvitationExistingUser",
        "responses": {
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    },
    "/invitations/register-and-accept": {
      "get": {
        "summary": "Redirects new users to register and accept an invitation.",
        "operationId": "acceptInvitationNewUser",
        "responses": {
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    },
    "/invitations/create": {
      "post": {
        "summary": "Create a team member invitation.",
        "operationId": "createInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "security": [
          {
            "authorization": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the home page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "Name",
          "Email",
          "Role"
        ]
      },
      "UserInvitationsViewModel": {
        "type": "object",
        "properties": {
          "Invitations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvitationView"
            }
          },
          "ShowBreadCrumbs": {
            "type": "boolean"
          }
        }
      },
      "InvitationView": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountName": {
            "type": "string"
          },
          "ExpiryDate": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "$ref": "#/components/schemas/InvitationStatus"
          },
          "InternalUserId": {
            "type": "integer",
            "format": "int32"
          },
          "ExternalUserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      },
      "InvitationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Accepted",
          "Expired",
          "Deleted"
        ]
      }
    }
  }
}
