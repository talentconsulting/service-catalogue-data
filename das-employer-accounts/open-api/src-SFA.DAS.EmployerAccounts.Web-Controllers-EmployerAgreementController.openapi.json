{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreements API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/agreements": {
      "get": {
        "operationId": "EmployerAgreementIndex",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementSigned",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the list of agreements for the account"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/details": {
      "get": {
        "operationId": "GetAgreementDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns details for a specific agreement"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/view": {
      "get": {
        "operationId": "AgreementView",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the signed agreement view"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/unsigned/view": {
      "get": {
        "operationId": "ViewUnsignedAgreements",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Redirects to next unsigned agreement"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/about-your-agreement": {
      "get": {
        "operationId": "AboutYourAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isFromTasklist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provides information about the specific agreement"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign-your-agreement": {
      "get": {
        "operationId": "EmployerAgreementSignYourAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the sign agreement view"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign": {
      "post": {
        "operationId": "EmployerAgreementSign",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sign agreement successfully"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/agreement-pdf": {
      "get": {
        "operationId": "GetPdfAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns agreement document in PDF format"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/signed-agreement-pdf": {
      "get": {
        "operationId": "GetSignedPdfAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns signed agreement document in PDF format"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{accountLegalEntityHashedId}/remove": {
      "get": {
        "operationId": "ConfirmRemoveOrganisation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirm removal of organisation"
          }
        }
      },
      "post": {
        "operationId": "PostConfirmRemoveOrganisation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmOrganisationToRemoveViewModel"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Handles the removal request"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/whenDoYouWantToView": {
      "get": {
        "operationId": "WhenDoYouWantToView",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns view options for specific agreement"
          }
        }
      },
      "post": {
        "operationId": "PostWhenDoYouWantToView",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Handles the user's choice for agreement view time"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/{accountLegalEntityHashedId}/agreements": {
      "get": {
        "operationId": "OrganisationAgreements",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns all agreements for the organisation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmOrganisationToRemoveViewModel": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "HashedAccountLegalEntitytId": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "CanBeRemoved": {
            "type": "boolean"
          },
          "HasSignedAgreement": {
            "type": "boolean"
          },
          "Remove": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "Remove"
        ]
      },
      "WhenDoYouWantToViewViewModel": {
        "type": "object",
        "properties": {
          "EmployerAgreement": {
            "$ref": "#/components/schemas/EmployerAgreementView"
          },
          "InError": {
            "type": "boolean"
          }
        }
      },
      "EmployerAgreementView": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "AccountId": {
            "type": "integer"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "SignedByName": {
            "type": "string"
          },
          "SignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "ExpiredDate": {
            "type": "string",
            "format": "date-time"
          },
          "LegalEntityId": {
            "type": "integer"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "TemplateId": {
            "type": "integer"
          },
          "HashedAgreementId": {
            "type": "string"
          },
          "Acknowledged": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
