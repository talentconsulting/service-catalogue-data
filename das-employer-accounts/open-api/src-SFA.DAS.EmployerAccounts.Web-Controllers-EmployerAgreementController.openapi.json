{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreements API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/agreements": {
      "get": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "getEmployerAgreementIndex",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementSigned",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved agreements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/details": {
      "get": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "getAgreementDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved agreement details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/view": {
      "get": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "viewAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the signed agreement view",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/unsigned/view": {
      "get": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "viewUnsignedAgreements",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved unsigned agreements",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/about-your-agreement": {
      "get": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "aboutYourAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isFromTasklist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved agreement details for tasklist",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign-your-agreement": {
      "get": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "signYourAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved agreement signing view",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign": {
      "post": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "signAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully signed the agreement",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/agreement-pdf": {
      "get": {
        "tags": [
          "Employer Agreements"
        ],
        "operationId": "getAgreementPdf",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved agreement PDF",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{accountLegalEntityHashedId}/remove": {
      "get": {
        "tags": [
          "Legal Entity Agreements"
        ],
        "operationId": "confirmRemoveOrganisation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved confirmation details for removing an organisation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Legal Entity Agreements"
        ],
        "operationId": "postConfirmRemoveOrganisation",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmOrganisationToRemoveViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully removed organisation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmOrganisationToRemoveViewModel": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "HashedAccountLegalEntitytId": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "CanBeRemoved": {
            "type": "boolean"
          },
          "HasSignedAgreement": {
            "type": "boolean"
          },
          "Remove": {
            "type": "boolean"
          }
        },
        "required": [
          "Remove"
        ]
      }
    }
  }
}
