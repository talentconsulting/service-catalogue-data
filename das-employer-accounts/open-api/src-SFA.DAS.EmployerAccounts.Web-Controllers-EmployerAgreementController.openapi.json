{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing employer accounts and agreements."
  },
  "paths": {
    "/accounts/{hashedAccountId}/agreements": {
      "get": {
        "operationId": "getAgreements",
        "summary": "Retrieve agreements for an account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementSigned",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/details": {
      "get": {
        "operationId": "getAgreementDetails",
        "summary": "Retrieve details of a specific agreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/view": {
      "get": {
        "operationId": "viewAgreement",
        "summary": "View a signed agreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/unsigned/view": {
      "get": {
        "operationId": "viewUnsignedAgreements",
        "summary": "View unsigned agreements for an account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/about-your-agreement": {
      "get": {
        "operationId": "aboutYourAgreement",
        "summary": "View agreement details with a context",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isFromTasklist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign-your-agreement": {
      "get": {
        "operationId": "signYourAgreement",
        "summary": "Sign an agreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign": {
      "post": {
        "operationId": "signAgreement",
        "summary": "Confirm signing of an agreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                },
                "required": [
                  "choice"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/agreement-pdf": {
      "get": {
        "operationId": "getAgreementPdf",
        "summary": "Retrieve PDF of an agreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF file of an agreement",
            "content": {
              "application/pdf": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/signed-agreement-pdf": {
      "get": {
        "operationId": "getSignedAgreementPdf",
        "summary": "Retrieve PDF of a signed agreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF file of a signed agreement",
            "content": {
              "application/pdf": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{accountLegalEntityHashedId}/remove": {
      "post": {
        "operationId": "removeOrganisation",
        "summary": "Remove organisation from account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmOrganisationToRemoveViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/whenDoYouWantToView": {
      "get": {
        "operationId": "whenDoYouWantToViewAgreement",
        "summary": "Decide when to view the agreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      },
      "post": {
        "operationId": "postWhenDoYouWantToViewAgreement",
        "summary": "Post decision on agreement viewing",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                },
                "required": [
                  "choice"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/{accountLegalEntityHashedId}/agreements": {
      "get": {
        "operationId": "viewAllAgreementsForOrganisation",
        "summary": "View all agreements for an organisation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmOrganisationToRemoveViewModel": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "HashedAccountLegalEntitytId": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "CanBeRemoved": {
            "type": "boolean"
          },
          "HasSignedAgreement": {
            "type": "boolean"
          },
          "Remove": {
            "type": "boolean"
          }
        },
        "required": [
          "Name",
          "HashedAccountLegalEntitytId",
          "HashedAccountId",
          "CanBeRemoved",
          "HasSignedAgreement",
          "Remove"
        ]
      }
    }
  }
}
