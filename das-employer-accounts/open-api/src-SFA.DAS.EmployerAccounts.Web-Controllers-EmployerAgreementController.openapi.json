{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreements API",
    "version": "1.0.0",
    "description": "API for managing employer agreements in the DAS employer accounts system"
  },
  "paths": {
    "/accounts/{hashedAccountId}/agreements": {
      "get": {
        "summary": "Fetch all agreements for an account",
        "operationId": "getEmployerAgreements",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementSigned",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of agreements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/details": {
      "get": {
        "summary": "Fetch details of a specific agreement",
        "operationId": "getAgreementDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with agreement details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/view": {
      "get": {
        "summary": "View the signed version of an agreement",
        "operationId": "getSignedAgreementView",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with a view of the signed agreement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/unsigned/view": {
      "get": {
        "summary": "View next unsigned agreements",
        "operationId": "viewUnsignedAgreements",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the appropriate action based on whether there are unsigned agreements"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/about-your-agreement": {
      "get": {
        "summary": "View information about a specific agreement",
        "operationId": "getAboutYourAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "isFromTasklist",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with information about the agreement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign-your-agreement": {
      "get": {
        "summary": "Initiate signing process for an agreement",
        "operationId": "signYourAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response to start signing the agreement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/sign": {
      "post": {
        "summary": "Sign an agreement",
        "operationId": "signAgreement",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Choice to sign the agreement",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agreement signed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized to sign the agreement"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/agreement-pdf": {
      "get": {
        "summary": "Download the agreement as a PDF",
        "operationId": "downloadAgreementPdf",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF file stream of the agreement",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/signed-agreement-pdf": {
      "get": {
        "summary": "Download the signed agreement as a PDF",
        "operationId": "downloadSignedAgreementPdf",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "PDF file stream of the signed agreement",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{accountLegalEntityHashedId}/remove": {
      "post": {
        "summary": "Remove an organisation from agreements",
        "operationId": "removeOrganisation",
        "requestBody": {
          "description": "Details of the organisation to remove",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmOrganisationToRemoveViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Organisation removed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/agreements/{hashedAgreementId}/whenDoYouWantToView": {
      "get": {
        "summary": "Determine when to view an agreement",
        "operationId": "getWhenDoYouWantToView",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Information about when to view the agreement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit a choice about when to view an agreement",
        "operationId": "postWhenDoYouWantToView",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Choice about when to view",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the appropriate resource based on the choice"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/{accountLegalEntityHashedId}/agreements": {
      "get": {
        "summary": "View all agreements for an organisation",
        "operationId": "viewAllAgreements",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with all agreements for the organisation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrchestratorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrchestratorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code of the response"
          },
          "exception": {
            "type": "object",
            "description": "Error details if any"
          },
          "flashMessage": {
            "$ref": "#/components/schemas/FlashMessageViewModel"
          },
          "redirectUrl": {
            "type": "string",
            "description": "Redirect URL if applicable"
          },
          "redirectButtonMessage": {
            "type": "string",
            "description": "Message for redirect button"
          },
          "data": {
            "type": "object",
            "description": "Response data payload",
            "nullable": true
          }
        }
      },
      "FlashMessageViewModel": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "subMessage": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "Complete",
              "Success",
              "Error",
              "Danger",
              "Info",
              "Warning",
              "Okay"
            ]
          },
          "severityCssClass": {
            "type": "string"
          },
          "errorMessages": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "redirectButtonMessage": {
            "type": "string"
          },
          "hiddenFlashMessageInformation": {
            "type": "string"
          }
        }
      },
      "ConfirmOrganisationToRemoveViewModel": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "hashedAccountLegalEntitytId": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "canBeRemoved": {
            "type": "boolean"
          },
          "hasSignedAgreement": {
            "type": "boolean"
          },
          "remove": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    }
  }
}
