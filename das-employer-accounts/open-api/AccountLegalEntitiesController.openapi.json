{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accountlegalentities": {
      "get": {
        "summary": "Get account legal entities",
        "operationId": "getAccountLegalEntities",
        "parameters": [
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedApiResponse_AccountLegalEntity"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    },
    "/api/accountlegalentities/GetAll": {
      "post": {
        "summary": "Get all legal entities by account ID",
        "operationId": "getAllLegalEntities",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetAllLegalEntitiesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllAccountLegalEntitiesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    }
  },
