{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing Employer Accounts, including their associated legal entities."
  },
  "paths": {
    "/api/accountlegalentities": {
      "get": {
        "summary": "Get Account Legal Entities",
        "operationId": "GetAccountLegalEntities",
        "parameters": [
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": true,
            "description": "Number of items per page",
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000,
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Legal entities retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAccountLegalEntitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accountlegalentities/GetAll": {
      "post": {
        "summary": "Get All Legal Entities by Account IDs",
        "operationId": "GetAllLegalEntities",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetAllLegalEntitiesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Legal entities retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllAccountLegalEntitiesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAccountLegalEntitiesQuery": {
        "type": "object",
        "properties": {
          "PageNumber": {
            "type": "integer",
            "minimum": 1,
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "minimum": 100,
            "maximum": 10000,
            "default": 1000
          }
        },
        "required": [
          "PageNumber",
          "PageSize"
        ]
      },
      "GetAccountLegalEntitiesResponse": {
        "type": "object",
        "properties": {
          "AccountLegalEntities": {
            "$ref": "#/components/schemas/PagedApiResponse"
          }
        },
        "required": [
          "AccountLegalEntities"
        ]
      },
      "GetAllLegalEntitiesRequest": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "SearchTerm": {
            "type": "string"
          },
          "PageNumber": {
            "type": "integer",
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "default": 10
          },
          "SortColumn": {
            "type": "string"
          },
          "IsAscending": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "AccountIds"
        ]
      },
      "GetAllAccountLegalEntitiesResponse": {
        "type": "object",
        "properties": {
          "PageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          }
        },
        "required": [
          "PageInfo",
          "LegalEntities"
        ]
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "TotalCount": {
            "type": "integer",
            "format": "int32"
          },
          "PageIndex": {
            "type": "integer",
            "format": "int32"
          },
          "PageSize": {
            "type": "integer",
            "format": "int32"
          },
          "TotalPages": {
            "type": "integer",
            "format": "int32"
          },
          "HasPreviousPage": {
            "type": "boolean"
          },
          "HasNextPage": {
            "type": "boolean"
          }
        },
        "required": [
          "TotalCount",
          "PageIndex",
          "PageSize",
          "TotalPages",
          "HasPreviousPage",
          "HasNextPage"
        ]
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "Agreements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agreement"
            }
          },
          "Code": {
            "type": "string"
          },
          "DasAccountId": {
            "type": "string"
          },
          "DateOfInception": {
            "type": "string",
            "format": "date-time"
          },
          "Address": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "PublicSectorDataSource": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "Source": {
            "type": "string"
          },
          "SourceNumeric": {
            "type": "integer",
            "format": "int16"
          },
          "Status": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          }
        }
      },
      "Agreement": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "SignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "SignedByName": {
            "type": "string"
          },
          "SignedById": {
            "type": "integer",
            "format": "int64"
          },
          "SignedByEmail": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/EmployerAgreementStatus"
          },
          "TemplateVersionNumber": {
            "type": "integer"
          },
          "AgreementType": {
            "$ref": "#/components/schemas/AgreementType"
          }
        }
      },
      "EmployerAgreementStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Signed",
          "Expired",
          "Superseded",
          "Removed"
        ]
      },
      "AgreementType": {
        "type": "string",
        "enum": [
          "Levy",
          "Combined",
          "Unknown"
        ]
      },
      "PagedApiResponse": {
        "type": "object",
        "properties": {
          "Data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          },
          "Page": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          }
        },
        "required": [
          "Data",
          "Page",
          "TotalPages"
        ]
      }
    }
  }
}
