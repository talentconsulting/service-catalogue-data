{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accountlegalentities": {
      "get": {
        "summary": "Retrieve Account Legal Entities",
        "parameters": [
          {
            "name": "PageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 100,
              "maximum": 10000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of account legal entities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/accountlegalentities/GetAll": {
      "post": {
        "summary": "Retrieve All Legal Entities",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetAllLegalEntitiesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "All account legal entities with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllAccountLegalEntitiesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PagedApiResponse": {
        "type": "object",
        "properties": {
          "Data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountLegalEntity"
            }
          },
          "Page": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          }
        }
      },
      "GetAllLegalEntitiesRequest": {
        "type": "object",
        "required": [
          "AccountIds"
        ],
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "SearchTerm": {
            "type": "string",
            "default": ""
          },
          "PageNumber": {
            "type": "integer",
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "default": 10
          },
          "SortColumn": {
            "type": "string",
            "default": "Name"
          },
          "IsAscending": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "GetAllAccountLegalEntitiesResponse": {
        "type": "object",
        "properties": {
          "PageInfo": {
            "$ref": "#/components/schemas/PageInfo"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "TotalCount": {
            "type": "integer"
          },
          "PageIndex": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "HasPreviousPage": {
            "type": "boolean"
          },
          "HasNextPage": {
            "type": "boolean"
          }
        }
      },
      "AccountLegalEntity": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "Agreements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Agreement"
            }
          },
          "Code": {
            "type": "string"
          },
          "DasAccountId": {
            "type": "string"
          },
          "DateOfInception": {
            "type": "string",
            "format": "date-time"
          },
          "Address": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "PublicSectorDataSource": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "Source": {
            "type": "string"
          },
          "SourceNumeric": {
            "type": "integer"
          },
          "Status": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "AgreementSignedByName": {
            "type": "string"
          },
          "AgreementSignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "AgreementStatus": {
            "$ref": "#/components/schemas/EmployerAgreementStatus"
          }
        }
      },
      "Agreement": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "SignedDate": {
            "type": "string",
            "format": "date-time"
          },
          "SignedByName": {
            "type": "string"
          },
          "SignedById": {
            "type": "integer",
            "format": "int64"
          },
          "SignedByEmail": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/EmployerAgreementStatus"
          },
          "TemplateVersionNumber": {
            "type": "integer"
          },
          "AgreementType": {
            "type": "string"
          }
        }
      },
      "EmployerAgreementStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Signed",
          "Expired",
          "Superseded",
          "Removed"
        ]
      }
    }
  }
}
