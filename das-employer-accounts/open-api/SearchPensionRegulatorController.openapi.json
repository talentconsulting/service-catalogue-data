{
  "openapi": "3.1.0",
  "info": {
    "title": "SearchPensionRegulator API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/pensionregulator": {
      "get": {
        "summary": "Search Pension Regulator",
        "operationId": "searchPensionRegulator",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Process outcome based on data availability."
          }
        }
      },
      "post": {
        "summary": "Submit Pension Regulator Search Results",
        "operationId": "submitSearchPensionRegulatorResults",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorResultsViewModel"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Redirect or return view based on selected organization."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/pensionregulator/aorn": {
      "get": {
        "summary": "Search Pension Regulator By AORN",
        "operationId": "searchPensionRegulatorByAORN",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "payeRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aorn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Generate view based on AORN search input."
          }
        }
      },
      "post": {
        "summary": "Perform AORN-based Pension Regulator Search",
        "operationId": "performSearchPensionRegulatorByAORN",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorByAornViewModel"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Perform AORN-based search and return the outcome."
          }
        }
      }
    },
    "/accounts/pensionregulator": {
      "get": {
        "summary": "Search Pension Regulator for a new account",
        "operationId": "searchPensionRegulatorNewAccount",
        "responses": {
          "default": {
            "description": "Process outcome based on availability of data."
          }
        }
      },
      "post": {
        "summary": "Submit Pension Regulator Search Results for a new account",
        "operationId": "submitSearchPensionRegulatorNewAccountResults",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorResultsViewModel"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Redirect or return view based on selected organization."
          }
        }
      }
    },
    "/accounts/pensionregulator/aorn": {
      "get": {
        "summary": "Search Pension Regulator by AORN for a new account",
        "operationId": "searchPensionRegulatorByAORNNewAccount",
        "parameters": [
          {
            "name": "payeRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aorn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": "Generate view based on AORN search input."
          }
        }
      },
      "post": {
        "summary": "Perform AORN-based Pension Regulator Search for a new account",
        "operationId": "performSearchPensionRegulatorByAORNNewAccount",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorByAornViewModel"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Process search and return the outcome."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchPensionRegulatorByAornViewModel": {
        "type": "object",
        "properties": {
          "Aorn": {
            "type": "string"
          },
          "PayeRef": {
            "type": "string"
          },
          "RemainingAttempts": {
            "type": "integer",
            "format": "int32"
          },
          "AllowedAttempts": {
            "type": "integer",
            "format": "int32"
          },
          "RemainingLock": {
            "type": "integer",
            "format": "int32"
          },
          "IsLocked": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "SearchPensionRegulatorResultsViewModel": {
        "type": "object",
        "properties": {
          "PayeRef": {
            "type": "string"
          },
          "Aorn": {
            "type": "string"
          },
          "Results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PensionRegulatorDetailsViewModel"
            }
          },
          "IsExistingAccount": {
            "type": "boolean"
          },
          "SelectedOrganisation": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PensionRegulatorDetailsViewModel": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Address": {
            "type": "string"
          },
          "ReferenceNumber": {
            "type": "integer",
            "format": "int64"
          },
          "Status": {
            "type": "string"
          },
          "Type": {
            "$ref": "#/components/schemas/OrganisationType"
          }
        },
        "additionalProperties": false
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
