{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Pension Regulator API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/pensionregulator": {
      "get": {
        "operationId": "GetSearchPensionRegulator",
        "summary": "Search Pension Regulator",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Pension regulator search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPensionRegulatorResultsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostSearchPensionRegulator",
        "summary": "Submit Search Pension Regulator",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorResultsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful submission of pension regulator organisation data for a specific account."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    },
    "/accounts/pensionregulator": {
      "get": {
        "operationId": "GetSearchPensionRegulatorWithoutAccountId",
        "summary": "Search Pension Regulator without Account ID",
        "responses": {
          "200": {
            "description": "Pension regulator search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPensionRegulatorResultsViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostSearchPensionRegulatorWithoutAccountId",
        "summary": "Submit Search Pension Regulator without Account ID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorResultsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful submission of pension regulator organisation data without specific account."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/pensionregulator/aorn": {
      "get": {
        "operationId": "GetSearchPensionRegulatorByAorn",
        "summary": "Search Pension Regulator by AORN",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account ID"
          },
          {
            "name": "payeRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "PAYE reference"
          },
          {
            "name": "aorn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Accounts Office Reference Number (AORN)"
          }
        ],
        "responses": {
          "200": {
            "description": "Pension regulator AORN search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPensionRegulatorByAornViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostSearchPensionRegulatorByAorn",
        "summary": "Submit Search Pension Regulator by AORN",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorByAornViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful submission of pension regulator AORN organisation data."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    },
    "/accounts/pensionregulator/aorn": {
      "get": {
        "operationId": "GetSearchPensionRegulatorByAornWithoutAccountId",
        "summary": "Search Pension Regulator by AORN without Account ID",
        "parameters": [
          {
            "name": "payeRef",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "PAYE reference"
          },
          {
            "name": "aorn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Accounts Office Reference Number (AORN)"
          }
        ],
        "responses": {
          "200": {
            "description": "Pension regulator AORN search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchPensionRegulatorByAornViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "PostSearchPensionRegulatorByAornWithoutAccountId",
        "summary": "Submit Search Pension Regulator by AORN without Account ID",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchPensionRegulatorByAornViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful submission of pension regulator AORN organisation data without specific account."
          },
          "400": {
            "description": "Validation error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchPensionRegulatorByAornViewModel": {
        "type": "object",
        "properties": {
          "Aorn": {
            "type": "string",
            "description": "Accounts Office Reference Number (AORN)."
          },
          "PayeRef": {
            "type": "string",
            "description": "PAYE reference."
          },
          "RemainingAttempts": {
            "type": "integer",
            "description": "Remaining attempts for AORN validation."
          },
          "AllowedAttempts": {
            "type": "integer",
            "description": "Total allowed attempts."
          },
          "RemainingLock": {
            "type": "integer",
            "description": "Remaining lock time in seconds."
          },
          "IsLocked": {
            "type": "boolean",
            "description": "Indicates if the account is locked."
          },
          "AornError": {
            "type": "string",
            "description": "Error message for AORN validation."
          },
          "PayeRefError": {
            "type": "string",
            "description": "Error message for PAYE reference validation."
          }
        }
      },
      "SearchPensionRegulatorResultsViewModel": {
        "type": "object",
        "properties": {
          "PayeRef": {
            "type": "string",
            "description": "PAYE reference."
          },
          "Aorn": {
            "type": "string",
            "description": "Accounts Office Reference Number (AORN)."
          },
          "Results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PensionRegulatorDetailsViewModel"
            },
            "description": "List of organisation results."
          },
          "IsExistingAccount": {
            "type": "boolean",
            "description": "Flag indicating if the account already exists."
          },
          "SelectedOrganisation": {
            "type": "integer",
            "nullable": true,
            "description": "Selected organisation identifier."
          }
        }
      },
      "PensionRegulatorDetailsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string",
            "description": "Hashed identifier for the organisation."
          },
          "Name": {
            "type": "string",
            "description": "Name of the organisation."
          },
          "Type": {
            "$ref": "#/components/schemas/OrganisationType",
            "description": "Type of the organisation."
          },
          "Address": {
            "$ref": "#/components/schemas/OrganisationAddress",
            "description": "Address of the organisation."
          },
          "ReferenceNumber": {
            "type": "integer",
            "description": "Reference number of the organisation."
          },
          "Status": {
            "type": "string",
            "description": "Status of the organisation."
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ],
        "description": "Represents the type of an organisation."
      },
      "OrganisationAddress": {
        "type": "object",
        "properties": {
          "Line1": {
            "type": "string",
            "description": "Address Line 1."
          },
          "Line2": {
            "type": "string",
            "description": "Address Line 2."
          },
          "Line3": {
            "type": "string",
            "description": "Address Line 3."
          },
          "Line4": {
            "type": "string",
            "description": "Address Line 4."
          },
          "Line5": {
            "type": "string",
            "description": "Address Line 5."
          },
          "Postcode": {
            "type": "string",
            "description": "Postcode of the address."
          }
        }
      }
    }
  }
}
