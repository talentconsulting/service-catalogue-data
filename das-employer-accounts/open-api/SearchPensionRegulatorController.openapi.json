          "PayeRef": {
            "type": "string"
          },
          "Aorn": {
            "type": "string"
          },
          "Results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PensionRegulatorDetailsViewModel"
            }
          },
          "IsExistingAccount": {
            "type": "boolean"
          },
          "SelectedOrganisation": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "PensionRegulatorDetailsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string"
          },
          "Type": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "Name": {
            "type": "string"
          },
          "Address": {
            "$ref": "#/components/schemas/Address"
          },
          "ReferenceNumber": {
            "type": "integer"
          },
          "Status": {
            "type": "string"
          }
        }
      },
