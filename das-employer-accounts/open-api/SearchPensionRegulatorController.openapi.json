          "payeRef": {
            "type": "string"
          },
          "aorn": {
            "type": "string"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PensionRegulatorDetailsViewModel"
            }
          },
          "isExistingAccount": {
            "type": "boolean"
          },
          "selectedOrganisation": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "PensionRegulatorDetailsViewModel": {
        "type": "object",
        "properties": {
          "hashedId": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "referenceNumber": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "SearchPensionRegulatorByAornViewModel": {
        "type": "object",
        "properties": {
          "aorn": {
            "type": "string"
          },
          "payeRef": {
            "type": "string"
          },
          "remainingAttempts": {
            "type": "integer"
          },
          "allowedAttempts": {
            "type": "integer"
          },
          "remainingLock": {
            "type": "integer"
          },
          "isLocked": {
            "type": "boolean"
          },
          "aornError": {
            "type": "string"
          },
          "payeRefError": {
            "type": "string"
          }
        }
      },
