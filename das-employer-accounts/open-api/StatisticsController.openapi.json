{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Statistics API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/statistics": {
      "get": {
        "summary": "Retrieve statistics",
        "operationId": "getStatistics",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "ApiRolesPolicy": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Statistics": {
        "type": "object",
        "description": "Representation of statistics data",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRolesPolicy": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization required with policy 'ReadUserAccounts'"
      }
    }
  }
}
