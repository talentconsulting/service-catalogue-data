{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/statistics": {
      "get": {
        "summary": "Get account statistics",
        "operationId": "GetStatistics",
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Statistics": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRolesReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Requires the ReadUserAccounts policy for authorization."
      }
    }
  }
}
