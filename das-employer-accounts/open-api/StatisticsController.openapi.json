{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/statistics": {
      "get": {
        "summary": "Get statistics",
        "operationId": "GetStatistics",
        "description": "Retrieves statistical information.",
        "responses": {
          "200": {
            "description": "Successful response containing statistics.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Statistics": {
        "type": "object",
        "description": "Represents statistical data.",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token with ReadUserAccounts role."
      }
    }
  }
}
