{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/statistics": {
      "get": {
        "operationId": "getStatistics",
        "summary": "Retrieve platform statistics",
        "responses": {
          "200": {
            "description": "Statistics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Statistics"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Statistics": {
        "type": "object",
        "description": "Represents platform statistical data",
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/oauth2/authorize",
            "scopes": {
              "ApiRoles.ReadUserAccounts": "Access to read statistics."
            }
          }
        }
      }
    }
  }
}
