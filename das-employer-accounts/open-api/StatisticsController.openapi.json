{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/statistics": {
      "get": {
        "summary": "Fetch statistics",
        "operationId": "GetStatistics",
        "responses": {
          "200": {
            "description": "Statistics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStatisticsResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetStatisticsResponse": {
        "type": "object",
        "properties": {
          "statistics": {
            "type": "object",
            "description": "Statistics data",
            "additionalProperties": true
          }
        },
        "required": [
          "statistics"
        ]
      }
    },
    "securitySchemes": {
      "ApiRolesReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Authorization header for API Roles with ReadUserAccounts policy."
      }
    }
  }
}
