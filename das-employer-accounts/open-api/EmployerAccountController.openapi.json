{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerAccounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/create/tasklist": {
      "get": {
        "operationId": "CreateAccountTaskList",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/tasklist": {
      "get": {
        "operationId": "ContinueCreateAccountTaskList",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/create/progress-saved": {
      "get": {
        "operationId": "CreateAccountProgressSaved",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress saved page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/progress-saved": {
      "get": {
        "operationId": "PartialAccountProgressSaved",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress saved page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/cannotAddPaye": {
      "get": {
        "operationId": "AddPayeShutter",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cannot add PAYE page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/payBill": {
      "get": {
        "operationId": "PayBillTriageGet",
        "responses": {
          "200": {
            "description": "Pay bill triage page",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "PayBillTriagePost",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirect based on user's choice",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/getApprenticeshipFunding": {
      "get": {
        "operationId": "GetApprenticeshipFundingInAccount",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get apprenticeship funding page",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "PostApprenticeshipFundingInAccount",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Redirect based on user's choice",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountProgressSavedViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "ContinueTaskListRouteName": {
            "type": "string"
          }
        }
      },
      "RenameEmployerAccountViewModel": {
        "type": "object",
        "properties": {
          "CurrentName": {
            "type": "string"
          },
          "NewName": {
            "type": "string"
          },
          "ChangeAccountName": {
            "type": "boolean"
          },
          "NameConfirmed": {
            "type": "boolean"
          }
        }
      },
      "SummaryViewModel": {
        "type": "object",
        "properties": {
          "OrganisationType": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "PublicSectorDataSource": {
            "type": "integer",
            "nullable": true
          },
          "OrganisationName": {
            "type": "string"
          },
          "OrganisationReferenceNumber": {
            "type": "string"
          },
          "OrganisationDateOfInception": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "RegisteredAddress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "PayeReference": {
            "type": "string"
          },
          "EmpRefNotFound": {
            "type": "boolean"
          },
          "OrganisationStatus": {
            "type": "string"
          },
          "EmployerRefName": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "NewSearch": {
            "type": "boolean"
          },
          "AORN": {
            "type": "string"
          },
          "IsOrganisationWithCorrectAddress": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
