{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/create/tasklist": {
      "get": {
        "summary": "Create Account Task List",
        "tags": [
          "EmployerAccount"
        ],
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/tasklist": {
      "get": {
        "summary": "Continue New Employer Account Task List",
        "tags": [
          "EmployerAccount"
        ],
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/create/progress-saved": {
      "get": {
        "summary": "Create Account Progress Saved",
        "tags": [
          "EmployerAccount"
        ],
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAccountProgressSavedViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/progress-saved": {
      "get": {
        "summary": "Partial Account Progress Saved",
        "tags": [
          "EmployerAccount"
        ],
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAccountProgressSavedViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/cannotAddPaye": {
      "get": {
        "summary": "Add PAYE Shutter",
        "tags": [
          "EmployerAccount"
        ],
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountProgressSavedViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "ContinueTaskListRouteName": {
            "type": "string"
          }
        }
      },
      "RenameEmployerAccountViewModel": {
        "type": "object",
        "properties": {
          "CurrentName": {
            "type": "string"
          },
          "NewName": {
            "type": "string"
          },
          "ChangeAccountName": {
            "type": "boolean",
            "nullable": true
          },
          "NewNameError": {
            "type": "string",
            "nullable": true
          },
          "LegalEntityName": {
            "type": "string"
          },
          "NameConfirmed": {
            "type": "boolean"
          }
        }
      },
      "SummaryViewModel": {
        "type": "object",
        "properties": {
          "OrganisationType": {
            "type": "integer",
            "format": "int16"
          },
          "PublicSectorDataSource": {
            "type": "integer",
            "format": "int16",
            "nullable": true
          },
          "OrganisationName": {
            "type": "string"
          },
          "OrganisationReferenceNumber": {
            "type": "string"
          },
          "OrganisationDateOfInception": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "RegisteredAddress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "PayeReference": {
            "type": "string"
          },
          "EmpRefNotFound": {
            "type": "boolean"
          },
          "OrganisationStatus": {
            "type": "string"
          },
          "EmployerRefName": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "NewSearch": {
            "type": "boolean"
          },
          "AORN": {
            "type": "string"
          },
          "IsOrganisationWithCorrectAddress": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "PolicyNames.HasEmployerViewerTransactorOwnerAccount": {
        "type": "http",
        "scheme": "bearer",
        "description": "Policy-based authorization for users with employer viewer, transactor, or owner account access."
      },
      "PolicyNames.HasUserAccount": {
        "type": "http",
        "scheme": "bearer",
        "description": "Policy-based authorization for users with general account access."
      }
    }
  }
}
