{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/create/tasklist": {
      "get": {
        "operationId": "CreateAccountTaskList",
        "summary": "Get the task list for creating an employer account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The task list for creating an employer account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAccountProgressSavedViewModel"
                }
              }
            }
          },
          "303": {
            "description": "Redirect to the employer team index if the task list is complete."
          }
        },
        "security": [
          {
            "oauth2": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/accounts/create/progress-saved": {
      "get": {
        "operationId": "CreateAccountProgressSaved",
        "summary": "Progress saved view when creating an employer account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The progress saved view."
          }
        },
        "security": [
          {
            "oauth2": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/cannotAddPaye": {
      "get": {
        "operationId": "AddPayeShutter",
        "summary": "View for users who cannot add PAYE.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The cannot add PAYE view."
          }
        },
        "security": [
          {
            "oauth2": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/accounts/payBill": {
      "get": {
        "operationId": "PayBillTriage",
        "summary": "View for paying the bill triage.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pay bill triage view."
          },
          "303": {
            "description": "Redirect to the Add PAYE Shutter view."
          }
        },
        "security": [
          {
            "oauth2": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      },
      "post": {
        "operationId": "PayBillTriagePost",
        "summary": "Post triage selection when paying the bill.",
        "requestBody": {
          "description": "User's choice for paying the bill.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "integer"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect to appropriate action based on user's choice."
          },
          "400": {
            "description": "Error in the user's selection data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "InError": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/getApprenticeshipFunding": {
      "get": {
        "operationId": "GetApprenticeshipFunding",
        "summary": "View for getting apprenticeship funding.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The apprenticeship funding view."
          }
        },
        "security": [
          {
            "oauth2": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      },
      "post": {
        "operationId": "PostGetApprenticeshipFunding",
        "summary": "Post user's funding choice.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "User's funding choice.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "integer"
              }
            }
          }
        },
        "responses": {
          "303": {
            "description": "Redirect to appropriate action based on the user's funding choice."
          },
          "400": {
            "description": "Error in the user's funding choice.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "InError": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [
              "HasEmployerViewerTransactorOwnerAccount"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountProgressSavedViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "ContinueTaskListRouteName": {
            "type": "string"
          }
        }
      },
      "RenameEmployerAccountViewModel": {
        "type": "object",
        "properties": {
          "CurrentName": {
            "type": "string"
          },
          "NewName": {
            "type": "string"
          },
          "ChangeAccountName": {
            "type": "boolean"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "NameConfirmed": {
            "type": "boolean"
          }
        }
      },
      "SummaryViewModel": {
        "type": "object",
        "properties": {
          "OrganisationType": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "PublicSectorDataSource": {
            "type": "integer"
          },
          "OrganisationName": {
            "type": "string"
          },
          "OrganisationReferenceNumber": {
            "type": "string"
          },
          "OrganisationDateOfInception": {
            "type": "string",
            "format": "date"
          },
          "RegisteredAddress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "PayeReference": {
            "type": "string"
          },
          "EmpRefNotFound": {
            "type": "boolean"
          },
          "OrganisationStatus": {
            "type": "string"
          },
          "EmployerRefName": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "NewSearch": {
            "type": "boolean"
          },
          "AORN": {
            "type": "string"
          },
          "IsOrganisationWithCorrectAddress": {
            "type": "boolean"
          }
        }
      },
      "OrganisationType": {
        "type": "integer",
        "enum": [
          1,
          2,
          3,
          4,
          5
        ]
      }
    }
  }
}
