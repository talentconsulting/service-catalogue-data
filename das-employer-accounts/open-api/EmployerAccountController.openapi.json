  "components": {
    "schemas": {
      "SummaryViewModel": {
        "type": "object",
        "properties": {
          "OrganisationType": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ],
            "description": "Organisation type as defined in OrganisationType."
          },
          "PublicSectorDataSource": {
            "type": "integer",
            "nullable": true
          },
          "OrganisationName": {
            "type": "string"
          },
          "OrganisationReferenceNumber": {
            "type": "string"
          },
          "OrganisationDateOfInception": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "RegisteredAddress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "PayeReference": {
            "type": "string"
          },
          "EmpRefNotFound": {
            "type": "boolean"
          },
          "OrganisationStatus": {
            "type": "string"
          },
          "EmployerRefName": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "NewSearch": {
            "type": "boolean"
          },
          "AORN": {
            "type": "string"
          },
          "IsOrganisationWithCorrectAddress": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
