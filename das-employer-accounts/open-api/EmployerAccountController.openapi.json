{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Account API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/create/tasklist": {
      "get": {
        "operationId": "createAccountTaskList",
        "description": "Starts the creation of a new employer account task list.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list view for creating account."
          },
          "302": {
            "description": "Redirects to Employer Team Index after task list completion."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/tasklist": {
      "get": {
        "operationId": "continueAccountTaskList",
        "description": "Continues the creation of an employer account's task list.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task list view for continuing account creation."
          },
          "302": {
            "description": "Redirects to Employer Team Index after task list completion."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/create/progress-saved": {
      "get": {
        "operationId": "createAccountProgressSaved",
        "description": "Displays saved progress for account creation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved progress view."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/progress-saved": {
      "get": {
        "operationId": "partialAccountProgressSaved",
        "description": "Displays saved progress for account creation for a specific account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Saved progress view for the specific hashedAccountId."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/cannotAddPaye": {
      "get": {
        "operationId": "addPayeShutter",
        "description": "Displays the shutter page when PAYE cannot be added.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Shutter view when PAYE cannot be added."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/payBill": {
      "get": {
        "operationId": "payBillTriageGet",
        "description": "Displays the pay bill triage screen.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pay bill triage view."
          },
          "302": {
            "description": "Redirects to the shutter page when hashedAccountId is provided."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "payBillTriagePost",
        "description": "Handles selection on the pay bill triage screen.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Handles the user's triage selection."
          },
          "302": {
            "description": "Redirects based on the submitted choice."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/getApprenticeshipFunding": {
      "get": {
        "operationId": "getApprenticeshipFundingInAccountGet",
        "description": "Displays apprenticeship funding options for a specific account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship funding view for the specific hashedAccountId."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "getApprenticeshipFundingInAccountPost",
        "description": "Handles selection on apprenticeship funding options for a specific account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Handles the user's apprenticeship funding selection."
          },
          "302": {
            "description": "Redirects based on the submitted choice."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/getApprenticeshipFunding": {
      "get": {
        "operationId": "getApprenticeshipFundingGet",
        "description": "Displays apprenticeship funding options.",
        "responses": {
          "200": {
            "description": "Apprenticeship funding view."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "getApprenticeshipFundingPost",
        "description": "Handles selection on apprenticeship funding options.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  },
                  "hashedAccountId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Handles the user's apprenticeship funding selection."
          },
          "302": {
            "description": "Redirects based on the submitted choice."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/gatewayInform": {
      "get": {
        "operationId": "gatewayInform",
        "description": "Displays information about the gateway for a specific account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gateway information view."
          }
        }
      }
    },
    "/accounts/gateway": {
      "get": {
        "operationId": "gatewayRedirect",
        "description": "Redirects to the gateway URL.",
        "responses": {
          "302": {
            "description": "Redirects to external gateway URL."
          }
        }
      }
    },
    "/accounts/gatewayResponse": {
      "get": {
        "operationId": "gatewayResponse",
        "description": "Handles responses and callbacks from the gateway.",
        "responses": {
          "302": {
            "description": "Redirects based on gateway response."
          }
        }
      }
    },
    "/accounts/payeerror": {
      "get": {
        "operationId": "payeError",
        "description": "Displays error details if PAYE information cannot be retrieved.",
        "parameters": [
          {
            "name": "notFound",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paye error view."
          }
        }
      }
    },
    "/accounts/summary": {
      "get": {
        "operationId": "summary",
        "description": "Displays summary page.",
        "responses": {
          "200": {
            "description": "Summary view."
          }
        }
      },
      "post": {
        "operationId": "submitSummary",
        "description": "Handles form submission for summary.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed summary submission."
          },
          "302": {
            "description": "Redirects based on form data."
          }
        }
      }
    },
    "/accounts/organisation-wrong-address": {
      "get": {
        "operationId": "organisationWrongAddressGet",
        "description": "Displays a page for cases where an incorrect organisation address is identified.",
        "responses": {
          "200": {
            "description": "Organisation wrong address view."
          }
        }
      },
      "post": {
        "operationId": "organisationWrongAddressPost",
        "description": "Handles acknowledgement of the wrong address on the organisation page.",
        "responses": {
          "302": {
            "description": "Redirects to corrected address flow."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAccountProgressSavedViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "ContinueTaskListRouteName": {
            "type": "string"
          }
        }
      },
      "RenameEmployerAccountViewModel": {
        "type": "object",
        "properties": {
          "CurrentName": {
            "type": "string"
          },
          "ChangeAccountName": {
            "type": "boolean"
          },
          "NewName": {
            "type": "string"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "NameConfirmed": {
            "type": "boolean"
          },
          "ErrorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "NewNameError": {
            "type": "string"
          }
        }
      },
      "SummaryViewModel": {
        "type": "object",
        "properties": {
          "OrganisationType": {
            "type": "integer",
            "enum": [
              1,
              2,
              3,
              4,
              5
            ],
            "description": "OrganisationType values: 1=CompaniesHouse, 2=Charities, 3=PublicBodies, 4=Other, 5=PensionsRegulator."
          },
          "PublicSectorDataSource": {
            "type": "integer"
          },
          "OrganisationName": {
            "type": "string"
          },
          "OrganisationReferenceNumber": {
            "type": "string"
          },
          "OrganisationDateOfInception": {
            "type": "string",
            "format": "date"
          },
          "RegisteredAddress": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "PayeReference": {
            "type": "string"
          },
          "EmpRefNotFound": {
            "type": "boolean"
          },
          "OrganisationStatus": {
            "type": "string"
          },
          "EmployerRefName": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "NewSearch": {
            "type": "boolean"
          },
          "AORN": {
            "type": "string"
          },
          "IsOrganisationWithCorrectAddress": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "apiKey",
        "name": "HasEmployerViewerTransactorOwnerAccount",
        "in": "header"
      },
      "HasUserAccount": {
        "type": "apiKey",
        "name": "HasUserAccount",
        "in": "header"
      }
    }
  }
}
