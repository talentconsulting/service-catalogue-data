{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreements API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/legalEntities/{hashedlegalEntityId}/agreements/{agreementId}": {
      "get": {
        "operationId": "GetAgreement",
        "summary": "Get a specific agreement by ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedlegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the agreement details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Agreement not found."
          }
        },
        "security": [
          {
            "ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/minimum-signed-agreement-version": {
      "get": {
        "operationId": "GetMinimumSignedAgreementVersion",
        "summary": "Get the minimum signed agreement version for an internal account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the minimum signed agreement version.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/signed-agreement-version": {
      "get": {
        "operationId": "GetMinimumSignedAgreementVersionByHashedId",
        "summary": "Get the minimum signed agreement version using a hashed account ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the minimum signed agreement version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinimumSignedAgreementResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/agreements": {
      "get": {
        "operationId": "GetAgreements",
        "summary": "Get all agreements associated with the account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with agreements details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ReadAllEmployerAgreements": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MinimumSignedAgreementResponse": {
        "type": "object",
        "properties": {
          "MinimumSignedAgreementVersion": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "MinimumSignedAgreementVersion"
        ]
      }
    },
    "securitySchemes": {
      "ReadAllEmployerAgreements": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
