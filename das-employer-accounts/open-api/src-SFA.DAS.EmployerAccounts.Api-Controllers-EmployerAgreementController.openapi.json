{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreements API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts/{hashedAccountId}/legalEntities/{hashedlegalEntityId}/agreements/{agreementId}": {
      "get": {
        "operationId": "GetAgreementById",
        "summary": "Retrieve a specific agreement by its ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedlegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agreementId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreement found and returned successfully.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Agreement not found."
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/minimum-signed-agreement-version": {
      "get": {
        "operationId": "InternalGetMinimumSignedAgreementVersion",
        "summary": "Retrieve the minimum signed agreement version for an account using its internal account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimum signed agreement version retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/signed-agreement-version": {
      "get": {
        "operationId": "GetMinimumSignedAgreementVersionByHashedId",
        "summary": "Retrieve the minimum signed agreement version for an account using its hashed account ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Minimum signed agreement version retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MinimumSignedAgreementResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/agreements": {
      "get": {
        "operationId": "GetAgreements",
        "summary": "Retrieve all agreements for a specific account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agreements retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {}
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles_ReadAllEmployerAgreements": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "MinimumSignedAgreementResponse": {
        "type": "object",
        "properties": {
          "MinimumSignedAgreementVersion": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadAllEmployerAgreements": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
