{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Organisation API",
    "version": "1.0.0",
    "description": "API documentation for the Search Organisation functionality of the Employer Accounts Web application."
  },
  "paths": {
    "/accounts/{HashedAccountId}/organisations/search": {
      "get": {
        "summary": "Search for an organisation.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID."
          }
        ],
        "responses": {
          "200": {
            "description": "The search view page.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": "HTML view rendered for organisation search."
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Perform a search for an organisation.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID."
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search term for organisation name."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected to search results page."
          },
          "400": {
            "description": "Bad request due to missing or invalid search term.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "status": "BadRequest",
                      "flashMessage": "Enter organisation name"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/organisations/search": {
      "get": {
        "summary": "Search for an organisation. No account ID supplied.",
        "responses": {
          "200": {
            "description": "The search view page.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": "HTML view rendered for organisation search."
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Perform a search for an organisation. No account ID supplied.",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search term for organisation name."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected to search results page."
          },
          "400": {
            "description": "Bad request due to missing or invalid search term.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "status": "BadRequest",
                      "flashMessage": "Enter organisation name"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/organisations/search/results": {
      "get": {
        "summary": "View organisation search results.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID."
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search term for organisation name."
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number of the results."
          },
          {
            "name": "organisationType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrganisationType"
            },
            "description": "The type of organisation to filter results by."
          }
        ],
        "responses": {
          "200": {
            "description": "Results of the organisation search.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOrganisationResultsViewModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing or invalid search term.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "status": "BadRequest",
                      "flashMessage": "Enter organisation name"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/organisations/search/results": {
      "get": {
        "summary": "View organisation search results. No account ID supplied.",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Search term for organisation name."
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number of the results."
          },
          {
            "name": "organisationType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrganisationType"
            },
            "description": "The type of organisation to filter results by."
          }
        ],
        "responses": {
          "200": {
            "description": "Results of the organisation search.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchOrganisationResultsViewModel"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to missing or invalid search term.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": {
                      "status": "BadRequest",
                      "flashMessage": "Enter organisation name"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{HashedAccountId}/organisations/search/confirm": {
      "post": {
        "summary": "Confirm the selected organisation details.",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed account ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The confirmation page for organisation details.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": "HTML view rendered for confirming organisation details."
                  }
                }
              }
            }
          },
          "302": {
            "description": "Redirected due to missing account ID."
          }
        }
      }
    },
    "/accounts/organisations/search/confirm": {
      "post": {
        "summary": "Confirm the selected organisation details. No account ID supplied.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The confirmation page for organisation details.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "value": "HTML view rendered for confirming organisation details."
                  }
                }
              }
            }
          },
          "302": {
            "description": "Redirected due to missing account ID."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationDetailsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string"
          },
          "Type": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "PublicSectorDataSource": {
            "type": "integer",
            "nullable": true
          },
          "Name": {
            "type": "string"
          },
          "Address": {
            "$ref": "#/components/schemas/Address"
          },
          "DateOfInception": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ReferenceNumber": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "AddedToAccount": {
            "type": "boolean"
          },
          "NameError": {
            "type": "string"
          },
          "Sector": {
            "type": "string"
          },
          "NewSearch": {
            "type": "boolean"
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "Line1": {
            "type": "string"
          },
          "Line2": {
            "type": "string"
          },
          "Line3": {
            "type": "string"
          },
          "Line4": {
            "type": "string"
          },
          "Line5": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          }
        }
      },
      "SearchOrganisationResultsViewModel": {
        "type": "object",
        "properties": {
          "Results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationDetailsViewModel"
            }
          },
          "IsExistingAccount": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
