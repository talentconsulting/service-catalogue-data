{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Organisation API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/organisations/search": {
      "get": {
        "summary": "Search for an organisation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search organisation page rendered"
          }
        }
      },
      "post": {
        "summary": "Search for an organisation using a search term",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to results page"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/search/results": {
      "get": {
        "summary": "View results for organisation search",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "organisationType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrganisationType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results page rendered"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/search/confirm": {
      "post": {
        "summary": "Confirm organisation details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmation page rendered"
          },
          "302": {
            "description": "Redirects to summary or another page"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationDetailsViewModel": {
        "type": "object",
        "properties": {
          "hashedId": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "publicSectorDataSource": {
            "type": "integer",
            "nullable": true
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "dateOfInception": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "referenceNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "sector": {
            "type": "string"
          },
          "newSearch": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
