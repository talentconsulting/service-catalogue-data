{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Search Organisation API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{HashedAccountId}/organisations/search": {
      "get": {
        "operationId": "SearchForOrganisation_Get",
        "summary": "Search for organisations",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search organisation view rendered"
          }
        }
      },
      "post": {
        "operationId": "SearchForOrganisation_Post",
        "summary": "Search for organisations with a search term",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "searchTerm": {
                    "type": "string"
                  }
                },
                "required": [
                  "searchTerm"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to organisation search results"
          }
        }
      }
    },
    "/accounts/organisations/search": {
      "get": {
        "$ref": "#/paths/~1accounts~1{HashedAccountId}~1organisations~1search/get"
      },
      "post": {
        "$ref": "#/paths/~1accounts~1{HashedAccountId}~1organisations~1search/post"
      }
    },
    "/accounts/{HashedAccountId}/organisations/search/results": {
      "get": {
        "operationId": "SearchForOrganisationResults",
        "summary": "View the organisation search results",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "organisationType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/OrganisationType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search organisation results view rendered"
          }
        }
      }
    },
    "/accounts/organisations/search/results": {
      "get": {
        "$ref": "#/paths/~1accounts~1{HashedAccountId}~1organisations~1search~1results/get"
      }
    },
    "/accounts/{HashedAccountId}/organisations/search/confirm": {
      "post": {
        "operationId": "ConfirmOrganisationSelection",
        "summary": "Confirm organisation details during search process",
        "parameters": [
          {
            "name": "HashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirm organisation details view rendered"
          },
          "302": {
            "description": "Redirect to Employer Account Summary page"
          }
        }
      }
    },
    "/accounts/organisations/search/confirm": {
      "post": {
        "$ref": "#/paths/~1accounts~1{HashedAccountId}~1organisations~1search~1confirm/post"
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationDetailsViewModel": {
        "type": "object",
        "properties": {
          "HashedId": {
            "type": "string"
          },
          "Type": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "PublicSectorDataSource": {
            "type": "integer",
            "nullable": true
          },
          "Name": {
            "type": "string"
          },
          "Address": {
            "type": "string"
          },
          "DateOfInception": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ReferenceNumber": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "AddedToAccount": {
            "type": "boolean"
          },
          "Sector": {
            "type": "string"
          },
          "NewSearch": {
            "type": "boolean"
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
