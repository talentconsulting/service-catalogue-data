{
  "openapi": "3.1.0",
  "info": {
    "title": "SearchOrganisation API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/organisations/search": {
      "get": {
        "operationId": "SearchForOrganisation",
        "summary": "Searches for an organisation for a specific account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The search organisation view."
          }
        }
      },
      "post": {
        "operationId": "SearchForOrganisationPost",
        "summary": "Submits a search for organisations for a specific account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "searchTerm": {
                    "type": "string"
                  }
                },
                "required": [
                  "searchTerm"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the search results page."
          }
        }
      }
    },
    "/accounts/organisations/search": {
      "get": {
        "operationId": "SearchForOrganisationRoot",
        "summary": "Search for an organisation without providing an account ID.",
        "responses": {
          "200": {
            "description": "The search organisation view."
          }
        }
      },
      "post": {
        "operationId": "SearchForOrganisationPostRoot",
        "summary": "Submit a search for organisations without an account ID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "searchTerm": {
                    "type": "string"
                  }
                },
                "required": [
                  "searchTerm"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the search results page."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/search/results": {
      "get": {
        "operationId": "SearchForOrganisationResults",
        "summary": "Fetches search results for organisations for a specific account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "organisationType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OrganisationType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The search organisation results view."
          }
        }
      }
    },
    "/accounts/organisations/search/results": {
      "get": {
        "operationId": "SearchForOrganisationResultsRoot",
        "summary": "Fetch search results without providing an account ID.",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "organisationType",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/OrganisationType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The search organisation results view."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/search/confirm": {
      "post": {
        "operationId": "ConfirmOrganisation",
        "summary": "Confirm the selection of an organisation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The confirmation organisation details view."
          }
        }
      }
    },
    "/accounts/organisations/search/confirm": {
      "post": {
        "operationId": "ConfirmOrganisationRoot",
        "summary": "Confirm the selection of an organisation without an account ID.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The confirmation organisation details view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationDetailsViewModel": {
        "type": "object",
        "properties": {
          "hashedId": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "publicSectorDataSource": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "dateOfInception": {
            "type": "string",
            "format": "date-time"
          },
          "referenceNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "addedToAccount": {
            "type": "boolean"
          },
          "sector": {
            "type": "string"
          },
          "newSearch": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
