{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Team API",
    "version": "1.0.0",
    "description": "API for managing teams within employer accounts."
  },
  "paths": {
    "/accounts/{hashedAccountId}/teams": {
      "get": {
        "operationId": "getEmployerTeamIndex",
        "summary": "View the employer team dashboard.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer team dashboard displayed successfully."
          },
          "302": {
            "description": "Redirected to account task list."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/view": {
      "get": {
        "operationId": "getEmployerTeamView",
        "summary": "View team members for the employer team.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team members displayed successfully."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/AddedProvider/{providerName}": {
      "get": {
        "operationId": "getAddedProvider",
        "summary": "Redirect after adding a training provider.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected to the employer team dashboard."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/invite": {
      "get": {
        "operationId": "getEmployerTeamInvite",
        "summary": "Get the team invitation view.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation view displayed successfully."
          }
        }
      },
      "post": {
        "operationId": "postEmployerTeamInvite",
        "summary": "Invite a team member.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Team member invited successfully."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/invite/next": {
      "get": {
        "operationId": "getInviteNextSteps",
        "summary": "Next steps after sending an invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next steps displayed successfully."
          }
        }
      },
      "post": {
        "operationId": "postInviteNextSteps",
        "summary": "Handle next steps after sending an invitation.",
        "parameters": [
          {
            "name": "choice",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected based on user choice."
          },
          "200": {
            "description": "Error response displayed if no option is selected."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/{hashedInvitationId}/cancel": {
      "get": {
        "operationId": "getCancelInvitation",
        "summary": "View an invitation for cancellation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation review displayed successfully."
          }
        }
      },
      "post": {
        "operationId": "postCancelInvitation",
        "summary": "Cancel a team member invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cancel",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancellation processed successfully."
          },
          "302": {
            "description": "Redirect to the view team page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "errorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      },
      "TriageViewModel": {
        "type": "object",
        "properties": {
          "triageOption": {
            "type": "string",
            "enum": [
              "Yes",
              "No",
              "Unknown"
            ]
          }
        }
      }
    }
  }
}
