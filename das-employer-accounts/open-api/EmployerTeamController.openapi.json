{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Team API",
    "version": "1.0.0",
    "description": "API specification derived from the EmployerTeamController in the SFA.DAS.EmployerAccounts.Web project."
  },
  "paths": {
    "/accounts/{hashedAccountId}/teams": {
      "get": {
        "operationId": "EmployerTeamIndex",
        "summary": "Gets the Employer Team Dashboard",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "description": "Error response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/view": {
      "get": {
        "operationId": "EmployerTeamView",
        "summary": "Gets the details of the team members.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "description": "Error response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/AddedProvider/{providerName}": {
      "get": {
        "operationId": "EmployerTeamAddedProvider",
        "summary": "Handles provider addition notification and redirects to the team index.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the Employer Team Index"
          },
          "default": {
            "description": "Error response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/invite": {
      "get": {
        "operationId": "EmployerTeamInvite",
        "summary": "Gets a new team invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "description": "Error response"
          }
        }
      },
      "post": {
        "operationId": "EmployerTeamInvitePost",
        "summary": "Creates a new team member invitation.",
        "parameters": [],
        "requestBody": {
          "description": "Team member invitation details.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation sent successfully."
          },
          "default": {
            "description": "Error response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/invite/next": {
      "get": {
        "operationId": "EmployerTeamInviteNextSteps",
        "summary": "Gets the next steps for a team invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "description": "Error response"
          }
        }
      },
      "post": {
        "operationId": "EmployerTeamInviteNextPost",
        "summary": "Handles the next steps in the employer process based on user choice.",
        "parameters": [
          {
            "name": "choice",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects based on user choice."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/teams/{hashedInvitationId}/cancel": {
      "get": {
        "operationId": "EmployerTeamCancelInvitation",
        "summary": "Gets information needed to cancel a team invitation.",
        "parameters": [
          {
            "name": "hashedInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "default": {
            "description": "Error response"
          }
        }
      },
      "post": {
        "operationId": "EmployerTeamCancelInvitationPost",
        "summary": "Cancels a team invitation.",
        "parameters": [
          {
            "name": "hashedInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cancel",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ],
        "responses": {
          "200": {
            "description": "Invitation canceled successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "errorDictionary": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      }
    },
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "oauth2",
        "description": "Authorization policy for Employer Viewer, Transactor, Owner Account",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/authorize",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "HasEmployerViewerTransactorOwnerAccount": "Access permission"
            }
          }
        }
      }
    }
  }
}
