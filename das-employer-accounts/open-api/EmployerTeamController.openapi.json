{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Team API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/teams": {
      "get": {
        "operationId": "GetEmployerTeamIndex",
        "summary": "Get the employer team view.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer team view retrieved successfully."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/view": {
      "get": {
        "operationId": "ViewTeam",
        "summary": "Retrieve team members for a specific account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Team members retrieved."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/AddedProvider/{providerName}": {
      "get": {
        "operationId": "AddedProvider",
        "summary": "Adds a notification for adding a provider to the account.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The name of the provider."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected to the Employer Team Index."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/invite": {
      "get": {
        "operationId": "InviteTeamMember",
        "summary": "Get invitation setup for a team member.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieved invitation setup."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "SendTeamMemberInvite",
        "summary": "Send invitation to a team member.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation sent successfully."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/invite/next": {
      "get": {
        "operationId": "InviteNextSteps",
        "summary": "Retrieve the next steps after invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next steps retrieved."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "PostInviteNextSteps",
        "summary": "Post the user's selection for next steps after invitation.",
        "parameters": [
          {
            "name": "choice",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected based on user choice."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        }
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      }
    },
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
