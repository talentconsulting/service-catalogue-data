{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Team API",
    "description": "API for managing employer teams in employer accounts.",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/teams": {
      "get": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "Get the employer team index view.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer team index view rendered."
          },
          "302": {
            "description": "Redirect to continue setup task list."
          },
          "default": {
            "description": "Unexpected error."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/view": {
      "get": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "View the employer team members.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Listing of employer team members."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/AddedProvider/{providerName}": {
      "get": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "Show confirmation after adding a provider.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to employer team index."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/invite": {
      "get": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "View the invite team member form.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invite team member form."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "Send an invitation to a new team member.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation sent to the new team member."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/invite/next": {
      "get": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "View post-invitation next steps.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Post-invitation next steps view loaded."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "Handle the next steps after sending an invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "choice",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                1,
                2,
                3,
                0
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the respective next step based on the choice."
          },
          "400": {
            "description": "Validation error."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/{hashedInvitationId}/cancel": {
      "get": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "View cancel invitation confirmation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmation view for canceling an invitation."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "Cancel the invitation of a team member.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedInvitationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cancel",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect or updated cancel confirmation."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/resend": {
      "post": {
        "tags": [
          "EmployerTeam"
        ],
        "summary": "Resend an invitation to a team member.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedInvitationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resent invitation details."
          }
        },
        "security": [
          {
            "HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "hashedAccountId",
          "name",
          "email"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      }
    },
    "securitySchemes": {
      "HasEmployerViewerTransactorOwnerAccount": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
