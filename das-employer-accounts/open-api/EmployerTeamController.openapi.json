{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Team API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/teams": {
      "get": {
        "operationId": "EmployerTeamController_Index",
        "summary": "Retrieve the employer team index view.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/view": {
      "get": {
        "operationId": "EmployerTeamController_ViewTeam",
        "summary": "View the employer team members.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/AddedProvider/{providerName}": {
      "get": {
        "operationId": "EmployerTeamController_AddedProvider",
        "summary": "Redirect after a provider is added.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/invite": {
      "get": {
        "operationId": "EmployerTeamController_Invite",
        "summary": "Get the invitation view for the employer team.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "EmployerTeamController_InvitePost",
        "summary": "Send an invitation to a team member.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteTeamMemberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/invite/next": {
      "get": {
        "operationId": "EmployerTeamController_NextSteps_Get",
        "summary": "Get the next steps after sending an invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "EmployerTeamController_NextSteps_Post",
        "summary": "Save next step action after sending an invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "choice": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    },
    "/accounts/{hashedAccountId}/teams/{hashedInvitationId}/cancel": {
      "get": {
        "operationId": "EmployerTeamController_Cancel_Get",
        "summary": "Get the cancel invitation view.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "EmployerTeamController_Cancel_Post",
        "summary": "Cancel a team member's invitation.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedInvitationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "cancel": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        },
        "security": [
          {
            "PolicyNames.HasEmployerViewerTransactorOwnerAccount": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "InviteTeamMemberViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "Name",
          "Email",
          "Role"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      }
    },
    "securitySchemes": {
      "PolicyNames.HasEmployerViewerTransactorOwnerAccount": {
        "type": "http",
        "scheme": "bearer",
        "description": "Requires a user with Employer Viewer, Transactor, or Owner roles."
      }
    }
  }
}
