{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "post": {
        "summary": "Create an employer account via a provider request",
        "operationId": "CreateEmployerAccountViaProviderRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerAccountViaProviderRequestModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerAccountViaProviderResponseModel"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Get a specific account by ID",
        "operationId": "GetAccountById",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}": {
      "get": {
        "summary": "Get a specific account by hashed ID",
        "operationId": "GetAccount",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "summary": "Get users associated with an account by hashed ID",
        "operationId": "GetAccountUsers",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users": {
      "get": {
        "summary": "Get users associated with an account internally by ID",
        "operationId": "GetAccountUsersByInternalAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users/which-receive-notifications": {
      "get": {
        "summary": "Get notified users of an account by ID",
        "operationId": "GetAccountUsersWhichReceiveNotifications",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/acknowledge-training-provider-task": {
      "patch": {
        "summary": "Acknowledge a training provider task",
        "operationId": "AcknowledgeTrainingProviderTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeTrainingProviderTaskCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/updated": {
      "get": {
        "summary": "Get accounts updated since a specific date",
        "operationId": "GetAccountsUpdated",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/search": {
      "get": {
        "summary": "Search accounts by employer name",
        "operationId": "SearchAccounts",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {}
        ]
      }
    },
    "/api/accounts/queries": {
      "post": {
        "summary": "Query accounts with filters",
        "operationId": "QueryAccounts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEmployerAccountViaProviderRequestModel": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "UserRef": {
            "type": "string",
            "format": "uuid"
          },
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmployerOrganisationName": {
            "type": "string"
          },
          "EmployerPaye": {
            "type": "string"
          },
          "EmployerAorn": {
            "type": "string"
          },
          "EmployerAddress": {
            "type": "string"
          },
          "EmployerOrganisationReferenceNumber": {
            "type": "string"
          }
        },
        "required": [
          "RequestId",
          "UserRef"
        ]
      },
      "CreateEmployerAccountViaProviderResponseModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          }
        }
      },
      "AcknowledgeTrainingProviderTaskCommand": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          }
        },
        "required": [
          "AccountId"
        ]
      },
      "AccountsQueryRequest": {
        "type": "object",
        "properties": {
          "Filter": {
            "$ref": "#/components/schemas/AccountsQueryFilter"
          },
          "Select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountsQueryFilter": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "AccountsQueryResponse": {
        "type": "object",
        "properties": {
          "Accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryResult"
            }
          }
        }
      },
      "AccountQueryResult": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "ApprenticeshipEmployerType": {
            "type": "string"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryLegalEntityResult"
            }
          }
        }
      },
      "AccountQueryLegalEntityResult": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Allows access to employer account balances",
              "ReadAllAccountUsers": "Allows access to account users"
            }
          }
        }
      }
    }
  }
}
