{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing employer accounts, their legal entities, users, and associated operations."
  },
  "paths": {
    "/api/accounts": {
      "post": {
        "summary": "Create a new employer account via provider request",
        "operationId": "createEmployerAccountViaProviderRequest",
        "requestBody": {
          "required": true,
          "description": "Payload to create an employer account via provider request",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerAccountViaProviderRequestModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employer account created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerAccountViaProviderResponseModel"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Retrieve an account by accountId",
        "operationId": "getAccountById",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Unique account identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Account not found"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/accounts/{hashedAccountId}": {
      "get": {
        "summary": "Retrieve an account by hashedAccountId",
        "operationId": "getAccount",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unique hashed account identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Account not found"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "summary": "Retrieve users of an account by hashedAccountId",
        "operationId": "getAccountUsers",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Unique hashed account identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Users"
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users": {
      "get": {
        "summary": "Retrieve users of an account by internal accountId",
        "operationId": "getAccountUsersByInternalAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Unique internal account identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Users"
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users/which-receive-notifications": {
      "get": {
        "summary": "Retrieve users who receive notifications for an account by internal accountId",
        "operationId": "getAccountUsersWhichReceiveNotifications",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Unique internal account identifier"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Users"
        ]
      }
    },
    "/api/accounts/acknowledge-training-provider-task": {
      "patch": {
        "summary": "Acknowledge training provider task for an account",
        "operationId": "acknowledgeTrainingProviderTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeTrainingProviderTaskCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task acknowledged successfully",
            "content": {
              "application/json": {}
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/accounts/queries": {
      "post": {
        "summary": "Query accounts with filters",
        "operationId": "queryAccounts",
        "requestBody": {
          "required": true,
          "description": "Filter and query options",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/accounts/search": {
      "get": {
        "summary": "Search accounts by employerName",
        "operationId": "searchAccounts",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Employer name to search"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search result",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Accounts"
        ]
      }
    },
    "/api/accounts/updated": {
      "get": {
        "summary": "Retrieve accounts updated since a specific date",
        "operationId": "getAccountsUpdated",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Date from which accounts have been updated"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "description": "Page number to retrieve"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000,
              "description": "Number of accounts per page"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Updated accounts retrieved successfully",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Internal server error"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "Authorization": []
          }
        ],
        "tags": [
          "Accounts"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountsQueryRequest": {
        "type": "object",
        "properties": {
          "Filter": {
            "$ref": "#/components/schemas/AccountsQueryFilter"
          },
          "Select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountsQueryFilter": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "AcknowledgeTrainingProviderTaskCommand": {
        "type": "object",
        "required": [
          "AccountId"
        ],
        "properties": {
          "AccountId": {
            "type": "integer",
            "description": "Unique identifier for the account"
          }
        }
      },
      "CreateEmployerAccountViaProviderRequestModel": {
        "type": "object",
        "required": [
          "RequestId",
          "UserRef",
          "Email",
          "FirstName",
          "LastName",
          "EmployerOrganisationName",
          "EmployerPaye",
          "EmployerAddress"
        ],
        "properties": {
          "RequestId": {
            "type": "string",
            "description": "Correlation ID for the request"
          },
          "UserRef": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the user"
          },
          "Email": {
            "type": "string",
            "description": "Email address of the user"
          },
          "FirstName": {
            "type": "string",
            "description": "First name of the user"
          },
          "LastName": {
            "type": "string",
            "description": "Last name of the user"
          },
          "EmployerOrganisationName": {
            "type": "string",
            "description": "Name of the employer organisation"
          },
          "EmployerPaye": {
            "type": "string",
            "description": "PAYE reference for the employer"
          },
          "EmployerAorn": {
            "type": "string",
            "description": "Accident/Incident reference number for the employer"
          },
          "EmployerAddress": {
            "type": "string",
            "description": "Address of the employer"
          },
          "EmployerOrganisationReferenceNumber": {
            "type": "string",
            "description": "Reference number for the employer organisation"
          }
        }
      },
      "CreateEmployerAccountViaProviderResponseModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "description": "Unique ID of the created account"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "description": "Unique ID of the account legal entity"
          }
        }
      },
      "AccountsQueryResponse": {
        "type": "object",
        "properties": {
          "Accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryResult"
            }
          }
        }
      },
      "AccountQueryResult": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "description": "Unique identifier of the account"
          },
          "ApprenticeshipEmployerType": {
            "type": "string",
            "description": "Type of employer apprenticeship"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryLegalEntityResult"
            }
          }
        }
      },
      "AccountQueryLegalEntityResult": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "Unique identifier for the legal entity"
          }
        }
      }
    },
    "securitySchemes": {
      "Authorization": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
