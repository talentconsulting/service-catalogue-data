{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "post": {
        "operationId": "CreateEmployerAccountViaProviderRequest",
        "summary": "Create employer account via provider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerAccountViaProviderRequestModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerAccountViaProviderResponseModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "operationId": "GetAccountById",
        "summary": "Retrieve employer account by ID",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}": {
      "get": {
        "operationId": "GetAccount",
        "summary": "Retrieve employer account by hashed ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "operationId": "GetAccountUsers",
        "summary": "Retrieve account users by hashed account ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users": {
      "get": {
        "operationId": "GetAccountUsersByInternalAccountId",
        "summary": "Retrieve account users by internal account ID",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Internal account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users/which-receive-notifications": {
      "get": {
        "operationId": "GetAccountUsersByInternalAccountIdWhichReceiveNotifications",
        "summary": "Retrieve users receiving notifications by internal account ID",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Internal account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/acknowledge-training-provider-task": {
      "patch": {
        "operationId": "AcknowledgeTrainingProviderTask",
        "summary": "Acknowledge a training provider task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeTrainingProviderTaskCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/updated": {
      "get": {
        "operationId": "GetAccountsUpdated",
        "summary": "Retrieve updated employer accounts",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Retrieve accounts updated since this date"
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "description": "Number of accounts per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/search": {
      "get": {
        "operationId": "SearchAccounts",
        "summary": "Search accounts by employer name",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer name to search by"
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/accounts/queries": {
      "post": {
        "operationId": "QueryAccounts",
        "summary": "Query accounts based on filters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEmployerAccountViaProviderRequestModel": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "UserRef": {
            "type": "string",
            "format": "uuid"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmployerOrganisationName": {
            "type": "string"
          },
          "EmployerPaye": {
            "type": "string"
          },
          "EmployerAorn": {
            "type": "string"
          },
          "EmployerAddress": {
            "type": "string"
          },
          "EmployerOrganisationReferenceNumber": {
            "type": "string"
          }
        }
      },
      "CreateEmployerAccountViaProviderResponseModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "AcknowledgeTrainingProviderTaskCommand": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "AccountId"
        ]
      },
      "AccountsQueryRequest": {
        "type": "object",
        "properties": {
          "Filter": {
            "$ref": "#/components/schemas/AccountsQueryFilter"
          },
          "Select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountsQueryFilter": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "AccountsQueryResponse": {
        "type": "object",
        "properties": {
          "Accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryResult"
            }
          }
        }
      },
      "AccountQueryResult": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeshipEmployerType": {
            "type": "string"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryLegalEntityResult"
            }
          }
        }
      },
      "AccountQueryLegalEntityResult": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          }
        }
      }
    }
  }
}
