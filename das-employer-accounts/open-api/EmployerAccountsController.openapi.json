{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "getAccounts",
        "summary": "Retrieve employer accounts",
        "parameters": [
          {
            "name": "toDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      },
      "post": {
        "operationId": "createEmployerAccountViaProvider",
        "summary": "Create an employer account via provider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerAccountViaProviderRequestModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerAccountViaProviderResponseModel"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "operationId": "getAccountByAccountId",
        "summary": "Retrieve account by numeric account ID",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}": {
      "get": {
        "operationId": "getAccountByHashedAccountId",
        "summary": "Retrieve account by hashed account ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "operationId": "getAccountUsersByHashedAccountId",
        "summary": "Retrieve account users by hashed account ID",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/users": {
      "get": {
        "operationId": "getAccountUsersByAccountId",
        "summary": "Retrieve account users by numeric account ID",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}/users/which-receive-notifications": {
      "get": {
        "operationId": "getAccountUsersReceivingNotifications",
        "summary": "Get users of an account which receive notifications",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/acknowledge-training-provider-task": {
      "patch": {
        "operationId": "acknowledgeTrainingProviderTask",
        "summary": "Acknowledge training provider task for a given account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeTrainingProviderTaskCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/updated": {
      "get": {
        "operationId": "getAccountsUpdatedSince",
        "summary": "Retrieve accounts updated since a given date",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/search": {
      "get": {
        "operationId": "searchAccounts",
        "summary": "Search employer accounts by employer name",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {}
            }
          },
          "400": {
            "description": "Bad request"
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/accounts/queries": {
      "post": {
        "operationId": "queryAccounts",
        "summary": "Query accounts with filters",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEmployerAccountViaProviderRequestModel": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "UserRef": {
            "type": "string",
            "format": "uuid"
          },
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmployerOrganisationName": {
            "type": "string"
          },
          "EmployerPaye": {
            "type": "string"
          },
          "EmployerAorn": {
            "type": "string"
          },
          "EmployerAddress": {
            "type": "string"
          },
          "EmployerOrganisationReferenceNumber": {
            "type": "string"
          }
        },
        "required": [
          "RequestId",
          "UserRef",
          "Email",
          "FirstName",
          "LastName",
          "EmployerOrganisationName",
          "EmployerPaye",
          "EmployerAorn",
          "EmployerAddress",
          "EmployerOrganisationReferenceNumber"
        ]
      },
      "CreateEmployerAccountViaProviderResponseModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          }
        },
        "required": [
          "AccountId",
          "AccountLegalEntityId"
        ]
      },
      "AcknowledgeTrainingProviderTaskCommand": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          }
        },
        "required": [
          "AccountId"
        ]
      },
      "AccountsQueryRequest": {
        "type": "object",
        "properties": {
          "Filter": {
            "$ref": "#/components/schemas/AccountsQueryFilter"
          },
          "Select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountsQueryFilter": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "AccountsQueryResponse": {
        "type": "object",
        "properties": {
          "Accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryResult"
            }
          }
        }
      },
      "AccountQueryResult": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "ApprenticeshipEmployerType": {
            "type": "string"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryLegalEntityResult"
            }
          }
        }
      },
      "AccountQueryLegalEntityResult": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiRoles.ReadAllEmployerAccountBalances": {
        "type": "http",
        "scheme": "bearer"
      },
      "ApiRoles.ReadAllAccountUsers": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
