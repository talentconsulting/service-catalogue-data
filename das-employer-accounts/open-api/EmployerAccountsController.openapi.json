{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "GetAccounts",
        "summary": "Get a list of employer accounts.",
        "parameters": [
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "description": "Filter accounts last updated before the given date."
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "description": "The number of accounts to include per page."
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number to retrieve."
          }
        ],
        "security": [
          {
            "OAuth2": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "A list of employer accounts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsList"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "operationId": "GetAccountById",
        "summary": "Get employer account details by account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The unique ID of the employer account."
          }
        ],
        "security": [
          {
            "OAuth2": [
              "ReadAllAccountUsers"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the employer account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Account not found."
          }
        }
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "operationId": "GetAccountUsers",
        "summary": "Get users associated with an employer account using hashed account ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hashed ID of the employer account."
          }
        ],
        "security": [
          {
            "OAuth2": [
              "ReadAllAccountUsers"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Users associated with the employer account.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersList"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/internal/{accountId}/users/which-receive-notifications": {
      "get": {
        "operationId": "GetNotificationReceivingUsers",
        "summary": "Get users of an employer account who receive notifications.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The unique ID of the employer account."
          }
        ],
        "security": [
          {
            "OAuth2": [
              "ReadAllAccountUsers"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "A list of users who receive notifications.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsersList"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/updated": {
      "get": {
        "operationId": "GetUpdatedAccounts",
        "summary": "Get accounts updated since a specific date.",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Specify the date to filter updated accounts."
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number to retrieve."
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "description": "The number of accounts to include per page."
          }
        ],
        "security": [
          {
            "OAuth2": [
              "ReadAllAccountUsers"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "A list of updated accounts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsList"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/search": {
      "get": {
        "operationId": "SearchAccounts",
        "summary": "Search employer accounts by name.",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The name of the employer to search for."
          }
        ],
        "security": [
          {
            "OAuth2": []
          }
        ],
        "responses": {
          "200": {
            "description": "Matched accounts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsList"
                }
              }
            }
          },
          "400": {
            "description": "Invalid search/empty employer name."
          }
        }
      }
    },
    "/api/accounts/queries": {
      "post": {
        "operationId": "QueryAccounts",
        "summary": "Query employer accounts based on filters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsQueryRequest"
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": [
              "ReadAllAccountUsers"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Queried accounts matching filters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: missing or incorrect filters."
          }
        }
      }
    },
    "/api/accounts/acknowledge-training-provider-task": {
      "patch": {
        "operationId": "AcknowledgeTrainingProviderTask",
        "summary": "Acknowledge training provider tasks for an account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeTrainingProviderTaskCommand"
              }
            }
          }
        },
        "security": [
          {
            "OAuth2": [
              "ReadAllAccountUsers"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Acknowledged successfully."
          },
          "500": {
            "description": "Internal server error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountsList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "accountName": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "apprenticeshipEmployerType": {
            "type": "string"
          },
          "accountAgreementType": {
            "$ref": "#/components/schemas/AccountAgreementType"
          }
        }
      },
      "AccountAgreementType": {
        "type": "string",
        "enum": [
          "Levy",
          "Combined",
          "Unknown"
        ]
      },
      "AcknowledgeTrainingProviderTaskCommand": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          }
        },
        "required": [
          "accountId"
        ]
      },
      "AccountsQueryRequest": {
        "type": "object",
        "properties": {
          "filter": {
            "$ref": "#/components/schemas/AccountsQueryFilter"
          },
          "select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountsQueryFilter": {
        "type": "object",
        "properties": {
          "accountIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "AccountsQueryResponse": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryResult"
            }
          }
        }
      },
      "AccountQueryResult": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "apprenticeshipEmployerType": {
            "type": "string"
          },
          "legalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryLegalEntityResult"
            }
          }
        }
      },
      "AccountQueryLegalEntityResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/auth",
            "scopes": {
              "ReadAllEmployerAccountBalances": "Access all employer account balance information",
              "ReadAllAccountUsers": "Access all account user information"
            }
          }
        }
      }
    }
  }
}
