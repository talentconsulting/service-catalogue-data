{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "GetAccounts",
        "parameters": [
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accounts"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      },
      "post": {
        "operationId": "CreateEmployerAccountViaProviderRequest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerAccountViaProviderRequestModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Account created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerAccountViaProviderResponseModel"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRoles": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "operationId": "GetAccount",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}": {
      "get": {
        "operationId": "GetAccountByHashedAccountId",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Account not found"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "operationId": "GetAccountUsers",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account users retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users/which-receive-notifications": {
      "get": {
        "operationId": "GetAccountUsersWhichReceiveNotifications",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users who receive notifications retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/acknowledge-training-provider-task": {
      "patch": {
        "operationId": "AcknowledgeTrainingProviderTask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeTrainingProviderTaskCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Acknowledged successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/updated": {
      "get": {
        "operationId": "GetAccountsUpdated",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of updated accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accounts"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Request"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/search": {
      "get": {
        "operationId": "SearchAccounts",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accounts"
                }
              }
            }
          },
          "400": {
            "description": "Invalid employer name"
          }
        },
        "security": [
          {
            "ApiRoles": []
          }
        ]
      }
    },
    "/api/accounts/queries": {
      "post": {
        "operationId": "QueryAccounts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Query results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Accounts": {
        "type": "object",
        "properties": {
          "accountsCount": {
            "type": "integer"
          },
          "accountList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Account"
            }
          }
        }
      },
      "Account": {
        "type": "object",
        "properties": {
          "accountName": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "publicAccountHashId": {
            "type": "string"
          },
          "accountId": {
            "type": "integer"
          },
          "href": {
            "type": "string"
          },
          "apprenticeshipEmployerType": {
            "$ref": "#/components/schemas/ApprenticeshipEmployerType"
          },
          "accountAgreementType": {
            "$ref": "#/components/schemas/AccountAgreementType"
          }
        }
      },
      "CreateEmployerAccountViaProviderRequestModel": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "userRef": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "employerOrganisationName": {
            "type": "string"
          },
          "employerPaye": {
            "type": "string"
          },
          "employerAorn": {
            "type": "string"
          },
          "employerAddress": {
            "type": "string"
          },
          "employerOrganisationReferenceNumber": {
            "type": "string"
          }
        },
        "required": [
          "requestId",
          "userRef",
          "firstName",
          "lastName",
          "email",
          "employerOrganisationName"
        ]
      },
      "CreateEmployerAccountViaProviderResponseModel": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "accountLegalEntityId": {
            "type": "integer"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "userRef": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "AcknowledgeTrainingProviderTaskCommand": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          }
        }
      },
      "AccountsQueryRequest": {
        "type": "object",
        "properties": {
          "filter": {
            "$ref": "#/components/schemas/AccountsQueryFilter"
          },
          "select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountsQueryFilter": {
        "type": "object",
        "properties": {
          "accountIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "AccountsQueryResponse": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryResult"
            }
          }
        }
      },
      "AccountQueryResult": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer"
          },
          "apprenticeshipEmployerType": {
            "type": "string"
          },
          "legalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryLegalEntityResult"
            }
          }
        }
      },
      "AccountQueryLegalEntityResult": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      },
      "ApprenticeshipEmployerType": {
        "type": "string",
        "enum": [
          "Levy",
          "NonLevy",
          "Unknown"
        ]
      },
      "AccountAgreementType": {
        "type": "string",
        "enum": [
          "Levy",
          "Combined",
          "Unknown"
        ]
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
