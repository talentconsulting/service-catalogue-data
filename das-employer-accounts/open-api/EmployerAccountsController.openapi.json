{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "get": {
        "summary": "Get accounts",
        "operationId": "GetAccounts",
        "parameters": [
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "required": false
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "required": false
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      },
      "post": {
        "summary": "Create employer account via provider",
        "operationId": "CreateEmployerAccountViaProviderRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerAccountViaProviderRequestModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerAccountViaProviderResponseModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "defaultAuth": []
          }
        ]
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "summary": "Get account by ID",
        "operationId": "GetAccountById",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}": {
      "get": {
        "summary": "Get account by hashed ID",
        "operationId": "GetAccount",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllEmployerAccountBalances": []
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "summary": "Get account users by hashed ID",
        "operationId": "GetAccountUsers",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users": {
      "get": {
        "summary": "Get account users by internal account ID",
        "operationId": "GetAccountUsersByInternalAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users/which-receive-notifications": {
      "get": {
        "summary": "Get account users which receive notifications",
        "operationId": "GetAccountUsersWhichReceiveNotifications",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/queries": {
      "post": {
        "summary": "Query accounts",
        "operationId": "QueryAccounts",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsQueryRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/updated": {
      "get": {
        "summary": "Get accounts updated since a date",
        "operationId": "GetAccountsUpdated",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            },
            "required": false
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/acknowledge-training-provider-task": {
      "patch": {
        "summary": "Acknowledge training provider task",
        "operationId": "AcknowledgeTrainingProviderTask",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcknowledgeTrainingProviderTaskCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "ApiRoles.ReadAllAccountUsers": []
          }
        ]
      }
    },
    "/api/accounts/search": {
      "get": {
        "summary": "Search accounts",
        "operationId": "SearchAccounts",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "defaultAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEmployerAccountViaProviderRequestModel": {
        "type": "object",
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "UserRef": {
            "type": "string",
            "format": "uuid"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmployerOrganisationName": {
            "type": "string"
          },
          "EmployerPaye": {
            "type": "string"
          },
          "EmployerAorn": {
            "type": "string"
          },
          "EmployerAddress": {
            "type": "string"
          },
          "EmployerOrganisationReferenceNumber": {
            "type": "string"
          }
        }
      },
      "CreateEmployerAccountViaProviderResponseModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          }
        }
      },
      "AccountsQueryRequest": {
        "type": "object",
        "properties": {
          "Filter": {
            "$ref": "#/components/schemas/AccountsQueryFilter"
          },
          "Select": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AccountsQueryFilter": {
        "type": "object",
        "properties": {
          "AccountIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "AccountsQueryResponse": {
        "type": "object",
        "properties": {
          "Accounts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryResult"
            }
          }
        }
      },
      "AccountQueryResult": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "ApprenticeshipEmployerType": {
            "type": "string"
          },
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountQueryLegalEntityResult"
            }
          }
        }
      },
      "AccountQueryLegalEntityResult": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          }
        }
      },
      "AcknowledgeTrainingProviderTaskCommand": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
