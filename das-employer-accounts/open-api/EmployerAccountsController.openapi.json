{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/accounts": {
      "post": {
        "operationId": "CreateEmployerAccountViaProviderRequest",
        "summary": "Create an employer account via a provider.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerAccountViaProviderRequestModel"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerAccountViaProviderResponseModel"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "ApiRoles": [
              "Authorize"
            ]
          }
        ]
      }
    },
    "/api/accounts/{accountId}": {
      "get": {
        "operationId": "GetAccountById",
        "summary": "Retrieve account details by account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account details returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Account not found."
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}": {
      "get": {
        "operationId": "GetAccount",
        "summary": "Retrieve account details by hashed account ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account details returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Account not found."
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllEmployerAccountBalances"
            ]
          }
        ]
      }
    },
    "/api/accounts/{hashedAccountId}/users": {
      "get": {
        "operationId": "GetAccountUsers",
        "summary": "Retrieve users in an account by hashed account ID.",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/internal/{accountId}/users": {
      "get": {
        "operationId": "GetAccountUsersByInternalAccountId",
        "summary": "Retrieve users in an account by internal account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of users returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Membership"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/updated": {
      "get": {
        "operationId": "GetAccountsUpdated",
        "summary": "Retrieve accounts updated since a specific date.",
        "parameters": [
          {
            "name": "sinceDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of updated accounts returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "ApiRoles": [
              "ReadAllAccountUsers"
            ]
          }
        ]
      }
    },
    "/api/accounts/search": {
      "get": {
        "operationId": "SearchAccounts",
        "summary": "Search employer accounts by name.",
        "parameters": [
          {
            "name": "employerName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results returned.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        },
        "security": [
          {
            "ApiRoles": [
              "Authorize"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Account": {
        "type": "object",
        "properties": {
          "AccountName": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          },
          "PublicAccountHashId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer"
          },
          "Href": {
            "type": "string"
          },
          "ApprenticeshipEmployerType": {
            "type": "string"
          },
          "AccountAgreementType": {
            "type": "string"
          }
        }
      },
      "CreateEmployerAccountViaProviderRequestModel": {
        "type": "object",
        "required": [
          "RequestId",
          "UserRef",
          "EmployerOrganisationName",
          "EmployerPaye",
          "EmployerAorn",
          "EmployerAddress",
          "EmployerOrganisationReferenceNumber"
        ],
        "properties": {
          "RequestId": {
            "type": "string"
          },
          "UserRef": {
            "type": "string",
            "format": "uuid"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "EmployerOrganisationName": {
            "type": "string"
          },
          "EmployerPaye": {
            "type": "string"
          },
          "EmployerAorn": {
            "type": "string"
          },
          "EmployerAddress": {
            "type": "string"
          },
          "EmployerOrganisationReferenceNumber": {
            "type": "string"
          }
        }
      },
      "CreateEmployerAccountViaProviderResponseModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          }
        }
      },
      "Membership": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "UserId": {
            "type": "integer"
          },
          "Role": {
            "type": "string"
          },
          "CreatedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRoles": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
