{
  "openapi": "3.1.0",
  "info": {
    "title": "OrganisationController API",
    "version": "1.0.0",
    "description": "API endpoints for managing organisations under employer accounts."
  },
  "paths": {
    "/accounts/{hashedAccountId}/organisations/nextStep": {
      "get": {
        "summary": "Organisation added next steps",
        "operationId": "OrganisationAddedNextSteps",
        "parameters": [
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Go to organisation next steps",
        "operationId": "GoToNextStep",
        "parameters": [
          {
            "name": "nextStep",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next step processed successfully"
          },
          "400": {
            "description": "Invalid next step chosen"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/nextStepSearch": {
      "get": {
        "summary": "Organisation added next steps search",
        "operationId": "OrganisationAddedNextStepsSearch",
        "parameters": [
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/review": {
      "get": {
        "summary": "Review organisation details",
        "operationId": "ReviewOrganisationDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Displays the organisation details review"
          }
        }
      },
      "post": {
        "summary": "Process organisation review",
        "operationId": "ProcessReviewSelection",
        "parameters": [
          {
            "name": "updateChoice",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationAddress",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataSourceFriendlyName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review processed successfully"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/confirm": {
      "post": {
        "summary": "Confirm organisation details",
        "operationId": "ConfirmOrganisationDetails",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNewLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Organisation confirmation successful"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/PostUpdateSelection": {
      "post": {
        "summary": "Post organisation update selection",
        "operationId": "PostUpdateSelection",
        "parameters": [
          {
            "name": "nextStep",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Next organisation update step processed successfully"
          },
          "400": {
            "description": "Invalid next step chosen"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "line3": {
            "type": "string"
          },
          "line4": {
            "type": "string"
          },
          "line5": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        }
      },
      "CreateNewLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "incorporatedDate": {
            "type": "string",
            "format": "date"
          },
          "externalUserId": {
            "type": "string"
          },
          "legalEntityStatus": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "publicSectorDataSource": {
            "type": "integer",
            "format": "int32"
          },
          "sector": {
            "type": "string"
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
