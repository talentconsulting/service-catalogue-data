{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/organisations/nextStep": {
      "post": {
        "summary": "Process the next steps for the organisation",
        "parameters": [
          {
            "name": "nextStep",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/nextStepSearch": {
      "get": {
        "summary": "Get next steps for organisation added during search",
        "parameters": [
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/confirm": {
      "post": {
        "summary": "Confirm the addition of a legal entity to an account",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNewLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "401": {
            "description": "Unauthorized access"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/review": {
      "post": {
        "summary": "Process review selection for organisation details",
        "parameters": [
          {
            "name": "updateChoice",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationAddress",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dataSourceFriendlyName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/PostUpdateSelection": {
      "post": {
        "summary": "Handle post-update selection for organisations",
        "parameters": [
          {
            "name": "nextStep",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FlashMessageViewModel": {
        "type": "object",
        "properties": {
          "Headline": {
            "type": "string"
          },
          "Message": {
            "type": "string"
          },
          "SubMessage": {
            "type": "string"
          },
          "Severity": {
            "type": "string",
            "enum": [
              "Complete",
              "Success",
              "Info",
              "Danger",
              "Warning",
              "Error",
              "Okay"
            ]
          },
          "ErrorMessages": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "RedirectButtonMessage": {
            "type": "string"
          },
          "HiddenFlashMessageInformation": {
            "type": "string"
          }
        }
      },
      "OrganisationAddedNextStepsViewModel": {
        "type": "object",
        "properties": {
          "ErrorMessage": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string"
          },
          "ShowWizard": {
            "type": "boolean"
          },
          "HashedAgreementId": {
            "type": "string"
          }
        }
      },
      "IncorrectOrganisationDetailsViewModel": {
        "type": "object",
        "properties": {
          "DataSourceFriendlyName": {
            "type": "string"
          }
        }
      },
      "OrganisationUpdatedNextStepsViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "ErrorMessage": {
            "type": "string"
          }
        }
      },
      "CreateNewLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Code": {
            "type": "string"
          },
          "Address": {
            "$ref": "#/components/schemas/Address"
          },
          "IncorporatedDate": {
            "type": "string",
            "format": "date"
          },
          "ExternalUserId": {
            "type": "string"
          },
          "LegalEntityStatus": {
            "type": "string",
            "nullable": true
          },
          "Source": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "PublicSectorDataSource": {
            "type": "integer",
            "nullable": true
          },
          "Sector": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "Line1": {
            "type": "string"
          },
          "Line2": {
            "type": "string"
          },
          "Line3": {
            "type": "string"
          },
          "Line4": {
            "type": "string"
          },
          "Line5": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
