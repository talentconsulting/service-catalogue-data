{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation Controller API",
    "description": "API endpoints for managing organisations in employer accounts.",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/organisations/nextStep": {
      "get": {
        "summary": "Get organisation added next steps",
        "parameters": [
          {
            "name": "organisationName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Go to next step",
        "operationId": "OrganisationGoToNextStep",
        "parameters": [
          {
            "name": "nextStep",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/nextStepSearch": {
      "get": {
        "summary": "Search organisation added next steps",
        "parameters": [
          {
            "name": "organisationName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/confirm": {
      "post": {
        "summary": "Confirm organisation",
        "operationId": "OrganisationConfirm",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNewLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/review": {
      "get": {
        "summary": "Review organisation details",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Process review selection",
        "operationId": "ProcessOrganisationReview",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessReviewSelectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/PostUpdateSelection": {
      "post": {
        "summary": "Handle post-update selection",
        "operationId": "OrganisationPostUpdateSelection",
        "parameters": [
          {
            "name": "nextStep",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateNewLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Code": {
            "type": "string"
          },
          "Address": {
            "$ref": "#/components/schemas/Address"
          },
          "IncorporatedDate": {
            "type": "string",
            "format": "date"
          },
          "ExternalUserId": {
            "type": "string"
          },
          "LegalEntityStatus": {
            "type": "string"
          },
          "Source": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "PublicSectorDataSource": {
            "type": "integer",
            "format": "int32"
          },
          "Sector": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "townOrCity": {
            "type": "string"
          },
          "county": {
            "type": "string"
          },
          "postCode": {
            "type": "string"
          }
        }
      },
      "ProcessReviewSelectionRequest": {
        "type": "object",
        "properties": {
          "updateChoice": {
            "type": "string"
          },
          "accountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "organisationName": {
            "type": "string"
          },
          "organisationAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "dataSourceFriendlyName": {
            "type": "string"
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      }
    }
  }
}
