{
  "openapi": "3.1.0",
  "info": {
    "title": "OrganisationController API",
    "description": "API for managing organisations within an employer account.",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{hashedAccountId}/organisations/nextStep": {
      "get": {
        "summary": "Organisation Added Next Steps",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View showing next steps after adding an organisation."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/nextStepSearch": {
      "get": {
        "summary": "Organisation Added Next Steps Search",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search-specific view showing next steps after adding an organisation."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/confirm": {
      "post": {
        "summary": "Confirm Organisation",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNewLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirection to the next steps page after confirmation."
          },
          "401": {
            "description": "Unauthorized access."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/review": {
      "post": {
        "summary": "Process Organisation Review Selection",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewSelectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "View reflecting the outcome of the review selection process."
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/PostUpdateSelection": {
      "post": {
        "summary": "Handle Post-Update Organisation Selection",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostUpdateSelectionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "View reflecting the chosen next step after update."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateNewLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "incorporatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "externalUserId": {
            "type": "string"
          },
          "legalEntityStatus": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "publicSectorDataSource": {
            "type": "integer",
            "format": "int32"
          },
          "sector": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "line3": {
            "type": "string"
          },
          "line4": {
            "type": "string"
          },
          "line5": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      },
      "ReviewSelectionRequest": {
        "type": "object",
        "properties": {
          "updateChoice": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          },
          "accountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "organisationName": {
            "type": "string"
          },
          "organisationAddress": {
            "type": "string"
          },
          "dataSourceFriendlyName": {
            "type": "string"
          }
        }
      },
      "PostUpdateSelectionRequest": {
        "type": "object",
        "properties": {
          "nextStep": {
            "type": "string"
          },
          "hashedAccountId": {
            "type": "string"
          }
        }
      }
    }
  }
}
