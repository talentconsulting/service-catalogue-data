{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation Management API",
    "version": "1.0.0",
    "description": "API for managing organisations in the SFA DAS Employer Accounts system"
  },
  "paths": {
    "/accounts/{hashedAccountId}/organisations/nextStep": {
      "post": {
        "summary": "Handle next steps selection for an organisation",
        "operationId": "GoToNextStep",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "nextStep": {
                    "type": "string"
                  },
                  "organisationName": {
                    "type": "string"
                  },
                  "hashedAgreementId": {
                    "type": "string"
                  }
                },
                "required": [
                  "nextStep"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the selected next step"
          },
          "200": {
            "description": "Error selection response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/nextStepSearch": {
      "get": {
        "summary": "Search for organisation added next steps",
        "operationId": "OrganisationAddedNextStepsSearch",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisationName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hashedAgreementId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/confirm": {
      "post": {
        "summary": "Confirm organisation details to create a new legal entity",
        "operationId": "Confirm",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNewLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the next step after successful organisation confirmation"
          },
          "401": {
            "description": "Unauthorized response"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/review": {
      "get": {
        "summary": "Review organisation details",
        "operationId": "Review",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns details for organisation review"
          }
        }
      },
      "post": {
        "summary": "Process organisation review selection",
        "operationId": "ProcessReviewSelection",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "updateChoice": {
                    "type": "string"
                  },
                  "accountLegalEntityPublicHashedId": {
                    "type": "string"
                  },
                  "organisationName": {
                    "type": "string"
                  },
                  "organisationAddress": {
                    "type": "string"
                  },
                  "dataSourceFriendlyName": {
                    "type": "string"
                  }
                },
                "required": [
                  "updateChoice",
                  "accountLegalEntityPublicHashedId"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the selected review outcome"
          },
          "302": {
            "description": "Redirects to the default organisation agreement details"
          }
        }
      }
    },
    "/accounts/{hashedAccountId}/organisations/PostUpdateSelection": {
      "post": {
        "summary": "Handle post-update selection for organisation",
        "operationId": "GoToPostUpdateSelection",
        "parameters": [
          {
            "name": "hashedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "nextStep": {
                    "type": "string"
                  }
                },
                "required": [
                  "nextStep"
                ]
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the selected post-update step"
          },
          "200": {
            "description": "Error selection response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FlashMessageViewModel": {
        "type": "object",
        "properties": {
          "headline": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "subMessage": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "Complete",
              "Success",
              "Info",
              "Danger",
              "Warning",
              "Error",
              "Okay"
            ]
          },
          "severityCssClass": {
            "type": "string"
          },
          "errorMessages": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "redirectButtonMessage": {
            "type": "string"
          },
          "hiddenFlashMessageInformation": {
            "type": "string"
          }
        }
      },
      "CreateNewLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "incorporatedDate": {
            "type": "string",
            "format": "date"
          },
          "externalUserId": {
            "type": "string"
          },
          "legalEntityStatus": {
            "type": "string"
          },
          "source": {
            "$ref": "#/components/schemas/OrganisationType"
          },
          "publicSectorDataSource": {
            "type": "integer",
            "format": "int32"
          },
          "sector": {
            "type": "string"
          }
        }
      },
      "OrganisationType": {
        "type": "string",
        "enum": [
          "CompaniesHouse",
          "Charities",
          "PublicBodies",
          "Other",
          "PensionsRegulator"
        ]
      },
      "OrganisationAddedNextStepsViewModel": {
        "type": "object",
        "properties": {
          "errorMessage": {
            "type": "string"
          },
          "organisationName": {
            "type": "string"
          },
          "showWizard": {
            "type": "boolean"
          },
          "hashedAgreementId": {
            "type": "string"
          }
        }
      },
      "OrganisationUpdatedNextStepsViewModel": {
        "type": "object",
        "properties": {
          "hashedAccountId": {
            "type": "string"
          },
          "errorMessage": {
            "type": "string"
          }
        }
      },
      "IncorrectOrganisationDetailsViewModel": {
        "type": "object",
        "properties": {
          "dataSourceFriendlyName": {
            "type": "string"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "line1": {
            "type": "string"
          },
          "line2": {
            "type": "string"
          },
          "line3": {
            "type": "string"
          },
          "line4": {
            "type": "string"
          },
          "line5": {
            "type": "string"
          },
          "postcode": {
            "type": "string",
            "format": "postcode"
          }
        }
      },
      "OrganisationStatus": {
        "type": "string",
        "enum": [
          "None",
          "Active",
          "Dissolved",
          "Liquidation",
          "Receivership",
          "Administration",
          "VoluntaryArrangement",
          "ConvertedClosed",
          "InsolvencyProceedings"
        ]
      },
      "OrchestratorResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "exception": {
            "type": "string"
          },
          "flashMessage": {
            "$ref": "#/components/schemas/FlashMessageViewModel"
          },
          "redirectUrl": {
            "type": "string"
          },
          "redirectButtonMessage": {
            "type": "string"
          }
        }
      },
      "OrchestratorResponse_OrganisationAddedNextStepsViewModel": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OrganisationAddedNextStepsViewModel"
          },
          "flashMessage": {
            "$ref": "#/components/schemas/FlashMessageViewModel"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "OrchestratorResponse_OrganisationUpdatedNextStepsViewModel": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/OrganisationUpdatedNextStepsViewModel"
          },
          "flashMessage": {
            "$ref": "#/components/schemas/FlashMessageViewModel"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
