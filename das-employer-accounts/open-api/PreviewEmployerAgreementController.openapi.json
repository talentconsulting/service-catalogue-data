{
  "openapi": "3.1.0",
  "info": {
    "title": "PreviewEmployerAgreement API",
    "description": "API for previewing employer agreements.",
    "version": "1.0.0"
  },
  "paths": {
    "/agreements/preview": {
      "get": {
        "summary": "Preview employer agreement",
        "description": "Fetches the latest employer agreement template for preview purposes.",
        "operationId": "PreviewEmployerAgreementController_Index",
        "parameters": [
          {
            "name": "legalEntityName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The encrypted name of the legal entity."
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The URL to which the user will be redirected after viewing the preview."
          }
        ],
        "responses": {
          "200": {
            "description": "The agreement preview view with the provided legal entity name and latest agreement template.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
