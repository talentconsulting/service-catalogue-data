{
  "openapi": "3.1.0",
  "info": {
    "title": "PreviewEmployerAgreement API",
    "version": "1.0.0"
  },
  "paths": {
    "/agreements/preview": {
      "get": {
        "summary": "Preview an employer agreement",
        "operationId": "PreviewEmployerAgreement_Index",
        "parameters": [
          {
            "name": "legalEntityName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The encrypted legal entity name to preview in the employer agreement."
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uri"
            },
            "description": "The URL to return to after previewing the employer agreement."
          }
        ],
        "responses": {
          "200": {
            "description": "The employer agreement preview page.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": [
              "read"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
