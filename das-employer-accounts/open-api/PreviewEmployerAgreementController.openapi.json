{
  "openapi": "3.1.0",
  "info": {
    "title": "Preview Employer Agreement API",
    "version": "1.0.0"
  },
  "paths": {
    "/agreements/preview": {
      "get": {
        "operationId": "GetPreviewEmployerAgreement",
        "summary": "Preview the employer agreement",
        "description": "Fetches the details for previewing an employer agreement template.",
        "parameters": [
          {
            "name": "legalEntityName",
            "in": "query",
            "required": true,
            "description": "Encrypted name of the legal entity.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": true,
            "description": "The URL to return to after previewing the agreement.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The view for the employer agreement preview was successfully returned.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML view for the agreement preview."
                }
              }
            }
          },
          "400": {
            "description": "Bad request. The input parameters might be invalid."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
