{
  "openapi": "3.1.0",
  "info": {
    "title": "Preview Employer Agreement API",
    "version": "1.0.0"
  },
  "paths": {
    "/agreements/preview": {
      "get": {
        "summary": "Preview an employer agreement",
        "operationId": "PreviewEmployerAgreement_Index",
        "parameters": [
          {
            "name": "legalEntityName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Encrypted legal entity name to be decrypted."
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "URL to return to after preview."
          }
        ],
        "responses": {
          "200": {
            "description": "Employer Agreement preview returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PreviewEmployerAgreementViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "oauth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "PreviewEmployerAgreementViewModel": {
        "type": "object",
        "properties": {
          "ReturnUrl": {
            "type": "string",
            "nullable": true
          },
          "Choice": {
            "type": "string",
            "nullable": true
          },
          "PreviouslySignedEmployerAgreement": {
            "type": "string",
            "nullable": true
          },
          "HasAcknowledgedAgreement": {
            "type": "boolean"
          },
          "EmployerAgreement": {
            "$ref": "#/components/schemas/EmployerAgreementView"
          }
        },
        "required": [
          "HasAcknowledgedAgreement",
          "EmployerAgreement"
        ]
      },
      "EmployerAgreementView": {
        "type": "object",
        "properties": {
          "LegalEntityName": {
            "type": "string"
          },
          "TemplateId": {
            "type": "string",
            "nullable": true
          },
          "TemplatePartialViewName": {
            "type": "string"
          }
        },
        "required": [
          "LegalEntityName",
          "TemplatePartialViewName"
        ]
      }
    }
  }
}
