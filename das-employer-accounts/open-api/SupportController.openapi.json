{
  "openapi": "3.1.0",
  "info": {
    "title": "Support API",
    "version": "1.0.0",
    "description": "API for support operations in the employer accounts system."
  },
  "paths": {
    "/api/support/change-role": {
      "post": {
        "summary": "Change the role of a team member",
        "operationId": "ChangeRole",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportChangeTeamMemberRoleCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The role was successfully changed."
          },
          "500": {
            "description": "Internal server error occurred."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/support/resend-invitation": {
      "post": {
        "summary": "Resend an invitation to a team member",
        "operationId": "ResendInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportResendInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The invitation was successfully resent."
          },
          "500": {
            "description": "Internal server error occurred."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/support/send-invitation": {
      "post": {
        "summary": "Send a new invitation to a team member",
        "operationId": "SendInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportCreateInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The invitation was successfully sent."
          },
          "500": {
            "description": "Internal server error occurred."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SupportChangeTeamMemberRoleCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "Email",
          "Role"
        ]
      },
      "SupportCreateInvitationCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "NameOfPersonBeingInvited": {
            "type": "string"
          },
          "EmailOfPersonBeingInvited": {
            "type": "string"
          },
          "RoleOfPersonBeingInvited": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "NameOfPersonBeingInvited",
          "EmailOfPersonBeingInvited",
          "RoleOfPersonBeingInvited"
        ]
      },
      "SupportResendInvitationCommand": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          }
        },
        "required": [
          "Email",
          "HashedAccountId"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ],
        "description": "Roles that a team member can have."
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadUserAccounts": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
