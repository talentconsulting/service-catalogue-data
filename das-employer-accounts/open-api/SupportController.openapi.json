{
  "openapi": "3.1.0",
  "info": {
    "title": "Support API",
    "version": "1.0.0",
    "description": "API for managing support-related operations, such as changing team member roles, sending and resending invitations."
  },
  "paths": {
    "/api/support/change-role": {
      "post": {
        "summary": "Change the role of a team member",
        "operationId": "changeRole",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportChangeTeamMemberRoleCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role changed successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/support/resend-invitation": {
      "post": {
        "summary": "Resend an invitation to a user",
        "operationId": "resendInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportResendInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation resent successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/support/send-invitation": {
      "post": {
        "summary": "Send an invitation to a user",
        "operationId": "sendInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportCreateInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation sent successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "ApiRoles.ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SupportChangeTeamMemberRoleCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string",
            "description": "The hashed account ID of the team member."
          },
          "Email": {
            "type": "string",
            "description": "The email of the team member whose role is being changed."
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "Email",
          "Role"
        ]
      },
      "SupportCreateInvitationCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string",
            "description": "The hashed account ID of the account to which the invitation belongs."
          },
          "NameOfPersonBeingInvited": {
            "type": "string",
            "description": "The name of the person being invited."
          },
          "EmailOfPersonBeingInvited": {
            "type": "string",
            "description": "The email of the person being invited."
          },
          "RoleOfPersonBeingInvited": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "NameOfPersonBeingInvited",
          "EmailOfPersonBeingInvited",
          "RoleOfPersonBeingInvited"
        ]
      },
      "SupportResendInvitationCommand": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string",
            "description": "The email of the person to whom the invitation is being resent."
          },
          "HashedAccountId": {
            "type": "string",
            "description": "The hashed account ID of the account to which the invitation belongs."
          }
        },
        "required": [
          "Email",
          "HashedAccountId"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ],
        "description": "Defines the role of a team member."
      }
    },
    "securitySchemes": {
      "ApiRoles.ReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
