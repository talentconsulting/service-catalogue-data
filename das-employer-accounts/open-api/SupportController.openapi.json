{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Support API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/support/change-role": {
      "post": {
        "summary": "Change Team Member Role",
        "description": "Change the role of a team member for a given account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportChangeTeamMemberRoleCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role changed successfully."
          },
          "500": {
            "description": "Internal Server Error."
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/support/resend-invitation": {
      "post": {
        "summary": "Resend Invitation",
        "description": "Resend an invitation to a specific email for a given account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportResendInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation resent successfully."
          },
          "500": {
            "description": "Internal Server Error."
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    },
    "/api/support/send-invitation": {
      "post": {
        "summary": "Send Invitation",
        "description": "Send an invitation to a new team member for a given account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportCreateInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation sent successfully."
          },
          "500": {
            "description": "Internal Server Error."
          }
        },
        "security": [
          {
            "ApiRoles_ReadUserAccounts": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SupportChangeTeamMemberRoleCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "Email",
          "Role"
        ]
      },
      "SupportResendInvitationCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "HashedAccountId",
          "Email"
        ]
      },
      "SupportCreateInvitationCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "NameOfPersonBeingInvited": {
            "type": "string"
          },
          "EmailOfPersonBeingInvited": {
            "type": "string",
            "format": "email"
          },
          "RoleOfPersonBeingInvited": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "NameOfPersonBeingInvited",
          "EmailOfPersonBeingInvited",
          "RoleOfPersonBeingInvited"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ],
        "description": "The role of the team member, with predefined values: None, Owner, Transactor, Viewer."
      }
    },
    "securitySchemes": {
      "ApiRoles_ReadUserAccounts": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "Requires the 'ReadUserAccounts' policy for authorization."
      }
    }
  }
}
