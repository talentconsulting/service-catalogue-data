{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts Support API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/support/change-role": {
      "post": {
        "summary": "Change the role of a team member",
        "description": "Allows modification of a team member's role within an account.",
        "operationId": "changeRole",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportChangeTeamMemberRoleCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Role successfully changed."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "defaultAuth": []
          }
        ]
      }
    },
    "/api/support/resend-invitation": {
      "post": {
        "summary": "Resend an account invitation",
        "description": "Resends an invitation to a team member.",
        "operationId": "resendInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportResendInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation successfully resent."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "defaultAuth": []
          }
        ]
      }
    },
    "/api/support/send-invitation": {
      "post": {
        "summary": "Send a new account invitation",
        "description": "Sends a new invitation to a prospective team member.",
        "operationId": "sendInvitation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SupportCreateInvitationCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invitation successfully sent."
          },
          "500": {
            "description": "Internal server error."
          }
        },
        "security": [
          {
            "defaultAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SupportChangeTeamMemberRoleCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "Email",
          "Role"
        ]
      },
      "SupportCreateInvitationCommand": {
        "type": "object",
        "properties": {
          "HashedAccountId": {
            "type": "string"
          },
          "NameOfPersonBeingInvited": {
            "type": "string"
          },
          "EmailOfPersonBeingInvited": {
            "type": "string"
          },
          "RoleOfPersonBeingInvited": {
            "$ref": "#/components/schemas/Role"
          }
        },
        "required": [
          "HashedAccountId",
          "NameOfPersonBeingInvited",
          "EmailOfPersonBeingInvited",
          "RoleOfPersonBeingInvited"
        ]
      },
      "SupportResendInvitationCommand": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "HashedAccountId": {
            "type": "string"
          }
        },
        "required": [
          "Email",
          "HashedAccountId"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "None",
          "Owner",
          "Transactor",
          "Viewer"
        ]
      }
    },
    "securitySchemes": {
      "defaultAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
