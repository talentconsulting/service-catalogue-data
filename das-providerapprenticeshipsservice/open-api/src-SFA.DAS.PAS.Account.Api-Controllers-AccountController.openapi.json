{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Apprenticeships Service Account API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/account/{ukprn}/users": {
      "get": {
        "summary": "Get Account Users",
        "description": "Retrieves a list of account users for the specified UKPRN.",
        "operationId": "GetAccountUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The unique identifier for the provider.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK. The list of account users was successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiRolesAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiRolesAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
