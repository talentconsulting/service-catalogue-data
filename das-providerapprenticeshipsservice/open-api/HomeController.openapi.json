{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Apprenticeships Service",
    "version": "1.0.0"
  },
  "paths": {
    "/signed-out": {
      "get": {
        "operationId": "ProviderSignedOut",
        "summary": "Handles signed-out redirection or view.",
        "tags": [
          "Home"
        ],
        "responses": {
          "302": {
            "description": "Redirect to home or auto-sign-out page."
          },
          "200": {
            "description": "AutoSignOut view is returned."
          }
        }
      }
    },
    "/help": {
      "get": {
        "operationId": "Help",
        "summary": "Displays the help page.",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "Help view is returned."
          }
        }
      }
    },
    "/": {
      "get": {
        "operationId": "HomeIndex",
        "summary": "Home page or redirect to account home.",
        "tags": [
          "Home"
        ],
        "responses": {
          "302": {
            "description": "Redirect to account home."
          },
          "200": {
            "description": "Home page view is returned."
          }
        }
      }
    },
    "/terms": {
      "get": {
        "operationId": "Terms",
        "summary": "Displays the terms page.",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "Terms view is returned."
          }
        }
      }
    },
    "/accessibility": {
      "get": {
        "operationId": "Accessibility",
        "summary": "Displays accessibility information.",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "Accessibility view is returned."
          }
        }
      }
    },
    "/privacy": {
      "get": {
        "operationId": "Privacy",
        "summary": "Displays the privacy policy.",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "Privacy view is returned."
          }
        }
      }
    },
    "/cookies": {
      "get": {
        "operationId": "Cookies",
        "summary": "Displays the cookies policy.",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "Cookies view is returned."
          }
        }
      }
    },
    "/cookie-details": {
      "get": {
        "operationId": "CookieDetails",
        "summary": "Displays detailed information about cookies.",
        "tags": [
          "Home"
        ],
        "responses": {
          "200": {
            "description": "Cookie details view is returned."
          }
        }
      }
    },
    "/signin": {
      "get": {
        "operationId": "SignIn",
        "summary": "Handles user sign-in process.",
        "tags": [
          "Authentication"
        ],
        "security": [
          {
            "openidConnect": []
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to account home after authentication."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "openidConnect": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://example.com/.well-known/openid-configuration"
      }
    },
    "schemas": {}
  }
}
