{
  "openapi": "3.1.0",
  "info": {
    "title": "User API",
    "version": "1.0"
  },
  "paths": {
    "/api/user/{userRef}": {
      "get": {
        "summary": "Retrieve user settings",
        "description": "Fetches the settings for a specific user.",
        "operationId": "getUserSettings",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The reference for the user."
          }
        ],
        "responses": {
          "200": {
            "description": "User settings successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserSettings"
                }
              }
            }
          },
          "404": {
            "description": "User settings not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserSettings": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
