{
  "openapi": "3.1.0",
  "info": {
    "title": "Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/rules": {
      "get": {
        "operationId": "getRules",
        "summary": "Retrieve all rules.",
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/rules/available-dates/{accountLegalEntityId}": {
      "get": {
        "operationId": "getAvailableDates",
        "summary": "Get available dates by account legal entity ID.",
        "parameters": [
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Available dates retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/rules/account/{accountId}": {
      "get": {
        "operationId": "getAccountRules",
        "summary": "Retrieve rules for a specific account ID.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account rules retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid account ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/rules/upcoming": {
      "post": {
        "operationId": "acknowledgeRuleAsRead",
        "summary": "Acknowledge a user rule as read.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRuleAcknowledgementCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArgumentErrorViewModel": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          },
          "Params": {
            "type": "string"
          }
        }
      },
      "CreateUserRuleAcknowledgementCommand": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "RuleId": {
            "type": "integer",
            "format": "int64"
          },
          "TypeOfRule": {
            "type": "string",
            "enum": [
              "None",
              "CourseRule",
              "GlobalRule"
            ]
          }
        },
        "required": [
          "Id",
          "RuleId",
          "TypeOfRule"
        ]
      }
    }
  }
}
