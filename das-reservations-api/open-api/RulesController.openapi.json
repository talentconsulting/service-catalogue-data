{
  "openapi": "3.1.0",
  "info": {
    "title": "Reservations API",
    "version": "1.0.0",
    "description": "API for managing reservation rules and acknowledgements."
  },
  "paths": {
    "/api/Rules": {
      "get": {
        "summary": "Get all rules",
        "operationId": "getAllRules",
        "responses": {
          "200": {
            "description": "Successful response with rules",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rule"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Rules/available-dates/{accountLegalEntityId}": {
      "get": {
        "summary": "Get available dates for an account legal entity",
        "operationId": "getAvailableDates",
        "parameters": [
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with available dates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "date"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid parameters provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/Rules/account/{accountId}": {
      "get": {
        "summary": "Get rules for a specific account",
        "operationId": "getAccountRules",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with rules for the account",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Rule"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid account ID provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/Rules/upcoming": {
      "post": {
        "summary": "Acknowledge a rule as read",
        "operationId": "acknowledgeRuleAsRead",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRuleAcknowledgementCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledgement succeeded"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Rule": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "activeFrom": {
            "type": "string",
            "format": "date-time"
          },
          "activeTo": {
            "type": "string",
            "format": "date-time"
          },
          "restriction": {
            "type": "integer",
            "format": "int32"
          },
          "courseId": {
            "type": "string"
          }
        }
      },
      "ArgumentErrorViewModel": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "params": {
            "type": "string"
          }
        }
      },
      "CreateUserRuleAcknowledgementCommand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ruleId": {
            "type": "integer",
            "format": "int64"
          },
          "typeOfRule": {
            "type": "string",
            "enum": [
              "None",
              "CourseRule",
              "GlobalRule"
            ]
          }
        },
        "required": [
          "id",
          "ruleId",
          "typeOfRule"
        ]
      }
    }
  }
}
