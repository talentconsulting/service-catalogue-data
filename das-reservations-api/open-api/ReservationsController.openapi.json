{
  "openapi": "3.1.0",
  "info": {
    "title": "Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/reservations/accounts/Bulk-Create": {
      "post": {
        "operationId": "BulkCreateReservations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkCreateReservationsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created reservations",
            "content": {
              "application/json": {
                "example": {
                  "message": "Reservations created"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/accounts/{accountId}/reservations": {
      "get": {
        "operationId": "GetAllReservations",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservations retrieved successfully",
            "content": {
              "application/json": {
                "example": {
                  "reservations": []
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      },
      "post": {
        "operationId": "CreateReservation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reservation"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Reservation created successfully",
            "content": {
              "application/json": {
                "example": {
                  "reservation": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "422": {
            "description": "Unprocessable entity"
          }
        }
      }
    },
    "/api/reservations/{id}": {
      "get": {
        "operationId": "GetReservationById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation retrieved successfully",
            "content": {
              "application/json": {
                "example": {
                  "reservation": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Reservation not found"
          }
        }
      },
      "delete": {
        "operationId": "DeleteReservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "employerDeleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Reservation deleted successfully"
          },
          "400": {
            "description": "Invalid request"
          },
          "410": {
            "description": "Reservation permanently gone"
          }
        }
      }
    },
    "/api/reservations/search": {
      "get": {
        "operationId": "SearchReservations",
        "parameters": [
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedCourse",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedEmployer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedStartDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "selectedLearningType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/LearningType"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageItemCount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservations found successfully",
            "content": {
              "application/json": {
                "example": {
                  "reservations": []
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "No reservations found"
          }
        }
      }
    },
    "/api/reservations/validate/{id}": {
      "get": {
        "operationId": "ValidateReservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "courseCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateReservationViewModel"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Reservation not found"
          }
        }
      }
    },
    "/api/reservations/accounts/{accountLegalEntityId}/bulk-create": {
      "post": {
        "operationId": "BulkCreateReservationsForEntity",
        "parameters": [
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkReservation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservations created for entity successfully",
            "content": {
              "application/json": {
                "example": {}
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Entity not found"
          }
        }
      }
    },
    "/api/reservations/{id}/change": {
      "post": {
        "operationId": "ChangeReservationParty",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeOfPartyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Party changed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeOfPartyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/reservations/accounts/bulk-validate": {
      "post": {
        "operationId": "BulkValidateReservations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BulkValidateReservationRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk validation completed",
            "content": {
              "application/json": {
                "example": {
                  "message": "Validated successfully"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArgumentErrorViewModel": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          },
          "Params": {
            "type": "string"
          }
        }
      },
      "BulkCreateReservationsRequest": {
        "type": "object",
        "properties": {
          "Reservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkCreateReservation"
            }
          }
        }
      },
      "BulkCreateReservation": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "TransferSenderAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "ULN": {
            "type": "string"
          },
          "RowNumber": {
            "type": "integer"
          }
        }
      },
      "BulkReservation": {
        "type": "object",
        "properties": {
          "Count": {
            "type": "integer"
          },
          "TransferSenderId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "BulkValidateReservationRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "TransferSenderAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "RowNumber": {
            "type": "integer"
          }
        }
      },
      "ChangeOfPartyRequest": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer"
          }
        }
      },
      "ChangeOfPartyResponse": {
        "type": "object",
        "properties": {
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "IsLevyAccount": {
            "type": "boolean"
          },
          "TransferSenderAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ValidateReservationViewModel": {
        "type": "object",
        "properties": {
          "ValidationErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationValidationErrorViewModel"
            }
          }
        }
      },
      "ReservationValidationErrorViewModel": {
        "type": "object",
        "properties": {
          "PropertyName": {
            "type": "string"
          },
          "Reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
