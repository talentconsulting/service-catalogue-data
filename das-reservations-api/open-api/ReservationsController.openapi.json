{
  "openapi": "3.1.0",
  "info": {
    "title": "Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Reservations/accounts/Bulk-Create": {
      "post": {
        "summary": "Bulk Create Reservations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkCreateReservationsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reservations created successfully"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/accounts/{accountId}/Reservations/": {
      "get": {
        "summary": "Get All Reservations for Account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of Reservations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Reservation"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "post": {
        "summary": "Create a Reservation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Reservation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservation created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/Reservations/{id}": {
      "get": {
        "summary": "Get Reservation by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reservation"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "delete": {
        "summary": "Delete Reservation by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "employerDeleted",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Reservation deleted successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "410": {
            "description": "Gone"
          }
        }
      }
    },
    "/api/Reservations/search": {
      "get": {
        "summary": "Search Reservations",
        "parameters": [
          {
            "name": "providerId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedCourse",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedEmployer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedStartDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "selectedLearningType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/LearningType"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageItemCount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Search results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/Reservations/validate/{id}": {
      "get": {
        "summary": "Validate a Reservation",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "courseCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateReservationViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/Reservations/accounts/{accountLegalEntityId}/bulk-create": {
      "post": {
        "summary": "Bulk Create Account Reservations",
        "parameters": [
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkReservation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reservations batch created successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/Reservations/{id}/change": {
      "post": {
        "summary": "Change Reservation Party",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeOfPartyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Change of party applied successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeOfPartyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/api/Reservations/accounts/bulk-validate": {
      "post": {
        "summary": "Bulk Validate Reservations",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BulkValidateReservationRequest"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation results",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkCreateReservationsRequest": {
        "type": "object",
        "properties": {
          "Reservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkCreateReservation"
            }
          }
        }
      },
      "BulkCreateReservation": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "TransferSenderAccountId": {
            "type": "integer"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "RowNumber": {
            "type": "integer"
          }
        }
      },
      "BulkReservation": {
        "type": "object",
        "properties": {
          "Count": {
            "type": "integer"
          },
          "TransferSenderId": {
            "type": "integer"
          }
        }
      },
      "BulkValidateReservationRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "TransferSenderAccountId": {
            "type": "integer"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "RowNumber": {
            "type": "integer"
          }
        }
      },
      "ChangeOfPartyRequest": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "ProviderId": {
            "type": "integer"
          }
        }
      },
      "ChangeOfPartyResponse": {
        "type": "object",
        "properties": {
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountId": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "IsLevyAccount": {
            "type": "boolean"
          },
          "TransferSenderAccountId": {
            "type": "integer"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ValidateReservationViewModel": {
        "type": "object",
        "properties": {
          "ValidationErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationValidationErrorViewModel"
            }
          }
        }
      },
      "ReservationValidationErrorViewModel": {
        "type": "object",
        "properties": {
          "PropertyName": {
            "type": "string"
          },
          "Reason": {
            "type": "string"
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      }
    }
  }
}
