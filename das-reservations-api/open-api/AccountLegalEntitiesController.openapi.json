{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Legal Entities API",
    "version": "1.0.0",
    "description": "API for managing account legal entities and their reservations."
  },
  "paths": {
    "/api/{accountId}/accountlegalentities": {
      "get": {
        "summary": "Get legal entities by account ID",
        "operationId": "GetByAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account."
          }
        ],
        "responses": {
          "200": {
            "description": "List of legal entities.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid account ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/status": {
      "get": {
        "summary": "Get account reservation status",
        "operationId": "GetAccountReservationStatus",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account."
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation status of the account.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid account ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Account legal entity not found."
          }
        }
      }
    },
    "/api/accountlegalentities/{legalEntityId}": {
      "get": {
        "summary": "Get legal entity by ID",
        "operationId": "GetByAccountLegalEntityId",
        "parameters": [
          {
            "name": "legalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the legal entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the legal entity.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Invalid legal entity ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/accountlegalentities/provider/{providerId}": {
      "get": {
        "summary": "Get legal entities by provider ID",
        "operationId": "GetByProviderId",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The ID of the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "List of provider permissions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid provider ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArgumentErrorViewModel": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string",
            "description": "Error message."
          },
          "Params": {
            "type": "string",
            "description": "Relevant parameters causing the error."
          }
        },
        "additionalProperties": false
      }
    }
  }
}
