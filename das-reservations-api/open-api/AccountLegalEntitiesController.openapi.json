{
  "openapi": "3.1.0",
  "info": {
    "title": "Account Legal Entities API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/{accountId}/AccountLegalEntities": {
      "get": {
        "summary": "Get legal entities by account ID",
        "operationId": "GetByAccountId",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Legal entities retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Argument exception occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/AccountLegalEntities/{legalEntityId}": {
      "get": {
        "summary": "Get legal entity by ID",
        "operationId": "GetByAccountLegalEntityId",
        "parameters": [
          {
            "name": "legalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Legal entity retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Argument exception occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{accountId}/status": {
      "get": {
        "summary": "Get reservation status by account ID",
        "operationId": "GetAccountReservationStatus",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Argument exception occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Entity not found"
          }
        }
      }
    },
    "/api/AccountLegalEntities/provider/{providerId}": {
      "get": {
        "summary": "Get legal entities by provider ID",
        "operationId": "GetByProviderId",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider permissions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Argument exception occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArgumentErrorViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArgumentErrorViewModel": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          },
          "Params": {
            "type": "string"
          }
        },
        "required": [
          "Message",
          "Params"
        ]
      }
    }
  }
