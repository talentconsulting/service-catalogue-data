{
  "openapi": "3.1.0",
  "info": {
    "title": "Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Courses/": {
      "get": {
        "summary": "Get all courses",
        "operationId": "GetAllCourses",
        "responses": {
          "200": {
            "description": "Successful response containing the list of courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursesViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CoursesViewModel": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "courses"
        ]
      }
    }
  }
}
