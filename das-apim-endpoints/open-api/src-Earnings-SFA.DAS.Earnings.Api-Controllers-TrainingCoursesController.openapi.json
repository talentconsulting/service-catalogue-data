{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "description": "API for accessing training course details",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/standards/{courseCode}": {
      "get": {
        "summary": "Get a standard by courseCode",
        "operationId": "GetStandard",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique code identifying a training course standard"
          }
        ],
        "responses": {
          "200": {
            "description": "Standard found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found"
          },
          "400": {
            "description": "Bad request due to an error during execution"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardResponse": {
        "type": "object",
        "properties": {}
      },
      "BaseMediatrResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string"
          },
          "errorCode": {
            "type": "string"
          },
          "value": {
            "type": "object"
          }
        }
      },
      "Route": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "format": "uuid"
          },
          "optionId": {
            "type": "string",
            "format": "uuid"
          },
          "nextPageOrder": {
            "type": "integer"
          },
          "nextSectionOrder": {
            "type": "integer"
          },
          "endForm": {
            "type": "boolean"
          },
          "endSection": {
            "type": "boolean"
          }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "questionId": {
            "type": "string",
            "format": "uuid"
          },
          "questionType": {
            "type": "string"
          },
          "answer": {
            "$ref": "#/components/schemas/Answer"
          }
        }
      },
      "Answer": {
        "type": "object",
        "properties": {
          "textValue": {
            "type": "string"
          },
          "numberValue": {
            "type": "number"
          },
          "dateValue": {
            "type": "string",
            "format": "date"
          },
          "multipleChoiceValue": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "radioChoiceValue": {
            "type": "string"
          }
        }
      }
    }
  }
}
