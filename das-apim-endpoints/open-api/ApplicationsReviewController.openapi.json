{
  "openapi": "3.1.0",
  "info": {
    "title": "Applications Review API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/application-reviews": {
      "post": {
        "summary": "Get application reviews",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetApplicationsForReviewQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Query successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsForReviewQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/share": {
      "put": {
        "summary": "Update application review sharing",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationReviewSharingCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Update successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}": {
      "get": {
        "summary": "Get application review by ID",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationForReviewByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/share-status": {
      "get": {
        "summary": "Get sharing status of application review",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationReviewSharingStatusByIdQueryHandler"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/feedback/{userType}": {
      "get": {
        "summary": "Get feedback for application review",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFeedbackForApplicationReviewByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/qfau-feedback-review": {
      "get": {
        "summary": "Get QFAU feedback for review confirmation",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetQfauFeedbackForApplicationReviewConfirmationQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/form-answers": {
      "get": {
        "summary": "Get form answers for application review",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Query successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationFormAnswersByReviewIdQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/export-data": {
      "get": {
        "summary": "Export application review data",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Export successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationExportDataQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/application-reviews/bulk-action": {
      "put": {
        "summary": "Perform bulk actions on application reviews",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkApplicationActionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Action executed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkApplicationActionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationsForReviewQuery": {
        "type": "object",
        "properties": {
          "applicationSearch": {
            "type": "string"
          },
          "awardingOrganisationSearch": {
            "type": "string"
          },
          "reviewerSearch": {
            "type": "string"
          },
          "unassignedOnly": {
            "type": "boolean"
          },
          "applicationStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewUser": {
            "type": "string"
          },
          "limit": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "applicationsWithNewMessages": {
            "type": "boolean"
          }
        }
      },
      "GetApplicationsForReviewQueryResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          },
          "availableReviewers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reviewer"
            }
          },
          "totalRecordsCount": {
            "type": "integer"
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "applicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "reference": {
            "type": "integer"
          },
          "qan": {
            "type": "string"
          },
          "awardingOrganisation": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "newMessage": {
            "type": "boolean"
          },
          "reviewer1": {
            "type": "string"
          },
          "reviewer2": {
            "type": "string"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Reviewer": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          }
        }
      },
      "UpdateApplicationReviewSharingCommand": {
        "type": "object",
        "properties": {
          "applicationReviewUserType": {
            "type": "string"
          },
          "shareApplication": {
            "type": "boolean"
          },
          "applicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "userType": {
            "type": "string"
          },
          "sentByName": {
            "type": "string"
          },
          "sentByEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "EmptyResponse": {
        "type": "object"
      }
    }
  }
}
