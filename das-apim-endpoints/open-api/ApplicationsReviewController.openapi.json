{
  "openapi": "3.1.0",
  "info": {
    "title": "Applications Review API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/application-reviews": {
      "post": {
        "summary": "Get application reviews",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetApplicationsForReviewQuery"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsForReviewQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/share": {
      "put": {
        "summary": "Update application review sharing",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationReviewSharingCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}": {
      "get": {
        "summary": "Get application for review by ID",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationForReviewByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/share-status": {
      "get": {
        "summary": "Get application review sharing status by ID",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationReviewSharingStatusByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/feedback/{userType}": {
      "get": {
        "summary": "Get feedback for application review by ID",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFeedbackForApplicationReviewByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/{applicationReviewId}/qfau-feedback-review": {
      "get": {
        "summary": "Get QFAU feedback for application review confirmation by ID",
        "parameters": [
          {
            "name": "applicationReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetQfauFeedbackForApplicationReviewConfirmationQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/application-reviews/bulk-action": {
      "put": {
        "summary": "Perform bulk application actions",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkApplicationActionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkApplicationActionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationsForReviewQuery": {
        "type": "object",
        "properties": {
          "ApplicationSearch": {
            "type": "string"
          },
          "AwardingOrganisationSearch": {
            "type": "string"
          },
          "ReviewerSearch": {
            "type": "string"
          },
          "UnassignedOnly": {
            "type": "boolean"
          },
          "ApplicationStatuses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ReviewUser": {
            "type": "string"
          },
          "Limit": {
            "type": "integer"
          },
          "Offset": {
            "type": "integer"
          },
          "ApplicationsWithNewMessages": {
            "type": "boolean"
          }
        }
      },
      "GetApplicationsForReviewQueryResponse": {
        "type": "object",
        "properties": {
          "Applications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string",
                  "format": "uuid"
                },
                "ApplicationReviewId": {
                  "type": "string",
                  "format": "uuid"
                },
                "Name": {
                  "type": "string"
                },
                "LastUpdated": {
                  "type": "string",
                  "format": "date-time"
                },
                "Reference": {
                  "type": "integer"
                },
                "Qan": {
                  "type": "string"
                },
                "AwardingOrganisation": {
                  "type": "string"
                }
              }
            }
          },
          "TotalRecordsCount": {
            "type": "integer"
          }
        }
      },
      "UpdateApplicationReviewSharingCommand": {
        "type": "object",
        "properties": {
          "ApplicationReviewUserType": {
            "type": "string"
          },
          "ShareApplication": {
            "type": "boolean"
          },
          "ApplicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "UserType": {
            "type": "string"
          },
          "SentByName": {
            "type": "string"
          },
          "SentByEmail": {
            "type": "string"
          }
        },
        "required": [
          "ApplicationReviewId",
          "UserType",
          "SentByName",
          "SentByEmail"
        ]
      },
      "EmptyResponse": {
        "type": "object"
      },
      "GetApplicationForReviewByIdQueryResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "ApplicationReviewId": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "LastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "Reference": {
            "type": "integer"
          },
          "AwardingOrganisation": {
            "type": "string"
          }
        }
      },
      "GetApplicationReviewSharingStatusByIdQueryResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "Value": {
            "type": "object",
            "properties": {
              "SharedWithSkillsEngland": {
                "type": "boolean"
              },
              "SharedWithOfqual": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "GetFeedbackForApplicationReviewByIdQueryResponse": {
        "type": "object",
        "properties": {
          "Owner": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "Comments": {
            "type": "string"
          },
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetQfauFeedbackForApplicationReviewConfirmationQueryResponse": {
        "type": "object",
        "properties": {
          "RelatedQualification": {
            "type": "object",
            "properties": {
              "Qan": {
                "type": "string"
              },
              "Name": {
                "type": "string"
              }
            }
          },
          "Owner": {
            "type": "string"
          },
          "Comments": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          }
        }
      },
      "BulkApplicationActionCommand": {
        "type": "object",
        "properties": {
          "ApplicationReviewIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "ActionType": {
            "type": "string"
          },
          "UserType": {
            "type": "string"
          },
          "SentByName": {
            "type": "string"
          },
          "SentByEmail": {
            "type": "string"
          }
        }
      },
      "BulkApplicationActionCommandResponse": {
        "type": "object",
        "properties": {
          "RequestedCount": {
            "type": "integer"
          },
          "UpdatedCount": {
            "type": "integer"
          },
          "ErrorCount": {
            "type": "integer"
          },
          "Errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ApplicationId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    }
  }
}
