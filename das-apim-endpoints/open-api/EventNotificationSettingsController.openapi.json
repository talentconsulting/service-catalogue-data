{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerAan Event Notifications Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/event-notifications-settings/locations": {
      "get": {
        "summary": "Get Event Notification Settings Locations",
        "operationId": "getEventNotificationSettingsLocations",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The employer account ID."
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "An optional search term to filter results."
          },
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The member ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with event notification settings locations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationsLocationsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetNotificationsLocationsResponse": {
        "type": "object",
        "description": "Response containing the event notification settings locations.",
        "additionalProperties": true
      }
    }
  }
}
