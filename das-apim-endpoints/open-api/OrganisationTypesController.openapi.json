{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation Types API",
    "version": "1.0.0",
    "description": "API for managing organisation types."
  },
  "paths": {
    "/organisation-types": {
      "get": {
        "summary": "Get Organisation Types",
        "operationId": "GetOrganisationTypes",
        "responses": {
          "200": {
            "description": "List of organisation types.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationTypesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationTypesResponse": {
        "type": "object",
        "properties": {
          "organisationTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationTypeSummary"
            }
          }
        },
        "required": [
          "organisationTypes"
        ]
      },
      "OrganisationTypeSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "description": {
            "type": "string",
            "example": "Education Provider"
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    }
  }
}
