{
  "openapi": "3.1.0",
  "info": {
    "title": "Find Apprenticeship Training API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship training courses and related features."
  },
  "paths": {
    "/Courses/levels": {
      "get": {
        "summary": "Get course levels",
        "operationId": "GetCourseLevels",
        "responses": {
          "200": {
            "description": "List of course levels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseLevelsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Courses/routes": {
      "get": {
        "summary": "Get course routes",
        "operationId": "GetCourseRoutes",
        "responses": {
          "200": {
            "description": "List of course routes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRoutesListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Courses/{larscode}/providers": {
      "get": {
        "summary": "Get providers for a specific course",
        "operationId": "GetCourseProviders",
        "parameters": [
          {
            "name": "larscode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "OrderBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Distance",
            "in": "query",
            "schema": {
              "type": "number",
              "format": "decimal"
            }
          },
          {
            "name": "LocationName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DeliveryModes",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "EmployerProviderRatings",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "ApprenticeProviderRatings",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "Qar",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ShortlistUserId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of course providers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseProvidersResponse"
                }
              }
            }
          },
          "404": {
            "description": "Course providers not found"
          }
        }
      }
    },
    "/Courses": {
      "get": {
        "summary": "Get courses",
        "operationId": "GetCourses",
        "parameters": [
          {
            "name": "Keyword",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "RouteIds",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "Levels",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "LearningTypes",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "Distance",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "LocationName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "OrderBy",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/Courses/{larscode}": {
      "get": {
        "summary": "Get course by Lars code",
        "operationId": "GetCourseByLarsCode",
        "parameters": [
          {
            "name": "larscode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distance",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "locationName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseByLarsCodeQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/Courses/{larsCode}/providers/{ukprn}": {
      "get": {
        "summary": "Get specific course provider details",
        "operationId": "GetCourseProvider",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ShortlistUserId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "LocationName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Distance",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider details for specific course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseProviderResponse"
                }
              }
            }
          },
          "404": {
            "description": "Course provider not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCourseLevelsListResponse": {
        "type": "object",
        "properties": {
          "Levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseLevelsListItem"
            }
          }
        }
      },
      "GetCourseLevelsListItem": {
        "type": "object",
        "properties": {
          "Code": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "GetRoutesListResponse": {
        "type": "object",
        "properties": {
          "Routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetRoutesListItem"
            }
          }
        }
      },
      "GetRoutesListItem": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "GetCourseProvidersResponse": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          },
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderData"
            }
          }
        }
      },
      "ProviderData": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer"
          }
        }
      },
      "GetCoursesQueryResult": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          },
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandardModel"
            }
          }
        }
      },
      "StandardModel": {
        "type": "object",
        "properties": {
          "StandardUId": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "LarsCode": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          }
        }
      },
      "GetCourseByLarsCodeQueryResult": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          },
          "ProvidersCountWithinDistance": {
            "type": "integer"
          },
          "TotalProvidersCount": {
            "type": "integer"
          }
        }
      },
      "GetCourseProviderResponse": {
        "type": "object",
        "properties": {
          "ProviderName": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer"
          }
        }
      }
    }
  }
}
