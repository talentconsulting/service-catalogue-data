{
  "openapi": "3.1.0",
  "info": {
    "title": "Pledge Applications API",
    "version": "1.0.0",
    "description": "API for managing pledge applications within the system."
  },
  "paths": {
    "/PledgeApplications/{id}": {
      "get": {
        "summary": "Get Pledge Application",
        "description": "Retrieve the details of a specific pledge application by its ID.",
        "operationId": "getPledgeApplication",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the pledge application to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with pledge application details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPledgeApplicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pledge application not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPledgeApplicationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The ID of the pledge application."
          },
          "status": {
            "type": "string",
            "description": "The status of the pledge application."
          },
          "details": {
            "type": "string",
            "description": "Additional details about the pledge application."
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
