{
  "openapi": "3.1.0",
  "info": {
    "title": "Pledge Applications API",
    "version": "1.0.0",
    "description": "API for managing pledge applications"
  },
  "paths": {
    "/PledgeApplications/{id}": {
      "get": {
        "summary": "Retrieve a pledge application by its ID",
        "description": "Fetch the details of a pledge application using its ID.",
        "operationId": "getPledgeApplication",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the pledge application"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with application details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPledgeApplicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Pledge application not found"
          },
          "400": {
            "description": "Bad request due to invalid input or internal error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPledgeApplicationResponse": {
        "type": "object",
        "description": "Representation of a pledge application response",
        "properties": {
          "PledgeApplicationId": {
            "type": "integer",
            "description": "The unique identifier for the pledge application"
          },
          "Status": {
            "type": "string",
            "description": "The current status of the pledge application"
          },
          "ApplicantName": {
            "type": "string",
            "description": "Name of the applicant"
          },
          "ApplicationDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date the application was submitted"
          },
          "Details": {
            "type": "string",
            "description": "Detailed description of the pledge application"
          }
        },
        "required": [
          "PledgeApplicationId",
          "Status",
          "ApplicantName",
          "ApplicationDate"
        ]
      }
    }
  }
}
