{
  "openapi": "3.1.0",
  "info": {
    "title": "Pledge Applications API",
    "version": "1.0.0"
  },
  "paths": {
    "/PledgeApplications/{id}": {
      "get": {
        "summary": "Retrieve a pledge application by ID",
        "operationId": "GetPledgeApplicationById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The ID of the pledge application",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPledgeApplicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPledgeApplicationResponse": {
        "type": "object",
        "description": "Response model for retrieving a pledge application",
        "additionalProperties": true
      }
    }
  }
}
