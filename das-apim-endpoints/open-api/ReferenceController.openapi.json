{
  "openapi": "3.1.0",
  "info": {
    "title": "LevyTransferMatching API",
    "version": "1.0.0"
  },
  "paths": {
    "/reference/levels": {
      "get": {
        "summary": "Get Levels Reference Data",
        "operationId": "getLevelsReferenceData",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceDataItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reference/sectors": {
      "get": {
        "summary": "Get Sectors Reference Data",
        "operationId": "getSectorsReferenceData",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceDataItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reference/jobRoles": {
      "get": {
        "summary": "Get Job Roles Reference Data",
        "operationId": "getJobRolesReferenceData",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ReferenceDataItem"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReferenceDataItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier of the reference data item"
          },
          "text": {
            "type": "string",
            "description": "Description of the reference data item"
          }
        },
        "required": [
          "id",
          "text"
        ]
      }
    }
  }
}
