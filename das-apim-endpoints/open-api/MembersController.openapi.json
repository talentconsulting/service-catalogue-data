{
  "openapi": "3.1.0",
  "info": {
    "title": "Members API",
    "version": "1.0.0"
  },
  "paths": {
    "/Members": {
      "get": {
        "summary": "Get Members",
        "operationId": "GetMembers",
        "parameters": [
          {
            "name": "Keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "RegionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "UserType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "Apprentice",
                  "Employer"
                ]
              }
            }
          },
          {
            "name": "IsRegionalChair",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMembersQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/Members/{memberId}": {
      "put": {
        "summary": "Update Member Profile and Preferences",
        "operationId": "UpdateMemberProfileAndPreferences",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemberProfileModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/Members/{memberId}/Leaving": {
      "post": {
        "summary": "Post Member Leaving Reasons",
        "operationId": "PostMemberLeavingReasons",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostMemberLeavingModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/Members/{memberId}/reinstate": {
      "post": {
        "summary": "Reinstate Member",
        "operationId": "PostMemberReinstate",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMembersQueryResult": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          },
          "Members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MembersSummary"
            }
          }
        }
      },
      "MembersSummary": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "FullName": {
            "type": "string"
          },
          "RegionId": {
            "type": "integer"
          },
          "RegionName": {
            "type": "string"
          },
          "UserType": {
            "type": "string",
            "enum": [
              "Apprentice",
              "Employer"
            ]
          },
          "IsRegionalChair": {
            "type": "boolean"
          },
          "JoinedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateMemberProfileModel": {
        "type": "object",
        "properties": {
          "patchMemberRequest": {
            "$ref": "#/components/schemas/PatchMemberRequest"
          },
          "updateMemberProfileRequest": {
            "$ref": "#/components/schemas/UpdateMemberProfileRequest"
          }
        }
      },
      "PatchMemberRequest": {
        "type": "object",
        "properties": {
          "RegionId": {
            "type": "integer"
          },
          "OrganisationName": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          }
        }
      },
      "UpdateMemberProfileRequest": {
        "type": "object",
        "properties": {
          "MemberProfiles": {
            "type": "array",
            "items": {}
          },
          "MemberPreferences": {
            "type": "array",
            "items": {}
          }
        }
      },
      "PostMemberLeavingModel": {
        "type": "object",
        "properties": {
          "LeavingReasons": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
