{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Aan Members API",
    "version": "1.0.0"
  },
  "paths": {
    "/Members": {
      "get": {
        "summary": "Get Members",
        "operationId": "getMembers",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "description": "Query string parameters for filtering members",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Members retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMembersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Members/{memberId}/profile": {
      "get": {
        "summary": "Get Member Profile",
        "operationId": "getMemberProfile",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the member",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "description": "ID of the member making the request",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemberProfileQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/Members/{memberId}/leaving": {
      "post": {
        "summary": "Update Member Leaving Status",
        "operationId": "postMemberLeaving",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the member",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "description": "ID of the member making the request",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Status update payload for member leaving",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostMemberStatusModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMembersResponse": {
        "type": "object",
        "properties": {
          "page": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "totalCount": {
            "type": "integer"
          },
          "members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberSummary"
            }
          }
        }
      },
      "GetMemberProfileQueryResult": {
        "type": "object",
        "properties": {
          "fullName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "organisationName": {
            "type": "string",
            "nullable": true
          },
          "regionId": {
            "type": "integer",
            "nullable": true
          },
          "regionName": {
            "type": "string"
          },
          "userType": {
            "$ref": "#/components/schemas/MemberUserType"
          },
          "isRegionalChair": {
            "type": "boolean"
          },
          "joinedDate": {
            "type": "string",
            "format": "date-time"
          },
          "apprenticeship": {
            "$ref": "#/components/schemas/Apprenticeship"
          },
          "activities": {
            "$ref": "#/components/schemas/GetMemberActivitiesResponse"
          },
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberProfile"
            }
          },
          "preferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberPreference"
            }
          }
        }
      },
      "PostMemberStatusModel": {
        "type": "object",
        "properties": {}
      },
      "MemberSummary": {
        "type": "object",
        "properties": {}
      },
      "MemberUserType": {
        "type": "string",
        "enum": [
          "Apprentice",
          "Employer",
          "Admin"
        ]
      },
      "Apprenticeship": {
        "type": "object",
        "properties": {
          "sector": {
            "type": "string",
            "nullable": true
          },
          "programme": {
            "type": "string",
            "nullable": true
          },
          "level": {
            "type": "string",
            "nullable": true
          },
          "activeApprenticesCount": {
            "type": "integer"
          },
          "sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "GetMemberActivitiesResponse": {
        "type": "object",
        "properties": {
          "lastSignedUpDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "eventsAttended": {
            "$ref": "#/components/schemas/EventsModel"
          },
          "eventsPlanned": {
            "$ref": "#/components/schemas/EventsModel"
          }
        }
      },
      "EventsModel": {
        "type": "object",
        "properties": {
          "eventsDateRange": {
            "$ref": "#/components/schemas/DateRangeModel"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventAttendanceModel"
            }
          }
        }
      },
      "DateRangeModel": {
        "type": "object",
        "properties": {
          "fromDate": {
            "type": "string",
            "format": "date-time"
          },
          "toDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventAttendanceModel": {
        "type": "object",
        "properties": {
          "calendarEventId": {
            "type": "string",
            "format": "uuid"
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "eventTitle": {
            "type": "string"
          },
          "urn": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "MemberProfile": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer"
          },
          "value": {
            "type": "string"
          },
          "preferenceId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "MemberPreference": {
        "type": "object",
        "properties": {
          "preferenceId": {
            "type": "integer"
          },
          "value": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
