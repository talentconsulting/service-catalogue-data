{
  "openapi": "3.1.0",
  "info": {
    "title": "Members Controller API",
    "version": "1.0.0"
  },
  "paths": {
    "/Members": {
      "get": {
        "operationId": "GetMembers",
        "summary": "Retrieve a list of members.",
        "parameters": [
          {
            "name": "queryString",
            "in": "query",
            "required": false,
            "description": "HTTP query string parameters for filtering or pagination.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of members.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMembersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Members/{memberId}/profile": {
      "get": {
        "operationId": "GetMemberProfile",
        "summary": "Retrieve details of a specific member's profile.",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the member.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "description": "The identifier of the member making the request.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the member's profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemberProfileQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/Members/{memberId}/leaving": {
      "post": {
        "operationId": "PostMemberLeaving",
        "summary": "Set the leaving status of a member.",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "description": "The unique identifier of the member.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "description": "The identifier of the member making the request.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostMemberStatusModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmation that the member's leaving status has been updated.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMembersResponse": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          },
          "Members": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberSummary"
            }
          }
        },
        "required": [
          "Page",
          "PageSize",
          "TotalPages",
          "TotalCount",
          "Members"
        ]
      },
      "MemberSummary": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "FullName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          }
        },
        "required": [
          "MemberId",
          "FullName",
          "Email"
        ]
      },
      "GetMemberProfileQueryResult": {
        "type": "object",
        "properties": {
          "FullName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string",
            "nullable": true
          },
          "RegionId": {
            "type": "integer",
            "nullable": true
          },
          "RegionName": {
            "type": "string"
          },
          "UserType": {
            "$ref": "#/components/schemas/MemberUserType"
          },
          "IsRegionalChair": {
            "type": "boolean"
          },
          "JoinedDate": {
            "type": "string",
            "format": "date-time"
          },
          "Apprenticeship": {
            "$ref": "#/components/schemas/Apprenticeship"
          },
          "Activities": {
            "$ref": "#/components/schemas/GetMemberActivitiesResponse"
          },
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberProfile"
            }
          },
          "Preferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberPreference"
            }
          }
        },
        "required": [
          "FullName",
          "Email",
          "FirstName",
          "LastName",
          "RegionName",
          "UserType",
          "IsRegionalChair",
          "JoinedDate",
          "Apprenticeship",
          "Activities",
          "Profiles",
          "Preferences"
        ]
      },
      "MemberProfile": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "Value": {
            "type": "string"
          },
          "PreferenceId": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "ProfileId",
          "Value"
        ]
      },
      "MemberPreference": {
        "type": "object",
        "properties": {
          "PreferenceId": {
            "type": "integer"
          },
          "Value": {
            "type": "boolean"
          }
        },
        "required": [
          "PreferenceId",
          "Value"
        ]
      },
      "Apprenticeship": {
        "type": "object",
        "properties": {
          "Sector": {
            "type": "string",
            "nullable": true
          },
          "Programme": {
            "type": "string",
            "nullable": true
          },
          "Level": {
            "type": "string",
            "nullable": true
          },
          "ActiveApprenticesCount": {
            "type": "integer"
          },
          "Sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ActiveApprenticesCount",
          "Sectors"
        ]
      },
      "GetMemberActivitiesResponse": {
        "type": "object",
        "properties": {
          "LastSignedUpDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EventsAttended": {
            "$ref": "#/components/schemas/EventsModel"
          },
          "EventsPlanned": {
            "$ref": "#/components/schemas/EventsModel"
          }
        }
      },
      "EventsModel": {
        "type": "object",
        "properties": {
          "EventsDateRange": {
            "$ref": "#/components/schemas/DateRangeModel"
          },
          "Events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventAttendanceModel"
            }
          }
        }
      },
      "DateRangeModel": {
        "type": "object",
        "properties": {
          "FromDate": {
            "type": "string",
            "format": "date-time"
          },
          "ToDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "FromDate",
          "ToDate"
        ]
      },
      "EventAttendanceModel": {
        "type": "object",
        "properties": {
          "CalendarEventId": {
            "type": "string",
            "format": "uuid"
          },
          "EventDate": {
            "type": "string",
            "format": "date-time"
          },
          "EventTitle": {
            "type": "string"
          },
          "Urn": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "CalendarEventId",
          "EventDate",
          "EventTitle"
        ]
      },
      "MemberUserType": {
        "type": "string",
        "enum": [
          "Apprentice",
          "Employer",
          "Admin"
        ]
      },
      "PostMemberStatusModel": {
        "type": "object",
        "properties": {
          "Reason": {
            "type": "string"
          },
          "Date": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        },
        "required": [
          "Reason"
        ]
      }
    }
  }
}
