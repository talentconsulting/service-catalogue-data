{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0",
    "description": "API for retrieving training courses and standards."
  },
  "paths": {
    "/TrainingCourses/": {
      "get": {
        "summary": "Retrieve list of standards",
        "operationId": "getStandards",
        "parameters": [
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "description": "The sector to filter standards by."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing standards.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsResponse"
                }
              }
            }
          },
          "404": {
            "description": "No standards found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/TrainingCourses/{standardUId}": {
      "get": {
        "summary": "Retrieve a specific standard by its UID",
        "operationId": "getStandard",
        "parameters": [
          {
            "name": "standardUId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier for the standard."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing a standard.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardByStandardUIdResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsResponse": {
        "type": "object",
        "properties": {
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardsResponseItem"
            }
          }
        }
      },
      "GetStandardsResponseItem": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "integer"
          },
          "StandardUId": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          }
        },
        "required": [
          "LarsCode",
          "StandardUId",
          "Title",
          "Level"
        ]
      },
      "GetStandardByStandardUIdResponse": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "integer"
          },
          "StandardUId": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          }
        },
        "required": [
          "LarsCode",
          "StandardUId",
          "Title",
          "Level",
          "Route"
        ]
      }
    }
  }
}
