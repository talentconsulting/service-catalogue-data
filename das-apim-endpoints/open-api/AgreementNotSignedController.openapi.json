{
  "openapi": "3.1.0",
  "info": {
    "title": "Agreement Not Signed API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountId}/unapproved/AgreementNotSigned": {
      "get": {
        "operationId": "GetAgreementNotSigned",
        "summary": "Retrieve account details for agreements not signed",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID to retrieve agreement details for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved agreement not signed details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAgreementNotSignedResponse"
                }
              }
            }
          },
          "404": {
            "description": "Account not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAgreementNotSignedResponse": {
        "type": "object",
        "properties": {
          "agreementDetails": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          }
        }
      }
    }
  }
}
