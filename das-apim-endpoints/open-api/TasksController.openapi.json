{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Tasks API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{apprenticeId}/progress/taskCategories": {
      "get": {
        "summary": "Retrieve task categories for an apprentice",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeTaskCategoriesCollection"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/apprentices/{apprenticeshipId}/progress/tasks": {
      "post": {
        "summary": "Add a new task",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeTaskData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "get": {
        "summary": "Retrieve tasks for an apprentice based on dates and status",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fromDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "toDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeTasksCollection"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/progress/tasks/{taskId}": {
      "get": {
        "summary": "Retrieve a specific task by ID",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeTask"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "put": {
        "summary": "Update a specific task by ID",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeTaskData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "delete": {
        "summary": "Delete a specific task by ID",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/progress/tasks/{taskId}/status/{statusId}": {
      "post": {
        "summary": "Update the status of a task",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "statusId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/progress/taskCategories/tasks/{taskId}/ksbs": {
      "get": {
        "summary": "Retrieve task view data including KSBs",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeTaskModelData"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/progress/tasks/taskReminders": {
      "get": {
        "summary": "Retrieve task reminders for an apprentice",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskReminder"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update a task reminder",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "statusId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeTaskData": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "TaskId": {
            "type": "integer"
          },
          "DueDate": {
            "type": "string",
            "format": "date-time"
          },
          "ApprenticeAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "ApprenticeshipCategoryId": {
            "type": "integer"
          },
          "Note": {
            "type": "string"
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "CategoryId": {
            "type": "integer"
          },
          "Status": {
            "type": "integer"
          },
          "Files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskFile"
            }
          },
          "ReminderUnit": {
            "type": "integer"
          },
          "ReminderValue": {
            "type": "integer"
          },
          "ReminderStatus": {
            "type": "integer"
          },
          "KsbsLinked": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ApprenticeTask": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "ApprenticeshipId": {
            "type": "integer"
          },
          "ApprenticeAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "DueDate": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          },
          "ApprenticeshipCategoryId": {
            "type": "integer"
          },
          "Note": {
            "type": "string"
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "integer"
          },
          "TaskFiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskFile"
            }
          },
          "TaskReminders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskReminder"
            }
          },
          "TaskLinkedKsbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskKSBs"
            }
          },
          "ApprenticeshipCategory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipCategory"
            }
          }
        }
      },
      "TaskFile": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "TaskFileId": {
            "type": "integer"
          },
          "FileType": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "FileContents": {
            "type": "string"
          }
        }
      },
      "TaskReminder": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "ReminderId": {
            "type": "integer"
          },
          "ReminderValue": {
            "type": "integer"
          },
          "ReminderUnit": {
            "type": "integer"
          },
          "Status": {
            "type": "integer"
          }
        }
      },
      "TaskKSBs": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "KSBProgressId": {
            "type": "integer"
          }
        }
      },
      "ApprenticeshipCategory": {
        "type": "object",
        "properties": {
          "CategoryId": {
            "type": "integer"
          },
          "Title": {
            "type": "string"
          }
        }
      },
      "ApprenticeTaskCategoriesCollection": {
        "type": "object",
        "properties": {
          "TaskCategories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipCategory"
            }
          }
        }
      },
      "ApprenticeTasksCollection": {
        "type": "object",
        "properties": {
          "Tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeTask"
            }
          }
        }
      },
      "ApprenticeTaskModelData": {
        "type": "object",
        "properties": {
          "Task": {
            "$ref": "#/components/schemas/ApprenticeTask"
          },
          "KSBProgress": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeKsbData"
            }
          },
          "TaskCategories": {
            "$ref": "#/components/schemas/ApprenticeTaskCategoriesCollection"
          }
        }
      },
      "ApprenticeKsbData": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "KsbProgressId": {
            "type": "integer"
          },
          "KSBId": {
            "type": "string",
            "format": "uuid"
          },
          "KsbKey": {
            "type": "string"
          },
          "CurrentStatus": {
            "type": "integer"
          },
          "Detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
