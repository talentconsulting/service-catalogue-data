{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign API",
    "version": "1.0.0"
  },
  "paths": {
    "/LandingPage/{hub}/{slug}": {
      "get": {
        "operationId": "GetLandingPageAsync",
        "summary": "Fetch a landing page by hub and slug.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLandingPageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Landing page not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/LandingPage/preview/{hub}/{slug}": {
      "get": {
        "operationId": "GetPreviewLandingPage",
        "summary": "Fetch a preview of a landing page by hub and slug.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLandingPageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview landing page not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetLandingPageResponse": {
        "type": "object",
        "properties": {
          "LandingPage": {
            "$ref": "#/components/schemas/LandingPageModel"
          }
        }
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          }
        }
      },
      "LandingPageModel": {
        "type": "object",
        "properties": {
          "PageAttributes": {
            "$ref": "#/components/schemas/PageModel"
          },
          "MainContent": {
            "$ref": "#/components/schemas/HubContent"
          },
          "MenuContent": {
            "$ref": "#/components/schemas/MenuPageModel_MenuPageContent"
          },
          "BannerModels": {
            "$ref": "#/components/schemas/BannerPageModel"
          }
        }
      },
      "PageModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "PageType": {
            "$ref": "#/components/schemas/PageType"
          },
          "Title": {
            "type": "string"
          },
          "MetaDescription": {
            "type": "string"
          },
          "Slug": {
            "type": "string"
          },
          "HubType": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "ArticleType": {
            "type": "string"
          }
        }
      },
      "HubContent": {
        "type": "object",
        "properties": {
          "HeaderImage": {
            "$ref": "#/components/schemas/ContentItem"
          },
          "Cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          }
        }
      },
      "MenuPageModel_MenuPageContent": {
        "type": "object",
        "properties": {
          "TopLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageModel_BannerPageContent"
            }
          }
        }
      },
      "CardPageModel": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/PageModel"
          }
        ],
        "properties": {
          "LandingPage": {
            "$ref": "#/components/schemas/UrlDetails"
          },
          "CardImage": {
            "$ref": "#/components/schemas/ContentItem"
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Hub": {
            "type": "string"
          },
          "PageType": {
            "type": "string"
          },
          "ParentSlug": {
            "type": "string"
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "Values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Type": {
            "type": "string"
          },
          "TableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "EmbeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "VideoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "Url": {
            "type": "string"
          },
          "Size": {
            "type": "integer",
            "format": "int64"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "VideoName": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        }
      },
      "BannerPageModel_BannerPageContent": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "BackgroundColour": {
            "type": "string"
          },
          "AllowUserToHideTheBanner": {
            "type": "boolean"
          },
          "ShowOnTheHomepageOnly": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        }
      },
      "PageType": {
        "type": "string",
        "enum": [
          "Unknown",
          "LandingPage",
          "Article",
          "Hub",
          "Tab"
        ]
      }
    }
  }
}
