{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Campaign API",
    "version": "1.0.0",
    "description": "API for managing landing pages within the SFA DAS Campaign."
  },
  "paths": {
    "/LandingPageController/{hub}/{slug}": {
      "get": {
        "operationId": "GetLandingPage",
        "summary": "Retrieve landing page details.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hub for which the landing page belongs."
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier for the landing page within the hub."
          }
        ],
        "responses": {
          "200": {
            "description": "Landing page details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLandingPageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Landing page not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/LandingPageController/preview/{hub}/{slug}": {
      "get": {
        "operationId": "GetPreviewLandingPage",
        "summary": "Retrieve preview of a landing page.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hub for which the landing page preview belongs."
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier for the preview landing page within the hub."
          }
        ],
        "responses": {
          "200": {
            "description": "Landing page preview retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLandingPageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview landing page not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetLandingPageResponse": {
        "type": "object",
        "properties": {
          "LandingPage": {
            "$ref": "#/components/schemas/LandingPageModel"
          }
        },
        "required": [
          "LandingPage"
        ]
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string",
            "description": "Error message providing details about why the requested resource was not found."
          }
        },
        "required": [
          "Message"
        ]
      },
      "LandingPageModel": {
        "type": "object",
        "properties": {
          "PageAttributes": {
            "$ref": "#/components/schemas/PageModel"
          },
          "MainContent": {
            "$ref": "#/components/schemas/HubContent"
          },
          "MenuContent": {
            "$ref": "#/components/schemas/MenuPageContent"
          },
          "BannerModels": {
            "$ref": "#/components/schemas/BannerPageModel"
          }
        }
      },
      "PageModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "PageType": {
            "$ref": "#/components/schemas/PageType"
          },
          "Title": {
            "type": "string"
          },
          "MetaDescription": {
            "type": "string"
          },
          "Slug": {
            "type": "string"
          },
          "HubType": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "ArticleType": {
            "type": "string"
          }
        }
      },
      "PageType": {
        "type": "string",
        "enum": [
          "Unknown",
          "LandingPage",
          "Article",
          "Hub",
          "Tab"
        ]
      },
      "HubContent": {
        "type": "object",
        "properties": {
          "HeaderImage": {
            "$ref": "#/components/schemas/ContentItem"
          },
          "Cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "Values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Type": {
            "type": "string"
          },
          "TableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "EmbeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "VideoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "Url": {
            "type": "string"
          },
          "Size": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "VideoName": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        }
      },
      "CardPageModel": {
        "type": "object",
        "properties": {
          "LandingPage": {
            "$ref": "#/components/schemas/UrlDetails"
          },
          "CardImage": {
            "$ref": "#/components/schemas/ContentItem"
          },
          "Id": {
            "type": "string"
          },
          "PageType": {
            "$ref": "#/components/schemas/PageType"
          },
          "Title": {
            "type": "string"
          },
          "MetaDescription": {
            "type": "string"
          },
          "Slug": {
            "type": "string"
          },
          "HubType": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "ArticleType": {
            "type": "string"
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Hub": {
            "type": "string"
          },
          "PageType": {
            "type": "string"
          },
          "ParentSlug": {
            "type": "string"
          }
        }
      },
      "MenuPageContent": {
        "type": "object",
        "properties": {
          "TopLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageContent"
            }
          }
        }
      },
      "BannerPageContent": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "BackgroundColour": {
            "type": "string"
          },
          "AllowUserToHideTheBanner": {
            "type": "boolean"
          },
          "ShowOnTheHomepageOnly": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        }
      }
    }
  }
}
