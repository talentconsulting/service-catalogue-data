          },
          "courseId": {
            "type": "integer"
          },
          "courseRoute": {
            "type": "string"
          },
          "apprenticeshipLevel": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "categoryCode": {
            "type": "string"
          },
          "subCategory": {
            "type": "string"
          },
          "subCategoryCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "frameworkLarsCode": {
            "type": "string"
          },
