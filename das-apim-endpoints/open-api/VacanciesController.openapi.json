              "type": "string"
            }
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "closingDate": {
            "type": "string",
            "format": "date-time"
          },
          "postedDate": {
            "type": "string",
            "format": "date-time"
          },
          "wageAmount": {
