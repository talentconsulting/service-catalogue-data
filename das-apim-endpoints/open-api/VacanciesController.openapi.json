{
  "openapi": "3.1.0",
  "info": {
    "title": "Find an Apprenticeship API",
    "description": "API for managing apprenticeship vacancies and related operations.",
    "version": "1.0.0"
  },
  "paths": {
    "/Vacancies/{vacancyReference}": {
      "get": {
        "summary": "Search apprenticeship vacancy by reference",
        "tags": [
          "Vacancies"
        ],
        "parameters": [
          {
            "name": "vacancyReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "candidateId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipVacancyApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Vacancy not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Apply to an apprenticeship vacancy",
        "tags": [
          "Vacancies"
        ],
        "parameters": [
          {
            "name": "vacancyReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostApplyApiRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostApplyApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Vacancy not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/Vacancies/statistics": {
      "get": {
        "summary": "Get statistics about search index",
        "tags": [
          "Vacancies"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSearchIndexStatisticsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
