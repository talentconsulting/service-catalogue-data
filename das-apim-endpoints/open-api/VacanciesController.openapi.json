{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Employer Accounts API",
    "description": "API for managing employer accounts and retrieving vacancies.",
    "version": "1.0.0"
  },
  "paths": {
    "/Vacancies/{accountId}": {
      "get": {
        "summary": "Retrieve employer vacancy data",
        "tags": [
          "Vacancies"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the employer account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of vacancy data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmployerVacanciesApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Vacancy data not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetEmployerVacanciesApiResponse": {
        "type": "object",
        "description": "Response data for employer vacancies",
        "properties": {
          "vacancies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Vacancy"
            }
          }
        }
      },
      "Vacancy": {
        "type": "object",
        "properties": {
          "vacancyId": {
            "type": "string",
            "description": "Unique identifier for the vacancy"
          },
          "title": {
            "type": "string",
            "description": "Title of the vacancy"
          },
          "description": {
            "type": "string",
            "description": "Description of the job role or apprenticeship"
          },
          "employerName": {
            "type": "string",
            "description": "Name of the employer posting the vacancy"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "postedDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the vacancy was posted"
          },
          "closingDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the vacancy application closes"
          }
        }
      },
      "Location": {
        "type": "object",
        "description": "Location details for the vacancy",
        "properties": {
          "addressLine1": {
            "type": "string",
            "description": "First line of the address"
          },
          "addressLine2": {
            "type": "string",
            "description": "Second line of the address (optional)"
          },
          "addressLine3": {
            "type": "string",
            "description": "Third line of the address (optional)"
          },
          "postcode": {
            "type": "string",
            "description": "Postcode of the location"
          },
          "latitude": {
            "type": "number",
            "format": "float",
            "description": "Latitude of the location"
          },
          "longitude": {
            "type": "number",
            "format": "float",
            "description": "Longitude of the location"
          }
        }
      }
    }
  }
}
