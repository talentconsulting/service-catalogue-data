          }
        }
      },
      "PostApplyApiRequest": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "candidateId"
        ]
      },
      "PostApplyApiResponse": {
        "type": "object",
        "properties": {
          "applicationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetSearchIndexStatisticsResponse": {
        "type": "object",
        "properties": {
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "indexStatistics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VacancySourceStatistic"
            }
          },
          "lastUpdatedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "VacancySourceStatistic": {
        "type": "object",
        "properties": {
          "source": {
