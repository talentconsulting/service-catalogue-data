{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/courses/{larsCode}": {
      "get": {
        "tags": [
          "Provider Courses"
        ],
        "summary": "Get provider course",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "UKPRN of the provider"
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the course"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderCourseResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderCourseResponse": {
        "type": "object",
        "properties": {
          "ProviderCourseId": {
            "type": "integer"
          },
          "StandardUId": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "ApprovalBody": {
            "type": "string"
          },
          "Route": {
            "type": "string"
          },
          "StandardInfoUrl": {
            "type": "string",
            "format": "uri"
          },
          "ContactUsPhoneNumber": {
            "type": "string"
          },
          "ContactUsEmail": {
            "type": "string",
            "format": "email"
          },
          "IsApprovedByRegulator": {
            "type": "boolean",
            "nullable": true
          },
          "IsRegulatedForProvider": {
            "type": "boolean"
          },
          "HasLocations": {
            "type": "boolean"
          },
          "HasOnlineDeliveryOption": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
