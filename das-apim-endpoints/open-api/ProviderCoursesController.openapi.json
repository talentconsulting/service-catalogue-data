{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Courses API",
    "description": "API for managing provider courses",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/courses/{larsCode}": {
      "get": {
        "operationId": "GetProviderCourse",
        "tags": [
          "Provider Courses"
        ],
        "summary": "Get a specific provider course",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK provider reference number",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "description": "LARS (Learning Aim Reference System) code of the course",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider course found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderCourseResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider course not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderCourseResponse": {
        "type": "object",
        "properties": {
          "ProviderCourseId": {
            "type": "integer",
            "description": "Unique identifier for the provider course"
          },
          "StandardUId": {
            "type": "string",
            "description": "Standard unique identifier"
          },
          "IfateReferenceNumber": {
            "type": "string",
            "description": "Institute for Apprenticeships reference number"
          },
          "LarsCode": {
            "type": "string",
            "description": "Learning Aim Reference System code for the course"
          },
          "Title": {
            "type": "string",
            "description": "Title of the course"
          },
          "Level": {
            "type": "integer",
            "description": "Level of the course"
          },
          "ApprovalBody": {
            "type": "string",
            "description": "Approval body for the course"
          },
          "Route": {
            "type": "string",
            "description": "Delivery route for the course"
          },
          "StandardInfoUrl": {
            "type": "string",
            "description": "URL for additional information about the standard"
          },
          "ContactUsPhoneNumber": {
            "type": "string",
            "description": "Phone number for contacting about the course"
          },
          "ContactUsEmail": {
            "type": "string",
            "description": "Email for contacting about the course"
          },
          "IsApprovedByRegulator": {
            "type": "boolean",
            "description": "Indicates whether the course is approved by a regulator"
          },
          "IsRegulatedForProvider": {
            "type": "boolean",
            "description": "Indicates whether the course is regulated for the provider"
          },
          "HasLocations": {
            "type": "boolean",
            "description": "Indicates whether the course has multiple locations"
          },
          "HasOnlineDeliveryOption": {
            "type": "boolean",
            "description": "Indicates whether the course has an online delivery option"
          }
        },
        "required": [
          "ProviderCourseId",
          "StandardUId",
          "IfateReferenceNumber",
          "LarsCode",
          "Title",
          "Level",
          "ApprovalBody",
          "Route",
          "StandardInfoUrl",
          "ContactUsPhoneNumber",
          "ContactUsEmail",
          "IsRegulatedForProvider",
          "HasLocations",
          "HasOnlineDeliveryOption"
        ]
      }
    }
  }
}
