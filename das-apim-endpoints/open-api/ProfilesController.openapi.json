{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerAan Profiles API",
    "version": "1.0.0"
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "summary": "Get profiles by user type",
        "description": "Retrieves a list of profiles based on the provided user type.",
        "operationId": "GetProfilesByUserType",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "description": "The type of user for which to retrieve profiles.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesByUserTypeQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesByUserTypeQueryResult": {
        "type": "object",
        "properties": {
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the profile."
          },
          "Description": {
            "type": "string",
            "description": "Description of the profile."
          },
          "Category": {
            "type": "string",
            "description": "Category of the profile."
          },
          "Ordering": {
            "type": "integer",
            "format": "int32",
            "description": "Ordering value for the profile."
          }
        },
        "required": [
          "Id",
          "Description",
          "Category",
          "Ordering"
        ]
      }
    }
  }
}
