{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Aan API",
    "version": "1.0.0",
    "description": "API for managing profiles based on user types."
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "summary": "Get list of profiles by user type",
        "operationId": "GetProfilesByUserType",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesByUserTypeQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesByUserTypeQueryResult": {
        "type": "object",
        "properties": {
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "Description": {
            "type": "string"
          },
          "Category": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "Id",
          "Description",
          "Category",
          "Ordering"
        ]
      }
    }
  }
}
