{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice AAN API",
    "description": "API for managing apprentice profiles in AAN.",
    "version": "1.0.0"
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "operationId": "GetProfilesByUserType",
        "summary": "Get list of profiles by user type",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Specifies the user type to filter profiles."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing profiles for the given user type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesByUserTypeQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesByUserTypeQueryResult": {
        "type": "object",
        "properties": {
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        },
        "description": "Result containing a list of profiles."
      },
      "Profile": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique identifier of the profile."
          },
          "Description": {
            "type": "string",
            "description": "Description of the profile."
          },
          "Category": {
            "type": "string",
            "description": "Category of the profile."
          },
          "Ordering": {
            "type": "integer",
            "description": "Ordering of the profiles."
          }
        },
        "required": [
          "Id",
          "Description",
          "Category",
          "Ordering"
        ],
        "description": "Represents a user profile."
      }
    }
  }
}
