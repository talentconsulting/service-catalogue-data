{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin AAN API",
    "description": "API for managing profiles in the Admin AAN system.",
    "version": "1.0.0"
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Get Profiles",
        "description": "Fetches profiles for the specified user type.",
        "operationId": "GetProfiles",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "description": "The user type for which profiles are being fetched.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profiles fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesResponse": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        },
        "required": [
          "profiles"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "ordering": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "description",
          "category",
          "ordering"
        ]
      }
    }
  }
}
