{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan Profiles API",
    "version": "1.0.0",
    "description": "API to retrieve profiles based on user type"
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "summary": "Retrieve Profiles",
        "description": "Retrieves profiles for a specified user type",
        "operationId": "GetProfiles",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The type of user for which to retrieve profiles"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of profiles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesResponse": {
        "type": "object",
        "properties": {
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            },
            "description": "List of profiles"
          }
        },
        "required": [
          "Profiles"
        ]
      },
      "Profile": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the profile"
          },
          "Description": {
            "type": "string",
            "description": "Description of the profile"
          },
          "Category": {
            "type": "string",
            "description": "Category of the profile"
          },
          "Ordering": {
            "type": "integer",
            "description": "Ordering value for the profile"
          }
        },
        "required": [
          "Id",
          "Description",
          "Category",
          "Ordering"
        ]
      }
    }
  }
}
