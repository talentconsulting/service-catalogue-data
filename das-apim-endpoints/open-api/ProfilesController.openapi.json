{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice AAN Profiles API",
    "version": "1.0.0"
  },
  "paths": {
    "/profiles/{userType}": {
      "get": {
        "summary": "Get list of profiles by user type",
        "description": "Retrieves a list of profiles filtered by the specified user type.",
        "operationId": "GetProfilesByUserType",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The user type to filter profiles (e.g., Employer, Provider)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the list of profiles.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesByUserTypeQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesByUserTypeQueryResult": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 123
          },
          "description": {
            "type": "string",
            "example": "Profile Description"
          },
          "category": {
            "type": "string",
            "example": "Category Name"
          },
          "ordering": {
            "type": "integer",
            "example": 1
          }
        }
      }
    }
  }
}
