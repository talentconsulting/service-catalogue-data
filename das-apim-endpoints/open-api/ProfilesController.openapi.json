{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "summary": "Get Profiles",
        "description": "Retrieve profiles based on user type.",
        "operationId": "GetProfiles",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The type of user for filtering profiles."
          }
        ],
        "responses": {
          "200": {
            "description": "Profiles retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesResponse": {
        "type": "object",
        "properties": {
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64",
            "example": 123
          },
          "Description": {
            "type": "string",
            "example": "Profile description"
          },
          "Category": {
            "type": "string",
            "example": "Category name"
          },
          "Ordering": {
            "type": "integer",
            "example": 1
          }
        }
      }
    }
  }
}
