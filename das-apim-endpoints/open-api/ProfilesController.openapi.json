{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice AAN API",
    "version": "1.0.0",
    "description": "API endpoints for Apprentice AAN service"
  },
  "paths": {
    "/Profiles/{userType}": {
      "get": {
        "summary": "Get list of profiles by user type",
        "operationId": "GetProfilesByUserType",
        "parameters": [
          {
            "name": "userType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProfilesByUserTypeQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProfilesByUserTypeQueryResult": {
        "type": "object",
        "properties": {
          "profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Profile"
            }
          }
        }
      },
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "description": {
            "type": "string",
            "example": "Example Description"
          },
          "category": {
            "type": "string",
            "example": "Example Category"
          },
          "ordering": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "id",
          "description",
          "category",
          "ordering"
        ]
      }
    }
  }
}
