{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/Epaos": {
      "get": {
        "operationId": "GetAllEpaos",
        "summary": "Retrieve all EPAOs",
        "responses": {
          "200": {
            "description": "List of EPAOs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEpaosListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetEpaosListResponse": {
        "type": "object",
        "properties": {
          "Epaos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetEpaoResponse"
            }
          }
        },
        "required": [
          "Epaos"
        ]
      },
      "GetEpaoResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "OrganisationType": {
            "type": "string"
          },
          "CreatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "IsApproved": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  }
}
