{
  "openapi": "3.1.0",
  "info": {
    "title": "FindEpao API",
    "version": "1.0.0"
  },
  "paths": {
    "/Epaos/delivery-areas": {
      "get": {
        "summary": "Retrieve a list of delivery areas.",
        "operationId": "GetDeliveryAreas",
        "responses": {
          "200": {
            "description": "Successful retrieval of delivery areas.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDeliveryAreaListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDeliveryAreaListResponse": {
        "type": "object",
        "properties": {
          "DeliveryAreas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDeliveryAreaListItem"
            }
          }
        },
        "required": [
          "DeliveryAreas"
        ]
      },
      "GetDeliveryAreaListItem": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    }
  }
}
