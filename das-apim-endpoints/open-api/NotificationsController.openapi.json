{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeAan - Notifications API",
    "version": "1.0.0"
  },
  "paths": {
    "/notifications/{id}": {
      "get": {
        "summary": "Retrieve a specific notification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the notification",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "description": "ID of the member making the request",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notification successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/notifications": {
      "post": {
        "summary": "Create a new notification",
        "parameters": [
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "description": "ID of the member creating the notification",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNotificationModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetNotificationResponse": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "TemplateName": {
            "type": "string"
          },
          "SentTime": {
            "type": "string",
            "format": "date-time"
          },
          "ReferenceId": {
            "type": "string",
            "nullable": true
          },
          "EmployerAccountId": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "MemberId",
          "TemplateName",
          "SentTime"
        ]
      },
      "CreateNotificationModel": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "NotificationTemplateId": {
            "type": "integer"
          }
        },
        "required": [
          "MemberId",
          "NotificationTemplateId"
        ]
      }
    }
  }
}
