{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Notification API",
    "version": "1.0.0"
  },
  "paths": {
    "/notifications/{id}": {
      "get": {
        "summary": "Get notification details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the notification."
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identifier for the member requesting the notification."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with notification details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Notification not found."
          }
        }
      }
    },
    "/notifications": {
      "post": {
        "summary": "Create a new notification",
        "parameters": [
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Identifier for the member creating the notification."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNotificationModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Member or template not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetNotificationResponse": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the member."
          },
          "TemplateName": {
            "type": "string",
            "description": "Name of the notification template."
          },
          "SentTime": {
            "type": "string",
            "format": "date-time",
            "description": "Time the notification was sent."
          },
          "ReferenceId": {
            "type": "string",
            "nullable": true,
            "description": "Reference identifier associated with the notification."
          },
          "EmployerAccountId": {
            "type": "integer",
            "nullable": true,
            "description": "Employer account ID associated with the notification."
          }
        }
      },
      "CreateNotificationModel": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the member to whom the notification is addressed."
          },
          "NotificationTemplateId": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier for the notification template."
          }
        },
        "required": [
          "MemberId",
          "NotificationTemplateId"
        ]
      }
    }
  }
}
