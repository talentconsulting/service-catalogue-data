{
  "openapi": "3.1.0",
  "info": {
    "title": "Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/courses/{larsCode}/providers/allowed": {
      "get": {
        "summary": "Get Allowed Providers by Course",
        "operationId": "getAllowedProvidersByCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the course"
          }
        ],
        "responses": {
          "200": {
            "description": "Allowed providers retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    },
    "/courses/{larsCode}/providers/not-allowed": {
      "get": {
        "summary": "Get Providers Not Allowed by Course",
        "operationId": "getProvidersNotAllowedByCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the course"
          }
        ],
        "responses": {
          "200": {
            "description": "Providers not allowed retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RestrictedCourseDetailsModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "IsActiveAvailable": {
            "type": "boolean"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        }
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      }
    }
  }
}
