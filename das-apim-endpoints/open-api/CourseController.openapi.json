{
  "openapi": "3.1.0",
  "info": {
    "title": "Course API",
    "version": "1.0.0"
  },
  "paths": {
    "/courses/{larsCode}/providers/allowed": {
      "get": {
        "summary": "Get allowed providers by course",
        "operationId": "GetAllowedProvidersByCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "description": "The LARS code of the course",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved allowed providers for course.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found."
          }
        }
      }
    },
    "/courses/{larsCode}/providers/not-allowed": {
      "get": {
        "summary": "Get providers not allowed to deliver the course",
        "operationId": "GetProvidersNotAllowedByCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "description": "The LARS code of the course",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved providers not allowed to deliver the course.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RestrictedCourseDetailsModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "IsActiveAvailable": {
            "type": "boolean"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int32",
            "description": "UKPRN of the provider."
          },
          "ProviderName": {
            "type": "string",
            "description": "Registered name of the provider."
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "description": "The last date for course starts.",
            "nullable": true
          }
        }
      }
    }
  }
}
