{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/registrations/{registrationId}": {
      "get": {
        "summary": "Get registration by ID",
        "operationId": "GetRegistrationById",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/registration/registration-details/{registrationId}": {
      "get": {
        "summary": "Get registration details by ID",
        "operationId": "GetRegistrationDetailsById",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/registrations": {
      "get": {
        "summary": "Get registration by account details",
        "operationId": "GetRegistrationByAccountDetails",
        "parameters": [
          {
            "name": "firstName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateOfBirth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/registrations/email": {
      "get": {
        "summary": "Get registration by email",
        "operationId": "GetRegistrationByEmail",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/registrations/reminders": {
      "get": {
        "summary": "Get reminders to send",
        "operationId": "GetRemindersToSend",
        "parameters": [
          {
            "name": "invitationCutOffTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/registrations/{registrationId}/reminder": {
      "post": {
        "summary": "Registration reminder sent",
        "operationId": "RegistrationReminderSent",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvitationReminderSentData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    },
    "/registrations/{registrationId}/firstseen": {
      "post": {
        "summary": "Registration first seen",
        "operationId": "RegistrationFirstSeen",
        "parameters": [
          {
            "name": "registrationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegistrationFirstSeenRequestData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "InvitationReminderSentData": {
        "type": "object",
        "properties": {
          "SentOn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "SentOn"
        ]
      },
      "RegistrationFirstSeenRequestData": {
        "type": "object",
        "properties": {
          "SeenOn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "SeenOn"
        ]
      }
    }
  }
}
