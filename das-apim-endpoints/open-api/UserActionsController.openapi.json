{
  "openapi": "3.1.0",
  "info": {
    "title": "User Actions API",
    "version": "1.0.0"
  },
  "paths": {
    "/user-actions/{code}": {
      "get": {
        "summary": "Get User Action By Code",
        "operationId": "GetUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User action retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "User action not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/user-actions/{code}/all-activity": {
      "get": {
        "summary": "Get All User Activity By Code",
        "operationId": "GetAllUserActivityByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User activity retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUserActivityByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "User activity not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/user-actions/{code}/search": {
      "post": {
        "summary": "Check User Action By Code",
        "operationId": "CheckUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUserActionByCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User action checked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserActionByCodeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetUserActionByCodeResponse": {
        "type": "object",
        "description": "Response for getting user action by code.",
        "properties": {}
      },
      "GetAllUserActivityByCodeResponse": {
        "type": "object",
        "description": "Response for getting all user activity by code.",
        "properties": {}
      },
      "CheckUserActionByCodeRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "The username of the user."
          }
        }
      },
      "CheckUserActionByCodeResponse": {
        "type": "object",
        "description": "Response for checking user action by code.",
        "properties": {}
      }
    }
  }
}
