{
  "openapi": "3.1.0",
  "info": {
    "title": "User Actions API",
    "description": "API for handling user actions",
    "version": "1.0.0"
  },
  "paths": {
    "/user-actions/{code}": {
      "get": {
        "summary": "Retrieve user action by code",
        "operationId": "GetUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Code of the user action to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "User action not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/user-actions/{code}/all-activity": {
      "get": {
        "summary": "Retrieve all user activity by code",
        "operationId": "GetAllUserActivityByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Code of the user action to retrieve all activity"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUserActivityByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "User activity not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/user-actions/{code}/search": {
      "post": {
        "summary": "Check user action by code",
        "operationId": "CheckUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Code of the user action to check"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUserActionByCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserActionByCodeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckUserActionByCodeRequest": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string"
          }
        },
        "required": [
          "Username"
        ]
      },
      "CheckUserActionByCodeResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetUserActionByCodeResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetAllUserActivityByCodeResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
