{
  "openapi": "3.1.0",
  "info": {
    "title": "User Actions API",
    "description": "API for managing user actions and related activities in DAS Admin.",
    "version": "1.0.0"
  },
  "paths": {
    "/user-actions/{code}": {
      "get": {
        "summary": "Retrieve user action by code",
        "operationId": "GetUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/user-actions/{code}/all-activity": {
      "get": {
        "summary": "Retrieve all user activity by code",
        "operationId": "GetAllUserActivityByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUserActivityByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/user-actions/{code}/search": {
      "post": {
        "summary": "Search user action by code",
        "operationId": "CheckUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Request details for checking user action",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUserActionByCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserActionByCodeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string"
          },
          "actionName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "GetAllUserActivityByCodeResponse": {
        "type": "object",
        "properties": {
          "activities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "activityId": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "CheckUserActionByCodeRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        }
      },
      "CheckUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "isActionValid": {
            "type": "boolean"
          },
          "validationMessage": {
            "type": "string"
          }
        }
      }
    }
  }
}
