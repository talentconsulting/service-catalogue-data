{
  "openapi": "3.1.0",
  "info": {
    "title": "User Actions API",
    "version": "1.0.0",
    "description": "API for managing user actions and their associated activities based on unique identifiers."
  },
  "paths": {
    "/user-actions/{code}": {
      "get": {
        "summary": "Retrieve user action by code",
        "operationId": "GetUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique code identifying the user action."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the user action data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "User action with the given code not found."
          },
          "500": {
            "description": "Internal server error occurred."
          }
        }
      }
    },
    "/user-actions/{code}/all-activity": {
      "get": {
        "summary": "Retrieve all user activity by code",
        "operationId": "GetAllUserActivityByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique code identifying the user action."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with all user activity data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUserActivityByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "No activity found for the user action with the given code."
          },
          "500": {
            "description": "Internal server error occurred."
          }
        }
      }
    },
    "/user-actions/{code}/search": {
      "post": {
        "summary": "Search for user action by code",
        "operationId": "CheckUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique code identifying the user action."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUserActionByCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with search results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserActionByCodeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "actionName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "GetAllUserActivityByCodeResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "activityId": {
              "type": "string"
            },
            "activityName": {
              "type": "string"
            },
            "performedAt": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "CheckUserActionByCodeRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        }
      },
      "CheckUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
