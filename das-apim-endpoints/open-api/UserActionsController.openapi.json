{
  "openapi": "3.1.0",
  "info": {
    "title": "User Actions API",
    "version": "1.0.0"
  },
  "paths": {
    "/user-actions/{code}": {
      "get": {
        "operationId": "GetUserActionByCode",
        "summary": "Retrieve a user action by its unique code.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/user-actions/{code}/all-activity": {
      "get": {
        "operationId": "GetAllUserActivityByCode",
        "summary": "Retrieve all user activity for a specific code.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUserActivityByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/user-actions/{code}/search": {
      "post": {
        "operationId": "CheckUserActionByCode",
        "summary": "Check a user action for a specific code.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUserActionByCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserActionByCodeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckUserActionByCodeRequest": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string"
          }
        },
        "required": [
          "Username"
        ]
      },
      "CheckUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "isValid": {
            "type": "boolean"
          }
        }
      },
      "GetUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "actionId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "actionId",
          "description",
          "createdAt"
        ]
      },
      "GetAllUserActivityByCodeResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "activityId": {
              "type": "string",
              "format": "uuid"
            },
            "action": {
              "type": "string"
            },
            "timestamp": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "activityId",
            "action",
            "timestamp"
          ]
        }
      }
    }
  }
}
