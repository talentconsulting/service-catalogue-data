{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin API",
    "description": "APIs for managing user actions in the Admin context.",
    "version": "1.0.0"
  },
  "paths": {
    "/user-actions/{code}": {
      "get": {
        "summary": "Retrieve user action by code",
        "operationId": "getUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique code for identifying the user action."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved user action.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "User action not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/user-actions/{code}/all-activity": {
      "get": {
        "summary": "Retrieve all user activities by code",
        "operationId": "getAllUserActivityByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique code for identifying the user activities."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all user activities.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUserActivityByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "User activities not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/user-actions/{code}/search": {
      "post": {
        "summary": "Check user action by code",
        "operationId": "checkUserActionByCode",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique code for verifying user action."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUserActionByCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful validation of user action by code.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserActionByCodeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetUserActionByCodeResponse": {
        "type": "object",
        "description": "Response object for a single user action.",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the user action."
          },
          "name": {
            "type": "string",
            "description": "Name of the user action."
          },
          "status": {
            "type": "string",
            "description": "Current status of the user action."
          }
        }
      },
      "GetAllUserActivityByCodeResponse": {
        "type": "object",
        "description": "Response object for all user activities related to a specific code.",
        "properties": {
          "activities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp of the activity."
                },
                "action": {
                  "type": "string",
                  "description": "Description of the user activity."
                }
              }
            }
          }
        }
      },
      "CheckUserActionByCodeRequest": {
        "type": "object",
        "description": "Request payload for validating a user action.",
        "properties": {
          "username": {
            "type": "string",
            "description": "Username of the user requesting action validation."
          }
        },
        "required": [
          "username"
        ]
      },
      "CheckUserActionByCodeResponse": {
        "type": "object",
        "description": "Response for successfully validating a user action by code.",
        "properties": {
          "isValid": {
            "type": "boolean",
            "description": "Indicates whether the user action is valid."
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry date of the user action."
          }
        }
      }
    }
  }
}
