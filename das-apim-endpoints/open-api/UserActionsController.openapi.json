{
  "openapi": "3.1.0",
  "info": {
    "title": "User Actions API",
    "version": "1.0.0"
  },
  "paths": {
    "/user-actions/{code}": {
      "get": {
        "summary": "Get user action by code",
        "description": "Retrieve a user action details based on the code.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/user-actions/{code}/all-activity": {
      "get": {
        "summary": "Get all user activities by code",
        "description": "Retrieve all activities for a specific user based on the code.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllUserActivityByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/user-actions/{code}/search": {
      "post": {
        "summary": "Check user action by code",
        "description": "Check if a specific action has been performed by a user, based on the code.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckUserActionByCodeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckUserActionByCodeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckUserActionByCodeRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "required": [
          "username"
        ]
      },
      "GetUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "string"
          }
        }
      },
      "GetAllUserActivityByCodeResponse": {
        "type": "object",
        "properties": {
          "activities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CheckUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "isActionValid": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
