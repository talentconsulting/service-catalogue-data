          }
        }
      },
      "AddressDetails": {
        "type": "object",
        "properties": {
          "Line1": {
            "type": "string",
            "nullable": true
          },
          "Line2": {
            "type": "string",
            "nullable": true
          },
          "Line3": {
            "type": "string",
            "nullable": true
          },
          "Line4": {
            "type": "string",
            "nullable": true
          },
          "Line5": {
            "type": "string",
            "nullable": true
          },
          "Postcode": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Operation": {
        "type": "string",
        "enum": [
          "CreateCohort",
          "Recruitment",
          "RecruitmentRequiresReview"
        ]
      }
    }
  }
