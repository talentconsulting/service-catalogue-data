{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Request Apprentice Training API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{accountId}/standard/{standardReference}/employer-request/existing": {
      "get": {
        "summary": "Check for existing employer request",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "standardReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns whether an employer request exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/accounts/{accountId}/employer-requests": {
      "post": {
        "summary": "Submit employer request",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitEmployerRequestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns the employer request ID",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to invalid location or other errors"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/accounts/{accountId}/dashboard": {
      "get": {
        "summary": "Get employer dashboard details",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns dashboard details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Dashboard"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitEmployerRequestRequest": {
        "type": "object",
        "properties": {
          "OriginalLocation": {
            "type": "string"
          },
          "RequestType": {
            "type": "string",
            "enum": [
              "Shortlist",
              "CourseDetail",
              "Providers"
            ]
          },
          "StandardReference": {
            "type": "string"
          },
          "NumberOfApprentices": {
            "type": "integer"
          },
          "SameLocation": {
            "type": "string"
          },
          "SingleLocation": {
            "type": "string"
          },
          "MultipleLocations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "AtApprenticesWorkplace": {
            "type": "boolean"
          },
          "DayRelease": {
            "type": "boolean"
          },
          "BlockRelease": {
            "type": "boolean"
          },
          "RequestedBy": {
            "type": "string",
            "format": "uuid"
          },
          "ModifiedBy": {
            "type": "string",
            "format": "uuid"
          },
          "DashboardUrl": {
            "type": "string"
          }
        }
      },
      "Dashboard": {
        "type": "object",
        "properties": {
          "AggregatedEmployerRequests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AggregatedEmployerRequest"
            }
          },
          "ExpiryAfterMonths": {
            "type": "integer"
          },
          "RemovedAfterExpiryMonths": {
            "type": "integer"
          }
        }
      },
      "AggregatedEmployerRequest": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
