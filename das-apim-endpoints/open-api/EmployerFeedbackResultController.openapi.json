{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback Result API",
    "version": "1.0.0"
  },
  "paths": {
    "/EmployerFeedbackResult": {
      "post": {
        "summary": "Submit employer feedback",
        "operationId": "SubmitEmployerFeedback",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitEmployerFeedbackRequestData"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content - Feedback submitted successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SubmitEmployerFeedbackRequestData": {
        "type": "object",
        "properties": {
          "UserRef": {
            "type": "string",
            "format": "uuid"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderRating": {
            "type": "string",
            "enum": [
              "VeryPoor",
              "Poor",
              "Good",
              "Excellent"
            ]
          },
          "FeedbackSource": {
            "type": "integer"
          },
          "ProviderAttributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAttributeData"
            }
          }
        },
        "required": [
          "UserRef",
          "Ukprn",
          "AccountId",
          "ProviderRating",
          "FeedbackSource"
        ]
      },
      "ProviderAttributeData": {
        "type": "object",
        "properties": {
          "AttributeId": {
            "type": "integer",
            "format": "int64"
          },
          "AttributeValue": {
            "type": "integer"
          }
        },
        "required": [
          "AttributeId",
          "AttributeValue"
        ]
      }
    }
  }
}
