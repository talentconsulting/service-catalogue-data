{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountId}/unapproved/add/select-funding": {
      "get": {
        "summary": "Get Select Funding Options",
        "operationId": "GetSelectFundingOptions",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Account ID for the funding options"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSelectFundingOptionsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSelectFundingOptionsQueryResponse": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64",
            "description": "The account ID for which funding options are retrieved"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Available funding options"
          }
        }
      }
    }
  }
}
