{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Funding Options API",
    "version": "1.0.0",
    "description": "API endpoints for managing select funding options."
  },
  "paths": {
    "/{accountId}/unapproved/add/select-funding": {
      "get": {
        "summary": "Get Select Funding options for a given account",
        "operationId": "getSelectFundingOptions",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSelectFundingOptionsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSelectFundingOptionsQueryResponse": {
        "type": "object",
        "description": "Response object containing select funding options.",
        "properties": {
          "fundingOptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "optionId": {
                  "type": "integer"
                },
                "description": {
                  "type": "string"
                },
                "amount": {
                  "type": "number",
                  "format": "decimal"
                }
              }
            }
          }
        }
      }
    }
  }
}
