{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/ProviderAccounts/{ukprn}": {
      "get": {
        "summary": "Gets the provider account status",
        "description": "Retrieves the provider account status based on the UKPRN.",
        "operationId": "getProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UKPRN of the provider.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the provider account status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderAccountResponse": {
        "type": "object",
        "properties": {
          "CanAccessService": {
            "type": "boolean",
            "description": "Indicates if the service can be accessed."
          }
        },
        "required": [
          "CanAccessService"
        ]
      }
    }
  }
}
