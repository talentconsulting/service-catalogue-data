{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/ProviderAccounts/{ukprn}": {
      "get": {
        "summary": "Retrieve Provider Status",
        "operationId": "GetProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the UK Provider Reference Number.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderAccountResponse": {
        "type": "object",
        "properties": {
          "CanAccessService": {
            "type": "boolean",
            "description": "Indicates whether the provider can access the apprenticeship service."
          }
        }
      }
    }
  }
}
