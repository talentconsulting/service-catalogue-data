{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/ProviderAccounts/{ukprn}": {
      "get": {
        "summary": "Get Provider Status",
        "description": "Retrieve the provider's access status by UKPRN.",
        "operationId": "GetProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK Provider Reference Number",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderAccountResponse": {
        "type": "object",
        "properties": {
          "CanAccessService": {
            "type": "boolean",
            "description": "Indicates whether the provider can access the service."
          }
        },
        "required": [
          "CanAccessService"
        ]
      }
    }
  }
}
