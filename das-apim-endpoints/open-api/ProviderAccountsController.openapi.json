{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS ApimDeveloper API",
    "version": "1.0.0"
  },
  "paths": {
    "/ProviderAccounts/{ukprn}": {
      "get": {
        "summary": "Get provider status",
        "operationId": "GetProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved provider status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderAccountResponse": {
        "type": "object",
        "properties": {
          "CanAccessService": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
