{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Accounts API",
    "version": "1.0.0",
    "description": "API for managing provider accounts and their access to apprenticeship services."
  },
  "paths": {
    "/ProviderAccounts/{ukprn}": {
      "get": {
        "tags": [
          "Provider Accounts"
        ],
        "summary": "Retrieve provider account status",
        "description": "Gets the access status of a provider account given its UKPRN (UK Provider Reference Number).",
        "operationId": "getProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The UKPRN of the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderAccountResponse": {
        "type": "object",
        "properties": {
          "CanAccessService": {
            "type": "boolean",
            "description": "Indicates whether the provider can access the apprenticeship service."
          }
        },
        "required": [
          "CanAccessService"
        ]
      }
    }
  }
}
