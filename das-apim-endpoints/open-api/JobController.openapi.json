{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/jobs": {
      "put": {
        "summary": "Add a new job request.",
        "operationId": "AddJob",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content. The job was added successfully."
          },
          "400": {
            "description": "Bad Request. The provided data is invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Details of the bad request."
                }
              }
            }
          }
        },
        "tags": [
          "Jobs"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "JobRequest": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/JobType"
          },
          "data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Additional data for the job request."
          }
        },
        "required": [
          "type",
          "data"
        ]
      },
      "JobType": {
        "type": "string",
        "enum": [
          "RefreshLegalEntities",
          "RefreshEmploymentChecks"
        ]
      }
    }
  }
}
