{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/jobs": {
      "put": {
        "operationId": "AddJob",
        "summary": "Add a new job for processing.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content - Job successfully added."
          },
          "400": {
            "description": "Bad Request - Invalid job data provided.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorCode": {
                      "type": "string"
                    },
                    "errorMessage": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "errorCode",
                    "errorMessage"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JobRequest": {
        "type": "object",
        "properties": {
          "Type": {
            "$ref": "#/components/schemas/JobType"
          },
          "Data": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "Type",
          "Data"
        ]
      },
      "JobType": {
        "type": "string",
        "enum": [
          "RefreshLegalEntities",
          "RefreshEmploymentChecks"
        ]
      }
    }
  }
}
