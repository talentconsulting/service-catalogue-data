{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin RoATP API",
    "version": "1.0.0"
  },
  "paths": {
    "/removed-reasons": {
      "get": {
        "operationId": "GetAllRemovedReasons",
        "summary": "Retrieve all removed reasons.",
        "tags": [
          "RemovedReasons"
        ],
        "responses": {
          "200": {
            "description": "Successful response with removed reasons.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRemovedReasonsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRemovedReasonsResponse": {
        "type": "object",
        "properties": {
          "ReasonsForRemoval": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RemovedReasonSummary"
            }
          }
        },
        "required": [
          "ReasonsForRemoval"
        ]
      },
      "RemovedReasonSummary": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Description": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
