{
  "openapi": "3.1.0",
  "info": {
    "title": "Member Profiles API",
    "description": "API for managing member profiles.",
    "version": "1.0.0"
  },
  "paths": {
    "/members/{memberId}/profile": {
      "get": {
        "summary": "Get Member Profile With Preferences",
        "description": "Retrieve the member profile along with preferences and apprenticeship details based on user type.",
        "operationId": "GetMemberProfileWithPreferences",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the member"
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the member requesting the data"
          },
          {
            "name": "public",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Flag indicating if the data should be publicly visible"
          }
        ],
        "responses": {
          "200": {
            "description": "Member profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemberProfileWithPreferencesModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMemberProfileWithPreferencesModel": {
        "type": "object",
        "properties": {
          "FullName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string",
            "nullable": true
          },
          "RegionId": {
            "type": "integer",
            "nullable": true
          },
          "RegionName": {
            "type": "string"
          },
          "JoinedDate": {
            "type": "string",
            "format": "date-time"
          },
          "UserType": {
            "type": "string",
            "enum": [
              "Apprentice",
              "Employer"
            ]
          },
          "IsRegionalChair": {
            "type": "boolean"
          },
          "Apprenticeship": {
            "$ref": "#/components/schemas/Apprenticeship"
          },
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberProfile"
            }
          },
          "Preferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberPreference"
            }
          }
        },
        "required": [
          "FullName",
          "Email",
          "FirstName",
          "LastName",
          "RegionName",
          "JoinedDate",
          "UserType",
          "IsRegionalChair",
          "Profiles",
          "Preferences"
        ]
      },
      "Apprenticeship": {
        "type": "object",
        "properties": {
          "Sector": {
            "type": "string"
          },
          "Programme": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "ActiveApprenticesCount": {
            "type": "integer"
          },
          "Sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MemberProfile": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Name"
        ]
      },
      "MemberPreference": {
        "type": "object",
        "properties": {
          "PreferenceId": {
            "type": "integer"
          },
          "Value": {
            "type": "boolean"
          }
        },
        "required": [
          "PreferenceId",
          "Value"
        ]
      }
    }
  }
}
