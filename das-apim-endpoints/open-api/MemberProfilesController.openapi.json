{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerAAN API",
    "version": "1.0.0",
    "description": "API for Member Profiles and Preferences"
  },
  "paths": {
    "/members/{memberId}/profile": {
      "get": {
        "summary": "Get Member Profile with Preferences",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the member whose profile is fetched"
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the member making the request"
          },
          {
            "name": "public",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": true
            },
            "description": "Flag for public access"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with member profile and preferences",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemberProfileWithPreferencesModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMemberProfileWithPreferencesModel": {
        "type": "object",
        "properties": {
          "FullName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string",
            "nullable": true
          },
          "RegionId": {
            "type": "integer",
            "nullable": true
          },
          "RegionName": {
            "type": "string"
          },
          "JoinedDate": {
            "type": "string",
            "format": "date-time"
          },
          "UserType": {
            "type": "string",
            "enum": [
              "Apprentice",
              "Employer"
            ]
          },
          "IsRegionalChair": {
            "type": "boolean"
          },
          "Apprenticeship": {
            "$ref": "#/components/schemas/Apprenticeship"
          },
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberProfile"
            }
          },
          "Preferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberPreference"
            }
          }
        }
      },
      "Apprenticeship": {
        "type": "object",
        "properties": {
          "Sector": {
            "type": "string"
          },
          "Programme": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "ActiveApprenticesCount": {
            "type": "integer"
          },
          "Sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MemberProfile": {
        "type": "object",
        "additionalProperties": true
      },
      "MemberPreference": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
