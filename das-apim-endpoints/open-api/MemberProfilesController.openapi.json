{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeAan API",
    "version": "1.0.0"
  },
  "paths": {
    "/members/{memberId}/profile": {
      "get": {
        "summary": "Get Member Profile with Preferences",
        "operationId": "getMemberProfileWithPreferences",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for a member",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "description": "Identifier of the member making the request",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "public",
            "in": "query",
            "required": false,
            "description": "Boolean flag indicating if the data is public",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Member profile with preferences retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemberProfileWithPreferencesModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMemberProfileWithPreferencesModel": {
        "type": "object",
        "properties": {
          "FullName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string",
            "nullable": true
          },
          "RegionId": {
            "type": "integer",
            "nullable": true
          },
          "RegionName": {
            "type": "string"
          },
          "JoinedDate": {
            "type": "string",
            "format": "date-time"
          },
          "UserType": {
            "$ref": "#/components/schemas/MemberUserType"
          },
          "IsRegionalChair": {
            "type": "boolean"
          },
          "Apprenticeship": {
            "$ref": "#/components/schemas/Apprenticeship"
          },
          "Profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberProfile"
            }
          },
          "Preferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberPreference"
            }
          }
        }
      },
      "Apprenticeship": {
        "type": "object",
        "properties": {
          "Sector": {
            "type": "string"
          },
          "Programme": {
            "type": "string"
          },
          "Level": {
            "type": "string"
          },
          "ActiveApprenticesCount": {
            "type": "integer"
          },
          "Sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "MemberUserType": {
        "type": "string",
        "enum": [
          "Apprentice",
          "Employer"
        ]
      },
      "MemberProfile": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "MemberPreference": {
        "type": "object",
        "properties": {
          "PreferenceId": {
            "type": "integer"
          },
          "Value": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
