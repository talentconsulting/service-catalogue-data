{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/ApprenticeFeedback/": {
      "post": {
        "summary": "Create Feedback Target",
        "operationId": "CreateFeedbackTarget",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApprenticeFeedbackCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with feedback",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApprenticeFeedbackResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateApprenticeFeedbackCommand": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          },
          "OverallRating": {
            "$ref": "#/components/schemas/OverallRating"
          },
          "AllowContact": {
            "type": "boolean"
          },
          "FeedbackAttributes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackAttribute"
            }
          }
        },
        "required": [
          "ApprenticeFeedbackTargetId",
          "OverallRating",
          "AllowContact",
          "FeedbackAttributes"
        ]
      },
      "FeedbackAttribute": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/FeedbackAttributeStatus"
          }
        },
        "required": [
          "Id",
          "Name",
          "Status"
        ]
      },
      "CreateApprenticeFeedbackResponse": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackResultId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "ApprenticeFeedbackResultId"
        ]
      },
      "OverallRating": {
        "type": "string",
        "enum": [
          "VeryPoor",
          "Poor",
          "Good",
          "Excellent"
        ]
      },
      "FeedbackAttributeStatus": {
        "type": "string",
        "enum": [
          "Disagree",
          "Agree"
        ]
      }
    }
  }
}
