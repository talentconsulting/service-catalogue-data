{
  "openapi": "3.1.0",
  "info": {
    "title": "Restricted Courses API",
    "version": "1.0.0",
    "description": "API for managing restricted courses."
  },
  "paths": {
    "/restricted-courses": {
      "get": {
        "operationId": "GetRestrictedCourses",
        "summary": "Retrieves a list of restricted courses.",
        "parameters": [
          {
            "name": "restricted",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            },
            "description": "Filter for restricted courses."
          }
        ],
        "responses": {
          "200": {
            "description": "List of restricted courses retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllRestrictedCoursesResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "AddRestrictedCourse",
        "summary": "Adds a new restricted course.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRestrictedCourseCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Restricted course created successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddRestrictedCourseCommand": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "Identifier of the user creating the restricted course."
          },
          "UserDisplayName": {
            "type": "string",
            "description": "Name of the user creating the restricted course."
          },
          "LarsCode": {
            "type": "string",
            "description": "Unique identifier for the course."
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "LarsCode"
        ]
      },
      "GetAllRestrictedCoursesResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestrictedCourseModel"
            },
            "description": "List of restricted courses."
          }
        }
      },
      "RestrictedCourseModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string",
            "description": "Unique identifier for the course."
          },
          "Title": {
            "type": "string",
            "description": "Title of the course."
          },
          "Level": {
            "type": "integer",
            "description": "Level of the course."
          },
          "LearningType": {
            "type": "string",
            "description": "Type of learning for the course."
          }
        },
        "required": [
          "LarsCode",
          "Title",
          "Level",
          "LearningType"
        ]
      }
    }
  }
}
