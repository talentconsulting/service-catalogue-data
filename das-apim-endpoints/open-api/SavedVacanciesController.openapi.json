{
  "openapi": "3.1.0",
  "info": {
    "title": "Saved Vacancies API",
    "version": "1.0.0"
  },
  "paths": {
    "/saved-vacancies/": {
      "get": {
        "summary": "Get saved vacancies",
        "operationId": "getSavedVacancies",
        "parameters": [
          {
            "name": "candidateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {}
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/saved-vacancies/{candidateId}/add": {
      "post": {
        "summary": "Add a saved vacancy",
        "operationId": "addSavedVacancy",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveVacancyApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/saved-vacancies/{candidateId}/delete": {
      "post": {
        "summary": "Delete a saved vacancy",
        "operationId": "deleteSavedVacancy",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteSavedVacancyApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaveVacancyApiRequest": {
        "type": "object",
        "properties": {
          "VacancyId": {
            "type": "string"
          },
          "VacancyReference": {
            "type": "string"
          }
        },
        "required": [
          "VacancyId",
          "VacancyReference"
        ]
      },
      "DeleteSavedVacancyApiRequest": {
        "type": "object",
        "properties": {
          "VacancyId": {
            "type": "string"
          },
          "DeleteAllByVacancyReference": {
            "type": "boolean"
          }
        },
        "required": [
          "VacancyId",
          "DeleteAllByVacancyReference"
        ]
      }
    }
  }
}
