{
  "openapi": "3.1.0",
  "info": {
    "title": "Qualifications API",
    "description": "API for managing qualifications and related data.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/qualifications": {
      "get": {
        "summary": "Get qualifications",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "take",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisation",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "qan",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "processStatusFilter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "name": "ageGroups",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetNewQualificationsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/detail": {
      "get": {
        "summary": "Get qualification details",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationDetailsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/detailwithversions": {
      "get": {
        "summary": "Get qualification detail with versions",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Invalid request"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/qualificationversions/{version}": {
      "get": {
        "summary": "Get qualification details for a specific version",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationDetailsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/qualificationdiscussionhistory": {
      "post": {
        "summary": "Add qualification discussion history",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQualificationDiscussionHistoryCommand"
              }
            }
          }
        },
        "responses": {
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/processstatuses": {
      "get": {
        "summary": "Get processing statuses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProcessStatusesQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/qualificationdiscussionhistories": {
      "get": {
        "summary": "Get discussion histories for qualification",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetDiscussionHistoriesForQualificationQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/bulk-status": {
      "put": {
        "summary": "Bulk status update",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUpdateQualificationStatusCommand"
              }
            }
          }
        },
        "responses": {
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/api/qualifications/qualificationstatus": {
      "post": {
        "summary": "Update qualification status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateQualificationStatusCommand"
              }
            }
          }
        },
        "responses": {
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaseMediatrResponse_GetNewQualificationsQueryResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "ErrorMessage": {
            "type": "string"
          },
          "ErrorCode": {
            "type": "string"
          },
          "Value": {
            "$ref": "#/components/schemas/GetNewQualificationsQueryResponse"
          }
        }
      },
      "GetNewQualificationsQueryResponse": {
        "type": "object",
        "properties": {
          "TotalRecords": {
            "type": "integer"
          },
          "Skip": {
            "type": "integer"
          },
          "Take": {
            "type": "integer"
          },
          "Data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NewQualification"
            }
          },
          "Job": {
            "$ref": "#/components/schemas/Job"
          }
        }
      },
      "NewQualification": {
        "type": "object",
        "properties": {
          "QualificationId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Reference": {
            "type": "string"
          },
          "AwardingOrganisation": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "AgeGroup": {
            "type": "string"
          },
          "EligibleForFunding": {
            "type": "boolean"
          }
        }
      },
      "Job": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "LastRunTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AddQualificationDiscussionHistoryCommand": {
        "type": "object",
        "properties": {
          "QualificationReference": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "QualificationReference"
        ]
      },
      "GetProcessStatusesQueryResponse": {
        "type": "object",
        "properties": {
          "ProcessStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProcessStatus"
            }
          }
        }
      },
      "ProcessStatus": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "IsOutcomeDecision": {
            "type": "integer"
          }
        }
      },
      "BaseMediatrResponse_GetDiscussionHistoriesForQualificationQueryResponse": {
        "type": "object",
        "properties": {
          "QualificationDiscussionHistories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QualificationDiscussionHistory"
            }
          }
        }
      },
      "QualificationDiscussionHistory": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationId": {
            "type": "string",
            "format": "uuid"
          },
          "ActionTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "Notes": {
            "type": "string"
          },
          "Timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          }
        }
      },
      "BulkUpdateQualificationStatusCommand": {
        "type": "object",
        "properties": {
          "QualificationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "ProcessStatusId": {
            "type": "string",
            "format": "uuid"
          },
          "Comment": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          }
        },
        "required": [
          "QualificationIds",
          "ProcessStatusId"
        ]
      },
      "UpdateQualificationStatusCommand": {
        "type": "object",
        "properties": {
          "QualificationReference": {
            "type": "string"
          },
          "ProcessStatusId": {
            "type": "string",
            "format": "uuid"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "Version": {
            "type": "integer"
          },
          "Notes": {
            "type": "string"
          }
        },
        "required": [
          "QualificationReference",
          "ProcessStatusId"
        ]
      }
    }
  }
}
