            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationQualificationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/{applicationId}/qualifications/delete/{qualificationReferenceId}": {
      "get": {
        "summary": "Get qualifications to delete.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "qualificationReferenceId",
