        "properties": {
          "qualificationReference": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "GetProcessStatusesQueryResponse": {
        "type": "object",
        "properties": {
          "processStatuses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "isOutcomeDecision": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "GetChangedQualificationsQueryResponse": {
        "type": "object",
        "properties": {
          "totalRecords": {
            "type": "integer"
          },
          "skip": {
            "type": "integer"
          },
          "take": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "qualificationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "qualificationReference": {
                  "type": "string"
                }
              }
            }
          },
          "job": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "lastRunTime": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "GetNewQualificationsQueryResponse": {
        "type": "object",
        "properties": {
          "totalRecords": {
            "type": "integer"
          },
          "skip": {
            "type": "integer"
          },
          "take": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "qualificationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "qualificationReference": {
                  "type": "string"
                }
              }
            }
          },
          "job": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "lastRunTime": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      },
      "GetDiscussionHistoriesForQualificationQueryResponse": {
        "type": "object",
        "properties": {
          "qualificationDiscussionHistories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "qualificationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "actionTypeId": {
                  "type": "string",
                  "format": "uuid"
                },
                "userDisplayName": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "GetQualificationDetailsQueryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "qualificationReference": {
            "type": "string"
