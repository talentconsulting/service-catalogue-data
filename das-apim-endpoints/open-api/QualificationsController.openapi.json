{
  "openapi": "3.1.0",
  "info": {
    "title": "Aodp API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/qualifications": {
      "get": {
        "summary": "Get qualifications",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          },
          {
            "name": "take",
            "in": "query",
            "schema": {
              "type": "integer",
              "nullable": true
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "organisation",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "qan",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            }
          },
          {
            "name": "processStatusFilter",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "name": "ageGroups",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgeGroup"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/detail": {
      "get": {
        "summary": "Get qualification details",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationDetailsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/detailwithversions": {
      "get": {
        "summary": "Get qualification details with versions",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/qualificationversions/{version}": {
      "get": {
        "summary": "Get qualification details by reference and version",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationDetailsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/qualificationdiscussionhistory": {
      "post": {
        "summary": "Add qualification discussion history",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddQualificationDiscussionHistoryCommand"
              }
            }
          }
        },
        "responses": {
          "404": {
            "description": "Not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/qualificationdiscussionhistories": {
      "get": {
        "summary": "Get discussion histories for qualification",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetDiscussionHistoriesForQualificationQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgeGroup": {
        "type": "string",
        "enum": [
          "Pre16",
          "SixteenToEighteen",
          "EighteenPlus",
          "NineteenPlus"
        ]
      },
      "BaseMediatrResponse_GetQualificationsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "AddQualificationDiscussionHistoryCommand": {
        "type": "object",
        "required": [
          "qualificationReference"
        ],
        "properties": {
          "qualificationReference": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BaseMediatrResponse_GetDiscussionHistoriesForQualificationQueryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/DiscussionHistory"
          }
        }
      },
      "DiscussionHistory": {
        "type": "object",
        "properties": {
          "qualificationDiscussionHistories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "qualificationId": {
                  "type": "string",
                  "format": "uuid"
                },
                "actionTypeId": {
                  "type": "string",
                  "format": "uuid"
                },
                "userDisplayName": {
                  "type": "string"
                },
                "notes": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}
