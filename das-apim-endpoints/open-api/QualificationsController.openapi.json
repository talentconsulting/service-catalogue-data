      },
      "post": {
        "summary": "Delete a qualification.",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "qualificationReferenceId",
            "in": "path",
            "required": true,
