{
  "openapi": "3.1.0",
  "info": {
    "title": "Qualifications API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/qualifications": {
      "get": {
        "summary": "Get qualifications",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "take",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "organisation",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "qan",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "processStatusFilter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          {
            "name": "ageGroups",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/AgeGroup"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/detail": {
      "get": {
        "summary": "Get qualification details",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Qualification details found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationDetailsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Qualification not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/qualificationversions/{version}": {
      "get": {
        "summary": "Get qualification details for a specific version",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Qualification details found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationDetailsQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Qualification version not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/{qualificationReference}/qualificationdiscussionhistories": {
      "get": {
        "summary": "Get discussion histories for a qualification",
        "parameters": [
          {
            "name": "qualificationReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Discussion histories retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetDiscussionHistoriesForQualificationQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/qualifications/outputfile/logs": {
      "get": {
        "summary": "Get qualification output file logs",
        "responses": {
          "200": {
            "description": "Logs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_GetQualificationOutputFileLogResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgeGroup": {
        "type": "string",
        "enum": [
          "Pre16",
          "SixteenToEighteen",
          "EighteenPlus",
          "NineteenPlus"
        ]
      },
      "BaseMediatrResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "ErrorMessage": {
            "type": "string"
          },
          "ErrorCode": {
            "type": "string"
          },
          "Value": {
            "type": "object"
          }
        }
      },
      "BaseMediatrResponse_GetQualificationDetailsQueryResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationId": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "AgeGroup": {
            "type": "string"
          }
        }
      },
      "BaseMediatrResponse_GetDiscussionHistoriesForQualificationQueryResponse": {
        "type": "object",
        "properties": {
          "QualificationDiscussionHistories": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string",
                  "format": "uuid"
                },
                "UserDisplayName": {
                  "type": "string"
                },
                "Notes": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "BaseMediatrResponse_GetQualificationOutputFileLogResponse": {
        "type": "object",
        "properties": {
          "OutputFileLogs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "string",
                  "format": "uuid"
                },
                "UserDisplayName": {
                  "type": "string"
                },
                "DownloadDate": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    }
  }
}
