  },
  "components": {
    "schemas": {
      "PostQualificationsApiRequest": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "format": "uuid"
          },
          "isComplete": {
            "type": "boolean"
          }
        }
      },
      "PostDeleteQualificationsApiRequest": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "format": "uuid"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "UpdateApplicationQualificationRequest": {
        "type": "object",
        "properties": {
          "candidateId": {
            "type": "string",
            "format": "uuid"
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "toYear": {
                  "type": "integer",
                  "nullable": true
                },
                "grade": {
                  "type": "string",
                  "nullable": true
                },
                "name": {
                  "type": "string",
                  "nullable": true
                },
                "isPredicted": {
                  "type": "boolean",
                  "nullable": true
                },
                "qualificationOrder": {
                  "type": "integer",
                  "format": "int16",
                  "nullable": true
                },
                "additionalInformation": {
                  "type": "string",
                  "nullable": true
                },
                "isDeleted": {
                  "type": "boolean",
                  "nullable": true
                }
              }
            }
          }
        }
      }
    }
  }
}
