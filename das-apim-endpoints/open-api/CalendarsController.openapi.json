{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS AdminAan API",
    "version": "1.0.0",
    "description": "API for managing calendars in SFA DAS AdminAan."
  },
  "paths": {
    "/Calendars": {
      "get": {
        "summary": "Retrieve all calendars",
        "operationId": "GetCalendars",
        "tags": [
          "Calendars"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved calendars.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "example": 1
          },
          "CalendarName": {
            "type": "string",
            "example": "Calendar Name"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T00:00:00Z"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2023-12-31T23:59:59Z"
          },
          "Ordering": {
            "type": "integer",
            "example": 1
          }
        },
        "required": [
          "Id",
          "CalendarName",
          "EffectiveFrom",
          "Ordering"
        ]
      }
    }
  }
}
