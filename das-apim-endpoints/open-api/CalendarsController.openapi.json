{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeAan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Calendars": {
      "get": {
        "operationId": "GeCalendars",
        "summary": "Get all calendars",
        "responses": {
          "200": {
            "description": "Successful response with the list of calendars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The unique identifier for the calendar"
          },
          "CalendarName": {
            "type": "string",
            "description": "The name of the calendar"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time from which the calendar is effective"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "The date and time until which the calendar is effective"
          },
          "Ordering": {
            "type": "integer",
            "description": "The ordering value for the calendar"
          }
        },
        "required": [
          "Id",
          "CalendarName",
          "EffectiveFrom",
          "Ordering"
        ]
      }
    }
  }
}
