{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Aan API",
    "version": "1.0.0",
    "description": "API for managing calendars in the Employer Aan portal."
  },
  "paths": {
    "/calendars": {
      "get": {
        "summary": "Get Calendars",
        "operationId": "GetCalendars",
        "tags": [
          "Calendars"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved calendars.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1,
            "description": "Unique identifier for the calendar."
          },
          "calendarName": {
            "type": "string",
            "example": "Events Calendar",
            "description": "Name of the calendar."
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time",
            "example": "2023-10-01T00:00:00Z",
            "description": "Start date for the calendar's availability."
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-01T00:00:00Z",
            "description": "End date for the calendar's availability. Null if ongoing."
          },
          "ordering": {
            "type": "integer",
            "example": 1,
            "description": "Ordering position for the calendar in a list."
          }
        },
        "required": [
          "id",
          "calendarName",
          "effectiveFrom",
          "ordering"
        ]
      }
    }
  }
}
