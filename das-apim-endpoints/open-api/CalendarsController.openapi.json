{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Calendars": {
      "get": {
        "operationId": "GetCalendars",
        "summary": "Retrieve a list of calendars",
        "tags": [
          "Calendars"
        ],
        "responses": {
          "200": {
            "description": "List of calendars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "example": 1
          },
          "CalendarName": {
            "type": "string",
            "example": "Event Calendar"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T00:00:00Z"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "example": "2023-12-31T00:00:00Z"
          },
          "Ordering": {
            "type": "integer",
            "example": 1
          }
        }
      }
    }
  }
}
