{
  "openapi": "3.1.0",
  "info": {
    "title": "Calendars API",
    "version": "1.0.0"
  },
  "paths": {
    "/Calendars": {
      "get": {
        "operationId": "GetCalendars",
        "summary": "Retrieve a list of calendars",
        "responses": {
          "200": {
            "description": "A list of calendars",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "calendarName": {
            "type": "string"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "effectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ordering": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "calendarName",
          "effectiveFrom",
          "ordering"
        ]
      }
    }
  }
}
