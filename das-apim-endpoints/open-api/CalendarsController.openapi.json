{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice AAN API",
    "version": "1.0.0"
  },
  "paths": {
    "/Calendars": {
      "get": {
        "summary": "Get calendars",
        "operationId": "GetCalendars",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique identifier of the calendar"
          },
          "CalendarName": {
            "type": "string",
            "description": "Name of the calendar"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "Date when the calendar becomes effective"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Date when the calendar is no longer effective"
          },
          "Ordering": {
            "type": "integer",
            "description": "Ordering value for the calendar"
          }
        },
        "required": [
          "Id",
          "CalendarName",
          "EffectiveFrom",
          "Ordering"
        ]
      }
    }
  }
}
