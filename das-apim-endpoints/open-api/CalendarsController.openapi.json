{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan API",
    "version": "1.0.0",
    "description": "API for retrieving calendar information."
  },
  "paths": {
    "/Calendars": {
      "get": {
        "summary": "Get Calendars",
        "operationId": "GetCalendars",
        "tags": [
          "Calendars"
        ],
        "responses": {
          "200": {
            "description": "A list of calendars.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Calendar"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Calendar": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique identifier for the calendar."
          },
          "CalendarName": {
            "type": "string",
            "description": "Name of the calendar."
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time",
            "description": "The date from which the calendar is effective."
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "The date up to which the calendar is effective."
          },
          "Ordering": {
            "type": "integer",
            "description": "Ordering index for the calendar."
          }
        }
      }
    }
  }
}
