{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/legalentities/vendorregistrationform/status": {
      "patch": {
        "operationId": "RefreshVendorRegistrationFormStatus",
        "summary": "Refresh the vendor registration form case status.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "DateTime to determine the starting point for refreshing the status."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      }
    },
    "/legalentities/{hashedLegalEntityId}/employervendorid": {
      "put": {
        "operationId": "AddEmployerVendorId",
        "summary": "Add an employer vendor ID to a legal entity.",
        "parameters": [
          {
            "name": "hashedLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed identifier of the legal entity."
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully added vendor ID."
          }
        }
      }
    },
    "/legalentities/refresh": {
      "put": {
        "operationId": "RefreshLegalEntities",
        "summary": "Refresh legal entities data.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The page number to refresh."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The size of the page to refresh."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully refreshed legal entities."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
