{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerFinance API",
    "version": "1.0.0"
  },
  "paths": {
    "/Transfers/{accountId}/counts": {
      "get": {
        "summary": "Get transfer counts",
        "operationId": "GetCounts",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Transfer counts retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCountsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/Transfers/{accountId}/financial-breakdown": {
      "get": {
        "summary": "Get financial breakdown",
        "operationId": "GetFinancialBreakdown",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Account ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Financial breakdown retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFinancialBreakdownResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCountsResponse": {
        "type": "object",
        "properties": {
          "PledgesCount": {
            "type": "integer",
            "example": 10
          },
          "ApplicationsCount": {
            "type": "integer",
            "example": 5
          },
          "CurrentYearEstimatedCommittedSpend": {
            "type": "integer",
            "example": 20000
          }
        }
      },
      "GetFinancialBreakdownResponse": {
        "type": "object",
        "properties": {
          "TransferConnections": {
            "type": "integer",
            "example": 3
          },
          "AcceptedPledgeApplications": {
            "type": "integer",
            "example": 7
          },
          "ApprovedPledgeApplications": {
            "type": "integer",
            "example": 5
          },
          "PledgeOriginatedCommitments": {
            "type": "integer",
            "example": 8
          },
          "Commitments": {
            "type": "integer",
            "example": 12
          },
          "AmountPledged": {
            "type": "integer",
            "example": 50000
          }
        }
      }
    }
  }
}
