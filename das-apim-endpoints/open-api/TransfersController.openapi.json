{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Finance Transfers API",
    "version": "1.0.0"
  },
  "paths": {
    "/Transfers/{accountId}/counts": {
      "get": {
        "summary": "Get transfer counts for an account",
        "operationId": "getTransferCounts",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCountsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/Transfers/{accountId}/financial-breakdown": {
      "get": {
        "summary": "Get financial breakdown for an account",
        "operationId": "getFinancialBreakdown",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFinancialBreakdownResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCountsResponse": {
        "type": "object",
        "properties": {
          "PledgesCount": {
            "type": "integer"
          },
          "ApplicationsCount": {
            "type": "integer"
          },
          "CurrentYearEstimatedCommittedSpend": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "GetFinancialBreakdownResponse": {
        "type": "object",
        "properties": {
          "TransferConnections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "AcceptedPledgeApplications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ApprovedPledgeApplications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "PledgeOriginatedCommitments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Commitments": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "AmountPledged": {
            "type": "number",
            "format": "double"
          }
        }
      }
    }
  }
}
