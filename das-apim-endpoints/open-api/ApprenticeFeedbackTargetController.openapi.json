{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/ApprenticeFeedbackTarget/": {
      "post": {
        "operationId": "CreateFeedbackTarget",
        "summary": "Create a new apprentice feedback target.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApprenticeFeedbackTargetCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created feedback target.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApprenticeFeedbackTargetResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "UpdateFeedbackTarget",
        "summary": "Trigger an update for a feedback target.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriggerFeedbackTargetUpdateCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully triggered feedback target update.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TriggerFeedbackTargetUpdateResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/ApprenticeFeedbackTarget/requiresupdate": {
      "get": {
        "operationId": "GetFeedbackTargetsForUpdate",
        "summary": "Retrieve feedback targets requiring update.",
        "parameters": [
          {
            "name": "batchSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved feedback targets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/ApprenticeFeedbackTarget/{apprenticeId}": {
      "get": {
        "operationId": "GetAllForApprentice",
        "summary": "Retrieve all feedback targets for an apprentice.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved feedback targets.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/ApprenticeFeedbackTarget/{id}/exitsurvey": {
      "get": {
        "operationId": "GetExitSurveyForApprenticeFeedbackTarget",
        "summary": "Retrieve exit survey for a specific feedback target.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved exit survey.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateApprenticeFeedbackTargetCommand": {
        "type": "object",
        "properties": {
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ConfirmationId": {
            "type": "integer",
            "format": "int64"
          },
          "ConfirmedOn": {
            "type": "string",
            "format": "date-time"
          },
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "CommitmentsApprovedOn": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateApprenticeFeedbackTargetResponse": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TriggerFeedbackTargetUpdateCommand": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "TriggerFeedbackTargetUpdateResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "Message": {
            "type": "string"
          }
        }
      }
    }
  }
}
