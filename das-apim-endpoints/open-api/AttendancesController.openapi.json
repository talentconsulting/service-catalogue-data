{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer AAN API",
    "version": "1.0.0"
  },
  "paths": {
    "/Attendances": {
      "get": {
        "summary": "Retrieve attendances within a date range",
        "parameters": [
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the member making the request"
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date of the attendance range"
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date of the attendance range"
          }
        ],
        "responses": {
          "200": {
            "description": "List of attendances",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AttendanceList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttendanceList": {
        "type": "object",
        "properties": {
          "attendances": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "attendanceId": {
                  "type": "string",
                  "format": "uuid"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "memberId": {
                  "type": "string",
                  "format": "uuid"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
