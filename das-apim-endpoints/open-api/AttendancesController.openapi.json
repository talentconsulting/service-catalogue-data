{
  "openapi": "3.1.0",
  "info": {
    "title": "Attendances API",
    "version": "1.0.0"
  },
  "paths": {
    "/Attendances": {
      "get": {
        "summary": "Retrieve attendances within a specified date range",
        "operationId": "GetAttendances",
        "parameters": [
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "ID of the member requesting data"
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date in YYYY-MM-DD format"
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date in YYYY-MM-DD format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of attendance data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attendances"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attendances": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
