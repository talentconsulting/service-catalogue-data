{
  "openapi": "3.1.0",
  "info": {
    "title": "Attendances API",
    "version": "1.0.0"
  },
  "paths": {
    "/Attendances": {
      "get": {
        "summary": "Retrieve attendances",
        "operationId": "GetAttendances",
        "parameters": [
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the member making the request."
          },
          {
            "name": "fromDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Start date for filtering attendances."
          },
          {
            "name": "toDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "End date for filtering attendances."
          }
        ],
        "responses": {
          "200": {
            "description": "List of attendances retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Attendances"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input parameters."
          },
          "401": {
            "description": "Unauthorized."
          },
          "500": {
            "description": "Server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attendances": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
