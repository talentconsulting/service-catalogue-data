{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice App API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/registeredProviders": {
      "get": {
        "operationId": "GetRegisteredProviders",
        "summary": "Retrieves registered providers",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRegisteredProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/activeStandards": {
      "get": {
        "operationId": "GetActiveStandards",
        "summary": "Retrieves active standards",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetActiveStandardsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRegisteredProvidersResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Ukprn": {
                  "type": "integer"
                },
                "LegalName": {
                  "type": "string"
                },
                "TradingName": {
                  "type": "string"
                },
                "ContactDetails": {
                  "type": "object",
                  "properties": {
                    "Title": {
                      "type": "string"
                    },
                    "FirstName": {
                      "type": "string"
                    },
                    "LastName": {
                      "type": "string"
                    },
                    "Email": {
                      "type": "string"
                    },
                    "Telephone": {
                      "type": "string"
                    },
                    "Website": {
                      "type": "string"
                    }
                  }
                },
                "LegalAddress": {
                  "type": "object",
                  "properties": {
                    "Address1": {
                      "type": "string"
                    },
                    "Address2": {
                      "type": "string"
                    },
                    "Address3": {
                      "type": "string"
                    },
                    "Address4": {
                      "type": "string"
                    },
                    "Town": {
                      "type": "string"
                    },
                    "County": {
                      "type": "string"
                    },
                    "Postcode": {
                      "type": "string"
                    }
                  }
                },
                "VerificationDetails": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "VerificationAuthority": {
                        "type": "string"
                      },
                      "VerificationId": {
                        "type": "string"
                      },
                      "PrimaryVerificationSource": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "GetActiveStandardsResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "StandardId": {
                  "type": "string"
                },
                "Title": {
                  "type": "string"
                },
                "Level": {
                  "type": "integer"
                },
                "DurationMonths": {
                  "type": "integer"
                },
                "MaxFunding": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
