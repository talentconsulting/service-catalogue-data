{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice App API",
    "version": "1.0.0",
    "description": "API for apprentice-related services"
  },
  "paths": {
    "/providers/registeredProviders": {
      "get": {
        "summary": "Get Registered Providers",
        "operationId": "GetRegisteredProviders",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UkrlpProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/activeStandards": {
      "get": {
        "summary": "Get Active Standards",
        "operationId": "GetActiveStandards",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveStandardsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UkrlpProvidersResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UkrlpProviderModel"
            }
          }
        }
      },
      "UkrlpProviderModel": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string"
          },
          "contactDetails": {
            "$ref": "#/components/schemas/ProviderContactModel"
          },
          "legalAddress": {
            "$ref": "#/components/schemas/UkrlpAddress"
          },
          "verificationDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VerificationInfo"
            }
          }
        }
      },
      "ProviderContactModel": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "telephone": {
            "type": "string"
          },
          "website": {
            "type": "string"
          }
        }
      },
      "UkrlpAddress": {
        "type": "object",
        "properties": {
          "address1": {
            "type": "string"
          },
          "address2": {
            "type": "string"
          },
          "address3": {
            "type": "string"
          },
          "address4": {
            "type": "string"
          },
          "town": {
            "type": "string"
          },
          "county": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          }
        }
      },
      "VerificationInfo": {
        "type": "object",
        "properties": {
          "verificationAuthority": {
            "type": "string"
          },
          "verificationId": {
            "type": "string"
          },
          "primaryVerificationSource": {
            "type": "boolean"
          }
        }
      },
      "ActiveStandardsResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Course"
            }
          }
        }
      },
      "Course": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "duration": {
            "type": "integer"
          }
        }
      }
    }
  }
}
