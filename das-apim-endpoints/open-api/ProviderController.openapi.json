{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider API",
    "version": "1.0.0",
    "description": "API for managing providers and their active standards."
  },
  "paths": {
    "/providers/registeredProviders": {
      "get": {
        "operationId": "GetRegisteredProviders",
        "summary": "Retrieve a list of registered providers",
        "tags": [
          "Providers"
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of registered providers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UkrlpProvidersResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/activeStandards": {
      "get": {
        "operationId": "GetActiveStandards",
        "summary": "Retrieve a list of active standards",
        "tags": [
          "Providers"
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of active standards",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Standard"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UkrlpProvidersResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UkrlpProviderModel"
            }
          }
        }
      },
      "UkrlpProviderModel": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "example": 12345678
          },
          "legalName": {
            "type": "string",
            "example": "Legal Name"
          },
          "tradingName": {
            "type": "string",
            "example": "Trading Name"
          },
          "contactDetails": {
            "$ref": "#/components/schemas/ProviderContactModel"
          },
          "legalAddress": {
            "$ref": "#/components/schemas/Address"
          },
          "verificationDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VerificationInfo"
            }
          }
        }
      },
      "ProviderContactModel": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Dr."
          },
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "example": "johndoe@example.com"
          },
          "telephone": {
            "type": "string",
            "example": "01234 567890"
          },
          "website": {
            "type": "string",
            "example": "http://example.com"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "address1": {
            "type": "string",
            "example": "123 Street Lane"
          },
          "address2": {
            "type": "string",
            "example": "Suite 456"
          },
          "address3": {
            "type": "string",
            "example": "Building 7"
          },
          "address4": {
            "type": "string",
            "example": "Business Park"
          },
          "town": {
            "type": "string",
            "example": "Townsville"
          },
          "county": {
            "type": "string",
            "example": "Countyshire"
          },
          "postcode": {
            "type": "string",
            "example": "AB12 3CD"
          }
        }
      },
      "VerificationInfo": {
        "type": "object",
        "properties": {
          "verificationAuthority": {
            "type": "string",
            "example": "Authority Name"
          },
          "verificationId": {
            "type": "string",
            "example": "12345678"
          },
          "primaryVerificationSource": {
            "type": "boolean",
            "example": true
          }
        }
      },
      "Standard": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Software Development"
          },
          "code": {
            "type": "string",
            "example": "ST0123"
          },
          "level": {
            "type": "string",
            "example": "Level 3"
          }
        }
      }
    }
  }
}
