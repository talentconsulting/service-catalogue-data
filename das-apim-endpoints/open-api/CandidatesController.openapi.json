{
  "openapi": "3.1.0",
  "info": {
    "title": "Candidates API",
    "version": "1.0.0",
    "description": "API for managing candidates and their statuses."
  },
  "paths": {
    "/Candidates/GetInactiveCandidates": {
      "get": {
        "summary": "Get inactive candidates",
        "parameters": [
          {
            "name": "cutOffDateTime",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInactiveCandidatesQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/Candidates/{govIdentifier}/status": {
      "post": {
        "summary": "Update candidate status",
        "parameters": [
          {
            "name": "govIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidateUpdateStatusRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CandidateUpdateStatusRequest": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        },
        "required": [
          "Email",
          "Status"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "Incomplete",
          "Completed",
          "InProgress",
          "Deleted",
          "Dormant"
        ]
      },
      "GetInactiveCandidatesQueryResult": {
        "type": "object",
        "properties": {
          "Candidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "TotalCount": {
            "type": "integer"
          },
          "PageIndex": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          }
        }
      },
      "Candidate": {
        "type": "object",
        "properties": {
          "Address": {
            "$ref": "#/components/schemas/Address"
          },
          "GovUkIdentifier": {
            "type": "string",
            "nullable": true
          },
          "LastName": {
            "type": "string",
            "nullable": true
          },
          "FirstName": {
            "type": "string",
            "nullable": true
          },
          "MiddleNames": {
            "type": "string",
            "nullable": true
          },
          "PhoneNumber": {
            "type": "string",
            "nullable": true
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "TermsOfUseAcceptedOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Status": {
            "$ref": "#/components/schemas/UserStatus"
          },
          "MigratedEmail": {
            "type": "string",
            "nullable": true
          },
          "Email": {
            "type": "string",
            "nullable": true
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "MigratedCandidateId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Uprn": {
            "type": "string",
            "nullable": true
          },
          "AddressLine1": {
            "type": "string",
            "nullable": true
          },
          "AddressLine2": {
            "type": "string",
            "nullable": true
          },
          "Town": {
            "type": "string",
            "nullable": true
          },
          "County": {
            "type": "string",
            "nullable": true
          },
          "Postcode": {
            "type": "string",
            "nullable": true
          },
          "Latitude": {
            "type": "number"
          },
          "Longitude": {
            "type": "number"
          },
          "CandidateId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
