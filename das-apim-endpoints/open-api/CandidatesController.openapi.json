{
  "openapi": "3.1.0",
  "info": {
    "title": "FindAnApprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/Candidates/create-account": {
      "get": {
        "summary": "Get Account Creation Inform",
        "parameters": [
          {
            "name": "candidateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInformQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/Candidates/{govIdentifier}": {
      "put": {
        "summary": "Create or Update Candidate",
        "parameters": [
          {
            "name": "govIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidatesModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandidateResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    },
    "/Candidates/{govIdentifier}/status": {
      "post": {
        "summary": "Update Candidate Status",
        "parameters": [
          {
            "name": "govIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidateStatus"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateCandidateStatusCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CandidatesModel": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          }
        },
        "required": [
          "Email"
        ]
      },
      "CandidateStatus": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/UserStatus"
          }
        },
        "required": [
          "Email",
          "Status"
        ]
      },
      "UserStatus": {
        "type": "string",
        "enum": [
          "Incomplete",
          "Completed",
          "InProgress",
          "Deleted",
          "Dormant"
        ]
      },
      "CandidateResponse": {
        "type": "object",
        "properties": {
          "GovUkIdentifier": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          }
        }
      },
      "UpdateCandidateStatusCommandResponse": {
        "type": "object"
      },
      "GetInformQueryResponse": {
        "type": "object"
      }
    }
  }
}
