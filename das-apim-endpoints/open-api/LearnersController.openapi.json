{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessors API",
    "version": "1.0.0",
    "description": "API for managing and retrieving learner information."
  },
  "paths": {
    "/Learners/": {
      "get": {
        "summary": "Get all learners",
        "operationId": "getAllLearners",
        "parameters": [
          {
            "name": "sinceTime",
            "in": "query",
            "description": "Timestamp to filter learners updated since this time.",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            }
          },
          {
            "name": "batch_number",
            "in": "query",
            "description": "Batch number for paginated results.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "batch_size",
            "in": "query",
            "description": "Size of each batch of learners.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000,
              "example": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learners retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Learner": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "ULN": {
            "type": "string"
          },
          "TrainingCode": {
            "type": "string"
          },
          "TrainingCourseVersion": {
            "type": "string"
          },
          "TrainingCourseVersionConfirmed": {
            "type": "boolean"
          },
          "TrainingCourseOption": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time"
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "StopDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "UKPRN": {
            "type": "integer",
            "format": "int64"
          },
          "LearnRefNumber": {
            "type": "string"
          },
          "PaymentStatus": {
            "type": "integer",
            "format": "int16"
          },
          "EmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerName": {
            "type": "string"
          }
        }
      },
      "GetAllLearnersResponse": {
        "type": "object",
        "properties": {
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Learner"
            }
          },
          "BatchNumber": {
            "type": "integer"
          },
          "BatchSize": {
            "type": "integer"
          },
          "TotalNumberOfBatches": {
            "type": "integer"
          }
        }
      }
    }
  }
}
