{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessors API",
    "version": "1.0.0"
  },
  "paths": {
    "/Learners/": {
      "get": {
        "summary": "Get all learners",
        "operationId": "GetAllLearners",
        "parameters": [
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter learners that have been updated since the given time."
          },
          {
            "name": "batch_number",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The batch number to retrieve."
          },
          {
            "name": "batch_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            },
            "description": "The size of the batch to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "The list of learners.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllLearnersResponse": {
        "type": "object",
        "properties": {
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Learner"
            }
          },
          "BatchNumber": {
            "type": "integer",
            "description": "The number of the retrieved batch."
          },
          "BatchSize": {
            "type": "integer",
            "description": "The size of the retrieved batch."
          },
          "TotalNumberOfBatches": {
            "type": "integer",
            "description": "The total number of batches available."
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "description": "Unique identifier for the apprenticeship."
          },
          "FirstName": {
            "type": "string",
            "description": "The first name of the learner."
          },
          "LastName": {
            "type": "string",
            "description": "The last name of the learner."
          },
          "ULN": {
            "type": "string",
            "description": "Unique learner number."
          },
          "TrainingCode": {
            "type": "string",
            "description": "Code for the training course."
          },
          "TrainingCourseVersion": {
            "type": "string",
            "description": "Version of the training course."
          },
          "TrainingCourseVersionConfirmed": {
            "type": "boolean",
            "description": "Whether the training course version is confirmed."
          },
          "TrainingCourseOption": {
            "type": "string",
            "description": "Options for the training course."
          },
          "StandardUId": {
            "type": "string",
            "description": "Unique identifier for the standard."
          },
          "StartDate": {
            "type": "string",
            "format": "date-time",
            "description": "The start date of the apprenticeship."
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "description": "The end date of the apprenticeship."
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The date the record was created."
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The date the record was last updated."
          },
          "StopDate": {
            "type": "string",
            "format": "date-time",
            "description": "The date the apprenticeship was stopped."
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "description": "The date the apprenticeship was paused."
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "description": "The date the apprenticeship was completed."
          },
          "UKPRN": {
            "type": "integer",
            "description": "The UK provider reference number."
          },
          "LearnRefNumber": {
            "type": "string",
            "description": "The learner's reference number."
          },
          "PaymentStatus": {
            "type": "integer",
            "description": "The payment status of the apprenticeship."
          },
          "EmployerAccountId": {
            "type": "integer",
            "description": "The employer's account ID."
          },
          "EmployerName": {
            "type": "string",
            "description": "The name of the employer."
          }
        }
      }
    }
  }
}
