{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessors API",
    "version": "1.0.0"
  },
  "paths": {
    "/Learners": {
      "get": {
        "summary": "Get all learners",
        "operationId": "getAllLearners",
        "parameters": [
          {
            "name": "sinceTime",
            "in": "query",
            "description": "Optional filter to get learners updated since a specific time",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "batch_number",
            "in": "query",
            "description": "Batch number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "batch_size",
            "in": "query",
            "description": "Number of learners to return per batch",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learners retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllLearnersResponse": {
        "type": "object",
        "properties": {
          "Learners": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Learner"
            }
          },
          "BatchNumber": {
            "type": "integer",
            "description": "The current batch number"
          },
          "BatchSize": {
            "type": "integer",
            "description": "The size of each batch"
          },
          "TotalNumberOfBatches": {
            "type": "integer",
            "description": "The total number of batches"
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "description": "Unique identifier for the apprenticeship"
          },
          "FirstName": {
            "type": "string",
            "description": "First name of the learner"
          },
          "LastName": {
            "type": "string",
            "description": "Last name of the learner"
          },
          "ULN": {
            "type": "string",
            "description": "Unique Learning Number"
          },
          "TrainingCode": {
            "type": "string",
            "description": "Code for the training course"
          },
          "TrainingCourseVersion": {
            "type": "string",
            "description": "Version of the training course"
          },
          "TrainingCourseVersionConfirmed": {
            "type": "boolean",
            "description": "Indicates whether the training course version is confirmed"
          },
          "TrainingCourseOption": {
            "type": "string",
            "description": "Option for the training course"
          },
          "StandardUId": {
            "type": "string",
            "description": "Standard unique identifier"
          },
          "StartDate": {
            "type": "string",
            "format": "date",
            "description": "Start date of the apprenticeship"
          },
          "EndDate": {
            "type": "string",
            "format": "date",
            "description": "End date of the apprenticeship"
          },
          "CreatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the record was created"
          },
          "UpdatedOn": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the record was last updated"
          },
          "StopDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the apprenticeship was stopped"
          },
          "PauseDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the apprenticeship was paused"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date",
            "description": "Date when the apprenticeship was completed"
          },
          "UKPRN": {
            "type": "integer",
            "description": "UK Provider Reference Number"
          },
          "LearnRefNumber": {
            "type": "string",
            "description": "Learner reference number"
          },
          "PaymentStatus": {
            "type": "integer",
            "description": "Payment status of the apprenticeship"
          },
          "EmployerAccountId": {
            "type": "integer",
            "description": "Unique identifier for the employer's account"
          },
          "EmployerName": {
            "type": "string",
            "description": "Name of the employer"
          }
        }
      }
    }
  }
}
