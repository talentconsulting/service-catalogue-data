{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Apprenticeships API",
    "version": "1.0.0",
    "description": "API for handling errors in the Apprenticeships service"
  },
  "paths": {
    "/Error": {
      "get": {
        "operationId": "ErrorController_Error",
        "summary": "Handles errors and unauthorized exceptions",
