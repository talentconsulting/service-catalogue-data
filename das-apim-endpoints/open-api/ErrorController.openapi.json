{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Error API",
    "version": "1.0"
  },
  "paths": {
    "/Error": {
      "get": {
        "tags": [
          "Error"
        ],
        "summary": "Handles errors and determines the response based on the error type.",
        "responses": {
          "401": {
            "description": "Unauthorized error response"
          },
          "500": {
            "description": "Unexpected error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BaseMediatrResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "ErrorMessage": {
            "type": "string",
            "nullable": true
          },
          "ErrorCode": {
            "type": "string",
            "nullable": true
          },
          "Value": {
            "type": "object"
          }
        }
      },
      "Route": {
        "type": "object",
        "properties": {
          "QuestionId": {
            "type": "string",
            "format": "uuid"
          },
          "OptionId": {
            "type": "string",
            "format": "uuid"
          },
          "NextPageOrder": {
            "type": "integer",
            "nullable": true
          },
          "NextSectionOrder": {
            "type": "integer",
            "nullable": true
          },
          "EndForm": {
            "type": "boolean"
          },
          "EndSection": {
            "type": "boolean"
          }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "QuestionId": {
            "type": "string",
            "format": "uuid"
          },
          "QuestionType": {
            "type": "string"
          },
          "Answer": {
            "$ref": "#/components/schemas/Answer"
          }
        }
      },
      "Answer": {
        "type": "object",
        "properties": {
          "TextValue": {
            "type": "string",
            "nullable": true
          },
          "NumberValue": {
            "type": "number",
            "nullable": true
          },
          "DateValue": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "MultipleChoiceValue": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "RadioChoiceValue": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "CreatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "SubmittedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Status": {
            "type": "string",
            "nullable": true
          },
          "Reference": {
            "type": "string"
          },
          "FormVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "UpdatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "string"
          },
          "DecisionReference": {
            "type": "string"
          },
          "TaskCreatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "Line1": {
            "type": "string"
          },
          "Line2": {
            "type": "string",
            "nullable": true
          },
          "Line3": {
            "type": "string",
            "nullable": true
          },
          "TownOrCity": {
            "type": "string"
          },
          "County": {
            "type": "string",
            "nullable": true
          },
          "PostCode": {
            "type": "string"
          },
          "Country": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
