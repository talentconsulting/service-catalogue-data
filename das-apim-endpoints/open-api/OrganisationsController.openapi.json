{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisations API",
    "version": "1.0.0"
  },
  "paths": {
    "/Organisations": {
      "get": {
        "summary": "Retrieve a list of organisations",
        "operationId": "GetOrganisations",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationsQueryResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new organisation",
        "operationId": "PostOrganisation",
        "requestBody": {
          "description": "Details of the organisation to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostOrganisationCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organisation created"
          },
          "400": {
            "description": "Invalid request format"
          }
        }
      }
    },
    "/Organisations/{ukprn}": {
      "get": {
        "summary": "Retrieve organisation details by UKPRN",
        "operationId": "GetOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the organisation"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Organisation not found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update organisation details using a patch document",
        "operationId": "PatchOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the organisation to update"
          },
          {
            "name": "X-RequestingUserId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "User ID of the requesting user"
          },
          {
            "name": "X-RequestingUserName",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Display name of the requesting user"
          }
        ],
        "requestBody": {
          "description": "Patch document",
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Organisation updated successfully"
          }
        }
      }
    },
    "/Organisations/{ukprn}/ukrlp-data": {
      "get": {
        "summary": "Retrieve UKRLP data for an organisation by UKPRN",
        "operationId": "GetUkrlp",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the organisation"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUkrlpQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Data not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationsQueryResult": {
        "type": "object",
        "properties": {
          "Organisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationSummary"
            }
          }
        }
      },
      "OrganisationSummary": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          }
        }
      },
      "GetOrganisationQueryResult": {
        "type": "object",
        "properties": {
          "OrganisationId": {
            "type": "string",
            "format": "uuid"
          },
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "ProviderType": {
            "type": "string"
          },
          "OrganisationTypeId": {
            "type": "integer"
          },
          "OrganisationType": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "ApplicationDeterminedDate": {
            "type": "string",
            "format": "date-time"
          },
          "RemovedReasonId": {
            "type": "integer"
          },
          "RemovedReason": {
            "type": "string"
          },
          "RemovedDate": {
            "type": "string",
            "format": "date-time"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "LastUpdatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "AllowedCourseTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedCourseType"
            }
          }
        }
      },
      "AllowedCourseType": {
        "type": "object",
        "properties": {
          "CourseTypeId": {
            "type": "integer"
          },
          "CourseTypeName": {
            "type": "string"
          }
        }
      },
      "GetUkrlpQueryResult": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          }
        }
      },
      "PostOrganisationCommand": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "ProviderType": {
            "type": "string"
          },
          "OrganisationTypeId": {
            "type": "integer"
          },
          "RequestingUserId": {
            "type": "string"
          },
          "RequestingUserDisplayName": {
            "type": "string"
          },
          "DeliversApprenticeships": {
            "type": "boolean"
          },
          "DeliversApprenticeshipUnits": {
            "type": "boolean"
          }
        }
      },
      "JsonPatchDocument": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "op": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ]
        }
      }
    }
  }
}
