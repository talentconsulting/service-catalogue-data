{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisations API",
    "version": "1.0.0",
    "description": "API for managing organisation data."
  },
  "paths": {
    "/Organisations": {
      "get": {
        "summary": "Retrieve all organisations",
        "operationId": "GetOrganisations",
        "responses": {
          "200": {
            "description": "Successful retrieval of organisations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationsQueryResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new organisation",
        "operationId": "PostOrganisation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostOrganisationCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organisation successfully created"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/Organisations/{ukprn}": {
      "get": {
        "summary": "Retrieve organisation by UKPRN",
        "operationId": "GetOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of organisation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Organisation not found"
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update organisation details",
        "operationId": "PatchOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Organisation successfully updated"
          }
        }
      }
    },
    "/Organisations/{ukprn}/ukrlp-data": {
      "get": {
        "summary": "Retrieve UKRLP data for an organisation",
        "operationId": "GetUkrlp",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of UKRLP data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUkrlpQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "UKRLP data not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationsQueryResult": {
        "type": "object",
        "properties": {
          "Organisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationSummary"
            }
          }
        }
      },
      "OrganisationSummary": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          }
        }
      },
      "GetOrganisationQueryResult": {
        "type": "object",
        "properties": {
          "OrganisationId": {
            "type": "string",
            "format": "uuid"
          },
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "ProviderType": {
            "type": "string"
          },
          "OrganisationTypeId": {
            "type": "integer"
          },
          "OrganisationType": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "ApplicationDeterminedDate": {
            "type": "string",
            "format": "date-time"
          },
          "RemovedReasonId": {
            "type": "integer"
          },
          "RemovedReason": {
            "type": "string"
          },
          "RemovedDate": {
            "type": "string",
            "format": "date-time"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "LastUpdatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "AllowedCourseTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedCourseTypeModel"
            }
          }
        }
      },
      "AllowedCourseTypeModel": {
        "type": "object",
        "properties": {
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "IsRestricted": {
            "type": "boolean"
          },
          "RestrictedCount": {
            "type": "integer"
          },
          "AllowedCount": {
            "type": "integer"
          }
        }
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "GetUkrlpQueryResult": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          }
        }
      },
      "PostOrganisationCommand": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "ProviderType": {
            "type": "string"
          },
          "OrganisationTypeId": {
            "type": "integer"
          },
          "RequestingUserId": {
            "type": "string"
          },
          "RequestingUserDisplayName": {
            "type": "string"
          },
          "DeliversApprenticeships": {
            "type": "boolean"
          },
          "DeliversApprenticeshipUnits": {
            "type": "boolean"
          }
        }
      },
      "JsonPatchDocument": {
        "type": "object",
        "description": "JSON Patch document for update operations",
        "additionalProperties": false
      }
    }
  }
}
