{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisations API",
    "version": "1.0.0"
  },
  "paths": {
    "/organisations": {
      "get": {
        "summary": "Retrieve all organisations",
        "operationId": "GetOrganisations",
        "responses": {
          "200": {
            "description": "A list of organisations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationsQueryResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new organisation",
        "operationId": "PostOrganisation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostOrganisationCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organisation created"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/organisations/{ukprn}": {
      "get": {
        "summary": "Retrieve an organisation by UKPRN",
        "operationId": "GetOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "An organisation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Organisation not found"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update an organisation using JSON Patch",
        "operationId": "PatchOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "X-RequestingUserId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-RequestingUserName",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PatchOrganisationModel"
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Organisation patched successfully"
          }
        }
      }
    },
    "/organisations/{ukprn}/ukrlp-data": {
      "get": {
        "summary": "Retrieve UKRLP data for an organisation",
        "operationId": "GetUkrlp",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "UKRLP data for an organisation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUkrlpQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Data not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationsQueryResult": {
        "type": "object",
        "properties": {
          "organisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationSummary"
            }
          }
        }
      },
      "OrganisationSummary": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          }
        },
        "required": [
          "ukprn",
          "legalName"
        ]
      },
      "GetOrganisationQueryResult": {
        "type": "object",
        "properties": {
          "organisationId": {
            "type": "string",
            "format": "uuid"
          },
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string"
          },
          "companyNumber": {
            "type": "string"
          },
          "charityNumber": {
            "type": "string"
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "organisationType": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "applicationDeterminedDate": {
            "type": "string",
            "format": "date-time"
          },
          "removedReasonId": {
            "type": "integer"
          },
          "removedReason": {
            "type": "string"
          },
          "removedDate": {
            "type": "string",
            "format": "date-time"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "lastUpdatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "allowedCourseTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedCourseType"
            }
          }
        },
        "required": [
          "organisationId",
          "ukprn",
          "legalName",
          "organisationTypeId",
          "organisationType"
        ]
      },
      "GetUkrlpQueryResult": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string"
          },
          "charityNumber": {
            "type": "string"
          },
          "companyNumber": {
            "type": "string"
          }
        }
      },
      "PostOrganisationCommand": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string"
          },
          "companyNumber": {
            "type": "string"
          },
          "charityNumber": {
            "type": "string"
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "requestingUserId": {
            "type": "string"
          },
          "requestingUserDisplayName": {
            "type": "string"
          },
          "deliversApprenticeships": {
            "type": "boolean"
          },
          "deliversApprenticeshipUnits": {
            "type": "boolean"
          }
        },
        "required": [
          "ukprn",
          "legalName",
          "requestingUserId",
          "requestingUserDisplayName"
        ]
      },
      "PatchOrganisationModel": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "removedReasonId": {
            "type": "integer"
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          }
        },
        "required": [
          "status",
          "providerType",
          "organisationTypeId"
        ]
      },
      "AllowedCourseType": {
        "type": "object",
        "properties": {
          "courseTypeId": {
            "type": "integer"
          },
          "courseTypeName": {
            "type": "string"
          }
        },
        "required": [
          "courseTypeId",
          "courseTypeName"
        ]
      },
      "ProviderType": {
        "type": "string",
        "enum": [
          "Main",
          "Employer"
        ]
      },
      "OrganisationStatus": {
        "type": "string",
        "enum": [
          "Removed",
          "Active",
          "ActiveNoStarts",
          "OnBoarding"
        ]
      }
    }
  }
}
