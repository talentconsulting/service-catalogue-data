{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.AdminRoatp API",
    "version": "1.0.0"
  },
  "paths": {
    "/Organisations": {
      "get": {
        "summary": "Get Organisations",
        "operationId": "GetOrganisations",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationsQueryResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Post Organisation",
        "operationId": "PostOrganisation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostOrganisationCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/Organisations/{ukprn}": {
      "get": {
        "summary": "Get Organisation by UKPRN",
        "operationId": "GetOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique provider reference number"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Patch Organisation by UKPRN",
        "operationId": "PatchOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique provider reference number"
          },
          {
            "name": "X-RequestingUserId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the user making the request"
          },
          {
            "name": "X-RequestingUserName",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name of the user making the request"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/Organisations/{ukprn}/ukrlp-data": {
      "get": {
        "summary": "Get UKRLP Data by UKPRN",
        "operationId": "GetUkrlp",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique provider reference number"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUkrlpQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationsQueryResult": {
        "type": "object",
        "properties": {
          "Organisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationSummary"
            }
          }
        }
      },
      "OrganisationSummary": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          }
        }
      },
      "GetOrganisationQueryResult": {
        "type": "object",
        "properties": {
          "OrganisationId": {
            "type": "string",
            "format": "uuid"
          },
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "ProviderType": {
            "type": "string"
          },
          "OrganisationTypeId": {
            "type": "integer"
          },
          "OrganisationType": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "ApplicationDeterminedDate": {
            "type": "string",
            "format": "date-time"
          },
          "RemovedReasonId": {
            "type": "integer"
          },
          "RemovedReason": {
            "type": "string"
          },
          "RemovedDate": {
            "type": "string",
            "format": "date-time"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "LastUpdatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "AllowedCourseTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedCourseType"
            }
          }
        }
      },
      "PostOrganisationCommand": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "ProviderType": {
            "type": "string"
          },
          "OrganisationTypeId": {
            "type": "integer"
          },
          "RequestingUserId": {
            "type": "string"
          },
          "RequestingUserDisplayName": {
            "type": "string"
          },
          "DeliversApprenticeships": {
            "type": "boolean"
          },
          "DeliversApprenticeshipUnits": {
            "type": "boolean"
          }
        }
      },
      "GetUkrlpQueryResult": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "CharityNumber": {
            "type": "string"
          },
          "CompanyNumber": {
            "type": "string"
          }
        }
      },
      "JsonPatchDocument": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonPatchOperation"
            }
          }
        }
      },
      "JsonPatchOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "AllowedCourseType": {
        "type": "object",
        "properties": {
          "CourseTypeId": {
            "type": "integer"
          },
          "CourseTypeName": {
            "type": "string"
          }
        }
      },
      "OrganisationStatus": {
        "type": "string",
        "enum": [
          "Removed",
          "Active",
          "ActiveNoStarts",
          "OnBoarding"
        ]
      }
    }
  }
}
