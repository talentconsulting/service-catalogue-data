{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisations API",
    "version": "1.0.0"
  },
  "paths": {
    "/Organisations": {
      "get": {
        "summary": "Get all organisations",
        "operationId": "GetOrganisations",
        "responses": {
          "200": {
            "description": "A list of organisations.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationsQueryResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new organisation",
        "operationId": "PostOrganisation",
        "requestBody": {
          "description": "Organisation details.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostOrganisationCommand"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organisation created successfully."
          },
          "400": {
            "description": "Invalid request."
          }
        }
      }
    },
    "/Organisations/{ukprn}": {
      "get": {
        "summary": "Get details of a specific organisation",
        "operationId": "GetOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the organisation."
          }
        ],
        "responses": {
          "200": {
            "description": "Organisation details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Organisation not found."
          },
          "400": {
            "description": "Bad request.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Patch an organisation",
        "operationId": "PatchOrganisation",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the organisation."
          },
          {
            "name": "X-RequestingUserId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-RequestingUserName",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Patch document describing changes to make.",
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Patch operation successful."
          }
        }
      }
    },
    "/Organisations/{ukprn}/ukrlp-data": {
      "get": {
        "summary": "Get UKRLP data for an organisation",
        "operationId": "GetUkrlp",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UKPRN of the organisation."
          }
        ],
        "responses": {
          "200": {
            "description": "UKRLP data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUkrlpQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "UKRLP data not found for the given UKPRN."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationsQueryResult": {
        "type": "object",
        "properties": {
          "organisations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationSummary"
            }
          }
        }
      },
      "OrganisationSummary": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "description": "UK Provider Reference Number."
          },
          "legalName": {
            "type": "string",
            "description": "Organisation's legal name."
          }
        },
        "required": [
          "ukprn",
          "legalName"
        ]
      },
      "PostOrganisationCommand": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string",
            "nullable": true
          },
          "companyNumber": {
            "type": "string",
            "nullable": true
          },
          "charityNumber": {
            "type": "string",
            "nullable": true
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "requestingUserId": {
            "type": "string"
          },
          "requestingUserDisplayName": {
            "type": "string"
          },
          "deliversApprenticeships": {
            "type": "boolean"
          },
          "deliversApprenticeshipUnits": {
            "type": "boolean"
          }
        },
        "required": [
          "ukprn",
          "legalName",
          "providerType",
          "organisationTypeId",
          "requestingUserId",
          "requestingUserDisplayName",
          "deliversApprenticeships",
          "deliversApprenticeshipUnits"
        ]
      },
      "ProviderType": {
        "type": "string",
        "enum": [
          "Main",
          "Supporting",
          "Employer"
        ]
      },
      "GetOrganisationQueryResult": {
        "type": "object",
        "properties": {
          "organisationId": {
            "type": "string",
            "format": "uuid"
          },
          "ukprn": {
            "type": "integer"
          },
          "legalName": {
            "type": "string"
          },
          "tradingName": {
            "type": "string",
            "nullable": true
          },
          "companyNumber": {
            "type": "string",
            "nullable": true
          },
          "charityNumber": {
            "type": "string",
            "nullable": true
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          },
          "organisationType": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "applicationDeterminedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "removedReasonId": {
            "type": "integer",
            "nullable": true
          },
          "removedReason": {
            "type": "string",
            "nullable": true
          },
          "removedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lastUpdatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "allowedCourseTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedCourseType"
            }
          }
        }
      },
      "OrganisationStatus": {
        "type": "string",
        "enum": [
          "Removed",
          "Active",
          "ActiveNoStarts",
          "OnBoarding"
        ]
      },
      "AllowedCourseType": {
        "type": "object",
        "properties": {
          "courseTypeId": {
            "type": "integer"
          },
          "courseTypeName": {
            "$ref": "#/components/schemas/CourseType"
          }
        }
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "HigherLevel",
          "Apprenticeship",
          "Traineeship"
        ]
      },
      "GetUkrlpQueryResult": {
        "type": "object",
        "properties": {
          "legalName": {
            "type": "string",
            "nullable": true
          },
          "tradingName": {
            "type": "string",
            "nullable": true
          },
          "charityNumber": {
            "type": "string",
            "nullable": true
          },
          "companyNumber": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PatchOrganisationModel": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "removedReasonId": {
            "type": "integer",
            "nullable": true
          },
          "providerType": {
            "$ref": "#/components/schemas/ProviderType"
          },
          "organisationTypeId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
