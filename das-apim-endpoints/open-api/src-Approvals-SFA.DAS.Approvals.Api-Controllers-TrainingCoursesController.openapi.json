{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/standards": {
      "get": {
        "summary": "Get list of standards",
        "operationId": "GetStandards",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/TrainingCourses/frameworks": {
      "get": {
        "summary": "Get list of frameworks",
        "operationId": "GetFrameworks",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworksListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/TrainingCourses/standards/{courseCode}": {
      "get": {
        "summary": "Get a specific standard by course code",
        "operationId": "GetStandard",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/TrainingCourses/{courseCode}/funding-band": {
      "get": {
        "summary": "Get funding band for a specific course",
        "operationId": "GetFundingBand",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Funding band not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/TrainingCourses/courses": {
      "get": {
        "summary": "Get list of courses",
        "operationId": "GetCourses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsListResponse": {
        "type": "object",
        "properties": {
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardResponse"
            }
          }
        }
      },
      "GetFrameworksListResponse": {
        "type": "object",
        "properties": {
          "Frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetFrameworkResponse"
            }
          }
        }
      },
      "GetCoursesListResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseResponse"
            }
          }
        }
      },
      "GetStandardResponse": {
        "type": "object",
        "properties": {}
      },
      "GetFrameworkResponse": {
        "type": "object",
        "properties": {}
      },
      "GetCourseResponse": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
