{
  "openapi": "3.1.0",
  "info": {
    "title": "TrainingCourses API",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/standards": {
      "get": {
        "summary": "Get list of standards",
        "operationId": "getStandards",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/TrainingCourses/frameworks": {
      "get": {
        "summary": "Get list of frameworks",
        "operationId": "getFrameworks",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworksListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/TrainingCourses/standards/{courseCode}": {
      "get": {
        "summary": "Get details of a specific standard",
        "operationId": "getStandard",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/TrainingCourses/{courseCode}/funding-band": {
      "get": {
        "summary": "Get funding band details for a course",
        "operationId": "getFundingBand",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFundingBandResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/TrainingCourses/courses": {
      "get": {
        "summary": "Get list of courses",
        "operationId": "getCourses",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsListResponse": {
        "type": "object",
        "properties": {
          "standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardResponse"
            }
          }
        }
      },
      "GetFrameworksListResponse": {
        "type": "object",
        "properties": {
          "frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetFrameworkResponse"
            }
          }
        }
      },
      "GetCoursesListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseResponse"
            }
          }
        }
      },
      "GetStandardResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetFrameworkResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetFundingBandResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetCourseResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
