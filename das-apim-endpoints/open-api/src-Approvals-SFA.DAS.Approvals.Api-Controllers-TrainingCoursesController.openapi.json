{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0",
    "description": "API for managing training courses, standards, frameworks, and funding bands."
  },
  "paths": {
    "/trainingCourses/standards": {
      "get": {
        "summary": "Retrieve a list of training standards",
        "tags": [
          "TrainingCourses"
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of standards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/trainingCourses/frameworks": {
      "get": {
        "summary": "Retrieve a list of training frameworks",
        "tags": [
          "TrainingCourses"
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of frameworks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworksListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/trainingCourses/standards/{courseCode}": {
      "get": {
        "summary": "Retrieve details of a specific standard by course code",
        "tags": [
          "TrainingCourses"
        ],
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "description": "The course code of the standard",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with standard details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/trainingCourses/{courseCode}/funding-band": {
      "get": {
        "summary": "Retrieve funding band details for a specific course",
        "tags": [
          "TrainingCourses"
        ],
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "description": "The course code of the training course",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "description": "Start date for the funding band details",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with funding band details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFundingBandResponse"
                }
              }
            }
          },
          "404": {
            "description": "Funding band not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trainingCourses/courses": {
      "get": {
        "summary": "Retrieve a list of available courses",
        "tags": [
          "TrainingCourses"
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsListResponse": {
        "type": "object",
        "properties": {
          "standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardResponse"
            }
          }
        }
      },
      "GetStandardResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "fundingBand": {
            "$ref": "#/components/schemas/GetFundingBandResponse"
          }
        }
      },
      "GetFrameworksListResponse": {
        "type": "object",
        "properties": {
          "frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetFrameworkResponse"
            }
          }
        }
      },
      "GetFrameworkResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "fundingBand": {
            "$ref": "#/components/schemas/GetFundingBandResponse"
          }
        }
      },
      "GetFundingBandResponse": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "fundingAmount": {
            "type": "integer"
          }
        }
      },
      "GetCoursesListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseResponse"
            }
          }
        }
      },
      "GetCourseResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "fundingBand": {
            "$ref": "#/components/schemas/GetFundingBandResponse"
          }
        }
      }
    }
  }
}
