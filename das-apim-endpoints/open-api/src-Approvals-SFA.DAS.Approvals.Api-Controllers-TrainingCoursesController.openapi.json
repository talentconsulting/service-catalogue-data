{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/standards": {
      "get": {
        "operationId": "GetStandards",
        "summary": "Retrieve a list of standards",
        "responses": {
          "200": {
            "description": "Successful retrieval of standards list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/TrainingCourses/frameworks": {
      "get": {
        "operationId": "GetFrameworks",
        "summary": "Retrieve a list of frameworks",
        "responses": {
          "200": {
            "description": "Successful retrieval of frameworks list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworksListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/TrainingCourses/standards/{courseCode}": {
      "get": {
        "operationId": "GetStandard",
        "summary": "Retrieve details for a specific standard",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "description": "Code for a specific standard",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of standard details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/TrainingCourses/{courseCode}/funding-band": {
      "get": {
        "operationId": "GetFundingBand",
        "summary": "Retrieve funding band information for a course",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "description": "Code for a specific course",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "description": "Optional start date for the funding band",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of funding band",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFundingBandResponse"
                }
              }
            }
          },
          "404": {
            "description": "Funding band not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/TrainingCourses/courses": {
      "get": {
        "operationId": "GetCourses",
        "summary": "Retrieve a list of courses",
        "responses": {
          "200": {
            "description": "Successful retrieval of courses list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCoursesListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsListResponse": {
        "type": "object",
        "properties": {
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardResponse"
            }
          }
        }
      },
      "GetFrameworksListResponse": {
        "type": "object",
        "properties": {
          "Frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetFrameworkResponse"
            }
          }
        }
      },
      "GetCoursesListResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseResponse"
            }
          }
        }
      },
      "GetStandardResponse": {
        "type": "object",
        "properties": {}
      },
      "GetFrameworkResponse": {
        "type": "object",
        "properties": {}
      },
      "GetCourseResponse": {
        "type": "object",
        "properties": {}
      },
      "GetFundingBandResponse": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
