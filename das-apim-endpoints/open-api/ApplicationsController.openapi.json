{
  "openapi": "3.1.0",
  "info": {
    "title": "Levy Transfer Matching API",
    "version": "1.0.0",
    "description": "API for managing levy transfer matching applications."
  },
  "paths": {
    "/accounts/{accountId}/applications": {
      "get": {
        "summary": "Get applications for an account",
        "operationId": "GetApplications",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of applications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}": {
      "get": {
        "summary": "Get application by ID",
        "operationId": "GetApplicationById",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Set application acceptance",
        "operationId": "SetApplicationAcceptance",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetApplicationAcceptanceRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content - application acceptance set successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}/accepted": {
      "get": {
        "summary": "Get accepted application details",
        "operationId": "GetAcceptedApplication",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted application details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAcceptedResponse"
                }
              }
            }
          },
          "404": {
            "description": "Accepted application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}/declined": {
      "get": {
        "summary": "Get declined application details",
        "operationId": "GetDeclinedApplication",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Declined application details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDeclinedResponse"
                }
              }
            }
          },
          "404": {
            "description": "Declined application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}/withdrawn": {
      "get": {
        "summary": "Get withdrawn application details",
        "operationId": "GetWithdrawnApplication",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Withdrawn application details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetWithdrawnResponse"
                }
              }
            }
          },
          "404": {
            "description": "Withdrawn application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}/withdrawal-confirmation": {
      "get": {
        "summary": "Get withdrawal confirmation for an application",
        "operationId": "GetWithdrawalConfirmation",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Withdrawal confirmation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetWithdrawalConfirmationResponse"
                }
              }
            }
          },
          "404": {
            "description": "Withdrawal confirmation not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Withdraw application after acceptance",
        "operationId": "WithdrawApplicationAfterAcceptance",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WithdrawApplicationAfterAcceptanceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application withdrawn successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "dasAccountName": {
                  "type": "string"
                },
                "pledgeId": {
                  "type": "integer"
                },
                "details": {
                  "type": "string"
                },
                "numberOfApprentices": {
                  "type": "integer"
                },
                "amount": {
                  "type": "integer"
                },
                "totalAmount": {
                  "type": "integer"
                },
                "createdOn": {
                  "type": "string",
                  "format": "date-time"
                },
                "isNamePublic": {
                  "type": "boolean"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "totalItems": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          }
        }
      },
      "GetApplicationResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "dasAccountName": {
            "type": "string"
          },
          "pledgeId": {
            "type": "integer"
          },
          "details": {
            "type": "string"
          },
          "numberOfApprentices": {
            "type": "integer"
          },
          "amount": {
            "type": "integer"
          },
          "totalAmount": {
            "type": "integer"
          },
          "createdOn": {
            "type": "string",
            "format": "date-time"
          },
          "isNamePublic": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "SetApplicationAcceptanceRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "acceptance": {
            "$ref": "#/components/schemas/ApplicationAcceptance"
          }
        }
      },
      "ApplicationAcceptance": {
        "type": "string",
        "enum": [
          "Accept",
          "Decline",
          "Withdraw"
        ]
      },
      "GetAcceptedResponse": {
        "type": "object",
        "properties": {}
      },
      "GetDeclinedResponse": {
        "type": "object",
        "properties": {}
      },
      "GetWithdrawnResponse": {
        "type": "object",
        "properties": {}
      },
      "GetWithdrawalConfirmationResponse": {
        "type": "object",
        "properties": {}
      },
      "WithdrawApplicationAfterAcceptanceRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          }
        }
      }
    }
  }
}
