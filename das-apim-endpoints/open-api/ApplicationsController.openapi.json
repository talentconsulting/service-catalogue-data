{
  "openapi": "3.1.0",
  "info": {
    "title": "Find An Apprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/applications": {
      "get": {
        "operationId": "GetApplications",
        "summary": "Retrieve applications for a given candidate",
        "parameters": [
          {
            "name": "candidateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ApplicationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of applications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsApiResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/count": {
      "get": {
        "operationId": "GetApplicationsCount",
        "summary": "Retrieve the count of applications for a given candidate",
        "parameters": [
          {
            "name": "candidateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ApplicationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of application count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsCountQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "Draft",
          "Submitted",
          "Withdrawn",
          "Successful",
          "UnSuccessful",
          "Expired"
        ]
      },
      "GetApplicationsApiResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "vacancyReference": {
            "type": "string"
          },
          "employerName": {
            "type": "string"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "submittedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "closingDate": {
            "type": "string",
            "format": "date-time"
          },
          "closedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "responseDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "responseNotes": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "withdrawnDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "address": {
            "$ref": "#/components/schemas/Address"
          },
          "otherAddresses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Address"
            },
            "nullable": true
          },
          "employmentLocationInformation": {
            "type": "string",
            "nullable": true
          },
          "employerLocationOption": {
            "$ref": "#/components/schemas/AvailableWhere",
            "nullable": true
          },
          "apprenticeshipType": {
            "$ref": "#/components/schemas/ApprenticeshipTypes"
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "addressLine1": {
            "type": "string"
          },
          "addressLine2": {
            "type": "string",
            "nullable": true
          },
          "addressLine3": {
            "type": "string",
            "nullable": true
          },
          "addressLine4": {
            "type": "string",
            "nullable": true
          },
          "postcode": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "longitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "country": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "AvailableWhere": {
        "type": "string",
        "enum": [
          "OneLocation",
          "MultipleLocations",
          "AcrossEngland"
        ]
      },
      "ApprenticeshipTypes": {
        "type": "string",
        "enum": [
          "Standard",
          "Foundation"
        ]
      },
      "GetApplicationsCountQueryResult": {
        "type": "object",
        "properties": {
          "applicationIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "status": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    }
  }
}
