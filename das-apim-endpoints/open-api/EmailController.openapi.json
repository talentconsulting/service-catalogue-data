{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/email/bank-details-required": {
      "post": {
        "operationId": "SendBankDetailsRequiredEmail",
        "summary": "Send bank details required email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendBankDetailsEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent successfully"
          }
        }
      }
    },
    "/email/bank-details-reminder": {
      "post": {
        "operationId": "SendBankDetailsReminderEmail",
        "summary": "Send bank details reminder email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendBankDetailsEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reminder email sent successfully"
          }
        }
      }
    },
    "/email/bank-details-repeat-reminders": {
      "post": {
        "operationId": "SendBankDetailsRepeatReminderEmails",
        "summary": "Send bank details repeat reminder emails",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankDetailsRepeatReminderEmailsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repeat reminder emails sent successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SendBankDetailsEmailRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "EmailAddress": {
            "type": "string",
            "format": "email"
          },
          "AddBankDetailsUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "AccountId",
          "AccountLegalEntityId",
          "EmailAddress",
          "AddBankDetailsUrl"
        ]
      },
      "BankDetailsRepeatReminderEmailsRequest": {
        "type": "object",
        "properties": {
          "ApplicationCutOffDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "ApplicationCutOffDate"
        ]
      }
    }
  }
}
