{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives Email API",
    "version": "1.0.0",
    "description": "API for managing email notifications for employer incentives."
  },
  "paths": {
    "/email/bank-details-required": {
      "post": {
        "operationId": "SendBankDetailsRequiredEmail",
        "summary": "Send bank details required email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendBankDetailsEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent successfully"
          }
        }
      }
    },
    "/email/bank-details-reminder": {
      "post": {
        "operationId": "SendBankDetailsReminderEmail",
        "summary": "Send bank details reminder email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendBankDetailsEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reminder email sent successfully"
          }
        }
      }
    },
    "/email/bank-details-repeat-reminders": {
      "post": {
        "operationId": "SendBankDetailsRepeatReminderEmails",
        "summary": "Send repeat reminders for bank details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BankDetailsRepeatReminderEmailsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Repeat reminders sent successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SendBankDetailsEmailRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64",
            "description": "The account ID associated with the request."
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "description": "The legal entity ID associated with the account."
          },
          "EmailAddress": {
            "type": "string",
            "format": "email",
            "description": "The email address to send the notification to."
          },
          "AddBankDetailsUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for adding bank details."
          }
        },
        "required": [
          "AccountId",
          "AccountLegalEntityId",
          "EmailAddress",
          "AddBankDetailsUrl"
        ]
      },
      "BankDetailsRepeatReminderEmailsRequest": {
        "type": "object",
        "properties": {
          "ApplicationCutOffDate": {
            "type": "string",
            "format": "date-time",
            "description": "The cutoff date for the application."
          }
        },
        "required": [
          "ApplicationCutOffDate"
        ]
      }
    }
  }
}
