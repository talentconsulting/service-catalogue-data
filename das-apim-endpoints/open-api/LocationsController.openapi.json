{
  "openapi": "3.1.0",
  "info": {
    "title": "Locations API",
    "version": "1.0.0",
    "description": "API for retrieving locations and addresses."
  },
  "paths": {
    "/Locations": {
      "get": {
        "summary": "Retrieve addresses by query",
        "operationId": "GetAddresses",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAddressesQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Locations/search": {
      "get": {
        "summary": "Retrieve locations by search query",
        "operationId": "GetLocationsBySearch",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLocationsBySearchQueryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAddressesQueryResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetLocationsBySearchQueryResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
