{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessors API",
    "version": "1.0.0",
    "description": "API for managing locations and address queries."
  },
  "paths": {
    "/locations": {
      "get": {
        "summary": "Retrieve list of addresses for a query",
        "operationId": "GetLocations",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Search query for addresses",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of addresses matching the query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddressesResponse"
                }
              }
            }
          },
          "404": {
            "description": "No addresses found matching the query"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressesResponse": {
        "type": "object",
        "properties": {
          "addresses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "addressLine1": {
                  "type": "string"
                },
                "addressLine2": {
                  "type": "string"
                },
                "addressLine3": {
                  "type": "string"
                },
                "addressLine4": {
                  "type": "string"
                },
                "postcode": {
                  "type": "string"
                },
                "latitude": {
                  "type": "number",
                  "format": "double"
                },
                "longitude": {
                  "type": "number",
                  "format": "double"
                },
                "country": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "addresses"
        ]
      }
    }
  }
}
