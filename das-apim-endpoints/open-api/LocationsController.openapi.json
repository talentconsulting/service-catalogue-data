{
  "openapi": "3.1.0",
  "info": {
    "title": "Locations API",
    "version": "1.0.0"
  },
  "paths": {
    "/Locations": {
      "get": {
        "operationId": "GetAddresses",
        "summary": "Get a list of addresses based on a search query.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of addresses matching the query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAddressesQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Locations/{postcode}": {
      "get": {
        "operationId": "GetCoordinates",
        "summary": "Get coordinates for a given postcode.",
        "parameters": [
          {
            "name": "postcode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Coordinates for the given postcode.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPostcodeQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "No data found for the given postcode."
          }
        }
      }
    },
    "/Locations/search": {
      "get": {
        "operationId": "GetLocationsBySearch",
        "summary": "Get locations that match a search query.",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Matching locations for the search query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLocationsBySearchQueryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAddressesQueryResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "addressLine1": {
              "type": "string"
            },
            "addressLine2": {
              "type": "string"
            },
            "addressLine3": {
              "type": "string"
            },
            "addressLine4": {
              "type": "string"
            },
            "postcode": {
              "type": "string"
            },
            "latitude": {
              "type": "number",
              "format": "double"
            },
            "longitude": {
              "type": "number",
              "format": "double"
            }
          }
        }
      },
      "GetPostcodeQueryResponse": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "GetLocationsBySearchQueryResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "address": {
              "$ref": "#/components/schemas/Address"
            }
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "addressLine1": {
            "type": "string"
          },
          "addressLine2": {
            "type": "string"
          },
          "addressLine3": {
            "type": "string"
          },
          "addressLine4": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      }
    }
  }
}
