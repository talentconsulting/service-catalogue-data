{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Aan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Locations": {
      "get": {
        "summary": "Get addresses based on query",
        "operationId": "GetAddresses",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/Locations/search": {
      "get": {
        "summary": "Search locations based on query",
        "operationId": "GetLocationsBySearch",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "addressLine1": {
            "type": "string"
          },
          "addressLine2": {
            "type": "string"
          },
          "addressLine3": {
            "type": "string"
          },
          "addressLine4": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "ApplicationStatus": {
        "type": "string",
        "enum": [
          "Draft",
          "Submitted",
          "Withdrawn",
          "Successful",
          "UnSuccessful",
          "Expired"
        ]
      },
      "ApprenticeshipTypes": {
        "type": "string",
        "enum": [
          "Standard",
          "Foundation"
        ]
      },
      "AvailableWhere": {
        "type": "string",
        "enum": [
          "OneLocation",
          "MultipleLocations",
          "AcrossEngland"
        ]
      }
    }
  }
}
