{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan Locations API",
    "version": "1.0.0"
  },
  "paths": {
    "/Locations": {
      "get": {
        "summary": "Get a list of addresses",
        "operationId": "GetAddresses",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Addresses retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAddressesQueryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Locations/search": {
      "get": {
        "summary": "Search for locations based on a query",
        "operationId": "GetLocationsBySearch",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Locations retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLocationsBySearchQueryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAddressesQueryResponse": {
        "type": "object",
        "description": "Response model for GetAddresses",
        "properties": {}
      },
      "GetLocationsBySearchQueryResponse": {
        "type": "object",
        "description": "Response model for GetLocationsBySearch",
        "properties": {}
      }
    }
  }
}
