{
  "openapi": "3.1.0",
  "info": {
    "title": "Pause Payments API",
    "version": "1.0.0",
    "description": "API for pausing or resuming incentive payments."
  },
  "paths": {
    "/pause-payments": {
      "post": {
        "summary": "Pause or resume payments",
        "operationId": "pausePayments",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PausePaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation successful"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleMessageResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SingleMessageResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PausePaymentsRequest": {
        "type": "object",
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PausePaymentsAction"
          },
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          },
          "serviceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          }
        },
        "required": [
          "action",
          "applications"
        ]
      },
      "PausePaymentsAction": {
        "type": "string",
        "enum": [
          "Pause",
          "Resume"
        ]
      },
      "Application": {
        "type": "object",
        "properties": {
          "accountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "serviceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          }
        },
        "required": [
          "accountLegalEntityId",
          "uln"
        ]
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "decisionReference": {
            "type": "string"
          },
          "taskCreatedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SingleMessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
