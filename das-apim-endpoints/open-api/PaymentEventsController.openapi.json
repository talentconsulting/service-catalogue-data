{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/PaymentEvents/submissionEvents": {
      "get": {
        "summary": "Retrieve submission events",
        "operationId": "GetSubmissionEvents",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "The event ID to retrieve events since this ID."
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "nullable": true
            },
            "description": "The time to retrieve events since this timestamp."
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "UK Provider Reference Number."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            },
            "description": "Page number for paginated results."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with payment submission events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPaymentSubmissionEventsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPaymentSubmissionEventsQueryResult": {
        "type": "object",
        "description": "Represents the result of a payment submission events query.",
        "properties": {},
        "additionalProperties": true
      }
    }
  }
}
