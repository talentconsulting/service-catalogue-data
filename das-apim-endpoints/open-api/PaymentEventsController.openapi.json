{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API - Payment Events",
    "version": "1.0.0"
  },
  "paths": {
    "/PaymentEvents/submissionEvents": {
      "get": {
        "operationId": "GetSubmissionEvents",
        "summary": "Retrieve payment submission events",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "The ID of the event since which to return submission events."
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "The timestamp since which to return submission events."
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "UKPRN (UK Provider Reference Number) to filter the submission events."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number to retrieve results from."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPaymentSubmissionEventsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPaymentSubmissionEventsQueryResult": {
        "type": "object",
        "description": "The result of the GetPaymentSubmissionEventsQuery operation. The fields are not specified in the source."
      }
    }
  }
}
