{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/PaymentEvents/submissionEvents": {
      "get": {
        "operationId": "GetSubmissionEvents",
        "summary": "Retrieve payment submission events",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "The ID of the event to start retrieval from."
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "The timestamp to start retrieval from."
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "The UKPRN of the provider whose events are being retrieved."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number for paginated results."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with payment submission events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPaymentSubmissionEventsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPaymentSubmissionEventsResponse": {
        "type": "object",
        "description": "The response containing payment submission events.",
        "properties": {
          "events": {
            "type": "array",
            "description": "The list of payment submission events.",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
