{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/PaymentEvents/submissionEvents": {
      "get": {
        "summary": "Retrieve payment submission events",
        "operationId": "getSubmissionEvents",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "The event ID to retrieve submissions from (inclusive)."
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "The time to retrieve submissions from (inclusive)."
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            },
            "description": "UK Provider Reference Number."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number for paginated results."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with payment events data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPaymentSubmissionEventsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPaymentSubmissionEventsResponse": {
        "type": "object",
        "description": "Response schema for payment submission events.",
        "additionalProperties": true
      }
    }
  }
}
