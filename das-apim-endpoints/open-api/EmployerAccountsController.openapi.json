{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing employer accounts and their legal entities."
  },
  "paths": {
    "/EmployerAccounts/{accountId}/LegalEntities": {
      "get": {
        "tags": [
          "Employer Accounts"
        ],
        "summary": "Retrieve legal entities associated with an employer account",
        "operationId": "GetAccountLegalEntities",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "Employer account ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with legal entities for the specified account ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAccountLegalEntitiesQueryResult"
                }
              }
            }
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "GetAccountLegalEntitiesQueryResult": {
        "type": "object",
        "properties": {
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "AccountLegalEntityName": {
            "type": "string",
            "nullable": true
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string",
            "nullable": true
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      }
    }
  }
}
