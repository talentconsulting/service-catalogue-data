{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/EmployerAccounts/{accountId}/LegalEntities": {
      "get": {
        "operationId": "GetAccountLegalEntities",
        "summary": "Fetch legal entities for a specific employer account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Identifier for the employer account"
          }
        ],
        "responses": {
          "200": {
            "description": "Legal entities successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAccountLegalEntitiesQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAccountLegalEntitiesQueryResult": {
        "type": "object",
        "properties": {
          "LegalEntities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegalEntity"
            }
          }
        }
      },
      "LegalEntity": {
        "type": "object",
        "properties": {
          "AccountLegalEntityName": {
            "type": "string",
            "nullable": true
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string",
            "nullable": true
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      }
    }
  }
}
