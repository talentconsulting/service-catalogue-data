{
  "openapi": "3.1.0",
  "info": {
    "title": "Das Apim Endpoints",
    "version": "1.0.0"
  },
  "paths": {
    "/menu": {
      "get": {
        "tags": [
          "Menu"
        ],
        "summary": "Get menu data",
        "operationId": "getMenu",
        "responses": {
          "200": {
            "description": "Menu data retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMenuResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select": {
      "post": {
        "tags": [
          "SelectLearners"
        ],
        "summary": "Get unapproved learners for a provider",
        "operationId": "getUnapprovedLearners",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "Search criteria for learners",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learners retrieved successfully",
            "content": {
              "application/json": {}
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select/{learnerId}": {
      "get": {
        "tags": [
          "SelectLearners"
        ],
        "summary": "Get details of a specific learner",
        "operationId": "getLearnerDetails",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "learnerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner details retrieved successfully",
            "content": {
              "application/json": {}
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/ai/vacancies/{vacancyId}/review/{vacancyReviewId}": {
      "post": {
        "tags": [
          "Ai"
        ],
        "summary": "Create an AI vacancy review",
        "operationId": "createAiVacancyReview",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "vacancyReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Details for creating a vacancy review",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVacancyReviewData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vacancy review created successfully"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/ai/vacancies/{vacancyId}/approve": {
      "post": {
        "tags": [
          "Ai"
        ],
        "summary": "Auto-approve a vacancy",
        "operationId": "autoApproveVacancy",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Review ID for approval",
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Vacancy auto-approved successfully"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMenuResponse": {
        "type": "object",
        "properties": {
          "Menu": {
            "$ref": "#/components/schemas/MenuPageModel"
          }
        }
      },
      "MenuPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "$ref": "#/components/schemas/MenuPageContent"
          }
        }
      },
      "MenuPageContent": {
        "type": "object",
        "properties": {
          "TopLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Hub": {
            "type": "string"
          },
          "PageType": {
            "type": "string"
          },
          "ParentSlug": {
            "type": "string"
          }
        }
      },
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "CohortId": {
            "type": "integer"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortColumn": {
            "type": "string"
          },
          "SortDescending": {
            "type": "boolean"
          },
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "StartMonth": {
            "type": "integer"
          },
          "StartYear": {
            "type": "integer"
          },
          "CourseCode": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ]
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "CreateVacancyReviewData": {
        "type": "object",
        "properties": {
          "ReviewStatus": {
            "type": "string",
            "enum": [
              "Skipped",
              "Failed",
              "Passed"
            ]
          }
        }
      }
    }
  }
}
