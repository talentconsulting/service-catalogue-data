{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Campaign API",
    "version": "1.0.0",
    "description": "API for handling menu operations in the DAS Campaign system."
  },
  "paths": {
    "/menu": {
      "get": {
        "summary": "Retrieve the menu data",
        "operationId": "GetMenu",
        "parameters": [
          {
            "name": "cancellationToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Optional token to cancel the operation."
          }
        ],
        "responses": {
          "200": {
            "description": "Menu retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMenuResponse"
                }
              }
            }
          },
          "default": {
            "description": "Unexpected error occurred."
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select": {
      "post": {
        "summary": "Retrieve ILR records for a provider",
        "operationId": "GetLearnersForProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Records retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLearnersForProviderQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select/{learnerId}": {
      "get": {
        "summary": "Get ILR record for a specific learner",
        "operationId": "GetLearnerForProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider ID."
          },
          {
            "name": "learnerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Learner ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Record retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLearnerForProviderQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/menu/{vacancyId:guid}/review/{vacancyReviewId:guid}": {
      "post": {
        "summary": "Create AiVacancyReview record",
        "operationId": "CreateVacancyReview",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the vacancy."
          },
          {
            "name": "vacancyReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the vacancy review."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVacancyReviewData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vacancy review created successfully."
          },
          "default": {
            "description": "Unexpected error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMenuResponse": {
        "type": "object",
        "properties": {
          "Menu": {
            "$ref": "#/components/schemas/MenuPageModel"
          }
        }
      },
      "MenuPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "$ref": "#/components/schemas/MenuPageContent"
          }
        }
      },
      "MenuPageContent": {
        "type": "object",
        "properties": {
          "TopLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Hub": {
            "type": "string"
          },
          "PageType": {
            "type": "string"
          },
          "ParentSlug": {
            "type": "string"
          }
        }
      },
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "CohortId": {
            "type": "integer"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortColumn": {
            "type": "string"
          },
          "SortDescending": {
            "type": "boolean"
          },
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "StartMonth": {
            "type": "integer"
          },
          "StartYear": {
            "type": "integer"
          },
          "CourseCode": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "GetLearnersForProviderQueryResult": {
        "type": "object",
        "properties": {
          "Learners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "LearnerId": {
                  "type": "integer"
                },
                "Name": {
                  "type": "string"
                },
                "CourseName": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "GetLearnerForProviderQueryResult": {
        "type": "object",
        "properties": {
          "LearnerId": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          }
        }
      },
      "CreateVacancyReviewData": {
        "type": "object",
        "properties": {
          "ReviewStatus": {
            "$ref": "#/components/schemas/AiReviewStatus"
          }
        }
      },
      "AiReviewStatus": {
        "type": "string",
        "enum": [
          "Skipped",
          "Failed",
          "Succeeded"
        ]
      }
    }
  }
}
