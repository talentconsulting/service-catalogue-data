{
  "openapi": "3.1.0",
  "info": {
    "title": "Skills Funding Agency API",
    "version": "1.0.0"
  },
  "paths": {
    "/Menu": {
      "get": {
        "summary": "Retrieve menu information",
        "operationId": "getMenuAsync",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMenuResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select": {
      "post": {
        "summary": "Get ILR records for a provider",
        "operationId": "getLearnersForProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLearnersForProviderQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select/{learnerId}": {
      "get": {
        "summary": "Retrieve ILR record for a specific learner",
        "operationId": "getLearnerForProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLearnerForProviderQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/Ai/vacancies/{vacancyId}/review/{vacancyReviewId}": {
      "post": {
        "summary": "Create AI review for a vacancy",
        "operationId": "createVacancyReview",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "vacancyReviewId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateVacancyReviewData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review successfully created"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/Ai/vacancies/{vacancyId}/review": {
      "post": {
        "summary": "Perform AI review for a vacancy",
        "operationId": "performVacancyReview",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review successfully performed"
          },
          "404": {
            "description": "Vacancy not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/Ai/vacancies/{vacancyId}/refer-to-manual": {
      "post": {
        "summary": "Send vacancy for manual review",
        "operationId": "sendVacancyForManualReview",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Review referred successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/Ai/vacancies/{vacancyId}/approve": {
      "post": {
        "summary": "Auto-approve a vacancy",
        "operationId": "autoApproveVacancy",
        "parameters": [
          {
            "name": "vacancyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Vacancy approved successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMenuResponse": {
        "type": "object",
        "properties": {
          "Menu": {
            "$ref": "#/components/schemas/MenuPageModel"
          }
        }
      },
      "MenuPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "$ref": "#/components/schemas/MenuPageContent"
          }
        }
      },
      "MenuPageContent": {
        "type": "object",
        "properties": {
          "TopLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Hub": {
            "type": "string"
          },
          "PageType": {
            "type": "string"
          },
          "ParentSlug": {
            "type": "string"
          }
        }
      },
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortColumn": {
            "type": "string"
          },
          "SortDescending": {
            "type": "boolean"
          },
          "Page": {
            "type": "integer",
            "format": "int32"
          },
          "PageSize": {
            "type": "integer",
            "format": "int32"
          },
          "StartMonth": {
            "type": "integer",
            "format": "int32"
          },
          "StartYear": {
            "type": "integer",
            "format": "int32"
          },
          "CourseCode": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        }
      },
      "GetLearnersForProviderQueryResult": {
        "type": "object",
        "properties": {
          "Learners": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "GetLearnerForProviderQueryResult": {
        "type": "object",
        "properties": {
          "Learner": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "CreateVacancyReviewData": {
        "type": "object",
        "properties": {
          "ReviewStatus": {
            "type": "string",
            "enum": [
              "Skipped",
              "Failed",
              "Success"
            ]
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      }
    }
  }
}
