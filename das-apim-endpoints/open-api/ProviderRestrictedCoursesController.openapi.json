  "components": {
    "schemas": {
      "AddProviderRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "lastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "userId",
          "userDisplayName"
        ]
      },
      "RemoveProviderRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "userDisplayName"
        ]
      },
      "UpdateProviderRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "lastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "userId",
          "userDisplayName"
        ]
      },
      "GetProviderNotRestrictedApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotRestrictedApprenticeshipModel"
            }
          }
        }
      },
      "GetProviderRestrictedApprenticeshipsResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestrictedApprenticeshipModel"
            }
          }
        }
      },
      "NotRestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "larsCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          }
        },
        "required": [
          "larsCode",
          "title",
          "level"
        ]
      },
      "RestrictedApprenticeshipModel": {
        "type": "object",
        "properties": {
          "larsCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "lastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "isClosedToNewStarts": {
            "type": "boolean"
          }
        },
        "required": [
          "larsCode",
          "title",
          "level",
          "isClosedToNewStarts"
        ]
      }
    }
  }
}
