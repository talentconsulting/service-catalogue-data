{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Restricted Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/restricted-apprenticeships": {
      "get": {
        "summary": "Get Provider Restricted Apprenticeships",
        "operationId": "GetProviderRestrictedApprenticeships",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderRestrictedApprenticeshipsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{ukprn}/not-restricted-apprenticeships": {
      "get": {
        "summary": "Get Provider Not Restricted Apprenticeships",
        "operationId": "GetProviderNotRestrictedApprenticeships",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderNotRestrictedApprenticeshipsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{ukprn}/restricted-apprenticeships/{larsCode}/change": {
      "post": {
        "summary": "Update Provider Restricted Apprenticeship",
        "operationId": "UpdateProviderRestrictedApprenticeship",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderRestrictedApprenticeshipModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/providers/{ukprn}/restricted-apprenticeships/{larsCode}/remove": {
      "post": {
        "summary": "Remove Provider Restricted Apprenticeship",
        "operationId": "RemoveProviderRestrictedApprenticeship",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveProviderRestrictedApprenticeshipModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/providers/{ukprn}/restricted-apprenticeships/{larsCode}/add": {
      "post": {
        "summary": "Add Provider Restricted Apprenticeship",
        "operationId": "AddProviderRestrictedApprenticeship",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
