{
  "openapi": "3.1.0",
  "info": {
    "title": "Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/settings/": {
      "get": {
        "operationId": "GetSettings",
        "summary": "Retrieve settings",
        "responses": {
          "200": {
            "description": "Successful response with settings data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSettingsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Settings not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSettingsResponse": {
        "type": "object",
        "additionalProperties": true,
        "description": "The settings data returned by the GetSettings endpoint."
      }
    }
  }
}
