{
  "openapi": "3.1.0",
  "info": {
    "title": "Survey Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Survey": {
      "post": {
        "operationId": "SaveSurveyAsync",
        "summary": "Save a survey",
        "description": "Endpoint for saving survey feedback given by users.",
        "security": [],
        "tags": [
          "Survey"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSurveyCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Survey saved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "An internal server error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaveSurveyCommand": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "string",
            "description": "The page identifier where feedback was given."
          },
          "SatisfactionScore": {
            "type": "integer",
            "description": "The satisfaction score provided by the user."
          },
          "Comments": {
            "type": "string",
            "description": "The comments provided by the user."
          }
        },
        "required": [
          "Page",
          "SatisfactionScore",
          "Comments"
        ]
      },
      "EmptyResponse": {
        "type": "object",
        "description": "Represents an empty successful response."
      }
    }
  }
}
