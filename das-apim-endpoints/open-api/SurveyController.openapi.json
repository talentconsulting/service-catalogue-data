{
  "openapi": "3.1.0",
  "info": {
    "title": "Aodp Survey API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Survey": {
      "post": {
        "operationId": "SaveSurveyAsync",
        "summary": "Saves a survey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSurveyCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaveSurveyCommand": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string"
          },
          "satisfactionScore": {
            "type": "integer",
            "format": "int32"
          },
          "comments": {
            "type": "string"
          }
        },
        "required": [
          "page",
          "satisfactionScore",
          "comments"
        ]
      },
      "EmptyResponse": {
        "type": "object",
        "description": "An empty response for a successful operation"
      }
    }
  }
}
