{
  "openapi": "3.1.0",
  "info": {
    "title": "Survey API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Survey": {
      "post": {
        "summary": "Save survey data",
        "operationId": "SaveSurvey",
        "requestBody": {
          "description": "Survey data",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveSurveyCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Survey saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SaveSurveyCommand": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "string"
          },
          "SatisfactionScore": {
            "type": "integer"
          },
          "Comments": {
            "type": "string"
          }
        },
        "required": [
          "Page",
          "SatisfactionScore"
        ]
      },
      "EmptyResponse": {
        "type": "object",
        "description": "Empty response"
      }
    }
  }
}
