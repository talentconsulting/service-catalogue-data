{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Request Apprentice Training API",
    "version": "1.0.0"
  },
  "paths": {
    "/employer-requests/{employerRequestId}/training-request": {
      "get": {
        "summary": "Get Training Request",
        "parameters": [
          {
            "name": "employerRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "includeProviders",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Training request retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Training request not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employer-requests/{employerRequestId}/responses/acknowledge": {
      "put": {
        "summary": "Acknowledge Provider Responses",
        "parameters": [
          {
            "name": "employerRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "acknowledgedBy",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider responses acknowledged successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employer-requests/{employerRequestId}/cancel": {
      "put": {
        "summary": "Cancel Employer Request",
        "parameters": [
          {
            "name": "employerRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelEmployerRequestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employer request canceled successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employer-requests/{employerRequestId}/submit-confirmation": {
      "get": {
        "summary": "Get Submit Employer Request Confirmation",
        "parameters": [
          {
            "name": "employerRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Submit confirmation retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitEmployerRequestConfirmation"
                }
              }
            }
          },
          "404": {
            "description": "Confirmation not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employer-requests/{employerRequestId}/cancel-confirmation": {
      "get": {
        "summary": "Get Cancel Employer Request Confirmation",
        "parameters": [
          {
            "name": "employerRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cancel confirmation retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CancelEmployerRequestConfirmation"
                }
              }
            }
          },
          "404": {
            "description": "Confirmation not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employer-requests/expire": {
      "put": {
        "summary": "Expire Employer Requests",
        "responses": {
          "200": {
            "description": "Employer requests expired successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employer-requests/response-notifications": {
      "get": {
        "summary": "Get Employer Requests for Response Notification",
        "responses": {
          "200": {
            "description": "Employer requests retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/employer-requests/send-notification": {
      "put": {
        "summary": "Send Response Notification",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendResponseNotificationEmailParameters"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification sent successfully"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CancelEmployerRequestRequest": {
        "type": "object",
        "properties": {
          "CancelledBy": {
            "type": "string",
            "format": "uuid"
          },
          "DashboardUrl": {
            "type": "string"
          }
        },
        "required": [
          "CancelledBy",
          "DashboardUrl"
        ]
      },
      "SendResponseNotificationEmailParameters": {
        "type": "object",
        "properties": {
          "RequestedBy": {
            "type": "string",
            "format": "uuid"
          },
          "AccountId": {
            "type": "integer"
          },
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandardDetails"
            }
          },
          "ManageNotificationSettingsLink": {
            "type": "string"
          },
          "ManageRequestsLink": {
            "type": "string"
          }
        },
        "required": [
          "RequestedBy",
          "AccountId",
          "Standards"
        ]
      },
      "StandardDetails": {
        "type": "object",
        "properties": {
          "StandardTitle": {
            "type": "string"
          },
          "StandardLevel": {
            "type": "integer"
          }
        },
        "required": [
          "StandardTitle",
          "StandardLevel"
        ]
      },
      "SubmitEmployerRequestConfirmation": {
        "type": "object",
        "properties": {
          "EmployerRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "StandardTitle": {
            "type": "string"
          },
          "StandardLevel": {
            "type": "integer"
          },
          "NumberOfApprentices": {
            "type": "integer"
          },
          "SameLocation": {
            "type": "string"
          },
          "SingleLocation": {
            "type": "string"
          },
          "AtApprenticesWorkplace": {
            "type": "boolean"
          },
          "DayRelease": {
            "type": "boolean"
          },
          "BlockRelease": {
            "type": "boolean"
          },
          "RequestedByEmail": {
            "type": "string"
          },
          "ExpiryAfterMonths": {
            "type": "integer"
          },
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        },
        "required": [
          "EmployerRequestId",
          "StandardTitle",
          "StandardLevel",
          "NumberOfApprentices"
        ]
      },
      "CancelEmployerRequestConfirmation": {
        "type": "object",
        "properties": {
          "EmployerRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "StandardTitle": {
            "type": "string"
          },
          "StandardLevel": {
            "type": "integer"
          },
          "CancelledByEmail": {
            "type": "string"
          },
          "NumberOfApprentices": {
            "type": "integer"
          },
          "SameLocation": {
            "type": "string"
          },
          "SingleLocation": {
            "type": "string"
          },
          "AtApprenticesWorkplace": {
            "type": "boolean"
          },
          "DayRelease": {
            "type": "boolean"
          },
          "BlockRelease": {
            "type": "boolean"
          },
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        },
        "required": [
          "EmployerRequestId",
          "StandardTitle",
          "StandardLevel",
          "CancelledByEmail",
          "NumberOfApprentices"
        ]
      },
      "Region": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Area": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer"
          }
        },
        "required": [
          "Id",
          "Area",
          "Ordering"
        ]
      }
    }
  }
}
