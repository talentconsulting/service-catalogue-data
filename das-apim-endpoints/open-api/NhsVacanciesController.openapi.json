{
  "openapi": "3.1.0",
  "info": {
    "title": "Find Apprenticeship Jobs API",
    "version": "1.0.0",
    "description": "API for accessing NHS Vacancies in the Find Apprenticeship Jobs platform."
  },
  "paths": {
    "/NhsVacancies": {
      "get": {
        "summary": "Retrieve NHS job vacancies",
        "operationId": "GetNhsVacancies",
        "responses": {
          "200": {
            "description": "Successfully retrieved NHS job vacancies.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLiveVacanciesApiResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetLiveVacanciesApiResponse": {
        "type": "object"
      }
    }
  }
}
