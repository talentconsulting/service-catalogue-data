{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin AAN API",
    "version": "1.0.0"
  },
  "paths": {
    "/schools/find/{searchTerm}": {
      "get": {
        "summary": "Get a list of schools based on a search term.",
        "operationId": "GetSchools",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The search term to find schools."
          }
        ],
        "responses": {
          "200": {
            "description": "List of schools based on search term.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/School"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "School": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "The name of the school."
          },
          "urn": {
            "type": "string",
            "description": "The unique reference number for the school."
          }
        },
        "required": [
          "name",
          "urn"
        ]
      }
    }
  }
}
