{
  "openapi": "3.1.0",
  "info": {
    "title": "Schools API",
    "version": "1.0.0",
    "description": "API for managing school information."
  },
  "paths": {
    "/Schools/find/{searchTerm}": {
      "get": {
        "tags": [
          "Schools"
        ],
        "summary": "Find schools by search term",
        "operationId": "GetSchools",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "path",
            "description": "Search string to find schools.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of schools matching the search term.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/School"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "School": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "urn": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "urn"
        ]
      }
    }
  }
}
