{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Schools/find/{searchTerm}": {
      "get": {
        "summary": "Search for schools",
        "operationId": "getSchools",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of schools matching the search term",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/School"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "School": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Urn": {
            "type": "string"
          }
        },
        "required": [
          "Name",
          "Urn"
        ]
      }
    }
  }
}
