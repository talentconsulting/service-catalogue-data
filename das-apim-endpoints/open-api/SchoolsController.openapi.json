{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Aan Schools API",
    "version": "1.0.0"
  },
  "paths": {
    "/schools/find/{searchTerm}": {
      "get": {
        "summary": "Get schools based on a search term",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The search term used to find schools."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of schools matching the search term.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SchoolList"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "School": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "The name of the school."
          },
          "Urn": {
            "type": "string",
            "description": "The unique reference number (URN) of the school."
          }
        },
        "required": [
          "Name",
          "Urn"
        ]
      },
      "SchoolList": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/School"
        }
      }
    }
  }
}
