{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign API",
    "version": "1.0.0"
  },
  "paths": {
    "/Hub/{hub}": {
      "get": {
        "summary": "Retrieve information about a hub.",
        "operationId": "getHub",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hub identifier."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved hub information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHubResponse"
                }
              }
            }
          },
          "404": {
            "description": "Hub not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Hub/preview/{hub}": {
      "get": {
        "summary": "Retrieve preview information about a hub.",
        "operationId": "getPreviewHub",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The hub identifier for preview."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved preview information about the hub.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHubResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview hub not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetHubResponse": {
        "type": "object",
        "properties": {
          "Hub": {
            "$ref": "#/components/schemas/HubPageModel"
          }
        }
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          }
        },
        "description": "Details of the not found error."
      },
      "HubPageModel": {
        "type": "object",
        "properties": {
          "PageAttributes": {
            "$ref": "#/components/schemas/PageModel"
          },
          "MainContent": {
            "$ref": "#/components/schemas/HubContent"
          },
          "MenuContent": {
            "$ref": "#/components/schemas/MenuPageContent"
          },
          "BannerModels": {
            "$ref": "#/components/schemas/BannerPageModel"
          }
        }
      },
      "PageModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "PageType": {
            "$ref": "#/components/schemas/PageType"
          },
          "Title": {
            "type": "string"
          },
          "MetaDescription": {
            "type": "string"
          },
          "Slug": {
            "type": "string"
          },
          "HubType": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "ArticleType": {
            "type": "string"
          }
        }
      },
      "PageType": {
        "type": "string",
        "enum": [
          "Unknown",
          "LandingPage",
          "Article",
          "Hub",
          "Tab"
        ]
      },
      "HubContent": {
        "type": "object",
        "properties": {
          "HeaderImage": {
            "$ref": "#/components/schemas/ContentItem"
          },
          "CardsTitle": {
            "type": "string"
          },
          "Cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          },
          "CardsTitle2": {
            "type": "string"
          },
          "Cards2": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          },
          "CardsTitle3": {
            "type": "string"
          },
          "Cards3": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          }
        }
      },
      "MenuPageContent": {
        "type": "object",
        "properties": {
          "TopLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageContent"
            }
          }
        }
      },
      "CardPageModel": {
        "type": "object",
        "properties": {
          "LandingPage": {
            "$ref": "#/components/schemas/UrlDetails"
          },
          "CardImage": {
            "$ref": "#/components/schemas/ContentItem"
          },
          "Id": {
            "type": "string"
          },
          "Slug": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "HubType": {
            "type": "string"
          },
          "MetaDescription": {
            "type": "string"
          },
          "PageType": {
            "$ref": "#/components/schemas/PageType"
          }
        }
      },
      "BannerPageContent": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "BackgroundColour": {
            "type": "string"
          },
          "AllowUserToHideTheBanner": {
            "type": "boolean"
          },
          "ShowOnTheHomepageOnly": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "Values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Type": {
            "type": "string"
          },
          "TableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "EmbeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "VideoTranscripts": {
