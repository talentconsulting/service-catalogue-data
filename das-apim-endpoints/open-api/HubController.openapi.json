{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign Hub API",
    "description": "API for managing campaign hubs and previews.",
    "version": "1.0.0"
  },
  "paths": {
    "/hub/{hub}": {
      "get": {
        "operationId": "getHub",
        "summary": "Get details of a specific hub by its identifier.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier of the hub to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Hub details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHubResponse"
                }
              }
            }
          },
          "404": {
            "description": "Hub not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/hub/preview/{hub}": {
      "get": {
        "operationId": "getPreviewHub",
        "summary": "Get preview details of a specific hub by its identifier.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Identifier of the hub preview to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Hub preview details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHubResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview hub not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetHubResponse": {
        "type": "object",
        "properties": {
          "hub": {
            "$ref": "#/components/schemas/HubPageModel"
          }
        },
        "required": [
          "hub"
        ]
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Details about the resource not being found."
          }
        },
        "required": [
          "message"
        ]
      },
      "HubPageModel": {
        "type": "object",
        "properties": {
          "pageAttributes": {
            "$ref": "#/components/schemas/PageModel"
          },
          "mainContent": {
            "$ref": "#/components/schemas/HubContent"
          },
          "menuContent": {
            "$ref": "#/components/schemas/MenuPageModelContent"
          },
          "bannerModels": {
            "$ref": "#/components/schemas/BannerPageModel"
          }
        }
      },
      "PageModel": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "metaDescription": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "hubType": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        }
      },
      "HubContent": {
        "type": "object",
        "properties": {
          "headerImage": {
            "$ref": "#/components/schemas/ContentItem"
          },
          "cardsTitle": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          },
          "cardsTitle2": {
            "type": "string"
          },
          "cards2": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          },
          "cardsTitle3": {
            "type": "string"
          },
          "cards3": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardPageModel"
            }
          }
        }
      },
      "MenuPageModelContent": {
        "type": "object",
        "properties": {
          "topLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "mainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageContent"
            }
          }
        }
      },
      "BannerPageContent": {
        "type": "object",
        "properties": {
          "backgroundColour": {
            "type": "string"
          },
          "allowUserToHideTheBanner": {
            "type": "boolean"
          },
          "showOnTheHomepageOnly": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "embeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "CardPageModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "hubType": {
            "type": "string"
          },
          "metaDescription": {
            "type": "string"
          },
          "landingPage": {
            "$ref": "#/components/schemas/UrlDetails"
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "hub": {
            "type": "string"
          },
          "pageType": {
            "type": "string"
          },
          "parentSlug": {
            "type": "string"
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
