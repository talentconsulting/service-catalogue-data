            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "Url": {
            "type": "string"
          },
          "Size": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "VideoName": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Hub": {
            "type": "string"
          },
          "PageType": {
            "type": "string"
          },
          "ParentSlug": {
            "type": "string"
          }
        }
      }
    }
  }
}
