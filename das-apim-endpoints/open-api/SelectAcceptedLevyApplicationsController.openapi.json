{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountId}/unapproved/add/select-funding/select-accepted-levy-connection": {
      "get": {
        "operationId": "GetAcceptedLevyConnections",
        "summary": "Retrieve accepted levy connections for a specific account",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the employer account"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAcceptedEmployerAccountApplicationsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAcceptedEmployerAccountApplicationsQueryResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "submittedDate": {
            "type": "string",
            "format": "date-time"
          },
          "submitted": {
            "type": "boolean"
          },
          "owner": {
            "type": "string"
          },
          "reference": {
            "type": "string"
          },
          "formVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "updatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "newMessage": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
