{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountId}/unapproved/add/select-funding/select-accepted-levy-connection": {
      "get": {
        "summary": "Get Accepted Levy Connections",
        "operationId": "GetAcceptedLevyConnections",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID for which levy connections are to be fetched."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAcceptedEmployerAccountApplicationsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationsByOrganisationIdQueryResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "name": {
                  "type": "string"
                },
                "createdDate": {
                  "type": "string",
                  "format": "date-time"
                },
                "submittedDate": {
                  "type": "string",
                  "format": "date-time"
                },
                "submitted": {
                  "type": "boolean"
                },
                "owner": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                },
                "formVersionId": {
                  "type": "string",
                  "format": "uuid"
                },
                "updatedDate": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "type": "string"
                },
                "newMessage": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "GetAcceptedEmployerAccountApplicationsQueryResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetApplicationsByOrganisationIdQueryResponse"
            }
          }
        }
      }
    }
  }
}
