{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0",
    "description": "API for managing levy applications for the SFA DAS Approvals service."
  },
  "paths": {
    "/{accountId}/unapproved/add/select-funding/select-accepted-levy-connection": {
      "get": {
        "summary": "Get accepted levy transfer connections",
        "operationId": "getAcceptedLevyConnections",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The unique identifier for the employer's account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of accepted employer account applications",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAcceptedEmployerAccountApplicationsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAcceptedEmployerAccountApplicationsQueryResponse": {
        "type": "object",
        "description": "Response model for accepted employer account applications query",
        "properties": {}
      }
    }
  }
}
