{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0",
    "description": "API for managing apprentice commitments and their apprenticeships."
  },
  "paths": {
    "/apprenticeships": {
      "post": {
        "summary": "Create an apprenticeship",
        "operationId": "CreateApprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship successfully created."
          },
          "default": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "example": {
                  "status": 500,
                  "error": "An error occurred."
                }
              }
            }
          }
        }
      }
    },
    "/apprenticeships/{id}": {
      "get": {
        "summary": "Retrieve an apprenticeship by its ID",
        "operationId": "GetApprenticeship",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{id}/apprenticeships": {
      "get": {
        "summary": "List apprenticeships for a specific apprentice",
        "operationId": "ListApprenticeApprenticeships",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeships listed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeshipResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Retrieve an apprenticeship by its apprentice and apprenticeship IDs",
        "operationId": "GetApprenticeshipDetails",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeshipResponse"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update specific fields of an apprenticeship",
        "operationId": "PatchApprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship updated successfully."
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/confirmed/latest": {
      "get": {
        "summary": "Retrieve the latest confirmed apprenticeship for a specific apprentice",
        "operationId": "GetLatestConfirmedApprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest confirmed apprenticeship retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions": {
      "get": {
        "summary": "Get all revisions of an apprenticeship",
        "operationId": "GetApprenticeshipRevisions",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revisions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeshipResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/commitments-apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Retrieve commitment details of an apprenticeship",
        "operationId": "GetCommitmentsApprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commitment apprenticeship details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitmentsApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "RegistrationId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "RegistrationId",
          "ApprenticeId"
        ]
      },
      "ApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "EmployerAccountId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "EmployerName": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "DeliveryModel": {
            "type": "integer"
          }
        }
      },
      "CommitmentsApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Status": {
            "type": "string"
          },
          "Cost": {
            "type": "number"
          }
        }
      }
    }
  }
}
