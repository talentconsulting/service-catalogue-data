{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships API",
    "description": "API for managing apprenticeships",
    "version": "1.0.0"
  },
  "paths": {
    "/apprenticeships": {
      "post": {
        "operationId": "createApprenticeship",
        "summary": "Create a new apprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApprenticeshipCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship created successfully"
          },
          "default": {
            "description": "Error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseException"
                }
              }
            }
          }
        }
      }
    },
    "/apprenticeships/{id}": {
      "get": {
        "operationId": "getApprenticeship",
        "summary": "Get apprenticeship by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship details retrieved successfully"
          },
          "default": {
            "description": "Error occurred"
          }
        }
      }
    },
    "/apprentices/{id}/apprenticeships": {
      "get": {
        "operationId": "listApprenticeApprenticeships",
        "summary": "List all apprenticeships for an apprentice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship list retrieved successfully"
          },
          "default": {
            "description": "Error occurred"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}": {
      "get": {
        "operationId": "getSpecificApprenticeship",
        "summary": "Get specific apprenticeship information",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Specific apprenticeship details retrieved successfully"
          },
          "default": {
            "description": "Error occurred"
          }
        }
      },
      "patch": {
        "operationId": "patchApprenticeship",
        "summary": "Update apprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship updated successfully"
          },
          "default": {
            "description": "Error occurred"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/confirmed/latest": {
      "get": {
        "operationId": "getLatestConfirmedApprenticeship",
        "summary": "Get latest confirmed apprenticeship information",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Latest confirmed apprenticeship details retrieved successfully"
          },
          "default": {
            "description": "Error occurred"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions": {
      "get": {
        "operationId": "getApprenticeshipRevisions",
        "summary": "Get apprenticeship revisions",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship revision details retrieved successfully"
          },
          "default": {
            "description": "Error occurred"
          }
        }
      }
    },
    "/commitments-apprenticeships/{apprenticeshipId}": {
      "get": {
        "operationId": "getCommitmentsApprenticeshipById",
        "summary": "Get commitments apprenticeship details by ID",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Commitments apprenticeship details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommitmentsApprenticeshipResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error occurred"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateApprenticeshipCommand": {
        "type": "object",
        "properties": {
          "RegistrationId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "RegistrationId",
          "ApprenticeId"
        ]
      },
      "JsonPatchDocument": {
        "type": "object",
        "additionalProperties": true
      },
      "ApiResponseException": {
        "type": "object",
        "properties": {
          "Status": {
            "type": "integer",
            "format": "int32"
          },
          "Error": {
            "type": "string"
          }
        },
        "required": [
          "Status",
          "Error"
        ]
      },
      "CommitmentsApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerName": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Uln": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "integer",
            "format": "int32",
            "enum": [
              0,
              1,
              2
            ]
          },
          "StandardUId": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "Option": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "StopDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "HasHadDataLockSuccess": {
            "type": "boolean"
          },
          "OriginalStartDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "RecognisePriorLearning": {
            "type": "boolean",
            "nullable": true
          },
          "TrainingTotalHours": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "DurationReducedByHours": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "DurationReducedBy": {
            "type": "integer",
            "nullable": true
          },
          "PriceReducedBy": {
            "type": "integer",
            "nullable": true
          },
          "ApprenticeshipType": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "required": [
          "Id",
          "EmployerAccountId",
          "AccountLegalEntityId",
          "EmployerName",
          "FirstName",
          "LastName",
          "Email",
          "Uln",
          "DeliveryModel",
          "StandardUId",
          "CourseCode",
          "CourseName",
          "StartDate",
          "EndDate",
          "DateOfBirth"
        ]
      }
    }
  }
}
