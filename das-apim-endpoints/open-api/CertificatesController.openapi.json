{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0",
    "description": "API for managing certificates and related operations"
  },
  "paths": {
    "/certificates/{id}": {
      "get": {
        "operationId": "GetStandardCertificate",
        "summary": "Retrieve a standard certificate by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Certificate ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Standard certificate retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardCertificateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Certificate not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/certificates/{id}/framework": {
      "get": {
        "operationId": "GetFrameworkCertificate",
        "summary": "Retrieve a framework certificate by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Framework learner ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Framework certificate retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworkCertificateResponse"
                }
              }
            }
          },
          "404": {
            "description": "Framework certificate not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/certificates/{id}/printrequest": {
      "post": {
        "operationId": "CreatePrintRequest",
        "summary": "Create a print request for a certificate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Certificate ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePrintRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Print request created successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardCertificateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the certificate"
          },
          "standard": {
            "type": "string",
            "description": "The standard associated with the certificate"
          },
          "learnerName": {
            "type": "string",
            "description": "Name of the learner"
          },
          "issueDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date the certificate was issued"
          }
        }
      },
      "GetFrameworkCertificateResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the framework certificate"
          },
          "framework": {
            "type": "string",
            "description": "The framework associated with the certificate"
          },
          "learnerName": {
            "type": "string",
            "description": "Name of the learner"
          },
          "issueDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date the certificate was issued"
          }
        }
      },
      "CreatePrintRequest": {
        "type": "object",
        "properties": {
          "certificateId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the certificate"
          },
          "address": {
            "$ref": "#/components/schemas/AddressDto"
          },
          "email": {
            "$ref": "#/components/schemas/EmailDto"
          }
        },
        "required": [
          "certificateId",
          "address",
          "email"
        ]
      },
      "AddressDto": {
        "type": "object",
        "properties": {
          "contactName": {
            "type": "string",
            "description": "Name of the contact person"
          },
          "contactOrganisation": {
            "type": "string",
            "description": "Organisation name"
          },
          "contactAddLine1": {
            "type": "string",
            "description": "Address line 1"
          },
          "contactAddLine2": {
            "type": "string",
            "description": "Address line 2"
          },
          "contactAddLine3": {
            "type": "string",
            "description": "Address line 3"
          },
          "contactAddLine4": {
            "type": "string",
            "description": "Address line 4"
          },
          "contactPostCode": {
            "type": "string",
            "description": "Postal code"
          }
        }
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string",
            "format": "email",
            "description": "Recipient's email address"
          },
          "userName": {
            "type": "string",
            "description": "User's name"
          },
          "linkDomain": {
            "type": "string",
            "description": "Domain link for the email"
          },
          "templateId": {
            "type": "string",
            "description": "Template ID for the email"
          }
        }
      }
    }
  }
}
