{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/FeedbackTargetVariant/process-variants": {
      "post": {
        "summary": "Process feedback target variants",
        "operationId": "ProcessFeedbackTargetVariants",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessFeedbackTargetVariantsCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FeedbackTargetVariant": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "Variant": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ProcessFeedbackTargetVariantsCommand": {
        "type": "object",
        "properties": {
          "ClearStaging": {
            "type": "boolean"
          },
          "MergeStaging": {
            "type": "boolean"
          },
          "FeedbackTargetVariants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedbackTargetVariant"
            }
          }
        }
      }
    }
  }
}
