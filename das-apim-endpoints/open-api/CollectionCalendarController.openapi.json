{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0",
    "description": "API for managing employer incentives, including updates to collection calendar periods."
  },
  "paths": {
    "/collectionPeriods": {
      "patch": {
        "summary": "Update a collection calendar period",
        "operationId": "updateCollectionCalendarPeriod",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCollectionCalendarPeriodRequest"
              }
            },
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCollectionCalendarPeriodRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCollectionCalendarPeriodRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateCollectionCalendarPeriodRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The collection calendar period was updated successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateCollectionCalendarPeriodRequest": {
        "type": "object",
        "properties": {
          "PeriodNumber": {
            "type": "integer",
            "format": "int32",
            "description": "The period number of the collection calendar."
          },
          "AcademicYear": {
            "type": "integer",
            "format": "int32",
            "description": "The academic year for which the collection period is active."
          },
          "Active": {
            "type": "boolean",
            "description": "Indicates whether the collection period is active."
          }
        },
        "required": [
          "PeriodNumber",
          "AcademicYear",
          "Active"
        ]
      }
    }
  }
}
