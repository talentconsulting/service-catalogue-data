{
  "openapi": "3.1.0",
  "info": {
    "title": "Collection Calendar API",
    "version": "1.0.0"
  },
  "paths": {
    "/CollectionCalendar/academicYear/{searchDate}": {
      "get": {
        "summary": "Get Academic Year",
        "description": "Retrieves the academic year based on a given search date.",
        "operationId": "GetAcademicYear",
        "parameters": [
          {
            "name": "searchDate",
            "in": "path",
            "required": true,
            "description": "The date to search for the academic year.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with academic year data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAcademicYearsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAcademicYearsResponse": {
        "type": "object",
        "additionalProperties": false
      }
    }
  }
}
