{
  "openapi": "3.1.0",
  "info": {
    "title": "Collection Calendar API",
    "version": "1.0.0"
  },
  "paths": {
    "/collectionCalendar/academicYear/{searchDate}": {
      "get": {
        "summary": "Get Academic Year",
        "description": "Retrieve the academic year based on the provided search date.",
        "parameters": [
          {
            "name": "searchDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "The search date to retrieve the academic year."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with academic year details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcademicYearDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcademicYearDetails": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "startDate",
          "endDate",
          "name"
        ]
      },
      "GetAcademicyearsApiRequest": {
        "type": "object",
        "properties": {
          "searchDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "searchDate"
        ]
      }
    }
  }
}
