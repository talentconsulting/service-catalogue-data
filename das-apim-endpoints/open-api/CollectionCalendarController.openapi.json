{
  "openapi": "3.1.0",
  "info": {
    "title": "Collection Calendar API",
    "description": "API for managing collection calendar data",
    "version": "1.0.0"
  },
  "paths": {
    "/CollectionCalendar/academicYear/{searchDate}": {
      "get": {
        "summary": "Get Academic Year",
        "description": "Retrieve academic year information for a specific date.",
        "parameters": [
          {
            "name": "searchDate",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "The date to search for the academic year."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing academic year data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAcademicYearsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAcademicYearsResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
