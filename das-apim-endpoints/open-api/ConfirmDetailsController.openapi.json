{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Aan Onboarding API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/onboarding/confirm-details": {
      "get": {
        "summary": "Retrieve onboarding confirmation details for an employer account",
        "operationId": "getOnboardingConfirmDetails",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "description": "The ID of the employer account",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The onboarding confirmation details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOnboardingConfirmDetailsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOnboardingConfirmDetailsResponse": {
        "type": "object",
        "description": "Response model containing onboarding confirmation details",
        "additionalProperties": true
      }
    }
  }
}
