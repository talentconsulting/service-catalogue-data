{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/FeedbackTransactions/": {
      "get": {
        "summary": "Get feedback transactions batch",
        "operationId": "getFeedbackTransactionsBatch",
        "parameters": [
          {
            "name": "batchsize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "feedbackTransactions": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/FeedbackTransactions/send": {
      "post": {
        "summary": "Send feedback email",
        "operationId": "sendFeedbackEmail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendFeedbackEmailRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/FeedbackTransactions/{id}": {
      "put": {
        "summary": "Update feedback transaction",
        "operationId": "updateFeedbackTransaction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFeedbackTransactionRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/FeedbackTransactions/{id}/users": {
      "get": {
        "summary": "Get feedback transaction users",
        "operationId": "getFeedbackTransactionUsers",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SendFeedbackEmailRequest": {
        "type": "object",
        "properties": {
          "TemplateId": {
            "type": "string",
            "format": "uuid"
          },
          "Contact": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "EmployerName": {
            "type": "string"
          },
          "AccountHashedId": {
            "type": "string"
          },
          "AccountsBaseUrl": {
            "type": "string"
          },
          "FeedbackBaseUrl": {
            "type": "string"
          }
        }
      },
      "UpdateFeedbackTransactionRequest": {
        "type": "object",
        "properties": {
          "TemplateId": {
            "type": "string",
            "format": "uuid"
          },
          "SentCount": {
            "type": "integer"
          },
          "SentDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
