{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/OverlappingTrainingDateRequest/create": {
      "post": {
        "summary": "Create Overlapping Training Date Request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/validate": {
      "post": {
        "summary": "Validate Draft Apprenticeship Details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/validateChangeOfEmployerOverlap": {
      "post": {
        "summary": "Validate Change of Employer Overlap",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateChangeOfEmployerOverlapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/{providerId}/validateUlnOverlap": {
      "get": {
        "summary": "Validate ULN Overlap on Start Date",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/{draftApprenticeshipId}/getOverlapRequest": {
      "get": {
        "summary": "Get Overlap Request by Draft Apprenticeship ID",
        "parameters": [
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "DraftApprenticeshipId": {
            "type": "integer"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "DraftApprenticeshipId",
          "UserInfo"
        ]
      },
      "ValidateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "CohortId": {
            "type": "integer",
            "nullable": true
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "ValidateChangeOfEmployerOverlapRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "ProviderId": {
            "type": "integer"
          }
        },
        "required": [
          "Uln",
          "StartDate",
          "EndDate",
          "ProviderId"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
