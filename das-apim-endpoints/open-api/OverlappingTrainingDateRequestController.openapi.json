{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/OverlappingTrainingDateRequest/create": {
      "post": {
        "summary": "Creates an Overlapping Training Date",
        "operationId": "CreateOverlappingTrainingDate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOverlappingTrainingDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request completed successfully."
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/validate": {
      "post": {
        "summary": "Validates Draft Apprenticeship Request",
        "operationId": "ValidateDraftApprenticeshipRequest",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request completed successfully."
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/validateChangeOfEmployerOverlap": {
      "post": {
        "summary": "Validates Change of Employer Overlap",
        "operationId": "ValidateChangeOfEmployerOverlap",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidateChangeOfEmployerOverlapRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Request completed successfully."
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/{providerId}/validateUlnOverlap": {
      "get": {
        "summary": "Validates ULN Overlap on Start Date",
        "operationId": "ValidateUlnOverlapOnStartDate",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "endDate",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request completed successfully."
          }
        }
      }
    },
    "/OverlappingTrainingDateRequest/{draftApprenticeshipId}/getOverlapRequest": {
      "get": {
        "summary": "Gets Overlap Request",
        "operationId": "GetOverlapRequest",
        "parameters": [
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request completed successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOverlappingTrainingDateRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "DraftApprenticeshipId",
          "UserInfo"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      },
      "ValidateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "string",
            "enum": [
              "Regular",
              "PortableFlexiJob",
              "FlexiJobAgency"
            ],
            "nullable": true
          },
          "Cost": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "TrainingPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "EndPointAssessmentPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "EmploymentPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "IsOnFlexiPaymentPilot": {
            "type": "boolean",
            "nullable": true
          },
          "LearnerDataId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "Id",
          "ProviderId",
          "UserId",
          "FirstName",
          "LastName",
          "Email",
          "Uln",
          "CourseCode",
          "IgnoreStartDateOverlap",
          "UserInfo"
        ]
      },
      "ValidateChangeOfEmployerOverlapRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Uln",
          "StartDate",
          "EndDate",
          "ProviderId"
        ]
      }
    }
  }
}
