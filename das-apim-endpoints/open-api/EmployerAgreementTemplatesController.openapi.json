{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Agreement Templates API",
    "version": "1.0.0"
  },
  "paths": {
    "/EmployerAgreementTemplates/": {
      "get": {
        "summary": "Get Employer Agreement Templates",
        "operationId": "GetEmployerAgreementTemplates",
        "responses": {
          "200": {
            "description": "A list of employer agreement templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EmployerAgreementTemplate"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No templates found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmployerAgreementTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
