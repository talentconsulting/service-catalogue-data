{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Aan Member Notification Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/MemberNotificationSettings/{memberId}": {
      "get": {
        "summary": "Get Member Notification Event Formats",
        "operationId": "GetMemberNotificationEventFormats",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved member notification settings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMemberNotificationSettingsQueryResult"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update Member Notification Settings",
        "operationId": "PostMemberNotificationSettings",
        "parameters": [
          {
            "name": "memberId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationsSettingsApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated member notification settings."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMemberNotificationSettingsQueryResult": {
        "type": "object",
        "properties": {
          "MemberNotificationEventFormats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberNotificationEventFormatModel"
            }
          },
          "MemberNotificationLocations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberNotificationLocationsModel"
            }
          },
          "ReceiveMonthlyNotifications": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "MemberNotificationEventFormatModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "EventFormat": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer"
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        }
      },
      "MemberNotificationLocationsModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Radius": {
            "type": "integer"
          },
          "Latitude": {
            "type": "number",
            "format": "double"
          },
          "Longitude": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "NotificationsSettingsApiRequest": {
        "type": "object",
        "properties": {
          "ReceiveNotifications": {
            "type": "boolean"
          },
          "EventTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationEventType"
            }
          },
          "Locations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Location"
            }
          }
        }
      },
      "NotificationEventType": {
        "type": "object",
        "properties": {
          "EventType": {
            "type": "string"
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        }
      },
      "Location": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Radius": {
            "type": "integer"
          },
          "Latitude": {
            "type": "number",
            "format": "double"
          },
          "Longitude": {
            "type": "number",
            "format": "double"
          }
        }
      }
    }
  }
}
