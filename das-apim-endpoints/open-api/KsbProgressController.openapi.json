{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice KSB Progress API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{apprenticeId}/ksbs": {
      "post": {
        "summary": "Add or update KSB progress",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeKsbProgressData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Progress data updated successfully"
          }
        }
      },
      "get": {
        "summary": "Get apprenticeship KSBs",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of KSBs for apprenticeships",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeKsbData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/{ksbId}": {
      "get": {
        "summary": "Get apprenticeship KSB progress",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ksbId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of KSB progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeKsbData"
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/taskid/{taskId}": {
      "get": {
        "summary": "Get KSB progress for a task",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Progress data linked to a task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeKsbProgressData"
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/{ksbProgressId}/taskid/{taskId}": {
      "delete": {
        "summary": "Remove the KSB to task association",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ksbProgressId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task association removed successfully"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/guids": {
      "get": {
        "summary": "Get KSBs by apprenticeship ID and GUID list",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "guids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of KSB progress data for given GUIDs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeKsbProgressData"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeKsbProgressData": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "KsbProgressId": {
            "type": "integer",
            "format": "int32"
          },
          "KSBProgressType": {
            "type": "string",
            "enum": [
              "Knowledge",
              "Skill",
              "Behaviour"
            ]
          },
          "KSBId": {
            "type": "string",
            "format": "uuid"
          },
          "KsbKey": {
            "type": "string"
          },
          "CurrentStatus": {
            "type": "string",
            "enum": [
              "NotStarted",
              "InProgress",
              "ReadyForReview",
              "Completed"
            ]
          },
          "Note": {
            "type": "string"
          },
          "Tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeTask"
            }
          }
        }
      },
      "ApprenticeTask": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "DueDate": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          },
          "ApprenticeshipCategoryId": {
            "type": "integer",
            "format": "int32"
          },
          "Note": {
            "type": "string"
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "string",
            "enum": [
              "Todo",
              "Done"
            ]
          },
          "TaskFiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskFile"
            }
          },
          "TaskReminders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskReminder"
            }
          },
          "TaskLinkedKsbs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskKSBs"
            }
          }
        }
      },
      "TaskFile": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "TaskFileId": {
            "type": "integer",
            "format": "int32"
          },
          "FileType": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "FileContents": {
            "type": "string"
          }
        }
      },
      "TaskReminder": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "ReminderId": {
            "type": "integer",
            "format": "int32"
          },
          "ReminderValue": {
            "type": "integer",
            "format": "int32"
          },
          "ReminderUnit": {
            "type": "string",
            "enum": [
              "Minutes",
              "Hours",
              "Days"
            ]
          },
          "Status": {
            "type": "string",
            "enum": [
              "NotSent",
              "Sent",
              "Dismissed"
            ]
          }
        }
      },
      "TaskKSBs": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer",
            "format": "int32"
          },
          "KSBProgressId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ApprenticeKsbData": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/ApprenticeKsbProgressData"
          },
          {
            "properties": {
              "Detail": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
