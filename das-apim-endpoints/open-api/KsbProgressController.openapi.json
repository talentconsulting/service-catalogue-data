{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice KSB Progress API",
    "version": "1.0.0",
    "description": "API to manage KSB (Knowledge, Skills, and Behaviours) progress for apprentices."
  },
  "paths": {
    "/apprentices/{apprenticeId}/ksbs": {
      "post": {
        "summary": "Add or update KSB progress",
        "description": "Allows adding or updating KSB progress information for a specific apprentice.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the apprentice."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeKsbProgressData"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "KSB progress added or updated successfully."
          }
        }
      },
      "get": {
        "summary": "Get apprenticeship KSBs",
        "description": "Retrieve all KSBs for a specific apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the apprentice."
          }
        ],
        "responses": {
          "200": {
            "description": "List of KSBs for the apprenticeship.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeKsb"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/{ksbProgressId}/taskid/{taskId}": {
      "delete": {
        "summary": "Remove task-to-KSB association",
        "description": "Removes the association between a task and a KSB for a specific apprentice.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the apprentice."
          },
          {
            "name": "ksbProgressId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the KSB progress record."
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID of the task associated with the KSB."
          }
        ],
        "responses": {
          "200": {
            "description": "Task-to-KSB association removed successfully."
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/guids": {
      "get": {
        "summary": "Get KSBs by apprenticeship ID and GUIDs",
        "description": "Fetches KSBs for an apprenticeship based on a list of GUIDs.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the apprentice."
          },
          {
            "name": "guids",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "description": "List of GUIDs to filter KSBs."
          }
        ],
        "responses": {
          "200": {
            "description": "List of KSB progress records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeKsbProgress"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/taskid/{taskId}": {
      "get": {
        "summary": "Get KSB progress for a task",
        "description": "Retrieves KSB progress associated with a specific task.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the apprentice."
          },
          {
            "name": "taskId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier of the task."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the KSB progress for the specified task.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeKsbProgress"
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/ksbs/{ksbId}": {
      "get": {
        "summary": "Get apprenticeship KSB progress",
        "description": "Retrieves progress information for a specific KSB under an apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the apprentice."
          },
          {
            "name": "ksbId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the KSB."
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the specified KSB progress.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeKsb"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeKsbProgressData": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer"
          },
          "KsbProgressId": {
            "type": "integer"
          },
          "KSBProgressType": {
            "type": "string",
            "enum": [
              "Knowledge",
              "Skill",
              "Behaviour"
            ],
            "nullable": true
          },
          "KSBId": {
            "type": "string",
            "format": "uuid"
          },
          "KsbKey": {
            "type": "string"
          },
          "CurrentStatus": {
            "type": "string",
            "enum": [
              "NotStarted",
              "InProgress",
              "ReadyForReview",
              "Completed"
            ],
            "nullable": true
          },
          "Note": {
            "type": "string"
          },
          "Tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeTask"
            },
            "nullable": true
          }
        }
      },
      "ApprenticeTask": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "integer"
          },
          "ApprenticeshipId": {
            "type": "integer"
          },
          "ApprenticeAccountId": {
            "type": "string",
            "format": "uuid"
          },
          "DueDate": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          },
          "ApprenticeshipCategoryId": {
            "type": "integer",
            "nullable": true
          },
          "Note": {
            "type": "string"
          },
          "CompletionDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CreatedDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Status": {
            "type": "string",
            "enum": [
              "Todo",
              "Done"
            ],
            "nullable": true
          }
        }
      },
      "ApprenticeKsb": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Key": {
            "type": "string"
          },
          "Detail": {
            "type": "string"
          },
          "Type": {
            "type": "string"
          },
          "Progress": {
            "$ref": "#/components/schemas/ApprenticeKsbProgressData"
          }
        }
      },
      "ApprenticeKsbProgress": {
        "type": "object",
        "properties": {
          "KSBId": {
            "type": "string",
            "format": "uuid"
          },
          "Progress": {
            "type": "string"
          }
        }
      }
    }
  }
}
