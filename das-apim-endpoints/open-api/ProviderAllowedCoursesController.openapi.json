{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Allowed Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/allowed-courses/{larsCode}": {
      "post": {
        "summary": "Upsert a provider's allowed course",
        "operationId": "upsertProviderAllowedCourse",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertProviderAllowedCourseModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      },
      "patch": {
        "summary": "Patch a provider's allowed course",
        "operationId": "patchProviderAllowedCourse",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-RequestingUserId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-RequestingUserName",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchProviderAllowedCourseRequestModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/providers/{ukprn}/allowed-courses": {
      "get": {
        "summary": "Retrieve a provider's allowed courses",
        "operationId": "getProviderAllowedCourses",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "courseType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderAllowedCoursesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpsertProviderAllowedCourseModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ]
      },
      "PatchProviderAllowedCourseRequestModel": {
        "type": "object",
        "properties": {
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "ProviderAllowedCourseModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsStartRestricted": {
            "type": "boolean"
          },
          "IsActive": {
            "type": "boolean"
          }
        },
        "required": [
          "LarsCode",
          "Title",
          "Level",
          "IsStartRestricted",
          "IsActive"
        ]
      },
      "GetProviderAllowedCoursesResponse": {
        "type": "object",
        "properties": {
          "AllowedCourses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAllowedCourseModel"
            }
          }
        }
      }
    }
  }
}
