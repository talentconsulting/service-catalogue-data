{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Allowed Courses API",
    "description": "API for managing Provider Allowed Courses.",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/allowed-courses/{larsCode}": {
      "get": {
        "summary": "Get Details for a Specific Allowed Course",
        "operationId": "GetProviderAllowedCourseDetails",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier for the provider."
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the course."
          }
        ],
        "responses": {
          "200": {
            "description": "Details for the requested course.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderAllowedCourseDetailsResponse"
                }
              }
            }
          },
          "204": {
            "description": "No content if the course does not exist."
          }
        }
      }
    },
    "/providers/{ukprn}/allowed-courses": {
      "get": {
        "summary": "Get All Allowed Courses for a Provider",
        "operationId": "GetProviderAllowedCourses",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique identifier for the provider."
          },
          {
            "name": "courseType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            },
            "description": "Filter courses by a specific type."
          }
        ],
        "responses": {
          "200": {
            "description": "List of allowed courses for the provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderAllowedCoursesResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddProviderAllowedCourseModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsStartRestricted": {
            "type": "boolean"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "IsStartRestricted"
        ]
      },
      "PatchProviderAllowedCourseRequestModel": {
        "type": "object",
        "properties": {
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "GetProviderAllowedCoursesResponse": {
        "type": "object",
        "properties": {
          "AllowedCourses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAllowedCourseModel"
            }
          }
        }
      },
      "ProviderAllowedCourseModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsClosedToNewStarts": {
            "type": "boolean"
          }
        },
        "required": [
          "LarsCode",
          "Title",
          "Level",
          "IsClosedToNewStarts"
        ]
      },
      "GetProviderAllowedCourseDetailsResponse": {
        "type": "object",
        "properties": {
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "IsClosedToNewStarts": {
            "type": "boolean"
          },
          "IsActive": {
            "type": "boolean"
          }
        }
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      }
    }
  }
}
