          "Title": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          }
        }
      },
      "GetRoutingInformationForQuestionQueryResponse": {
        "type": "object",
        "properties": {
          "QuestionId": {
            "type": "string",
            "format": "uuid"
          },
          "QuestionTitle": {
            "type": "string"
          },
          "SectionTitle": {
            "type": "string"
          },
          "PageTitle": {
            "type": "string"
          },
          "Routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteInformation"
