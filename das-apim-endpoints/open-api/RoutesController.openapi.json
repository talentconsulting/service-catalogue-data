        "properties": {
          "Sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            }
          }
        }
      },
      "Section": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          },
          "Pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Page"
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          }
        }
      },
      "GetRoutingInformationForFormQueryResponse": {
        "type": "object",
        "properties": {
          "Sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            }
          },
          "Editable": {
            "type": "boolean"
          }
        }
      },
      "GetAvailableQuestionsForRoutingQueryResponse": {
        "type": "object",
        "properties": {
          "Questions": {
            "type": "array",
