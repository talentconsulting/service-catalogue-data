{
  "openapi": "3.1.0",
  "info": {
    "title": "Routes API",
    "description": "API for FormBuilder Routes Management",
    "version": "1.0.0"
  },
  "paths": {
    "/api/routes/forms/{formVersionId}/available-sections": {
      "get": {
        "summary": "List available sections and pages for a Form version",
        "operationId": "getAvailableSectionsAndPagesForRouting",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAvailableSectionsAndPagesForRoutingQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/routes/forms/{formVersionId}": {
      "get": {
        "summary": "Get routing information for a Form version",
        "operationId": "getRoutesByFormVersionId",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRoutingInformationForFormQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/routes/forms/{formVersionId}/sections/{sectionId}/pages/{pageId}/available-questions": {
      "get": {
        "summary": "List available questions for routing on a page",
        "operationId": "getAvailableQuestionsForRouting",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAvailableQuestionsForRoutingQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/routes/forms/{formVersionId}/sections/{sectionId}/pages/{pageId}/questions/{questionId}": {
      "get": {
        "summary": "Get routing information for a specific question",
        "operationId": "getQuestionRoutingInformation",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRoutingInformationForQuestionQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Configure routing for a specific question",
        "operationId": "configureRoutingForQuestion",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigureRoutingForQuestionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRoutingInformationForQuestionQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete routing for a specific question",
        "operationId": "deleteRouteAsync",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "pageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Route": {
        "type": "object",
        "properties": {
          "OptionId": {
            "type": "string",
            "format": "uuid"
          },
          "NextSectionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "NextPageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "EndForm": {
            "type": "boolean"
          },
          "EndSection": {
            "type": "boolean"
          }
        }
      },
      "ConfigureRoutingForQuestionCommand": {
        "type": "object",
        "properties": {
          "FormVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "SectionId": {
            "type": "string",
            "format": "uuid"
          },
          "PageId": {
            "type": "string",
            "format": "uuid"
          },
          "QuestionId": {
            "type": "string",
            "format": "uuid"
          },
          "Routes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Route"
            }
          }
        }
      },
      "EmptyResponse": {
        "type": "object"
      },
      "GetAvailableSectionsAndPagesForRoutingQueryResponse": {
