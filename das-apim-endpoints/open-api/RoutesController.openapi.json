          "SourceQuestionId": {
            "type": "string",
            "format": "uuid"
          },
          "NextPageId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "NextSectionId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "OptionId": {
            "type": "string",
            "format": "uuid"
          },
          "EndSection": {
            "type": "boolean"
