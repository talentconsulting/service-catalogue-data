{
  "openapi": "3.1.0",
  "info": {
    "title": "Apim Developer Products API",
    "version": "1.0.0",
    "description": "API for managing Apim Developer products."
  },
  "paths": {
    "/Products/{id}": {
      "get": {
        "operationId": "GetApiProduct",
        "summary": "Retrieve details of an API product.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the API product."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with product details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductApiResponseItem"
                }
              }
            }
          },
          "404": {
            "description": "API product not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductApiResponseItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "price": {
            "type": "number",
            "format": "float"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
