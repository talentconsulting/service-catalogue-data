{
  "openapi": "3.1.0",
  "info": {
    "title": "API for managing products",
    "version": "1.0.0"
  },
  "paths": {
    "/Products/{id}": {
      "get": {
        "summary": "Retrieve details of an API product",
        "operationId": "getApiProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The identifier of the API product to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the API product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductApiResponseItem"
                }
              }
            }
          },
          "404": {
            "description": "API product not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductApiResponseItem": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
