{
  "openapi": "3.1.0",
  "info": {
    "title": "ApimDeveloper API",
    "version": "1.0.0"
  },
  "paths": {
    "/Products/{id}": {
      "get": {
        "summary": "Get API Product",
        "description": "Fetches the product details by ID",
        "operationId": "GetApiProduct",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique identifier for the API Product"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched the product",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductApiResponseItem"
                }
              }
            }
          },
          "404": {
            "description": "Product not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProductApiResponseItem": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "Name of the product"
          },
          "Description": {
            "type": "string",
            "description": "Detailed description of the product"
          },
          "Url": {
            "type": "string",
            "description": "URL of the product"
          }
        }
      }
    }
  }
}
