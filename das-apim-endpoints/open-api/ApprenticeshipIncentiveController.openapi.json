{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{accountId}/legalentities/{accountLegalEntityId}/apprenticeshipIncentives": {
      "get": {
        "summary": "Get Apprenticeship Incentives",
        "tags": [
          "Apprenticeship Incentives"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved apprenticeship incentives",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeshipIncentiveDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/earningsRecalculations": {
      "post": {
        "summary": "Recalculate Earnings",
        "tags": [
          "Earnings Recalculations"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecalculateEarningsRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Earnings successfully recalculated"
          },
          "400": {
            "description": "Bad Request - Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipIncentiveDto": {
        "type": "object",
        "additionalProperties": true
      },
      "RecalculateEarningsRequest": {
        "type": "object",
        "properties": {
          "IncentiveLearnerIdentifiers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IncentiveLearnerIdentifierDto"
            }
          }
        },
        "required": [
          "IncentiveLearnerIdentifiers"
        ]
      },
      "IncentiveLearnerIdentifierDto": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ULN": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "AccountLegalEntityId",
          "ULN"
        ]
      }
    }
  }
}
