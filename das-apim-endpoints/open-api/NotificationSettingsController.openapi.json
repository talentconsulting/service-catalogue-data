{
  "openapi": "3.1.0",
  "info": {
    "title": "Notification Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/notification-settings": {
      "get": {
        "summary": "Get Notification Settings",
        "operationId": "getNotificationSettings",
        "parameters": [
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "description": "The unique identifier of the member.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Notification settings successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationsSettingsQueryResult"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update Notification Settings",
        "operationId": "updateNotificationSettings",
        "parameters": [
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "description": "The unique identifier of the member.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettingsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Notification settings successfully updated."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetNotificationsSettingsQueryResult": {
        "type": "object",
        "properties": {
          "receiveNotifications": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates if the member has opted to receive notifications."
          }
        }
      },
      "NotificationSettingsPostRequest": {
        "type": "object",
        "properties": {
          "receiveNotifications": {
            "type": "boolean",
            "description": "The member's preference for receiving notifications."
          }
        },
        "required": [
          "receiveNotifications"
        ]
      }
    }
  }
}
