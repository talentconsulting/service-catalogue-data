{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Aan Notification Settings API",
    "version": "1.0.0"
  },
  "paths": {
    "/notification-settings": {
      "get": {
        "summary": "Get Notification Settings",
        "operationId": "GetNotificationSettings",
        "parameters": [
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetNotificationsSettingsQueryResult"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update Notification Settings",
        "operationId": "UpdateNotificationSettings",
        "parameters": [
          {
            "name": "memberId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSettingsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetNotificationsSettingsQueryResult": {
        "type": "object",
        "properties": {
          "ReceiveNotifications": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "NotificationSettingsPostRequest": {
        "type": "object",
        "properties": {
          "ReceiveNotifications": {
            "type": "boolean"
          }
        },
        "required": [
          "ReceiveNotifications"
        ]
      }
    }
  }
}
