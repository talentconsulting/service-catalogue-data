{
  "openapi": "3.1.0",
  "info": {
    "title": "Funding Offers API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/funding-offers": {
      "get": {
        "summary": "Retrieve funding offers",
        "operationId": "GetFundingOffers",
        "responses": {
          "200": {
            "description": "Successful retrieval of funding offers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFundingOffersQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetFundingOffersQueryResponse": {
        "type": "object",
        "properties": {
          "offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FundingOffer"
            }
          }
        }
      },
      "FundingOffer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  }
}
