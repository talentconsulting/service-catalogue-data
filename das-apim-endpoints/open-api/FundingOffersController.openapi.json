{
  "openapi": "3.1.0",
  "info": {
    "title": "Funding Offers API",
    "version": "1.0.0",
    "description": "API for retrieving funding offers."
  },
  "paths": {
    "/api/funding-offers": {
      "get": {
        "operationId": "GetFundingOffers",
        "summary": "Retrieve a list of funding offers",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFundingOffersQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetFundingOffersQueryResponse": {
        "type": "object",
        "properties": {
          "Offers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FundingOffer"
            }
          }
        }
      },
      "FundingOffer": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          }
        }
      }
    }
  }
}
