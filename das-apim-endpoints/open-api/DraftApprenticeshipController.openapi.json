{
  "openapi": "3.1.0",
  "info": {
    "title": "DraftApprenticeship API",
    "version": "1.0.0"
  },
  "paths": {
    "/draftApprenticeship/{cohortId}": {
      "get": {
        "summary": "Get all draft apprenticeships for a cohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft apprenticeships retrieved successfully"
          },
          "404": {
            "description": "Cohort not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}/apprentices/{draftApprenticeshipId}/edit": {
      "get": {
        "summary": "Get draft apprenticeship details for editing (Employer view)",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft apprenticeship details retrieved successfully"
          },
          "404": {
            "description": "Draft apprenticeship not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/provider/{providerId}/unapproved/{cohortId}/apprentices/{draftApprenticeshipId}/edit": {
      "get": {
        "summary": "Get draft apprenticeship details for editing (Provider view)",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft apprenticeship details retrieved successfully"
          },
          "404": {
            "description": "Draft apprenticeship not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/cohorts/{cohortId}/draft-apprenticeships": {
      "post": {
        "summary": "Add a draft apprenticeship to a cohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "put": {
        "summary": "Update a draft apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship updated successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "CourseCode": {
            "type": "string"
          },
          "Cost": {
            "type": "integer",
            "format": "int32"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "FirstName",
          "LastName",
          "Email",
          "CourseCode"
        ]
      },
      "AddDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UpdateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "CourseCode": {
            "type": "string"
          },
          "Cost": {
            "type": "integer",
            "format": "int32"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "FirstName",
          "LastName",
          "Email",
          "CourseCode"
        ]
      }
    }
  }
}
