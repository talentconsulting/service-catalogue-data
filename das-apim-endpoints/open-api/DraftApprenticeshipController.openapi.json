{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship API",
    "version": "1.0.0",
    "description": "API for managing draft apprenticeships."
  },
  "paths": {
    "/DraftApprenticeship/{cohortId}": {
      "get": {
        "summary": "Get all Draft Apprenticeships in a cohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}/apprentices/{draftApprenticeshipId}/edit": {
      "get": {
        "summary": "Get details for editing a Draft Apprenticeship",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "courseCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}/apprentices/{draftApprenticeshipId}/view": {
      "get": {
        "summary": "Get view of a Draft Apprenticeship",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/cohorts/{cohortId}/draft-apprenticeships": {
      "post": {
        "summary": "Add a new Draft Apprenticeship to a cohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "put": {
        "summary": "Update an existing Draft Apprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship updated successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "IsOnFlexiPaymentPilot": {
            "type": "boolean"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "EndPointAssessmentPrice": {
            "type": "integer"
          },
          "LearnerDataId": {
            "type": "integer"
          }
        }
      },
      "AddDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer"
          }
        }
      },
      "UpdateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "CourseOption": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "EndPointAssessmentPrice": {
            "type": "integer"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          }
        }
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      }
    }
  }
}
