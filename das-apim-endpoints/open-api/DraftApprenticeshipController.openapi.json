{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship API",
    "version": "1.0.0",
    "description": "API endpoints for managing draft apprenticeships."
  },
  "paths": {
    "/DraftApprenticeship/{cohortId}": {
      "get": {
        "summary": "Get all draft apprenticeships by cohort ID",
        "operationId": "getAllDraftApprenticeships",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with draft apprenticeships.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}/apprentices/{draftApprenticeshipId}/edit": {
      "get": {
        "summary": "Get edit draft apprenticeship details",
        "operationId": "getEditDraftApprenticeship",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "draftApprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft Apprenticeship edit details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "404": {
            "description": "Not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/cohorts/{cohortId}/draft-apprenticeships": {
      "post": {
        "summary": "Add a new draft apprenticeship",
        "operationId": "addDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Draft apprenticeship created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddDraftApprenticeshipResponse"
                }
              }
            }
          }
        }
      }
    },
    "/cohorts/{cohortId}/draft-apprenticeships/{apprenticeshipId}": {
      "put": {
        "summary": "Update an existing draft apprenticeship",
        "operationId": "updateDraftApprenticeship",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftApprenticeshipRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeship updated."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          }
        }
      },
      "AddDraftApprenticeshipResponse": {
        "type": "object",
        "properties": {
          "DraftApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UpdateDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          }
        }
      }
    }
  }
}
