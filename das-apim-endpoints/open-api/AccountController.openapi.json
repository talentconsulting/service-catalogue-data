{
  "openapi": "3.1.0",
  "info": {
    "title": "Levy Transfer Matching API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{encodedAccountId}": {
      "get": {
        "summary": "Get account details",
        "operationId": "GetAccount",
        "parameters": [
          {
            "name": "encodedAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountDto": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
