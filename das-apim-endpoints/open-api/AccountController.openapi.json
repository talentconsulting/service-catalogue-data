{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{accountId}/legalentities": {
      "get": {
        "summary": "Get legal entities for an account",
        "operationId": "getLegalEntities",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AccountLegalEntityDto"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Add a legal entity to an account",
        "operationId": "addLegalEntity",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LegalEntityRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/accounts/{accountId}/legalentities/{accountLegalEntityId}": {
      "get": {
        "summary": "Get a legal entity by its ID",
        "operationId": "getLegalEntity",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountLegalEntityDto"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove a legal entity from an account",
        "operationId": "removeLegalEntity",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      },
      "patch": {
        "summary": "Sign an agreement for a legal entity",
        "operationId": "signAgreement",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignAgreementRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/accounts/{accountId}/legalentity/{accountLegalEntityId}/applications": {
      "get": {
        "summary": "Get applications for a legal entity",
        "operationId": "getApplications",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Application"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/accounts/{accountId}/legalentity/{accountLegalEntityId}/vrfcasestatus": {
      "put": {
        "summary": "Update VRF Case Status for a legal entity",
        "operationId": "updateVrfCaseStatus",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/plain": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/blockedpayments": {
      "patch": {
        "summary": "Block Account Legal Entity for Payments",
        "operationId": "blockAccountLegalEntityForPayments",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BlockAccountLegalEntityForPaymentsRequest"
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountLegalEntityDto": {
        "type": "object",
        "properties": {}
      },
      "LegalEntityRequest": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "OrganisationName": {
            "type": "string"
          }
        },
        "required": [
          "AccountLegalEntityId",
          "LegalEntityId",
          "OrganisationName"
        ]
      },
      "SignAgreementRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AgreementVersion": {
            "type": "integer"
          }
        },
        "required": [
          "AccountId",
          "AccountLegalEntityId",
          "LegalEntityName",
          "LegalEntityId",
          "AgreementVersion"
        ]
      },
      "Application": {
        "type": "object",
        "properties": {}
      },
      "BlockAccountLegalEntityForPaymentsRequest": {
        "type": "object",
        "properties": {
          "VendorBlocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VendorBlock"
            }
          },
          "ServiceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          }
        }
      },
      "VendorBlock": {
        "type": "object",
        "properties": {
          "VendorId": {
            "type": "string"
          },
          "VendorBlockEndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "string"
          },
          "DecisionReference": {
            "type": "string"
          },
          "TaskCreatedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
