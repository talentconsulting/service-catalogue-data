{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/ExitSurvey/": {
      "post": {
        "operationId": "CreateExitSurvey",
        "summary": "Create an exit survey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExitSurveyCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exit survey created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateExitSurveyResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateExitSurveyCommand": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the apprentice feedback target"
          },
          "AllowContact": {
            "type": "boolean",
            "description": "Indicates whether the user allows contact"
          },
          "AttributeIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32"
            },
            "description": "List of attribute IDs"
          },
          "PrimaryReason": {
            "type": "integer",
            "format": "int32",
            "description": "Primary reason for survey completion"
          }
        },
        "required": [
          "ApprenticeFeedbackTargetId",
          "AllowContact",
          "AttributeIds",
          "PrimaryReason"
        ]
      },
      "CreateExitSurveyResponse": {
        "type": "object",
        "properties": {
          "ApprenticeExitSurveyId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the created exit survey"
          }
        }
      }
    }
  }
}
