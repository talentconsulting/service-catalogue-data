        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved pages",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllPagesQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "tags": [
          "Pages"
        ],
        "summary": "Create a new page in a section",
