  "components": {
    "schemas": {
      "CreatePageCommand": {
        "type": "object",
        "properties": {
          "formVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "sectionId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "CreatePageCommandResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetAllPagesQueryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Page"
            }
          }
        }
      },
      "Page": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sectionId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      },
      "GetPageByIdQueryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sectionId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Question"
            }
          },
          "editable": {
            "type": "boolean"
          },
          "hasAssociatedRoutes": {
            "type": "boolean"
          }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "UpdatePageCommand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "formVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "sectionId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "EmptyResponse": {
        "type": "object",
        "description": "An empty response"
      }
    }
