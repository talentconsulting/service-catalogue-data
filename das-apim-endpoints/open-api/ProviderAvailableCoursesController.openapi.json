{
  "openapi": "3.1.0",
  "info": {
    "title": "ProviderAvailableCourses API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/courses-tobe-allowed": {
      "get": {
        "summary": "Get Provider Available Courses",
        "operationId": "GetProviderAvailableCourses",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "UKPRN of the provider"
          },
          {
            "name": "courseType",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            },
            "description": "Type of the course (e.g., Apprenticeship, ShortCourse)"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of available courses for the provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsModel"
                }
              }
            }
          }
        },
        "tags": [
          "ProviderAvailableCourses"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "RestrictedCourseDetailsModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "IsActiveAvailable": {
            "type": "boolean"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "IsCourseRestricted": {
            "type": "boolean"
          },
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        },
        "required": [
          "LarsCode",
          "IfateReferenceNumber",
          "CourseName",
          "Level",
          "Route",
          "LearningType",
          "CourseType",
          "IsActiveAvailable",
          "IsCourseRestricted",
          "Providers"
        ]
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "Ukprn",
          "ProviderName"
        ]
      }
    }
  }
}
