{
  "openapi": "3.1.0",
  "info": {
    "title": "Jobs API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/job": {
      "get": {
        "operationId": "GetJobByName",
        "summary": "Get job by name",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Name of the job to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetJobByNameQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetJobByNameQueryResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Enabled": {
            "type": "boolean"
          },
          "Status": {
            "type": "string"
          },
          "LastRunTime": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "Id",
          "Name",
          "Enabled",
          "Status"
        ]
      }
    }
  }
}
