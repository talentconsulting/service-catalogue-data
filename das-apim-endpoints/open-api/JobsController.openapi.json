{
  "openapi": "3.1.0",
  "info": {
    "title": "Jobs API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/job": {
      "get": {
        "summary": "Gets a job by name",
        "operationId": "GetJobByName",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "The name of the job",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job was found successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetJobByNameQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found."
          },
          "500": {
            "description": "An internal server error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetJobByNameQueryResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Enabled": {
            "type": "boolean"
          },
          "Status": {
            "type": "string"
          },
          "LastRunTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "Id",
          "Name",
          "Enabled",
          "Status"
        ]
      }
    }
  }
}
