{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS APIM Endpoints",
    "version": "1.0.0",
    "description": "An API for managing job-related data."
  },
  "paths": {
    "/api/job": {
      "get": {
        "operationId": "GetByNameAsync",
        "summary": "Retrieve job details by name",
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The name of the job to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetJobByNameQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Job not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetJobByNameQueryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "type": "string"
          },
          "lastRunTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "enabled",
          "status"
        ]
      }
    }
  }
}
