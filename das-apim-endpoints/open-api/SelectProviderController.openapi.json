{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "description": "API for managing Select Provider information",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountId}/unapproved/add/select-provider": {
      "get": {
        "summary": "Get Select Provider Information",
        "operationId": "getSelectProviderInformation",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The account ID"
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The legal entity ID associated with the account"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with Select Provider data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSelectProviderQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSelectProviderQueryResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "value": {
            "type": "object",
            "properties": {
              "accountLegalEntityId": {
                "type": "integer",
                "format": "int64"
              }
            },
            "description": "Result object containing Select Provider data"
          }
        }
      }
    }
  }
}
