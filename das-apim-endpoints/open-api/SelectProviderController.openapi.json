{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0",
    "description": "API for handling operations related to provider selection."
  },
  "paths": {
    "/{accountId}/unapproved/add/select-provider": {
      "get": {
        "summary": "Retrieve Select Provider Information",
        "operationId": "GetSelectProviderInformation",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account."
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account legal entity."
          }
        ],
        "responses": {
          "200": {
            "description": "Select Provider information retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSelectProviderQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSelectProviderQueryResult": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the account legal entity."
          },
          "Providers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ProviderId": {
                  "type": "integer",
                  "format": "int64",
                  "description": "The ID of the provider."
                },
                "ProviderName": {
                  "type": "string",
                  "description": "The name of the provider."
                }
              }
            }
          }
        }
      }
    }
  }
}
