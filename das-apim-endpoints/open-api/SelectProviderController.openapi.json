{
  "openapi": "3.1.0",
  "info": {
    "title": "SelectProvider API",
    "version": "1.0.0",
    "description": "API to handle selecting provider functionality."
  },
  "paths": {
    "/{accountId}/unapproved/add/select-provider": {
      "get": {
        "summary": "Get Select Provider Information",
        "operationId": "GetSelectProviderInformation",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the account.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "description": "The ID of the account's legal entity.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Select Provider information returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSelectProviderQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "An internal server error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSelectProviderQueryResponse": {
        "type": "object",
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": true
          },
          "success": {
            "type": "boolean"
          },
          "errorMessage": {
            "type": "string",
            "nullable": true
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
