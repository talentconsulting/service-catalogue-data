{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign Redirect API",
    "version": "1.0.0"
  },
  "paths": {
    "/redirects/": {
      "get": {
        "summary": "Retrieve all redirects",
        "description": "Returns a list of redirects.",
        "operationId": "getRedirectsAsync",
        "parameters": [
          {
            "name": "cancellationToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Cancellation token for the request."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRedirectsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRedirectsResponse": {
        "type": "object",
        "properties": {
          "redirects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RedirectModel"
            }
          }
        }
      },
      "RedirectModel": {
        "type": "object",
        "properties": {
          "fromPath": {
            "type": "string",
            "description": "The source path of the redirect."
          },
          "toPath": {
            "type": "string",
            "description": "The target path of the redirect."
          },
          "matchType": {
            "type": "string",
            "description": "Type of the match, e.g., 'Exact' or 'Prefix'."
          },
          "permanent": {
            "type": "boolean",
            "description": "Indicates if the redirect is permanent."
          }
        },
        "required": [
          "fromPath",
          "toPath",
          "matchType",
          "permanent"
        ]
      }
    }
  }
}
