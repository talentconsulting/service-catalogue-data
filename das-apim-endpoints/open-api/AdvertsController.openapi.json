{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign Adverts API",
    "version": "1.0.0",
    "description": "API for fetching campaign adverts data."
  },
  "paths": {
    "/Adverts/": {
      "get": {
        "summary": "Get adverts",
        "description": "Fetches a list of adverts based on given parameters.",
        "operationId": "GetAdverts",
        "parameters": [
          {
            "name": "postCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distance",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdvertsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAdvertsResponse": {
        "type": "object",
        "properties": {
          "Adverts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Advert"
            }
          }
        }
      },
      "Advert": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Location": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          },
          "Route": {
            "type": "string"
          },
          "Distance": {
            "type": "integer",
            "format": "uint32"
          }
        }
      }
    }
  }
}
