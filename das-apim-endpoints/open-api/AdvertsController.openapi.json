{
  "openapi": "3.1.0",
  "info": {
    "title": "Adverts API",
    "version": "1.0.0",
    "description": "API for fetching adverts based on postcode, route, and distance."
  },
  "paths": {
    "/adverts": {
      "get": {
        "summary": "Get Adverts",
        "description": "Fetch a list of adverts filtered by postcode, route, and distance.",
        "operationId": "GetAdverts",
        "parameters": [
          {
            "name": "postCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The postcode to filter adverts."
          },
          {
            "name": "route",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The route to filter adverts."
          },
          {
            "name": "distance",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "The distance in kilometers to filter adverts."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of adverts matching the specified filters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdvertsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error. Unable to retrieve adverts."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAdvertsResponse": {
        "type": "object",
        "properties": {
          "adverts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "location": {
                  "$ref": "#/components/schemas/Address"
                },
                "route": {
                  "type": "string"
                },
                "distance": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            }
          }
        }
      },
      "Address": {
        "type": "object",
        "properties": {
          "addressLine1": {
            "type": "string"
          },
          "addressLine2": {
            "type": "string"
          },
          "addressLine3": {
            "type": "string"
          },
          "postcode": {
            "type": "string"
          },
          "latitude": {
            "type": "number",
            "format": "double"
          },
          "longitude": {
            "type": "number",
            "format": "double"
          }
        }
      }
    }
  }
}
