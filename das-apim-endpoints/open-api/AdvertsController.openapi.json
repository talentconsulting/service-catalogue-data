{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign Adverts API",
    "version": "1.0.0"
  },
  "paths": {
    "/adverts/": {
      "get": {
        "summary": "Get a list of adverts",
        "operationId": "GetAdverts",
        "parameters": [
          {
            "name": "postCode",
            "in": "query",
            "description": "Post code for filtering adverts",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "description": "Route for filtering adverts",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distance",
            "in": "query",
            "description": "Distance to filter adverts by",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of adverts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdvertsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAdvertsResponse": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    }
  }
}
