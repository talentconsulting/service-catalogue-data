{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Campaign API",
    "version": "1.0.0",
    "description": "API for retrieving adverts"
  },
  "paths": {
    "/Adverts/": {
      "get": {
        "summary": "Retrieve list of adverts",
        "operationId": "GetAdverts",
        "parameters": [
          {
            "name": "postCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distance",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of adverts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdvertsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAdvertsResponse": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
