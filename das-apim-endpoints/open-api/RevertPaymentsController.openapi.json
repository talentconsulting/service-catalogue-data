{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/revert-payments": {
      "post": {
        "operationId": "RevertPayments",
        "summary": "Revert payments",
        "description": "Allows reverting of specified payments.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevertPaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payments reverted successfully."
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errorContent": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "errorContent"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RevertPaymentsRequest": {
        "type": "object",
        "properties": {
          "payments": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "List of payment IDs to revert."
          },
          "serviceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          }
        },
        "required": [
          "payments",
          "serviceRequest"
        ]
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "ID of the related task."
          },
          "decisionReference": {
            "type": "string",
            "description": "Decision reference for the service request."
          },
          "taskCreatedDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date the task was created."
          }
        },
        "required": [
          "taskId",
          "decisionReference"
        ]
      }
    }
  }
}
