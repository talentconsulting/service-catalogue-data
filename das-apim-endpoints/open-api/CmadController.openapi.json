{
  "openapi": "3.1.0",
  "info": {
    "title": "Cmad API",
    "version": "1.0.0"
  },
  "paths": {
    "/registrations": {
      "get": {
        "summary": "Get registrations by account details",
        "parameters": [
          {
            "name": "firstName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateOfBirth",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with registrations data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {}
                }
              }
            }
          }
        }
      }
    },
    "/registrations/email/": {
      "get": {
        "summary": "Get registrations by email",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with registration data",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/revisionsById": {
      "get": {
        "summary": "Get revisions by ID",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "revisionId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with revision data",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/commitments-apprenticeships/{apprenticeshipId}": {
      "get": {
        "summary": "Get commitments apprenticeship by ID",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with apprenticeship data",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/apprenticeships": {
      "post": {
        "summary": "Create apprenticeship from registration",
        "parameters": [
          {
            "name": "registrationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "lastName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateOfBirth",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship successfully created"
          }
        }
      }
    },
    "/apprentices/{id}/MyApprenticeship": {
      "post": {
        "summary": "Create My Apprenticeship",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMyApprenticeshipData"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Response status indicating success or failure with optional error content",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateMyApprenticeshipData": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerName": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "TrainingProviderId": {
            "type": "integer",
            "format": "int32"
          },
          "TrainingProviderName": {
            "type": "string"
          },
          "TrainingCode": {
            "type": "string"
          },
          "StandardUId": {
            "type": "string"
          }
        },
        "required": [
          "Uln",
          "ApprenticeshipId",
          "EmployerName",
          "StartDate",
          "EndDate",
          "TrainingProviderId",
          "TrainingProviderName",
          "TrainingCode",
          "StandardUId"
        ]
      }
    }
  }
}
