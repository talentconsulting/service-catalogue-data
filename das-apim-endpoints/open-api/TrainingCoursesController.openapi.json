{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/standards": {
      "get": {
        "operationId": "GetStandards",
        "summary": "Retrieve available standards",
        "responses": {
          "200": {
            "description": "Standards retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/TrainingCourses/frameworks": {
      "get": {
        "operationId": "GetFrameworks",
        "summary": "Retrieve available frameworks",
        "responses": {
          "200": {
            "description": "Frameworks retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworksResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsResponse": {
        "type": "object",
        "properties": {
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandardResponse"
            }
          }
        },
        "required": [
          "Standards"
        ]
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Level": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "Id",
          "Name",
          "Level"
        ]
      },
      "GetFrameworksResponse": {
        "type": "object",
        "properties": {
          "Frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrameworkResponse"
            }
          }
        },
        "required": [
          "Frameworks"
        ]
      },
      "FrameworkResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Pathway": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Name",
          "Pathway"
        ]
      }
    }
  }
}
