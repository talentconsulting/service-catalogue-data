{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerFinance API",
    "version": "1.0.0"
  },
  "paths": {
    "/trainingcourses/standards": {
      "get": {
        "summary": "Get list of standards",
        "operationId": "GetStandards",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/trainingcourses/frameworks": {
      "get": {
        "summary": "Get list of frameworks",
        "operationId": "GetFrameworks",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFrameworksResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsResponse": {
        "type": "object",
        "properties": {
          "standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StandardResponse"
            }
          }
        },
        "required": [
          "standards"
        ]
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "duration": {
            "type": "integer"
          },
          "fundingCap": {
            "type": "integer"
          }
        }
      },
      "GetFrameworksResponse": {
        "type": "object",
        "properties": {
          "frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrameworkResponse"
            }
          }
        },
        "required": [
          "frameworks"
        ]
      },
      "FrameworkResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "level": {
            "type": "integer"
          },
          "pathway": {
            "type": "string"
          },
          "fundingCap": {
            "type": "integer"
          }
        }
      }
    }
  }
}
