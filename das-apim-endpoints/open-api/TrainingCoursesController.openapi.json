{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships API",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/standards/{courseCode}": {
      "get": {
        "operationId": "GetStandard",
        "summary": "Get details for a training course standard by course code",
        "parameters": [
          {
            "name": "courseCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The code of the course to retrieve details for"
          }
        ],
        "responses": {
          "200": {
            "description": "Standard retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardResponse": {
        "type": "object",
        "description": "Response model containing details about a training course standard",
        "properties": {}
      }
    }
  }
}
