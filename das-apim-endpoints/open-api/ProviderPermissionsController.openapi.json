{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Permissions API",
    "version": "1.0.0",
    "description": "API for managing provider permissions."
  },
  "paths": {
    "/ProviderPermissions/has-permission": {
      "get": {
        "summary": "Check if a provider has permission",
        "operationId": "hasPermission",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHasPermissionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ProviderPermissions/has-relationship-with-permission": {
      "get": {
        "summary": "Check if a provider has a relationship with permission",
        "operationId": "hasRelationshipWithPermission",
        "parameters": [
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHasRelationshipWithPermissionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ProviderPermissions/account-provider-legal-entities": {
      "get": {
        "summary": "Get account provider legal entities",
        "operationId": "accountProviderLegalEntities",
        "parameters": [
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetHasPermissionResponse": {
        "type": "object",
        "properties": {
          "HasPermission": {
            "type": "boolean"
          }
        }
      },
      "GetHasRelationshipWithPermissionResponse": {
        "type": "object",
        "properties": {
          "HasPermission": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
