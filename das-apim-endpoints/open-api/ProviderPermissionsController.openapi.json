{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Permissions API",
    "version": "1.0.0"
  },
  "paths": {
    "/ProviderPermissions/has-permission": {
      "get": {
        "summary": "Check if provider has specific permission",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Permission check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHasPermissionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ProviderPermissions/has-relationship-with-permission": {
      "get": {
        "summary": "Check if provider has relationship with permission",
        "parameters": [
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Relationship check result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetHasRelationshipWithPermissionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ProviderPermissions/account-provider-legal-entities": {
      "get": {
        "summary": "Get account provider legal entities for the specified UKPRN",
        "parameters": [
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account provider legal entities",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {}
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetHasPermissionResponse": {
        "type": "object",
        "properties": {
          "HasPermission": {
            "type": "boolean"
          }
        }
      },
      "GetHasRelationshipWithPermissionResponse": {
        "type": "object",
        "properties": {
          "HasPermission": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
