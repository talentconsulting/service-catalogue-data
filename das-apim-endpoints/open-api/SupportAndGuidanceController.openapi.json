{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Support and Guidance API",
    "version": "1.0.0",
    "description": "API for providing support and guidance to apprentices."
  },
  "paths": {
    "/supportguidance/categories/{contentType}": {
      "get": {
        "summary": "Get Categories",
        "description": "Returns categories based on content type.",
        "parameters": [
          {
            "name": "contentType",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/supportguidance/category/{categoryIdentifier}/articles/": {
      "get": {
        "summary": "Get Articles for Category",
        "description": "Returns all articles for a given category.",
        "parameters": [
          {
            "name": "categoryIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/supportguidance/category/{categoryIdentifier}/articles/{id}": {
      "get": {
        "summary": "Get Single Article for Category",
        "description": "Returns a specific article for a given category identified by ID.",
        "parameters": [
          {
            "name": "categoryIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/supportguidance/articles/{entryId}": {
      "get": {
        "summary": "Get Article by Entry ID",
        "description": "Returns an article by entry ID.",
        "parameters": [
          {
            "name": "entryId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/supportguidance/savedarticles/{id}": {
      "get": {
        "summary": "Get Saved Articles for Apprentice",
        "description": "Returns saved articles for a specific apprentice identified by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/apprentices/{id}/articles/{articleIdentifier}/title/{articleTitle}": {
      "post": {
        "summary": "Add or Update an Apprentice Article",
        "description": "Adds or updates an article associated with a specific apprentice.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "articleIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "articleTitle",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeArticleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/apprentices/{id}/removearticle/{articleIdentifier}": {
      "post": {
        "summary": "Remove an Article for Apprentice",
        "description": "Removes an article associated with a specific apprentice.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "articleIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeArticleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeArticleRequest": {
        "type": "object",
        "properties": {
          "IsSaved": {
            "type": "boolean",
            "nullable": true
          },
          "LikeStatus": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    }
  }
}
