{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "description": "API for managing employer incentives applications.",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{accountId}/applications": {
      "post": {
        "summary": "Create Application",
        "operationId": "createApplication",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Employer account ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Application created successfully.",
            "headers": {
              "Location": {
                "description": "URI of the created resource.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update Application",
        "operationId": "updateApplication",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Employer account ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "URI of the updated resource."
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Confirm Application",
        "operationId": "confirmApplication",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Employer account ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmApplicationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Application confirmed successfully."
          },
          "409": {
            "description": "Conflict: Application contains a ULN which has already been submitted."
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}": {
      "get": {
        "summary": "Get Application",
        "operationId": "getApplication",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Employer account ID."
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID."
          },
          {
            "name": "includeApprenticeships",
            "in": "query",
            "schema": {
              "type": "boolean"
            },
            "description": "Include apprenticeship details.",
            "required": false,
            "example": true
          }
        ],
        "responses": {
          "200": {
            "description": "Application retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}/bankingDetails/": {
      "get": {
        "summary": "Get Banking Details",
        "operationId": "getBankingDetails",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Employer account ID."
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID."
          },
          {
            "name": "hashedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hashed account ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Banking details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BankingDetailsDto"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}/accountlegalentity": {
      "get": {
        "summary": "Get Application Account Legal Entity",
        "operationId": "getApplicationAccountLegalEntity",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Employer account ID."
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Account legal entity retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{accountId}/applications/{applicationId}/apprenticeships": {
      "patch": {
        "summary": "Save Apprenticeship Details",
        "operationId": "saveApprenticeshipDetails",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Employer account ID."
          },
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Application ID."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeshipDetailsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprenticeship details saved successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateApplicationRequest": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeshipIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        "required": [
          "ApplicationId",
          "AccountId",
          "AccountLegalEntityId",
          "ApprenticeshipIds"
        ]
      },
      "UpdateApplicationRequest": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeshipIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          }
        },
        "required": [
          "ApplicationId",
          "AccountId",
          "ApprenticeshipIds"
        ]
      },
      "ConfirmApplicationRequest": {
        "type": "object",
        "properties": {
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "DateSubmitted": {
            "type": "string",
            "format": "date-time"
          },
          "SubmittedByEmail": {
            "type": "string",
            "format": "email"
          },
          "SubmittedByName": {
            "type": "string"
          }
        },
        "required": [
          "ApplicationId",
          "AccountId",
          "DateSubmitted",
          "SubmittedByEmail",
          "SubmittedByName"
        ]
      },
      "ApplicationResponse": {
        "type": "object",
        "properties": {
          "Application": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "BankingDetailsDto": {
        "type": "object",
        "additionalProperties": true
      },
      "ApprenticeshipDetailsRequest": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "ApplicationId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeshipDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeDetailsDto"
            }
          }
        },
        "required": [
          "AccountId",
          "ApplicationId",
          "ApprenticeshipDetails"
        ]
      },
      "ApprenticeDetailsDto": {
        "type": "object",
        "properties": {
          "ApprenticeId": {
            "type": "integer",
            "format": "int64"
          },
          "EmploymentStartDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "ApprenticeId",
          "EmploymentStartDate"
        ]
      }
    }
  }
}
