{
  "openapi": "3.1.0",
  "info": {
    "title": "FindAnApprenticeship API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship applications."
  },
  "paths": {
    "/applications/{applicationId}": {
      "get": {
        "summary": "Retrieve application index",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "candidateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application index retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationsApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/{applicationId}/{candidateId}/summary": {
      "get": {
        "summary": "Retrieve application summary",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application summary retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/{applicationId}/{candidateId}/view": {
      "get": {
        "summary": "View application details",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Application details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApplicationViewApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/{applicationId}/{candidateId}/status": {
      "post": {
        "summary": "Update application status",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationStatusModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Application status updated successfully"
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/{applicationId}/{candidateId}/work-history": {
      "post": {
        "summary": "Update application work history",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationWorkHistoryModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Application work history updated successfully"
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/{applicationId}/{candidateId}/training-courses": {
      "post": {
        "summary": "Update application training courses",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateApplicationTrainingCoursesModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Application training courses updated successfully"
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/applications/{applicationId}/{candidateId}/disability-confidence": {
      "post": {
        "summary": "Update disability confidence status",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDisabilityConfidenceModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Disability confidence status updated successfully"
          },
          "404": {
            "description": "Application not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApplicationsApiResponse": {
        "type": "object",
        "properties": {
          "applications": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Application"
            }
          }
        }
      },
      "Application": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Submitted",
              "Withdrawn",
              "Successful",
              "UnSuccessful",
              "Expired"
            ]
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateApplicationStatusModel": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Draft",
              "Submitted",
              "Withdrawn",
              "Successful",
              "UnSuccessful",
              "Expired"
            ]
          }
        }
      },
      "UpdateApplicationWorkHistoryModel": {
        "type": "object",
        "properties": {
          "workHistorySectionStatus": {
            "type": "string",
            "enum": [
              "Incomplete",
              "Completed"
            ]
          }
        }
      },
      "UpdateApplicationTrainingCoursesModel": {
        "type": "object",
        "properties": {
          "trainingCoursesSectionStatus": {
            "type": "string",
            "enum": [
              "Incomplete",
              "Completed"
            ]
          }
        }
      },
      "UpdateDisabilityConfidenceModel": {
        "type": "object",
        "properties": {
          "isSectionCompleted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
