{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0",
    "description": "API for managing Select Direct Connections in Approvals."
  },
  "paths": {
    "/{accountId}/unapproved/add/select-funding/select-direct-connection": {
      "get": {
        "summary": "Get Select Direct Connections",
        "operationId": "GetSelectDirectConnections",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The ID of the account."
          }
        ],
        "responses": {
          "200": {
            "description": "Select Direct Connections fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSelectDirectConnectionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error occurred."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSelectDirectConnectionResponse": {
        "type": "object",
        "description": "Response object containing Direct Connection data.",
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "description": "Direct Transfer Connection",
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
