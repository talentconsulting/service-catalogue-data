{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0",
    "description": "API for managing direct transfer connections for DAS approvals."
  },
  "paths": {
    "/{accountId}/unapproved/add/select-funding/select-direct-connection": {
      "get": {
        "operationId": "GetSelectDirectTransferConnection",
        "summary": "Retrieve direct transfer connections for a given account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "Account ID for which to retrieve direct transfer connections.",
            "schema": {
              "type": "integer",
              "example": 123456
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with direct transfer connections.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSelectDirectConnectionResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSelectDirectConnectionResponse": {
        "type": "object",
        "description": "Response payload for fetching direct transfer connections.",
        "properties": {
          "connections": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
