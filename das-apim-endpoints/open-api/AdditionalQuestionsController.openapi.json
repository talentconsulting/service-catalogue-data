{
  "openapi": "3.1.0",
  "info": {
    "title": "Find An Apprenticeship API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship applications."
  },
  "paths": {
    "/applications/{applicationId}/additionalQuestions": {
      "get": {
        "summary": "Retrieve additional question details for an application.",
        "operationId": "getAdditionalQuestion",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the application."
          },
          {
            "name": "candidateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the candidate."
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the additional question."
          },
          {
            "name": "additionalQuestion",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The index of the additional question in the application."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of question details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdditionalQuestionApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "The additional question was not found.",
            "content": {}
          },
          "500": {
            "description": "An error occurred during processing.",
            "content": {}
          }
        }
      },
      "post": {
        "summary": "Submit updated answer for an additional question in an application.",
        "operationId": "postAdditionalQuestion",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier of the application."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostAdditionalQuestionApiRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The additional question answer was successfully saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationResponse"
                }
              }
            }
          },
          "404": {
            "description": "The application could not be found.",
            "content": {}
          },
          "500": {
            "description": "An error occurred during processing.",
            "content": {}
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PostAdditionalQuestionApiRequest": {
        "type": "object",
        "properties": {
          "CandidateId": {
            "type": "string",
            "format": "uuid"
          },
          "Answer": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "UpdatedAdditionalQuestion": {
            "type": "integer"
          },
          "AdditionalQuestionSectionStatus": {
            "$ref": "#/components/schemas/SectionStatus"
          }
        },
        "required": [
          "CandidateId",
          "Answer",
          "Id",
          "UpdatedAdditionalQuestion",
          "AdditionalQuestionSectionStatus"
        ]
      },
      "GetAdditionalQuestionApiResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "QuestionText": {
            "type": "string"
          },
          "AnswerText": {
            "type": "string"
          },
          "AdditionalQuestionIndex": {
            "type": "integer"
          }
        },
        "required": [
          "Id",
          "QuestionText",
          "AnswerText",
          "AdditionalQuestionIndex"
        ]
      },
      "SectionStatus": {
        "type": "string",
        "enum": [
          "NotStarted",
          "InProgress",
          "Incomplete",
          "Completed",
          "NotRequired",
          "PreviousAnswer"
        ]
      },
      "ApplicationResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Application": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "Id",
          "Application"
        ]
      }
    }
  }
}
