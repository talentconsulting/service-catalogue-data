{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeAan API",
    "version": "1.0.0"
  },
  "paths": {
    "/CalendarEvents": {
      "get": {
        "summary": "Retrieve a list of calendar events",
        "operationId": "GetCalendarEvents",
        "parameters": [
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "FromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "ToDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "EventFormat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/EventFormat"
              }
            }
          },
          {
            "name": "CalendarId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "RegionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "Location",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "OrderBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved calendar events",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCalendarEventsQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/CalendarEvents/{calendarEventId}": {
      "get": {
        "summary": "Retrieve a specific calendar event by ID",
        "operationId": "GetCalendarEventById",
        "parameters": [
          {
            "name": "calendarEventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Calendar event found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEvent"
                }
              }
            }
          },
          "404": {
            "description": "Calendar event not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEvent"
                }
              }
            }
          }
        }
      }
    },
    "/CalendarEvents/{calendarEventId}/attendance": {
      "put": {
        "summary": "Update attendance for a calendar event",
        "operationId": "PutAttendance",
        "parameters": [
          {
            "name": "calendarEventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceStatus"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Attendance successfully updated"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventFormat": {
        "type": "string",
        "enum": [
          "InPerson",
          "Online",
          "Hybrid"
        ]
      },
      "GetCalendarEventsQueryResult": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          },
          "CalendarEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarEventSummary"
            }
          },
          "IsInvalidLocation": {
            "type": "boolean"
          },
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RegionData"
            }
          },
          "Calendars": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarType"
            }
          }
        }
      },
      "CalendarEvent": {
        "type": "object",
        "properties": {
          "CalendarEventId": {
            "type": "string",
            "format": "uuid"
          },
          "CalendarName": {
            "type": "string"
          },
          "EventFormat": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "RegionId": {
            "type": "integer"
          },
          "Location": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          },
          "Latitude": {
            "type": "number"
          },
          "Longitude": {
            "type": "number"
          },
          "EventLink": {
            "type": "string"
          },
          "ContactName": {
            "type": "string"
          },
          "ContactEmail": {
            "type": "string"
          },
          "IsActive": {
            "type": "boolean"
          },
          "CancelReason": {
            "type": "string"
          },
          "Attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attendee"
            }
          },
          "EventGuests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventGuest"
            }
          }
        }
      },
      "AttendanceStatus": {
        "type": "object",
        "properties": {}
      },
      "CalendarEventSummary": {
        "type": "object",
        "properties": {
          "CalendarEventId": {
            "type": "string",
            "format": "uuid"
          },
          "CalendarName": {
            "type": "string"
          },
          "EventFormat": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegionData": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Area": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer"
          }
        }
      },
      "CalendarType": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "CalendarName": {
            "type": "string"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "EffectiveTo": {
            "type": "string",
            "format": "date"
          },
          "Ordering": {
            "type": "integer"
          }
        }
      },
      "Attendee": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "UserType": {
            "type": "string"
          },
          "MemberName": {
            "type": "string"
          },
          "AddedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "EventGuest": {
        "type": "object",
        "properties": {
          "GuestName": {
            "type": "string"
          },
          "GuestJobTitle": {
            "type": "string"
          }
        }
      }
    }
  }
}
