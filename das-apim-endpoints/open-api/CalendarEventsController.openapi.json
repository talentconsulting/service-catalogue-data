{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeAan - CalendarEvents API",
    "version": "1.0.0"
  },
  "paths": {
    "/CalendarEvents": {
      "get": {
        "summary": "Retrieve calendar events",
        "operationId": "getCalendarEvents",
        "parameters": [
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Keyword",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "FromDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "ToDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "EventFormat",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "InPerson",
                  "Online",
                  "Hybrid"
                ]
              }
            }
          },
          {
            "name": "CalendarId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "RegionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer"
              }
            }
          },
          {
            "name": "Location",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Radius",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "OrderBy",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "PageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of calendar events.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCalendarEventsQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/CalendarEvents/{calendarEventId}": {
      "get": {
        "summary": "Retrieve a specific calendar event by ID",
        "operationId": "getCalendarEventById",
        "parameters": [
          {
            "name": "calendarEventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the calendar event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarEvent"
                }
              }
            }
          },
          "404": {
            "description": "Calendar event not found."
          }
        }
      }
    },
    "/CalendarEvents/{calendarEventId}/attendance": {
      "put": {
        "summary": "Update attendance for a calendar event",
        "operationId": "putAttendance",
        "parameters": [
          {
            "name": "calendarEventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "X-RequestedByMemberId",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttendanceStatus"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Attendance updated successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AttendanceStatus": {
        "type": "object",
        "additionalProperties": true
      },
      "GetCalendarEventsQueryResult": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          },
          "CalendarEvents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CalendarEvent"
            }
          },
          "IsInvalidLocation": {
            "type": "boolean"
          },
          "Regions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "integer"
                },
                "Area": {
                  "type": "string"
                },
                "Ordering": {
                  "type": "integer"
                }
              }
            }
          },
          "Calendars": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": {
                  "type": "integer"
                },
                "CalendarName": {
                  "type": "string"
                },
                "EffectiveFrom": {
                  "type": "string",
                  "format": "date-time"
                },
                "EffectiveTo": {
                  "type": "string",
                  "format": "date-time"
                },
                "Ordering": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "CalendarEvent": {
        "type": "object",
        "properties": {
          "CalendarEventId": {
            "type": "string",
            "format": "uuid"
          },
          "CalendarName": {
            "type": "string"
          },
          "EventFormat": {
            "type": "string",
            "enum": [
              "InPerson",
              "Online",
              "Hybrid"
            ]
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Summary": {
            "type": "string",
            "nullable": true
          },
          "RegionId": {
            "type": "integer",
            "nullable": true
          },
          "Location": {
            "type": "string",
            "nullable": true
          },
          "Postcode": {
            "type": "string",
            "nullable": true
          },
          "Latitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "Longitude": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "EventLink": {
            "type": "string",
            "nullable": true
          },
          "ContactName": {
            "type": "string"
          },
          "ContactEmail": {
            "type": "string"
          },
          "IsActive": {
            "type": "boolean"
          },
          "CancelReason": {
            "type": "string",
            "nullable": true
          },
          "Attendees": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Attendee"
            }
          },
          "EventGuests": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventGuest"
            }
          }
        }
      },
      "Attendee": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "UserType": {
            "type": "string"
          },
          "MemberName": {
            "type": "string"
          },
          "AddedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "EventGuest": {
        "type": "object",
        "properties": {
          "GuestName": {
            "type": "string"
          },
          "GuestJobTitle": {
            "type": "string"
          }
        }
      }
    }
  }
}
