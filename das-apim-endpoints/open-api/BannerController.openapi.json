{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.Campaign.Api",
    "version": "1.0.0"
  },
  "paths": {
    "/banner": {
      "get": {
        "operationId": "getBanner",
        "summary": "Retrieves banner content",
        "responses": {
          "200": {
            "description": "Successful response with banner data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBannerResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetBannerResponse": {
        "type": "object",
        "properties": {
          "banner": {
            "$ref": "#/components/schemas/BannerPageModel"
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "mainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageContent"
            }
          }
        }
      },
      "BannerPageContent": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "backgroundColour": {
            "type": "string"
          },
          "allowUserToHideTheBanner": {
            "type": "boolean"
          },
          "showOnTheHomepageOnly": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          },
          "tableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "embeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "videoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "videoName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
