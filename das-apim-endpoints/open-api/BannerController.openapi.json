{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Campaign API",
    "description": "API for managing campaign banners",
    "version": "1.0.0"
  },
  "paths": {
    "/banner": {
      "get": {
        "summary": "GetBannerAsync",
        "operationId": "GetBannerAsync",
        "tags": [
          "Banner"
        ],
        "responses": {
          "200": {
            "description": "The campaign banner data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBannerResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetBannerResponse": {
        "type": "object",
        "properties": {
          "Banner": {
            "$ref": "#/components/schemas/BannerPageModel"
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageContent"
            }
          }
        }
      },
      "BannerPageContent": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "BackgroundColour": {
            "type": "string"
          },
          "AllowUserToHideTheBanner": {
            "type": "boolean"
          },
          "ShowOnTheHomepageOnly": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        },
        "required": [
          "Items",
          "BackgroundColour",
          "AllowUserToHideTheBanner",
          "ShowOnTheHomepageOnly",
          "Title",
          "Id"
        ]
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "Values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Type": {
            "type": "string"
          },
          "TableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "EmbeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "VideoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "Url": {
            "type": "string"
          },
          "Size": {
            "type": "integer",
            "format": "int64"
          },
          "Description": {
            "type": "string"
          }
        },
        "required": [
          "Title",
          "Id",
          "FileName",
          "ContentType",
          "Url",
          "Size"
        ]
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "VideoName": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        },
        "required": [
          "VideoName",
          "Text"
        ]
      }
    }
  }
}
