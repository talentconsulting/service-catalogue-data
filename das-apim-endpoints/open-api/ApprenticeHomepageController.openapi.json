{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Portal API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{id}/homepage": {
      "get": {
        "operationId": "GetHomepageApprentice",
        "summary": "Get an apprentice's homepage data.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the apprentice."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the apprentice's homepage data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeHomepage"
                }
              }
            }
          },
          "404": {
            "description": "Apprentice not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeHomepage": {
        "type": "object",
        "properties": {
          "Apprentice": {
            "type": [
              "object",
              "null"
            ],
            "description": "Details about the apprentice. Null if apprentice does not exist."
          }
        }
      }
    }
  }
}
