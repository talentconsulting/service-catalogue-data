{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign API",
    "description": "API for managing articles in the campaign module.",
    "version": "1.0.0"
  },
  "paths": {
    "/article/{hub}/{slug}": {
      "get": {
        "summary": "Retrieve an article by hub and slug.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hub identifier"
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Slug identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with article details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetArticleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Article not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/article/preview/{hub}/{slug}": {
      "get": {
        "summary": "Retrieve a preview article by hub and slug.",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Hub identifier"
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Slug identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with preview article details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetArticleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview article not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetArticleResponse": {
        "type": "object",
        "properties": {
          "article": {
            "$ref": "#/components/schemas/CmsPageModel"
          }
        }
      },
      "CmsPageModel": {
        "type": "object",
        "properties": {
          "pageAttributes": {
            "$ref": "#/components/schemas/PageModel"
          },
          "mainContent": {
            "$ref": "#/components/schemas/PageContent"
          },
          "menuContent": {
            "$ref": "#/components/schemas/MenuPageModel_MenuPageContent"
          },
          "bannerModels": {
            "$ref": "#/components/schemas/BannerPageModel"
          },
          "tabbedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TabbedContentModel"
            }
          },
          "relatedArticles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageModel"
            }
          },
          "attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceItem"
            }
          }
        }
      },
      "PageModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "pageType": {
            "$ref": "#/components/schemas/PageType"
          },
          "title": {
            "type": "string"
          },
          "metaDescription": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "hubType": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "articleType": {
            "type": "string"
          }
        }
      },
      "PageType": {
        "type": "string",
        "enum": [
          "Unknown",
          "LandingPage",
          "Article",
          "Hub",
          "Tab"
        ]
      },
      "PageContent": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "headerImage": {
            "$ref": "#/components/schemas/ContentItem"
          }
        }
      },
      "MenuPageModel_MenuPageContent": {
        "type": "object",
        "properties": {
          "topLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "mainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageModel_BannerPageContent"
            }
          }
        }
      },
      "BannerPageModel_BannerPageContent": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "backgroundColour": {
            "type": "string"
          },
          "allowUserToHideTheBanner": {
            "type": "boolean"
          },
          "showOnTheHomepageOnly": {
            "type": "boolean"
          },
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "TabbedContentModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tabName": {
            "type": "string"
          },
          "tabTitle": {
            "type": "string"
          },
          "findTraineeship": {
            "type": "boolean"
          },
          "content": {
            "$ref": "#/components/schemas/CmsPageModel_PageContent"
          }
        }
      },
      "CmsPageModel_PageContent": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "headerImage": {
            "$ref": "#/components/schemas/ContentItem"
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          },
          "tableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "embeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "videoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "videoName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "hub": {
            "type": "string"
          },
          "pageType": {
            "type": "string"
          },
          "parentSlug": {
            "type": "string"
          }
        }
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
