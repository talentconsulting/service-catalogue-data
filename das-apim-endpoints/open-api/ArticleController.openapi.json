{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign API",
    "version": "1.0.0"
  },
  "paths": {
    "/Article/{hub}/{slug}": {
      "get": {
        "summary": "Get an article by hub and slug",
        "operationId": "getArticleByHubAndSlug",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Article retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetArticleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Article not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Article/preview/{hub}/{slug}": {
      "get": {
        "summary": "Preview an article by hub and slug",
        "operationId": "getPreviewArticle",
        "parameters": [
          {
            "name": "hub",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Preview article retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetArticleResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview article not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetArticleResponse": {
        "type": "object",
        "properties": {
          "Article": {
            "$ref": "#/components/schemas/CmsPageModel"
          }
        }
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          }
        }
      },
      "CmsPageModel": {
        "type": "object",
        "properties": {
          "PageAttributes": {
            "$ref": "#/components/schemas/PageModel"
          },
          "MainContent": {
            "$ref": "#/components/schemas/PageContent"
          },
          "MenuContent": {
            "$ref": "#/components/schemas/MenuPageModel_MenuPageContent"
          },
          "BannerModels": {
            "$ref": "#/components/schemas/BannerPageModel"
          },
          "TabbedContents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TabbedContentModel"
            }
          },
          "RelatedArticles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PageModel"
            }
          },
          "Attachments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResourceItem"
            }
          },
          "ParentPage": {
            "$ref": "#/components/schemas/PageModel"
          }
        }
      },
      "PageModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "PageType": {
            "type": "string",
            "enum": [
              "Unknown",
              "LandingPage",
              "Article",
              "Hub",
              "Tab"
            ]
          },
          "Title": {
            "type": "string"
          },
          "MetaDescription": {
            "type": "string"
          },
          "Slug": {
            "type": "string"
          },
          "HubType": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "ArticleType": {
            "type": "string"
          }
        }
      },
      "PageContent": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "HeaderImage": {
            "$ref": "#/components/schemas/ContentItem"
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "Values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Type": {
            "type": "string"
          },
          "TableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "EmbeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "VideoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "Url": {
            "type": "string"
          },
          "Size": {
            "type": "integer",
            "format": "int64"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "VideoName": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        }
      },
      "MenuPageModel_MenuPageContent": {
        "type": "object",
        "properties": {
          "TopLevel": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Apprentices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Employers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          },
          "Influencers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        }
      },
      "BannerPageModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BannerPageContent"
            }
          }
        }
      },
      "BannerPageContent": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "BackgroundColour": {
            "type": "string"
          },
          "AllowUserToHideTheBanner": {
            "type": "boolean"
          },
          "ShowOnTheHomepageOnly": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        }
      },
      "TabbedContentModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "TabName": {
            "type": "string"
          },
          "TabTitle": {
            "type": "string"
          },
          "FindTraineeship": {
            "type": "boolean"
          },
          "Content": {
            "$ref": "#/components/schemas/PageContent"
          }
        }
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "Slug": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Hub": {
            "type": "string"
          },
          "PageType": {
            "type": "string"
          },
          "ParentSlug": {
            "type": "string"
          }
        }
      }
    }
  }
}
