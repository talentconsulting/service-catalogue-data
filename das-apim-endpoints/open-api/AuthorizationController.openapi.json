{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.Approvals.Api",
    "version": "1.0.0"
  },
  "paths": {
    "/Authorization/{partyId}/can-access-cohort/{cohortId}": {
      "get": {
        "summary": "Checks if a party can access a cohort",
        "operationId": "CanAccessCohort",
        "parameters": [
          {
            "name": "partyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "party",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Party's cohort access information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCohortAccessResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/Authorization/{partyId}/can-access-apprenticeship/{apprenticeshipId}": {
      "get": {
        "summary": "Checks if a party can access an apprenticeship",
        "operationId": "CanAccessApprenticeship",
        "parameters": [
          {
            "name": "partyId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "party",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Party"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Party's apprenticeship access information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipAccessResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCohortAccessResponse": {
        "type": "object",
        "properties": {
          "HasCohortAccess": {
            "type": "boolean"
          }
        },
        "required": [
          "HasCohortAccess"
        ]
      },
      "GetApprenticeshipAccessResponse": {
        "type": "object",
        "properties": {
          "HasApprenticeshipAccess": {
            "type": "boolean"
          }
        },
        "required": [
          "HasApprenticeshipAccess"
        ]
      },
      "Party": {
        "type": "integer",
        "description": "Flag enum representing party types",
        "format": "int16",
        "enum": [
          0,
          1,
          2,
          4
        ]
      }
    }
  }
}
