{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Accounts API",
    "version": "1.0.0",
    "description": "API for managing employer accounts, including reservations."
  },
  "paths": {
    "/Reservation/{accountId}": {
      "get": {
        "summary": "Get Reservations",
        "operationId": "getReservations",
        "tags": [
          "Reservation"
        ],
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "description": "The ID of the employer account.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservations fetched successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetReservationsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetReservationsResponse": {
        "type": "object",
        "properties": {
          "reservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Reservation"
            }
          }
        }
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier of the reservation."
          },
          "accountId": {
            "type": "integer",
            "description": "The ID of the employer account.",
            "format": "int64"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time",
            "description": "The date when the reservation was created."
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "description": "The start date of the reservation."
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "description": "The expiry date of the reservation."
          },
          "course": {
            "$ref": "#/components/schemas/ReservationCourse"
          },
          "status": {
            "$ref": "#/components/schemas/ReservationStatus"
          },
          "accountLegalEntityId": {
            "type": "integer",
            "description": "The ID of the account legal entity.",
            "format": "int64"
          },
          "accountLegalEntityName": {
            "type": "string",
            "description": "The name of the account legal entity."
          }
        }
      },
      "ReservationCourse": {
        "type": "object",
        "properties": {
          "courseId": {
            "type": "string",
            "description": "The ID of the course associated with the reservation."
          },
          "title": {
            "type": "string",
            "description": "The title of the course."
          },
          "level": {
            "type": "string",
            "description": "The level of the course."
          }
        }
      },
      "ReservationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Confirmed",
          "Completed",
          "Deleted"
        ],
        "description": "The status of the reservation."
      }
    }
  }
}
