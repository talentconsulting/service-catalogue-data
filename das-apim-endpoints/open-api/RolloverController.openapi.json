{
  "openapi": "3.1.0",
  "info": {
    "title": "Rollover API",
    "version": "1.0.0",
    "description": "API to manage rollover functionality."
  },
  "paths": {
    "/api/rollover/workflowcandidatescount": {
      "get": {
        "summary": "Get Workflow Candidates Count",
        "operationId": "GetRolloverWorkflowCandidatesCount",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverWorkflowCandidatesCountQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/rollovercandidates": {
      "get": {
        "summary": "Get Rollover Candidates",
        "operationId": "GetRolloverCandidates",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverCandidatesQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/rolloverworkflowcandidates": {
      "get": {
        "summary": "Get Workflow Candidates",
        "operationId": "GetRolloverWorkflowCandidates",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverWorkflowCandidatesQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/rolloverworkflowruns": {
      "post": {
        "summary": "Create Workflow Run",
        "operationId": "CreateRolloverWorkflowRun",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRolloverWorkflowRunCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_CreateRolloverWorkflowRunCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/{rolloverWorkflowRunId}/rollovercandidatesforexport": {
      "get": {
        "summary": "Export Rollover Candidates",
        "operationId": "GetRolloverCandidatesForExport",
        "parameters": [
          {
            "name": "rolloverWorkflowRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverCandidatesForExportQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/validaterolloverextension": {
      "post": {
        "summary": "Validate Rollover Extension",
        "operationId": "ValidateRolloverExtension",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateRolloverExtensionCommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/submitrolloverextension": {
      "post": {
        "summary": "Submit Rollover Extension",
        "operationId": "SubmitRolloverExtension",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitRolloverExtensionCommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/removepreviousworkflowcandidates": {
      "post": {
        "summary": "Remove Previous Workflow Candidates",
        "operationId": "RemovePreviousWorkflowCandidates",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemovePreviousWorkflowCandidatesCommand"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovePreviousWorkflowCandidatesCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/rollover/startsummary": {
      "get": {
        "summary": "Get Rollover Start Summary",
        "operationId": "GetRolloverStartSummary",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverStartSummaryQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRolloverWorkflowCandidatesCountQueryResponse": {
        "type": "object",
        "properties": {
          "TotalRecords": {
            "type": "integer"
          }
        }
      },
      "GetRolloverCandidatesQueryResponse": {
        "type": "object",
        "properties": {
          "RolloverCandidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolloverCandidate"
            }
          }
        }
      },
      "RolloverCandidate": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationNumber": {
            "type": "string"
          },
          "QualificationName": {
            "type": "string"
          },
          "FundingOfferId": {
            "type": "string",
            "format": "uuid"
          },
          "FundingOfferName": {
            "type": "string"
          },
          "AcademicYear": {
            "type": "string"
          },
          "RolloverRound": {
            "type": "integer"
          },
          "PreviousFundingEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "NewFundingEndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetRolloverWorkflowCandidatesQueryResponse": {
        "type": "object",
        "properties": {
          "WorkflowRunId": {
            "type": "string",
            "format": "uuid"
          },
          "FundingEndDateEligibilityThreshold": {
            "type": "string",
            "format": "date-time"
          },
          "OperationalEndDateEligibilityThreshold": {
            "type": "string",
            "format": "date-time"
          },
          "MaximumApprovalFundingEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "RolloverWorkflowCandidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolloverWorkflowCandidate"
            }
          }
        }
      },
      "RolloverWorkflowCandidate": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "RolloverWorkflowRunId": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "FundingOfferId": {
            "type": "string",
            "format": "uuid"
          },
          "AcademicYear": {
            "type": "string"
          },
          "CurrentFundingEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "ProposedFundingEndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateRolloverWorkflowRunCommand": {
        "type": "object",
        "properties": {
          "AcademicYear": {
            "type": "string"
          },
          "SelectionMethod": {
            "type": "string",
            "enum": [
              "None",
              "QueryBuilder",
              "FileUpload",
              "Unknown"
            ]
          },
          "RolloverCandidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "FundingOfferIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "FundingEndDateEligibilityThreshold": {
            "type": "string",
            "format": "date-time"
          },
          "OperationalEndDateEligibilityThreshold": {
            "type": "string",
            "format": "date-time"
          },
          "MaximumApprovalFundingEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedByUserName": {
            "type": "string"
          }
        }
      },
      "BaseMediatrResponse_CreateRolloverWorkflowRunCommandResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "ErrorMessage": {
            "type": "string"
          },
          "ErrorCode": {
            "type": "string"
          },
          "Value": {
            "$ref": "#/components/schemas/CreateRolloverWorkflowRunCommandResponse"
          }
        }
      },
      "CreateRolloverWorkflowRunCommandResponse": {
        "type": "object",
        "properties": {
          "RolloverWorkflowRunId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetRolloverCandidatesForExportQueryResponse": {
        "type": "object",
        "properties": {
          "FileContent": {
            "type": "string",
            "format": "binary"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          }
        }
      },
      "ValidateRolloverExtensionCommandResponse": {
        "type": "object",
        "properties": {
          "IsValid": {
            "type": "boolean"
          },
          "ValidationFailureSummary": {
            "type": "object",
            "properties": {
              "FailedCandidateCount": {
                "type": "integer"
              },
              "GeneralFailureMessage": {
                "type": "string"
              }
            }
          },
          "ValidationSuccessSummary": {
            "type": "object",
            "properties": {
              "TotalCandidatesCount": {
                "type": "integer"
              },
              "CandidatesExtendedInUploadCount": {
                "type": "integer"
              }
            }
          }
        }
      },
      "SubmitRolloverExtensionCommandResponse": {
        "type": "object",
        "properties": {
          "ResultMessage": {
            "type": "string"
          }
        }
      },
      "RemovePreviousWorkflowCandidatesCommand": {
        "type": "object",
        "properties": {
          "RolloverWorkflowRunId": {
            "type": "string",
            "format": "uuid"
          },
          "CandidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "RemovePreviousWorkflowCandidatesCommandResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          }
        }
      },
      "GetRolloverStartSummaryQueryResponse": {
        "type": "object",
        "properties": {
          "TotalCandidatesCount": {
            "type": "integer"
          },
          "CandidatesEligibleCount": {
            "type": "integer"
          },
          "CandidatesRemainingCount": {
            "type": "integer"
          }
        }
      }
    }
  }
}
