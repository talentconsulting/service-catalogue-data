{
  "openapi": "3.1.0",
  "info": {
    "title": "Rollover API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/rollover/workflowcandidatescount": {
      "get": {
        "operationId": "getWorkflowCandidatesCount",
        "summary": "Get the count of rollover workflow candidates",
        "responses": {
          "200": {
            "description": "Successfully retrieved the count",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverWorkflowCandidatesCountQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/rollovercandidates": {
      "get": {
        "operationId": "getRolloverCandidates",
        "summary": "Retrieve rollover candidates",
        "responses": {
          "200": {
            "description": "Successfully retrieved rollover candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverCandidatesQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/rolloverworkflowcandidates": {
      "get": {
        "operationId": "getRolloverWorkflowCandidates",
        "summary": "Retrieve rollover workflow candidates",
        "responses": {
          "200": {
            "description": "Successfully retrieved workflow candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverWorkflowCandidatesQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/rolloverworkflowruns": {
      "post": {
        "operationId": "createRolloverWorkflowRun",
        "summary": "Create a rollover workflow run",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRolloverWorkflowRunCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created rollover workflow run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BaseMediatrResponse_CreateRolloverWorkflowRunCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/{rolloverWorkflowRunId}/rollovercandidatesforexport": {
      "get": {
        "operationId": "getRolloverCandidatesForExport",
        "summary": "Retrieve rollover candidates for export",
        "parameters": [
          {
            "name": "rolloverWorkflowRunId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved candidates for export",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverCandidatesForExportQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/validaterolloverextension": {
      "post": {
        "operationId": "validateRolloverExtension",
        "summary": "Validate rollover extension payload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateRolloverExtensionCommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/submitrolloverextension": {
      "post": {
        "operationId": "submitRolloverExtension",
        "summary": "Submit rollover extension payload",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "payload": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitRolloverExtensionCommandResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/removepreviousworkflowcandidates": {
      "post": {
        "operationId": "removePreviousWorkflowCandidates",
        "summary": "Remove previous workflow candidates",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemovePreviousWorkflowCandidatesCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully removed candidates",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemovePreviousWorkflowCandidatesCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/rollover/startsummary": {
      "get": {
        "operationId": "getStartSummary",
        "summary": "Retrieve rollover start summary",
        "responses": {
          "200": {
            "description": "Successfully retrieved summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRolloverStartSummaryQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRolloverWorkflowCandidatesCountQueryResponse": {
        "type": "object",
        "properties": {
          "TotalRecords": {
            "type": "integer"
          }
        }
      },
      "GetRolloverCandidatesQueryResponse": {
        "type": "object",
        "properties": {
          "RolloverCandidates": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolloverCandidate"
            }
          }
        }
      },
      "RolloverCandidate": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "QualificationNumber": {
            "type": "string"
          },
          "QualificationName": {
            "type": "string"
          },
          "FundingOfferId": {
            "type": "string",
            "format": "uuid"
          },
          "AcademicYear": {
            "type": "string"
          },
          "RolloverRound": {
            "type": "integer"
          },
          "PreviousFundingEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "NewFundingEndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BaseMediatrResponse_CreateRolloverWorkflowRunCommandResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "ErrorMessage": {
            "type": "string"
          },
          "ErrorCode": {
            "type": "string"
          },
          "Value": {
            "$ref": "#/components/schemas/CreateRolloverWorkflowRunCommandResponse"
          }
        }
      },
      "CreateRolloverWorkflowRunCommandResponse": {
        "type": "object",
        "properties": {
          "RolloverWorkflowRunId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateRolloverWorkflowRunCommand": {
        "type": "object",
        "properties": {
          "AcademicYear": {
            "type": "string"
          },
          "SelectionMethod": {
            "type": "string"
          },
          "RolloverCandidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "FundingOfferIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "FundingEndDateEligibilityThreshold": {
            "type": "string",
            "format": "date-time"
          },
          "OperationalEndDateEligibilityThreshold": {
            "type": "string",
            "format": "date-time"
          },
          "MaximumApprovalFundingEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "CreatedByUserName": {
            "type": "string"
          }
        }
      },
      "GetRolloverCandidatesForExportQueryResponse": {
        "type": "object",
        "properties": {
          "FileContent": {
            "type": "string",
            "format": "binary"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          }
        }
      },
      "ValidateRolloverExtensionCommandResponse": {
        "type": "object",
        "properties": {
          "IsValid": {
            "type": "boolean"
          },
          "ValidationFailureSummary": {
            "$ref": "#/components/schemas/ValidationFailureSummary"
          },
          "ValidationSuccessSummary": {
            "$ref": "#/components/schemas/FundingExtensionSummary"
          }
        }
      },
      "ValidationFailureSummary": {
        "type": "object",
        "properties": {
          "FailedCandidateCount": {
            "type": "integer"
          },
          "ValidatedCandidateFile": {
            "type": "string",
            "format": "binary"
          },
          "GeneralFailureMessage": {
            "type": "string"
          },
          "NotIncludedInRollover": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CandidateNotIncludedInRollover"
            }
          }
        }
      },
      "FundingExtensionSummary": {
        "type": "object",
        "properties": {
          "TotalCandidatesCount": {
            "type": "integer"
          },
          "CandidatesExtendedInUploadCount": {
            "type": "integer"
          },
          "TotalCandidatesToBeExtendedCount": {
            "type": "integer"
          },
          "TotalCandidatesToBeExcludedCount": {
            "type": "integer"
          },
          "TotalCandidatesToBeReviewedCount": {
            "type": "integer"
          }
        }
      },
      "CandidateNotIncludedInRollover": {
        "type": "object",
        "properties": {
          "Qan": {
            "type": "string"
          },
          "FundingStream": {
            "type": "string"
          },
          "Errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SubmitRolloverExtensionCommandResponse": {
        "type": "object",
        "properties": {
          "ResultMessage": {
            "type": "string"
          }
        }
      },
      "RemovePreviousWorkflowCandidatesCommand": {
        "type": "object",
        "properties": {
          "RolloverWorkflowRunId": {
            "type": "string",
            "format": "uuid"
          },
          "CandidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "RemovePreviousWorkflowCandidatesCommandResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          }
        }
      },
      "GetRolloverStartSummaryQueryResponse": {
        "type": "object",
        "properties": {
          "TotalCandidatesCount": {
            "type": "integer"
          },
          "CandidatesEligibleCount": {
            "type": "integer"
          },
          "CandidatesIneligibleCount": {
            "type": "integer"
          },
          "CandidatesRemainingCount": {
            "type": "integer"
          }
        }
      }
    }
  }
}
