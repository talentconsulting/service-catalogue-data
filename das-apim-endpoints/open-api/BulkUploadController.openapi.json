{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals Bulk Upload API",
    "version": "1.0.0"
  },
  "paths": {
    "/BulkUpload/Validate": {
      "post": {
        "summary": "Validate Bulk Upload Records",
        "operationId": "validateBulkUploadRecords",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadValidateApimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation successful",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/BulkUpload/AddAndApprove": {
      "post": {
        "summary": "Add and Approve Draft Apprenticeships",
        "operationId": "addAndApproveDraftApprenticeships",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddAndApproveDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships added and approved successfully",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Draft apprenticeships not found"
          }
        }
      }
    },
    "/BulkUpload/Add": {
      "post": {
        "summary": "Add Draft Apprenticeships",
        "operationId": "addDraftApprenticeships",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships added successfully",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Draft apprenticeships not found"
          }
        }
      }
    },
    "/BulkUpload/logs": {
      "post": {
        "summary": "Add a Bulk Upload Log",
        "operationId": "addBulkUploadLog",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk upload log added successfully",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/BulkUpload/logs/{logId}/error": {
      "put": {
        "summary": "Update Bulk Upload Log with Error Content",
        "operationId": "updateBulkUploadLogWithError",
        "parameters": [
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadLogUpdateWithErrorContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk upload log updated successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkUploadValidateApimRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CsvRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId"
        ]
      },
      "BulkUploadAddAndApproveDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FileUploadLogId": {
            "type": "integer",
            "format": "int64"
          },
          "BulkUploadAddAndApproveDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId"
        ]
      },
      "BulkUploadAddDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FileUploadLogId": {
            "type": "integer",
            "format": "int64"
          },
          "BulkUploadDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId"
        ]
      },
      "BulkUploadAddLogRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FileName": {
            "type": "string"
          },
          "RplCount": {
            "type": "integer",
            "format": "int32"
          },
          "RowCount": {
            "type": "integer",
            "format": "int32"
          },
          "FileContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "FileName",
          "FileContent"
        ]
      },
      "BulkUploadLogUpdateWithErrorContentRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "ErrorContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "ErrorContent"
        ]
      },
      "BulkUploadAddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "EndDateAsString": {
            "type": "string",
            "format": "date"
          },
          "CostAsString": {
            "type": "string"
          },
          "RowNumber": {
            "type": "integer",
            "format": "int32"
          },
          "ProviderRef": {
            "type": "string"
          },
          "Uln": {
            "type": "string"
          },
          "DateOfBirthAsString": {
            "type": "string",
            "format": "date"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "LastName": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "EPAOrgId": {
            "type": "string"
          },
          "StartDateAsString": {
            "type": "string",
            "format": "date"
          },
          "CourseCode": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "AgreementId": {
            "type": "string"
          },
          "LegalEntityId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "ProviderId",
          "RowNumber",
          "Uln",
          "StartDateAsString",
          "CourseCode",
          "FirstName",
          "LastName"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId"
        ]
      }
    }
  }
}
