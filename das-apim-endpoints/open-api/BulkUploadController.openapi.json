{
  "openapi": "3.1.0",
  "info": {
    "title": "Bulk Upload API",
    "version": "1.0.0"
  },
  "paths": {
    "/BulkUpload/Validate": {
      "post": {
        "operationId": "ValidateBulkUpload",
        "summary": "Validates bulk upload records.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadValidateApimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation results returned successfully."
          }
        }
      }
    },
    "/BulkUpload/AddAndApprove": {
      "post": {
        "operationId": "AddAndApproveDraftApprenticeships",
        "summary": "Adds and approves draft apprenticeships from bulk upload.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddAndApproveDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships added and approved successfully."
          },
          "404": {
            "description": "Draft apprenticeships not found."
          }
        }
      }
    },
    "/BulkUpload/Add": {
      "post": {
        "operationId": "AddDraftApprenticeships",
        "summary": "Adds draft apprenticeships from bulk upload.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Draft apprenticeships added successfully."
          },
          "404": {
            "description": "Draft apprenticeships not found."
          }
        }
      }
    },
    "/BulkUpload/logs": {
      "post": {
        "operationId": "AddBulkUploadLog",
        "summary": "Adds a new bulk upload log.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk upload log added successfully."
          }
        }
      }
    },
    "/BulkUpload/logs/{logId}/error": {
      "put": {
        "operationId": "UpdateLogWithErrorContent",
        "summary": "Updates bulk upload log with error content.",
        "parameters": [
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Id of the log to update."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadLogUpdateWithErrorContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk upload log updated successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkUploadValidateApimRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "CsvRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "UserInfo"
        ]
      },
      "BulkUploadAddAndApproveDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FileUploadLogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadAddAndApproveDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "UserInfo"
        ]
      },
      "BulkUploadAddDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FileUploadLogId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "BulkUploadDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "UserInfo"
        ]
      },
      "BulkUploadAddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "ProviderRef": {
            "type": "string"
          },
          "Uln": {
            "type": "string"
          },
          "DateOfBirthAsString": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "StartDateAsString": {
            "type": "string"
          },
          "EndDateAsString": {
            "type": "string"
          },
          "CostAsString": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "ProviderRef",
          "Uln",
          "FirstName",
          "LastName",
          "ProviderId"
        ]
      },
      "BulkUploadAddLogRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FileName": {
            "type": "string"
          },
          "RplCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "RowCount": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "FileContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "FileName",
          "FileContent",
          "UserInfo"
        ]
      },
      "BulkUploadLogUpdateWithErrorContentRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "ErrorContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "ErrorContent",
          "UserInfo"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      }
    }
  }
}
