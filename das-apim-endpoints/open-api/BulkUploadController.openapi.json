{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/BulkUpload/Validate": {
      "post": {
        "summary": "Validate Bulk Upload Records",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadValidateApimRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation Result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/BulkUpload/AddAndApprove": {
      "post": {
        "summary": "Add and Approve Bulk Upload Draft Apprenticeships",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddAndApproveDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation Successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/BulkUpload/Add": {
      "post": {
        "summary": "Add Draft Apprenticeships",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation Successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/BulkUpload/logs": {
      "post": {
        "summary": "Add Bulk Upload Log",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadAddLogRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Log Added Successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/BulkUpload/logs/{logId}/error": {
      "put": {
        "summary": "Update Log With Error Content",
        "parameters": [
          {
            "name": "logId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkUploadLogUpdateWithErrorContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Log Updated Successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkUploadValidateApimRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CsvRecords": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId"
        ]
      },
      "BulkUploadAddAndApproveDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "FileUploadLogId": {
            "type": "integer",
            "nullable": true
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          },
          "BulkUploadAddAndApproveDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        },
        "required": [
          "ProviderId"
        ]
      },
      "BulkUploadAddDraftApprenticeshipsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "FileUploadLogId": {
            "type": "integer",
            "nullable": true
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          },
          "BulkUploadDraftApprenticeships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BulkUploadAddDraftApprenticeshipRequest"
            }
          }
        },
        "required": [
          "ProviderId"
        ]
      },
      "BulkUploadAddLogRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "FileName": {
            "type": "string"
          },
          "RplCount": {
            "type": "integer",
            "nullable": true
          },
          "RowCount": {
            "type": "integer",
            "nullable": true
          },
          "FileContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "FileName",
          "FileContent",
          "UserInfo"
        ]
      },
      "BulkUploadLogUpdateWithErrorContentRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "ErrorContent": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "ProviderId",
          "ErrorContent"
        ]
      },
      "BulkUploadAddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "AgreementId": {
            "type": "string",
            "nullable": true
          },
          "StartDateAsString": {
            "type": "string",
            "nullable": true
          },
          "EndDateAsString": {
            "type": "string",
            "nullable": true
          },
          "CostAsString": {
            "type": "string",
            "nullable": true
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "ReservationId": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "ProviderId",
          "FirstName",
          "LastName"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string",
            "nullable": true
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId",
          "UserEmail"
        ]
      }
    }
  }
}
