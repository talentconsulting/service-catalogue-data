{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Aan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Employers/{userRef}": {
      "get": {
        "summary": "Get Employer Member",
        "operationId": "GetEmployerMember",
        "parameters": [
          {
            "name": "userRef",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmployerMemberQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/Employers/{employerAccountId}/summary": {
      "get": {
        "summary": "Get Employer Member Summary",
        "operationId": "GetEmployerMemberSummary",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmployerMemberSummaryQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/Employers": {
      "post": {
        "summary": "Create Employer Member",
        "operationId": "CreateEmployerMember",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEmployerMemberCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateEmployerMemberCommandResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEmployerMemberCommand": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "JoinedDate": {
            "type": "string",
            "format": "date-time"
          },
          "RegionId": {
            "type": "integer",
            "nullable": true
          },
          "OrganisationName": {
            "type": "string",
            "nullable": true
          },
          "ProfileValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileValue"
            }
          },
          "MemberNotificationEventFormatValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberNotificationEventFormatValues"
            },
            "nullable": true
          },
          "MemberNotificationLocationValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberNotificationLocationValues"
            },
            "nullable": true
          },
          "ReceiveNotifications": {
            "type": "boolean"
          },
          "AccountId": {
            "type": "integer"
          },
          "UserRef": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "Email",
          "FirstName",
          "LastName",
          "JoinedDate",
          "ProfileValues",
          "ReceiveNotifications",
          "AccountId",
          "UserRef"
        ]
      },
      "ProfileValue": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Value": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Value"
        ]
      },
      "MemberNotificationEventFormatValues": {
        "type": "object",
        "properties": {
          "EventFormat": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer"
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        },
        "required": [
          "EventFormat",
          "Ordering",
          "ReceiveNotifications"
        ]
      },
      "MemberNotificationLocationValues": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Radius": {
            "type": "integer"
          },
          "Latitude": {
            "type": "number",
            "format": "double"
          },
          "Longitude": {
            "type": "number",
            "format": "double"
          }
        },
        "required": [
          "Name",
          "Radius",
          "Latitude",
          "Longitude"
        ]
      },
      "CreateEmployerMemberCommandResult": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "MemberId"
        ]
      },
      "GetEmployerMemberQueryResult": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "Status": {
            "type": "string"
          }
        },
        "required": [
          "MemberId",
          "Status"
        ]
      },
      "GetEmployerMemberSummaryQueryResult": {
        "type": "object",
        "properties": {
          "ActiveCount": {
            "type": "integer"
          },
          "Sectors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "ActiveCount",
          "Sectors"
        ]
      }
    }
  }
}
