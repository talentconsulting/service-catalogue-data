{
  "openapi": "3.1.0",
  "info": {
    "title": "Change History API",
    "description": "API for fetching change history details associated with apprenticeships, provider, and employer.",
    "version": "1.0.0"
  },
  "paths": {
    "/change-history/{apprenticeshipId}": {
      "get": {
        "summary": "Get Change History for an Apprenticeship",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetChangeHistoryQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/change-history/provider/{providerId}/apprentices/change-history": {
      "get": {
        "summary": "Get Change History for All Apprentices of a Provider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllChangeHistoryForProviderQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/change-history/employer/{accountId}/apprentices/change-history": {
      "get": {
        "summary": "Get Change History for an Employer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllChangeHistoryForEmployerQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetChangeHistoryQueryResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetAllChangeHistoryForProviderQueryResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetAllChangeHistoryForEmployerQueryResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
