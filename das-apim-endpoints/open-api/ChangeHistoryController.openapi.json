{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0",
    "description": "API for managing approvals change history"
  },
  "paths": {
    "/change-history/{apprenticeshipId}": {
      "get": {
        "summary": "Get Change History for an Apprenticeship",
        "operationId": "GetChangeHistory",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/change-history/provider/{providerId}/apprentices/change-history": {
      "get": {
        "summary": "Get Change History for All Apprentices of a Provider",
        "operationId": "GetChangeHistoryForAllLearnersOfProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/change-history/employer/{accountId}/apprentices/change-history": {
      "get": {
        "summary": "Get Change History for Employer's Apprentices",
        "operationId": "GetChangeHistoryForEmployer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
