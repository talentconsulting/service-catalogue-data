{
  "openapi": "3.1.0",
  "info": {
    "title": "Change History API",
    "version": "1.0.0",
    "description": "API for accessing apprenticeship change history."
  },
  "paths": {
    "/change-history/{apprenticeshipId}": {
      "get": {
        "summary": "Get Change History",
        "description": "Retrieves the change history for a given apprenticeship.",
        "parameters": [
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the apprenticeship."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/change-history/provider/{providerId}/apprentices/change-history": {
      "get": {
        "summary": "Get Change History for All Learners of Provider",
        "description": "Retrieves the change history for all apprentices for a specified provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/change-history/employer/{accountId}/apprentices/change-history": {
      "get": {
        "summary": "Get Change History for Employer",
        "description": "Retrieves the change history for all apprentices of a specified employer account.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the employer account."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved change history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeHistoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeHistoryResponse": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Change"
            }
          }
        }
      },
      "Change": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time of the change."
          },
          "description": {
            "type": "string",
            "description": "Details of the change."
          }
        }
      }
    }
  }
}
