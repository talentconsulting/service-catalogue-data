{
  "openapi": "3.1.0",
  "info": {
    "title": "Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/Courses/": {
      "get": {
        "summary": "Retrieve a list of training courses",
        "operationId": "GetList",
        "responses": {
          "200": {
            "description": "Successfully retrieved the list of courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/Courses/{id}": {
      "get": {
        "summary": "Retrieve details for a specific course",
        "operationId": "GetCourseById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the course",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/Courses/{id}/epaos": {
      "get": {
        "summary": "Retrieve the EPAOs for a specific course",
        "operationId": "GetCourseEpaos",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the course",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the EPAOs for the course",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseEpaoListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/Courses/{id}/epaos/{epaoId}": {
      "get": {
        "summary": "Retrieve details of a specific epao for a course",
        "operationId": "GetCourseEpao",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the course",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "epaoId",
            "in": "path",
            "required": true,
            "description": "ID of the EPAO",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the EPAO details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseEpaoResponse"
                }
              }
            }
          },
          "404": {
            "description": "EPAO not found"
          },
          "400": {
            "description": "Validation error or bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCourseListResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseListItem"
            }
          }
        }
      },
      "GetCourseListItem": {
        "type": "object",
        "additionalProperties": true
      },
      "GetCourseResponse": {
        "type": "object",
        "properties": {
          "Course": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "GetCourseEpaoListResponse": {
        "type": "object",
        "properties": {
          "Course": {
            "type": "object",
            "additionalProperties": true
          },
          "Epaos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseEpaoListItem"
            }
          }
        }
      },
      "GetCourseEpaoListItem": {
        "type": "object",
        "additionalProperties": true
      },
      "GetCourseEpaoResponse": {
        "type": "object",
        "properties": {
          "Course": {
            "type": "object",
            "additionalProperties": true
          },
          "StandardVersions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "Epao": {
            "type": "object",
            "additionalProperties": true
          },
          "CourseEpaosCount": {
            "type": "integer"
          },
          "EffectiveFrom": {
            "type": "string",
            "format": "date-time"
          },
          "EpaoDeliveryAreas": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "DeliveryAreas": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDeliveryAreaListItem"
            }
          },
          "AllCourses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetAllCoursesListItem"
            }
          }
        }
      },
      "GetDeliveryAreaListItem": {
        "type": "object",
        "additionalProperties": true
      },
      "GetAllCoursesListItem": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
