{
  "openapi": "3.1.0",
  "info": {
    "title": "Employment Check API",
    "version": "1.0.0",
    "description": "API for employment checks."
  },
  "paths": {
    "/api/EmploymentCheck/RegisterCheck": {
      "post": {
        "summary": "Registers an employment check",
        "operationId": "RegisterCheck",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterCheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpContentError"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpContentError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterCheckRequest": {
        "type": "object",
        "properties": {
          "CorrelationId": {
            "type": "string",
            "format": "uuid",
            "description": "The correlation identifier of the check."
          },
          "CheckType": {
            "type": "string",
            "description": "The type of check being performed."
          },
          "Uln": {
            "type": "integer",
            "format": "int64",
            "description": "The unique learner number."
          },
          "ApprenticeshipAccountId": {
            "type": "integer",
            "format": "int32",
            "description": "The apprenticeship account ID."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "The apprenticeship ID.",
            "nullable": true
          },
          "MinDate": {
            "type": "string",
            "format": "date-time",
            "description": "The minimum date for the check."
          },
          "MaxDate": {
            "type": "string",
            "format": "date-time",
            "description": "The maximum date for the check."
          }
        },
        "required": [
          "CorrelationId",
          "CheckType",
          "Uln",
          "ApprenticeshipAccountId",
          "MinDate",
          "MaxDate"
        ]
      },
      "RegisterCheckResponse": {
        "type": "object",
        "description": "Response for RegisterCheck endpoint.",
        "properties": {}
      },
      "HttpContentError": {
        "type": "object",
        "description": "Error response returned by the API.",
        "properties": {
          "StatusCode": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code."
          },
          "ErrorContent": {
            "type": "string",
            "description": "Detail of the error."
          }
        }
      }
    }
  }
}
