{
  "openapi": "3.1.0",
  "info": {
    "title": "Employment Check API",
    "version": "1.0.0",
    "description": "API for managing employment checks."
  },
  "paths": {
    "/employmentchecks/{correlationId}": {
      "put": {
        "summary": "Update Employment Check",
        "operationId": "UpdateCheck",
        "parameters": [
          {
            "name": "correlationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the employment check."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEmploymentCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employment check updated successfully."
          }
        }
      }
    },
    "/employmentchecks": {
      "post": {
        "summary": "Register Employment Check",
        "operationId": "RegisterCheck",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employment check registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterEmploymentCheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdateEmploymentCheckRequest": {
        "type": "object",
        "required": [
          "CorrelationId",
          "Result",
          "DateChecked"
        ],
        "properties": {
          "CorrelationId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the employment check."
          },
          "Result": {
            "type": "string",
            "description": "Result of the employment check."
          },
          "DateChecked": {
            "type": "string",
            "format": "date-time",
            "description": "Date the check was performed."
          }
        }
      },
      "RegisterCheckRequest": {
        "type": "object",
        "required": [
          "CorrelationId",
          "CheckType",
          "Uln",
          "ApprenticeshipAccountId",
          "MinDate",
          "MaxDate"
        ],
        "properties": {
          "CorrelationId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the employment check."
          },
          "CheckType": {
            "type": "string",
            "description": "Type of the check to be performed."
          },
          "Uln": {
            "type": "integer",
            "format": "int64",
            "description": "Unique learner number associated with the check."
          },
          "ApprenticeshipAccountId": {
            "type": "integer",
            "description": "Account ID associated with the apprenticeship."
          },
          "ApprenticeshipId": {
            "type": "integer",
            "description": "Optional ID of the apprenticeship."
          },
          "MinDate": {
            "type": "string",
            "format": "date",
            "description": "Earliest date covered by the employment check."
          },
          "MaxDate": {
            "type": "string",
            "format": "date",
            "description": "Latest date covered by the employment check."
          }
        }
      },
      "RegisterEmploymentCheckResponse": {
        "type": "object",
        "description": "Response data for registering an employment check.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Registration status."
          }
        }
      }
    }
  }
}
