{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeFeedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/Apprentice/{id}": {
      "get": {
        "summary": "Get apprentice feedback",
        "description": "Retrieves feedback for a specific apprentice by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier of the apprentice."
          }
        ],
        "responses": {
          "200": {
            "description": "Feedback successfully retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Apprentice not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
