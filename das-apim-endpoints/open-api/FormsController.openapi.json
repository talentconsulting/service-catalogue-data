        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        }
