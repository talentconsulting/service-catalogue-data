{
  "openapi": "3.1.0",
  "info": {
    "title": "Forms API",
    "description": "API for managing forms and their versions in the FormBuilder module.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/forms": {
      "get": {
        "summary": "Get all form versions",
        "operationId": "GetAllFormVersions",
        "responses": {
          "200": {
            "description": "Successful response with form versions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllFormVersionsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create a new form version",
        "operationId": "CreateFormVersion",
        "requestBody": {
          "description": "Details of the form version to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFormVersionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form version successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateFormVersionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/forms/{formVersionId}": {
      "get": {
        "summary": "Get a form version by ID",
        "operationId": "GetFormVersionById",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version details response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFormVersionByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "summary": "Update a form version by ID",
        "operationId": "UpdateFormVersion",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Updated form version details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFormVersionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form version successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Remove a form version by ID",
        "operationId": "DeleteFormVersion",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version successfully removed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/forms/{formVersionId}/publish": {
      "put": {
        "summary": "Publish a form version by ID",
        "operationId": "PublishFormVersion",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version successfully published",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/forms/{formVersionId}/unpublish": {
      "put": {
        "summary": "Unpublish a form version by ID",
        "operationId": "UnpublishFormVersion",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version successfully unpublished",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/forms/{formId}/new-version": {
      "put": {
        "summary": "Create a new draft version of a form",
        "operationId": "CreateDraftFormVersion",
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft form version successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/forms/{formId}/MoveUp": {
      "put": {
        "summary": "Move a form version up in order",
        "operationId": "MoveFormVersionUp",
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version order successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/forms/{formId}/MoveDown": {
      "put": {
        "summary": "Move a form version down in order",
        "operationId": "MoveFormVersionDown",
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version order successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllFormVersionsQueryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormVersion"
            }
          }
        }
      },
      "FormVersion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "formId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetFormVersionByIdQueryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "formId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "descriptionHTML": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            }
          }
        }
      },
      "Section": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string",
            "format": "uuid"
          },
          "order": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "CreateFormVersionCommand": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        },
        "required": [
          "title",
          "description",
          "order"
        ]
      },
      "CreateFormVersionCommandResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UpdateFormVersionCommand": {
        "type": "object",
        "properties": {
          "formVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        },
        "required": [
          "formVersionId",
          "name",
          "description",
          "order"
        ]
      },
      "EmptyResponse": {
        "type": "object"
      }
    }
  }
}
