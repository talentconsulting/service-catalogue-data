          "formId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          },
          "dateCreated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetFormVersionByIdQueryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "formId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": "string",
