{
  "openapi": "3.1.0",
  "info": {
    "title": "Forms API",
    "version": "1.0.0",
    "description": "API for managing form versions in the FormBuilder application."
  },
  "paths": {
    "/api/forms": {
      "get": {
        "summary": "Retrieve all form versions",
        "tags": [
          "Forms"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all form versions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllFormVersionsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "summary": "Create a new form version",
        "tags": [
          "Forms"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFormVersionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form version successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateFormVersionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formVersionId}": {
      "get": {
        "summary": "Retrieve a form version by ID",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the form version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFormVersionByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "summary": "Update a form version",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFormVersionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form version successfully updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formVersionId}/publish": {
      "put": {
        "summary": "Publish a form version",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version successfully published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formVersionId}/unpublish": {
      "put": {
        "summary": "Unpublish a form version",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version successfully unpublished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formId}/MoveUp": {
      "put": {
        "summary": "Move a form up in order",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form successfully moved up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formId}/MoveDown": {
      "put": {
        "summary": "Move a form down in order",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form successfully moved down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formId}/new-version": {
      "put": {
        "summary": "Create a draft form version",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft form version successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formId}": {
      "delete": {
        "summary": "Remove a form",
        "tags": [
          "Forms"
        ],
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form successfully removed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmptyResponse": {
        "type": "object"
      },
      "CreateFormVersionCommand": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          }
        }
      },
      "CreateFormVersionCommandResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetAllFormVersionsQueryResponse": {
        "type": "object",
        "properties": {
          "Data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormVersion"
            }
          }
        }
      },
      "FormVersion": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FormId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Version": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          },
          "DateCreated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetFormVersionByIdQueryResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FormId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Version": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "DescriptionHTML": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          },
          "Sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            }
          }
        }
      },
      "Section": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Key": {
            "type": "string",
            "format": "uuid"
          },
          "Order": {
            "type": "integer"
          },
          "Title": {
            "type": "string"
          }
        }
      },
      "UpdateFormVersionCommand": {
        "type": "object",
        "properties": {
          "FormVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          }
        }
      }
    }
  }
}
