{
  "openapi": "3.1.0",
  "info": {
    "title": "Forms API",
    "version": "1.0.0",
    "description": "API for managing forms and form versions."
  },
  "paths": {
    "/api/forms": {
      "get": {
        "summary": "Get all form versions",
        "operationId": "GetAllFormVersions",
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllFormVersionsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "summary": "Create a new form version",
        "operationId": "CreateFormVersion",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFormVersionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form version created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateFormVersionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formVersionId}": {
      "get": {
        "summary": "Get a form version by ID",
        "operationId": "GetFormVersionById",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFormVersionByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "put": {
        "summary": "Update a form version by ID",
        "operationId": "UpdateFormVersionById",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFormVersionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Form version updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "delete": {
        "summary": "Delete a form version by ID",
        "operationId": "DeleteFormVersionById",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formVersionId}/publish": {
      "put": {
        "summary": "Publish a form version by ID",
        "operationId": "PublishFormVersionById",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version published.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formVersionId}/unpublish": {
      "put": {
        "summary": "Unpublish a form version by ID",
        "operationId": "UnpublishFormVersionById",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version unpublished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formId}/MoveUp": {
      "put": {
        "summary": "Move a form version up",
        "operationId": "MoveFormVersionUp",
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version moved up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formId}/MoveDown": {
      "put": {
        "summary": "Move a form version down",
        "operationId": "MoveFormVersionDown",
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Form version moved down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/api/forms/{formId}/new-version": {
      "put": {
        "summary": "Create a new draft version",
        "operationId": "CreateDraftFormVersion",
        "parameters": [
          {
            "name": "formId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft version created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmptyResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateFormVersionCommand": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          }
        }
      },
      "CreateFormVersionCommandResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "UpdateFormVersionCommand": {
        "type": "object",
        "properties": {
          "FormVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "Name": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          }
        }
      },
      "GetAllFormVersionsQueryResponse": {
        "type": "object",
        "properties": {
          "Data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormVersion"
            }
          }
        }
      },
      "FormVersion": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FormId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Version": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          },
          "DateCreated": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetFormVersionByIdQueryResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FormId": {
            "type": "string",
            "format": "uuid"
          },
          "Title": {
            "type": "string"
          },
          "Version": {
            "type": "string",
            "format": "date-time"
          },
          "Status": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "DescriptionHTML": {
            "type": "string"
          },
          "Order": {
            "type": "integer"
          },
          "Sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            }
          }
        }
      },
      "Section": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Key": {
            "type": "string",
            "format": "uuid"
          },
          "Order": {
            "type": "integer"
          },
          "Title": {
            "type": "string"
          }
        }
      },
      "EmptyResponse": {
        "type": "object"
      }
    }
  }
}
