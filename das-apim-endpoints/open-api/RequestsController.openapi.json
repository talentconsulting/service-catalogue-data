  "components": {
    "schemas": {
      "GetRequestResponse": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "requestType": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "providerName": {
            "type": "string"
          },
          "requestedBy": {
            "type": "string"
          },
          "requestedDate": {
            "type": "string",
            "format": "date-time"
          },
          "accountLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "employerOrganisationName": {
            "type": "string",
            "nullable": true
          },
          "employerContactFirstName": {
            "type": "string",
            "nullable": true
          },
          "employerContactLastName": {
            "type": "string",
            "nullable": true
          },
          "employerContactEmail": {
            "type": "string",
            "nullable": true
          },
          "employerPAYE": {
            "type": "string",
            "nullable": true
          },
          "employerAORN": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string"
          },
          "updatedDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "DeclinedRequestModel": {
        "type": "object",
        "properties": {
          "actionedBy": {
            "type": "string"
          }
        },
        "required": [
          "actionedBy"
        ]
      },
      "AcceptPermissionsRequestModel": {
        "type": "object",
        "properties": {
          "actionedBy": {
            "type": "string"
          }
        },
        "required": [
          "actionedBy"
        ]
      },
      "AcceptAddAccountRequestModel": {
        "type": "object",
        "properties": {
          "actionedBy": {
            "type": "string"
          }
        },
        "required": [
          "actionedBy"
        ]
      },
      "ValidatePermissionsRequestQueryResult": {
        "type": "object",
        "properties": {
          "isRequestValid": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "nullable": true
          },
          "hasEmployerAccount": {
            "type": "boolean",
            "nullable": true
          },
          "hasValidPaye": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "AcceptCreateAccountRequestModel": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "userRef": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "firstName",
          "lastName",
          "email",
          "userRef"
        ]
      },
      "AcceptCreateAccountRequestCommandResult": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    }
