{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerPR API",
    "version": "1.0.0"
  },
  "paths": {
    "/requests/{requestId}": {
      "get": {
        "summary": "Get request details",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the request",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRequestResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
