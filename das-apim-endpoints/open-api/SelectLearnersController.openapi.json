{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0",
    "description": "API for managing learner selection within the Approvals system."
  },
  "paths": {
    "/providers/{providerId}/unapproved/add/learners/select": {
      "post": {
        "tags": [
          "Learners"
        ],
        "summary": "Get learners for a provider.",
        "operationId": "getLearnersForProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The ID of the provider.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "description": "Search criteria for learners.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A list of learners matching the search criteria.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetLearnersForProviderQueryResponse"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select/{learnerId}": {
      "get": {
        "tags": [
          "Learners"
        ],
        "summary": "Get ILR record for a specific learner.",
        "operationId": "getLearnerForProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "The ID of the provider.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerId",
            "in": "path",
            "required": true,
            "description": "The ID of the learner.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The ILR record for the specified learner.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLearnerForProviderQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "StartMonth": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "StartYear": {
            "type": "integer",
            "format": "int32"
          },
          "Page": {
            "type": "integer",
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "nullable": true,
            "default": 20
          },
          "SortColumn": {
            "type": "string",
            "default": ""
          },
          "SortDescending": {
            "type": "boolean",
            "default": false
          },
          "CourseCode": {
            "type": "string",
            "nullable": true
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "SearchTerm": {
            "type": "string",
            "default": ""
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "default": []
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "GetLearnersForProviderQueryResponse": {
        "type": "object",
        "description": "Response schema for learners retrieved for a provider. Details not provided in the input data."
      },
      "GetLearnerForProviderQueryResponse": {
        "type": "object",
        "description": "Response schema for a specific learner's ILR record. Details not provided in the input data."
      }
    }
  }
}
