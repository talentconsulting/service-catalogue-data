{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "description": "API for managing learners and providers",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{providerId}/unapproved/add/learners/select": {
      "post": {
        "summary": "Get ILR records for a provider",
        "operationId": "getILRRecordsForProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "List of ILR records",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select/{learnerId}": {
      "get": {
        "summary": "Get ILR record for a selected learner",
        "operationId": "getILRRecordForLearner",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ILR record for the learner",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "StartMonth": {
            "type": "integer",
            "nullable": true
          },
          "StartYear": {
            "type": "integer"
          },
          "Page": {
            "type": "integer",
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "default": 20,
            "nullable": true
          },
          "SortColumn": {
            "type": "string",
            "default": ""
          },
          "SortDescending": {
            "type": "boolean",
            "default": false
          },
          "CourseCode": {
            "type": "string",
            "nullable": true
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "nullable": true
          },
          "CohortId": {
            "type": "integer",
            "nullable": true
          },
          "SearchTerm": {
            "type": "string",
            "default": ""
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType",
            "nullable": true
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "default": []
          }
        },
        "required": [
          "StartYear",
          "Page",
          "SortColumn",
          "SortDescending",
          "SearchTerm",
          "ExcludeUlns"
        ]
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      }
    }
  }
}
