{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0",
    "description": "API for managing learners and associated operations."
  },
  "paths": {
    "/providers/{providerId}/unapproved/add/learners/select": {
      "post": {
        "summary": "Get learners for provider",
        "description": "Retrieves unapproved learners for a specific provider based on the provided search criteria.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the provider",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select/{learnerId}": {
      "get": {
        "summary": "Get details for a specific learner",
        "description": "Retrieves the details of a specific learner using their learnerId and providerId.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the provider",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerId",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the learner",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "StartMonth": {
            "type": "integer",
            "description": "Month to start the search"
          },
          "StartYear": {
            "type": "integer",
            "description": "Year to start the search"
          },
          "Page": {
            "type": "integer",
            "description": "Page number",
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "description": "Number of results per page",
            "default": 20
          },
          "SortColumn": {
            "type": "string",
            "description": "Column to sort by",
            "default": ""
          },
          "SortDescending": {
            "type": "boolean",
            "description": "Indicates whether to sort in descending order",
            "default": false
          },
          "CourseCode": {
            "type": "string",
            "nullable": true,
            "description": "Code of the course"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Account Legal Entity ID"
          },
          "CohortId": {
            "type": "integer",
            "format": "int64",
            "nullable": true,
            "description": "Cohort ID"
          },
          "SearchTerm": {
            "type": "string",
            "description": "Search term",
            "default": ""
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ],
            "nullable": true,
            "description": "Type of learning"
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "List of ULNs to exclude"
          }
        }
      }
    }
  }
}
