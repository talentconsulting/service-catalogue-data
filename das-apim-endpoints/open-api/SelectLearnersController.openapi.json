{
  "openapi": "3.1.0",
  "info": {
    "title": "SelectLearners API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{providerId}/unapproved/add/learners/select": {
      "post": {
        "summary": "Get ILR records for a provider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/providers/{providerId}/unapproved/add/learners/select/{learnerId}": {
      "get": {
        "summary": "Get ILR record for a selected learner",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "StartMonth": {
            "type": "integer",
            "nullable": true
          },
          "StartYear": {
            "type": "integer"
          },
          "Page": {
            "type": "integer",
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "nullable": true,
            "default": 20
          },
          "SortColumn": {
            "type": "string",
            "default": ""
          },
          "SortDescending": {
            "type": "boolean",
            "default": false
          },
          "CourseCode": {
            "type": "string",
            "nullable": true
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "nullable": true
          },
          "CohortId": {
            "type": "integer",
            "nullable": true
          },
          "SearchTerm": {
            "type": "string",
            "default": ""
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ],
            "nullable": true
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "default": []
          }
        }
      }
    }
  }
}
