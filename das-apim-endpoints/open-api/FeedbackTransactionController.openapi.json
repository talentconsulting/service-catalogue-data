{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "description": "API for managing apprentice feedback transactions.",
    "version": "1.0.0"
  },
  "paths": {
    "/FeedbackTransaction/generate-email-transactions": {
      "post": {
        "summary": "Generate email transactions",
        "operationId": "GenerateEmailTransactions",
        "responses": {
          "200": {
            "description": "Email transactions generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NullResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/FeedbackTransaction/{feedbackTransactionId}": {
      "post": {
        "summary": "Process email transaction",
        "operationId": "ProcessEmailTransaction",
        "parameters": [
          {
            "name": "feedbackTransactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackTransaction"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProcessEmailTransactionResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/FeedbackTransaction/{feedbackTransactionId}/track-click": {
      "post": {
        "summary": "Track email transaction click",
        "operationId": "TrackClick",
        "parameters": [
          {
            "name": "feedbackTransactionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackTransactionClick"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Click tracked successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackEmailTransactionClickResult"
                }
              }
            }
          }
        }
      }
    },
    "/FeedbackTransaction": {
      "get": {
        "summary": "Get feedback transactions to email",
        "operationId": "GetFeedbackTransactionsToEmail",
        "parameters": [
          {
            "name": "batchSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feedback transactions retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetFeedbackTransactionsToEmailResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NullResponse": {
        "type": "object",
        "properties": {}
      },
      "FeedbackTransaction": {
        "type": "object",
        "properties": {
          "FeedbackTransactionId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "FeedbackTransactionId",
          "ApprenticeId",
          "ApprenticeFeedbackTargetId"
        ]
      },
      "FeedbackTransactionClick": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          },
          "LinkName": {
            "type": "string"
          },
          "LinkUrl": {
            "type": "string",
            "format": "uri"
          },
          "ClickedOn": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "ApprenticeFeedbackTargetId",
          "LinkName",
          "LinkUrl",
          "ClickedOn"
        ]
      },
      "ProcessEmailTransactionResult": {
        "type": "object",
        "properties": {
          "FeedbackTransactionId": {
            "type": "integer",
            "format": "int64"
          },
          "EmailStatus": {
            "type": "string",
            "enum": [
              "Successful",
              "NotAllowed",
              "Failed"
            ]
          }
        },
        "required": [
          "FeedbackTransactionId",
          "EmailStatus"
        ]
      },
      "TrackEmailTransactionClickResult": {
        "type": "object",
        "properties": {
          "FeedbackTransactionId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          },
          "ClickStatus": {
            "type": "string",
            "enum": [
              "Invalid",
              "Valid"
            ]
          }
        },
        "required": [
          "FeedbackTransactionId",
          "ApprenticeFeedbackTargetId",
          "ClickStatus"
        ]
      },
      "GetFeedbackTransactionsToEmailResponse": {
        "type": "object",
        "properties": {
          "FeedbackTransactionId": {
            "type": "integer",
            "format": "int64"
          },
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "FeedbackTransactionId",
          "ApprenticeId",
          "ApprenticeFeedbackTargetId"
        ]
      }
    }
  }
}
