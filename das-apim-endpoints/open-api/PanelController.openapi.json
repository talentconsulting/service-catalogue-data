{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Campaign API",
    "version": "1.0.0"
  },
  "paths": {
    "/Panel/{panelId}": {
      "get": {
        "summary": "Retrieve a specific Panel by ID",
        "parameters": [
          {
            "name": "panelId",
            "in": "path",
            "required": true,
            "description": "ID of the Panel",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of panel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPanelResponse"
                }
              }
            }
          },
          "404": {
            "description": "Panel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Panel/preview/{panelId}": {
      "get": {
        "summary": "Retrieve a preview of a Panel by ID",
        "parameters": [
          {
            "name": "panelId",
            "in": "path",
            "required": true,
            "description": "ID of the Panel",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of the preview panel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPreviewPanelResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview Panel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPanelResponse": {
        "type": "object",
        "properties": {
          "Panel": {
            "$ref": "#/components/schemas/PanelModel"
          }
        }
      },
      "GetPreviewPanelResponse": {
        "type": "object",
        "properties": {
          "Panel": {
            "$ref": "#/components/schemas/PanelModel"
          }
        }
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "Message": {
            "type": "string"
          }
        }
      },
      "PanelModel": {
        "type": "object",
        "properties": {
          "MainContent": {
            "$ref": "#/components/schemas/PanelContent"
          }
        }
      },
      "PanelContent": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Slug": {
            "type": "string"
          },
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "Image": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "Button": {
            "$ref": "#/components/schemas/ButtonModel"
          },
          "Id": {
            "type": "integer"
          }
        }
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "Values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "Type": {
            "type": "string"
          },
          "TableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "EmbeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "VideoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        }
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "Url": {
            "type": "string",
            "format": "uri"
          },
          "Size": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "VideoName": {
            "type": "string"
          },
          "Text": {
            "type": "string"
          }
        }
      },
      "ButtonModel": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Url": {
            "type": "string",
            "format": "uri"
          },
          "Styles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
