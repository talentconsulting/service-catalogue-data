{
  "openapi": "3.1.0",
  "info": {
    "title": "Panel API",
    "version": "1.0.0"
  },
  "paths": {
    "/Panel/{panelId}": {
      "get": {
        "summary": "Get Panel by ID",
        "operationId": "getPanelById",
        "parameters": [
          {
            "name": "panelId",
            "in": "path",
            "required": true,
            "description": "The ID of the panel to retrieve",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A GetPanelResponse object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPanelResponse"
                }
              }
            }
          },
          "404": {
            "description": "Panel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    },
    "/Panel/preview/{panelId}": {
      "get": {
        "summary": "Get Preview Panel by ID",
        "operationId": "getPreviewPanelById",
        "parameters": [
          {
            "name": "panelId",
            "in": "path",
            "required": true,
            "description": "The ID of the preview panel to retrieve",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A GetPreviewPanelResponse object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetPreviewPanelResponse"
                }
              }
            }
          },
          "404": {
            "description": "Preview Panel not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetPanelResponse": {
        "type": "object",
        "properties": {
          "panel": {
            "$ref": "#/components/schemas/PanelModel"
          }
        },
        "required": [
          "panel"
        ]
      },
      "GetPreviewPanelResponse": {
        "type": "object",
        "properties": {
          "panel": {
            "$ref": "#/components/schemas/PanelModel"
          }
        },
        "required": [
          "panel"
        ]
      },
      "NotFoundResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Error message indicating the reason for the not found response"
          }
        },
        "required": [
          "message"
        ]
      },
      "PanelModel": {
        "type": "object",
        "properties": {
          "mainContent": {
            "$ref": "#/components/schemas/PanelContent"
          }
        },
        "required": [
          "mainContent"
        ]
      },
      "PanelContent": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContentItem"
            }
          },
          "image": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "button": {
            "$ref": "#/components/schemas/ButtonModel"
          },
          "id": {
            "type": "integer"
          }
        },
        "required": [
          "items"
        ]
      },
      "ContentItem": {
        "type": "object",
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string"
          },
          "tableValue": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "embeddedResource": {
            "$ref": "#/components/schemas/ResourceItem"
          },
          "videoTranscripts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VideoTranscript"
            }
          }
        },
        "required": [
          "values",
          "type"
        ]
      },
      "ResourceItem": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "contentType": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "size": {
            "type": "integer",
            "format": "int64"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "VideoTranscript": {
        "type": "object",
        "properties": {
          "videoName": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "ButtonModel": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "styles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title",
          "url",
          "styles"
        ]
      }
    }
  }
}
