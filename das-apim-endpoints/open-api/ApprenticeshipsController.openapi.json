{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/academicyears/{academicyear}/apprenticeships": {
      "get": {
        "summary": "Retrieve apprenticeships for a given provider and academic year",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier for the provider."
          },
          {
            "name": "academicyear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The academic year to filter apprenticeships by."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number for pagination."
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "The number of apprenticeship records per page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with list of apprenticeships.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipsResponse": {
        "type": "object"
      }
    }
  }
}
