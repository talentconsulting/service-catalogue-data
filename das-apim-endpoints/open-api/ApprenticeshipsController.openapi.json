{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/academicyears/{academicyear}/apprenticeships": {
      "get": {
        "summary": "Get Apprenticeships",
        "description": "Retrieve apprenticeships for a specific provider and academic year.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique provider reference number."
          },
          {
            "name": "academicyear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Academic year."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "Page number of the results."
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            },
            "description": "Number of results per page. Defaults to 20 and is capped at 100."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeshipsResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeshipsResponse": {
        "type": "object",
        "description": "Response containing apprenticeships data.",
        "properties": {}
      }
    }
  }
}
