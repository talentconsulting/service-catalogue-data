{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Portal API",
    "description": "API for managing Apprentices in the Apprentice Portal",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{id}": {
      "get": {
        "summary": "Get Apprentice",
        "operationId": "GetApprentice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier of the apprentice"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeAccount"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}": {
      "patch": {
        "summary": "Update Apprentice",
        "operationId": "UpdateApprentice",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier of the apprentice"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/json-patch+json": {
              "schema": {
                "type": "object"
              }
            },
            "text/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "The unique identifier of the apprentice"
          },
          "firstName": {
            "type": "string",
            "description": "First name of the apprentice"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the apprentice"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date",
            "description": "Date of birth of the apprentice"
          },
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "termsOfUseAccepted": {
            "type": "boolean",
            "description": "Indicates if the apprentice has accepted the terms of use"
          }
        }
      },
      "Email": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "description": "Display name of the email"
          },
          "user": {
            "type": "string",
            "description": "User portion of the email address"
          },
          "host": {
            "type": "string",
            "description": "Host portion of the email address"
          },
          "address": {
            "type": "string",
            "description": "Complete email address"
          }
        }
      }
    }
  }
}
