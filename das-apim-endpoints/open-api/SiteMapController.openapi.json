{
  "openapi": "3.1.0",
  "info": {
    "title": "Campaign API",
    "version": "1.0.0"
  },
  "paths": {
    "/sitemap/": {
      "get": {
        "summary": "Get Full Site Map",
        "operationId": "getFullSiteMap",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSiteMapResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSiteMapResponse": {
        "type": "object",
        "properties": {
          "map": {
            "$ref": "#/components/schemas/SiteMapPageModel"
          }
        },
        "required": [
          "map"
        ]
      },
      "SiteMapPageModel": {
        "type": "object",
        "properties": {
          "mainContent": {
            "$ref": "#/components/schemas/SiteMapContent"
          }
        },
        "required": [
          "mainContent"
        ]
      },
      "SiteMapContent": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UrlDetails"
            }
          }
        },
        "required": [
          "pages"
        ]
      },
      "UrlDetails": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "hub": {
            "type": "string"
          },
          "pageType": {
            "type": "string"
          },
          "parentSlug": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "hub",
          "pageType",
          "parentSlug"
        ]
      }
    }
  }
}
