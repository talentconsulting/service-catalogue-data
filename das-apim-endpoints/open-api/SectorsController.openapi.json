{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.Campaign.Api",
    "version": "1.0.0"
  },
  "paths": {
    "/sectors/": {
      "get": {
        "operationId": "GetSectors",
        "summary": "Retrieve a list of sectors",
        "description": "Endpoint to fetch a list of sectors.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSectorsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetSectorsResponse": {
        "type": "object",
        "properties": {
          "Sectors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetRouteResponseItem"
            }
          }
        },
        "required": [
          "Sectors"
        ]
      },
      "GetRouteResponseItem": {
        "type": "object",
        "properties": {
          "Route": {
            "type": "string"
          }
        },
        "required": [
          "Route"
        ]
      }
    }
  }
}
