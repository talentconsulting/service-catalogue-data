{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions/{revisionId}": {
      "patch": {
        "operationId": "PatchApprenticeshipRevision",
        "summary": "Patch apprenticeship revision",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/RevisionPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "get": {
        "operationId": "GetApprenticeshipRevision",
        "summary": "Get apprenticeship revision details",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}/apprenticeships/{apprenticeshipId}/revisions/{revisionId}/confirmations": {
      "patch": {
        "operationId": "ConfirmApprenticeshipRevision",
        "summary": "Confirm apprenticeship revision",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "revisionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Confirmations"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RevisionPatch": {
        "type": "object",
        "properties": {
          "LastViewed": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "LastViewed"
        ]
      },
      "Confirmations": {
        "type": "object",
        "properties": {
          "EmployerCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "TrainingProviderCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "ApprenticeshipDetailsCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "RolesAndResponsibilitiesConfirmations": {
            "$ref": "#/components/schemas/RolesAndResponsibilitiesConfirmations"
          },
          "HowApprenticeshipDeliveredCorrect": {
            "type": "boolean",
            "nullable": true
          },
          "ApprenticeshipCorrect": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "RolesAndResponsibilitiesConfirmations": {
        "type": "integer",
        "format": "int32",
        "enum": [
          0,
          1,
          2,
          4
        ],
        "description": "Enum flags for roles and responsibilities confirmations"
      }
    }
  }
}
