{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice App API",
    "version": "1.0.0",
    "description": "API for managing apprentice accounts and subscriptions."
  },
  "paths": {
    "/apprentices/{id}": {
      "patch": {
        "summary": "Update apprentice details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/json-patch+json": {
              "schema": {
                "type": "object"
              }
            },
            "text/json": {
              "schema": {
                "type": "object"
              }
            },
            "application/*+json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          }
        }
      }
    },
    "/apprentices": {
      "get": {
        "summary": "Get apprentice by name and date of birth",
        "parameters": [
          {
            "name": "firstName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dateOfBirth",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApprenticeAccount"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Apprentice not found"
          }
        }
      }
    },
    "/apprentice/{id}/MyApprenticeship": {
      "patch": {
        "summary": "Update apprentice's My Apprenticeship details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "404": {
            "description": "Apprentice not found"
          }
        }
      }
    },
    "/apprentices/{id}/subscriptions": {
      "post": {
        "summary": "Add a subscription for an apprentice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeAddSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription successfully added."
          }
        }
      },
      "delete": {
        "summary": "Remove a subscription for an apprentice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeRemoveSubscriptionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription successfully removed."
          }
        }
      }
    },
    "/apprentice/{id}": {
      "delete": {
        "summary": "Delete apprentice account by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account successfully deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeAccount": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "email": {
            "$ref": "#/components/schemas/Email"
          },
          "termsOfUseAccepted": {
            "type": "boolean"
          }
        }
      },
      "Email": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "address": {
            "type": "string"
          }
        }
      },
      "ApprenticeAddSubscriptionRequest": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string"
          },
          "publicKey": {
            "type": "string"
          },
          "authenticationSecret": {
            "type": "string"
          }
        },
        "required": [
          "endpoint",
          "publicKey",
          "authenticationSecret"
        ]
      },
      "ApprenticeRemoveSubscriptionRequest": {
        "type": "object",
        "properties": {
          "endpoint": {
            "type": "string"
          }
        },
        "required": [
          "endpoint"
        ]
      }
    }
  }
}
