{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers Allowed List API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/allowedlist": {
      "get": {
        "operationId": "getAllowedList",
        "summary": "Get Allowed List",
        "description": "Retrieve the list of allowed providers.",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The column to sort results by."
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The order to sort results (e.g., 'Ascending' or 'Descending')."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with allowed providers list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersAllowedListQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersAllowedListQueryResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedProvider"
            }
          }
        }
      },
      "AllowedProvider": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "description": "The UK Provider Reference Number."
          },
          "startDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The start date and time for the provider."
          },
          "endDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The end date and time for the provider."
          },
          "addedDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time when the provider was added.",
            "nullable": true
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "description": "A code that indicates the type of error."
          },
          "errorMessage": {
            "type": "string",
            "description": "A descriptive error message."
          }
        }
      }
    }
  }
}
