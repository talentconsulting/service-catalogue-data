{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminRoatp API",
    "version": "1.0.0",
    "description": "API operations for managing Providers Allowed List."
  },
  "paths": {
    "/providers/allowedlist": {
      "get": {
        "summary": "Get Providers Allowed List",
        "description": "Retrieve a list of allowed providers, optionally sorted by a column and order.",
        "operationId": "GetAllowedList",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Column to sort the results by."
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Ascending",
                "Descending"
              ]
            },
            "description": "Order to sort the results. Accepted values: Ascending, Descending."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of allowed providers list.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersAllowedListQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersAllowedListQueryResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedProvider"
            },
            "description": "List of allowed providers."
          }
        },
        "required": [
          "Providers"
        ],
        "description": "Response containing a list of allowed providers."
      },
      "AllowedProvider": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int32",
            "description": "Unique Provider Reference Number (UKPRN)."
          },
          "StartDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Start date and time of the provider being allowed."
          },
          "EndDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "End date and time of the provider being allowed."
          },
          "AddedDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the provider was added to the allowed list."
          }
        },
        "required": [
          "Ukprn",
          "StartDateTime",
          "EndDateTime"
        ]
      }
    }
  }
}
