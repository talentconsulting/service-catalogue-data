{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers Allowed List API",
    "version": "1.0.0",
    "description": "API endpoints for managing the providers' allowed list."
  },
  "paths": {
    "/providers/allowedlist": {
      "get": {
        "summary": "Get Providers Allowed List",
        "operationId": "GetAllowedList",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "description": "The column to sort by."
          },
          {
            "name": "sortOrder",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "nullable": true
            },
            "description": "The sorting order (e.g., ascending, descending)."
          }
        ],
        "responses": {
          "200": {
            "description": "Allowed providers list retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetProvidersAllowedListQueryResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters provided.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersAllowedListQueryResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedProvider"
            }
          }
        },
        "required": [
          "providers"
        ]
      },
      "AllowedProvider": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int32"
          },
          "startDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "endDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "addedDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "ukprn",
          "startDateTime",
          "endDateTime"
        ]
      }
    }
  }
}
