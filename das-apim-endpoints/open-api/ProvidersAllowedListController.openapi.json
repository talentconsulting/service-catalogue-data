{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers Allowed List API",
    "version": "1.0.0",
    "description": "API for managing the providers allowed list."
  },
  "paths": {
    "/providers/allowedlist": {
      "get": {
        "operationId": "GetAllowedList",
        "summary": "Retrieve the list of allowed providers.",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "description": "Column to sort the results on.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Order of sorting (ascending or descending).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Allowed providers list retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetProvidersAllowedListQueryResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to invalid parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersAllowedListQueryResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedProvider"
            }
          }
        }
      },
      "AllowedProvider": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "description": "Unique identifier for the provider."
          },
          "StartDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Start date and time for the provider."
          },
          "EndDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "End date and time for the provider."
          },
          "AddedDateTime": {
            "type": "string",
            "format": "date-time",
            "description": "Date and time when the provider was added to the list.",
            "nullable": true
          }
        }
      }
    }
  }
}
