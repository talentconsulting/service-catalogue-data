{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin RoATP Providers Allowed List API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/allowedlist": {
      "get": {
        "summary": "Retrieve the list of allowed providers",
        "operationId": "GetAllowedList",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            },
            "description": "Optional column to sort by"
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "nullable": true
            },
            "description": "Optional order to sort (Ascending/Descending)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of allowed providers list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GetProvidersAllowedListQueryResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersAllowedListQueryResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AllowedProvider"
            }
          }
        },
        "required": [
          "Providers"
        ]
      },
      "AllowedProvider": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int32"
          },
          "StartDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "EndDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "AddedDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "Ukprn",
          "StartDateTime",
          "EndDateTime"
        ]
      }
    }
  }
}
