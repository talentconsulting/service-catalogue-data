{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.AdminRoatp.Api",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/allowedlist": {
      "get": {
        "summary": "Get Allowed Providers List",
        "operationId": "getAllowedProvidersList",
        "parameters": [
          {
            "name": "sortColumn",
            "in": "query",
            "description": "Column to sort by",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Order of sorting (e.g., Ascending or Descending)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersAllowedListQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
