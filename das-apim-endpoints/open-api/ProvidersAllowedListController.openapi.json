        ]
      },
      "AllowedProvider": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int32"
          },
          "startDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "endDateTime": {
            "type": "string",
            "format": "date-time"
          },
          "addedDateTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "ukprn",
          "startDateTime",
          "endDateTime"
        ]
      }
    }
  }
