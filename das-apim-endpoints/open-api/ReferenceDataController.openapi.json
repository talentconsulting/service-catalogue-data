{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Learner Data API",
    "version": "1.0.0"
  },
  "paths": {
    "/reference-data/providers/{ukprn}": {
      "get": {
        "summary": "Get provider relationship details",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The UK Provider Reference Number."
          }
        ],
        "responses": {
          "200": {
            "description": "Provider relationship details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderRelationshipQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider relationship details not found."
          }
        }
      }
    },
    "/reference-data/providers": {
      "get": {
        "summary": "Get all provider relationship details",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            },
            "description": "The page number to retrieve."
          },
          {
            "name": "pagesize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            },
            "description": "The number of items per page (between 1 and 100)."
          }
        ],
        "responses": {
          "200": {
            "description": "List of provider relationship details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllProviderRelationshipQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid page or pagesize parameters."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderRelationshipQueryResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetAllProviderRelationshipQueryResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
