{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/cohort/{cohortId}": {
      "get": {
        "summary": "Retrieve specific cohort",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort retrieved successfully",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}": {
      "get": {
        "summary": "Get cohort details (Employer)",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "post": {
        "summary": "Post cohort details (Employer)",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Details posted successfully"
          },
          "404": {
            "description": "Resource not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/provider/{providerId}/unapproved/{cohortId}": {
      "get": {
        "summary": "Get cohort details (Provider)",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "post": {
        "summary": "Post cohort details (Provider)",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Details posted successfully"
          },
          "404": {
            "description": "Resource not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/cohorts": {
      "post": {
        "summary": "Create cohort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    },
    "/employer/{accountHashedId}/unapproved/add/assign/allow-employer-add": {
      "get": {
        "summary": "Get assign allow employer add",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reservationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Assign retrieved successfully",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Resource not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DetailsPostRequest": {
        "type": "object",
        "properties": {
          "SubmissionType": {
            "type": "string",
            "enum": [
              "Send",
              "Approve"
            ]
          },
          "Message": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "SubmissionType",
          "Message",
          "UserInfo"
        ]
      },
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          },
          "RequestingParty": {
            "type": "string",
            "enum": [
              "None",
              "Employer",
              "Provider",
              "TransferSender"
            ]
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "string",
            "enum": [
              "Regular",
              "PortableFlexiJob",
              "FlexiJobAgency"
            ]
          },
          "Cost": {
            "type": "integer"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "EndPointAssessmentPrice": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "TransferSenderId": {
            "type": "integer"
          },
          "PledgeApplicationId": {
            "type": "integer"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "IsOnFlexiPaymentPilot": {
            "type": "boolean"
          },
          "LearnerDataId": {
            "type": "integer"
          }
        },
        "required": [
          "UserInfo",
          "AccountId",
          "AccountLegalEntityId",
          "ProviderId",
          "FirstName",
          "LastName",
          "Email",
          "CourseCode"
        ]
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortReference": {
            "type": "string"
          }
        },
        "required": [
          "CohortId",
          "CohortReference"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      }
    }
  }
}
