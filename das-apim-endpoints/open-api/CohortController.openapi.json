{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals Cohort API",
    "version": "1.0.0"
  },
  "paths": {
    "/Cohort/{cohortId}": {
      "get": {
        "summary": "Get Cohort",
        "description": "Retrieve cohort details by ID.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}": {
      "get": {
        "summary": "Get Cohort Details (Employer)",
        "description": "Retrieve detailed cohort data for employer.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      },
      "post": {
        "summary": "Post Cohort Details (Employer)",
        "description": "Submit cohort details for employer.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation."
          },
          "404": {
            "description": "Resource not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/provider/{providerId}/unapproved/{cohortId}": {
      "get": {
        "summary": "Get Cohort Details (Provider)",
        "description": "Retrieve detailed cohort data for provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/employer/{accountHashedId}/unapproved/add/assign/allow-employer-add": {
      "get": {
        "summary": "Get Assign Allow Employer Add",
        "description": "Retrieve information to allow employer addition with reservation ID.",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reservationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Not found."
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    },
    "/cohorts": {
      "post": {
        "summary": "Create Cohort",
        "description": "Create a new cohort.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          },
          "RequestingParty": {
            "$ref": "#/components/schemas/Party"
          },
          "AccountId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "ProviderId": {
            "type": "integer"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "DeliveryModel": {
            "$ref": "#/components/schemas/DeliveryModel"
          },
          "Cost": {
            "type": "integer"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "EndPointAssessmentPrice": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date"
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date"
          },
          "EndDate": {
            "type": "string",
            "format": "date"
          },
          "OriginatorReference": {
            "type": "string"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "TransferSenderId": {
            "type": "integer"
          },
          "PledgeApplicationId": {
            "type": "integer"
          },
          "EmploymentPrice": {
            "type": "integer"
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date"
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "IsOnFlexiPaymentPilot": {
            "type": "boolean"
          },
          "LearnerDataId": {
            "type": "integer"
          }
        }
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer"
          },
          "CohortReference": {
            "type": "string"
          }
        }
      },
      "DetailsPostRequest": {
        "type": "object",
        "properties": {
          "SubmissionType": {
            "$ref": "#/components/schemas/CohortSubmissionType"
          },
          "Message": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string"
          }
        }
      },
      "Party": {
        "type": "string",
        "enum": [
          "None",
          "Employer",
          "Provider",
          "TransferSender"
        ]
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ]
      },
      "CohortSubmissionType": {
        "type": "string",
        "enum": [
          "Send",
          "Approve"
        ]
      }
    }
  }
}
