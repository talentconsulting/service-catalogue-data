{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Approvals API",
    "version": "1.0.0",
    "description": "API for managing cohorts and apprenticeships approvals within the SFA DAS platform."
  },
  "paths": {
    "/cohort/{cohortId}": {
      "get": {
        "summary": "Get cohort by ID",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}": {
      "get": {
        "summary": "Get cohort details for employer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Cohort not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "post": {
        "summary": "Update cohort details for employer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort details updated successfully"
          },
          "404": {
            "description": "Cohort not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/employer/{accountHashedId}/unapproved/add/assign/allow-employer-add": {
      "get": {
        "summary": "Get employer assignment details",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reservationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer assignment details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Details not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/add/apprenticeship": {
      "get": {
        "summary": "Get apprenticeship draft details for employer",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "courseCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship draft details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Details not found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DetailsPostRequest": {
        "type": "object",
        "properties": {
          "SubmissionType": {
            "type": "string",
            "enum": [
              "Send",
              "Approve"
            ]
          },
          "Message": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "SubmissionType",
          "Message",
          "UserInfo"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
