{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA.DAS.Approvals.API",
    "version": "1.0.0",
    "description": "API for managing approval-related actions within the DAS platform."
  },
  "paths": {
    "/Cohort/{cohortId}": {
      "get": {
        "summary": "Get specific cohort by ID.",
        "parameters": [
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort not found."
          },
          "400": {
            "description": "Bad Request."
          }
        }
      }
    },
    "/employer/{accountId}/unapproved/{cohortId}": {
      "get": {
        "summary": "Get cohort details for employer.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort details not found."
          },
          "400": {
            "description": "Bad Request."
          }
        }
      },
      "post": {
        "summary": "Post details for a cohort for employer.",
        "parameters": [
          {
            "name": "accountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation."
          },
          "404": {
            "description": "Resource not found."
          },
          "400": {
            "description": "Bad Request."
          }
        }
      }
    },
    "/provider/{providerId}/unapproved/{cohortId}": {
      "get": {
        "summary": "Get cohort details for provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": {
            "description": "Cohort details not found."
          },
          "400": {
            "description": "Bad Request."
          }
        }
      },
      "post": {
        "summary": "Post details for a cohort for provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cohortId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsPostRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation."
          },
          "404": {
            "description": "Resource not found."
          },
          "400": {
            "description": "Bad Request."
          }
        }
      }
    },
    "/cohorts": {
      "post": {
        "summary": "Create a new cohort.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCohortRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cohort successfully created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCohortResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DetailsPostRequest": {
        "type": "object",
        "properties": {
          "SubmissionType": {
            "type": "string",
            "enum": [
              "Send",
              "Approve"
            ]
          },
          "Message": {
            "type": "string"
          },
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          }
        },
        "required": [
          "SubmissionType",
          "UserInfo"
        ]
      },
      "CreateCohortRequest": {
        "type": "object",
        "properties": {
          "UserInfo": {
            "$ref": "#/components/schemas/UserInfo"
          },
          "RequestingParty": {
            "type": "string",
            "enum": [
              "None",
              "Employer",
              "Provider",
              "TransferSender"
            ],
            "nullable": true
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string",
            "nullable": true
          },
          "LastName": {
            "type": "string",
            "nullable": true
          },
          "Email": {
            "type": "string",
            "format": "email",
            "nullable": true
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "Uln": {
            "type": "string",
            "nullable": true
          },
          "CourseCode": {
            "type": "string",
            "nullable": true
          },
          "DeliveryModel": {
            "type": "string",
            "enum": [
              "Regular",
              "PortableFlexiJob",
              "FlexiJobAgency"
            ],
            "nullable": true
          },
          "Cost": {
            "type": "integer",
            "nullable": true
          },
          "TrainingPrice": {
            "type": "integer",
            "nullable": true
          },
          "EndPointAssessmentPrice": {
            "type": "integer",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "ActualStartDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "EndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "OriginatorReference": {
            "type": "string",
            "nullable": true
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "TransferSenderId": {
            "type": "integer",
            "nullable": true
          },
          "PledgeApplicationId": {
            "type": "integer",
            "nullable": true
          },
          "EmploymentPrice": {
            "type": "integer",
            "nullable": true
          },
          "EmploymentEndDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          },
          "IgnoreStartDateOverlap": {
            "type": "boolean"
          },
          "IsOnFlexiPaymentPilot": {
            "type": "boolean",
            "nullable": true
          },
          "LearnerDataId": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "UserInfo",
          "AccountId",
          "AccountLegalEntityId",
          "ProviderId",
          "IgnoreStartDateOverlap"
        ]
      },
      "CreateCohortResponse": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer",
            "format": "int64"
          },
          "CohortReference": {
            "type": "string"
          }
        },
        "required": [
          "CohortId",
          "CohortReference"
        ]
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "UserEmail": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "UserEmail"
        ]
      }
    }
  }
}
