{
  "openapi": "3.1.0",
  "info": {
    "title": "Admins API",
    "version": "1.0.0"
  },
  "paths": {
    "/Admins/Lookup": {
      "post": {
        "summary": "Lookup an admin member or create a new admin member.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetAdminMemberRequestModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAdminMemberResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAdminMemberRequestModel": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          }
        },
        "required": [
          "Email",
          "FirstName",
          "LastName"
        ]
      },
      "GetAdminMemberResult": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "Status": {
            "type": "string"
          }
        },
        "required": [
          "MemberId",
          "Status"
        ]
      }
    }
  }
}
