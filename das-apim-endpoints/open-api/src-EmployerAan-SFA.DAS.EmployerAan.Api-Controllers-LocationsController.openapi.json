{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerAan Locations API",
    "version": "1.0.0"
  },
  "paths": {
    "/Locations/search": {
      "get": {
        "summary": "Get locations by search query",
        "operationId": "getLocationsBySearch",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLocationsBySearchQueryResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetLocationsBySearchQuery": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      },
      "GetLocationsBySearchQueryResponse": {
        "type": "object",
        "properties": {
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
