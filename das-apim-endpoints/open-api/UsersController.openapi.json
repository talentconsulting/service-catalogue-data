{
  "openapi": "3.1.0",
  "info": {
    "title": "Admin Users API",
    "version": "1.0.0"
  },
  "paths": {
    "/users/{userId}/unlock": {
      "post": {
        "summary": "Unlock a user",
        "operationId": "UnlockUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockUserRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnlockUserRequest": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string"
          },
          "UserActionId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "Username",
          "UserActionId"
        ]
      }
    }
  }
}
