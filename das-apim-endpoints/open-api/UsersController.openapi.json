{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0"
  },
  "paths": {
    "/users/{govUkIdentifier}": {
      "get": {
        "operationId": "GetUser",
        "parameters": [
          {
            "name": "govUkIdentifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The GOV.UK identifier of the user."
          }
        ],
        "responses": {
          "200": {
            "description": "User details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/users": {
      "post": {
        "operationId": "CreateOrUpdateUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrUpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User created or updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "The ID of the created or updated user."
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/users/{userId}/identity": {
      "post": {
        "operationId": "UpdateUserIdentity",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserIdentityRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User identity updated successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/users/{userId}/certificates": {
      "get": {
        "operationId": "GetCertificates",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          }
        ],
        "responses": {
          "200": {
            "description": "Certificates retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/users/{userId}/sharings": {
      "get": {
        "operationId": "GetSharings",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          },
          {
            "name": "certificateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the certificate."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The maximum number of results to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Sharings retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/users/{userId}/match": {
      "get": {
        "operationId": "GetCertificatesMatch",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          }
        ],
        "responses": {
          "200": {
            "description": "Certificate matches retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "204": {
            "description": "No matches found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "operationId": "CreateUserMatch",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserMatchRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "User match created successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/users/{userId}/user-actions": {
      "post": {
        "operationId": "CreateUserAction",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserActionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User action created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "get": {
        "operationId": "GetUserActions",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          }
        ],
        "responses": {
          "200": {
            "description": "User actions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/users/{userId}/authorise": {
      "post": {
        "operationId": "CreateUserAuthorise",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserAuthoriseRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "User authorised successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateOrUpdateUserRequest": {
        "type": "object",
        "required": [
          "GovUkIdentifier",
          "EmailAddress"
        ],
        "properties": {
          "GovUkIdentifier": {
            "type": "string"
          },
          "EmailAddress": {
            "type": "string",
            "format": "email"
          },
          "PhoneNumber": {
            "type": "string"
          }
        }
      },
      "UpdateUserIdentityRequest": {
        "type": "object",
        "required": [
          "Names",
          "DateOfBirth"
        ],
        "properties": {
          "Names": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "UserIdentityId",
                "FamilyName",
                "GivenNames"
              ],
              "properties": {
                "UserIdentityId": {
                  "type": "string",
                  "format": "uuid"
                },
                "ValidSince": {
                  "type": "string",
                  "format": "date-time"
                },
                "ValidUntil": {
                  "type": "string",
                  "format": "date-time"
                },
                "FamilyName": {
                  "type": "string"
                },
                "GivenNames": {
                  "type": "string"
                }
              }
            }
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUserActionRequest": {
        "type": "object",
        "required": [
          "ActionType",
          "CertificateType"
        ],
        "properties": {
          "ActionType": {
            "type": "string"
          },
          "FamilyName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          },
          "CertificateId": {
            "type": "string",
            "format": "uuid"
          },
          "CertificateType": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          }
        }
      },
      "CreateUserMatchRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "integer",
            "nullable": true
          },
          "UserIdentityId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "CertificateType": {
            "type": "string"
          },
          "CourseCode": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          },
          "CourseLevel": {
            "type": "string"
          },
          "YearAwarded": {
            "type": "integer",
            "nullable": true
          },
          "ProviderName": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "nullable": true
          },
          "IsMatched": {
            "type": "boolean"
          },
          "IsFailed": {
            "type": "boolean"
          }
        }
      },
      "CreateUserAuthoriseRequest": {
        "type": "object",
        "required": [
          "Uln"
        ],
        "properties": {
          "Uln": {
            "type": "integer"
          }
        }
      }
    }
  }
}
