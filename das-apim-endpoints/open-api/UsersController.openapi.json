{
  "openapi": "3.1.0",
  "info": {
    "title": "Users API",
    "version": "1.0.0"
  },
  "paths": {
    "/users/{userId}/unlock": {
      "post": {
        "summary": "Unlock a user",
        "operationId": "UnlockUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the user to unlock"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnlockUserRequest"
              }
            }
          },
          "description": "Request body to unlock a user"
        },
        "responses": {
          "204": {
            "description": "User unlocked successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnlockUserRequest": {
        "type": "object",
        "properties": {
          "Username": {
            "type": "string",
            "description": "The username of the user to unlock"
          },
          "UserActionId": {
            "type": "integer",
            "format": "int64",
            "description": "The action ID associated with unlocking the user"
          }
        },
        "required": [
          "Username"
        ]
      }
    }
  }
}
