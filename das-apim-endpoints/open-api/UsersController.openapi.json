{
  "openapi": "3.1.0",
  "info": {
    "title": "ApimDeveloper Users API",
    "version": "1.0.0"
  },
  "paths": {
    "/users/{id}": {
      "post": {
        "summary": "Create User",
        "description": "Creates a new user.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully."
          },
          "400": {
            "description": "Bad Request."
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/users/{id}/activate": {
      "put": {
        "summary": "Activate User Account",
        "description": "Activates a user account.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the user."
          }
        ],
        "responses": {
          "204": {
            "description": "Account activation successful."
          },
          "400": {
            "description": "Bad Request."
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/users/authenticate": {
      "post": {
        "summary": "Authenticate User",
        "description": "Authenticates a user's credentials.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAuthenticationApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found."
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/users": {
      "get": {
        "summary": "Get User",
        "description": "Retrieves a user by email.",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            },
            "description": "Email address of the user."
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found."
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/users/{id}/send-change-password-email": {
      "post": {
        "summary": "Send Change Password Email",
        "description": "Sends an email to change password.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendChangePasswordEmailRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Email sent successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    },
    "/users/{id}/change-password": {
      "put": {
        "summary": "Change Password",
        "description": "Changes the user's password.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the user."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password change successful."
          },
          "400": {
            "description": "Bad Request."
          },
          "500": {
            "description": "Internal Server Error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Password": {
            "type": "string",
            "format": "password"
          },
          "ConfirmationEmailLink": {
            "type": "string"
          }
        },
        "required": [
          "FirstName",
          "LastName",
          "Email",
          "Password",
          "ConfirmationEmailLink"
        ]
      },
      "AuthenticateUserRequest": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "Email",
          "Password"
        ]
      },
      "SendChangePasswordEmailRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "ChangePasswordUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "FirstName",
          "LastName",
          "Email",
          "ChangePasswordUrl"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "Password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "Password"
        ]
      },
      "UserAuthenticationApiResponse": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "IsAuthenticated": {
            "type": "boolean"
          }
        }
      },
      "UserApiResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          }
        }
      }
    }
  }
}
