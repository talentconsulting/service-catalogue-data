{
  "openapi": "3.1.0",
  "info": {
    "title": "ApimDeveloper Users API",
    "version": "1.0.0"
  },
  "paths": {
    "/Users/{id}": {
      "post": {
        "summary": "Create a user",
        "operationId": "CreateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User successfully created"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/Users/{id}/activate": {
      "put": {
        "summary": "Activate an account",
        "operationId": "ActivateAccount",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Account successfully activated"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/Users/authenticate": {
      "post": {
        "summary": "Authenticate a user",
        "operationId": "AuthenticateUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authentication successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserAuthenticationApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/Users": {
      "get": {
        "summary": "Get a user",
        "operationId": "GetUser",
        "parameters": [
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/Users/{id}/send-change-password-email": {
      "post": {
        "summary": "Send email to change password",
        "operationId": "SendChangePasswordEmail",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendChangePasswordEmailRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Email successfully sent"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/Users/{id}/change-password": {
      "put": {
        "summary": "Change user password",
        "operationId": "ChangePassword",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password successfully changed"
          },
          "400": {
            "description": "Bad Request"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Password": {
            "type": "string",
            "format": "password"
          },
          "ConfirmationEmailLink": {
            "type": "string"
          }
        },
        "required": [
          "FirstName",
          "LastName",
          "Email",
          "Password",
          "ConfirmationEmailLink"
        ]
      },
      "AuthenticateUserRequest": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "Email",
          "Password"
        ]
      },
      "UserAuthenticationApiResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresIn": {
            "type": "integer"
          }
        },
        "required": [
          "token",
          "expiresIn"
        ]
      },
      "UserApiResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          }
        },
        "required": [
          "Id",
          "FirstName",
          "LastName",
          "Email"
        ]
      },
      "SendChangePasswordEmailRequest": {
        "type": "object",
        "properties": {
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "ChangePasswordUrl": {
            "type": "string"
          }
        },
        "required": [
          "FirstName",
          "LastName",
          "Email",
          "ChangePasswordUrl"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "properties": {
          "Password": {
            "type": "string",
            "format": "password"
          }
        },
        "required": [
          "Password"
        ]
      }
    }
  }
}
