{
  "openapi": "3.1.0",
  "info": {
    "title": "FindAnApprenticeship Users API",
    "version": "1.0.0",
    "description": "API for managing user-related operations in FindAnApprenticeship platform."
  },
  "paths": {
    "/users/{candidateId}/create-account/add-details": {
      "put": {
        "summary": "Add user details",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidatesNameModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Details added successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/users/{candidateId}/create-account/user-name": {
      "get": {
        "summary": "Get user name",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User name fetched successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/users/{candidateId}/create-account/date-of-birth": {
      "get": {
        "summary": "Get user date of birth",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Date of birth fetched successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "summary": "Add or update user date of birth",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidatesDateOfBirthModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Date of birth updated successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/users/{candidateId}/create-account/postcode": {
      "get": {
        "summary": "Get user postcode",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Postcode fetched successfully"
          },
          "404": {
            "description": "Postcode not found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/users/create-account/postcode-address": {
      "get": {
        "summary": "Get address by postcode",
        "parameters": [
          {
            "name": "postcode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Address fetched successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/users/{candidateId}/create-account/select-address": {
      "get": {
        "summary": "Get candidate addresses by postcode",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "postcode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Addresses fetched successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "summary": "Select candidate address",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidatesAddressModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Address selected successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/users/{candidateId}/create-account/phone-number": {
      "get": {
        "summary": "Get user phone number",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Phone number fetched successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "summary": "Add or update user phone number",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidatesPhoneNumberModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Phone number updated successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/users/{candidateId}/create-account/enter-address": {
      "post": {
        "summary": "Add manually entered address for user",
        "parameters": [
          {
            "name": "candidateId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CandidatesManuallyEnteredAddressModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Manually entered address added successfully"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CandidatesModel": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        },
        "required": [
          "email"
        ]
      },
      "CandidatesNameModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CandidatesModel"
          },
          {
            "type": "object",
            "properties": {
              "firstName": {
                "type": "string"
              },
              "lastName": {
                "type": "string"
              }
            },
            "required": [
              "firstName",
              "lastName"
            ]
          }
        ]
      },
      "CandidatesDateOfBirthModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CandidatesModel"
          },
          {
            "type": "object",
            "properties": {
              "dateOfBirth": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "dateOfBirth"
            ]
          }
        ]
      },
      "CandidatesPhoneNumberModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CandidatesModel"
          },
          {
            "type": "object",
            "properties": {
              "phoneNumber": {
                "type": "string"
              }
            },
            "required": [
              "phoneNumber"
            ]
          }
        ]
      },
      "CandidatesAddressModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CandidatesModel"
          },
          {
            "type": "object",
            "properties": {
              "uprn": {
                "type": "string"
              },
              "addressLine1": {
                "type": "string"
              },
              "addressLine2": {
                "type": "string"
              },
              "addressLine3": {
                "type": "string"
              },
              "addressLine4": {
                "type": "string"
              },
              "postcode": {
                "type": "string"
              }
            },
            "required": [
              "addressLine1",
              "postcode"
            ]
          }
        ]
      },
      "CandidatesManuallyEnteredAddressModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CandidatesModel"
          },
          {
            "type": "object",
            "properties": {
              "addressLine1": {
                "type": "string"
              },
              "addressLine2": {
                "type": "string"
              },
              "townOrCity": {
                "type": "string"
              },
              "county": {
                "type": "string"
              },
              "postcode": {
                "type": "string"
              }
            },
            "required": [
              "addressLine1",
              "townOrCity",
              "county",
              "postcode"
            ]
          }
        ]
      }
    }
  }
}
