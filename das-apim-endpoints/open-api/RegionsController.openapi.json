{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Request Apprentice Training API",
    "description": "API for managing regions and apprentice training requests.",
    "version": "1.0.0"
  },
  "paths": {
    "/regions": {
      "get": {
        "summary": "Get all regions",
        "description": "Retrieves a list of all regions.",
        "responses": {
          "200": {
            "description": "Successfully retrieved regions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Region"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No regions found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/regions/closest": {
      "get": {
        "summary": "Get closest region",
        "description": "Retrieves the closest region to a specified location name.",
        "parameters": [
          {
            "name": "locationName",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The name of the location to find the closest region for."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the closest region.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Region"
                }
              }
            }
          },
          "404": {
            "description": "No location or region found."
          },
          "400": {
            "description": "Bad request. Could not process the location name."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Region": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the region."
          },
          "name": {
            "type": "string",
            "description": "Name of the region."
          }
        }
      }
    }
  }
}
