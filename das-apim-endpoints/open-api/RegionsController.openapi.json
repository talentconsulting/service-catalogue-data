{
  "openapi": "3.1.0",
  "info": {
    "title": "SFA DAS Apprentice Aan API",
    "version": "1.0.0"
  },
  "paths": {
    "/Regions": {
      "get": {
        "tags": [
          "Regions"
        ],
        "summary": "Get list of regions",
        "operationId": "GetRegions",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRegionsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRegionsQueryResult": {
        "type": "object",
        "properties": {
          "regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        }
      },
      "Region": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "area": {
            "type": "string",
            "example": "North West"
          },
          "ordering": {
            "type": "integer",
            "example": 1
          }
        }
      }
    }
  }
}
