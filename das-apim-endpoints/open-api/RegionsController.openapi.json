{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan Regions API",
    "version": "1.0.0"
  },
  "paths": {
    "/Regions": {
      "get": {
        "summary": "Retrieve the list of regions",
        "operationId": "GetRegions",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRegionsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRegionsQueryResult": {
        "type": "object",
        "properties": {
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        },
        "required": [
          "Regions"
        ]
      },
      "Region": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique identifier of the region"
          },
          "Area": {
            "type": "string",
            "description": "Name of the area"
          },
          "Ordering": {
            "type": "integer",
            "description": "Ordering rank of the region"
          }
        },
        "required": [
          "Id",
          "Area",
          "Ordering"
        ]
      }
    }
  }
}
