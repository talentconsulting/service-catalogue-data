{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAan API",
    "version": "1.0.0",
    "description": "API for managing regions in the AdminAan system."
  },
  "paths": {
    "/Regions": {
      "get": {
        "summary": "Get all regions",
        "operationId": "getRegions",
        "responses": {
          "200": {
            "description": "Successfully retrieved regions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRegionsQueryResult"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "cancellationToken",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Token for cancelling the request."
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "GetRegionsQueryResult": {
        "type": "object",
        "properties": {
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        }
      },
      "Region": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Area": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "Id",
          "Area",
          "Ordering"
        ]
      }
    }
  }
}
