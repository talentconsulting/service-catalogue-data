{
  "openapi": "3.1.0",
  "info": {
    "title": "Regions API",
    "version": "1.0.0",
    "description": "API for retrieving region information."
  },
  "paths": {
    "/Regions": {
      "get": {
        "summary": "Get list of regions",
        "operationId": "GetRegions",
        "responses": {
          "200": {
            "description": "Successful response with regions list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRegionsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Region": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique identifier for the region."
          },
          "Area": {
            "type": "string",
            "description": "Name of the region area."
          },
          "Ordering": {
            "type": "integer",
            "description": "Ordering index of the region."
          }
        },
        "required": [
          "Id",
          "Area",
          "Ordering"
        ]
      },
      "GetRegionsQueryResult": {
        "type": "object",
        "properties": {
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        },
        "required": [
          "Regions"
        ]
      }
    }
  }
}
