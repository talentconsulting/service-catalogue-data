{
  "openapi": "3.1.0",
  "info": {
    "title": "Regions API",
    "version": "1.0.0",
    "description": "API for managing regions."
  },
  "paths": {
    "/Regions": {
      "get": {
        "summary": "Get list of regions",
        "description": "Retrieves a list of regions.",
        "operationId": "GetRegions",
        "responses": {
          "200": {
            "description": "A successful response with the list of regions.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRegionsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRegionsQueryResult": {
        "type": "object",
        "properties": {
          "Regions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Region"
            }
          }
        }
      },
      "Region": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique ID of the region."
          },
          "Area": {
            "type": "string",
            "description": "Name of the area."
          },
          "Ordering": {
            "type": "integer",
            "description": "Order of the region for sorting purposes."
          }
        },
        "required": [
          "Id",
          "Area",
          "Ordering"
        ]
      }
    }
  }
}
