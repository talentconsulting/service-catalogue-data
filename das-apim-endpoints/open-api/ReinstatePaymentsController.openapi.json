{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/reinstate-payments": {
      "post": {
        "summary": "Reinstate payments",
        "operationId": "reinstatePayments",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReinstatePaymentsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payments reinstated successfully"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReinstatePaymentsRequest": {
        "type": "object",
        "properties": {
          "Payments": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "ServiceRequest": {
            "$ref": "#/components/schemas/ReinstatePaymentsServiceRequest"
          }
        },
        "required": [
          "Payments",
          "ServiceRequest"
        ]
      },
      "ReinstatePaymentsServiceRequest": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "string"
          },
          "DecisionReference": {
            "type": "string"
          },
          "TaskCreatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "Process": {
            "type": "string"
          }
        },
        "required": [
          "TaskId",
          "DecisionReference"
        ]
      }
    }
  }
}
