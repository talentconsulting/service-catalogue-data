{
  "openapi": "3.1.0",
  "info": {
    "title": "Find Apprenticeship Training API",
    "version": "1.0.0"
  },
  "paths": {
    "/Providers": {
      "get": {
        "operationId": "GetProviders",
        "summary": "Retrieve all RoATP providers",
        "tags": [
          "Providers"
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of providers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRoatpProvidersQueryResult"
                }
              }
            }
          }
        }
      }
    },
    "/Providers/{ukprn}": {
      "get": {
        "operationId": "GetProviderSummary",
        "summary": "Retrieve summary information for a provider",
        "tags": [
          "Providers"
        ],
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of provider summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderSummaryQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Provider not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRoatpProvidersQueryResult": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoatpProvider"
            }
          }
        }
      },
      "RoatpProvider": {
        "type": "object",
        "additionalProperties": true
      },
      "GetProviderSummaryQueryResult": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "ProviderAddress": {
            "$ref": "#/components/schemas/ProviderAddressDetails"
          },
          "Contact": {
            "$ref": "#/components/schemas/ContactDetails"
          },
          "Qar": {
            "$ref": "#/components/schemas/ProviderQarModel"
          },
          "Reviews": {
            "$ref": "#/components/schemas/ReviewsModel"
          },
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseDetails"
            }
          },
          "EndpointAssessments": {
            "$ref": "#/components/schemas/EndpointAssessmentsDetails"
          },
          "AnnualEmployerFeedbackDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmployerFeedbackStarsAnnualSummary"
            }
          },
          "AnnualApprenticeFeedbackDetails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeFeedbackStarsAnnualSummary"
            }
          }
        }
      },
      "ProviderAddressDetails": {
        "type": "object",
        "properties": {
          "AddressLine1": {
            "type": "string"
          },
          "AddressLine2": {
            "type": "string"
          },
          "AddressLine3": {
            "type": "string"
          },
          "AddressLine4": {
            "type": "string"
          },
          "Town": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          }
        }
      },
      "ContactDetails": {
        "type": "object",
        "properties": {
          "MarketingInfo": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "format": "email"
          },
          "PhoneNumber": {
            "type": "string"
          },
          "Website": {
            "type": "string"
          }
        }
      },
      "ProviderQarModel": {
        "type": "object",
        "additionalProperties": true
      },
      "ReviewsModel": {
        "type": "object",
        "additionalProperties": true
      },
      "CourseDetails": {
        "type": "object",
        "properties": {
          "CourseName": {
            "type": "string"
          },
          "CourseType": {
            "$ref": "#/components/schemas/CourseType"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "Level": {
            "type": "integer"
          },
          "LarsCode": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          }
        }
      },
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "EndpointAssessmentsDetails": {
        "type": "object",
        "properties": {
          "EarliestAssessment": {
            "type": "string",
            "format": "date-time"
          },
          "EndpointAssessmentCount": {
            "type": "integer"
          }
        }
      },
      "EmployerFeedbackStarsAnnualSummary": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "Stars": {
            "type": "integer"
          },
          "ReviewCount": {
            "type": "integer"
          },
          "TimePeriod": {
            "type": "string"
          },
          "ProviderAttribute": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "ApprenticeFeedbackStarsAnnualSummary": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "Stars": {
            "type": "integer"
          },
          "ReviewCount": {
            "type": "integer"
          },
          "TimePeriod": {
            "type": "string"
          },
          "ProviderAttribute": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "NotFoundResult": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
