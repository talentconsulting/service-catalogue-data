{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/Provider/{ApprenticeId}": {
      "get": {
        "operationId": "GetApprenticeTrainingProviders",
        "summary": "Get a list of training providers for a given apprentice.",
        "parameters": [
          {
            "name": "ApprenticeId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the apprentice.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with a list of training providers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeTrainingProvidersResult"
                }
              }
            }
          }
        }
      }
    },
    "/Provider/{ApprenticeId}/{Ukprn}": {
      "get": {
        "operationId": "GetApprenticeTrainingProvider",
        "summary": "Get details of a specific training provider for a given apprentice.",
        "parameters": [
          {
            "name": "ApprenticeId",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the apprentice.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Ukprn",
            "in": "path",
            "required": true,
            "description": "Unique identifier of the training provider.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with details of a specific training provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeTrainingProviderResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeTrainingProvidersResult": {
        "type": "object",
        "properties": {
          "RecentDenyPeriodDays": {
            "type": "integer",
            "description": "Number of days for the recent deny feedback period."
          },
          "InitialDenyPeriodDays": {
            "type": "integer",
            "description": "Number of days for the initial deny feedback period."
          },
          "FinalAllowedPeriodDays": {
            "type": "integer",
            "description": "Number of days for the final allowed feedback period."
          },
          "TrainingProviders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProvider"
            }
          }
        }
      },
      "GetApprenticeTrainingProviderResult": {
        "type": "object",
        "properties": {
          "TrainingProvider": {
            "$ref": "#/components/schemas/TrainingProvider"
          }
        }
      },
      "TrainingProvider": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid",
            "description": "Unique identifier for the feedback target associated with the training provider."
          },
          "ProviderName": {
            "type": "string",
            "description": "Name of the training provider."
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the training provider."
          },
          "LarsCode": {
            "type": "integer",
            "description": "LARS code associated with the training provider."
          },
          "LastFeedbackSubmittedDate": {
            "type": "string",
            "format": "date-time",
            "description": "Date of the last feedback submitted for the training provider."
          },
          "TimeWindow": {
            "type": "string",
            "format": "duration",
            "description": "Time window for feedback submission."
          },
          "SignificantDate": {
            "type": "string",
            "format": "date-time",
            "description": "A notable date related to the training provider."
          },
          "FeedbackEligibility": {
            "type": "string",
            "description": "Feedback eligibility status for the training provider."
          }
        }
      }
    }
  }
}
