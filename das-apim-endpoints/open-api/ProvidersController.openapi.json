{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/": {
      "get": {
        "summary": "Get all providers",
        "operationId": "getProviders",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{ukprn}/users": {
      "get": {
        "summary": "Get users for a provider",
        "operationId": "getProviderUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersUsersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{providerId}/courses/{trainingCode}": {
      "get": {
        "summary": "Get provider course delivery model",
        "operationId": "getProviderCourseDeliveryModel",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "trainingCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDeliveryModelsQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "deprecated": true
      }
    },
    "/providers/{providerId}/courses": {
      "get": {
        "summary": "Get provider courses delivery model by query parameters",
        "operationId": "getProviderCourseDeliveryModelByQuery",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "trainingCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDeliveryModelsQueryResult"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/providers/{ukprn}/emails": {
      "post": {
        "summary": "Send emails to provider users",
        "operationId": "emailProviderUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent successfully"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{ukprn}/status": {
      "get": {
        "summary": "Get provider status",
        "operationId": "getProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountDetailsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersListResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetProvidersResponse"
            }
          }
        }
      },
      "GetProvidersResponse": {
        "type": "object",
        "additionalProperties": true
      },
      "GetProvidersUsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "GetDeliveryModelsQueryResult": {
        "type": "object",
        "additionalProperties": true
      },
      "ProviderEmailRequest": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string"
          },
          "tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "explicitEmailAddresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProviderAccountDetailsResponse": {
        "type": "object",
        "properties": {
          "providerStatusTypeId": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
