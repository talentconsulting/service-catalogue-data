{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers API",
    "version": "1.0.0",
    "description": "API for managing providers and their related data such as delivery models, courses, users, and statuses."
  },
  "paths": {
    "/providers/": {
      "get": {
        "summary": "Get all providers",
        "operationId": "GetAllProviders",
        "responses": {
          "200": {
            "description": "A list of providers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{ukprn}/users": {
      "get": {
        "summary": "Get users for a provider",
        "operationId": "GetProviderUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Users for the specified provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersUsersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{providerId}/courses/{trainingCode}": {
      "get": {
        "summary": "Get delivery models for a provider's course",
        "operationId": "GetProviderCoursesDeliveryModel",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "trainingCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery models for the specified course",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "deprecated": true
      }
    },
    "/providers/{providerId}/courses": {
      "get": {
        "summary": "Get delivery models using a query",
        "operationId": "GetProviderCoursesDeliveryModelByQuery",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "trainingCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delivery models for the specified query",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/providers/{ukprn}/emails": {
      "post": {
        "summary": "Send an email to provider users",
        "operationId": "EmailUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email sent successfully"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{ukprn}/status": {
      "get": {
        "summary": "Get provider status",
        "operationId": "GetProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountDetailsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersListResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetProvidersResponse"
            }
          }
        }
      },
      "GetProvidersResponse": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "providerName": {
            "type": "string"
          }
        }
      },
      "GetProvidersUsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "integer"
                },
                "userName": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ProviderEmailRequest": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string"
          },
          "tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "explicitEmailAddresses": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          }
        }
      },
      "ProviderAccountDetailsResponse": {
        "type": "object",
        "properties": {
          "providerStatusTypeId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
