{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers API",
    "version": "1.0.0"
  },
  "paths": {
    "/Providers/": {
      "get": {
        "summary": "Retrieve all providers",
        "operationId": "GetAllProviders",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/Providers/{ukprn}/users": {
      "get": {
        "summary": "Retrieve all users for a provider",
        "operationId": "GetProviderUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersUsersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/Providers/{providerId}/courses/{trainingCode}": {
      "get": {
        "summary": "Retrieve delivery models for a specific provider course",
        "operationId": "GetProviderCoursesDeliveryModel",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "trainingCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "deprecated": true
      }
    },
    "/Providers/{providerId}/courses": {
      "get": {
        "summary": "Retrieve delivery models for a provider using query parameters",
        "operationId": "GetProviderCoursesDeliveryModelByQuery",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "trainingCode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/Providers/{ukprn}/emails": {
      "post": {
        "summary": "Send emails to provider users",
        "operationId": "EmailProviderUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/Providers/{ukprn}/status": {
      "get": {
        "summary": "Retrieve provider status",
        "operationId": "GetProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountDetailsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersListResponse": {
        "type": "object",
        "properties": {
          "Providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetProvidersResponse"
            }
          }
        }
      },
      "GetProvidersResponse": {
        "type": "object",
        "properties": {}
      },
      "GetProvidersUsersResponse": {
        "type": "object",
        "properties": {
          "Users": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "ProviderEmailRequest": {
        "type": "object",
        "properties": {
          "TemplateId": {
            "type": "string"
          },
          "Tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "ExplicitEmailAddresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ProviderAccountDetailsResponse": {
        "type": "object",
        "properties": {
          "ProviderStatusTypeId": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
