{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/": {
      "get": {
        "operationId": "getAllProviders",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{ukprn}/users": {
      "get": {
        "operationId": "getProviderUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProvidersUsersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{providerId}/courses/{trainingCode}": {
      "get": {
        "operationId": "getProviderCoursesDeliveryModel",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "trainingCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "deprecated": true,
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDeliveryModelsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/providers/{providerId}/courses": {
      "get": {
        "operationId": "getProviderCoursesDeliveryModelByQuery",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "trainingCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDeliveryModelsResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/providers/{ukprn}/emails": {
      "post": {
        "operationId": "emailProviderUsers",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/providers/{ukprn}/status": {
      "get": {
        "operationId": "getProviderStatus",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderAccountDetailsResponse"
                }
              }
            },
            "500": {
              "description": "Internal Server Error"
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProvidersListResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetProvidersResponse"
            }
          }
        }
      },
      "GetProvidersResponse": {
        "type": "object"
      },
      "GetProvidersUsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GetDeliveryModelsResponse": {
        "type": "object"
      },
      "ProviderEmailRequest": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string"
          },
          "tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "explicitEmailAddresses": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "email"
            }
          }
        },
        "required": [
          "templateId",
          "tokens"
        ]
      },
      "ProviderAccountDetailsResponse": {
        "type": "object",
        "properties": {
          "providerStatusTypeId": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
