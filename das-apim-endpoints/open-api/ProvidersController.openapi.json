{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers API",
    "description": "Provides API endpoints for retrieving information about registered providers.",
    "version": "1.0.0"
  },
  "paths": {
    "/providers": {
      "get": {
        "summary": "Retrieve registered providers",
        "operationId": "getProviders",
        "description": "Retrieves the list of registered providers.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersApiResponse"
                }
              }
            }
          }
        },
        "tags": [
          "Providers"
        ]
      }
    },
    "/providers/status-events": {
      "get": {
        "summary": "Retrieve provider status events",
        "operationId": "getProviderStatusEvents",
        "description": "Retrieves a paginated list of provider status events that have occurred since the specified event ID.",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": false,
            "description": "The ID of the last received event. Only events with an ID greater than this value are returned.",
            "schema": {
              "type": "integer",
              "minimum": 0
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "The maximum number of events to return in the response. Defaults to 1000.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "description": "The page number of results to retrieve. Defaults to 1.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderStatusEvent"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Provider Status Events"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProvidersApiResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        }
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "description": "UKPRN of the provider."
          },
          "name": {
            "type": "string",
            "description": "Registered name of the provider."
          },
          "tradingName": {
            "type": "string",
            "description": "Registered trading name of the provider."
          },
          "providerTypeId": {
            "type": "integer",
            "description": "Provider type ID.",
            "enum": [
              0,
              1,
              2
            ],
            "example": 0
          },
          "statusId": {
            "type": "integer",
            "description": "Status ID of the provider.",
            "enum": [
              0,
              1,
              2
            ],
            "example": 0
          },
          "canAccessApprenticeshipService": {
            "type": "boolean",
            "description": "Indicates if provider can access apprenticeship services."
          }
        }
      },
      "ProviderStatusEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the event."
          },
          "providerId": {
            "type": "integer",
            "description": "Identifier for the provider associated with the event."
          },
          "event": {
            "type": "string",
            "description": "Description of the event."
          },
          "createdOn": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the event occurred."
          }
        }
      }
    }
  }
}
