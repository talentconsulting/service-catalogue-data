{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers API",
    "version": "1.0.0",
    "description": "API endpoints for retrieving information about registered providers."
  },
  "paths": {
    "/providers": {
      "get": {
        "operationId": "GetProviders",
        "summary": "Retrieves the list of registered providers.",
        "responses": {
          "200": {
            "description": "A collection of registered providers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/status-events": {
      "get": {
        "operationId": "GetProviderStatusEvents",
        "summary": "Retrieves a paginated list of provider status events.",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "description": "The ID of the last received event. Events with an ID greater than this value are returned."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1000
            },
            "description": "Maximum number of events to return."
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number of results to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "A paginated collection of provider status events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderStatusEvent"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProvidersApiResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        },
        "required": [
          "providers"
        ]
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "description": "UK Provider Reference Number"
          },
          "name": {
            "type": "string",
            "description": "Legal name of the provider."
          },
          "tradingName": {
            "type": "string",
            "description": "Trading name of the provider."
          },
          "providerTypeId": {
            "type": "integer",
            "description": "Provider Type."
          },
          "statusId": {
            "type": "integer",
            "description": "Provider status."
          },
          "canAccessApprenticeshipService": {
            "type": "boolean",
            "description": "Indicates whether the provider can access the Apprenticeship Service."
          }
        },
        "required": [
          "ukprn",
          "name",
          "tradingName",
          "providerTypeId",
          "statusId",
          "canAccessApprenticeshipService"
        ]
      },
      "ProviderStatusEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Event identifier."
          },
          "providerId": {
            "type": "integer",
            "description": "ID of the provider."
          },
          "event": {
            "type": "string",
            "description": "Description of the event."
          },
          "createdOn": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when the event was created."
          }
        },
        "required": [
          "id",
          "providerId",
          "event",
          "createdOn"
        ]
      }
    }
  }
}
