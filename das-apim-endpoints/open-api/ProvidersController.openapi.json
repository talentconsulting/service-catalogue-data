{
  "openapi": "3.1.0",
  "info": {
    "title": "Providers API",
    "description": "Provides API endpoints for retrieving information about registered providers.",
    "version": "1.0.0"
  },
  "paths": {
    "/providers": {
      "get": {
        "summary": "Retrieves the list of registered providers.",
        "operationId": "GetProviders",
        "tags": [
          "Providers"
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the list of registered providers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersApiResponse"
                }
              }
            }
          }
        }
      }
    },
    "/providers/status-events": {
      "get": {
        "summary": "Retrieves a paginated list of provider status events since a specific event ID.",
        "operationId": "GetProviderStatusEvents",
        "tags": [
          "Providers"
        ],
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 0
            },
            "description": "The ID of the last received event. Only events with an ID greater than this value are returned."
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1000,
              "minimum": 1,
              "maximum": 1000
            },
            "description": "The maximum number of events to return in the response. Defaults to 1000."
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "The page number of results to retrieve. Defaults to 1."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the provider status events.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderStatusEvent"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProvidersApiResponse": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderModel"
            }
          }
        },
        "required": [
          "providers"
        ]
      },
      "ProviderModel": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "description": "The UKPRN of the provider."
          },
          "name": {
            "type": "string",
            "description": "The registered name of the provider."
          },
          "tradingName": {
            "type": "string",
            "description": "The trading name of the provider."
          },
          "providerTypeId": {
            "type": "integer",
            "description": "The type of the provider. 0 -> Main, 1 -> Employer, 2 -> Supporting."
          },
          "statusId": {
            "type": "integer",
            "description": "The status of the provider. 0 -> Active, 1 -> Active but not taking on apprentices, 2 -> Onboarding."
          },
          "canAccessApprenticeshipService": {
            "type": "boolean",
            "description": "Indicates whether the provider can access apprenticeship services."
          }
        },
        "required": [
          "ukprn",
          "name",
          "tradingName",
          "providerTypeId",
          "statusId",
          "canAccessApprenticeshipService"
        ]
      },
      "ProviderStatusEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The unique identifier of the status event."
          },
          "providerId": {
            "type": "integer",
            "description": "The UKPRN of the provider associated with the event."
          },
          "event": {
            "type": "string",
            "description": "The type of the event."
          },
          "createdOn": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the event was created."
          }
        },
        "required": [
          "id",
          "providerId",
          "event",
          "createdOn"
        ]
      }
    }
  }
}
