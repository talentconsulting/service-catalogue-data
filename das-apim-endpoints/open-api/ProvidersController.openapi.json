{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeFeedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/Provider/{ApprenticeId}": {
      "get": {
        "summary": "Retrieve training providers for an apprentice",
        "operationId": "GetApprenticeTrainingProviders",
        "parameters": [
          {
            "name": "ApprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeTrainingProvidersResult"
                }
              }
            }
          }
        }
      }
    },
    "/Provider/{ApprenticeId}/{Ukprn}": {
      "get": {
        "summary": "Retrieve a specific training provider for an apprentice",
        "operationId": "GetApprenticeTrainingProvider",
        "parameters": [
          {
            "name": "ApprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeTrainingProviderResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeTrainingProvidersResult": {
        "type": "object",
        "properties": {
          "RecentDenyPeriodDays": {
            "type": "integer",
            "format": "int32"
          },
          "InitialDenyPeriodDays": {
            "type": "integer",
            "format": "int32"
          },
          "FinalAllowedPeriodDays": {
            "type": "integer",
            "format": "int32"
          },
          "TrainingProviders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TrainingProvider"
            }
          }
        }
      },
      "GetApprenticeTrainingProviderResult": {
        "type": "object",
        "properties": {
          "TrainingProvider": {
            "$ref": "#/components/schemas/TrainingProvider"
          }
        }
      },
      "TrainingProvider": {
        "type": "object",
        "properties": {
          "ApprenticeFeedbackTargetId": {
            "type": "string",
            "format": "uuid"
          },
          "ProviderName": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "LarsCode": {
            "type": "integer",
            "format": "int32"
          },
          "LastFeedbackSubmittedDate": {
            "type": "string",
            "format": "date-time"
          },
          "TimeWindow": {
            "type": "string",
            "format": "duration"
          },
          "SignificantDate": {
            "type": "string",
            "format": "date-time"
          },
          "FeedbackEligibility": {
            "type": "string",
            "enum": [
              "Eligible",
              "NotEligible"
            ]
          }
        }
      }
    }
  }
}
