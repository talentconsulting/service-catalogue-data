{
  "openapi": "3.1.0",
  "info": {
    "title": "Disability Confident API",
    "version": "1.0.0",
    "description": "API endpoints for managing Disability Confident applications."
  },
  "paths": {
    "/applications/{applicationId}/disability-confident": {
      "get": {
        "summary": "Get Disability Confident status",
        "operationId": "getDisabilityConfident",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the application."
          },
          {
            "name": "candidateId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the candidate."
          }
        ],
        "responses": {
          "200": {
            "description": "Disability Confident status retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDisabilityConfidentApiResponse"
                }
              }
            }
          },
          "404": {
            "description": "Disability Confident status not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "summary": "Update Disability Confident status",
        "operationId": "postDisabilityConfident",
        "parameters": [
          {
            "name": "applicationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the application."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostDisabilityConfidentApiRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Disability Confident status updated successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/applications/{applicationId}/disability-confident/details": {
