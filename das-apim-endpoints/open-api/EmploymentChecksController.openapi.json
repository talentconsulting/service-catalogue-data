{
  "openapi": "3.1.0",
  "info": {
    "title": "Employment Checks API",
    "version": "1.0.0"
  },
  "paths": {
    "/EmploymentChecks/": {
      "get": {
        "summary": "Get employment checks",
        "description": "Returns employment checks for given apprenticeship IDs.",
        "operationId": "getEmploymentChecks",
        "parameters": [
          {
            "name": "apprenticeshipIds",
            "in": "query",
            "description": "List of apprenticeship IDs (maximum 50).",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              },
              "maxItems": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employment checks retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmploymentChecksResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetEmploymentChecksResponse": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EmploymentCheck"
            }
          }
        }
      },
      "EmploymentCheck": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string"
          },
          "details": {
            "type": "string"
          }
        }
      }
    }
  }
}
