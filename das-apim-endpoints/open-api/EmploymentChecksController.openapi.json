{
  "openapi": "3.1.0",
  "info": {
    "title": "Employment Checks API",
    "version": "1.0.0",
    "description": "API for managing employment checks related to apprenticeships."
  },
  "paths": {
    "/EmploymentChecks": {
      "get": {
        "summary": "Retrieve Employment Checks",
        "description": "Fetch employment checks for specific apprenticeship IDs.",
        "operationId": "GetEmploymentChecks",
        "parameters": [
          {
            "name": "apprenticeshipIds",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              },
              "minItems": 1,
              "maxItems": 50
            },
            "description": "List of apprenticeship IDs (max 50)."
          }
        ],
        "responses": {
          "200": {
            "description": "Employment checks retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmploymentChecksQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request. Invalid or missing parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetEmploymentChecksQueryResponse": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the apprenticeship."
          },
          "employmentChecks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "$ref": "#/components/schemas/DataLockStatus"
                },
                "timestamp": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Timestamp of the check."
                }
              }
            }
          }
        }
      },
      "DataLockStatus": {
        "type": "string",
        "enum": [
          "Unknown",
          "Pass",
          "Fail"
        ],
        "description": "Status of the employment check."
      }
    }
  }
}
