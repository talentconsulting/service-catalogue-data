{
  "openapi": "3.1.0",
  "info": {
    "title": "Employment Checks API",
    "version": "1.0.0"
  },
  "paths": {
    "/EmploymentChecks/": {
      "get": {
        "summary": "Retrieve employment checks for given apprenticeship IDs.",
        "description": "Fetches employment check results given a list of apprenticeship IDs.",
        "parameters": [
          {
            "name": "apprenticeshipIds",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int64"
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with employment check results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEmploymentChecksQueryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to invalid or missing data."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetEmploymentChecksQueryResponse": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "employmentCheckPassed": {
            "type": "boolean"
          },
          "errorDetails": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "apprenticeshipId",
          "employmentCheckPassed"
        ]
      }
    }
  }
}
