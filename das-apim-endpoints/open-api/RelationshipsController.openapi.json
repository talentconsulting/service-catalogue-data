{
  "openapi": "3.1.0",
  "info": {
    "title": "EmployerPR API",
    "version": "1.0.0"
  },
  "paths": {
    "/Relationships": {
      "get": {
        "operationId": "GetRelationships",
        "summary": "Retrieve a list of relationships",
        "parameters": [
          {
            "name": "Ukprn",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "nullable": true
            },
            "description": "UK Provider Reference Number"
          },
          {
            "name": "AccountLegalEntityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            },
            "description": "Account legal entity identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetRelationshipsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetRelationshipsResponse": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "ProviderName": {
            "type": "string"
          },
          "Operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Operation"
            }
          },
          "LastAction": {
            "$ref": "#/components/schemas/PermissionAction"
          },
          "LastActionTime": {
            "type": "string",
            "format": "date-time"
          },
          "LastRequestType": {
            "type": "string",
            "nullable": true
          },
          "LastRequestTime": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "LastRequestStatus": {
            "$ref": "#/components/schemas/RequestStatus"
          },
          "LastRequestOperations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Operation"
            },
            "nullable": true
          }
        },
        "required": [
          "AccountLegalEntityId",
          "AccountLegalEntityPublicHashedId",
          "AccountLegalEntityName",
          "AccountId",
          "Ukprn",
          "ProviderName",
          "Operations"
        ]
      },
      "Operation": {
        "type": "string",
        "enum": [
          "CreateCohort",
          "Recruitment",
          "RecruitmentRequiresReview"
        ]
      },
      "PermissionAction": {
        "type": "string",
        "enum": [
          "ApprovalsRelationship",
          "RecruitRelationship",
          "PermissionCreated",
          "PermissionUpdated",
          "PermissionDeleted",
          "AccountCreated",
          "AccountAdded"
        ]
      },
      "RequestStatus": {
        "type": "string",
        "enum": [
          "New",
          "Sent",
          "Accepted",
          "Declined",
          "Expired",
          "Deleted"
        ]
      }
    }
  }
}
