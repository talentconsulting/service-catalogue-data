{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0"
  },
  "paths": {
    "/DataLock/statuses": {
      "get": {
        "summary": "Get Data Lock Statuses",
        "description": "Retrieves data lock statuses filtered by parameters.",
        "operationId": "GetDataLockStatuses",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Filter data lock statuses since the provided event ID."
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Filter data lock statuses since the provided time."
          },
          {
            "name": "employerAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The employer account ID linked to the data lock statuses."
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The UKPRN (UK Provider Reference Number) to filter statuses."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            },
            "description": "The page number for paginated results. Defaults to 1."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved data lock statuses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockStatusListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request. The query parameters may be invalid."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLockStatusListResponse": {
        "type": "object",
        "properties": {
          "TotalNumberOfPages": {
            "type": "integer",
            "format": "int32",
            "description": "Total number of pages available for paginated results."
          },
          "DataLockStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDataLockStatusResponse"
            },
            "description": "List of data lock statuses."
          }
        }
      },
      "GetDataLockStatusResponse": {
        "type": "object",
        "description": "Representing a single data lock status."
      }
    }
  }
}
