{
  "openapi": "3.1.0",
  "info": {
    "title": "DataLock API",
    "version": "1.0.0"
  },
  "paths": {
    "/DataLock/statuses": {
      "get": {
        "summary": "Retrieve DataLock statuses",
        "operationId": "GetDataLockStatuses",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "employerAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of DataLock statuses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockStatusListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLockStatusListResponse": {
        "type": "object",
        "properties": {
          "totalNumberOfPages": {
            "type": "integer",
            "format": "int32"
          },
          "dataLockStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDataLockStatusResponse"
            }
          }
        }
      },
      "GetDataLockStatusResponse": {
        "type": "object"
      }
    }
  }
}
