{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "description": "API for managing Data Lock Events and related operations",
    "version": "1.0.0"
  },
  "paths": {
    "/DataLock/statuses": {
      "get": {
        "summary": "Retrieve Data Lock Statuses",
        "operationId": "GetDataLockStatuses",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The starting event ID for filtering"
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "The starting point in time for filtering"
          },
          {
            "name": "employerAccountId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The employer account ID for filtering"
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The UK Provider Reference Number (UKPRN)"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "The page number for pagination"
          }
        ],
        "responses": {
          "200": {
            "description": "Data Lock statuses successfully retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockStatusListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLockStatusListResponse": {
        "type": "object",
        "properties": {
          "TotalNumberOfPages": {
            "type": "integer",
            "description": "The total number of pages available"
          },
          "DataLockStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDataLockStatusResponse"
            },
            "description": "List of data lock statuses"
          }
        }
      },
      "GetDataLockStatusResponse": {
        "type": "object",
        "description": "Representation of a single data lock status"
      }
    }
  }
}
