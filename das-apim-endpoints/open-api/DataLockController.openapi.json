{
  "openapi": "3.1.0",
  "info": {
    "title": "Approvals API",
    "version": "1.0.0",
    "description": "API for managing data locks in SFA DAS Approvals."
  },
  "paths": {
    "/datalock/statuses": {
      "get": {
        "summary": "Get Data Lock Statuses",
        "description": "Retrieve data lock statuses based on query parameters.",
        "parameters": [
          {
            "name": "sinceEventId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sinceTime",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "employerAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDataLockStatusListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetDataLockStatusListResponse": {
        "type": "object",
        "properties": {
          "totalNumberOfPages": {
            "type": "integer"
          },
          "dataLockStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetDataLockStatusResponse"
            }
          }
        }
      },
      "GetDataLockStatusResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/DataLockStatus"
          },
          "details": {
            "type": "string"
          }
        }
      },
      "DataLockStatus": {
        "type": "string",
        "enum": [
          "Unknown",
          "Pass",
          "Fail"
        ]
      }
    }
  }
}
