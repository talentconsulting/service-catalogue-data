{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Course Types API",
    "version": "1.0.0",
    "description": "API for managing provider course types."
  },
  "paths": {
    "/providers/{ukprn}/course-types/{courseType}/restrict": {
      "post": {
        "summary": "Restrict Provider",
        "description": "Restricts a provider for a specific course type.",
        "operationId": "RestrictProvider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The unique provider reference number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "courseType",
            "in": "path",
            "required": true,
            "description": "The type of course to restrict.",
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            }
          }
        ],
        "requestBody": {
          "description": "Restrict provider request payload.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictProviderModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content - The provider restriction was successful."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ],
        "description": "Enumeration of course types."
      },
      "RestrictProviderModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "The ID of the user performing the restriction."
          },
          "UserDisplayName": {
            "type": "string",
            "description": "The display name of the user performing the restriction."
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ],
        "description": "Model for restricting a provider."
      }
    }
  }
}
