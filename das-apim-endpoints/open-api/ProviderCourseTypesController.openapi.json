{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Course Types API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/course-types/{courseType}/restrict": {
      "post": {
        "summary": "Restrict a provider course type",
        "operationId": "restrictProviderCourseType",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "UKPRN identifier for the provider"
          },
          {
            "name": "courseType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            },
            "description": "The course type to restrict"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictProviderModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content",
            "content": {}
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ],
        "description": "The course type enum"
      },
      "RestrictProviderModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "The identifier of the user making the request"
          },
          "UserDisplayName": {
            "type": "string",
            "description": "The display name of the user making the request"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ],
        "description": "Model to restrict a provider for a specific course type"
      }
    }
  }
}
