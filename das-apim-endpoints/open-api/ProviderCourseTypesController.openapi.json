{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Course Types API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/course-types/{courseType}/restrict": {
      "post": {
        "summary": "Restrict a provider for a specific course type",
        "operationId": "RestrictProvider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "courseType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictProviderModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ]
      },
      "RestrictProviderModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ]
      }
    }
  }
}
