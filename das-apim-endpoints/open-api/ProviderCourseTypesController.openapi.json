{
  "openapi": "3.1.0",
  "info": {
    "title": "ProviderCourseTypes API",
    "version": "1.0.0",
    "description": "API for managing provider course types and restricting providers by course type."
  },
  "paths": {
    "/providers/{ukprn}/course-types/{courseType}/restrict": {
      "post": {
        "summary": "Restrict provider for a specific course type",
        "operationId": "restrictProvider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique UKPRN identifier for the provider."
          },
          {
            "name": "courseType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CourseType"
            },
            "description": "The type of course to restrict the provider for."
          }
        ],
        "requestBody": {
          "description": "Details for restricting the provider.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictProviderModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Provider restricted successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CourseType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ShortCourse"
        ],
        "description": "Enumeration of possible course types."
      },
      "RestrictProviderModel": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "Identifier for the user making the request."
          },
          "UserDisplayName": {
            "type": "string",
            "description": "Display name of the user making the request."
          }
        },
        "required": [
          "UserId",
          "UserDisplayName"
        ],
        "description": "Model representing the input for restricting a provider."
      }
    }
  }
}
