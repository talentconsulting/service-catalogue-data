{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/providerFeedback/{ukprn}": {
      "get": {
        "summary": "Get provider feedback by UKPRN",
        "operationId": "getProviderFeedback",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique Provider Reference Number (UKPRN)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderFeedbackResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider feedback not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/providerFeedback/{ukprn}/annual": {
      "get": {
        "summary": "Get provider feedback annual statistics by UKPRN",
        "operationId": "getProviderFeedbackAnnual",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique Provider Reference Number (UKPRN)"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderFeedbackAnnualResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider feedback annual statistics not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/providerFeedback/{ukprn}/annual/{year}": {
      "get": {
        "summary": "Get provider feedback for a specific academic year",
        "operationId": "getProviderFeedbackForAcademicYear",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique Provider Reference Number (UKPRN)"
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Specific academic year"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderFeedbackForAcademicYearResponse"
                }
              }
            }
          },
          "404": {
            "description": "Provider feedback for the specified academic year not found"
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetProviderFeedbackResponse": {
        "type": "object",
        "properties": {
          "providerFeedback": {
            "$ref": "#/components/schemas/GetProviderFeedbackItem"
          }
        }
      },
      "GetProviderFeedbackAnnualResponse": {
        "type": "object",
        "properties": {
          "providerFeedback": {
            "$ref": "#/components/schemas/GetProviderFeedbackAnnualItem"
          }
        }
      },
      "GetProviderFeedbackForAcademicYearResponse": {
        "type": "object",
        "properties": {
          "providerFeedback": {
            "$ref": "#/components/schemas/GetProviderFeedbackForAcademicYearItem"
          }
        }
      },
      "GetProviderFeedbackItem": {
        "type": "object",
        "properties": {}
      },
      "GetProviderFeedbackAnnualItem": {
        "type": "object",
        "properties": {}
      },
      "GetProviderFeedbackForAcademicYearItem": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
