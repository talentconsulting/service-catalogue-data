{
  "openapi": "3.1.0",
  "info": {
    "title": "Eligible Apprenticeship Search API",
    "version": "1.0.0",
    "description": "API for searching eligible apprenticeships."
  },
  "paths": {
    "/apprenticeships": {
      "get": {
        "summary": "Get eligible apprenticeships",
        "operationId": "getEligibleApprentices",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the user's account."
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "ID of the legal entity associated with the account."
          }
        ],
        "responses": {
          "200": {
            "description": "A list of eligible apprenticeships.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EligibleApprenticeshipDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EligibleApprenticeshipDto": {
        "type": "object",
        "properties": {
          "apprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "apprenticeshipStatus": {
            "type": "string",
            "enum": [
              "Draft",
              "Submitted",
              "Withdrawn",
              "Successful",
              "UnSuccessful",
              "Expired"
            ]
          },
          "accountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "serviceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          }
        },
        "required": [
          "apprenticeshipId",
          "apprenticeshipStatus",
          "accountLegalEntityId"
        ]
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "decisionReference": {
            "type": "string"
          },
          "taskCreatedDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "taskId",
          "decisionReference"
        ]
      }
    }
  }
}
