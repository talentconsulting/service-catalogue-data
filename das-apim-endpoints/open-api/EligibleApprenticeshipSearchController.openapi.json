{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprenticeships": {
      "get": {
        "summary": "Get eligible apprenticeships",
        "operationId": "GetEligibleApprentices",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with eligible apprenticeships",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EligibleApprenticeshipDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EligibleApprenticeshipDto": {
        "type": "object",
        "properties": {
          "apprenticeshipStatus": {
            "type": "string",
            "description": "Status of the apprenticeship"
          },
          "otherProperties": {
            "type": "string",
            "description": "Placeholder for additional unknown properties"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
