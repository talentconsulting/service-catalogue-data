{
  "openapi": "3.1.0",
  "info": {
    "title": "LevyTransferMatching API",
    "version": "1.0.0"
  },
  "paths": {
    "/locations": {
      "get": {
        "summary": "Retrieve locations",
        "operationId": "getLocations",
        "parameters": [
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term for locations."
          }
        ],
        "responses": {
          "200": {
            "description": "Location names retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationsDto"
                }
              }
            }
          }
        }
      }
    },
    "/locations/information": {
      "get": {
        "summary": "Retrieve location information",
        "operationId": "getLocationInformation",
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The name of the location."
          }
        ],
        "responses": {
          "200": {
            "description": "Location information retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LocationInformationDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LocationsDto": {
        "type": "object",
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "Manchester"
            },
            "description": "Array of location names."
          }
        }
      },
      "LocationInformationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Location name."
          },
          "geoPoint": {
            "type": "object",
            "properties": {
              "latitude": {
                "type": "number",
                "format": "float",
                "example": 53.4808
              },
              "longitude": {
                "type": "number",
                "format": "float",
                "example": -2.2426
              }
            },
            "description": "Geographical coordinates of the location."
          }
        }
      }
    }
  }
}
