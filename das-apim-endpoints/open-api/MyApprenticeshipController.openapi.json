{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Portal API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{id}/my-apprenticeship": {
      "post": {
        "summary": "Add or update MyApprenticeship details",
        "operationId": "PostMyApprenticeship",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The unique identifier of the apprentice"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MyApprenticeshipConfirmedRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MyApprenticeshipConfirmedRequest": {
        "type": "object",
        "properties": {
          "CommitmentsApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "description": "The apprenticeship ID within the commitments system"
          },
          "ApprovedOn": {
            "type": "string",
            "format": "date-time",
            "description": "The date and time when the apprenticeship was approved"
          }
        },
        "required": [
          "CommitmentsApprenticeshipId",
          "ApprovedOn"
        ]
      }
    }
  }
}
