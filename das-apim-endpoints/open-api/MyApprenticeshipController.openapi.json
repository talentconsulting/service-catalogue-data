{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Aan API",
    "version": "1.0.0"
  },
  "paths": {
    "/MyApprenticeship/{apprenticeId}": {
      "get": {
        "summary": "Retrieve MyApprenticeship information by apprentice ID",
        "operationId": "getMyApprenticeship",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMyApprenticeshipQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/MyApprenticeship": {
      "post": {
        "summary": "Try to create a MyApprenticeship entry",
        "operationId": "tryCreateMyApprenticeship",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TryCreateMyApprenticeshipRequestModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MyApprenticeship found or successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMyApprenticeshipQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetMyApprenticeshipQueryResult": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "nullable": true
          },
          "apprenticeshipId": {
            "type": "integer",
            "nullable": true
          },
          "employerName": {
            "type": "string",
            "nullable": true
          },
          "startDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "endDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "trainingProviderId": {
            "type": "integer",
            "nullable": true
          },
          "trainingProviderName": {
            "type": "string",
            "nullable": true
          },
          "trainingCourse": {
            "$ref": "#/components/schemas/TrainingCourse"
          }
        }
      },
      "TryCreateMyApprenticeshipRequestModel": {
        "type": "object",
        "required": [
          "apprenticeId",
          "firstName",
          "lastName",
          "email",
          "dateOfBirth"
        ],
        "properties": {
          "apprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TrainingCourse": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "nullable": true
          },
          "level": {
            "type": "integer"
          },
          "duration": {
            "type": "integer",
            "nullable": true
          },
          "sector": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
