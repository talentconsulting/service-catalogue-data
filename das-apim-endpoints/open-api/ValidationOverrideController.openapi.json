{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Incentives API",
    "version": "1.0.0"
  },
  "paths": {
    "/validation-overrides": {
      "post": {
        "summary": "Add validation overrides",
        "operationId": "AddValidationOverrides",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ValidationOverrideRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ValidationOverrideRequest": {
        "type": "object",
        "properties": {
          "ValidationOverrides": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationOverride"
            }
          }
        }
      },
      "ValidationOverride": {
        "type": "object",
        "properties": {
          "AccountLegalEntityId": {
            "type": "integer",
            "format": "int64"
          },
          "ULN": {
            "type": "integer",
            "format": "int64"
          },
          "ValidationSteps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationStep"
            }
          },
          "ServiceRequest": {
            "$ref": "#/components/schemas/ServiceRequest"
          }
        }
      },
      "ValidationStep": {
        "type": "object",
        "properties": {
          "ValidationType": {
            "$ref": "#/components/schemas/ValidationType"
          },
          "ExpiryDate": {
            "type": "string",
            "format": "date-time"
          },
          "Remove": {
            "type": "boolean"
          }
        }
      },
      "ValidationType": {
        "type": "string",
        "enum": [
          "NotSet",
          "HasDaysInLearning",
          "IsInLearning",
          "HasNoDataLocks",
          "EmployedBeforeSchemeStarted",
          "EmployedAtStartOfApprenticeship",
          "EmployedAt365Days"
        ]
      },
      "ServiceRequest": {
        "type": "object",
        "properties": {
          "TaskId": {
            "type": "string"
          },
          "DecisionReference": {
            "type": "string"
          },
          "TaskCreatedDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
