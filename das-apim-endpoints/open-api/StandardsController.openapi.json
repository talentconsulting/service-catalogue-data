{
  "openapi": "3.1.0",
  "info": {
    "title": "Standards API",
    "description": "API operations related to Standards.",
    "version": "1.0.0"
  },
  "paths": {
    "/Standards": {
      "get": {
        "summary": "Retrieve a list of standards",
        "description": "Fetches all available standards.",
        "operationId": "GetStandards",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardsQueryResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetStandardsQueryResult": {
        "type": "object",
        "properties": {
          "Standards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Standard"
            }
          }
        },
        "required": [
          "Standards"
        ]
      },
      "Standard": {
        "type": "object",
        "properties": {
          "StandardUId": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "LarsCode": {
            "type": "integer"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Route": {
            "type": "string"
          },
          "Version": {
            "type": "string"
          },
          "Options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "VersionDetail": {
            "type": "object",
            "properties": {}
          },
          "StandardPageUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
