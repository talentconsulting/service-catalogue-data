{
  "openapi": "3.1.0",
  "info": {
    "title": "Standards API",
    "version": "1.0.0"
  },
  "paths": {
    "/standards/{standardReference}": {
      "get": {
        "summary": "Get a specific standard by reference.",
        "operationId": "GetStandard",
        "parameters": [
          {
            "name": "standardReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The reference identifier for the standard to retrieve."
          }
        ],
        "responses": {
          "200": {
            "description": "Standard retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Standard"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/standards/{standardLarsCode}": {
      "post": {
        "summary": "Cache a standard by LARS code.",
        "operationId": "CacheStandard",
        "parameters": [
          {
            "name": "standardLarsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The LARS code of the standard to cache."
          }
        ],
        "responses": {
          "200": {
            "description": "Standard cached successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Standard"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/standards/refresh": {
      "put": {
        "summary": "Refresh all standards.",
        "operationId": "RefreshStandards",
        "responses": {
          "200": {
            "description": "Standards refreshed successfully."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Standard": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "The unique identifier of the standard."
          },
          "title": {
            "type": "string",
            "description": "The title of the standard."
          },
          "reference": {
            "type": "string",
            "description": "The reference identifier for the standard."
          },
          "larsCode": {
            "type": "string",
            "description": "The LARS code for the standard."
          },
          "description": {
            "type": "string",
            "description": "A brief description of the standard."
          }
        },
        "required": [
          "id",
          "title",
          "reference"
        ]
      }
    }
  }
}
