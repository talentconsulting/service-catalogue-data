{
  "openapi": "3.1.0",
  "info": {
    "title": "DigitalCertificates Sharing API",
    "version": "1.0.0"
  },
  "paths": {
    "/sharing/": {
      "post": {
        "summary": "Create Sharing",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/sharing/{sharingId}": {
      "get": {
        "summary": "Get Sharing By Id",
        "parameters": [
          {
            "name": "sharingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Delete Sharing",
        "parameters": [
          {
            "name": "sharingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/sharing/code/{code}": {
      "get": {
        "summary": "Get Sharing By Code",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/sharing/{sharingId}/email": {
      "post": {
        "summary": "Create Sharing Email",
        "parameters": [
          {
            "name": "sharingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingEmailRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/sharingaccess": {
      "post": {
        "summary": "Create Sharing Access",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingAccessRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/sharingemailaccess": {
      "post": {
        "summary": "Create Sharing Email Access",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSharingEmailAccessRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/certificates/{id}": {
      "get": {
        "summary": "Get Shared Standard Certificate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/certificates/framework/{id}": {
      "get": {
        "summary": "Get Shared Framework Certificate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateSharingRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "CertificateId": {
            "type": "string",
            "format": "uuid"
          },
          "CertificateType": {
            "type": "string"
          },
          "CourseName": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "CertificateId",
          "CertificateType",
          "CourseName"
        ]
      },
      "CreateSharingEmailRequest": {
        "type": "object",
        "properties": {
          "SharingId": {
            "type": "string",
            "format": "uuid"
          },
          "EmailAddress": {
            "type": "string"
          },
          "UserName": {
            "type": "string"
          },
          "LinkDomain": {
            "type": "string"
          },
          "MessageText": {
            "type": "string"
          },
          "TemplateId": {
            "type": "string"
          }
        },
        "required": [
          "SharingId",
          "EmailAddress",
          "UserName",
          "LinkDomain",
          "MessageText",
          "TemplateId"
        ]
      },
      "CreateSharingAccessRequest": {
        "type": "object",
        "properties": {
          "SharingId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "SharingId"
        ]
      },
      "CreateSharingEmailAccessRequest": {
        "type": "object",
        "properties": {
          "SharingEmailId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "SharingEmailId"
        ]
      }
    }
  }
}
