{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/": {
      "get": {
        "operationId": "GetList",
        "summary": "Get a list of training courses.",
        "responses": {
          "200": {
            "description": "Successful list retrieval.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseExportListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/TrainingCourses/{id}": {
      "get": {
        "operationId": "GetStandardById",
        "summary": "Get standard course details by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the standard (standardUId, LarsCode, or IfateReferenceNumber)."
          }
        ],
        "responses": {
          "200": {
            "description": "Standard details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardDetailsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found."
          }
        }
      }
    },
    "/TrainingCourses/active": {
      "get": {
        "operationId": "GetActiveList",
        "summary": "Get a list of active training courses.",
        "responses": {
          "200": {
            "description": "Active training courses retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/TrainingCourses/draft": {
      "get": {
        "operationId": "GetDraftList",
        "summary": "Get a list of draft training courses.",
        "responses": {
          "200": {
            "description": "Draft training courses retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCourseExportListResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardDetailsResponse"
            }
          }
        }
      },
      "GetCourseListResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseListItem"
            }
          }
        }
      },
      "GetCourseListItem": {
        "type": "object",
        "additionalProperties": true
      },
      "GetStandardDetailsResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
