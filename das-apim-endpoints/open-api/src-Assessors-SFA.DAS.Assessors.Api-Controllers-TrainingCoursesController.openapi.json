{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "description": "API for retrieving training courses and standards details.",
    "version": "1.0.0"
  },
  "paths": {
    "/trainingcourses/": {
      "get": {
        "summary": "Get a list of training courses",
        "operationId": "getTrainingCourses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseExportListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/trainingcourses/{id}": {
      "get": {
        "summary": "Get standard details by ID",
        "operationId": "getStandardById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID of the standard (standardUId, LarsCode, or IfateReferenceNumber)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardDetailsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard details not found"
          }
        }
      }
    },
    "/trainingcourses/active": {
      "get": {
        "summary": "Get a list of active training courses",
        "operationId": "getActiveTrainingCourses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trainingcourses/draft": {
      "get": {
        "summary": "Get a list of draft training courses",
        "operationId": "getDraftTrainingCourses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCourseExportListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardDetailsResponse"
            }
          }
        }
      },
      "GetStandardDetailsResponse": {
        "type": "object",
        "properties": {
          "standardCode": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "duration": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentPlanUrl": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Draft",
              "Retired"
            ]
          }
        }
      },
      "GetCourseListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseListItem"
            }
          }
        }
      },
      "GetCourseListItem": {
        "type": "object",
        "properties": {
          "standardCode": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "integer",
            "format": "int32"
          },
          "duration": {
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "type": "string",
            "enum": [
              "Active",
              "Draft",
              "Retired"
            ]
          }
        }
      }
    }
  }
}
