{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/trainingcourses": {
      "get": {
        "summary": "Retrieve a list of training courses",
        "operationId": "getTrainingCoursesList",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseExportListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/trainingcourses/{id}": {
      "get": {
        "summary": "Retrieve details of a training standard by ID",
        "operationId": "getStandardById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Standard ID, which can be StandardUId, LarsCode, or IFateReferenceNumber"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardDetailsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/trainingcourses/active": {
      "get": {
        "summary": "Retrieve a list of active training courses",
        "operationId": "getActiveTrainingCourses",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/trainingcourses/draft": {
      "get": {
        "summary": "Retrieve a list of draft training courses",
        "operationId": "getDraftTrainingCourses",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCourseExportListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardDetailsResponse"
            }
          }
        }
      },
      "GetStandardDetailsResponse": {
        "type": "object",
        "properties": {
          "standardId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "larsCode": {
            "type": "string"
          },
          "ifateReferenceNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "GetCourseListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseListItem"
            }
          }
        }
      },
      "GetCourseListItem": {
        "type": "object",
        "properties": {
          "standardId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "level": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
