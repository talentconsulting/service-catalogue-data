{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/TrainingCourses/": {
      "get": {
        "operationId": "getTrainingCoursesList",
        "summary": "Retrieve list of training courses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseExportListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/TrainingCourses/{id}": {
      "get": {
        "operationId": "getStandardById",
        "summary": "Retrieve standard details by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID can be standardUId, LarsCode, or IfateReferenceNumber"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetStandardDetailsResponse"
                }
              }
            }
          },
          "404": {
            "description": "Standard not found"
          }
        }
      }
    },
    "/TrainingCourses/active": {
      "get": {
        "operationId": "getActiveTrainingCoursesList",
        "summary": "Retrieve list of active training courses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/TrainingCourses/draft": {
      "get": {
        "operationId": "getDraftTrainingCoursesList",
        "summary": "Retrieve list of draft training courses",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCourseListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetCourseExportListResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetStandardDetailsResponse"
            }
          }
        }
      },
      "GetStandardDetailsResponse": {
        "type": "object",
        "properties": {
          "StandardUid": {
            "type": "string"
          },
          "LarsCode": {
            "type": "string"
          },
          "IfateReferenceNumber": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Duration": {
            "type": "integer"
          },
          "FundingBand": {
            "type": "integer"
          },
          "Status": {
            "type": "string"
          }
        }
      },
      "GetCourseListResponse": {
        "type": "object",
        "properties": {
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetCourseListItem"
            }
          }
        }
      },
      "GetCourseListItem": {
        "type": "object",
        "properties": {
          "StandardUid": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Level": {
            "type": "integer"
          },
          "Duration": {
            "type": "integer"
          },
          "FundingBand": {
            "type": "integer"
          },
          "IsActive": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
