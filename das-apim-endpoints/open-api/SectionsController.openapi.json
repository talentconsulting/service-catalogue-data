      "get": {
        "operationId": "GetSectionById",
        "summary": "Retrieve a section by section and form version IDs.",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sectionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with section data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetSectionByIdQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
