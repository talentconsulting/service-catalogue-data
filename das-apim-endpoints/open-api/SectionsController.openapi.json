{
  "openapi": "3.1.0",
  "info": {
    "title": "Sections API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/forms/{formVersionId}/sections": {
      "get": {
        "summary": "Get all sections by form version ID",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with all sections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllSectionsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "summary": "Create a new section",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSectionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Section created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSectionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
