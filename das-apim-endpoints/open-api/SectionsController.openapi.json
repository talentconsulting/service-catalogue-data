{
  "openapi": "3.1.0",
  "info": {
    "title": "Aodp Form Builder Sections API",
    "version": "1.0.0",
    "description": "API for form builder sections management."
  },
  "paths": {
    "/api/forms/{formVersionId}/sections": {
      "get": {
        "operationId": "GetAllSections",
        "summary": "Retrieve all sections by form version ID.",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with sections data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllSectionsQueryResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "operationId": "CreateSection",
        "summary": "Create a new section.",
        "parameters": [
          {
            "name": "formVersionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSectionCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with created section data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSectionCommandResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
