{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/attributes/": {
      "get": {
        "summary": "Retrieve all attributes",
        "operationId": "GetAttributes",
        "responses": {
          "200": {
            "description": "Successful retrieval of attributes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAttributesResponse"
                }
              }
            }
          },
          "404": {
            "description": "Attributes not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAttributesResponse": {
        "type": "object",
        "properties": {
          "attributes": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "description": "Response schema for retrieving attributes."
      }
    }
  }
}
