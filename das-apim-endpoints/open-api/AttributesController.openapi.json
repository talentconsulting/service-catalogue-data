{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback Attributes API",
    "version": "1.0.0",
    "description": "API for accessing apprentice feedback attributes."
  },
  "paths": {
    "/attributes/provider-attributes": {
      "get": {
        "summary": "Get provider attributes",
        "operationId": "GetProviderAttributes",
        "responses": {
          "200": {
            "description": "List of provider attributes returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Attribute"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No provider attributes found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/attributes/exitsurvey-attributes": {
      "get": {
        "summary": "Get exit survey attributes",
        "operationId": "GetExitSurveyAttributes",
        "responses": {
          "200": {
            "description": "List of exit survey attributes returned successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Attribute"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No exit survey attributes found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attribute": {
        "type": "object",
        "properties": {},
        "additionalProperties": true,
        "description": "Representation of an individual attribute."
      }
    }
  }
}
