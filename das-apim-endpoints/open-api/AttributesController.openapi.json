{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/provider-attributes": {
      "get": {
        "operationId": "GetProviderAttributes",
        "summary": "Retrieve provider attributes for feedback.",
        "responses": {
          "200": {
            "description": "Successful retrieval of provider attributes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Attribute"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No provider attributes found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/exitsurvey-attributes": {
      "get": {
        "operationId": "GetExitSurveyAttributes",
        "summary": "Retrieve exit survey attributes.",
        "responses": {
          "200": {
            "description": "Successful retrieval of exit survey attributes.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Attribute"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No exit survey attributes found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Attribute": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    }
  }
}
