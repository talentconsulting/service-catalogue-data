{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/apprentices/{id}": {
      "get": {
        "summary": "Retrieve apprentice details",
        "operationId": "getApprentice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the apprentice"
          }
        ],
        "responses": {
          "200": {
            "description": "Apprentice details retrieved successfully"
          },
          "400": {
            "description": "Invalid request"
          },
          "404": {
            "description": "Apprentice not found"
          }
        }
      },
      "patch": {
        "summary": "Update apprentice details",
        "operationId": "updateApprentice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The ID of the apprentice"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json-patch+json": {
              "schema": {
                "$ref": "#/components/schemas/JsonPatchDocument"
              },
              "description": "The JSON Patch document containing updates for the apprentice"
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprentice details updated successfully"
          },
          "400": {
            "description": "Invalid patch request"
          },
          "404": {
            "description": "Apprentice not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Apprentice": {
        "type": "object",
        "properties": {
          "ApprenticeId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the apprentice"
          },
          "FirstName": {
            "type": "string",
            "description": "The first name of the apprentice"
          },
          "LastName": {
            "type": "string",
            "description": "The last name of the apprentice"
          },
          "Email": {
            "type": "string",
            "format": "email",
            "description": "The email address of the apprentice"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date",
            "description": "The date of birth of the apprentice"
          },
          "TermsOfUseAccepted": {
            "type": "boolean",
            "description": "Indicates whether the apprentice has accepted the terms of use"
          },
          "GovUkIdentifier": {
            "type": "string",
            "description": "The Gov UK identifier for the apprentice"
          }
        }
      },
      "JsonPatchDocument": {
        "type": "object",
        "properties": {
          "operations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JsonPatchOperation"
            },
            "description": "List of operations for the patch request"
          }
        }
      },
      "JsonPatchOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "replace",
              "move",
              "copy",
              "test"
            ],
            "description": "The operation to perform"
          },
          "path": {
            "type": "string",
            "description": "A JSON-Pointer path describing the target location"
          },
          "value": {
            "type": "object",
            "description": "The value to use for 'add' or 'replace' operations"
          },
          "from": {
            "type": "string",
            "description": "A JSON-Pointer path describing the source location for 'move' or 'copy' operations"
          }
        },
        "required": [
          "op",
          "path"
        ]
      }
    }
  }
}
