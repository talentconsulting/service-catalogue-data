{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentices API",
    "version": "1.0.0",
    "description": "API for managing Apprenticeships and related operations."
  },
  "paths": {
    "/apprentices/{id}": {
      "get": {
        "operationId": "getApprentice",
        "summary": "Get apprentice details by ID",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/provider/{providerId}/apprentices/{apprenticeshipId}/change-employer/inform": {
      "get": {
        "operationId": "getChangeEmployerInform",
        "summary": "Get employer change inform details",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "legalEntityName": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/provider/{providerId}/apprentices/{apprenticeshipId}/change-employer/confirm-employer": {
      "get": {
        "operationId": "getChangeEmployerConfirmEmployer",
        "summary": "Get confirm employer details",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "legalEntityName": {
                      "type": "string"
                    },
                    "accountLegalEntityName": {
                      "type": "string"
                    },
                    "accountName": {
                      "type": "string"
                    },
                    "isFlexiJobAgency": {
                      "type": "boolean"
                    },
                    "deliveryModel": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    },
    "/provider/{providerId}/apprentices/{apprenticeshipId}/change-employer/apprenticeship-data": {
      "get": {
        "operationId": "getChangeEmployerApprenticeshipData",
        "summary": "Get apprenticeship data for employer change",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "apprenticeshipId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "accountLegalEntityId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePaymentsRequest": {
        "type": "object",
        "properties": {
          "paymentFreezeDate": {
            "type": "string",
            "format": "date-time"
          },
          "userInfo": {
            "$ref": "#/components/schemas/UserInfo"
          },
          "freezePaymentsReason": {
            "type": "integer"
          }
        }
      },
      "UserInfo": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string"
          },
          "userDisplayName": {
            "type": "string"
          },
          "userEmail": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}
