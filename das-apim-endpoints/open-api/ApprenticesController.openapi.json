{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Aan API",
    "version": "1.0.0",
    "description": "API for managing apprentices in the Apprentice Aan system."
  },
  "paths": {
    "/apprentices/{apprenticeId}/account": {
      "get": {
        "operationId": "getApprenticeAccount",
        "summary": "Get apprentice account details",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Account details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeAccountQueryResult"
                }
              }
            }
          },
          "404": {
            "description": "Apprentice not found"
          }
        }
      }
    },
    "/apprentices/{apprenticeId}": {
      "get": {
        "operationId": "getApprentice",
        "summary": "Get apprentice details",
        "parameters": [
          {
            "name": "apprenticeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprentice details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetApprenticeResult"
                }
              }
            }
          },
          "404": {
            "description": "Apprentice not found"
          }
        }
      }
    },
    "/apprentices": {
      "post": {
        "operationId": "createApprenticeMember",
        "summary": "Create a new apprentice member",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateApprenticeMemberCommand"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Apprentice member created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateApprenticeMemberCommandResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetApprenticeAccountQueryResult": {
        "type": "object",
        "properties": {
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetApprenticeResult": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string"
          },
          "Status": {
            "type": "string"
          },
          "RegionId": {
            "type": "integer"
          }
        }
      },
      "CreateApprenticeMemberCommand": {
        "type": "object",
        "properties": {
          "ApprenticeId": {
            "type": "string",
            "format": "uuid"
          },
          "Email": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "JoinedDate": {
            "type": "string",
            "format": "date-time"
          },
          "RegionId": {
            "type": "integer"
          },
          "OrganisationName": {
            "type": "string"
          },
          "ProfileValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProfileValue"
            }
          },
          "MemberNotificationEventFormatValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberNotificationEventFormatValues"
            }
          },
          "MemberNotificationLocationValues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberNotificationLocationValues"
            }
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        }
      },
      "ProfileValue": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Value": {
            "type": "string"
          }
        }
      },
      "MemberNotificationEventFormatValues": {
        "type": "object",
        "properties": {
          "EventFormat": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer"
          },
          "ReceiveNotifications": {
            "type": "boolean"
          }
        }
      },
      "MemberNotificationLocationValues": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Radius": {
            "type": "integer"
          },
          "Latitude": {
            "type": "number",
            "format": "float"
          },
          "Longitude": {
            "type": "number",
            "format": "float"
          }
        }
      },
      "CreateApprenticeMemberCommandResult": {
        "type": "object",
        "properties": {
          "MemberId": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  }
}
