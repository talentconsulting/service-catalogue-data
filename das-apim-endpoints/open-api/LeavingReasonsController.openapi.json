{
  "openapi": "3.1.0",
  "info": {
    "title": "ApprenticeAAN Leaving Reasons API",
    "version": "1.0.0"
  },
  "paths": {
    "/LeavingReasons": {
      "get": {
        "summary": "Get list of leaving reasons",
        "description": "Retrieves a list of leaving reasons categorized by LeavingCategory.",
        "operationId": "GetLeavingReasons",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful response with a list of leaving categories and respective reasons.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeavingCategory"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LeavingCategory": {
        "type": "object",
        "properties": {
          "Category": {
            "type": "string",
            "description": "The category name of the leaving reasons."
          },
          "LeavingReasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeavingReason"
            },
            "description": "List of reasons within the category."
          }
        },
        "required": [
          "Category",
          "LeavingReasons"
        ]
      },
      "LeavingReason": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "Unique identifier for the leaving reason."
          },
          "Description": {
            "type": "string",
            "description": "Description of the leaving reason."
          },
          "Ordering": {
            "type": "integer",
            "description": "Ordering index for the leaving reason."
          }
        },
        "required": [
          "Id",
          "Description",
          "Ordering"
        ]
      }
    }
  }
}
