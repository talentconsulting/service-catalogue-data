{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Aan API",
    "version": "1.0.0"
  },
  "paths": {
    "/LeavingReasons": {
      "get": {
        "summary": "Get list of leaving reasons",
        "operationId": "getLeavingReasons",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeavingCategory"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LeavingCategory": {
        "type": "object",
        "properties": {
          "Category": {
            "type": "string"
          },
          "LeavingReasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeavingReason"
            }
          }
        },
        "required": [
          "Category",
          "LeavingReasons"
        ]
      },
      "LeavingReason": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "Ordering": {
            "type": "integer"
          }
        },
        "required": [
          "Id",
          "Description",
          "Ordering"
        ]
      }
    }
  }
}
