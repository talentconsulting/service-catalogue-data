{
  "openapi": "3.1.0",
  "info": {
    "title": "Leaving Reasons API",
    "version": "1.0.0"
  },
  "paths": {
    "/leavingreasons": {
      "get": {
        "summary": "Get list of leaving reasons",
        "operationId": "getLeavingReasons",
        "responses": {
          "200": {
            "description": "A list of leaving reasons categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LeavingCategory"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LeavingCategory": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string"
          },
          "leavingReasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeavingReason"
            }
          }
        },
        "required": [
          "category",
          "leavingReasons"
        ]
      },
      "LeavingReason": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "ordering": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "description",
          "ordering"
        ]
      }
    }
  }
}
