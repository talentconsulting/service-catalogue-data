{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Feedback Web API",
    "version": "1.0.0"
  },
  "paths": {
    "/account-details": {
      "get": {
        "operationId": "getAccountDetails",
        "summary": "Retrieve Account Details",
        "tags": [
          "Account"
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The URL to return to after the operation."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {}
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "post": {
        "operationId": "postAccountDetails",
        "summary": "Submit Account Details",
        "tags": [
          "Account"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StubAuthenticationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to signed-in route"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/Stub-Auth": {
      "get": {
        "operationId": "getStubSignedIn",
        "summary": "Authorized Stub Sign-In",
        "tags": [
          "Stub Authentication"
        ],
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "The URL to return to after signing in."
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/html": {}
            }
          },
          "404": {
            "description": "Not Found"
          }
        },
        "security": [
          {
            "cookieAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "StubAuthenticationViewModel": {
        "type": "object",
        "properties": {
          "ReturnUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "description": "ViewModel for stub authentication functionality."
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "name": "Cookie",
        "in": "header"
      }
    }
  }
}
