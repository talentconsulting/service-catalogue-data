{
  "openapi": "3.1.0",
  "info": {
    "title": "Organisation Type Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/type": {
      "get": {
        "summary": "Display organisation type update page",
        "operationId": "getOrganisationTypeUpdate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to Home page if organisation data is not found"
          },
          "200": {
            "description": "Renders the organisation type update page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationTypeUpdateViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Update organisation type",
        "operationId": "postOrganisationTypeUpdate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationTypeUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to Provider Summary page after updating organisation type"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationTypeUpdateViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "OrganisationTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationTypeModel"
            }
          },
          "OrganisationTypeId": {
            "type": "integer"
          }
        },
        "required": [
          "LegalName",
          "OrganisationTypeId"
        ]
      },
      "OrganisationTypeModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
