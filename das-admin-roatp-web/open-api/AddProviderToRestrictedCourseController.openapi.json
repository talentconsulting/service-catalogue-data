{
  "openapi": "3.1.0",
  "info": {
    "title": "Add Provider to Restricted Course API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/{larsCode}/providers/add": {
      "get": {
        "tags": [
          "CourseRestrictions"
        ],
        "summary": "Get Add Provider to Restricted Course View",
        "operationId": "GetAddProviderToRestrictedCourseView",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The LARS code of the restricted course."
          }
        ],
        "responses": {
          "200": {
            "description": "HTML view of the Add Provider to Restricted Course page."
          },
          "404": {
            "description": "The requested restricted course was not found."
          }
        }
      },
      "post": {
        "tags": [
          "CourseRestrictions"
        ],
        "summary": "Submit Provider to Restricted Course",
        "operationId": "SubmitProviderToRestrictedCourse",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The LARS code of the restricted course."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddProviderToRestrictedCourseSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to confirm adding provider to restricted course."
          },
          "404": {
            "description": "Either the restricted course or the provider was not found."
          },
          "400": {
            "description": "Validation errors occurred.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddProviderToRestrictedCourseSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedUkprn": {
            "type": "string",
            "nullable": true,
            "description": "The UKPRN of the selected provider."
          }
        }
      }
    }
  }
}
