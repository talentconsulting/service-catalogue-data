{
  "openapi": "3.1.0",
  "info": {
    "title": "Unrestricted Course Details API",
    "version": "1.0.0"
  },
  "paths": {
    "/unrestricted-courses/{larsCode}": {
      "get": {
        "operationId": "GetUnrestrictedCourseDetails",
        "summary": "Get unrestricted course details",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the course (LARS code)."
          }
        ],
        "responses": {
          "200": {
            "description": "The unrestricted course details were successfully retrieved.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "description": "HTML representation of the unrestricted course details view."
                }
              }
            }
          },
          "302": {
            "description": "The course is restricted and the user is redirected to the restricted course details route."
          },
          "404": {
            "description": "The course details were not found."
          }
        },
        "security": [
          {
            "RoatpAdminTeam": []
          }
        ],
        "tags": [
          "CourseRestrictions"
        ]
      },
      "post": {
        "operationId": "SubmitUnrestrictedCourseDetails",
        "summary": "Submit unrestricted course for restriction confirmation",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The unique identifier of the course (LARS code)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictCourseSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects the user to the restrict course confirmation route."
          }
        },
        "security": [
          {
            "RoatpAdminTeam": []
          }
        ],
        "tags": [
          "CourseRestrictions"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "RoatpAdminTeam": {
        "type": "oauth2",
        "description": "Requires the user to be part of the RoATP Admin team."
      }
    },
    "schemas": {
      "RestrictCourseSubmitModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string",
            "nullable": true,
            "description": "The unique identifier of the course (LARS code)."
          },
          "DisplayName": {
            "type": "string",
            "nullable": true,
            "description": "The display name of the course."
          }
        }
      }
    }
  }
}
