{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Status Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/status": {
      "get": {
        "operationId": "getProviderStatus",
        "summary": "Fetch the current status and status options for a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UKPRN of the provider.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched the provider status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationStatusUpdateViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the home page if the provider is not found."
          }
        },
        "security": [
          {
            "rolesAuth": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "operationId": "updateProviderStatus",
        "summary": "Update the current status of a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UKPRN of the provider.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationStatusUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to various routes based on the status update outcome.",
            "headers": {
              "Location": {
                "description": "Redirect URL.",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/providers/{ukprn}/status/confirmed": {
      "get": {
        "operationId": "getProviderStatusUpdateConfirmation",
        "summary": "Confirm the updated status of a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UKPRN of the provider.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully fetched the provider status confirmation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderStatusConfirmationViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the home page if the provider is not found."
          }
        },
        "security": [
          {
            "rolesAuth": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationStatusUpdateViewModel": {
        "type": "object",
        "properties": {
          "OrganisationStatuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationStatusSelectionModel"
            }
          },
          "OrganisationStatus": {
            "$ref": "#/components/schemas/OrganisationStatus"
          }
        },
        "required": [
          "OrganisationStatuses",
          "OrganisationStatus"
        ]
      },
      "OrganisationStatusSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The ID of the organisation status option."
          },
          "Description": {
            "type": "string",
            "description": "The description of the organisation status option."
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates if this status option is selected."
          }
        },
        "required": [
          "Id",
          "Description",
          "IsSelected"
        ]
      },
      "OrganisationStatus": {
        "type": "string",
        "enum": [
          "Removed",
          "Active",
          "ActiveNoStarts",
          "OnBoarding"
        ]
      },
      "ProviderStatusConfirmationViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string",
            "description": "The legal name of the provider."
          },
          "OrganisationStatus": {
            "$ref": "#/components/schemas/OrganisationStatus"
          },
          "Ukprn": {
            "type": "integer",
            "description": "The UKPRN of the provider."
          },
          "StatusText": {
            "type": "string",
            "description": "Text representation of the provider's status."
          },
          "ProviderSummaryLink": {
            "type": "string",
            "description": "Link to the provider summary page."
          },
          "SelectTrainingProviderLink": {
            "type": "string",
            "description": "Link to the page for selecting a training provider."
          },
          "AddNewTrainingProviderLink": {
            "type": "string",
            "description": "Link to the page for adding a new training provider."
          }
        },
        "required": [
          "LegalName",
          "OrganisationStatus",
          "Ukprn",
          "StatusText",
          "ProviderSummaryLink",
          "SelectTrainingProviderLink",
          "AddNewTrainingProviderLink"
        ]
      }
    },
    "securitySchemes": {
      "rolesAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Roles-based authentication."
      }
    }
  }
}
