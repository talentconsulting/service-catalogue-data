{
  "openapi": "3.1.0",
  "info": {
    "title": "AccountController API",
    "version": "1.0.0"
  },
  "paths": {
    "/SignOut": {
      "get": {
        "operationId": "SignOut",
        "summary": "Signs the user out and deletes all cookies.",
        "responses": {
          "200": {
            "description": "Successfully signed out."
          }
        }
      }
    },
    "/SignedOut": {
      "get": {
        "operationId": "SignedOut",
        "summary": "Displays the signed out confirmation page.",
        "responses": {
          "200": {
            "description": "Signed out confirmation view."
          }
        }
      }
    }
  },
  "components": {}
}
