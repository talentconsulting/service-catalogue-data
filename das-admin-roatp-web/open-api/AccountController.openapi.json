{
  "openapi": "3.1.0",
  "info": {
    "title": "AccountController API",
    "version": "1.0.0"
  },
  "paths": {
    "/SignOut": {
      "get": {
        "operationId": "AccountController_SignOut",
        "summary": "Signs the user out and clears all cookies.",
        "responses": {
          "200": {
            "description": "Sign-out successful."
          }
        }
      }
    },
    "/SignedOut": {
      "get": {
        "operationId": "AccountController_SignedOut",
        "summary": "Displays the signed-out view.",
        "responses": {
          "200": {
            "description": "Signed-out view displayed."
          }
        }
      }
    }
  },
  "components": {}
}
