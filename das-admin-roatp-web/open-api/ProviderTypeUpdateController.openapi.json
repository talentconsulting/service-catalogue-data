{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Type Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/route": {
      "get": {
        "summary": "Get provider type update view",
        "description": "Fetches the provider type update view model for a given UKPRN.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "Unique Provider Reference Number",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The provider type update view model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTypeUpdateViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the home page if the provider is not found."
          }
        },
        "security": [
          {
            "oauth2": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "summary": "Update provider type",
        "description": "Updates the provider type for a given UKPRN.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "Unique Provider Reference Number",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "description": "New provider type update view model.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderTypeUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the appropriate route based on the updated provider type."
          }
        },
        "security": [
          {
            "oauth2": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderTypeUpdateViewModel": {
        "type": "object",
        "properties": {
          "ProviderTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderTypeSelectionModel"
            }
          },
          "ProviderTypeId": {
            "type": "integer"
          }
        },
        "required": [
          "ProviderTypes",
          "ProviderTypeId"
        ]
      },
      "ProviderTypeSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description",
          "IsSelected"
        ]
      }
    },
    "securitySchemes": {
      "oauth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {
              "RoatpAdminTeam": "Access for RoATP Admin Team members"
            }
          }
        }
      }
    }
  }
}
