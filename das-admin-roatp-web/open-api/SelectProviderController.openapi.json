{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/select": {
      "get": {
        "operationId": "getSelectProviderPage",
        "summary": "Select a new provider.",
        "tags": [
          "Providers"
        ],
        "responses": {
          "200": {
            "description": "Renders the select provider page.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postSelectProvider",
        "summary": "Submit provider selection.",
        "tags": [
          "Providers"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProviderSubmitModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Renders the select provider page with validation errors.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "302": {
            "description": "Redirects the user either to provider details or provider not found pages."
          },
          "500": {
            "description": "Unexpected service responses handled by the system."
          }
        }
      }
    },
    "/providers/new/not-found": {
      "get": {
        "operationId": "getProviderNotFound",
        "summary": "Provider not found in UKRLP.",
        "tags": [
          "Providers"
        ],
        "responses": {
          "200": {
            "description": "Renders the provider not found page.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectProviderSubmitModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "string",
            "nullable": true,
            "description": "Unique Provider Reference Number."
          }
        }
      }
    }
  }
}
