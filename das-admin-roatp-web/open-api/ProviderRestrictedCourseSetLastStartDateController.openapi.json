{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Restricted Course Set Last Start Date API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/restricted-courses/add/set-last-start-date": {
      "get": {
        "summary": "Retrieve view model for setting last start date of restricted course",
        "operationId": "getProviderRestrictedCourseSetLastStartDate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 12345678
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View returned successfully",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to provider restricted courses route if session is null",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit last start date for restricted course",
        "operationId": "postProviderRestrictedCourseSetLastStartDate",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 12345678
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetLastDateStartsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "View returned successfully after validation errors",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to provider restricted courses route on successful submission",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SetLastDateStartsSubmitModel": {
        "type": "object",
        "properties": {
          "Day": {
            "type": "string",
            "nullable": true
          },
          "Month": {
            "type": "string",
            "nullable": true
          },
          "Year": {
            "type": "string",
            "nullable": true
          },
          "LarsCode": {
            "type": "string",
            "nullable": true
          },
          "CourseLastDateStarts": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": []
      }
    }
  }
}
