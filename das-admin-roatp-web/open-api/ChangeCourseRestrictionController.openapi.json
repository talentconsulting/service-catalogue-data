{
  "openapi": "3.1.0",
  "info": {
    "title": "Change Course Restriction API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/{larsCode}/providers/{ukprn}/change-restriction": {
      "get": {
        "operationId": "getChangeCourseRestriction",
        "summary": "Get the course restriction change view",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View rendered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeCourseRestrictionViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "post": {
        "operationId": "postChangeCourseRestriction",
        "summary": "Submit a decision on course restriction change",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeCourseRestrictionSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected based on the selected action"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeCourseRestrictionSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedOption": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ChangeCourseRestrictionViewModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "CourseDisplayTitle": {
            "type": "string"
          },
          "LastDateStarts": {
            "type": "string",
            "format": "date-time"
          },
          "SelectedOption": {
            "type": "string",
            "nullable": true
          },
          "CancelUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
