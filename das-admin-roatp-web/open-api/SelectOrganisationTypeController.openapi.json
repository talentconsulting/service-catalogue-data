{
  "openapi": "3.1.0",
  "info": {
    "title": "Add Provider API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/organisation-type": {
      "get": {
        "summary": "Get organisation types for selecting organisation type.",
        "responses": {
          "200": {
            "description": "Returns organisation type selection view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationTypeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit organisation type selection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationTypeSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the Provider Details Summary route upon successful form submission."
          },
          "400": {
            "description": "Validation errors occurred. Returns organisation type selection view with errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationTypeViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationTypeViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string",
            "description": "Legal name of the organisation."
          },
          "OrganisationTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationTypeModel"
            },
            "description": "List of organisation types."
          },
          "OrganisationTypeId": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the selected organisation type."
          }
        },
        "required": [
          "LegalName",
          "OrganisationTypes"
        ]
      },
      "OrganisationTypeSubmitModel": {
        "type": "object",
        "properties": {
          "OrganisationTypeId": {
            "type": "integer",
            "nullable": true,
            "description": "ID of the submitted organisation type selection."
          }
        }
      },
      "OrganisationTypeModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "ID of the organisation type."
          },
          "Description": {
            "type": "string",
            "description": "Description of the organisation type."
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates whether this organisation type is selected."
          }
        },
        "required": [
          "Id",
          "Description",
          "IsSelected"
        ]
      }
    }
  }
}
