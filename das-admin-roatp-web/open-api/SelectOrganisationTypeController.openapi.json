{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Organisation Type API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/organisation-type": {
      "get": {
        "summary": "Get the organisation type selection page",
        "operationId": "GetOrganisationTypeSelectionPage",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "summary": "Submit selected organisation type",
        "operationId": "SubmitOrganisationTypeSelection",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationTypeSubmitModel"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrganisationTypeSubmitModel"
              }
            }
          }
        },
        "parameters": [],
        "responses": {
          "302": {
            "description": "Successful redirection to provider details summary"
          },
          "400": {
            "description": "Validation errors occurred",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationTypeSubmitModel": {
        "type": "object",
        "properties": {
          "OrganisationTypeId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "OrganisationTypeViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "OrganisationTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganisationTypeModel"
            }
          },
          "OrganisationTypeId": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "LegalName",
          "OrganisationTypes"
        ]
      },
      "OrganisationTypeModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      },
      "RadioButtonSelectionModel": {
        "type": "object",
        "properties": {
          "IsSelected": {
            "type": "boolean"
          },
          "Checked": {
            "type": "string"
          }
        },
        "required": []
      }
    }
  }
}
