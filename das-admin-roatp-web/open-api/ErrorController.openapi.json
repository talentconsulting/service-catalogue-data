{
  "openapi": "3.1.0",
  "info": {
    "title": "ErrorController API",
    "version": "1.0.0"
  },
  "paths": {
    "/Error/{status}": {
      "get": {
        "operationId": "getErrorStatus",
        "parameters": [
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "HTTP status code indicating the type of error."
            }
          },
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uri",
              "description": "Optional URL to return to after error handling."
            }
          }
        ],
        "responses": {
          "403": {
            "description": "Access Denied view returned.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Page Not Found view returned.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Service Error view returned for other status codes.",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessDeniedViewModel": {
        "type": "object",
        "properties": {
          "dfESignInServiceHelpUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL for help with DfE Sign In service."
          }
        },
        "required": [
          "dfESignInServiceHelpUrl"
        ]
      }
    }
  }
}
