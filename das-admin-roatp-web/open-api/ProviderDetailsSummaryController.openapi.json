{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Details Summary API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/provider-details-summary": {
      "get": {
        "operationId": "GetProviderDetailsSummary",
        "summary": "View provider details summary.",
        "responses": {
          "200": {
            "description": "Provider details summary page loaded successfully.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "SubmitProviderDetailsSummary",
        "summary": "Submit provider details summary.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderDetailsSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on validation or submission result."
          }
        }
      }
    },
    "/providers/new/provider-added": {
      "get": {
        "operationId": "GetAddProviderConfirmation",
        "summary": "View confirmation after provider is added.",
        "responses": {
          "200": {
            "description": "Provider added confirmation page loaded successfully.",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to home if organization is not submitted."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderDetailsSummaryViewModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "description": "UKPRN of the provider."
          },
          "LegalName": {
            "type": "string",
            "nullable": true,
            "description": "Legal name of the provider."
          },
          "TradingName": {
            "type": "string",
            "nullable": true,
            "description": "Trading name of the provider."
          },
          "ProviderRoute": {
            "type": "string",
            "nullable": true,
            "description": "Route of the provider."
          },
          "OffersApprenticeshipsText": {
            "type": "string",
            "nullable": true,
            "description": "Specifies whether provider offers apprenticeships."
          },
          "OffersApprenticeshipUnitsText": {
            "type": "string",
            "nullable": true,
            "description": "Specifies whether provider offers apprenticeship units."
          },
          "OrganisationType": {
            "type": "string",
            "nullable": true,
            "description": "Type of the organization."
          },
          "IsSupportingProvider": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates if the provider is a supporting provider."
          },
          "ProviderTypeChangeLink": {
            "type": "string",
            "description": "Link to change provider type."
          },
          "OffersApprenticeshipsChangeLink": {
            "type": "string",
            "description": "Link to change apprenticeships offer."
          },
          "OffersApprenticeshipUnitsChangeLink": {
            "type": "string",
            "description": "Link to change apprenticeship units offer."
          },
          "OrganisationTypeChangeLink": {
            "type": "string",
            "description": "Link to change organization type."
          },
          "ManageProviderLink": {
            "type": "string",
            "description": "Link to manage provider."
          }
        },
        "required": [
          "Ukprn"
        ]
      },
      "AddProviderConfirmationViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string",
            "description": "Legal name of the provider."
          },
          "DashboardLink": {
            "type": "string",
            "description": "Link to the dashboard."
          }
        },
        "required": [
          "LegalName",
          "DashboardLink"
        ]
      }
    }
  }
}
