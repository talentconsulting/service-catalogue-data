{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Details Summary API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/provider-details-summary": {
      "get": {
        "operationId": "getProviderDetailsSummary",
        "summary": "Get provider details for summary page",
        "responses": {
          "200": {
            "description": "Provider details summary retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderDetailsSummaryViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postProviderDetailsSummary",
        "summary": "Submit provider details summary",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderDetailsSummaryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirected after successful form submission"
          }
        }
      }
    },
    "/providers/new/provider-added": {
      "get": {
        "operationId": "getAddProviderConfirmation",
        "summary": "Get confirmation of provider addition",
        "responses": {
          "302": {
            "description": "Redirected if organisation is not submitted"
          },
          "200": {
            "description": "Provider confirmation retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddProviderConfirmationViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderDetailsSummaryViewModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer"
          },
          "LegalName": {
            "type": "string"
          },
          "TradingName": {
            "type": "string"
          },
          "ProviderRoute": {
            "type": "string"
          },
          "OffersApprenticeshipsText": {
            "type": "string"
          },
          "OffersApprenticeshipUnitsText": {
            "type": "string"
          },
          "OrganisationType": {
            "type": "string"
          },
          "IsSupportingProvider": {
            "type": "boolean"
          },
          "ProviderTypeChangeLink": {
            "type": "string"
          },
          "OffersApprenticeshipsChangeLink": {
            "type": "string"
          },
          "OffersApprenticeshipUnitsChangeLink": {
            "type": "string"
          },
          "OrganisationTypeChangeLink": {
            "type": "string"
          },
          "ManageProviderLink": {
            "type": "string"
          }
        },
        "required": [
          "Ukprn"
        ]
      },
      "AddProviderConfirmationViewModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "DashboardLink": {
            "type": "string"
          }
        },
        "required": [
          "LegalName",
          "DashboardLink"
        ]
      }
    }
  }
}
