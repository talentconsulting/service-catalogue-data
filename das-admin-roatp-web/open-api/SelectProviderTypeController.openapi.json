{
  "openapi": "3.1.0",
  "info": {
    "title": "SelectProviderType API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/provider-type": {
      "get": {
        "operationId": "getProviderType",
        "summary": "Displays the view for selecting a provider type.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderTypeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postProviderType",
        "summary": "Submits the selected provider type.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProviderTypeSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect response based on selected provider type."
          },
          "400": {
            "description": "Validation errors occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderTypeViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectProviderTypeViewModel": {
        "type": "object",
        "properties": {
          "SelectedProviderTypeId": {
            "type": "integer",
            "nullable": true
          },
          "ProviderTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddProviderTypeSelectionModel"
            }
          }
        }
      },
      "SelectProviderTypeSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedProviderTypeId": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "AddProviderTypeSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
