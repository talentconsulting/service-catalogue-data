{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Type Selection API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/provider-type": {
      "get": {
        "summary": "Get provider type selection page",
        "operationId": "getProviderTypeSelectionPage",
        "responses": {
          "200": {
            "description": "The provider type selection view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderTypeViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit provider type selection",
        "operationId": "submitProviderTypeSelection",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectProviderTypeSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on selected provider type."
          },
          "400": {
            "description": "Invalid input, validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectProviderTypeViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectProviderTypeViewModel": {
        "type": "object",
        "properties": {
          "SelectedProviderTypeId": {
            "type": "integer",
            "nullable": true,
            "description": "The ID of the selected provider type."
          },
          "ProviderTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddProviderTypeSelectionModel"
            },
            "description": "List of provider types available for selection."
          }
        }
      },
      "SelectProviderTypeSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedProviderTypeId": {
            "type": "integer",
            "nullable": true,
            "description": "The ID of the selected provider type."
          }
        }
      },
      "AddProviderTypeSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The ID of the provider type."
          },
          "Description": {
            "type": "string",
            "description": "The description of the provider type."
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates if this provider type is selected."
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
