{
  "openapi": "3.1.0",
  "info": {
    "title": "Restricted Course Details API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/{larsCode}": {
      "get": {
        "operationId": "GetRestrictedCourseDetails",
        "summary": "Retrieve details for restricted courses.",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "description": "The LARS code of the course.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "description": "Optional search term to filter providers.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DeliveryStatus",
            "in": "query",
            "required": false,
            "description": "Delivery statuses to filter providers.",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/DeliveryStatus"
              }
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": false,
            "description": "The page number for pagination.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved course details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCourseDetailsViewModel"
                }
              }
            }
          },
          "404": {
            "description": "Course not found or not restricted."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeliveryStatus": {
        "type": "string",
        "enum": [
          "OpenToNewStarts",
          "LastStartDateAdded",
          "ClosedToNewStarts"
        ]
      },
      "RestrictedCourseDetailsViewModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string",
            "description": "The LARS code of the course."
          },
          "CourseName": {
            "type": "string",
            "description": "The name of the course."
          },
          "Level": {
            "type": "integer",
            "description": "The level of the course."
          },
          "Title": {
            "type": "string",
            "description": "The title of the course."
          },
          "Sector": {
            "type": "string",
            "description": "The sector or route of the course."
          },
          "LearningType": {
            "type": "string",
            "description": "The type of learning for the course."
          },
          "IsCourseRestricted": {
            "type": "boolean",
            "description": "Indicates if the course is restricted."
          },
          "RestrictedCourseDetailsPageUrl": {
            "type": "string",
            "description": "The URL for the restricted course details page."
          },
          "AddProviderUrl": {
            "type": "string",
            "description": "The URL to add a provider to the restricted course."
          },
          "HasActiveFilters": {
            "type": "boolean",
            "description": "Indicates if filters are active."
          },
          "Filters": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "Details about active filters applied."
          },
          "SuccessBannerMessage": {
            "type": "string",
            "nullable": true,
            "description": "A success banner message."
          },
          "TotalProviderCount": {
            "type": "integer",
            "description": "The total count of filtered providers."
          },
          "AllowedProviders": {
            "type": "array",
            "items": {
              "type": "object"
            },
            "description": "List of providers allowed for the course."
          },
          "Pagination": {
            "type": "object",
            "description": "Pagination details for the filtered results."
          }
        }
      }
    }
  }
}
