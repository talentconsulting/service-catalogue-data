{
  "openapi": "3.1.0",
  "info": {
    "title": "Restricted Course Change Restriction API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/restricted-courses/{larsCode}/change-restriction": {
      "get": {
        "summary": "Get the restricted course change restriction view",
        "operationId": "getRestrictedCourseChangeRestriction",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to another route due to a missing apprenticeship or session issue"
          },
          "404": {
            "description": "Provider name could not be found"
          },
          "200": {
            "description": "Success",
            "content": {
              "text/html": {}
            }
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "summary": "Submit a change for the restricted course restriction",
        "operationId": "postRestrictedCourseChangeRestriction",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Payload to submit restricted course change restriction",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RestrictedCourseChangeRestrictionSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to another route based on the selected option or a session issue"
          },
          "200": {
            "description": "Validation errors occurred",
            "content": {
              "text/html": {}
            }
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "RestrictedCourseChangeRestrictionSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedOption": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
