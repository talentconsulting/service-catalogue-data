{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Summary API",
    "description": "API for managing and viewing provider summaries in the RoATP system.",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}": {
      "get": {
        "summary": "Get Provider Summary",
        "description": "Fetches the summary of a provider given their UKPRN.",
        "operationId": "getProviderSummary",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK Provider Reference Number of the provider",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with provider summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderSummaryViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirection to the home route."
          }
        },
        "security": [
          {
            "RoleBasedAuth": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderSummaryViewModel": {
        "type": "object",
        "properties": {
          "SearchProviderUrl": {
            "type": "string",
            "description": "URL for searching a provider."
          },
          "StatusChangeLink": {
            "type": "string",
            "description": "URL for changing the provider's status."
          },
          "ProviderTypeChangeLink": {
            "type": "string",
            "description": "URL for changing the provider's type."
          },
          "OrganisationTypeChangeLink": {
            "type": "string",
            "description": "URL for changing the provider's organisation type."
          },
          "OffersApprenticeshipUnitsChangeLink": {
            "type": "string",
            "description": "URL for changing whether the provider offers apprenticeship units."
          },
          "ManageRestrictedCoursesUrl": {
            "type": "string",
            "description": "URL for managing restricted apprenticeship courses."
          },
          "ManageApprovedCoursesUrl": {
            "type": "string",
            "description": "URL for managing approved courses for the provider."
          },
          "ChangeHowWeManageThisProviderUrl": {
            "type": "string",
            "description": "URL for changing how the provider is managed."
          },
          "ManageApprovedUnitsUrl": {
            "type": "string",
            "description": "URL for managing the provider's approved units."
          }
        },
        "required": [
          "SearchProviderUrl",
          "StatusChangeLink",
          "ProviderTypeChangeLink",
          "OrganisationTypeChangeLink",
          "OffersApprenticeshipUnitsChangeLink",
          "ManageRestrictedCoursesUrl",
          "ManageApprovedCoursesUrl",
          "ChangeHowWeManageThisProviderUrl",
          "ManageApprovedUnitsUrl"
        ]
      }
    },
    "securitySchemes": {
      "RoleBasedAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Role-based authorization using the 'RoatpAdminTeam' role."
      }
    }
  }
}
