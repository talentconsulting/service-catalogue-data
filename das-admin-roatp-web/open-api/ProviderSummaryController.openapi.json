{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Summary API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}": {
      "get": {
        "summary": "Get provider summary",
        "description": "Retrieves the summary details of a provider specified by UKPRN.",
        "operationId": "GetProviderSummary",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "The UK Provider Reference Number (UKPRN) of the provider.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the provider's summary details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetOrganisationResponse"
                }
              }
            }
          },
          "302": {
            "description": "Redirected to the homepage if the provider's details are not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetOrganisationResponse": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string",
            "description": "The legal name of the provider."
          }
        },
        "additionalProperties": true
      }
    }
  }
}
