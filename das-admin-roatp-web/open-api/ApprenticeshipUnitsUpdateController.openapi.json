{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Units Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/apprenticeship-units": {
      "get": {
        "operationId": "GetApprenticeshipUnits",
        "summary": "Retrieve the Apprenticeship Units information for a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The UKPRN (UK Provider Reference Number) of the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with the Apprenticeship Units information.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprenticeshipUnitsUpdateViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to the home route if the organization is not found."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      },
      "post": {
        "operationId": "UpdateApprenticeshipUnits",
        "summary": "Update the Apprenticeship Units information for a provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The UKPRN (UK Provider Reference Number) of the provider."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeshipUnitsUpdateViewModel"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApprenticeshipUnitsUpdateViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the home or provider summary route based on the operation result."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApprenticeshipUnitsUpdateViewModel": {
        "type": "object",
        "properties": {
          "apprenticeshipUnitsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipUnitsSelectionModel"
            },
            "description": "A list of options for apprenticeship units selection."
          },
          "offersApprenticeships": {
            "type": "boolean",
            "description": "Indicates whether the provider offers apprenticeships."
          },
          "apprenticeshipUnitsSelectionId": {
            "type": "boolean",
            "nullable": true,
            "description": "The selected apprenticeship units choice."
          }
        },
        "required": [
          "offersApprenticeships"
        ]
      },
      "ApprenticeshipUnitsSelectionModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "boolean",
            "description": "The ID of the selection option."
          },
          "description": {
            "type": "string",
            "description": "Description of the selection option."
          },
          "isSelected": {
            "type": "boolean",
            "description": "Indicates whether the option is selected."
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
