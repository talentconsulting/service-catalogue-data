{
  "openapi": "3.1.0",
  "info": {
    "title": "Restrict Course Confirm API",
    "description": "API for managing course restrictions.",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/add/{larsCode}/confirm": {
      "get": {
        "operationId": "GetRestrictCourseConfirm",
        "summary": "Display confirmation view for restricting a course",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The LARS code of the course."
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the unrestricted course details route if the session model is invalid."
          },
          "200": {
            "description": "Returns the confirmation view for restricting the course."
          }
        },
        "security": [
          {
            "roles": {
              "type": "string",
              "example": "RoatpAdminTeam"
            }
          }
        ]
      },
      "post": {
        "operationId": "PostRestrictCourseConfirm",
        "summary": "Restrict a course",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The LARS code of the course."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddRestrictedCourseRequest"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the unrestricted course details route if the session model is invalid."
          },
          "201": {
            "description": "Redirects to the restricted course details route after successfully restricting the course."
          }
        },
        "security": [
          {
            "roles": {
              "type": "string",
              "example": "RoatpAdminTeam"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddRestrictedCourseRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string",
            "description": "The ID of the user performing the operation."
          },
          "UserDisplayName": {
            "type": "string",
            "description": "The display name of the user performing the operation."
          },
          "LarsCode": {
            "type": "string",
            "description": "The LARS code of the course being restricted."
          }
        },
        "required": [
          "UserId",
          "UserDisplayName",
          "LarsCode"
        ]
      }
    }
  }
}
