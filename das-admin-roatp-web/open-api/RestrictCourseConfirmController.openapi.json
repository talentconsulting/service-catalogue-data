{
  "openapi": "3.1.0",
  "info": {
    "title": "Restrict Course Confirm API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses/add/{larsCode}/confirm": {
      "get": {
        "summary": "Get confirmation page for restricting a course",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the course being restricted"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected to unrestricted course details if session is null"
          },
          "200": {
            "description": "Success - Restrict confirmation page rendered",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Restricted Courses"
        ]
      },
      "post": {
        "summary": "Confirm restriction of a course",
        "parameters": [
          {
            "name": "larsCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "LARS code of the course being restricted"
          }
        ],
        "responses": {
          "302": {
            "description": "Redirected based on result of restriction process",
            "headers": {
              "Location": {
                "description": "URL of the target redirect",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tags": [
          "Restricted Courses"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AddRestrictedCourseRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          },
          "UserDisplayName": {
            "type": "string"
          },
          "LarsCode": {
            "type": "string"
          }
        }
      },
      "AddRestrictedCourseSessionModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          }
        }
      },
      "RestrictCourseConfirmViewModel": {
        "type": "object",
        "properties": {
          "LarsCode": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          },
          "CancelUrl": {
            "type": "string"
          }
        }
      }
    }
  }
}
