{
  "openapi": "3.1.0",
  "info": {
    "title": "Registered Providers API",
    "version": "1.0.0"
  },
  "paths": {
    "/RegisteredProviders": {
      "get": {
        "summary": "Retrieve registered providers",
        "operationId": "getRegisteredProviders",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term to filter providers by legal name or UKPRN. Minimum length is 3."
          }
        ],
        "responses": {
          "200": {
            "description": "Matched registered providers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrganisationModel"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "Represents a registered organisation with legal name and UKPRN."
      }
    }
  }
}
