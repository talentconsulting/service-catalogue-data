{
  "openapi": "3.1.0",
  "info": {
    "title": "Registered Providers API",
    "version": "1.0.0"
  },
  "paths": {
    "/RegisteredProviders": {
      "get": {
        "summary": "Retrieve a list of registered providers matching the search query",
        "operationId": "getRegisteredProviders",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term to match providers (minimum length of 3 characters)"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of matched registered providers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrganisationModel"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrganisationModel": {
        "type": "object",
        "properties": {
          "LegalName": {
            "type": "string",
            "description": "The legal name of the organisation"
          },
          "Ukprn": {
            "type": "integer",
            "description": "The UKPRN (UK Provider Reference Number) of the organisation"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
