{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Restricted Course Search API",
    "version": "1.0.0",
    "description": "API for managing restricted courses for providers."
  },
  "paths": {
    "/providers/{ukprn}/restricted-courses/add": {
      "get": {
        "summary": "Display the restricted course search page.",
        "operationId": "getRestrictedCourseSearch",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Unique identifier for the provider."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response displaying the restricted course search page.",
            "content": {
              "text/html": {
                "examples": {
                  "example": {
                    "description": "HTML view displayed."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Provider not found or no courses available."
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      },
      "post": {
        "summary": "Submit selected course for restriction.",
        "operationId": "postRestrictedCourseSearch",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Unique identifier for the provider."
            }
          }
        ],
        "requestBody": {
          "description": "Submit model for restricted course search.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderRestrictedCourseSearchSubmitModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "302": {
            "description": "Redirects based on whether the provider-course relationship exists."
          },
          "404": {
            "description": "Selected course or provider not found."
          },
          "400": {
            "description": "Validation errors occurred.",
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "description": "Validation failed for the given input."
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "roles": [
              "RoatpAdminTeam"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderRestrictedCourseSearchSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedLarsCode": {
            "type": "string",
            "nullable": true,
            "description": "LARS code for the selected course."
          }
        }
      }
    }
  }
}
