{
  "openapi": "3.1.0",
  "info": {
    "title": "Unrestricted Course Search API",
    "version": "1.0.0"
  },
  "paths": {
    "/unrestricted-courses/search": {
      "get": {
        "summary": "Get unrestricted courses for search.",
        "operationId": "UnrestrictedCourseSearch_Index_Get",
        "responses": {
          "200": {
            "description": "HTML view of unrestricted courses search results."
          }
        }
      },
      "post": {
        "summary": "Submit unrestricted course search.",
        "operationId": "UnrestrictedCourseSearch_Index_Post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnrestrictedCourseSearchSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to unrestricted course details based on selected course."
          },
          "400": {
            "description": "Validation errors encountered."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnrestrictedCourseSearchSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedLarsCode": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
