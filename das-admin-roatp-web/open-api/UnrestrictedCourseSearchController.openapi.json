{
  "openapi": "3.1.0",
  "info": {
    "title": "Unrestricted Course Search API",
    "version": "1.0.0",
    "description": "API for managing unrestricted course search."
  },
  "paths": {
    "/unrestricted-courses/search": {
      "get": {
        "summary": "Search unrestricted courses",
        "operationId": "GetUnrestrictedCourses",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      },
      "post": {
        "summary": "Submit unrestricted course search",
        "operationId": "SubmitUnrestrictedCourseSearch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UnrestrictedCourseSearchSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to course details"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UnrestrictedCourseSearchSubmitModel": {
        "type": "object",
        "properties": {
          "SelectedLarsCode": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
