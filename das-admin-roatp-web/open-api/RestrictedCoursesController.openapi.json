{
  "openapi": "3.1.0",
  "info": {
    "title": "Restricted Courses API",
    "version": "1.0.0"
  },
  "paths": {
    "/restricted-courses": {
      "get": {
        "summary": "Get restricted courses",
        "description": "Retrieves a list of restricted courses, optionally filtered by various criteria.",
        "operationId": "getRestrictedCourses",
        "parameters": [
          {
            "name": "SearchTerm",
            "in": "query",
            "description": "Search term to filter courses.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "LearningType",
            "in": "query",
            "description": "Filter by learning type.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/LearningType"
              }
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "description": "Page number for pagination.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of restricted courses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RestrictedCoursesViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "ApprenticeshipUnit",
          "FoundationApprenticeship"
        ]
      },
      "RestrictedCoursesViewModel": {
        "type": "object",
        "properties": {
          "HasActiveFilters": {
            "type": "boolean"
          },
          "Filters": {
            "type": "string",
            "description": "Filters applied to the courses."
          },
          "TotalCount": {
            "type": "integer",
            "description": "Total number of restricted courses."
          },
          "Courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RestrictedCourseItemViewModel"
            },
            "description": "List of paginated courses."
          },
          "Pagination": {
            "type": "string",
            "description": "Pagination details."
          }
        }
      },
      "RestrictedCourseItemViewModel": {
        "type": "object",
        "description": "A restricted course item."
      }
    }
  }
}
