{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeships Update API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/{ukprn}/apprenticeships": {
      "get": {
        "summary": "Get apprenticeships for a provider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "UK Provider Reference Number"
          }
        ],
        "responses": {
          "200": {
            "description": "Success response displaying the apprenticeships offered by the provider",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to home if the provider is invalid or session data is missing"
          }
        }
      },
      "post": {
        "summary": "Update apprenticeships for a provider",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "UK Provider Reference Number"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferApprenticeshipsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the next appropriate page if the input is valid",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "The URL for the next page"
              }
            }
          },
          "400": {
            "description": "Validation error, showing the invalid fields and resubmitting the form",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipsViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfferApprenticeshipsViewModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipsOffered": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates if the provider offers apprenticeships"
          },
          "ApprenticeshipsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipsSelectionModel"
            },
            "description": "List of apprenticeship selection options"
          }
        }
      },
      "OfferApprenticeshipsSubmitModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipsOffered": {
            "type": "boolean",
            "nullable": true,
            "description": "Flag indicating if the provider offers apprenticeships"
          }
        },
        "required": []
      },
      "ApprenticeshipsSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "boolean",
            "description": "The selection identifier (true for Yes, false for No)"
          },
          "Description": {
            "type": "string",
            "description": "Description of the selection option"
          },
          "IsSelected": {
            "type": "boolean",
            "description": "Indicates if this option is selected"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
