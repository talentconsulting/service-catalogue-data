{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Details API",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/details": {
      "get": {
        "operationId": "GetProviderDetails",
        "summary": "Get provider details",
        "tags": [
          "ProviderDetails"
        ],
        "responses": {
          "200": {
            "description": "Successful response with provider details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderDetailsViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderDetailsViewModel": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "description": "The unique provider reference number"
          },
          "LegalName": {
            "type": "string",
            "description": "The legal name of the provider"
          },
          "TradingName": {
            "type": "string",
            "description": "The trading name of the provider"
          },
          "CompanyNumber": {
            "type": "string",
            "description": "The company number of the provider"
          },
          "CharityNumber": {
            "type": "string",
            "description": "The charity number of the provider"
          },
          "SelectProviderTypeUrl": {
            "type": "string",
            "format": "uri",
            "description": "The URL to select provider type"
          },
          "SelectProviderUrl": {
            "type": "string",
            "format": "uri",
            "description": "The URL to add a provider"
          }
        },
        "required": [
          "Ukprn",
          "LegalName",
          "TradingName",
          "CompanyNumber",
          "CharityNumber",
          "SelectProviderTypeUrl",
          "SelectProviderUrl"
        ]
      }
    }
  }
}
