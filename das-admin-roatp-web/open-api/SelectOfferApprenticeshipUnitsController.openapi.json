{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Offer Apprenticeship Units API",
    "description": "API for managing apprenticeship unit offerings in the 'Add Provider' workflow.",
    "version": "1.0.0"
  },
  "paths": {
    "/providers/new/offer-apprenticeship-units": {
      "get": {
        "operationId": "getOfferApprenticeshipUnits",
        "summary": "Get Offer Apprenticeship Units",
        "description": "Retrieves the view model for selecting if apprenticeship units are offered.",
        "responses": {
          "200": {
            "description": "Successful response with the OfferApprenticeshipUnitsViewModel.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipUnitsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to home if the provider type is 'Supporting'."
          }
        }
      },
      "post": {
        "operationId": "postOfferApprenticeshipUnits",
        "summary": "Submit Offer Apprenticeship Units",
        "description": "Submits the selected choice for offering apprenticeship units.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferApprenticeshipUnitsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to Provider Details Summary or Select Organisation Type based on the session state."
          },
          "400": {
            "description": "Validation errors in the submitted data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipUnitsViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfferApprenticeshipUnitsViewModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipUnitsOffered": {
            "type": "boolean",
            "nullable": true
          },
          "ApprenticeshipUnitsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipUnitsSelectionModel"
            }
          }
        },
        "required": [
          "ApprenticeshipUnitsSelection"
        ]
      },
      "OfferApprenticeshipUnitsSubmitModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipUnitsOffered": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "ApprenticeshipUnitsSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "boolean"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
