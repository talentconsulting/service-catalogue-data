{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Offer Apprenticeship Units API",
    "version": "1.0.0",
    "description": "API for managing the selection of apprenticeship units offered by providers."
  },
  "paths": {
    "/providers/new/offer-apprenticeship-units": {
      "get": {
        "summary": "Get the page for selecting apprenticeship units offer.",
        "operationId": "getSelectOfferApprenticeshipUnits",
        "responses": {
          "200": {
            "description": "Returns the view model containing apprenticeship units selection details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipUnitsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects user if provider type is Supporting."
          }
        }
      },
      "post": {
        "summary": "Submit the apprenticeship units offer selection.",
        "operationId": "postSelectOfferApprenticeshipUnits",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OfferApprenticeshipUnitsSubmitModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Returns a view model with validation errors.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OfferApprenticeshipUnitsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirects to summary or organisation type selection pages based on context."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OfferApprenticeshipUnitsViewModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipUnitsOffered": {
            "type": "boolean",
            "nullable": true
          },
          "ApprenticeshipUnitsSelection": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipUnitsSelectionModel"
            }
          }
        },
        "required": [
          "ApprenticeshipUnitsSelection"
        ]
      },
      "OfferApprenticeshipUnitsSubmitModel": {
        "type": "object",
        "properties": {
          "IsApprenticeshipUnitsOffered": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "ApprenticeshipUnitsSelectionModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "boolean"
          },
          "Description": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        },
        "required": [
          "Id",
          "Description"
        ]
      }
    }
  }
}
