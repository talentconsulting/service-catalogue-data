{
  "openapi": "3.1.0",
  "info": {
    "title": "Results and Certification Timeout API",
    "description": "API for managing timeout functionality for the Results and Certification system.",
    "version": "1.0.0"
  },
  "paths": {
    "/active-duration": {
      "get": {
        "operationId": "GetActiveDuration",
        "description": "Retrieves the remaining active duration for the current user session.",
        "responses": {
          "200": {
            "description": "Returns the remaining active duration in minutes and seconds.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionActivityData"
                }
              }
            }
          }
        }
      }
    },
    "/renew-activity": {
      "get": {
        "operationId": "RenewSessionActivity",
        "description": "Renews the session activity for the user by resetting the timeout.",
        "responses": {
          "200": {
            "description": "Returns the renewed session activity duration.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionActivityData"
                }
              }
            }
          }
        }
      }
    },
    "/activity-timeout": {
      "get": {
        "operationId": "ActivityTimeout",
        "description": "Logs out the user and clears the session activity.",
        "responses": {
          "204": {
            "description": "Successfully logged out and session cleared."
          }
        }
      }
    },
    "/timeout": {
      "get": {
        "operationId": "TimeoutConfirmation",
        "description": "Displays a confirmation page indicating the user has been timed out.",
        "responses": {
          "200": {
            "description": "Returns the timeout confirmation view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SessionActivityData": {
        "type": "object",
        "properties": {
          "Minutes": {
            "type": "integer",
            "description": "Remaining minutes of active duration."
          },
          "Seconds": {
            "type": "integer",
            "description": "Remaining seconds of active duration."
          }
        },
        "required": [
          "Minutes",
          "Seconds"
        ]
      }
    }
  }
}
