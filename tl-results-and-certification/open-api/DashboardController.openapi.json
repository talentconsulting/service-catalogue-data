{
  "openapi": "3.1.0",
  "info": {
    "title": "Results and Certification Dashboard API",
    "version": "1.0.0"
  },
  "paths": {
    "/home": {
      "get": {
        "tags": [
          "Dashboard"
        ],
        "summary": "Retrieves the dashboard view model",
        "operationId": "GetDashboardIndex",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The dashboard view model",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to service access denied route"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DashboardViewModel": {
        "type": "object",
        "properties": {
          "hasAccessToService": {
            "type": "boolean",
            "description": "Indicates whether the user has access to the service."
          }
        },
        "required": [
          "hasAccessToService"
        ]
      }
    }
  }
}
