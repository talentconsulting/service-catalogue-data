{
  "openapi": "3.1.0",
  "info": {
    "title": "Account API",
    "version": "1.0.0"
  },
  "paths": {
    "/signin": {
      "get": {
        "summary": "Initiates the sign-in process.",
        "operationId": "SignIn",
        "tags": [
          "Account"
        ],
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirected to sign-in endpoint."
          }
        },
        "security": []
      }
    },
    "/postsignin": {
      "get": {
        "summary": "Handles post sign-in redirection logic.",
        "operationId": "PostSignIn",
        "tags": [
          "Account"
        ],
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirected based on user authentication and access conditions."
          }
        },
        "security": []
      }
    },
    "/signout": {
      "get": {
        "summary": "Signs out the user from both cookie and OpenID authentication.",
        "operationId": "SignOut",
        "tags": [
          "Account"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "User successfully signed out."
          }
        },
        "security": []
      }
    },
    "/sign-out": {
      "get": {
        "summary": "Signs out a user from DfE authentication.",
        "operationId": "SignOutDsi",
        "tags": [
          "Account"
        ],
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirected to configured DfE sign-out URL."
          }
        },
        "security": []
      }
    },
    "/signout-complete": {
      "get": {
        "summary": "Completes the sign-out process with a redirect.",
        "operationId": "SignoutComplete",
        "tags": [
          "Account"
        ],
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirected to either the configured sign-out URI or the home page."
          }
        },
        "security": []
      }
    },
    "/account-profile": {
      "get": {
        "summary": "Redirects to account profile URL.",
        "operationId": "Profile",
        "tags": [
          "Account"
        ],
        "parameters": [],
        "responses": {
          "302": {
            "description": "Redirected to the account profile URL."
          },
          "404": {
            "description": "Page not found if profile URL configuration is missing."
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
