{
  "openapi": "3.1.0",
  "info": {
    "title": "Industry Placement Import API",
    "version": "1.0.0"
  },
  "paths": {
    "/upload-industry-placements-file/{requestErrorTypeId}": {
      "get": {
        "summary": "Upload Industry Placements File",
        "operationId": "UploadIndustryPlacementsFile",
        "parameters": [
          {
            "name": "requestErrorTypeId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Load upload industry placements file page",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/upload-industry-placements-file": {
      "post": {
        "summary": "Submit Upload Industry Placements File",
        "operationId": "SubmitUploadIndustryPlacementsFile",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadIndustryPlacementsRequestViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "302": {
            "description": "Redirect based on processing result",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/upload-ip-file-success": {
      "get": {
        "summary": "Upload Successful Page",
        "operationId": "IndustryPlacementsUploadSuccessful",
        "responses": {
          "200": {
            "description": "Return upload successful response",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to page not found if data missing",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/ip-upload-unsuccessful": {
      "get": {
        "summary": "Upload Unsuccessful Page",
        "operationId": "IndustryPlacementsUploadUnsuccessful",
        "responses": {
          "200": {
            "description": "Return upload unsuccessful response",
            "content": {
              "text/html": {}
            }
          },
          "302": {
            "description": "Redirect to page not found if data missing",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/download-industry-placement-errors": {
      "get": {
        "summary": "Download Industry Placement Errors",
        "operationId": "DownloadIndustryPlacementErrors",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Return validation errors file",
            "content": {
              "text/csv": {}
            }
          },
          "302": {
            "description": "Redirect if file not found or invalid id",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UploadIndustryPlacementsRequestViewModel": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer",
            "description": "The awarding organization UKPRN"
          },
          "File": {
            "type": "string",
            "format": "binary",
            "description": "CSV file to upload"
          },
          "RequestErrorTypeId": {
            "type": "integer",
            "description": "Optional error type ID"
          }
        },
        "required": [
          "File"
        ]
      }
    }
  }
}
