{
  "openapi": "3.1.0",
  "info": {
    "title": "Results and Certification API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Result/ProcessBulkResults": {
      "post": {
        "operationId": "ProcessBulkResults",
        "summary": "Processes bulk results file.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkProcessRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkResultResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Result/GetResultDetails/{aoUkprn}/{profileId}/{status}": {
      "get": {
        "operationId": "GetResultDetails",
        "summary": "Gets the result details of a learner profile.",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Result/AddResult": {
      "post": {
        "operationId": "AddResult",
        "summary": "Adds a new result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddResultResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Result/ChangeResult": {
      "put": {
        "operationId": "ChangeResult",
        "summary": "Changes an existing result.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChangeResultResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddResultRequest": {
        "type": "object",
        "properties": {
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentId": {
            "type": "integer",
            "format": "int32"
          },
          "lookupId": {
            "type": "integer",
            "format": "int32"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "performedBy": {
            "type": "string"
          }
        },
        "required": [
          "aoUkprn",
          "profileId",
          "assessmentId",
          "lookupId",
          "componentType",
          "performedBy"
        ]
      },
      "AddResultResponse": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "isSuccess": {
            "type": "boolean"
          }
        }
      },
      "BulkProcessRequest": {
        "type": "object",
        "properties": {
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "blobFileName": {
            "type": "string"
          },
          "blobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "fileType": {
            "$ref": "#/components/schemas/FileType"
          },
          "documentType": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "loginUserType": {
            "$ref": "#/components/schemas/LoginUserType"
          },
          "performedBy": {
            "type": "string"
          }
        },
        "required": [
          "aoUkprn",
          "blobFileName",
          "blobUniqueReference",
          "fileType",
          "documentType",
          "loginUserType",
          "performedBy"
        ]
      },
      "BulkResultResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/BulkProcessResponse"
          }
        ]
      },
      "BulkProcessResponse": {
        "type": "object",
        "properties": {
          "isSuccess": {
            "type": "boolean"
          },
          "blobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "errorFileSize": {
            "type": "number",
            "format": "double"
          },
          "stats": {
            "$ref": "#/components/schemas/BulkUploadStats"
          }
        }
      },
      "BulkUploadStats": {
        "type": "object",
        "properties": {
          "totalRecordsCount": {
            "type": "integer",
            "format": "int32"
          },
          "newRecordsCount": {
            "type": "integer",
            "format": "int32"
          },
          "amendedRecordsCount": {
            "type": "integer",
            "format": "int32"
          },
          "unchangedRecordsCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ChangeResultRequest": {
        "type": "object",
        "properties": {
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "resultId": {
            "type": "integer",
            "format": "int32"
          },
          "lookupId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "performedBy": {
            "type": "string"
          }
        },
        "required": [
          "aoUkprn",
          "uln",
          "profileId",
          "resultId",
          "componentType",
          "performedBy"
        ]
      },
      "ChangeResultResponse": {
        "type": "object",
        "allOf": [
          {
            "$ref": "#/components/schemas/AddResultResponse"
          }
        ]
      },
      "ResultDetails": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "dateofBirth": {
            "type": "string",
            "format": "date-time"
          },
          "providerUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "providerName": {
            "type": "string"
          },
          "tlevelTitle": {
            "type": "string"
          },
          "pathwayLarId": {
            "type": "string"
          },
          "pathwayName": {
            "type": "string"
          },
          "pathwayAssessmentSeries": {
            "type": "string"
          },
          "pathwayAssessmentId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "appealEndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "pathwayResultId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "pathwayResultCode": {
            "type": "string"
          },
          "pathwayResult": {
            "type": "string"
          },
          "pathwayPrsStatus": {
            "$ref": "#/components/schemas/PrsStatus"
          },
          "status": {
            "$ref": "#/components/schemas/RegistrationPathwayStatus"
          }
        }
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "Registrations",
          "Assessments",
          "Results",
          "Documents",
          "Ucas",
          "DataExports",
          "OverallResults",
          "IndustryPlacements",
          "AnalystOverallResults",
          "AnalystCoreResults",
          "CoreRomm",
          "SpecialismRomm",
          "ProviderAddressess",
          "CertificateTracking",
          "Withdrawals",
          "ResultSlips",
          "Romms",
          "Aspose"
        ]
      },
      "FileType": {
        "type": "string",
        "enum": [
          "Csv",
          "Xlsx",
          "Pdf"
        ]
      },
      "LoginUserType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "AwardingOrganisation",
          "TrainingProvider",
          "Admin"
        ]
      },
      "PrsStatus": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "UnderReview",
          "Reviewed",
          "BeingAppealed",
          "Final",
          "Withdraw"
        ]
      },
      "RegistrationPathwayStatus": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Active",
          "InActive",
          "Transferred",
          "Withdrawn"
        ]
      }
    }
  }
}
