{
  "openapi": "3.1.0",
  "info": {
    "title": "Results and Certification API",
    "version": "1.0.0",
    "description": "API for managing T Level results and certification."
  },
  "paths": {
    "/results": {
      "get": {
        "operationId": "GetResultsDashboard",
        "summary": "Get results dashboard view.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "Dashboard view returned."
          }
        }
      }
    },
    "/upload-results-file/{requestErrorTypeId}": {
      "get": {
        "operationId": "GetUploadResultsFile",
        "summary": "Upload Results File",
        "tags": [
          "Results"
        ],
        "parameters": [
          {
            "name": "requestErrorTypeId",
            "in": "path",
            "description": "Optional request error type ID.",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File upload view returned."
          }
        }
      },
      "post": {
        "operationId": "PostUploadResultsFile",
        "summary": "Submit a results file for upload.",
        "tags": [
          "Results"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadResultsRequestViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File upload processed successfully."
          },
          "400": {
            "description": "Validation errors encountered."
          }
        }
      }
    },
    "/results-upload-confirmation": {
      "get": {
        "operationId": "GetResultsUploadConfirmation",
        "summary": "Confirmation for successful results upload.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "Confirmation page returned."
          },
          "404": {
            "description": "Upload confirmation not found."
          }
        }
      }
    },
    "/results-upload-unsuccessful": {
      "get": {
        "operationId": "GetResultsUploadUnsuccessful",
        "summary": "View for unsuccessful results upload.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "Unsuccessful upload page returned."
          },
          "404": {
            "description": "Unsuccessful upload data not found."
          }
        }
      }
    },
    "/results-file-upload-service-problem": {
      "get": {
        "operationId": "GetResultsFileUploadServiceProblem",
        "summary": "Error page for service-related problems during results file upload.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "Service problem page returned."
          }
        }
      }
    },
    "/download-result-errors": {
      "get": {
        "operationId": "DownloadResultErrors",
        "summary": "Download error file for uploaded results.",
        "tags": [
          "Results"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "description": "Unique ID for the error file.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file returned for errors.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Error file not found."
          }
        }
      }
    },
    "/results-generating-download": {
      "get": {
        "operationId": "GetResultsGeneratingDownload",
        "summary": "Indicates results data file is generating.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "Generating download page returned."
          }
        }
      },
      "post": {
        "operationId": "PostResultsGeneratingDownload",
        "summary": "Submit for results data file generation.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "File generation initiated successfully."
          },
          "400": {
            "description": "File generation failed."
          }
        }
      }
    },
    "/results-download-data": {
      "get": {
        "operationId": "GetResultsDownloadData",
        "summary": "Download results data file.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "Results data file available for download."
          },
          "404": {
            "description": "Results data file not found."
          }
        }
      }
    },
    "/download-results-data/{id}/{componentType}": {
      "get": {
        "operationId": "DownloadResultsDataLink",
        "summary": "Download specific results data file.",
        "tags": [
          "Results"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Unique ID for the results data file.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "componentType",
            "in": "path",
            "description": "Type of results data to download (e.g., Core, Specialism).",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "Core",
                "Specialism"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV file returned with requested data.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Requested results data file not found."
          }
        }
      }
    },
    "/results-no-records-found": {
      "get": {
        "operationId": "GetResultsNoRecordsFound",
        "summary": "Page for no records found during results data download.",
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "Page displayed for no records found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UploadResultsRequestViewModel": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer",
            "description": "Awarding organization UKPRN."
          },
          "File": {
            "type": "string",
            "format": "binary",
            "description": "CSV file containing results."
          },
          "RequestErrorTypeId": {
            "type": "integer",
            "nullable": true,
            "description": "Optional error type ID for request."
          }
        },
        "required": [
          "File"
        ]
      }
    }
  }
}
