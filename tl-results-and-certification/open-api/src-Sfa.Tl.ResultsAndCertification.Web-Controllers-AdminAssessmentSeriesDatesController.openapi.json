{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminAssessmentSeriesDates API",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/search-assessment-series-dates-clear": {
      "get": {
        "operationId": "SearchAssessmentSeriesDatesClear",
        "summary": "Clears assessment series search criteria.",
        "responses": {
          "302": {
            "description": "Redirects to the search assessment series dates route."
          }
        }
      }
    },
    "/admin/search-assessment-series-dates": {
      "get": {
        "operationId": "SearchAssessmentSeriesDates",
        "summary": "Searches for assessment series dates with optional pagination.",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "query",
            "description": "Page number for pagination.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": null
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Displays a list of assessment series dates.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/admin/search-assessment-series-dates-apply-filters": {
      "post": {
        "operationId": "SearchAssessmentSeriesDatesApplyFilters",
        "summary": "Applies filters to search assessment series dates.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminAssessmentSeriesDatesCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the search assessment series dates route with filters applied."
          }
        }
      }
    },
    "/admin/search-assessment-series-dates-clear-filters": {
      "post": {
        "operationId": "SearchAssessmentSeriesDatesClearFilters",
        "summary": "Clears filters applied to assessment series dates search.",
        "responses": {
          "302": {
            "description": "Redirects to the search assessment series dates route with filters cleared."
          }
        }
      }
    },
    "/admin/assessment-series-date/{assessmentId}": {
      "get": {
        "operationId": "AdminAssessmentSeriesDateDetails",
        "summary": "Fetches details for a specific assessment series date.",
        "parameters": [
          {
            "name": "assessmentId",
            "in": "path",
            "description": "The ID of the assessment series.",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the problem with service route if no data is found."
          },
          "200": {
            "description": "Displays details for the specified assessment series date.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminAssessmentSeriesDatesCriteriaViewModel": {
        "type": "object",
        "properties": {
          "ActiveFilters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterLookupData"
            }
          },
          "AreFiltersApplied": {
            "type": "boolean"
          },
          "PageNumber": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FilterLookupData": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "type": "string"
          },
          "CoreCode": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
