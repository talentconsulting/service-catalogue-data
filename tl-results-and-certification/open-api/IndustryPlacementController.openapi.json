{
  "openapi": "3.1.0",
  "info": {
    "title": "Industry Placement API",
    "version": "1.0.0",
    "description": "API interface for managing industry placement workflows and data."
  },
  "paths": {
    "/add-industry-placement/{profileId}": {
      "get": {
        "operationId": "AddIndustryPlacement",
        "summary": "Redirect to Add Industry Placement workflow.",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to Industry Placement Completion workflow."
          },
          "404": {
            "description": "Profile not found."
          }
        }
      }
    },
    "/change-industry-placement/{profileId}": {
      "get": {
        "operationId": "ChangeIndustryPlacement",
        "summary": "Redirect to Change Industry Placement workflow.",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to a change-specific Industry Placement workflow."
          },
          "404": {
            "description": "Profile not found."
          }
        }
      }
    },
    "/industry-placement-completion/{profileId}/{isChangeMode}": {
      "get": {
        "operationId": "GetIpCompletion",
        "summary": "Retrieve industry placement completion data.",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "isChangeMode",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns industry placement completion details."
          },
          "404": {
            "description": "Data not found."
          }
        }
      },
      "post": {
        "operationId": "SubmitIpCompletion",
        "summary": "Submit industry placement completion details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IpCompletionViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission successful."
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found."
          }
        }
      }
    },
    "/industry-placement-special-consideration-hours/{isChangeMode}": {
      "get": {
        "operationId": "GetIpSpecialConsiderationHours",
        "summary": "Retrieve special consideration industry placement hours.",
        "parameters": [
          {
            "name": "isChangeMode",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns special consideration hours details."
          },
          "404": {
            "description": "Data not found."
          }
        }
      },
      "post": {
        "operationId": "SubmitIpSpecialConsiderationHours",
        "summary": "Submit special consideration hours.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecialConsiderationHoursViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission successful."
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found."
          }
        }
      }
    },
    "/industry-placement-special-consideration-reasons/{isChangeMode}": {
      "get": {
        "operationId": "GetIpSpecialConsiderationReasons",
        "summary": "Retrieve special consideration reasons.",
        "parameters": [
          {
            "name": "isChangeMode",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns special consideration reasons details."
          },
          "404": {
            "description": "Data not found."
          }
        }
      },
      "post": {
        "operationId": "SubmitIpSpecialConsiderationReasons",
        "summary": "Submit special consideration reasons.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SpecialConsiderationReasonsViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Submission successful."
          },
          "400": {
            "description": "Validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IpCompletionViewModel": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "industryPlacementStatus": {
            "$ref": "#/components/schemas/IndustryPlacementStatus"
          }
        }
      },
      "SpecialConsiderationHoursViewModel": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "hours": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,2}$"
          }
        }
      },
      "SpecialConsiderationReasonsViewModel": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "reasonsList": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReasonItem"
            }
          }
        }
      },
      "ReasonItem": {
        "type": "object",
        "properties": {
          "isSelected": {
            "type": "boolean"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "errorMessage": {
            "type": "string"
          },
          "fieldName": {
            "type": "string"
          }
        }
      },
      "IndustryPlacementStatus": {
        "type": "string",
        "enum": [
          "Completed",
          "CompletedWithSpecialConsideration",
          "NotCompleted",
          "WillNotComplete"
        ]
      }
    }
  }
}
