{
  "openapi": "3.1.0",
  "info": {
    "title": "IndustryPlacement API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/IndustryPlacement/ProcessBulkIndustryPlacements": {
      "post": {
        "summary": "Processes bulk industry placement details.",
        "operationId": "ProcessBulkIndustryPlacementsAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkProcessRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bulk processing operation completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkIndustryPlacementResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/IndustryPlacement/GetIpLookupData/{ipLookupType}/{pathwayId}": {
      "get": {
        "summary": "Retrieves industry placement lookup data.",
        "operationId": "GetIpLookupDataAsync",
        "parameters": [
          {
            "name": "ipLookupType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IpLookupType"
            }
          },
          {
            "name": "pathwayId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved lookup data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IpLookupData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/IndustryPlacement/ProcessIndustryPlacementDetails": {
      "post": {
        "summary": "Processes specific industry placement details.",
        "operationId": "ProcessIndustryPlacementDetailsAsync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IndustryPlacementRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkProcessRequest": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "BlobFileName": {
            "type": "string"
          },
          "BlobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "FileType": {
            "$ref": "#/components/schemas/FileType"
          },
          "DocumentType": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "LoginUserType": {
            "$ref": "#/components/schemas/LoginUserType"
          },
          "PerformedBy": {
            "type": "string"
          }
        },
        "required": [
          "AoUkprn",
          "BlobFileName",
          "BlobUniqueReference",
          "FileType",
          "DocumentType",
          "LoginUserType",
          "PerformedBy"
        ]
      },
      "BulkIndustryPlacementResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/BulkProcessResponse"
          }
        ]
      },
      "BulkProcessResponse": {
        "type": "object",
        "properties": {
          "IsSuccess": {
            "type": "boolean"
          },
          "BlobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "ErrorFileSize": {
            "type": "number",
            "format": "double"
          },
          "Stats": {
            "$ref": "#/components/schemas/BulkUploadStats"
          }
        }
      },
      "BulkUploadStats": {
        "type": "object",
        "properties": {
          "TotalRecordsCount": {
            "type": "integer",
            "format": "int32"
          },
          "NewRecordsCount": {
            "type": "integer",
            "format": "int32"
          },
          "AmendedRecordsCount": {
            "type": "integer",
            "format": "int32"
          },
          "UnchangedRecordsCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IpLookupData": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ShowOption": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "IndustryPlacementRequest": {
        "type": "object",
        "properties": {
          "ProviderUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "ProfileId": {
            "type": "integer",
            "format": "int32"
          },
          "RegistrationPathwayId": {
            "type": "integer",
            "format": "int32"
          },
          "PathwayId": {
            "type": "integer",
            "format": "int32"
          },
          "IndustryPlacementStatus": {
            "$ref": "#/components/schemas/IndustryPlacementStatus"
          },
          "IndustryPlacementDetails": {
            "$ref": "#/components/schemas/IndustryPlacementDetails"
          },
          "PerformedBy": {
            "type": "string"
          }
        },
        "required": [
          "ProviderUkprn",
          "ProfileId",
          "RegistrationPathwayId",
          "PathwayId",
          "IndustryPlacementStatus",
          "PerformedBy"
        ]
      },
      "FileType": {
        "type": "string",
        "enum": [
          "Csv",
          "Xlsx",
          "Pdf"
        ]
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "Registrations",
          "Assessments",
          "Results",
          "Documents",
          "Ucas",
          "DataExports",
          "OverallResults",
          "IndustryPlacements",
          "AnalystOverallResults",
          "AnalystCoreResults",
          "CoreRomm",
          "SpecialismRomm",
          "ProviderAddressess",
          "CertificateTracking",
          "Withdrawals",
          "ResultSlips",
          "Romms",
          "Aspose"
        ]
      },
      "LoginUserType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "AwardingOrganisation",
          "TrainingProvider",
          "Admin"
        ]
      },
      "IndustryPlacementStatus": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Completed",
          "CompletedWithSpecialConsideration",
          "NotCompleted",
          "WillNotComplete"
        ]
      },
      "IndustryPlacementDetails": {
        "type": "object",
        "properties": {
          "IndustryPlacementStatus": {
            "type": "string"
          },
          "HoursSpentOnPlacement": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "SpecialConsiderationReasons": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          }
        }
      },
      "IpLookupType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "SpecialConsideration",
          "IndustryPlacementModel",
          "TemporaryFlexibility"
        ]
      }
    }
  }
}
