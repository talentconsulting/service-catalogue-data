{
  "openapi": "3.1.0",
  "info": {
    "title": "Post Results Service API",
    "version": "1.0.0"
  },
  "paths": {
    "/post-results-reviews-appeals-and-grade-changes": {
      "get": {
        "operationId": "StartReviewsAndAppealsAsync",
        "responses": {
          "200": {
            "description": "Returns the start reviews and appeals page"
          }
        }
      }
    },
    "/results-reviews-appeals-and-grade-changes": {
      "get": {
        "operationId": "ResultReviewsAndAppealsAsync",
        "responses": {
          "200": {
            "description": "Returns the result reviews and appeals page"
          }
        }
      }
    },
    "/post-results-learner-withdrawn/{profileId}": {
      "get": {
        "operationId": "PrsUlnWithdrawnAsync",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the withdrawn learner page"
          },
          "302": {
            "description": "Redirects to the PageNotFound route if learner details are not found"
          }
        }
      }
    },
    "/post-results-no-results/{profileId}": {
      "get": {
        "operationId": "PrsNoResultsAsync",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the No Results page"
          },
          "302": {
            "description": "Redirects to the PageNotFound route if learner details are not found"
          }
        }
      }
    },
    "/post-results-learners-grades/{profileId}": {
      "get": {
        "operationId": "PrsLearnerDetailsAsync",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the learner grades page"
          },
          "302": {
            "description": "Redirects to the PageNotFound route if learner details are not found"
          }
        }
      }
    },
    "/post-results-add-romm/{profileId}/{assessmentId}/{componentType}/{isBack}": {
      "get": {
        "operationId": "GetPrsAddRomm",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "componentType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ComponentType"
            }
          },
          {
            "name": "isBack",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the Add ROMM page"
          },
          "302": {
            "description": "Redirects to the PageNotFound route if learner details are invalid"
          }
        }
      },
      "post": {
        "operationId": "SubmitPrsAddRomm",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrsAddRommViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on ROMM request outcome"
          }
        }
      }
    },
    "/post-results-add-romm-outcome/{profileId}/{assessmentId}/{componentType}/{outcomeTypeId}": {
      "get": {
        "operationId": "PrsAddRommOutcomeAsync",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "componentType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ComponentType"
            }
          },
          {
            "name": "outcomeTypeId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the Add ROMM Outcome page"
          },
          "302": {
            "description": "Redirects if learner details are invalid"
          }
        }
      },
      "post": {
        "operationId": "SubmitPrsAddRommOutcome",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PrsAddRommOutcomeViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Records the ROMM outcome"
          },
          "302": {
            "description": "Redirects if learner details are invalid"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ComponentType": {
        "type": "string",
        "enum": [
          "Core",
          "Specialism"
        ]
      },
      "PrsAddRommViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "AssessmentId": {
            "type": "integer"
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "IsRommRequested": {
            "type": "boolean"
          }
        },
        "required": [
          "ProfileId",
          "AssessmentId"
        ]
      },
      "PrsAddRommOutcomeViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "AssessmentId": {
            "type": "integer"
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "RommOutcome": {
            "type": "string"
          }
        },
        "required": [
          "ProfileId",
          "AssessmentId"
        ]
      }
    }
  }
}
