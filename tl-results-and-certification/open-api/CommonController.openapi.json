{
  "openapi": "3.1.0",
  "info": {
    "title": "Common API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Common/GetLookupData/{lookupCategory}": {
      "get": {
        "summary": "Retrieve lookup data by category",
        "parameters": [
          {
            "name": "lookupCategory",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/LookupCategory"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LookupData"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Common/GetLoggedInUserTypeInfo/{ukprn}": {
      "get": {
        "summary": "Get logged-in user's type info based on UKPRN",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoggedInUserTypeInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/Common/CurrentAcademicYears": {
      "get": {
        "summary": "Get current academic years",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AcademicYear"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Common/AcademicYears": {
      "get": {
        "summary": "Get all academic years",
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AcademicYear"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LookupCategory": {
        "type": "string",
        "enum": [
          "PathwayComponentGrade",
          "QualificationSubject",
          "SpecialismComponentGrade",
          "OverallResult"
        ],
        "description": "The category of the lookup."
      },
      "LookupData": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The unique identifier of the lookup data."
          },
          "Code": {
            "type": "string",
            "description": "The code of the lookup data."
          },
          "Value": {
            "type": "string",
            "description": "The value of the lookup data."
          }
        }
      },
      "LoggedInUserTypeInfo": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64",
            "description": "The UKPRN of the current user."
          },
          "Name": {
            "type": "string",
            "description": "The name of the user."
          },
          "UserType": {
            "type": "string",
            "enum": [
              "NotSpecified",
              "AwardingOrganisation",
              "TrainingProvider",
              "Admin"
            ],
            "description": "The type of the logged-in user."
          }
        }
      },
      "AcademicYear": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer",
            "description": "The identifier of the academic year."
          },
          "Name": {
            "type": "string",
            "description": "The name of the academic year."
          },
          "Year": {
            "type": "integer",
            "description": "The year of the academic period."
          }
        }
      }
    }
  }
}
