{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessment Series API",
    "description": "API for managing assessment series",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AssessmentSeries/GetResultCalculationAssessment": {
      "get": {
        "operationId": "GetResultCalculationAssessmentAsync",
        "summary": "Retrieve result calculation assessment details",
        "responses": {
          "200": {
            "description": "Successful response with assessment series details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentSeriesDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssessmentSeriesDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "appealEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "resultPublishDate": {
            "type": "string",
            "format": "date-time"
          },
          "resultCalculationYear": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "id",
          "componentType",
          "name",
          "description",
          "year",
          "startDate",
          "endDate",
          "appealEndDate",
          "resultPublishDate",
          "resultCalculationYear"
        ]
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      }
    }
  }
}
