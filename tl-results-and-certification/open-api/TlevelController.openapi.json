{
  "openapi": "3.1.0",
  "info": {
    "title": "TlevelController API",
    "version": "1.0.0"
  },
  "paths": {
    "/tlevels": {
      "get": {
        "operationId": "getTlevelsDashboard",
        "description": "T Levels dashboard page.",
        "responses": {
          "200": {
            "description": "Successful response showing the T Levels dashboard."
          }
        }
      }
    },
    "/review-tlevels": {
      "get": {
        "operationId": "reviewTlevels",
        "description": "Redirects based on the number of T Levels pending review.",
        "responses": {
          "302": {
            "description": "Redirect response."
          }
        }
      }
    },
    "/all-tlevels-reviewed": {
      "get": {
        "operationId": "getAllTlevelsReviewed",
        "description": "Displays page indicating all T Levels are reviewed or redirects if there are pending ones.",
        "responses": {
          "200": {
            "description": "Successful response showing the 'all T Levels reviewed' page."
          },
          "302": {
            "description": "Redirect response."
          }
        }
      }
    },
    "/select-tlevel/{id}": {
      "get": {
        "operationId": "selectTlevelToReview",
        "description": "Selects a T Level for review based on its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response showing the select T Level to review page."
          },
          "302": {
            "description": "Redirect response."
          }
        }
      }
    },
    "/select-tlevel": {
      "post": {
        "operationId": "submitSelectTlevelToReview",
        "description": "Submits the selected T Level to review and redirects to its details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectToReviewPageViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect response to review T Level details."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/review-t-level-details/{id}/{isback}": {
      "get": {
        "operationId": "verifyTLevel",
        "description": "Displays the verification page for a T Level.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "isback",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response shows T Level verification page."
          },
          "404": {
            "description": "T Level not found or invalid status."
          }
        }
      }
    },
    "/tlevel-details-queried-confirmation/{id}": {
      "get": {
        "operationId": "getTLevelQueriedConfirmation",
        "description": "Displays the confirmation page for a queried T Level.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response shows confirmation page for queried T Level."
          },
          "404": {
            "description": "Invalid confirmation request or T Level not found."
          }
        }
      }
    },
    "/confirm-tlevel": {
      "post": {
        "operationId": "confirmTLevel",
        "description": "Confirms the review of a T Level.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmTlevelViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects based on the confirmation outcome."
          },
          "404": {
            "description": "Invalid T Level confirmation request."
          }
        }
      }
    },
    "/query-t-level/{id}/{isBackToConfirmed}": {
      "post": {
        "operationId": "submitTLevelIssue",
        "description": "Submits a query about a T Level's details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TlevelQueryViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect response after submitting T Level issue."
          },
          "400": {
            "description": "Invalid request body."
          }
        }
      }
    },
    "/tlevel-query-sent": {
      "get": {
        "operationId": "getTLevelQuerySent",
        "description": "Displays a confirmation page after a T Level query is submitted.",
        "responses": {
          "200": {
            "description": "Successful response shows T Level query sent confirmation page."
          },
          "404": {
            "description": "Confirmation data not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectToReviewPageViewModel": {
        "type": "object",
        "properties": {
          "TlevelsToReview": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          },
          "SelectedPathwayId": {
            "type": "integer"
          }
        }
      },
      "ConfirmTlevelViewModel": {
        "type": "object",
        "properties": {
          "TqAwardingOrganisationId": {
            "type": "integer"
          },
          "RouteId": {
            "type": "integer"
          },
          "PathwayId": {
            "type": "integer"
          },
          "PathwayStatusId": {
            "type": "integer"
          },
          "TlevelTitle": {
            "type": "string"
          },
          "PathwayDisplayName": {
            "type": "string"
          },
          "IsEverythingCorrect": {
            "type": "boolean"
          },
          "Specialisms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "HasMoreToReview": {
            "type": "boolean"
          }
        }
      },
      "TlevelQueryViewModel": {
        "type": "object",
        "properties": {
          "TqAwardingOrganisationId": {
            "type": "integer"
          },
          "RouteId": {
            "type": "integer"
          },
          "PathwayId": {
            "type": "integer"
          },
          "PathwayStatusId": {
            "type": "integer"
          },
          "IsBackToConfirmed": {
            "type": "boolean"
          },
          "Query": {
            "type": "string"
          }
        }
      }
    }
  }
}
