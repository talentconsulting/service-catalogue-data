{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Address API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/ProviderAddress/AddAddress": {
      "post": {
        "summary": "Add a new address for a provider",
        "operationId": "AddAddress",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAddressRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Address added successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/ProviderAddress/GetAddress/{providerUkprn}": {
      "get": {
        "summary": "Get the address details for a provider",
        "operationId": "GetAddress",
        "parameters": [
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique identifier for the provider"
          }
        ],
        "responses": {
          "200": {
            "description": "Address details retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Address"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddAddressRequest": {
        "type": "object",
        "properties": {
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "DepartmentName": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string"
          },
          "AddressLine1": {
            "type": "string"
          },
          "AddressLine2": {
            "type": "string"
          },
          "Town": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          },
          "PerformedBy": {
            "type": "string"
          }
        },
        "required": [
          "Ukprn",
          "DepartmentName",
          "OrganisationName",
          "AddressLine1",
          "Town",
          "Postcode",
          "PerformedBy"
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "AddressId": {
            "type": "integer",
            "format": "int32"
          },
          "DepartmentName": {
            "type": "string"
          },
          "OrganisationName": {
            "type": "string"
          },
          "AddressLine1": {
            "type": "string"
          },
          "AddressLine2": {
            "type": "string"
          },
          "Town": {
            "type": "string"
          },
          "Postcode": {
            "type": "string"
          }
        },
        "required": [
          "AddressId",
          "DepartmentName",
          "OrganisationName",
          "AddressLine1",
          "Town",
          "Postcode"
        ]
      }
    }
  }
}
