{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Registrations API",
    "version": "1.0.0"
  },
  "paths": {
    "/download-registrations-data": {
      "get": {
        "summary": "Get available start years for registrations data.",
        "operationId": "DownloadRegistrationsDataAsync",
        "responses": {
          "200": {
            "description": "Successful retrieval of available start years.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "AvailableStartYearViewModels": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "description": "Component representing available start year data."
                      }
                    }
                  }
                }
              }
            }
          },
          "302": {
            "description": "Redirection to another URL when there is an issue.",
            "content": {}
          }
        }
      }
    },
    "/download-registrations-data-for": {
      "get": {
        "summary": "Download registrations data for a specific start year.",
        "operationId": "DownloadRegistrationsDataForAsync",
        "parameters": [
          {
            "name": "startYear",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 2023
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of registrations data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "DownloadRegistrationsDataForViewModel": {
                      "type": "object",
                      "description": "Component representing data for the specific start year."
                    }
                  }
                }
              }
            }
          },
          "302": {
            "description": "Redirection to another URL if requested data is unavailable or has issues.",
            "content": {}
          }
        }
      }
    },
    "/download-registrations-data-for/{id}": {
      "get": {
        "summary": "Download link for exported registrations data.",
        "operationId": "DownloadRegistrationsDataForLinkAsync",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful download of exported data.",
            "content": {}
          },
          "302": {
            "description": "Redirection to an error page for invalid or unavailable data.",
            "content": {}
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
