{
  "openapi": "3.1.0",
  "info": {
    "title": "Statement of Achievement API",
    "version": "1.0.0",
    "description": "API for managing Statement of Achievement requests and related functionality."
  },
  "paths": {
    "/SoA-unavailable": {
      "get": {
        "summary": "Statements of Achievement Not Available",
        "operationId": "getStatementsOfAchievementNotAvailable",
        "responses": {
          "200": {
            "description": "Returns a view indicating Statements of Achievement are not available.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotAvailableViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/postal-address-missing": {
      "get": {
        "summary": "Postal Address Missing",
        "operationId": "getPostalAddressMissing",
        "responses": {
          "200": {
            "description": "Returns a view for a missing postal address.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostalAddressMissingViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-unique-learner-number": {
      "get": {
        "summary": "Request Statement of Achievement by ULN",
        "operationId": "getRequestSoaUniqueLearnerNumber",
        "responses": {
          "200": {
            "description": "Returns a view to request a statement of achievement by ULN.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSoaUniqueLearnerNumberViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit Statement of Achievement Request by ULN",
        "operationId": "postRequestSoaUniqueLearnerNumber",
        "requestBody": {
          "description": "Data for the request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestSoaUniqueLearnerNumberViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Process the ULN and determine the request's eligibility.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-ULN-not-registered": {
      "get": {
        "summary": "ULN Not Registered",
        "operationId": "getRequestSoaUlnNotFound",
        "responses": {
          "200": {
            "description": "Returns a view indicating the ULN is not registered.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSoaUlnNotFoundViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-ULN-not-withdrawn": {
      "get": {
        "summary": "ULN Not Withdrawn",
        "operationId": "getRequestSoaUlnNotWithdrawn",
        "responses": {
          "200": {
            "description": "Returns a view indicating the ULN has not been withdrawn.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSoaUlnNotWithdrawnViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-not-available-no-ip-status": {
      "get": {
        "summary": "Statement of Achievement Not Available Due to Missing Industry Placement Status",
        "operationId": "getRequestSoaNotAvailableNoIpStatus",
        "responses": {
          "200": {
            "description": "Returns a view indicating missing industry placement status.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSoaNotAvailableNoIpStatusViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-not-available-no-results": {
      "get": {
        "summary": "Statement of Achievement Not Available Due to Missing Results",
        "operationId": "getRequestSoaNotAvailableNoResults",
        "responses": {
          "200": {
            "description": "Returns a view indicating missing results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestSoaNotAvailableNoResultsViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-check-and-submit/{profileId}": {
      "get": {
        "summary": "Check and Submit Statement of Achievement Request",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "operationId": "getRequestSoaCheckAndSubmit",
        "responses": {
          "200": {
            "description": "Returns the Check and Submit view.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoaLearnerRecordDetailsViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/request-statement-of-achievement-already-requested/{profileId}/{pathwayId}": {
      "get": {
        "summary": "Statement of Achievement Already Requested",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pathwayId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "operationId": "getRequestSoaAlreadySubmitted",
        "responses": {
          "200": {
            "description": "Returns a view indicating the SoA has already been requested.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotAvailableViewModel": {
        "type": "object",
        "properties": {
          "SoaAvailableDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PostalAddressMissingViewModel": {
        "type": "object"
      },
      "RequestSoaUniqueLearnerNumberViewModel": {
        "type": "object",
        "properties": {
          "SearchUln": {
            "type": "string",
            "description": "Unique Learner Number, must be 10 digits."
          }
        }
      },
      "RequestSoaUlnNotFoundViewModel": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          }
        }
      },
      "RequestSoaUlnNotWithdrawnViewModel": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          }
        }
      },
      "RequestSoaNotAvailableNoIpStatusViewModel": {
        "type": "object"
      },
      "RequestSoaNotAvailableNoResultsViewModel": {
        "type": "object"
      },
      "SoaLearnerRecordDetailsViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "Uln": {
            "type": "string"
          },
          "LearnerName": {
            "type": "string"
          },
          "DateofBirth": {
            "type": "string",
            "format": "date"
          },
          "ProviderDisplayName": {
            "type": "string"
          },
          "RegistrationPathwayId": {
            "type": "integer"
          },
          "PathwayDisplayName": {
            "type": "string"
          },
          "PathwayGrade": {
            "type": "string"
          }
        }
      }
    }
  }
}
