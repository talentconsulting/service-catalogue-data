{
  "openapi": "3.1.0",
  "info": {
    "title": "Search Registration API",
    "version": "1.0.0"
  },
  "paths": {
    "/search-learner-clear": {
      "get": {
        "summary": "Clear learner search data and redirect to the search registration endpoint.",
        "operationId": "SearchRegistrationClearAsync",
        "tags": [
          "SearchRegistration"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SearchRegistrationType"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to search registration endpoint."
          }
        }
      }
    },
    "/search-learner": {
      "get": {
        "summary": "Search for learners by search registration type.",
        "operationId": "SearchRegistrationAsync",
        "tags": [
          "SearchRegistration"
        ],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SearchRegistrationType"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learners will be returned within the view model."
          }
        }
      }
    },
    "/search-learner-search-key": {
      "post": {
        "summary": "Set learner search key and update cache.",
        "operationId": "SearchRegistrationSearchKeyAsync",
        "tags": [
          "SearchRegistration"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRegistrationCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to search registration endpoint."
          }
        }
      }
    },
    "/search-learner-clear-key": {
      "post": {
        "summary": "Clear search key and update cache.",
        "operationId": "SearchRegistrationClearKeyAsync",
        "tags": [
          "SearchRegistration"
        ],
        "responses": {
          "302": {
            "description": "Redirects to search registration endpoint."
          }
        }
      }
    },
    "/search-learner-filters": {
      "post": {
        "summary": "Set search filters and update the cache.",
        "operationId": "SearchRegistrationFiltersAsync",
        "tags": [
          "SearchRegistration"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRegistrationFiltersViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to search registration endpoint."
          }
        }
      }
    },
    "/search-learner-clear-filters": {
      "post": {
        "summary": "Clear search filters and update the cache.",
        "operationId": "SearchRegistrationClearFiltersAsync",
        "tags": [
          "SearchRegistration"
        ],
        "responses": {
          "302": {
            "description": "Redirects to search registration endpoint."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchRegistrationType": {
        "type": "integer",
        "description": "The type of search registration.",
        "enum": [
          1,
          2,
          3,
          4
        ],
        "example": 1
      },
      "SearchRegistrationCriteriaViewModel": {
        "type": "object",
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/SearchRegistrationFiltersViewModel"
          },
          "searchKey": {
            "type": "string",
            "example": "1234567890"
          },
          "pageNumber": {
            "type": "integer",
            "nullable": true,
            "example": 1
          }
        }
      },
      "SearchRegistrationFiltersViewModel": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string",
            "example": "Provider Name"
          },
          "selectedProviderId": {
            "type": "integer",
            "nullable": true,
            "example": 100
          },
          "academicYears": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "isSelected": {
                  "type": "boolean"
                }
              },
              "example": {
                "id": 1,
                "isSelected": true
              }
            }
          }
        }
      }
    }
  }
}
