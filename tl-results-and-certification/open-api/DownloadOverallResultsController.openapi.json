{
  "openapi": "3.1.0",
  "info": {
    "title": "Download Overall Results API",
    "version": "1.0.0"
  },
  "paths": {
    "/download-tlevel-results": {
      "get": {
        "summary": "Download Overall Results Page",
        "operationId": "DownloadOverallResults",
        "responses": {
          "200": {
            "description": "Returns the HTML content for the overall results page."
          }
        }
      }
    },
    "/download-tlevel-results-file": {
      "get": {
        "summary": "Download Overall Results File",
        "operationId": "DownloadOverallResultsFileAsync",
        "responses": {
          "200": {
            "description": "Returns the overall results CSV file.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found."
          }
        }
      }
    },
    "/download-tlevel-result-slips-file": {
      "get": {
        "summary": "Download Overall Result Slips File",
        "operationId": "DownloadOverallResultSlipsFileAsync",
        "responses": {
          "200": {
            "description": "Returns the result slips PDF file.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found."
          }
        }
      }
    },
    "/download-learner-tlevel-result-slips-file/{profileId}": {
      "get": {
        "summary": "Download Learner Overall Result Slips File",
        "operationId": "DownloadLearnerOverallResultSlipsFileAsync",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the learner result slips PDF file.",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "File not found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
