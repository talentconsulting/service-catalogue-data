    "/api/DataExport/DownloadLearnerOverallResultSlipsData/{providerUkprn}/{profileId}/{requestedBy}": {
      "get": {
        "summary": "Download Learner Overall Result Slips Data",
        "parameters": [
          {
            "name": "providerUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
