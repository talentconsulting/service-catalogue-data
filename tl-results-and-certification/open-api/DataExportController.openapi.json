{
  "openapi": "3.1.0",
  "info": {
    "title": "Data Export API",
    "version": "1.0.0",
    "description": "API for exporting data related to results and certifications."
  },
  "paths": {
    "/api/DataExport/GetDataExport/{aoUkprn}/{requestType}/{requestedBy}": {
      "get": {
        "summary": "Get Data Export",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "requestType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/DataExportType"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DataExportResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/DataExport/DownloadOverallResultsData/{providerUkprn}/{requestedBy}": {
