    "/api/DataExport/DownloadRommExport/{aoUkprn}/{requestedBy}": {
      "get": {
        "summary": "Download ROMM Export Data",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "requestedBy",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DataExportResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DataExportResponse": {
        "type": "object",
        "properties": {
          "IsDataFound": {
            "type": "boolean"
          },
          "BlobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "FileSize": {
            "type": "number"
          },
          "ComponentType": {
            "$ref": "#/components/schemas/ComponentType"
          }
        }
      },
      "DataExportType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Registrations",
          "Assessments",
          "Results",
          "PendingWithdrawals",
          "ProviderRegistrations",
          "Romms"
        ]
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      }
    }
  }
}
