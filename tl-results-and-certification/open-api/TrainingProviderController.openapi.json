{
  "openapi": "3.1.0",
  "info": {
    "title": "Training Provider API",
    "version": "1.0.0",
    "description": "API for managing training provider operations including learner records, replacement documents, withdrawal processes, and provider guidance."
  },
  "paths": {
    "/manage-learners/{academicYear}/{pageNumber}": {
      "get": {
        "summary": "Search Learner Details",
        "parameters": [
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "nullable": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner details fetched successfully"
          },
          "404": {
            "description": "Page not found"
          }
        }
      },
      "post": {
        "summary": "Submit Search Learner Details",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to search learner details"
          }
        }
      }
    },
    "/manage-learners-clearsearchkey/{academicYear}": {
      "get": {
        "summary": "Clear Search Key",
        "parameters": [
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to search learner details"
          }
        }
      }
    },
    "/manage-learners-applyfilters": {
      "post": {
        "summary": "Apply Filters for Learner Search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to search learner details"
          }
        }
      }
    },
    "/manage-learners-clearfilters/{academicYear}": {
      "get": {
        "summary": "Clear Learner Filters",
        "parameters": [
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to search learner details"
          }
        }
      }
    },
    "/request-replacement-document/{profileId}": {
      "get": {
        "summary": "Request Replacement Document",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Replacement document request details fetched successfully"
          },
          "404": {
            "description": "Page not found"
          }
        }
      },
      "post": {
        "summary": "Submit Replacement Document Request",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestReplacementDocumentViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to learner record details"
          },
          "500": {
            "description": "Problem with service"
          }
        }
      }
    },
    "/manage-learners-add-withdrawn-status/{profileId}": {
      "get": {
        "summary": "Add Withdrawn Status to Learner",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Withdrawn status details fetched successfully"
          },
          "404": {
            "description": "Page not found"
          }
        }
      },
      "post": {
        "summary": "Submit Withdrawn Status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddWithdrawnStatusViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to appropriate action based on response"
          }
        }
      }
    },
    "/restore-learner-ao/{profileId}": {
      "get": {
        "summary": "Reinstate Learner From Withdrawn Status",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner reinstatement details fetched successfully"
          },
          "404": {
            "description": "Page not found"
          }
        }
      },
      "post": {
        "summary": "Submit Change Back to Active Status",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeBackToActiveStatusViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to appropriate action based on response"
          }
        }
      }
    },
    "/search-learner-records": {
      "get": {
        "summary": "Search Learner Records",
        "responses": {
          "200": {
            "description": "Search learner records initialized successfully"
          }
        }
      },
      "post": {
        "summary": "Submit Search Learner Records",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnerRecordViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to learner record details or not found"
          }
        }
      }
    },
    "/provider-guidance": {
      "get": {
        "summary": "Provider Guidance",
        "responses": {
          "200": {
            "description": "Provider guidance page rendered successfully"
          }
        }
      }
    },
    "/provider-timeline": {
      "get": {
        "summary": "Provider Timeline",
        "responses": {
          "200": {
            "description": "Provider timeline page rendered successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchCriteriaViewModel": {
        "type": "object",
        "properties": {
          "SearchLearnerFilters": {
            "type": "object"
          },
          "SearchKey": {
            "type": "string"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "PageNumber": {
            "type": "integer",
            "nullable": true
          },
          "IsSearchKeyApplied": {
            "type": "boolean"
          }
        }
      },
      "RequestReplacementDocumentViewModel": {
        "type": "object",
        "properties": {
          "ProfileId": {
            "type": "integer"
          },
          "Uln": {
            "type": "integer"
          },
          "LearnerName": {
            "type": "string"
          }
        }
      },
      "AddWithdrawnStatusViewModel": {
        "type": "object",
        "properties": {
          "IsPendingWithdrawl": {
            "type": "boolean",
            "nullable": true
          },
          "ProfileId": {
            "type": "integer"
          },
          "LearnerName": {
            "type": "string"
          }
        }
      },
      "ChangeBackToActiveStatusViewModel": {
        "type": "object",
        "properties": {
          "ChangeBackToActive": {
            "type": "boolean",
            "nullable": true
          },
          "ProfileId": {
            "type": "integer"
          },
          "LearnerName": {
            "type": "string"
          }
        }
      },
      "SearchLearnerRecordViewModel": {
        "type": "object",
        "properties": {
          "SearchUln": {
            "type": "integer"
          },
          "IsLearnerRegistered": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
