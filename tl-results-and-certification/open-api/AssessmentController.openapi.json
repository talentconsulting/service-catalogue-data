{
  "openapi": "3.1.0",
  "info": {
    "title": "Assessment API",
    "version": "1.0.0",
    "description": "API for managing assessment-related operations."
  },
  "paths": {
    "/api/Assessment/ProcessBulkAssessments": {
      "post": {
        "operationId": "processBulkAssessments",
        "summary": "Processes bulk assessment requests.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BulkProcessRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The bulk assessment process result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BulkAssessmentResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetAvailableAssessmentSeries/{aoUkprn}/{profileId}/{componentType}/{componentIds}": {
      "get": {
        "operationId": "getAvailableAssessmentSeries",
        "summary": "Retrieves available assessment series for a given profile and components.",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "componentType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ComponentType"
            }
          },
          {
            "name": "componentIds",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The available assessment series.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailableAssessmentSeries"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/AddAssessmentEntry": {
      "post": {
        "operationId": "addAssessmentEntry",
        "summary": "Adds an assessment entry for a profile.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddAssessmentEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The result of adding an assessment entry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddAssessmentEntryResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetActiveAssessmentEntryDetails/{aoUkprn}/{assessmentId}/{componentType}": {
      "get": {
        "operationId": "getActiveAssessmentEntryDetails",
        "summary": "Retrieves active assessment entry details for a given profile and component.",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "assessmentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "componentType",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ComponentType"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The active assessment entry details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentEntryDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetActiveSpecialismAssessmentEntries/{aoUkprn}/{specialismAssessmentIds}": {
      "get": {
        "operationId": "getActiveSpecialismAssessmentEntries",
        "summary": "Retrieves active specialism assessment entries for the given assessments.",
        "parameters": [
          {
            "name": "aoUkprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "specialismAssessmentIds",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The active specialism assessment entry details.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssessmentEntryDetails"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/RemoveAssessmentEntry": {
      "put": {
        "operationId": "removeAssessmentEntry",
        "summary": "Removes an assessment entry.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RemoveAssessmentEntryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The result of removing an assessment entry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "/api/Assessment/GetAssessmentSeries": {
      "get": {
        "operationId": "getAssessmentSeries",
        "summary": "Retrieves the list of assessment series.",
        "responses": {
          "200": {
            "description": "All available assessment series.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssessmentSeriesDetails"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BulkProcessRequest": {
        "type": "object",
        "properties": {
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "blobFileName": {
            "type": "string"
          },
          "blobUniqueReference": {
            "type": "string",
            "format": "uuid"
          },
          "fileType": {
            "$ref": "#/components/schemas/FileType"
          },
          "documentType": {
            "$ref": "#/components/schemas/DocumentType"
          },
          "loginUserType": {
            "$ref": "#/components/schemas/LoginUserType"
          },
          "performedBy": {
            "type": "string"
          }
        },
        "required": [
          "aoUkprn",
          "blobFileName",
          "blobUniqueReference",
          "fileType",
          "documentType",
          "loginUserType",
          "performedBy"
        ]
      },
      "BulkAssessmentResponse": {
        "type": "object"
      },
      "AvailableAssessmentSeries": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesName": {
            "type": "string"
          }
        },
        "required": [
          "profileId",
          "assessmentSeriesId",
          "assessmentSeriesName"
        ]
      },
      "AddAssessmentEntryRequest": {
        "type": "object",
        "properties": {
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesId": {
            "type": "integer",
            "format": "int32"
          },
          "specialismIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "performedBy": {
            "type": "string"
          }
        },
        "required": [
          "aoUkprn",
          "profileId",
          "assessmentSeriesId",
          "componentType",
          "performedBy"
        ]
      },
      "AddAssessmentEntryResponse": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "isSuccess": {
            "type": "boolean"
          }
        },
        "required": [
          "uln",
          "isSuccess"
        ]
      },
      "AssessmentEntryDetails": {
        "type": "object",
        "properties": {
          "profileId": {
            "type": "integer",
            "format": "int32"
          },
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "assessmentId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesId": {
            "type": "integer",
            "format": "int32"
          },
          "assessmentSeriesName": {
            "type": "string"
          }
        },
        "required": [
          "profileId",
          "uln",
          "assessmentId",
          "assessmentSeriesId",
          "assessmentSeriesName"
        ]
      },
      "RemoveAssessmentEntryRequest": {
        "type": "object",
        "properties": {
          "assessmentId": {
            "type": "integer",
            "format": "int32"
          },
          "aoUkprn": {
            "type": "integer",
            "format": "int64"
          },
          "specialismAssessmentIds": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "performedBy": {
            "type": "string"
          }
        },
        "required": [
          "assessmentId",
          "aoUkprn",
          "componentType",
          "performedBy"
        ]
      },
      "AssessmentSeriesDetails": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "componentType": {
            "$ref": "#/components/schemas/ComponentType"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "startDate": {
            "type": "string",
            "format": "date-time"
          },
          "endDate": {
            "type": "string",
            "format": "date-time"
          },
          "appealEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "resultPublishDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "componentType",
          "name",
          "startDate",
          "endDate",
          "appealEndDate",
          "resultPublishDate"
        ]
      },
      "ComponentType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "Core",
          "Specialism"
        ]
      },
      "FileType": {
        "type": "string",
        "enum": [
          "Csv",
          "Xlsx",
          "Pdf"
        ]
      },
      "DocumentType": {
        "type": "string",
        "enum": [
          "Registrations",
          "Assessments",
          "Results",
          "Documents",
          "Ucas",
          "DataExports",
          "OverallResults",
          "IndustryPlacements",
          "AnalystOverallResults",
          "AnalystCoreResults",
          "CoreRomm",
          "SpecialismRomm",
          "ProviderAddressess",
          "CertificateTracking",
          "Withdrawals",
          "ResultSlips",
          "Romms",
          "Aspose"
        ]
      },
      "LoginUserType": {
        "type": "string",
        "enum": [
          "NotSpecified",
          "AwardingOrganisation",
          "TrainingProvider",
          "Admin"
        ]
      }
    }
  }
}
