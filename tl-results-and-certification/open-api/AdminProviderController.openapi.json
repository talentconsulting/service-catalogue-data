{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminProvider API",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/find-provider-clear": {
      "get": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "AdminFindProviderClear",
        "summary": "Clears the provider search cache.",
        "responses": {
          "302": {
            "description": "Redirect to find provider page."
          }
        }
      }
    },
    "/admin/find-provider": {
      "get": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "GetAdminFindProvider",
        "summary": "Retrieve the current state of provider search.",
        "responses": {
          "200": {
            "description": "Returns the provider search view model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminFindProviderViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "PostAdminFindProvider",
        "summary": "Submit a search for a provider.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminFindProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on search result."
          }
        }
      }
    },
    "/admin/provider-details/{providerId}": {
      "get": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "GetAdminProviderDetails",
        "summary": "Retrieve the details of a provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns provider details view model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminProviderDetailsViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the error page if provider not found."
          }
        }
      }
    },
    "/admin/edit-provider/{providerId}": {
      "get": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "GetAdminEditProvider",
        "summary": "Retrieve the edit view for a provider.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the provider edit view model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminEditProviderViewModel"
                }
              }
            }
          },
          "302": {
            "description": "Redirect to the error page if provider not found."
          }
        }
      }
    },
    "/admin/edit-provider": {
      "post": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "PostAdminEditProvider",
        "summary": "Submit changes to provider details.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminEditProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the provider details page."
          }
        }
      }
    },
    "/admin/add-provider": {
      "get": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "GetAdminAddProvider",
        "summary": "Retrieve the add provider form.",
        "responses": {
          "200": {
            "description": "Returns the add provider view model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminAddProviderViewModel"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "AdminProvider"
        ],
        "operationId": "PostAdminAddProvider",
        "summary": "Submit a new provider to the system.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminAddProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to the newly added provider details page."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminFindProviderViewModel": {
        "type": "object",
        "properties": {
          "Search": {
            "type": "string",
            "description": "Search term for provider.",
            "maxLength": 400
          }
        }
      },
      "AdminProviderDetailsViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int32"
          },
          "Name": {
            "type": "string"
          },
          "UkPrn": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          },
          "IsActive": {
            "type": "boolean"
          }
        }
      },
      "AdminEditProviderViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int32"
          },
          "UkPrn": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "Name": {
            "type": "string",
            "maxLength": 256
          },
          "DisplayName": {
            "type": "string",
            "maxLength": 256
          },
          "IsActive": {
            "type": "boolean"
          }
        },
        "required": [
          "ProviderId",
          "UkPrn",
          "Name",
          "DisplayName"
        ]
      },
      "AdminAddProviderViewModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "string",
            "pattern": "^\\d{8}$"
          },
          "Name": {
            "type": "string",
            "maxLength": 256
          },
          "DisplayName": {
            "type": "string",
            "maxLength": 256
          }
        },
        "required": [
          "UkPrn",
          "Name",
          "DisplayName"
        ]
      }
    }
  }
}
