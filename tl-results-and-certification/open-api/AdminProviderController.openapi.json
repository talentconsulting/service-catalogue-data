{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminProvider API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/AdminProvider/GetProvider/{providerId}": {
      "get": {
        "summary": "Get Provider",
        "operationId": "getProvider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The unique ID of the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetProviderResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminProvider/UpdateProvider": {
      "put": {
        "summary": "Update Provider",
        "operationId": "updateProvider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProviderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with update results.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateProviderResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/AdminProvider/AddProvider": {
      "post": {
        "summary": "Add Provider",
        "operationId": "addProvider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddProviderRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with the added provider details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AddProviderResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddProviderRequest": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          },
          "CreatedBy": {
            "type": "string"
          }
        },
        "required": [
          "UkPrn",
          "Name",
          "DisplayName",
          "CreatedBy"
        ]
      },
      "AddProviderResponse": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int32"
          },
          "Success": {
            "type": "boolean"
          },
          "DuplicatedUkprnFound": {
            "type": "boolean"
          },
          "DuplicatedNameFound": {
            "type": "boolean"
          },
          "DuplicatedDisplayNameFound": {
            "type": "boolean"
          }
        },
        "required": [
          "ProviderId",
          "Success",
          "DuplicatedUkprnFound",
          "DuplicatedNameFound",
          "DuplicatedDisplayNameFound"
        ]
      },
      "GetProviderResponse": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int32"
          },
          "UkPrn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          },
          "IsActive": {
            "type": "boolean"
          }
        },
        "required": [
          "ProviderId",
          "UkPrn",
          "Name",
          "DisplayName",
          "IsActive"
        ]
      },
      "UpdateProviderRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer",
            "format": "int32"
          },
          "UkPrn": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "DisplayName": {
            "type": "string"
          },
          "IsActive": {
            "type": "boolean"
          },
          "ModifiedBy": {
            "type": "string"
          }
        },
        "required": [
          "ProviderId",
          "UkPrn",
          "Name",
          "DisplayName",
          "IsActive",
          "ModifiedBy"
        ]
      },
      "UpdateProviderResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean"
          },
          "DuplicatedUkprnFound": {
            "type": "boolean"
          },
          "DuplicatedNameFound": {
            "type": "boolean"
          },
          "DuplicatedDisplayNameFound": {
            "type": "boolean"
          }
        },
        "required": [
          "Success",
          "DuplicatedUkprnFound",
          "DuplicatedNameFound",
          "DuplicatedDisplayNameFound"
        ]
      }
    }
  }
}
