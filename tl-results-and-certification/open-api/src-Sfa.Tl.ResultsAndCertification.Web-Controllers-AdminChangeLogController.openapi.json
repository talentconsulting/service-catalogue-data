{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminChangeLog API",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/change-log-clear": {
      "get": {
        "summary": "Clear Admin Change Log Search",
        "operationId": "AdminSearchChangeLogClear",
        "responses": {
          "302": {
            "description": "Redirects to the Admin Change Log Search route."
          }
        }
      }
    },
    "/admin/change-log/{pageNumber}": {
      "get": {
        "summary": "Admin Change Log Search",
        "operationId": "AdminSearchChangeLog",
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the admin change log view model."
          }
        }
      }
    },
    "/admin/change-log-search-key": {
      "post": {
        "summary": "Submit Change Log Search Key",
        "operationId": "AdminSearchChangeLogSearchKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminSearchChangeLogCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the Admin Change Log Search route."
          }
        }
      }
    },
    "/admin/change-log-clear-key": {
      "post": {
        "summary": "Clear Change Log Search Key",
        "operationId": "AdminSearchChangeLogClearKey",
        "responses": {
          "302": {
            "description": "Redirects to the Admin Change Log Search route."
          }
        }
      }
    },
    "/admin/view-change-record/1/{changeLogId}": {
      "get": {
        "summary": "View Change Record Start Year",
        "operationId": "AdminViewChangeRecordStartYear",
        "parameters": [
          {
            "name": "changeLogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the change record for the start year."
          }
        }
      }
    },
    "/admin/view-change-record/2/{changeLogId}": {
      "get": {
        "summary": "View Change Record Industry Placement",
        "operationId": "AdminViewChangeRecordIP",
        "parameters": [
          {
            "name": "changeLogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the change record for industry placement."
          }
        }
      }
    },
    "/admin/view-change-record/{typeId}/{changeLogId}": {
      "get": {
        "summary": "View Change Record Details",
        "operationId": "AdminViewChangeRecordType",
        "parameters": [
          {
            "name": "typeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "changeLogId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the change record for the specified type."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminSearchChangeLogCriteriaViewModel": {
        "type": "object",
        "properties": {
          "SearchKey": {
            "type": "string"
          },
          "PageNumber": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "AdminChangeLog": {
        "type": "object",
        "properties": {
          "ChangeLogId": {
            "type": "integer"
          },
          "ChangeType": {
            "type": "integer"
          },
          "DateAndTimeOfChange": {
            "type": "string",
            "format": "date-time"
          },
          "ZendeskTicketID": {
            "type": "string"
          },
          "LearnerFirstname": {
            "type": "string"
          },
          "LearnerLastname": {
            "type": "string"
          },
          "Uln": {
            "type": "integer"
          },
          "ProviderName": {
            "type": "string"
          },
          "ProviderUkprn": {
            "type": "integer"
          },
          "LastUpdatedBy": {
            "type": "string"
          }
        }
      }
    }
  }
}
