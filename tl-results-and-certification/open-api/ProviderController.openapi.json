{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider API",
    "version": "1.0.0",
    "description": "API for managing provider and provider-related T Levels."
  },
  "paths": {
    "/your-providers": {
      "get": {
        "operationId": "getYourProviders",
        "summary": "Get list of providers",
        "description": "Retrieves the list of providers associated with the user.",
        "responses": {
          "200": {
            "description": "A list of providers is returned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProvidersViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/find-provider/{isback}": {
      "get": {
        "operationId": "getFindProvider",
        "summary": "Find provider page",
        "parameters": [
          {
            "name": "isback",
            "in": "path",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicate whether to prefill the search field."
          }
        ],
        "responses": {
          "200": {
            "description": "Find provider page information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindProviderViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/find-provider": {
      "post": {
        "operationId": "postFindProvider",
        "summary": "Submit search for provider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindProviderViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to appropriate page based on search results."
          }
        }
      }
    },
    "/select-providers-tlevels/{providerId}": {
      "get": {
        "operationId": "getSelectProviderTlevels",
        "summary": "Select provider's T Levels",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The unique identifier of the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieve T Level selection page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevelsViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/add-additional-tlevels/{providerId}": {
      "get": {
        "operationId": "getAddProviderTlevels",
        "summary": "Add additional T Levels for provider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The unique identifier of the provider."
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieve Add T Levels page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevelsViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/add-additional-tlevels": {
      "post": {
        "operationId": "postSubmitAddProviderTlevels",
        "summary": "Submit additional T Levels for provider",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderTlevelsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects after adding additional T Levels for provider."
          }
        }
      }
    },
    "/remove-tlevel/{id}/{navigation}": {
      "get": {
        "operationId": "getRemoveProviderTlevel",
        "summary": "Remove provider's T Level",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The unique identifier of the T Level to be removed."
          },
          {
            "name": "navigation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicator for navigation flow."
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieve Remove T Level page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevelDetailsViewModel"
                }
              }
            }
          }
        }
      }
    },
    "/remove-tlevel": {
      "post": {
        "operationId": "postSubmitRemoveProviderTlevel",
        "summary": "Submit request to remove T Level",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProviderTlevelDetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects after processing remove request."
          }
        }
      }
    },
    "/provider-tlevels/{providerId}/{navigation}": {
      "get": {
        "operationId": "getViewProviderTlevels",
        "summary": "View T Levels for a provider",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "The unique identifier of the provider."
          },
          {
            "name": "navigation",
            "in": "path",
            "required": true,
            "schema": {
              "type": "boolean"
            },
            "description": "Indicator for navigation flow."
          }
        ],
        "responses": {
          "200": {
            "description": "Retrieve provider's T Levels",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProviderTlevelsViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProvidersViewModel": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderViewModel"
            }
          }
        }
      },
      "ProviderViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer"
          }
        }
      },
      "FindProviderViewModel": {
        "type": "object",
        "properties": {
          "search": {
            "type": "string"
          },
          "showViewProvidersLink": {
            "type": "boolean"
          },
          "selectedProviderId": {
            "type": "integer"
          }
        }
      },
      "ProviderTlevelsViewModel": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "tlevels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderTlevelViewModel"
            }
          }
        }
      },
      "ProviderTlevelViewModel": {
        "type": "object",
        "properties": {
          "tqProviderId": {
            "type": "integer"
          },
          "tqAwardingOrganisationId": {
            "type": "integer"
          },
          "tlProviderId": {
            "type": "integer"
          },
          "tlevelTitle": {
            "type": "string"
          },
          "isSelected": {
            "type": "boolean"
          }
        }
      },
      "ProviderTlevelDetailsViewModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "displayName": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer"
          },
          "tlevelTitle": {
            "type": "string"
          },
          "tlProviderId": {
            "type": "integer"
          },
          "canRemoveTlevel": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
