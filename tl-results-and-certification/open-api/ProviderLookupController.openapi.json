{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Lookup API",
    "version": "1.0.0"
  },
  "paths": {
    "/search-provider/{name}": {
      "get": {
        "tags": [
          "Provider Lookup"
        ],
        "summary": "Retrieve provider lookup data by name",
        "description": "Search for providers by a partial or full name query.",
        "operationId": "GetProviderLookupData",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "description": "The name or partial name of the provider to be searched.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response containing provider lookup data.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProviderData"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request due to insufficient query length or missing name parameter."
          }
        },
        "security": [
          {
            "ProviderDashboardAccess": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ProviderData": {
        "type": "object",
        "properties": {
          "providerId": {
            "type": "integer",
            "description": "Unique identifier for the provider."
          },
          "name": {
            "type": "string",
            "description": "Name of the provider."
          },
          "location": {
            "type": "string",
            "description": "Location of the provider."
          }
        },
        "required": [
          "providerId",
          "name"
        ]
      }
    },
    "securitySchemes": {
      "ProviderDashboardAccess": {
        "type": "http",
        "scheme": "bearer",
        "description": "Provider dashboard requires authorization with a bearer token."
      }
    }
  }
}
