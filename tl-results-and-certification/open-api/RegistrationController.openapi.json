{
  "openapi": "3.1.0",
  "info": {
    "title": "Registration API",
    "version": "1.0.0"
  },
  "paths": {
    "/registrations": {
      "get": {
        "operationId": "getRegistrationDashboard",
        "summary": "Get the registration dashboard.",
        "tags": [
          "Registrations"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/upload-registrations-file/{requestErrorTypeId}": {
      "get": {
        "operationId": "getUploadRegistrationsFile",
        "summary": "Get the upload registrations file view.",
        "tags": [
          "Registrations"
        ],
        "parameters": [
          {
            "name": "requestErrorTypeId",
            "in": "path",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postUploadRegistrationsFile",
        "summary": "Submit the upload registrations file.",
        "tags": [
          "Registrations"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadRegistrationsRequestViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful upload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/upload-registrations-file-success": {
      "get": {
        "operationId": "getRegistrationsUploadSuccessful",
        "summary": "Get the successful registrations upload page.",
        "tags": [
          "Registrations"
        ],
        "responses": {
          "200": {
            "description": "Upload Successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/registrations-upload-unsuccessful": {
      "get": {
        "operationId": "getRegistrationsUploadUnsuccessful",
        "summary": "Get the unsuccessful registrations upload page.",
        "tags": [
          "Registrations"
        ],
        "responses": {
          "200": {
            "description": "Upload Unsuccessful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/problem-with-registrations-upload": {
      "get": {
        "operationId": "getProblemWithRegistrationsUpload",
        "summary": "Get the problem with registrations upload page.",
        "tags": [
          "Registrations"
        ],
        "responses": {
          "200": {
            "description": "Page rendered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/download-registration-errors": {
      "get": {
        "operationId": "getRegistrationErrorsFile",
        "summary": "Download registration error file.",
        "tags": [
          "Registrations"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Error file downloaded",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UploadRegistrationsRequestViewModel": {
        "type": "object",
        "properties": {
          "AoUkprn": {
            "type": "integer"
          },
          "File": {
            "type": "string",
            "format": "binary",
            "description": "CSV file required for upload"
          },
          "RequestErrorTypeId": {
            "type": "integer"
          }
        },
        "required": [
          "File"
        ]
      }
    }
  }
}
