{
  "openapi": "3.1.0",
  "info": {
    "title": "AdminNotification API",
    "version": "1.0.0"
  },
  "paths": {
    "/admin/find-notification-clear": {
      "get": {
        "summary": "Clear admin notification search filters and redirect",
        "operationId": "AdminFindNotificationClear",
        "tags": [
          "AdminNotification"
        ],
        "responses": {
          "302": {
            "description": "Redirect to /admin/find-notification",
            "headers": {
              "Location": {
                "description": "Redirection URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/admin/find-notification/{pageNumber}": {
      "get": {
        "summary": "View admin notification search results",
        "operationId": "AdminFindNotification",
        "tags": [
          "AdminNotification"
        ],
        "parameters": [
          {
            "name": "pageNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for paginated results"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification search results page"
          },
          "302": {
            "description": "Redirect to problem or another route based on conditions",
            "headers": {
              "Location": {
                "description": "Alternative route",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/admin/find-notification-apply-filters": {
      "post": {
        "summary": "Apply filters to admin notification search",
        "operationId": "AdminFindNotificationApplyFilters",
        "tags": [
          "AdminNotification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminFindNotificationCriteriaViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to /admin/find-notification with page number",
            "headers": {
              "Location": {
                "description": "Redirection URL with filters applied",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/admin/find-notification-clear-filters": {
      "post": {
        "summary": "Clear filters applied to admin notification search",
        "operationId": "AdminFindNotificationClearFilters",
        "tags": [
          "AdminNotification"
        ],
        "responses": {
          "302": {
            "description": "Redirect to /admin/find-notification with cleared filters",
            "headers": {
              "Location": {
                "description": "Redirection URL with cleared filters",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/admin/notification-details/{notificationId}": {
      "get": {
        "summary": "View admin notification details",
        "operationId": "AdminNotificationDetails",
        "tags": [
          "AdminNotification"
        ],
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique ID of the notification"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification details rendered"
          },
          "302": {
            "description": "Redirect to problem page if notification not found",
            "headers": {
              "Location": {
                "description": "Redirection URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/admin/edit-notification": {
      "get": {
        "summary": "Edit a specific admin notification",
        "operationId": "AdminEditNotificationGet",
        "tags": [
          "AdminNotification"
        ],
        "parameters": [
          {
            "name": "notificationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique ID of the notification to be edited"
          }
        ],
        "responses": {
          "200": {
            "description": "Admin notification edit page"
          },
          "302": {
            "description": "Redirect to problem page if notification not found",
            "headers": {
              "Location": {
                "description": "Redirection URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Submit changes to an admin notification",
        "operationId": "AdminEditNotificationPost",
        "tags": [
          "AdminNotification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminEditNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to notification details page or problem page",
            "headers": {
              "Location": {
                "description": "Redirection URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/admin/add-notification": {
      "get": {
        "summary": "Render form for adding a new admin notification",
        "operationId": "AdminAddNotificationGet",
        "tags": [
          "AdminNotification"
        ],
        "responses": {
          "200": {
            "description": "Notification creation form rendered"
          }
        }
      },
      "post": {
        "summary": "Submit a new admin notification",
        "operationId": "AdminAddNotificationPost",
        "tags": [
          "AdminNotification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminAddNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to notification details or problem page",
            "headers": {
              "Location": {
                "description": "Redirection URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    },
    "/admin/delete-notification/{notificationId}": {
      "get": {
        "summary": "Retrieve details for deleting an admin notification",
        "operationId": "AdminDeleteNotificationGet",
        "tags": [
          "AdminNotification"
        ],
        "parameters": [
          {
            "name": "notificationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Unique ID of the notification to be deleted"
          }
        ],
        "responses": {
          "200": {
            "description": "Notification deletion details rendered"
          },
          "302": {
            "description": "Redirect to problem page if notification not found",
            "headers": {
              "Location": {
                "description": "Redirection URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Delete an admin notification",
        "operationId": "AdminDeleteNotificationPost",
        "tags": [
          "AdminNotification"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdminDeleteNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to find notification or problem page",
            "headers": {
              "Location": {
                "description": "Redirection URL",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdminFindNotificationCriteriaViewModel": {
        "type": "object",
        "properties": {
          "ActiveFilters": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FilterLookupData"
            }
          },
          "PageNumber": {
            "type": "integer",
            "nullable": true
          }
        }
      },
      "FilterLookupData": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "integer"
          },
          "Name": {
            "type": "string"
          },
          "CoreCode": {
            "type": "string"
          },
          "IsSelected": {
            "type": "boolean"
          }
        }
      },
      "AdminEditNotificationViewModel": {
        "type": "object",
        "properties": {
          "NotificationId": {
            "type": "integer"
          },
          "Title": {
            "type": "string"
          },
          "Content": {
            "type": "string"
          },
          "Target": {
            "type": "string"
          },
          "StartDay": {
            "type": "string"
          },
          "StartMonth": {
            "type": "string"
          },
          "StartYear": {
            "type": "string"
          },
          "EndDay": {
            "type": "string"
          },
          "EndMonth": {
            "type": "string"
          },
          "EndYear": {
            "type": "string"
          }
        }
      },
      "AdminAddNotificationViewModel": {
        "type": "object",
        "properties": {
          "Title": {
            "type": "string"
          },
          "Content": {
            "type": "string"
          },
          "Target": {
            "type": "string"
          },
          "StartDay": {
            "type": "string"
          },
          "StartMonth": {
            "type": "string"
          },
          "StartYear": {
            "type": "string"
          },
          "EndDay": {
            "type": "string"
          },
          "EndMonth": {
            "type": "string"
          },
          "EndYear": {
            "type": "string"
          }
        }
      },
      "AdminDeleteNotificationViewModel": {
        "type": "object",
        "properties": {
          "NotificationId": {
            "type": "integer"
          }
        }
      }
    }
  }
}
