{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback Questions API",
    "version": "1.0.0"
  },
  "paths": {
    "/landing": {
      "get": {
        "operationId": "StartFeedbackGet",
        "summary": "Retrieve the start feedback page.",
        "parameters": [
          {
            "name": "EncodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "AccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feedback start page retrieved successfully.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/question-one": {
      "get": {
        "operationId": "QuestionOneGet",
        "summary": "Retrieve the first question page.",
        "parameters": [
          {
            "name": "EncodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "AccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ReturnToReviewAnswers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "First question page retrieved successfully.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "QuestionOnePost",
        "summary": "Submit answers for the first question page.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionOneStrengthsViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after successful answer submission."
          }
        }
      }
    },
    "/question-two": {
      "get": {
        "operationId": "QuestionTwoGet",
        "summary": "Retrieve the second question page.",
        "parameters": [
          {
            "name": "EncodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "AccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ReturnToReviewAnswers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Second question page retrieved successfully.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "QuestionTwoPost",
        "summary": "Submit answers for the second question page.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionTwoWeaknessesViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after successful answer submission."
          }
        }
      }
    },
    "/question-three": {
      "get": {
        "operationId": "QuestionThreeGet",
        "summary": "Retrieve the third question page.",
        "parameters": [
          {
            "name": "EncodedAccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "AccountId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "ReturnToReviewAnswers",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Third question page retrieved successfully.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "QuestionThreePost",
        "summary": "Submit answers for the third question page.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionThreeRatingViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect after successful answer submission."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccountModel": {
        "type": "object",
        "properties": {
          "EncodedAccountId": {
            "type": "string"
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "EncodedAccountId",
          "AccountId"
        ]
      },
      "ProviderAttributeModel": {
        "type": "object",
        "properties": {
          "AttributeId": {
            "type": "integer",
            "format": "int64"
          },
          "Name": {
            "type": "string"
          },
          "Good": {
            "type": "boolean"
          },
          "Bad": {
            "type": "boolean"
          }
        },
        "required": [
          "AttributeId",
          "Name",
          "Good",
          "Bad"
        ]
      },
      "QuestionOneStrengthsViewModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          },
          {
            "type": "object",
            "properties": {
              "ProviderName": {
                "type": "string"
              },
              "Attributes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ProviderAttributeModel"
                }
              },
              "ReturnToReviewAnswers": {
                "type": "boolean"
              }
            },
            "required": [
              "ProviderName",
              "Attributes",
              "ReturnToReviewAnswers"
            ]
          }
        ]
      },
      "QuestionTwoWeaknessesViewModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          },
          {
            "type": "object",
            "properties": {
              "ProviderName": {
                "type": "string"
              },
              "Attributes": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ProviderAttributeModel"
                }
              },
              "ReturnToReviewAnswers": {
                "type": "boolean"
              }
            },
            "required": [
              "ProviderName",
              "Attributes",
              "ReturnToReviewAnswers"
            ]
          }
        ]
      },
      "QuestionThreeRatingViewModel": {
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountModel"
          },
          {
            "type": "object",
            "properties": {
              "Rating": {
                "type": "string",
                "enum": [
                  "VeryPoor",
                  "Poor",
                  "Good",
                  "Excellent"
                ]
              },
              "ProviderName": {
                "type": "string"
              },
              "ReturnToReviewAnswers": {
                "type": "boolean"
              }
            },
            "required": [
              "ProviderName",
              "ReturnToReviewAnswers"
            ]
          }
        ]
      }
    }
  }
}
