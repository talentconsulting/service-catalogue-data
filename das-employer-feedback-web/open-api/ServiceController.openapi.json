{
  "openapi": "3.1.0",
  "info": {
    "title": "Service API",
    "version": "1.0.0"
  },
  "paths": {
    "/service/signout": {
      "get": {
        "operationId": "SignOut",
        "summary": "Signs out the user.",
        "responses": {
          "302": {
            "description": "Redirect after sign out."
          }
        }
      }
    },
    "/service/signoutcleanup": {
      "get": {
        "operationId": "SignOutCleanup",
        "summary": "Cleans up cookies related to sign out.",
        "responses": {
          "204": {
            "description": "No content."
          }
        }
      }
    },
    "/service/signin-stub": {
      "get": {
        "operationId": "SigninStub",
        "summary": "Displays a sign-in stub for debugging purposes.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sign-in stub page rendered.",
            "content": {
              "text/html": {}
            }
          }
        }
      },
      "post": {
        "operationId": "SigninStubPost",
        "summary": "Handles the sign-in stub form submission.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInStubViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to SignedInStub page."
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "SignedInStub",
        "summary": "Displays the signed-in stub view.",
        "parameters": [
          {
            "name": "returnUrl",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Signed-in stub page rendered.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SignInStubViewModel": {
        "type": "object",
        "properties": {
          "StubEmail": {
            "type": "string"
          },
          "StubId": {
            "type": "string"
          },
          "ReturnUrl": {
            "type": "string"
          }
        },
        "required": [
          "StubEmail",
          "StubId",
          "ReturnUrl"
        ]
      }
    }
  }
}
