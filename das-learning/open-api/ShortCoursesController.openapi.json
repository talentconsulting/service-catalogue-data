{
  "openapi": "3.1.0",
  "info": {
    "title": "Short Courses API",
    "version": "1.0.0",
    "description": "API for managing short courses."
  },
  "paths": {
    "/{ukprn}/academicyears/{academicYear}/shortCourses": {
      "get": {
        "summary": "Get paginated short courses by academic year.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of short courses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetShortCoursesByAcademicYearResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{ukprn}/{collectionYear}/shortCourses": {
      "get": {
        "summary": "Get paginated short courses for earnings.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "collectionYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of short courses for earnings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetShortCoursesForEarningsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/shortCourses": {
      "post": {
        "summary": "Create a draft short course learner record.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraftShortCourseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The newly created short course record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDraftShortCourseCommandResponse"
                }
              }
            }
          },
          "204": {
            "description": "No content."
          }
        }
      }
    },
    "/{ukprn}/shortCourses/{learnerKey}": {
      "delete": {
        "summary": "Remove a short course learner record.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "academicYear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Result indicating the short course was removed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemoveShortCourseResult"
                }
              }
            }
          },
          "404": {
            "description": "Short course record not found."
          }
        }
      },
      "put": {
        "summary": "Update a short course learner record.",
        "parameters": [
          {
            "name": "learnerKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShortCourseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated short course record.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateShortCourseResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetShortCoursesByAcademicYearResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShortCourseLearnerItem"
            }
          },
          "page": {
            "type": "integer"
          },
          "totalItems": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "ShortCourseLearnerItem": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "GetShortCoursesForEarningsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetShortCoursesForEarningsItem"
            }
          },
          "page": {
            "type": "integer"
          },
          "totalItems": {
            "type": "integer"
          },
          "pageSize": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "GetShortCoursesForEarningsItem": {
        "type": "object",
        "properties": {
          "learnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "learner": {
            "$ref": "#/components/schemas/GetShortCoursesForEarningsLearner"
          },
          "episodes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GetShortCoursesForEarningsEpisode"
            }
          }
        }
      },
      "GetShortCoursesForEarningsLearner": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "GetShortCoursesForEarningsEpisode": {
        "type": "object",
        "properties": {
          "learningKey": {
            "type": "string",
            "format": "uuid"
          },
          "courseCode": {
            "type": "string"
          },
          "isApproved": {
            "type": "boolean"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "learnerRef": {
            "type": "string"
          },
          "employerType": {
            "type": "string",
            "enum": [
              "NonLevy",
              "Levy"
            ]
          }
        }
      },
      "CreateDraftShortCourseRequest": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "academicYear": {
            "type": "integer",
            "format": "int32"
          },
          "learnerUpdateDetails": {
            "$ref": "#/components/schemas/ShortCourseLearnerUpdateDetails"
          },
          "learningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportDetails"
            }
          },
          "onProgramme": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnProgramme"
            }
          }
        }
      },
      "ShortCourseLearnerUpdateDetails": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "emailAddress": {
            "type": "string",
            "format": "email"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "uln": {
            "type": "integer",
            "format": "int64"
          },
          "learnerRef": {
            "type": "string"
          }
        }
      },
      "LearningSupportDetails": {
        "type": "object",
        "properties": {
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "OnProgramme": {
        "type": "object",
        "properties": {
          "courseCode": {
            "type": "string"
          },
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "withdrawalDate": {
            "type": "string",
            "format": "date"
          },
          "withdrawalReasonCode": {
            "type": "integer",
            "format": "int16"
          },
          "completionDate": {
            "type": "string",
            "format": "date"
          },
          "expectedEndDate": {
            "type": "string",
            "format": "date"
          },
          "milestones": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ThirtyPercentLearningComplete",
                "LearningComplete"
              ]
            }
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "learningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ]
          }
        }
      },
      "CreateDraftShortCourseCommandResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShortCourseCommandResult"
            }
          }
        }
      },
      "RemoveShortCourseResult": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RemoveShortCourseItemResult"
            }
          }
        }
      },
      "RemoveShortCourseItemResult": {
        "type": "object",
        "properties": {
          "removedEpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "learningKey": {
            "type": "string",
            "format": "uuid"
          },
          "learnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "learner": {
            "$ref": "#/components/schemas/ShortCourseLearner"
          },
          "episode": {
            "$ref": "#/components/schemas/ShortCourseCommandEpisode"
          }
        }
      },
      "ShortCourseLearner": {
        "type": "object",
        "properties": {
          "uln": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "ShortCourseCommandEpisode": {
        "type": "object",
        "properties": {
          "episodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "employerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "courseCode": {
            "type": "string"
          },
          "courseType": {
            "type": "string"
          },
          "learningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ]
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "plannedEndDate": {
            "type": "string",
            "format": "date"
          },
          "withdrawalDate": {
            "type": "string",
            "format": "date"
          },
          "ageAtStart": {
            "type": "integer"
          },
          "isApproved": {
            "type": "boolean"
          },
          "price": {
            "type": "number",
            "format": "decimal"
          },
          "learnerRef": {
            "type": "string"
          },
          "employerType": {
            "type": "string",
            "enum": [
              "NonLevy",
              "Levy"
            ]
          },
          "approvalsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "isRemoved": {
            "type": "boolean"
          },
          "transferSenderId": {
            "type": "integer",
            "format": "int64"
          },
          "completionDate": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "UpdateShortCourseRequest": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "academicYear": {
            "type": "integer",
            "format": "int32"
          },
          "learnerUpdateDetails": {
            "$ref": "#/components/schemas/ShortCourseLearnerUpdateDetails"
          },
          "onProgramme": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OnProgramme"
            }
          }
        }
      },
      "UpdateShortCourseResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UpdateShortCourseItemResult"
            }
          }
        }
      },
      "UpdateShortCourseItemResult": {
        "type": "object",
        "properties": {
          "changes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "WithdrawalDate",
                "Milestone",
                "CompletionDate",
                "LearnerRef",
                "Reinstated",
                "StartDate",
                "ExpectedEndDate",
                "ForceEarningsSync"
              ]
            }
          },
          "isNewLearning": {
            "type": "boolean"
          },
          "isNewEpisode": {
            "type": "boolean"
          },
          "isIgnored": {
            "type": "boolean"
          },
          "isRemoved": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
