{
  "openapi": "3.1.0",
  "info": {
    "title": "Learning API",
    "description": "API for managing apprenticeship learning and related data.",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukprn}/apprenticeships": {
      "post": {
        "summary": "Creates a draft apprenticeship",
        "description": "Creates a draft apprenticeship learning record associated with a given provider.",
        "tags": [
          "Apprenticeships"
        ],
        "operationId": "createDraftLearning",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK provider reference number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDraftApprenticeship"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The draft apprenticeship was created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateDraftApprenticeshipLearningCommandResult"
                }
              }
            }
          },
          "204": {
            "description": "No content."
          }
        }
      },
      "head": {
        "summary": "Checks if an apprenticeship record exists",
        "description": "Validates whether an apprenticeship record exists for a given ULN, training code, start date, and approval status.",
        "tags": [
          "Apprenticeships"
        ],
        "operationId": "checkApprovedApprenticeshipExists",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK provider reference number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uln",
            "in": "query",
            "required": true,
            "description": "Unique learner number.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "trainingCode",
            "in": "query",
            "required": true,
            "description": "Training code of the apprenticeship.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "in": "query",
            "required": true,
            "description": "Start date of the apprenticeship.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "isApproved",
            "in": "query",
            "required": true,
            "description": "Approval status to match against.",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A matching apprenticeship record exists."
          },
          "404": {
            "description": "No matching apprenticeship record exists."
          }
        }
      }
    },
    "/{ukprn}/learnings": {
      "get": {
        "summary": "Retrieve all apprenticeship learnings",
        "description": "Fetches summary data for all apprenticeships associated with a given provider.",
        "tags": [
          "Learnings"
        ],
        "operationId": "getAllLearnings",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "Unique provider reference number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeships retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LearnerSummary"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{ukprn}/{learnerKey}": {
      "put": {
        "summary": "Update learner details",
        "description": "Updates the details of a learner for a given learner key and provider.",
        "tags": [
          "Learners"
        ],
        "operationId": "updateLearning",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK provider reference number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerKey",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the learner record.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLearnerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Learner details updated successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LearningUpdateChanges"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remove learner details",
        "description": "Deletes a learner record for a given learner key, scoped to a specific provider and academic year.",
        "tags": [
          "Learners"
        ],
        "operationId": "removeLearning",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK provider reference number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "learnerKey",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the learner record.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "academicYear",
            "in": "query",
            "required": true,
            "description": "Academic year in yyyy format.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner record removed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{ukprn:long}/academicyears/{academicYear:int}/learnings": {
      "get": {
        "summary": "Retrieve paginated learnings by academic year",
        "description": "Fetches apprenticeship data for a provider filtered by academic year with support for pagination.",
        "tags": [
          "Learnings"
        ],
        "operationId": "getByAcademicYear",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK provider reference number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "academicYear",
            "in": "path",
            "required": true,
            "description": "Academic year in yyyy format.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination.",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Number of items per page.",
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learnings retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLearningsByAcademicYearResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{ukprn}/{collectionYear}/{collectionPeriod}": {
      "get": {
        "summary": "Retrieve FM36 learnings data",
        "description": "Fetches all FM36 learnings data for a provider including episodes and price data with optional pagination.",
        "tags": [
          "Learnings"
        ],
        "operationId": "getLearningsForFm36",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "description": "UK provider reference number.",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "collectionYear",
            "in": "path",
            "required": true,
            "description": "Collection year (e.g., 2023).",
            "schema": {
              "type": "integer",
              "format": "int16"
            }
          },
          {
            "name": "collectionPeriod",
            "in": "path",
            "required": true,
            "description": "Collection period (month).",
            "schema": {
              "type": "integer",
              "format": "int8"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Number of items per page.",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learnings retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetLearningsWithEpisodesResponse"
                }
              }
            }
          },
          "404": {
            "description": "No learnings data found."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDraftApprenticeship": {
        "type": "object",
        "properties": {
          "AcademicYear": {
            "type": "integer",
            "format": "int32"
          },
          "Delivery": {
            "$ref": "#/components/schemas/Delivery"
          },
          "Learner": {
            "$ref": "#/components/schemas/ApprenticeshipLearnerUpdateDetails"
          },
          "EnglishAndMathsCourses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishAndMaths"
            }
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportDetails"
            }
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/OnProgrammeDetails"
          }
        }
      },
      "Delivery": {
        "type": "object",
        "properties": {
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "TrainingCode": {
            "type": "string"
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          }
        }
      },
      "ApprenticeshipLearnerUpdateDetails": {
        "type": "object",
        "properties": {
          "Care": {
            "$ref": "#/components/schemas/CareDetails"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date"
          },
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "EmailAddress": {
            "type": "string"
          }
        }
      },
      "EnglishAndMaths": {
        "type": "object",
        "properties": {
          "Course": {
            "type": "string"
          },
          "LearnAimRef": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "PlannedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "LearningSupportDetails": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OnProgrammeDetails": {
        "type": "object",
        "properties": {
          "AchievementDate": {
            "type": "string",
            "format": "date-time"
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LearnerSummary": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "string"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          }
        }
      },
      "UpdateLearnerRequest": {
        "type": "object",
        "properties": {
          "AcademicYear": {
            "type": "integer",
            "format": "int32"
          },
          "Delivery": {
            "$ref": "#/components/schemas/Delivery"
          },
          "Learner": {
            "$ref": "#/components/schemas/ApprenticeshipLearnerUpdateDetails"
          }
        }
      },
      "GetLearningsByAcademicYearResponse": {
        "type": "object",
        "properties": {
          "Page": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalItems": {
            "type": "integer"
          },
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearnerSummary"
            }
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      },
      "CareDetails": {
        "type": "object",
        "properties": {
          "HasEHCP": {
            "type": "boolean"
          },
          "IsCareLeaver": {
            "type": "boolean"
          },
          "CareLeaverEmployerConsentGiven": {
            "type": "boolean"
          }
        }
      },
      "GetLearningsWithEpisodesResponse": {
        "type": "object",
        "additionalProperties": true
      }
    }
  }
}
