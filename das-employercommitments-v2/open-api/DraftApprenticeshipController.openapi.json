{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship Management API",
    "version": "1.0.0",
    "description": "API for managing draft apprenticeships within employer commitments."
  },
  "paths": {
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add": {
      "get": {
        "operationId": "AddNewDraftApprenticeship",
        "parameters": [
          {
            "name": "AccountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to SelectCourse"
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add/select-course": {
      "get": {
        "operationId": "SelectCourse",
        "parameters": [
          {
            "name": "AccountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Select course view"
          }
        }
      },
      "post": {
        "operationId": "SetCourse",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to SelectDeliveryModel"
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add/select-delivery-model": {
      "get": {
        "operationId": "SelectDeliveryModel",
        "parameters": [
          {
            "name": "AccountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Select delivery model view"
          }
        }
      },
      "post": {
        "operationId": "SetDeliveryModel",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectDeliveryModelViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to AddDraftApprenticeshipDetails"
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/add-another": {
      "get": {
        "operationId": "AddDraftApprenticeshipDetailsGet",
        "parameters": [
          {
            "name": "AccountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Add draft apprenticeship details view"
          }
        }
      },
      "post": {
        "operationId": "AddDraftApprenticeshipDetailsPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftApprenticeshipViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on changes/confirmation"
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/{DraftApprenticeshipHashedId}/edit": {
      "get": {
        "operationId": "EditDraftApprenticeship",
        "parameters": [
          {
            "name": "AccountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DraftApprenticeshipHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Edit draft apprenticeship view"
          }
        }
      }
    },
    "/{AccountHashedId}/unapproved/{cohortReference}/apprentices/{DraftApprenticeshipHashedId}/delete": {
      "get": {
        "operationId": "DeleteDraftApprenticeshipGet",
        "parameters": [
          {
            "name": "AccountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "DraftApprenticeshipHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Delete draft apprenticeship confirmation view"
          }
        }
      },
      "post": {
        "operationId": "DeleteDraftApprenticeshipPost",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteDraftApprenticeshipViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect based on delete confirmation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddDraftApprenticeshipRequest": {
        "type": "object",
        "properties": {
          "CohortId": {
            "type": "integer"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          }
        }
      },
      "AddDraftApprenticeshipViewModel": {
        "type": "object",
        "properties": {
          "AccountId": {
            "type": "integer"
          },
          "AccountHashedId": {
            "type": "string"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "TransferSenderHashedId": {
            "type": "string"
          },
          "CacheKey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "DeleteDraftApprenticeshipViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "DraftApprenticeshipHashedId": {
            "type": "string"
          },
          "DraftApprenticeshipId": {
            "type": "integer"
          },
          "ConfirmDelete": {
            "type": "boolean"
          }
        }
      },
      "SelectCourseViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "Courses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "CourseCode": {
            "type": "string"
          }
        }
      },
      "SelectDeliveryModelViewModel": {
        "type": "object",
        "properties": {
          "AccountHashedId": {
            "type": "string"
          },
          "DeliveryModels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DeliveryModel"
            }
          }
        }
      },
      "DeliveryModel": {
        "type": "string",
        "enum": [
          "Regular",
          "PortableFlexiJob",
          "FlexiJobAgency"
        ],
        "description": "Enumeration of delivery models available for apprenticeships."
      }
    }
  }
}
