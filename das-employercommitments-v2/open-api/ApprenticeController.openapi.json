{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Commitments API",
    "version": "1.0.0",
    "description": "API for managing employer commitments and apprenticeships."
  },
  "paths": {
    "/{accountHashedId}/apprentices": {
      "get": {
        "operationId": "getApprenticesIndex",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved apprentices index"
          }
        }
      }
    },
    "/{accountHashedId}/apprentices/download": {
      "get": {
        "operationId": "downloadApprentices",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully downloaded apprentices data"
          }
        }
      }
    },
    "/{accountHashedId}/apprentices/{apprenticeshipHashedId}/details/editenddate": {
      "get": {
        "operationId": "editApprenticeshipEndDate",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "apprenticeshipHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully edited apprenticeship end date"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "view": {}
    }
  }
}
