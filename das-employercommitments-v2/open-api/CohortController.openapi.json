{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Commitments V2 Cohort API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountHashedId}/unapproved/{cohortReference}": {
      "get": {
        "summary": "Get cohort details",
        "operationId": "getCohortDetails",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort details retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailsRequest"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.AccessCohort": []
          }
        ]
      },
      "post": {
        "summary": "Update cohort details",
        "operationId": "updateCohortDetails",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetailsViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cohort details updated successfully."
          }
        },
        "security": [
          {
            "PolicyNames.AccessCohort": []
          }
        ]
      }
    },
    "/{accountHashedId}/unapproved/{cohortReference}/delete": {
      "get": {
        "summary": "Confirm cohort deletion",
        "operationId": "confirmCohortDeletion",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort deletion confirmation page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfirmDeleteViewModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.AccessCohort": []
          }
        ]
      },
      "post": {
        "summary": "Delete cohort",
        "operationId": "deleteCohort",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmDeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Cohort deleted successfully."
          }
        },
        "security": [
          {
            "PolicyNames.AccessCohort": []
          }
        ]
      }
    },
    "/{accountHashedId}/unapproved/viewAgreement": {
      "get": {
        "summary": "View employer agreement",
        "operationId": "viewEmployerAgreement",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortId",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer agreement page."
          }
        }
      }
    },
    "/{accountHashedId}/unapproved/add": {
      "get": {
        "summary": "Add cohort apprenticeships",
        "operationId": "addCohortApprenticeships",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cohort addition page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexRequest"
                }
              }
            }
          }
        }
      }
    },
    "/{accountHashedId}/unapproved/{cohortReference}/sent": {
      "get": {
        "summary": "Get sent confirmation",
        "operationId": "getSentConfirmation",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sent confirmation details retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SentRequest"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.AccessCohort": []
          }
        ]
      }
    },
    "/{accountHashedId}/unapproved/{cohortReference}/approved": {
      "get": {
        "summary": "Get approved confirmation",
        "operationId": "getApprovedConfirmation",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Approved confirmation details retrieved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovedRequest"
                }
              }
            }
          }
        },
        "security": [
          {
            "PolicyNames.AccessCohort": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "DetailsRequest": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer"
          },
          "cohortReference": {
            "type": "string"
          }
        },
        "required": [
          "accountHashedId",
          "cohortReference"
        ]
      },
      "DetailsViewModel": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer"
          },
          "cohortReference": {
            "type": "string"
          },
          "selection": {
            "type": "string",
            "enum": [
              "Send",
              "Approve",
              "ViewEmployerAgreement",
              "Homepage"
            ]
          }
        },
        "required": [
          "accountHashedId",
          "cohortReference",
          "selection"
        ]
      },
      "ConfirmDeleteViewModel": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          },
          "cohortReference": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer"
          },
          "confirmDeletion": {
            "type": "boolean"
          }
        },
        "required": [
          "accountHashedId",
          "cohortReference",
          "cohortId"
        ]
      },
      "SentRequest": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          },
          "cohortReference": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer"
          }
        },
        "required": [
          "accountHashedId",
          "cohortReference"
        ]
      },
      "ApprovedRequest": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          },
          "cohortReference": {
            "type": "string"
          },
          "cohortId": {
            "type": "integer"
          }
        },
        "required": [
          "accountHashedId",
          "cohortReference"
        ]
      },
      "IndexRequest": {
        "type": "object",
        "properties": {
          "accountHashedId": {
            "type": "string"
          }
        },
        "required": [
          "accountHashedId"
        ]
      }
    }
  }
}
