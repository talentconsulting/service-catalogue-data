{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Commitments Service API",
    "version": "1.0.0"
  },
  "paths": {
    "/service/signout": {
      "post": {
        "operationId": "ServiceController_SignOut",
        "summary": "Signs out the current user.",
        "responses": {
          "200": {
            "description": "Successful sign-out."
          }
        }
      }
    },
    "/service/signoutcleanup": {
      "post": {
        "operationId": "ServiceController_SignOutCleanup",
        "summary": "Cleans up cookies after signing out.",
        "responses": {
          "200": {
            "description": "Successfully deleted authentication cookies."
          }
        }
      }
    },
    "/service/SignIn-Stub": {
      "get": {
        "operationId": "ServiceController_SigninStub",
        "summary": "Displays a stub sign-in page (debug mode only).",
        "responses": {
          "200": {
            "description": "Renders the sign-in stub view."
          }
        }
      },
      "post": {
        "operationId": "ServiceController_SigninStubPost",
        "summary": "Processes stub sign-in (debug mode only).",
        "responses": {
          "302": {
            "description": "Redirects to the signed-in stub route."
          }
        }
      }
    },
    "/service/signed-in-stub": {
      "get": {
        "operationId": "ServiceController_SignedInStub",
        "summary": "Displays the signed-in stub page (debug mode only).",
        "security": [
          {
            "defaultAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Renders the signed-in stub view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {},
    "securitySchemes": {
      "defaultAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
