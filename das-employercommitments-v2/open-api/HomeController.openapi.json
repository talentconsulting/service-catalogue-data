{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Commitments API",
    "version": "1.0.0"
  },
  "paths": {
    "/{accountHashedId}": {
      "get": {
        "summary": "Gets the home index view",
        "operationId": "GetHomeIndex",
        "parameters": [
          {
            "name": "accountHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "PageNumber",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SelectedProvider",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SelectedCourse",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SelectedEndDate",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "SelectedStatus",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ApprenticeshipStatus"
            }
          },
          {
            "name": "FromSearch",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "SelectedAlert",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/Alerts"
            }
          },
          {
            "name": "SelectedApprenticeConfirmation",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ConfirmationStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IndexViewModel"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IndexViewModel": {
        "type": "object",
        "additionalProperties": true
      },
      "ApprenticeshipStatus": {
        "type": "string",
        "enum": [
          "Approved",
          "InProgress",
          "Paused",
          "Stopped",
          "Completed"
        ]
      },
      "Alerts": {
        "type": "string",
        "enum": [
          "IlrDataMismatch",
          "ChangesPending",
          "ChangesRequested",
          "ChangesForReview",
          "ConfirmDates",
          "IlrChangeInvalid",
          "ChangesDeclined",
          "IlrChangesPending"
        ]
      },
      "ConfirmationStatus": {
        "type": "string",
        "enum": [
          "Pending",
          "Confirmed",
          "Declined"
        ]
      }
    }
  }
}
