{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Apprenticeship Management",
    "version": "1.0.0"
  },
  "paths": {
    "/{providerId}/unapproved/{cohortReference}/apprentices/add": {
      "get": {
        "operationId": "addNewDraftApprenticeship",
        "summary": "Redirect to adding a new draft apprenticeship.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to appropriate route based on the request."
          }
        }
      }
    },
    "/{providerId}/unapproved/{cohortReference}/apprentices/add/select-how": {
      "get": {
        "operationId": "addAnotherSelectMethodGet",
        "summary": "Select method for adding another apprenticeship.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Renders method selection view."
          }
        }
      },
      "post": {
        "operationId": "addAnotherSelectMethodPost",
        "summary": "Submit method for adding another apprenticeship.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Details of the selected method.",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectAddAnotherDraftApprenticeshipJourneyViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the reservation ID or course selection page."
          }
        }
      }
    },
    "/{providerId}/unapproved/{cohortReference}/apprentices/add/reservation": {
      "get": {
        "operationId": "getReservationId",
        "summary": "Fetch reservation ID for adding apprenticeships.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to reservation selection link."
          }
        }
      }
    },
    "/{providerId}/unapproved/{cohortReference}/apprentices/add/select-course": {
      "get": {
        "operationId": "addDraftApprenticeshipCourseGet",
        "summary": "Display course selection screen for draft apprenticeships.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course selection screen."
          }
        }
      },
      "post": {
        "operationId": "setCoursePost",
        "summary": "Set course for draft apprenticeship.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cohortReference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Draft apprenticeship course selection details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to delivery model selection screen."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectAddAnotherDraftApprenticeshipJourneyViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CohortReference": {
            "type": "string"
          },
          "UseLearnerData": {
            "type": "boolean"
          }
        }
      },
      "SelectCourseViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CourseCode": {
            "type": "string"
          }
        }
      }
    }
  }
}
