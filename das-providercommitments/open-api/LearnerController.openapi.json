{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Commitments - Learner Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/{providerId}/unapproved/add/learners/select": {
      "get": {
        "operationId": "selectLearnerRecord",
        "summary": "Select a learner record",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "AccountLegalEntityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "ReservationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "StartMonth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "StartYear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 2023
            }
          },
          {
            "name": "CourseCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "LearningType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Apprenticeship",
                "FoundationApprenticeship",
                "ApprenticeshipUnit"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Learner record selected successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectLearnerRecordRequest"
                }
              }
            }
          }
        },
        "security": [
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      }
    },
    "/{providerId}/unapproved/add/learners/select-multiple": {
      "get": {
        "operationId": "selectMultipleLearnerRecords",
        "summary": "Select multiple learner records",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Multiple learner records selected successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectMultipleLearnerRecordsRequest"
                }
              }
            }
          }
        },
        "security": [
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      }
    },
    "/{providerId}/unapproved/add/learners/select-multiple-filter": {
      "get": {
        "operationId": "selectMultipleLearnerRecordsFilter",
        "summary": "Filter multiple learner records for selection",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "StartMonth",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "StartYear",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 2023
            }
          },
          {
            "name": "ClearFilter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "CourseCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "LearningType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "Apprenticeship",
                "FoundationApprenticeship",
                "ApprenticeshipUnit"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to filtered selection of multiple learner records"
          }
        },
        "security": [
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      }
    },
    "/{providerId}/unapproved/add/learners/select/{learnerDataId}": {
      "get": {
        "operationId": "learnerSelectedForNewCohort",
        "summary": "Select a learner for new cohort",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "learnerDataId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "CacheKey",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "AccountLegalEntityId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "EmployerAccountLegalEntityPublicHashedId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to create cohort and add first apprenticeship"
          }
        },
        "security": [
          {
            "HasContributorOrAbovePermission": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SelectLearnerRecordRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "EmployerAccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "CacheKey": {
            "type": "string",
            "format": "uuid"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortField": {
            "type": "string"
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "Page": {
            "type": "integer",
            "default": 1
          },
          "StartMonth": {
            "type": "integer",
            "nullable": true
          },
          "StartYear": {
            "type": "integer",
            "default": 2023
          },
          "CourseCode": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "enum": [
              "Apprenticeship",
              "FoundationApprenticeship",
              "ApprenticeshipUnit"
            ],
            "nullable": true
          }
        }
      },
      "SelectMultipleLearnerRecordsRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CacheKey": {
            "type": "string",
            "format": "uuid"
          },
          "Page": {
            "type": "integer",
            "default": 1
          }
        }
      },
      "LearnerSelectedRequest": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CacheKey": {
            "type": "string",
            "format": "uuid"
          },
          "LearnerDataId": {
            "type": "integer"
          },
          "EmployerAccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          }
        }
      }
    },
    "securitySchemes": {
      "HasContributorOrAbovePermission": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
