{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Commitments Cohort API",
    "version": "1.0.0",
    "description": "API documentation for the CohortController in the DAS Provider Commitments project."
  },
  "paths": {
    "/{providerId}/unapproved/review": {
      "get": {
        "operationId": "GetCohortReview",
        "summary": "Retrieve cohort review details.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Review data retrieved successfully."
          }
        }
      }
    },
    "/{providerId}/unapproved/draft": {
      "get": {
        "operationId": "GetCohortDraft",
        "summary": "Retrieve cohort draft details.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft data retrieved successfully."
          }
        }
      }
    },
    "/{providerId}/unapproved/with-employer": {
      "get": {
        "operationId": "GetCohortWithEmployer",
        "summary": "Retrieve cohort details with employer involvement.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data with employer retrieved successfully."
          }
        }
      }
    },
    "/{providerId}/unapproved/with-transfer-sender": {
      "get": {
        "operationId": "GetCohortWithTransferSender",
        "summary": "Retrieve cohort details with transfer sender involvement.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data with transfer sender retrieved successfully."
          }
        }
      }
    },
    "/{providerId}/unapproved/add-apprentice": {
      "get": {
        "operationId": "GetAddApprenticeToDraft",
        "summary": "Initiate addition of a new apprentice to a draft cohort.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Apprenticeship addition initiated successfully."
          }
        }
      }
    },
    "/{providerId}/unapproved/add/select-course": {
      "get": {
        "operationId": "GetSelectCourseForCohort",
        "summary": "Select a course for adding apprentices to a cohort.",
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course selection data retrieved successfully."
          }
        }
      },
      "post": {
        "operationId": "PostSelectCourseForCohort",
        "summary": "Confirm course selection for cohort.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectCourseViewModel"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "providerId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course selection confirmed successfully."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectCourseViewModel": {
        "type": "object",
        "properties": {
          "ProviderId": {
            "type": "integer"
          },
          "CohortReference": {
            "type": "string"
          },
          "DraftApprenticeshipHashedId": {
            "type": "string"
          },
          "ApprenticeshipHashedId": {
            "type": "string"
          },
          "CohortId": {
            "type": "integer"
          },
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "EmployerAccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountLegalEntityId": {
            "type": "integer"
          },
          "Courses": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          },
          "CourseCode": {
            "type": "string"
          },
          "StartMonthYear": {
            "type": "string"
          },
          "DeliveryModel": {
            "type": "string"
          }
        }
      }
    }
  }
}
