{
  "openapi": "3.1.0",
  "info": {
    "title": "Provide Feedback Employer API",
    "version": "1.0.0"
  },
  "paths": {
    "/feedback/review-answers": {
      "get": {
        "operationId": "getReviewAnswers",
        "summary": "Retrieve review answers for feedback.",
        "responses": {
          "200": {
            "description": "Successful response with review answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyModel"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "operationId": "postReviewAnswersConfirmation",
        "summary": "Submit review answers confirmation.",
        "responses": {
          "302": {
            "description": "Redirect to the confirmation page.",
            "headers": {
              "Location": {
                "description": "URL of the confirmation page.",
                "schema": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          }
        },
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "SurveyModel": {
        "type": "object",
        "properties": {
          "FatUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL of the 'Find Apprenticeship Training' site."
          },
          "Submitted": {
            "type": "boolean",
            "description": "Indicates if the feedback was already submitted."
          }
        },
        "required": []
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
