{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Feedback API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/EmployerFeedbackResult/{ukprn}": {
      "get": {
        "tags": [
          "EmployerFeedbackResult"
        ],
        "summary": "Get Employer Feedback Result",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployerFeedbackResultDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/EmployerFeedbackResult/{ukprn}/annual": {
      "get": {
        "tags": [
          "EmployerFeedbackResult"
        ],
        "summary": "Get Employer Feedback Result Annual",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployerFeedbackAnnualResultDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/EmployerFeedbackResult/{ukprn}/annual/{year}": {
      "get": {
        "tags": [
          "EmployerFeedbackResult"
        ],
        "summary": "Get Employer Feedback Result for Academic Year",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^AY\\d{4}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EmployerFeedbackForAcademicYearResultDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/EmployerFeedbackResult/reviews": {
      "get": {
        "tags": [
          "EmployerFeedbackResult"
        ],
        "summary": "Get All Stars Summary",
        "parameters": [
          {
            "name": "timePeriod",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(|All|AY\\d{4})$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/EmployerFeedbackStarsSummary"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmployerFeedbackResultDto": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "stars": {
            "type": "integer",
            "format": "int32"
          },
          "reviewCount": {
            "type": "integer",
            "format": "int32"
          },
          "timeperiod": {
            "type": "string"
          },
          "providerAttribute": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderAttributeSummaryItemDto"
            }
          }
        }
      },
      "EmployerFeedbackAnnualResultDto": {
        "type": "object"
      },
      "EmployerFeedbackForAcademicYearResultDto": {
        "type": "object"
      },
      "EmployerFeedbackStarsSummary": {
        "type": "object",
        "properties": {
          "ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "stars": {
            "type": "integer",
            "format": "int32"
          },
          "reviewCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProviderAttributeSummaryItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "strength": {
            "type": "integer",
            "format": "int32"
          },
          "weakness": {
            "type": "integer",
            "format": "int32"
          }
        }
      }
    }
  }
}
