{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprentice Accounts API",
    "version": "1.0.0"
  },
  "paths": {
    "/profile/{clientId}/changeemail/confirm": {
      "get": {
        "operationId": "ConfirmChangeEmail",
        "summary": "Redirects to confirm email change using clientId, email, and token.",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "email",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "email"
            }
          },
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the external service for email confirmation."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    },
    "/AcceptTermsOfUse": {
      "get": {
        "operationId": "AcceptTermsOfUse",
        "summary": "Redirects the user to the Terms of Use page.",
        "responses": {
          "302": {
            "description": "Redirect to the Terms of Use page."
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "tokenUrl": "https://example.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  }
}
