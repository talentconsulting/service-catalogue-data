{
  "openapi": "3.1.0",
  "info": {
    "title": "Learner Data API",
    "version": "1.0.0"
  },
  "paths": {
    "/learners": {
      "get": {
        "summary": "Get All Learners",
        "operationId": "getAllLearners",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for pagination",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "description": "Number of results per page (maximum 1000)",
            "schema": {
              "type": "integer",
              "default": 100
            }
          },
          {
            "name": "excludeApproved",
            "in": "query",
            "required": false,
            "description": "Exclude approved learners",
            "schema": {
              "type": "boolean",
              "default": true
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with learners data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetAllLearnersResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request (e.g., if pageSize exceeds 1000)"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetAllLearnersResponse": {
        "type": "object",
        "description": "The response object for retrieving all learners.",
        "properties": {}
      }
    }
  }
}
