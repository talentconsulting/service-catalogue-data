{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Learners API",
    "version": "1.0"
  },
  "paths": {
    "/providers/{ukprn}/learners": {
      "post": {
        "operationId": "SearchLearners",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchLearnersRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/providers/{ukprn}/learners/{uln}": {
      "put": {
        "operationId": "SaveLearner",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "uln",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveLearnerRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/providers/{ukprn}/learners/{id}": {
      "get": {
        "operationId": "GetLearnerById",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/providers/{ukprn}/learners/{id}/apprenticeshipId": {
      "patch": {
        "operationId": "PatchApprenticeshipId",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchLearnerDataApprenticeshipIdRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchLearnersRequest": {
        "type": "object",
        "properties": {
          "StartMonth": {
            "type": "integer",
            "nullable": true
          },
          "StartYear": {
            "type": "integer"
          },
          "Page": {
            "type": "integer",
            "default": 1
          },
          "PageSize": {
            "type": "integer",
            "nullable": true,
            "default": 20
          },
          "SortColumn": {
            "type": "string",
            "nullable": true,
            "default": ""
          },
          "SortDescending": {
            "type": "boolean",
            "default": false
          },
          "Filter": {
            "type": "string",
            "nullable": true,
            "default": ""
          },
          "ExcludeApproved": {
            "type": "boolean",
            "default": true
          },
          "MaxStartDate": {
            "type": "string",
            "nullable": true,
            "default": ""
          },
          "ExcludeUlns": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            }
          },
          "CourseCode": {
            "type": "string",
            "nullable": true
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          }
        }
      },
      "SaveLearnerRequest": {
        "type": "object",
        "properties": {
          "Uln": {
            "type": "integer",
            "format": "int64"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "FirstName": {
            "type": "string"
          },
          "LastName": {
            "type": "string"
          },
          "Email": {
            "type": "string",
            "nullable": true
          },
          "Dob": {
            "type": "string",
            "format": "date"
          },
          "AcademicYear": {
            "type": "integer"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "PlannedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "PercentageLearningToBeDelivered": {
            "type": "integer",
            "nullable": true
          },
          "EpaoPrice": {
            "type": "integer"
          },
          "TrainingPrice": {
            "type": "integer"
          },
          "AgreementId": {
            "type": "string",
            "nullable": true
          },
          "LarsCode": {
            "type": "string",
            "nullable": true
          },
          "TrainingName": {
            "type": "string",
            "nullable": true
          },
          "LearningType": {
            "$ref": "#/components/schemas/LearningType"
          },
          "IsFlexiJob": {
            "type": "boolean"
          },
          "PlannedOTJTrainingHours": {
            "type": "integer"
          },
          "ReceivedDate": {
            "type": "string",
            "format": "date-time"
          },
          "CorrelationId": {
            "type": "string",
            "format": "uuid"
          },
          "ConsumerReference": {
            "type": "string"
          }
        }
      },
      "PatchLearnerDataApprenticeshipIdRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          }
        }
      },
      "LearningType": {
        "type": "string",
        "enum": [
          "Apprenticeship",
          "FoundationApprenticeship",
          "ApprenticeshipUnit"
        ]
      }
    }
  }
}
