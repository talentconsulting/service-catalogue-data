{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite BidManager API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/runtime/auth": {
      "get": {
        "operationId": "getRuntimeAuth",
        "responses": {
          "200": {
            "description": "Runtime Authentication response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeAuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/accept-invite/validate": {
      "get": {
        "operationId": "validateInvitationToken",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteValidationResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RuntimeAuthResponse": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
