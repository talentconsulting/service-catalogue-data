{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/runtime/auth": {
      "get": {
        "summary": "Retrieve runtime authentication configuration",
        "operationId": "getRuntimeAuth",
        "responses": {
          "200": {
            "description": "Runtime authentication response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeAuthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/accept-invite/validate": {
      "get": {
        "summary": "Validate an invitation token",
        "operationId": "validateInvitationToken",
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Valid or invalid token status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteValidationResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/accept-invite": {
      "post": {
        "summary": "Accept invitation token",
        "operationId": "acceptInvitationToken",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInviteRequest"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/users/accept-invite/register": {
      "post": {
        "summary": "Register user with invitation token",
        "operationId": "registerInvite",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInviteRequest"
              }
            }
          }
        },
        "responses": {
          "default": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Retrieve all users",
        "operationId": "getUsers",
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Retrieve current user profile",
        "operationId": "getMyProfile",
        "responses": {
          "200": {
            "description": "Current user profile information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserProfileResponse"
                }
              }
            }
          },
          "404": {
            "description": "Profile not found"
          }
        }
      }
    },
    "/api/users/me-authorisation": {
      "get": {
        "summary": "Get current user authorization details",
        "operationId": "getMyAuthorisation",
        "responses": {
          "200": {
            "description": "Current user authorization details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserAuthorisationResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bids/{bidId}": {
      "get": {
        "summary": "Retrieve a bid's details",
        "operationId": "getBid",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Details of the bid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidManageModel"
                }
              }
            }
          }
        }
      }
    },
    "/api/bids/{bidId}/files": {
      "get": {
        "summary": "Get files associated with a bid",
        "operationId": "getBidFiles",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bid files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BidFileResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload a file to a bid",
        "operationId": "uploadBidFile",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded file information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidFileResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/bids/{bidId}/files/{fileId}": {
      "get": {
        "summary": "Download a specific file from a bid",
        "operationId": "downloadBidFile",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File download response",
            "content": {
              "application/octet-stream": {}
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a specific file from a bid",
        "operationId": "deleteBidFile",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "File deleted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RuntimeAuthResponse": {
        "type": "object",
        "properties": {
          "KeycloakAuthority": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "InviteValidationResponse": {
        "type": "object",
        "properties": {
          "Status": {
            "type": "string"
          }
        }
      },
      "AcceptInviteRequest": {
        "type": "object",
        "properties": {
          "InvitationToken": {
            "type": "string"
          }
        }
      },
      "RegisterInviteRequest": {
        "type": "object",
        "properties": {
          "InvitationToken": {
            "type": "string"
          },
          "Username": {
            "type": "string"
          },
          "Password": {
            "type": "string"
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          },
          "IdentityProvider": {
            "type": "string"
          },
          "IdentitySubject": {
            "type": "string"
          },
          "IdentityUsername": {
            "type": "string"
          },
          "InvitationToken": {
            "type": "string"
          },
          "InvitationExpiresAtUtc": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "Admin",
          "BidManager",
          "User"
        ]
      },
      "CurrentUserProfileResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          },
          "IdentityProvider": {
            "type": "string"
          },
          "IdentitySubject": {
            "type": "string"
          },
          "IdentityUsername": {
            "type": "string"
          }
        }
      },
      "CurrentUserAuthorisationResponse": {
        "type": "object",
        "properties": {
          "IsAdmin": {
            "type": "boolean"
          },
          "IsBidManager": {
            "type": "boolean"
          },
          "CanManageAssignedBids": {
            "type": "boolean"
          },
          "Roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BidManageModel": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "UniqueReference": {
            "type": "string",
            "nullable": true
          },
          "Company": {
            "type": "string"
          },
          "Summary": {
            "type": "string",
            "nullable": true
          },
          "KeyInformation": {
            "type": "string",
            "nullable": true
          },
          "Budget": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForSubmission": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForQualifying": {
            "type": "string",
            "nullable": true
          },
          "LengthOfContract": {
            "type": "string",
            "nullable": true
          },
          "Stage": {
            "$ref": "#/components/schemas/BidStage"
          },
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          },
          "BidLibraryPush": {
            "$ref": "#/components/schemas/BidLibraryPushResponse",
            "nullable": true
          }
        }
      },
      "BidStage": {
        "type": "string",
        "enum": [
          "Stage1",
          "Stage2"
        ]
      },
      "BidStatus": {
        "type": "string",
        "enum": [
          "Underway",
          "Cancelled",
          "Submitted",
          "Won",
          "Lost"
        ]
      },
      "BidLibraryPushResponse": {
        "type": "object",
        "properties": {
          "BidId": {
            "type": "string"
          },
          "PerformedByUserId": {
            "type": "string"
          },
          "PerformedByName": {
            "type": "string"
          },
          "PushedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BidFileResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "BidId": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "SizeBytes": {
            "type": "integer"
          },
          "UploadedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
