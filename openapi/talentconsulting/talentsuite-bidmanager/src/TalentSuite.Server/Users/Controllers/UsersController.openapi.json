{
  "openapi": "3.1.0",
  "info": {
    "title": "Users API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/users": {
      "get": {
        "summary": "Get list of users",
        "operationId": "getUsers",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserResponse"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "AuthorizePolicy": [
              "RequireBidManagerOrAdminRole"
            ]
          }
        ]
      },
      "post": {
        "summary": "Add a new user",
        "operationId": "addUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        },
        "security": [
          {
            "AuthorizePolicy": [
              "RequireAdminRole"
            ]
          }
        ]
      }
    },
    "/api/users/{userId}": {
      "get": {
        "summary": "Get user details",
        "operationId": "getUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "AuthorizePolicy": [
              "RequireAdminRole"
            ]
          }
        ]
      },
      "put": {
        "summary": "Update user details",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "User updated successfully"
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "AuthorizePolicy": [
              "RequireAdminRole"
            ]
          }
        ]
      },
      "delete": {
        "summary": "Delete a user",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted successfully"
          },
          "400": {
            "description": "Bad request"
          }
        },
        "security": [
          {
            "AuthorizePolicy": [
              "RequireAdminRole"
            ]
          }
        ]
      }
    },
    "/api/users/{userId}/resend-invite": {
      "post": {
        "summary": "Resend user invite",
        "operationId": "resendInvite",
        "parameters": [
          {
            "name": "userId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Invite resent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendInviteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        },
        "security": [
          {
            "AuthorizePolicy": [
              "RequireAdminRole"
            ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "UserResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          },
          "IdentityProvider": {
            "type": "string"
          },
          "IdentitySubject": {
            "type": "string"
          },
          "IdentityUsername": {
            "type": "string"
          },
          "InvitationToken": {
            "type": "string"
          },
          "InvitationExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          }
        },
        "required": [
          "Name",
          "Email",
          "Role",
          "HasAcceptedRegistration"
        ]
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          }
        },
        "required": [
          "Name",
          "Email",
          "Role",
          "HasAcceptedRegistration"
        ]
      },
      "ResendInviteResponse": {
        "type": "object",
        "properties": {
          "InvitationToken": {
            "type": "string"
          },
          "InvitationExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "Admin",
          "BidManager",
          "User"
        ]
      }
    },
    "securitySchemes": {
      "AuthorizePolicy": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
}
