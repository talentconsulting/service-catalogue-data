{
  "openapi": "3.1.0",
  "info": {
    "title": "Draft Response Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/drafts": {
      "post": {
        "summary": "Add a new draft response.",
        "operationId": "AddResponse",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Response successfully added."
          },
          "400": {
            "description": "Invalid request."
          }
        }
      },
      "get": {
        "summary": "Retrieve all draft responses for a question.",
        "operationId": "GetAllResponses",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft responses retrieved successfully."
          },
          "400": {
            "description": "Invalid request."
          }
        }
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}": {
      "delete": {
        "summary": "Remove a draft response.",
        "operationId": "RemoveResponse",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "responseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft response removed successfully."
          },
          "400": {
            "description": "Invalid request."
          }
        }
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}/comments": {
      "get": {
        "summary": "Retrieve all comments for a draft.",
        "operationId": "GetComments",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comments retrieved successfully."
          },
          "400": {
            "description": "Invalid request."
          }
        }
      },
      "post": {
        "summary": "Add a comment to a draft.",
        "operationId": "AddComment",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment added successfully."
          },
          "400": {
            "description": "Invalid request."
          }
        }
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}/comments/{commentId}": {
      "patch": {
        "summary": "Set the completion status of a comment.",
        "operationId": "SetCommentCompletion",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "draftId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Completion status of the comment set successfully."
          },
          "400": {
            "description": "Invalid request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DraftRequest": {
        "type": "object",
        "properties": {
          "Response": {
            "type": "string"
          }
        },
        "required": [
          "Response"
        ]
      },
      "UpdateDraftRequest": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Response": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Response"
        ]
      },
      "AddDraftCommentRequest": {
        "type": "object",
        "properties": {
          "Comment": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "MentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        },
        "required": [
          "Comment",
          "UserId",
          "AuthorName",
          "MentionedUserIds",
          "SelectedText"
        ]
      },
      "SetCommentCompletionRequest": {
        "type": "object",
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "IsComplete"
        ]
      }
    }
  }
}
