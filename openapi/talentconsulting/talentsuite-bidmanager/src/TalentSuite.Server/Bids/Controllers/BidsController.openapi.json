{
  "openapi": "3.1.0",
  "info": {
    "title": "Bids API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids": {
      "post": {
        "summary": "Create a new bid",
        "operationId": "createBid",
        "security": [
          {
            "requireAdminRole": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBidRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bid successfully created",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid request data"
          }
        }
      },
      "get": {
        "summary": "Get a paginated list of bids",
        "operationId": "getBids",
        "security": [
          {
            "requireAuthorization": []
          }
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedBidListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/bids/{bidId}": {
      "get": {
        "summary": "Get details of a specific bid",
        "operationId": "getBid",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bid details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidResponse"
                }
              }
            }
          },
          "404": {
            "description": "Bid not found"
          }
        }
      }
    },
    "/api/bids/{bidId}/status": {
      "patch": {
        "summary": "Update bid status",
        "operationId": "updateBidStatus",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBidStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bid status updated"
          },
          "400": {
            "description": "Invalid request data"
          }
        }
      }
    },
    "/api/bids/{bidId}/overview": {
      "patch": {
        "summary": "Update bid overview",
        "operationId": "updateBidOverview",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBidOverviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Bid overview updated"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/api/bids/{bidId}/files": {
      "get": {
        "summary": "Get a list of bid files",
        "operationId": "getBidFiles",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BidFileResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Upload a file to a bid",
        "operationId": "uploadBidFile",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "File uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidFileResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          }
        }
      }
    },
    "/api/bids/{bidId}/files/{fileId}": {
      "get": {
        "summary": "Download a file from a bid",
        "operationId": "downloadBidFile",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File downloaded",
            "content": {
              "application/octet-stream": {}
            }
          },
          "404": {
            "description": "File not found"
          }
        }
      },
      "delete": {
        "summary": "Delete a file from a bid",
        "operationId": "deleteBidFile",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "File deleted"
          },
          "404": {
            "description": "File not found"
          }
        }
      }
    },
    "/api/bids/{bidId}/library-push": {
      "post": {
        "summary": "Push a bid to the library",
        "operationId": "pushBidToLibrary",
        "security": [
          {
            "requireBidAccess": []
          }
        ],
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bid pushed to library",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidLibraryPushResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateBidRequest": {
        "type": "object",
        "properties": {
          "UniqueReference": {
            "type": "string",
            "nullable": true
          },
          "Company": {
            "type": "string",
            "nullable": true
          },
          "Summary": {
            "type": "string",
            "nullable": true
          },
          "KeyInformation": {
            "type": "string",
            "nullable": true
          },
          "Budget": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForQualifying": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForSubmission": {
            "type": "string",
            "nullable": true
          },
          "LengthOfContract": {
            "type": "string",
            "nullable": true
          },
          "Stage": {
            "$ref": "#/components/schemas/BidStage"
          },
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          },
          "Questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateQuestionRequest"
            }
          }
        }
      },
      "CreateQuestionRequest": {
        "type": "object",
        "properties": {
          "QuestionOrderIndex": {
            "type": "integer"
          },
          "Category": {
            "type": "string"
          },
          "Number": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Length": {
            "type": "string"
          },
          "Weighting": {
            "type": "integer"
          },
          "Required": {
            "type": "boolean"
          },
          "NiceToHave": {
            "type": "boolean"
          }
        }
      },
      "BidResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "nullable": true
          },
          "UniqueReference": {
            "type": "string",
            "nullable": true
          },
          "Company": {
            "type": "string",
            "nullable": true
          },
          "Summary": {
            "type": "string",
            "nullable": true
          },
          "KeyInformation": {
            "type": "string",
            "nullable": true
          },
          "Budget": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForQualifying": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForSubmission": {
            "type": "string",
            "nullable": true
          },
          "LengthOfContract": {
            "type": "string",
            "nullable": true
          },
          "Stage": {
            "$ref": "#/components/schemas/BidStage"
          },
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          },
          "BidLibraryPush": {
            "$ref": "#/components/schemas/BidLibraryPushResponse"
          },
          "Questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionResponse"
            }
          }
        }
      },
      "UpdateBidStatusRequest": {
        "type": "object",
        "properties": {
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          }
        }
      },
      "UpdateBidOverviewRequest": {
        "type": "object",
        "properties": {
          "UniqueReference": {
            "type": "string",
            "nullable": true
          },
          "Summary": {
            "type": "string",
            "nullable": true
          },
          "KeyInformation": {
            "type": "string",
            "nullable": true
          },
          "Budget": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForQualifying": {
            "type": "string",
            "nullable": true
          },
          "DeadlineForSubmission": {
            "type": "string",
            "nullable": true
          },
          "LengthOfContract": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BidFileResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "BidId": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "SizeBytes": {
            "type": "integer"
          },
          "UploadedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BidLibraryPushResponse": {
        "type": "object",
        "properties": {
          "BidId": {
            "type": "string"
          },
          "PerformedByUserId": {
            "type": "string"
          },
          "PerformedByName": {
            "type": "string"
          },
          "PushedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PagedBidListResponse": {
        "type": "object",
        "properties": {
          "Items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BidListItemResponse"
            }
          },
          "CurrentPage": {
            "type": "integer"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          },
          "TotalPages": {
            "type": "integer"
          },
          "FirstItem": {
            "type": "integer"
          },
          "LastItem": {
            "type": "integer"
          }
        }
      },
      "BidListItemResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Company": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "QuestionCount": {
            "type": "integer"
          },
          "OwnerId": {
            "type": "string"
          },
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          }
        }
      },
      "QuestionResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ParsedQuestionResponse"
          },
          {
            "type": "object",
            "properties": {
              "Id": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ParsedQuestionResponse": {
        "type": "object",
        "properties": {
          "QuestionOrderIndex": {
            "type": "integer"
          },
          "Category": {
            "type": "string"
          },
          "Number": {
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Length": {
            "type": "string"
          },
          "Weighting": {
            "type": "integer"
          },
          "Required": {
            "type": "boolean"
          },
          "NiceToHave": {
            "type": "boolean"
          }
        }
      },
      "BidStage": {
        "type": "string",
        "enum": [
          "Stage1",
          "Stage2"
        ]
      },
      "BidStatus": {
        "type": "string",
        "enum": [
          "Underway",
          "Cancelled",
          "Submitted",
          "Won",
          "Lost"
        ]
      }
    },
    "securitySchemes": {
      "requireAdminRole": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "RequireAdminRole": "Admin role required"
            }
          }
        }
      },
      "requireBidAccess": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "RequireBidAccess": "Access to the bid required"
            }
          }
        }
      },
      "requireAuthorization": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "tokenUrl": "https://example.com/token",
            "scopes": {
              "RequireAuthorization": "Authorization required"
            }
          }
        }
      }
    }
  }
}
