{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Bid Manager API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/tasks/my": {
      "get": {
        "summary": "Get tasks assigned to the current user.",
        "operationId": "GetMyTasks",
        "responses": {
          "200": {
            "description": "Tasks assigned to the current user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MentionTaskResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/api/tasks/my-question-assignments": {
      "get": {
        "summary": "Get question assignments for the current user.",
        "operationId": "GetMyQuestionAssignments",
        "responses": {
          "200": {
            "description": "Question assignments for the current user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AssignedQuestionTaskResponse"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MentionTaskResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "BidId": {
            "type": "string"
          },
          "BidTitle": {
            "type": "string"
          },
          "QuestionId": {
            "type": "string"
          },
          "QuestionTitle": {
            "type": "string"
          },
          "CommentId": {
            "type": "string"
          },
          "AssignedUserId": {
            "type": "string"
          },
          "CommentText": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "Id",
          "BidId",
          "BidTitle",
          "QuestionId",
          "QuestionTitle",
          "CommentId",
          "AssignedUserId",
          "CommentText",
          "CreatedAtUtc"
        ]
      },
      "AssignedQuestionTaskResponse": {
        "type": "object",
        "properties": {
          "BidId": {
            "type": "string"
          },
          "BidTitle": {
            "type": "string"
          },
          "QuestionId": {
            "type": "string"
          },
          "QuestionNumber": {
            "type": "string"
          },
          "QuestionTitle": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/QuestionUserRole"
          },
          "NiceToHave": {
            "type": "boolean"
          }
        },
        "required": [
          "BidId",
          "BidTitle",
          "QuestionId",
          "QuestionNumber",
          "QuestionTitle",
          "Role",
          "NiceToHave"
        ]
      },
      "QuestionUserRole": {
        "type": "string",
        "enum": [
          "Owner",
          "Reviewer",
          "Support"
        ]
      }
    }
  }
}
