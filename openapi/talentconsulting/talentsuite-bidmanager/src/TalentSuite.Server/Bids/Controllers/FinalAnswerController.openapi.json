{
  "openapi": "3.1.0",
  "info": {
    "title": "Final Answer API",
    "version": "1.0.0",
    "description": "API for managing final answers and comments for bids."
  },
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/final-answer": {
      "get": {
        "summary": "Get Final Answer",
        "description": "Retrieve the final answer for a specified bid and question.",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "description": "The bid ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "description": "The question ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the final answer.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalAnswerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Final answer not found."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      },
      "put": {
        "summary": "Set Final Answer",
        "description": "Update the final answer for a specified bid and question.",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "description": "The bid ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "description": "The question ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFinalAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Final answer successfully updated."
          },
          "400": {
            "description": "Invalid request body."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments": {
      "post": {
        "summary": "Add Comment to Final Answer",
        "description": "Add a comment to the final answer.",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "description": "The bid ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "description": "The question ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment successfully added.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or empty comment."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments/{commentId}": {
      "patch": {
        "summary": "Set Comment Completion",
        "description": "Mark a comment as complete or incomplete.",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "description": "The bid ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "description": "The question ID.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "description": "The comment ID.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Comment completion status successfully updated.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing comment ID."
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "FinalAnswerResponse": {
        "type": "object",
        "properties": {
          "QuestionId": {
            "type": "string"
          },
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          },
          "Comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftCommentResponse"
            }
          }
        }
      },
      "UpdateFinalAnswerRequest": {
        "type": "object",
        "properties": {
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          }
        },
        "required": [
          "AnswerText",
          "ReadyForSubmission"
        ]
      },
      "AddDraftCommentRequest": {
        "type": "object",
        "properties": {
          "Comment": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "MentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        }
      },
      "DraftCommentResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "IsComplete": {
            "type": "boolean"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        }
      },
      "SetCommentCompletionRequest": {
        "type": "object",
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "IsComplete"
        ]
      }
    },
    "securitySchemes": {
      "RequireBidAccess": {
        "type": "http",
        "scheme": "bearer",
        "description": "Access token required to access bid-related endpoints."
      }
    }
  }
}
