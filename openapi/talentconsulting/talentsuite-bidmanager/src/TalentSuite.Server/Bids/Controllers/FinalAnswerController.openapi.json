{
  "openapi": "3.1.0",
  "info": {
    "title": "Final Answer API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/final-answer": {
      "get": {
        "summary": "Get the final answer",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalAnswerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Answer not found"
          }
        }
      },
      "put": {
        "summary": "Update the final answer",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFinalAnswerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response"
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments": {
      "post": {
        "summary": "Add a draft comment",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments/{commentId}": {
      "patch": {
        "summary": "Set comment completion status",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FinalAnswerResponse": {
        "type": "object",
        "properties": {
          "QuestionId": {
            "type": "string"
          },
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          },
          "Comments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftCommentResponse"
            }
          }
        }
      },
      "UpdateFinalAnswerRequest": {
        "type": "object",
        "properties": {
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          }
        }
      },
      "AddDraftCommentRequest": {
        "type": "object",
        "properties": {
          "Comment": {
            "type": "string"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "MentionedUserIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        }
      },
      "DraftCommentResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "IsComplete": {
            "type": "boolean"
          },
          "UserId": {
            "type": "string"
          },
          "AuthorName": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "StartIndex": {
            "type": "integer",
            "nullable": true
          },
          "EndIndex": {
            "type": "integer",
            "nullable": true
          },
          "SelectedText": {
            "type": "string"
          }
        }
      },
      "SetCommentCompletionRequest": {
        "type": "object",
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
