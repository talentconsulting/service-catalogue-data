{
  "openapi": "3.1.0",
  "info": {
    "title": "Bid User API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/bids/{bidId}/users": {
      "get": {
        "summary": "Get users assigned to a bid",
        "description": "Retrieve the list of users assigned to the specified bid.",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "RequireBidAccess": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of bid users retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/BidUserResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a user to a bid",
        "description": "Assign a user to the specified bid.",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAssignmentRequest"
              }
            }
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ],
        "responses": {
          "200": {
            "description": "User added to the bid successfully."
          },
          "400": {
            "description": "Bad request due to invalid input."
          }
        }
      },
      "delete": {
        "summary": "Remove a user from a bid",
        "description": "Unassign a user from the specified bid.",
        "parameters": [
          {
            "name": "bidId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAssignmentRequest"
              }
            }
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ],
        "responses": {
          "200": {
            "description": "User removed from the bid successfully."
          },
          "400": {
            "description": "Bad request due to invalid input."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Email": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          },
          "IdentityProvider": {
            "type": "string"
          },
          "IdentitySubject": {
            "type": "string"
          },
          "IdentityUsername": {
            "type": "string"
          },
          "InvitationToken": {
            "type": "string"
          },
          "InvitationExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "BidUserResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          }
        }
      },
      "UserAssignmentRequest": {
        "type": "object",
        "properties": {
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "UserId"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "Admin",
          "BidManager",
          "User"
        ]
      }
    }
  }
}
