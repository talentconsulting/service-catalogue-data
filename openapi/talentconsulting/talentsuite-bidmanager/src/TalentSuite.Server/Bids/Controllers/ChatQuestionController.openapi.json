{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Bid Manager - Chat Questions API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/ai/questions/{questionId}": {
      "post": {
        "summary": "Ask questions about a bid",
        "operationId": "AskQuestions",
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatQuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatQuestionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/ai/questions/{questionId}/messages": {
      "get": {
        "summary": "Get messages for a specific bid question",
        "operationId": "GetMessages",
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bidId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatMessageResponse"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/ai/questions/{questionId}/stream": {
      "post": {
        "summary": "Stream answers for a bid question",
        "operationId": "StreamQuestion",
        "parameters": [
          {
            "name": "questionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatQuestionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Streaming successful",
            "content": {
              "application/x-ndjson": {
                "schema": {
                  "$ref": "#/components/schemas/ChatStreamUpdate"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatQuestionRequest": {
        "type": "object",
        "properties": {
          "BidId": {
            "type": "string"
          },
          "QuestionId": {
            "type": "string"
          },
          "FreeTextQuestion": {
            "type": "string"
          },
          "ThreadId": {
            "type": "string",
            "nullable": true
          },
          "BidFileIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "BidId",
          "QuestionId",
          "FreeTextQuestion"
        ]
      },
      "ChatQuestionResponse": {
        "type": "object",
        "properties": {
          "Response": {
            "type": "string"
          },
          "ThreadId": {
            "type": "string"
          },
          "Sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatSourceReferenceResponse"
            }
          },
          "UsedSourcesOutsideBidLibrary": {
            "type": "boolean"
          }
        }
      },
      "ChatMessageResponse": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string"
          },
          "Role": {
            "type": "string"
          },
          "Content": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "Sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatSourceReferenceResponse"
            }
          },
          "UsedSourcesOutsideBidLibrary": {
            "type": "boolean"
          }
        }
      },
      "ChatSourceReferenceResponse": {
        "type": "object",
        "properties": {
          "Kind": {
            "type": "string"
          },
          "FileId": {
            "type": "string",
            "nullable": true
          },
          "FileName": {
            "type": "string",
            "nullable": true
          },
          "Uri": {
            "type": "string",
            "nullable": true
          },
          "Title": {
            "type": "string",
            "nullable": true
          },
          "Quote": {
            "type": "string",
            "nullable": true
          },
          "IsFromBidLibrary": {
            "type": "boolean"
          }
        }
      },
      "ChatStreamUpdate": {
        "type": "object",
        "properties": {
          "Type": {
            "type": "string"
          },
          "ThreadId": {
            "type": "string",
            "nullable": true
          },
          "Content": {
            "type": "string",
            "nullable": true
          },
          "Sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatSourceReferenceResponse"
            }
          },
          "UsedSourcesOutsideBidLibrary": {
            "type": "boolean"
          },
          "Error": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
