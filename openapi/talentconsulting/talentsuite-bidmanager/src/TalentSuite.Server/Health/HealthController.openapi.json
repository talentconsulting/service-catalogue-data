{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Health API",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "GetHealthStatus",
        "summary": "Get the health status of the application",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Application is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Application is not healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthCheckResult": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "description": "The name of the health check probe"
          },
          "Success": {
            "type": "boolean",
            "description": "Indicates if the probe succeeded"
          },
          "Description": {
            "type": "string",
            "description": "Additional information about the health check result"
          }
        },
        "required": [
          "Name",
          "Success",
          "Description"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean",
            "description": "Indicates if all health checks are successful"
          },
          "Checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheckResult"
            },
            "description": "List of individual health check results"
          }
        },
        "required": [
          "Success",
          "Checks"
        ]
      }
    }
  }
}
