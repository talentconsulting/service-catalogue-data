{
  "openapi": "3.1.0",
  "info": {
    "title": "TalentSuite Bid Manager API",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "redirectToHealth",
        "summary": "Redirects to health endpoint",
        "responses": {
          "302": {
            "description": "Redirects to /health"
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Performs a health check",
        "responses": {
          "200": {
            "description": "Health check successful"
          },
          "500": {
            "description": "Health check failed"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {}
  }
}
