{
  "components": {
    "schemas": {
      "AddDraftCommentRequest": {
        "properties": {
          "AuthorName": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "EndIndex": {
            "nullable": true,
            "type": "integer"
          },
          "MentionedUserIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "SelectedText": {
            "type": "string"
          },
          "StartIndex": {
            "nullable": true,
            "type": "integer"
          },
          "UserId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreateAssetResponse": {
        "additionalProperties": true,
        "type": "object"
      },
      "DraftCommentResponse": {
        "additionalProperties": true,
        "type": "object"
      },
      "DraftRequest": {
        "properties": {
          "Response": {
            "type": "string"
          }
        },
        "required": [
          "Response"
        ],
        "type": "object"
      },
      "DraftResponse": {
        "additionalProperties": true,
        "type": "object"
      },
      "SetCommentCompletionRequest": {
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "IsComplete"
        ],
        "type": "object"
      },
      "UpdateDraftRequest": {
        "properties": {
          "Id": {
            "type": "string"
          },
          "Response": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Response"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TalentSuite Bid Manager Draft Responses API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/drafts": {
      "delete": {
        "operationId": "removeResponse",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "responseId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Draft response removed successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "summary": "Remove a draft response"
      },
      "get": {
        "operationId": "getAllResponses",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DraftResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of all draft responses"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "summary": "Get all draft responses for a question"
      },
      "post": {
        "operationId": "addResponse",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateAssetResponse"
                }
              }
            },
            "description": "Draft response added successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "summary": "Add a new draft response"
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}": {
      "put": {
        "operationId": "updateResponse",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "draftId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraftRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Draft response updated successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "summary": "Update a draft response"
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}/comments": {
      "get": {
        "operationId": "getComments",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "draftId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DraftCommentResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of all comments for the draft"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "summary": "Get all comments for a draft response"
      },
      "post": {
        "operationId": "addComment",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "draftId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            },
            "description": "Comment added successfully"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "summary": "Add a comment to a draft response"
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/drafts/{draftId}/comments/{commentId}": {
      "patch": {
        "operationId": "setCommentCompletion",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "draftId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "commentId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Comment completion status updated"
          },
          "400": {
            "description": "Invalid request"
          }
        },
        "summary": "Set a draft comment's completion status"
      }
    }
  }
}
