{
  "components": {
    "schemas": {
      "AddDraftCommentRequest": {
        "properties": {
          "AuthorName": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "EndIndex": {
            "nullable": true,
            "type": "integer"
          },
          "MentionedUserIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "SelectedText": {
            "type": "string"
          },
          "StartIndex": {
            "nullable": true,
            "type": "integer"
          },
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "Comment",
          "UserId",
          "AuthorName"
        ],
        "type": "object"
      },
      "DraftCommentResponse": {
        "properties": {
          "AuthorName": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "format": "date-time",
            "type": "string"
          },
          "EndIndex": {
            "nullable": true,
            "type": "integer"
          },
          "Id": {
            "type": "string"
          },
          "IsComplete": {
            "type": "boolean"
          },
          "SelectedText": {
            "type": "string"
          },
          "StartIndex": {
            "nullable": true,
            "type": "integer"
          },
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Comment",
          "IsComplete",
          "UserId",
          "AuthorName",
          "CreatedAtUtc"
        ],
        "type": "object"
      },
      "FinalAnswerResponse": {
        "properties": {
          "AnswerText": {
            "type": "string"
          },
          "Comments": {
            "items": {
              "$ref": "#/components/schemas/DraftCommentResponse"
            },
            "type": "array"
          },
          "QuestionId": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          }
        },
        "required": [
          "QuestionId",
          "AnswerText",
          "ReadyForSubmission",
          "Comments"
        ],
        "type": "object"
      },
      "SetCommentCompletionRequest": {
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "required": [
          "IsComplete"
        ],
        "type": "object"
      },
      "UpdateFinalAnswerRequest": {
        "properties": {
          "AnswerText": {
            "type": "string"
          },
          "ReadyForSubmission": {
            "type": "boolean"
          }
        },
        "required": [
          "AnswerText",
          "ReadyForSubmission"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "FinalAnswer API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/final-answer": {
      "get": {
        "operationId": "getFinalAnswer",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinalAnswerResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "Not Found"
          }
        },
        "summary": "Get Final Answer"
      },
      "put": {
        "operationId": "setFinalAnswer",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFinalAnswerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "summary": "Set Final Answer"
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments": {
      "post": {
        "operationId": "addFinalAnswerComment",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "summary": "Add Final Answer Comment"
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/final-answer/comments/{commentId}": {
      "patch": {
        "operationId": "setCommentCompletion",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "commentId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "summary": "Set Comment Completion"
      }
    }
  }
}
