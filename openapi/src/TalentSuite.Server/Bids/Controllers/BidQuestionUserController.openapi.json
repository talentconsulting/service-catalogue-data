{
  "components": {
    "schemas": {
      "BidUserResponse": {
        "properties": {
          "Id": {
            "description": "ID of the user.",
            "type": "string"
          },
          "Name": {
            "description": "Name of the user.",
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Name"
        ],
        "type": "object"
      },
      "QuestionUserAssignmentRequest": {
        "properties": {
          "Role": {
            "$ref": "#/components/schemas/QuestionUserRole"
          },
          "UserId": {
            "description": "ID of the user to assign.",
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "Role"
        ],
        "type": "object"
      },
      "QuestionUserRole": {
        "enum": [
          "Owner",
          "Reviewer",
          "Support"
        ],
        "type": "string"
      },
      "UserAssignmentRequest": {
        "properties": {
          "UserId": {
            "description": "ID of the user to remove.",
            "type": "string"
          }
        },
        "required": [
          "UserId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/auth",
            "scopes": {
              "RequireBidAccess": "Access to bid-related information.",
              "RequireBidManagementRole": "Management role required for modifying bid users."
            },
            "tokenUrl": "https://example.com/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Bid Question User Management API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/users": {
      "delete": {
        "operationId": "RemoveBidUser",
        "parameters": [
          {
            "description": "ID of the bid.",
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ID of the question.",
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAssignmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User successfully removed."
          },
          "400": {
            "description": "Invalid input."
          }
        },
        "security": [
          {
            "OAuth2": [
              "RequireBidManagementRole"
            ]
          }
        ],
        "summary": "Remove a user from a bid question."
      },
      "get": {
        "operationId": "GetQuestionUsers",
        "parameters": [
          {
            "description": "ID of the bid.",
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ID of the question.",
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BidUserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "List of users assigned to the question."
          }
        },
        "security": [
          {
            "OAuth2": [
              "RequireBidAccess"
            ]
          }
        ],
        "summary": "Retrieve users assigned to a bid question."
      },
      "post": {
        "operationId": "AddBidUser",
        "parameters": [
          {
            "description": "ID of the bid.",
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ID of the question.",
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionUserAssignmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User successfully assigned."
          },
          "400": {
            "description": "Invalid input."
          }
        },
        "security": [
          {
            "OAuth2": [
              "RequireBidManagementRole"
            ]
          }
        ],
        "summary": "Assign a user to a bid question."
      },
      "put": {
        "operationId": "UpdateBidUserRole",
        "parameters": [
          {
            "description": "ID of the bid.",
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "ID of the question.",
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionUserAssignmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Role successfully updated."
          },
          "400": {
            "description": "Invalid input."
          }
        },
        "security": [
          {
            "OAuth2": [
              "RequireBidManagementRole"
            ]
          }
        ],
        "summary": "Update role of a user assigned to a bid question."
      }
    }
  }
}
