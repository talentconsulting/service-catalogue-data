{
  "components": {
    "schemas": {
      "BidUserResponse": {
        "properties": {
          "Id": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          }
        },
        "required": [
          "Id",
          "Name"
        ],
        "type": "object"
      },
      "QuestionUserAssignmentRequest": {
        "properties": {
          "Role": {
            "$ref": "#/components/schemas/QuestionUserRole"
          },
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "UserId",
          "Role"
        ],
        "type": "object"
      },
      "QuestionUserRole": {
        "enum": [
          "Owner",
          "Reviewer",
          "Support"
        ],
        "type": "string"
      },
      "UserAssignmentRequest": {
        "properties": {
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "UserId"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "RequireBidAccess": {
        "description": "Access control for viewing bid questions.",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/auth",
            "scopes": {
              "RequireBidAccess": "Access to bid questions"
            }
          }
        },
        "type": "oauth2"
      },
      "RequireBidManagementRole": {
        "description": "Access control for modifying bid question assignments.",
        "flows": {
          "implicit": {
            "authorizationUrl": "https://example.com/auth",
            "scopes": {
              "RequireBidManagementRole": "Management access for bid questions"
            }
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Bid Question User API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/users": {
      "delete": {
        "description": "Unassign a user from a specific question in a bid.",
        "operationId": "RemoveBidUser",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserAssignmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ],
        "summary": "Remove User from Bid Question"
      },
      "get": {
        "description": "Retrieve the list of users assigned to a specific question in a bid.",
        "operationId": "GetQuestionUsers",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BidUserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Success"
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ],
        "summary": "Get Users Assigned to a Bid Question"
      },
      "post": {
        "description": "Add a user with a role to a specific question in a bid.",
        "operationId": "AddBidUser",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionUserAssignmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ],
        "summary": "Assign a User to a Bid Question"
      },
      "put": {
        "description": "Update the role of an assigned user in a specific question in a bid.",
        "operationId": "UpdateBidUserRole",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionUserAssignmentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "RequireBidManagementRole": []
          }
        ],
        "summary": "Update User Role in Bid Question"
      }
    }
  }
}
