{
  "components": {
    "schemas": {
      "AddDraftCommentRequest": {
        "properties": {
          "AuthorName": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "EndIndex": {
            "nullable": true,
            "type": "integer"
          },
          "MentionedUserIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "SelectedText": {
            "type": "string"
          },
          "StartIndex": {
            "nullable": true,
            "type": "integer"
          },
          "UserId": {
            "type": "string"
          }
        },
        "required": [
          "Comment",
          "UserId",
          "AuthorName"
        ],
        "type": "object"
      },
      "DraftCommentResponse": {
        "properties": {
          "AuthorName": {
            "type": "string"
          },
          "Comment": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "format": "date-time",
            "type": "string"
          },
          "EndIndex": {
            "nullable": true,
            "type": "integer"
          },
          "Id": {
            "type": "string"
          },
          "IsComplete": {
            "type": "boolean"
          },
          "SelectedText": {
            "type": "string"
          },
          "StartIndex": {
            "nullable": true,
            "type": "integer"
          },
          "UserId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RedReviewResponse": {
        "properties": {
          "Comments": {
            "items": {
              "$ref": "#/components/schemas/DraftCommentResponse"
            },
            "type": "array"
          },
          "QuestionId": {
            "type": "string"
          },
          "ResultText": {
            "type": "string"
          },
          "Reviewers": {
            "items": {
              "$ref": "#/components/schemas/RedReviewReviewerResponse"
            },
            "type": "array"
          },
          "State": {
            "$ref": "#/components/schemas/RedReviewState"
          }
        },
        "type": "object"
      },
      "RedReviewReviewerResponse": {
        "properties": {
          "State": {
            "$ref": "#/components/schemas/RedReviewState"
          },
          "UserId": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RedReviewState": {
        "enum": [
          "Pending",
          "ChangesRequested",
          "Complete"
        ],
        "type": "string"
      },
      "SetCommentCompletionRequest": {
        "properties": {
          "IsComplete": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "UpdateRedReviewRequest": {
        "properties": {
          "ResultText": {
            "type": "string"
          },
          "Reviewers": {
            "items": {
              "$ref": "#/components/schemas/RedReviewReviewerResponse"
            },
            "type": "array"
          },
          "State": {
            "$ref": "#/components/schemas/RedReviewState"
          }
        },
        "required": [
          "ResultText",
          "State"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "RequireBidAccess": {
        "in": "header",
        "name": "Authorization",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "title": "Red Review API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bids/{bidId}/questions/{questionId}/red-review": {
      "get": {
        "operationId": "GetRedReview",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedReviewResponse"
                }
              }
            },
            "description": "Red review details retrieved successfully"
          },
          "404": {
            "description": "Red review not found"
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ],
        "summary": "Get Red Review"
      },
      "put": {
        "operationId": "UpdateRedReview",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateRedReviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Red review updated successfully"
          },
          "400": {
            "description": "Invalid request body"
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ],
        "summary": "Update Red Review"
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/red-review/comments": {
      "post": {
        "operationId": "AddRedReviewComment",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddDraftCommentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            },
            "description": "Comment added successfully"
          },
          "400": {
            "description": "Invalid request body or comment is empty"
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ],
        "summary": "Add Comment to Red Review"
      }
    },
    "/api/bids/{bidId}/questions/{questionId}/red-review/comments/{commentId}": {
      "patch": {
        "operationId": "SetRedReviewCommentCompletion",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "commentId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetCommentCompletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftCommentResponse"
                }
              }
            },
            "description": "Comment completion status updated successfully"
          },
          "400": {
            "description": "Invalid request body or comment ID is missing"
          }
        },
        "security": [
          {
            "RequireBidAccess": []
          }
        ],
        "summary": "Set Comment Completion"
      }
    }
  }
}
