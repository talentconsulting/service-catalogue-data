{
  "components": {
    "schemas": {
      "ChatMessageResponse": {
        "properties": {
          "Content": {
            "type": "string"
          },
          "CreatedAtUtc": {
            "format": "date-time",
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "Role": {
            "type": "string"
          },
          "Sources": {
            "items": {
              "$ref": "#/components/schemas/ChatSourceReferenceResponse"
            },
            "type": "array"
          },
          "UsedSourcesOutsideBidLibrary": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ChatQuestionRequest": {
        "properties": {
          "BidFileIds": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "BidId": {
            "type": "string"
          },
          "FreeTextQuestion": {
            "type": "string"
          },
          "QuestionId": {
            "type": "string"
          },
          "ThreadId": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "BidId",
          "QuestionId",
          "FreeTextQuestion",
          "BidFileIds"
        ],
        "type": "object"
      },
      "ChatQuestionResponse": {
        "properties": {
          "Response": {
            "type": "string"
          },
          "Sources": {
            "items": {
              "$ref": "#/components/schemas/ChatSourceReferenceResponse"
            },
            "type": "array"
          },
          "ThreadId": {
            "type": "string"
          },
          "UsedSourcesOutsideBidLibrary": {
            "type": "boolean"
          }
        },
        "type": "object"
      },
      "ChatSourceReferenceResponse": {
        "properties": {
          "FileId": {
            "nullable": true,
            "type": "string"
          },
          "FileName": {
            "nullable": true,
            "type": "string"
          },
          "IsFromBidLibrary": {
            "type": "boolean"
          },
          "Kind": {
            "type": "string"
          },
          "Quote": {
            "nullable": true,
            "type": "string"
          },
          "Title": {
            "nullable": true,
            "type": "string"
          },
          "Uri": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ChatQuestion API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/ai/questions/{questionId}": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatQuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatQuestionResponse"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Server Error"
          }
        },
        "summary": "Ask questions for a specific bid"
      }
    },
    "/api/ai/questions/{questionId}/messages": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ChatMessageResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "description": "Bad Request"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "summary": "Get chat messages for a specific question"
      }
    },
    "/api/ai/questions/{questionId}/stream": {
      "post": {
        "parameters": [
          {
            "in": "path",
            "name": "questionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatQuestionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Streaming started"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "summary": "Stream chat updates for a question"
      }
    }
  }
}
