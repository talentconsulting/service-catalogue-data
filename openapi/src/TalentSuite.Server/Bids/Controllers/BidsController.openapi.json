{
  "components": {
    "schemas": {
      "BidFileResponse": {
        "properties": {
          "BidId": {
            "type": "string"
          },
          "ContentType": {
            "type": "string"
          },
          "FileName": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "SizeBytes": {
            "type": "integer"
          },
          "UploadedAtUtc": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BidLibraryPushResponse": {
        "properties": {
          "BidId": {
            "type": "string"
          },
          "PerformedByName": {
            "type": "string"
          },
          "PerformedByUserId": {
            "type": "string"
          },
          "PushedAtUtc": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BidListItemResponse": {
        "properties": {
          "Company": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "OwnerId": {
            "type": "string"
          },
          "QuestionCount": {
            "type": "integer"
          },
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          },
          "Summary": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "BidResponse": {
        "properties": {
          "Budget": {
            "type": "string"
          },
          "Company": {
            "type": "string"
          },
          "DeadlineForQualifying": {
            "type": "string"
          },
          "DeadlineForSubmission": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "KeyInformation": {
            "type": "string"
          },
          "LengthOfContract": {
            "type": "string"
          },
          "Questions": {
            "items": {
              "$ref": "#/components/schemas/QuestionResponse"
            },
            "type": "array"
          },
          "Stage": {
            "$ref": "#/components/schemas/BidStage"
          },
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          },
          "Summary": {
            "type": "string"
          },
          "UniqueReference": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "BidStage": {
        "enum": [
          "Stage1",
          "Stage2"
        ],
        "type": "string"
      },
      "BidStatus": {
        "enum": [
          "Underway",
          "Cancelled",
          "Submitted",
          "Won",
          "Lost"
        ],
        "type": "string"
      },
      "CreateBidRequest": {
        "properties": {
          "Budget": {
            "type": "string"
          },
          "Company": {
            "type": "string"
          },
          "DeadlineForQualifying": {
            "type": "string"
          },
          "DeadlineForSubmission": {
            "type": "string"
          },
          "KeyInformation": {
            "type": "string"
          },
          "LengthOfContract": {
            "type": "string"
          },
          "Questions": {
            "items": {
              "$ref": "#/components/schemas/CreateQuestionRequest"
            },
            "type": "array"
          },
          "Stage": {
            "$ref": "#/components/schemas/BidStage"
          },
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          },
          "Summary": {
            "type": "string"
          },
          "UniqueReference": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreateQuestionRequest": {
        "properties": {
          "Category": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Length": {
            "type": "string"
          },
          "NiceToHave": {
            "type": "boolean"
          },
          "Number": {
            "type": "string"
          },
          "QuestionOrderIndex": {
            "type": "integer"
          },
          "Required": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Weighting": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "PagedBidListResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PagedResult"
          }
        ],
        "type": "object"
      },
      "PagedResult": {
        "properties": {
          "CurrentPage": {
            "type": "integer"
          },
          "Items": {
            "items": {
              "$ref": "#/components/schemas/BidListItemResponse"
            },
            "type": "array"
          },
          "PageSize": {
            "type": "integer"
          },
          "TotalCount": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "ParsedQuestionResponse": {
        "properties": {
          "Category": {
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Length": {
            "type": "string"
          },
          "NiceToHave": {
            "type": "boolean"
          },
          "Number": {
            "type": "string"
          },
          "QuestionOrderIndex": {
            "type": "integer"
          },
          "Required": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Weighting": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "QuestionResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ParsedQuestionResponse"
          },
          {
            "properties": {
              "Id": {
                "type": "string"
              }
            },
            "type": "object"
          }
        ],
        "type": "object"
      },
      "UpdateBidOverviewRequest": {
        "properties": {
          "Budget": {
            "type": "string"
          },
          "DeadlineForQualifying": {
            "type": "string"
          },
          "DeadlineForSubmission": {
            "type": "string"
          },
          "KeyInformation": {
            "type": "string"
          },
          "LengthOfContract": {
            "type": "string"
          },
          "Summary": {
            "type": "string"
          },
          "UniqueReference": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateBidStatusRequest": {
        "properties": {
          "Status": {
            "$ref": "#/components/schemas/BidStatus"
          }
        },
        "type": "object"
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {},
            "tokenUrl": "https://example.com/oauth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "TalentSuite BidManager API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bids": {
      "get": {
        "operationId": "getBids",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "pageSize",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedBidListResponse"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Get a paginated list of bids"
      },
      "post": {
        "operationId": "createBid",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBidRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidResponse"
                }
              }
            },
            "description": "Bid created successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Create a new bid"
      }
    },
    "/api/bids/{bidId}": {
      "get": {
        "operationId": "getBid",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidResponse"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Bid not found"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Get bid by ID"
      }
    },
    "/api/bids/{bidId}/files": {
      "get": {
        "operationId": "getBidFiles",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/BidFileResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Successful operation"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Get files associated with bid"
      },
      "post": {
        "operationId": "uploadBidFile",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "format": "binary",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidFileResponse"
                }
              }
            },
            "description": "File uploaded successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Upload a file to a bid"
      }
    },
    "/api/bids/{bidId}/files/{fileId}": {
      "delete": {
        "operationId": "deleteBidFile",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "fileId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "File deleted successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "File not found"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Delete a file associated with bid"
      },
      "get": {
        "operationId": "downloadBidFile",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "fileId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {}
            },
            "description": "File download successful"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "File not found"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Download a file associated with bid"
      }
    },
    "/api/bids/{bidId}/library-push": {
      "post": {
        "operationId": "pushBidToLibrary",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidLibraryPushResponse"
                }
              }
            },
            "description": "Bid pushed to library successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Push bid to library"
      }
    },
    "/api/bids/{bidId}/overview": {
      "patch": {
        "operationId": "updateBidOverview",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBidOverviewRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Overview updated successfully"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Update bid overview"
      }
    },
    "/api/bids/{bidId}/status": {
      "patch": {
        "operationId": "updateBidStatus",
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBidStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Status updated successfully"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": []
          }
        ],
        "summary": "Update bid status"
      }
    }
  }
}
