{
  "components": {
    "schemas": {
      "CreateUserRequest": {
        "properties": {
          "Email": {
            "type": "string"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          },
          "Name": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": [
          "Name",
          "Email",
          "Role",
          "HasAcceptedRegistration"
        ],
        "type": "object"
      },
      "ResendInviteResponse": {
        "properties": {
          "InvitationExpiresAtUtc": {
            "format": "date-time",
            "type": "string"
          },
          "InvitationToken": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateUserRequest": {
        "properties": {
          "Email": {
            "type": "string"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          },
          "Name": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": [
          "Name",
          "Email",
          "Role",
          "HasAcceptedRegistration"
        ],
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "Email": {
            "type": "string"
          },
          "HasAcceptedRegistration": {
            "type": "boolean"
          },
          "Id": {
            "type": "string"
          },
          "IdentityProvider": {
            "type": "string"
          },
          "IdentitySubject": {
            "type": "string"
          },
          "IdentityUsername": {
            "type": "string"
          },
          "InvitationExpiresAtUtc": {
            "format": "date-time",
            "type": "string"
          },
          "InvitationToken": {
            "type": "string"
          },
          "Name": {
            "type": "string"
          },
          "Role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "type": "object"
      },
      "UserRole": {
        "enum": [
          "Admin",
          "BidManager",
          "User"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "OAuth2": {
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://example.com/oauth/authorize",
            "scopes": {
              "RequireAdminRole": "Access endpoints requiring Admin role",
              "RequireBidManagerOrAdminRole": "Access endpoints requiring Bid Manager or Admin role"
            },
            "tokenUrl": "https://example.com/oauth/token"
          }
        },
        "type": "oauth2"
      }
    }
  },
  "info": {
    "title": "Users API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/users": {
      "get": {
        "operationId": "GetUsers",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserResponse"
                  },
                  "type": "array"
                }
              }
            },
            "description": "A list of users."
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "OAuth2": [
              "RequireBidManagerOrAdminRole"
            ]
          }
        ],
        "summary": "Get a list of users."
      },
      "post": {
        "operationId": "AddUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "User successfully created."
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "security": [
          {
            "OAuth2": [
              "RequireAdminRole"
            ]
          }
        ],
        "summary": "Add a new user."
      }
    },
    "/api/users/{userId}": {
      "delete": {
        "operationId": "DeleteUser",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "User successfully deleted."
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "summary": "Delete a user."
      },
      "get": {
        "operationId": "GetUser",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "User found."
          },
          "404": {
            "description": "User not found."
          }
        },
        "summary": "Retrieve a user by ID."
      },
      "put": {
        "operationId": "UpdateUser",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "User successfully updated."
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "User not found."
          }
        },
        "summary": "Update an existing user."
      }
    },
    "/api/users/{userId}/resend-invite": {
      "post": {
        "operationId": "ResendInvite",
        "parameters": [
          {
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResendInviteResponse"
                }
              }
            },
            "description": "Invite successfully resent."
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "summary": "Resend an invite to a user."
      }
    }
  }
}
