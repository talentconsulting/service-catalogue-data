{
  "components": {
    "schemas": {
      "AcceptInviteRequest": {
        "properties": {
          "InvitationToken": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "BidLibraryPushResponse": {
        "properties": {
          "BidId": {
            "type": "string"
          },
          "PerformedByName": {
            "type": "string"
          },
          "PerformedByUserId": {
            "type": "string"
          },
          "PushedAtUtc": {
            "format": "date-time",
            "type": "string"
          }
        },
        "type": "object"
      },
      "BidManageModel": {
        "properties": {
          "BidLibraryPush": {
            "$ref": "#/components/schemas/BidLibraryPushResponse"
          },
          "Budget": {
            "nullable": true,
            "type": "string"
          },
          "Company": {
            "type": "string"
          },
          "DeadlineForQualifying": {
            "nullable": true,
            "type": "string"
          },
          "DeadlineForSubmission": {
            "nullable": true,
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "KeyInformation": {
            "nullable": true,
            "type": "string"
          },
          "LengthOfContract": {
            "nullable": true,
            "type": "string"
          },
          "Questions": {
            "items": {
              "$ref": "#/components/schemas/BidQuestionModel"
            },
            "type": "array"
          },
          "Stage": {
            "enum": [
              "Stage1",
              "Stage2"
            ],
            "type": "string"
          },
          "Status": {
            "enum": [
              "Underway",
              "Cancelled",
              "Submitted",
              "Won",
              "Lost"
            ],
            "type": "string"
          },
          "Summary": {
            "nullable": true,
            "type": "string"
          },
          "Title": {
            "type": "string"
          },
          "UniqueReference": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "BidQuestionModel": {
        "properties": {
          "Category": {
            "nullable": true,
            "type": "string"
          },
          "Description": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          },
          "Length": {
            "type": "string"
          },
          "NiceToHave": {
            "type": "boolean"
          },
          "Number": {
            "type": "string"
          },
          "QuestionOrderIndex": {
            "type": "integer"
          },
          "Required": {
            "type": "boolean"
          },
          "Title": {
            "type": "string"
          },
          "Weighting": {
            "type": "integer"
          }
        },
        "type": "object"
      },
      "InviteValidationResponse": {
        "properties": {
          "Status": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RegisterInviteRequest": {
        "properties": {
          "InvitationToken": {
            "type": "string"
          },
          "Password": {
            "type": "string"
          },
          "Username": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "RuntimeAuthResponse": {
        "properties": {
          "KeycloakAuthority": {
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "UpdateBidStatusRequest": {
        "properties": {
          "Status": {
            "enum": [
              "Underway",
              "Cancelled",
              "Submitted",
              "Won",
              "Lost"
            ],
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "TalentSuite API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/bids/{bidId}": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BidManageModel"
                }
              }
            },
            "description": "Bid details retrieved."
          }
        },
        "summary": "Retrieve bid details.",
        "tags": [
          "BidManagement"
        ]
      }
    },
    "/api/bids/{bidId}/status": {
      "patch": {
        "parameters": [
          {
            "in": "path",
            "name": "bidId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBidStatusRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Bid status updated."
          },
          "default": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to update bid status."
          }
        },
        "summary": "Update bid status.",
        "tags": [
          "BidManagement"
        ]
      }
    },
    "/api/runtime/auth": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RuntimeAuthResponse"
                }
              }
            },
            "description": "Runtime authentication configuration successfully retrieved."
          }
        },
        "summary": "Retrieve runtime authentication configuration.",
        "tags": [
          "RuntimeAuth"
        ]
      }
    },
    "/api/users/accept-invite": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Invitation accepted."
          },
          "default": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to accept invite."
          }
        },
        "summary": "Accept invitation.",
        "tags": [
          "Invite"
        ]
      }
    },
    "/api/users/accept-invite/register": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInviteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User successfully registered."
          },
          "default": {
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Failed to register user."
          }
        },
        "summary": "Register user via invitation.",
        "tags": [
          "Invite"
        ]
      }
    },
    "/api/users/accept-invite/validate": {
      "get": {
        "parameters": [
          {
            "in": "query",
            "name": "token",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteValidationResponse"
                }
              }
            },
            "description": "Token validated."
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Token invalid or expired."
          }
        },
        "summary": "Validate invitation token.",
        "tags": [
          "Invite"
        ]
      }
    }
  }
}
