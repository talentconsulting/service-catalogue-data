{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user-actions/{userActionId}/admin-actions": {
      "post": {
        "operationId": "CreateAdminAction",
        "summary": "Create an admin action for a user action.",
        "parameters": [
          {
            "name": "userActionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The id of the user action."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminActionRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/api/user-actions/{code}": {
      "get": {
        "operationId": "GetUserActionByCode",
        "summary": "Retrieve a user action by its code.",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The code of the user action."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAdminActionRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "The username performing the admin action."
          },
          "action": {
            "type": "string",
            "enum": [
              "Viewed",
              "Unlocked"
            ],
            "description": "The type of admin action."
          }
        },
        "required": [
          "username",
          "action"
        ]
      },
      "GetUserActionByCodeResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "The ID of the user action."
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the user."
          },
          "actionType": {
            "type": "string",
            "enum": [
              "Reprint",
              "Help",
              "Contact",
              "NotMatched",
              "NotFound"
            ],
            "description": "The type of the user action."
          },
          "actionTime": {
            "type": "string",
            "format": "date-time",
            "description": "The time the action occurred."
          },
          "actionStatus": {
            "type": "string",
            "enum": [
              "New",
              "Viewed"
            ],
            "description": "The status of the user action."
          },
          "familyName": {
            "type": "string",
            "description": "The family name associated with the user action."
          },
          "givenNames": {
            "type": "string",
            "description": "The given names associated with the user action."
          },
          "certificateId": {
            "type": "string",
            "format": "uuid",
            "description": "The ID of the certificate related to the user action."
          },
          "certificateType": {
            "type": "string",
            "enum": [
              "Unknown",
              "Standard",
              "Framework"
            ],
            "description": "The type of certificate associated with the user action."
          },
          "courseName": {
            "type": "string",
            "description": "The name of the course associated with the user action."
          },
          "adminActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminActionResponse"
            },
            "description": "List of admin actions associated with the user action."
          },
          "uln": {
            "type": "integer",
            "format": "int64",
            "description": "The unique learner number related to the user action."
          }
        },
        "required": [
          "id",
          "userId",
          "actionType",
          "actionTime",
          "actionStatus",
          "familyName",
          "givenNames"
        ]
      },
      "AdminActionResponse": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "The username associated with the admin action."
          },
          "actionTime": {
            "type": "string",
            "format": "date-time",
            "description": "The time the admin action occurred."
          },
          "action": {
            "type": "string",
            "enum": [
              "Viewed",
              "Unlocked"
            ],
            "description": "The type of admin action."
          }
        },
        "required": [
          "username",
          "actionTime",
          "action"
        ]
      }
    }
  }
}
