{
  "openapi": "3.1.0",
  "info": {
    "title": "Digital Certificates API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/user-actions/{userActionId}/admin-actions": {
      "post": {
        "operationId": "CreateAdminAction",
        "summary": "Create an admin action for a user action",
        "parameters": [
          {
            "name": "userActionId",
            "in": "path",
            "required": true,
            "description": "The ID of the user action",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdminActionRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/user-actions/{code}": {
      "get": {
        "operationId": "GetUserActionByCode",
        "summary": "Retrieve a user action by its unique code",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "The unique code of the user action",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User action retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetUserActionByCodeResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateAdminActionRequest": {
        "type": "object",
        "required": [
          "Username",
          "Action"
        ],
        "properties": {
          "Username": {
            "type": "string"
          },
          "Action": {
            "type": "string",
            "enum": [
              "Viewed",
              "Unlocked"
            ]
          }
        }
      },
      "GetUserActionByCodeResponse": {
        "type": "object",
        "required": [
          "Id",
          "UserId",
          "ActionType",
          "ActionTime",
          "ActionStatus",
          "FamilyName",
          "GivenNames"
        ],
        "properties": {
          "Id": {
            "type": "integer",
            "format": "int64"
          },
          "UserId": {
            "type": "string",
            "format": "uuid"
          },
          "ActionType": {
            "type": "string",
            "enum": [
              "Reprint",
              "Help",
              "Contact",
              "NotMatched",
              "NotFound"
            ]
          },
          "ActionTime": {
            "type": "string",
            "format": "date-time"
          },
          "ActionStatus": {
            "type": "string",
            "enum": [
              "New",
              "Viewed"
            ]
          },
          "FamilyName": {
            "type": "string"
          },
          "GivenNames": {
            "type": "string"
          },
          "CertificateId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "CertificateType": {
            "type": "string",
            "enum": [
              "Unknown",
              "Standard",
              "Framework"
            ],
            "nullable": true
          },
          "CourseName": {
            "type": "string",
            "nullable": true
          },
          "Uln": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "AdminActions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AdminActionResponse"
            },
            "nullable": true
          }
        }
      },
      "AdminActionResponse": {
        "type": "object",
        "required": [
          "Username",
          "ActionTime",
          "Action"
        ],
        "properties": {
          "Username": {
            "type": "string"
          },
          "ActionTime": {
            "type": "string",
            "format": "date-time"
          },
          "Action": {
            "type": "string",
            "enum": [
              "Viewed",
              "Unlocked"
            ]
          }
        }
      }
    }
  }
}
