  "components": {
    "schemas": {
      "CreateSharingRequest": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "$ref": "#/components/schemas/CertificateType"
          },
          "courseName": {
            "type": "string"
          }
        },
        "required": [
          "userId",
          "certificateId",
          "certificateType",
          "courseName"
        ]
      },
      "CreateSharingResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "$ref": "#/components/schemas/CertificateType"
          },
          "courseName": {
            "type": "string"
          },
          "sharingId": {
            "type": "string",
            "format": "uuid"
          },
          "sharingNumber": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "linkCode": {
            "type": "string",
            "format": "uuid"
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateSharingEmailRequest": {
        "type": "object",
        "properties": {
          "emailAddress": {
            "type": "string"
          }
        },
        "required": [
          "emailAddress"
        ]
      },
      "CreateSharingEmailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "emailLinkCode": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateSharingAccessRequest": {
        "type": "object",
        "properties": {
          "sharingId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "sharingId"
        ]
      },
      "CreateSharingEmailAccessRequest": {
        "type": "object",
        "properties": {
          "sharingEmailId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "sharingEmailId"
        ]
      },
      "GetSharingByEmailLinkCodeResponse": {
        "type": "object",
        "properties": {
          "sharingEmailId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "$ref": "#/components/schemas/CertificateType"
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GetSharingByIdResponse": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "$ref": "#/components/schemas/CertificateType"
          },
          "courseName": {
            "type": "string"
          },
          "sharingId": {
            "type": "string",
            "format": "uuid"
          },
          "sharingNumber": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "linkCode": {
            "type": "string",
            "format": "uuid"
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          },
          "sharingAccess": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          },
          "sharingEmails": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SharingEmailDetailGetById"
            }
          }
        }
      },
      "GetSharingByLinkCodeResponse": {
        "type": "object",
        "properties": {
          "sharingId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateId": {
            "type": "string",
            "format": "uuid"
          },
          "certificateType": {
            "$ref": "#/components/schemas/CertificateType"
          },
          "expiryTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SharingEmailDetailGetById": {
        "type": "object",
        "properties": {
          "sharingEmailId": {
            "type": "string",
            "format": "uuid"
          },
          "emailAddress": {
            "type": "string"
          },
          "emailLinkCode": {
            "type": "string",
            "format": "uuid"
          },
          "sentTime": {
            "type": "string",
            "format": "date-time"
          },
          "sharingEmailAccess": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      },
      "CertificateType": {
        "type": "string",
        "enum": [
          "Unknown",
          "Standard",
          "Framework"
        ]
      }
    }
  }
}
