@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_digital_certification_api, "Digital Certificates") {
  Container(c_digital_certificates, "Digital Certificates", "API")
}

System_Ext(d_cloud_service_azure_token_credentials, "Azure Token Credentials", "Azure.Identity")
SystemDb_Ext(d_database_application_database, "Application Database", "Microsoft.EntityFrameworkCore.SqlServer")

Rel(c_digital_certificates, d_cloud_service_azure_token_credentials, "Uses", "Azure.Identity")
Rel(c_digital_certificates, d_database_application_database, "Reads from and writes to", "Microsoft.EntityFrameworkCore.SqlServer")

@enduml
