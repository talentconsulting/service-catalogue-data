{
  "openapi": "3.1.0",
  "info": {
    "title": "ShortCourses API",
    "version": "1.0.0"
  },
  "paths": {
    "/shortCourses": {
      "post": {
        "summary": "Create unapproved short course learning",
        "operationId": "CreateUnapprovedShortCourseLearning",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnapprovedShortCourseLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/fm99/{learningKey}/shortCourses": {
      "get": {
        "summary": "Get FM99 short course earnings",
        "operationId": "GetFm99ShortCourseEarnings",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The learning key identifier"
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "Unique UKPRN number"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/shortCourses/{learningKey}/shortCourses/{episodeKey}/on-programme": {
      "put": {
        "summary": "Update short course on programme",
        "operationId": "UpdateShortCourseOnProgramme",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The learning key identifier"
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The episode key identifier"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShortCourseOnProgrammeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/shortCourses/{learningKey}/shortCourses/{episodeKey}": {
      "get": {
        "summary": "Get short course details",
        "operationId": "GetShortCourse",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The learning key identifier"
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The episode key identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "summary": "Remove short course learning",
        "operationId": "RemoveShortCourseLearning",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The learning key identifier"
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The episode key identifier"
          },
          {
            "name": "learnerKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The learner key identifier"
          },
          {
            "name": "learnerRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The learner reference"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUnapprovedShortCourseLearningRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "EpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/OnProgramme"
          }
        },
        "required": [
          "LearningKey",
          "EpisodeKey",
          "Learner",
          "LearningSupport",
          "OnProgramme"
        ]
      },
      "Learner": {
        "type": "object",
        "properties": {
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          }
        },
        "required": [
          "DateOfBirth",
          "Uln"
        ]
      },
      "OnProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Milestone"
            }
          },
          "TotalPrice": {
            "type": "number",
            "format": "decimal"
          }
        },
        "required": [
          "CourseCode",
          "Ukprn",
          "StartDate",
          "ExpectedEndDate",
          "Milestones",
          "TotalPrice"
        ]
      },
      "Milestone": {
        "type": "integer",
        "enum": [
          1,
          2
        ],
        "description": "Possible milestones: 1 for 30% learning complete, 2 for learning complete"
      },
      "LearningSupportItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "StartDate",
          "EndDate"
        ]
      },
      "UpdateShortCourseOnProgrammeRequest": {
        "type": "object",
        "properties": {
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Milestone"
            }
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "LearnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "LearnerRef": {
            "type": "string"
          }
        },
        "required": [
          "Milestones",
          "StartDate",
          "ExpectedEndDate",
          "LearnerKey",
          "LearnerRef"
        ]
      }
    }
  }
}
