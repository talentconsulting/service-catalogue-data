{
  "openapi": "3.1.0",
  "info": {
    "title": "ShortCourses API",
    "version": "1.0.0"
  },
  "paths": {
    "/shortCourses": {
      "post": {
        "summary": "Create unapproved short course learning",
        "operationId": "createUnapprovedShortCourseLearning",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnapprovedShortCourseLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation was successful."
          },
          "500": {
            "description": "An error occurred while processing the request."
          }
        }
      }
    },
    "/fm99/{learningKey}/shortCourses": {
      "get": {
        "summary": "Get FM99 short course earnings",
        "operationId": "getFm99ShortCourseEarnings",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation was successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "An error occurred while processing the request."
          }
        }
      }
    },
    "/{learningKey}/shortCourses/{episodeKey}/on-programme": {
      "put": {
        "summary": "Update on-programme details",
        "operationId": "updateOnProgramme",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShortCourseOnProgrammeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The operation was successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "An error occurred while processing the request."
          }
        }
      }
    },
    "/{learningKey}/shortCourses/{episodeKey}": {
      "get": {
        "summary": "Get short course details",
        "operationId": "getShortCourse",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation was successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "An error occurred while processing the request."
          }
        }
      },
      "delete": {
        "summary": "Remove short course learning",
        "operationId": "removeShortCourseLearning",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "learnerKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "learnerRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The operation was successful.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "500": {
            "description": "An error occurred while processing the request."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUnapprovedShortCourseLearningRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "EpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/OnProgramme"
          }
        }
      },
      "Learner": {
        "type": "object",
        "properties": {
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          }
        }
      },
      "OnProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Milestone"
            }
          },
          "TotalPrice": {
            "type": "number",
            "format": "decimal"
          }
        }
      },
      "Milestone": {
        "type": "integer",
        "enum": [
          1,
          2
        ],
        "description": "1 = ThirtyPercentLearningComplete, 2 = LearningComplete"
      },
      "LearningSupportItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateShortCourseOnProgrammeRequest": {
        "type": "object",
        "properties": {
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Milestones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Milestone"
            }
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "LearnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "LearnerRef": {
            "type": "string"
          }
        }
      }
    }
  }
}
