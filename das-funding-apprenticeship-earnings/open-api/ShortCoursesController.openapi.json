{
  "openapi": "3.1.0",
  "info": {
    "title": "ShortCourses API",
    "version": "1.0.0"
  },
  "paths": {
    "/shortCourses": {
      "post": {
        "summary": "Create Unapproved Short Course Learning",
        "operationId": "createUnapprovedShortCourseLearning",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnapprovedShortCourseLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created unapproved short course learning"
          },
          "500": {
            "description": "Error creating unapproved short course learning"
          }
        }
      }
    },
    "/fm99/{learningKey}/shortCourses": {
      "get": {
        "summary": "Get FM99 Short Course Earnings",
        "operationId": "getFm99ShortCourseEarnings",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "ukprn",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "collectionYear",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved short course earnings",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Error retrieving short course earnings"
          }
        }
      }
    },
    "/{learningKey}/shortCourses/{episodeKey}/on-programme": {
      "put": {
        "summary": "Update Short Course On Programme",
        "operationId": "updateShortCourseOnProgramme",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateShortCourseOnProgrammeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated short course on programme",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Error updating short course on programme"
          }
        }
      }
    },
    "/{learningKey}/shortCourses/{episodeKey}": {
      "get": {
        "summary": "Get Short Course",
        "operationId": "getShortCourse",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved short course",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Error retrieving short course"
          }
        }
      },
      "delete": {
        "summary": "Remove Short Course Learning",
        "operationId": "removeShortCourseLearning",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "episodeKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "learnerKey",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "learnerRef",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully removed short course learning",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "500": {
            "description": "Error removing short course learning"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUnapprovedShortCourseLearningRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "EpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "Learner": {
            "$ref": "#/components/schemas/Learner"
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/OnProgramme"
          }
        },
        "required": [
          "LearningKey",
          "EpisodeKey",
          "Learner",
          "LearningSupport",
          "OnProgramme"
        ]
      },
      "Learner": {
        "type": "object",
        "properties": {
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          }
        },
        "required": [
          "DateOfBirth",
          "Uln"
        ]
      },
      "LearningSupportItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "StartDate",
          "EndDate"
        ]
      },
      "OnProgramme": {
        "type": "object",
        "properties": {
          "CourseCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Milestones": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "TotalPrice": {
            "type": "number"
          }
        },
        "required": [
          "CourseCode",
          "Ukprn",
          "StartDate",
          "ExpectedEndDate",
          "Milestones",
          "TotalPrice"
        ]
      },
      "UpdateShortCourseOnProgrammeRequest": {
        "type": "object",
        "properties": {
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "Milestones": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "ExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          },
          "LearnerKey": {
            "type": "string",
            "format": "uuid"
          },
          "LearnerRef": {
            "type": "string"
          }
        },
        "required": [
          "Milestones",
          "StartDate",
          "ExpectedEndDate",
          "LearnerKey",
          "LearnerRef"
        ]
      }
    }
  }
}
