{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Earnings API",
    "version": "1.0.0",
    "description": "API for retrieving provider earnings (fm36) data."
  },
  "paths": {
    "/{ukprn}/fm36/{collectionYear}/{collectionPeriod}": {
      "post": {
        "summary": "Gets the fm36 earnings for the provider",
        "description": "Retrieves data on provider earnings based on fm36 schema for a specific collection year and period.",
        "operationId": "GetFm36Earnings",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "collectionYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            }
          },
          {
            "name": "collectionPeriod",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int8"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with provider earnings data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFm36DataResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetFm36DataResponse": {
        "type": "object",
        "description": "Response object for fm36 data.",
        "properties": {}
      }
    }
  }
}
