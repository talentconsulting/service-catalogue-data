{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Earnings API",
    "version": "1.0.0",
    "description": "API for retrieving FM36 data on provider earnings."
  },
  "paths": {
    "/{ukprn}/fm36/{collectionYear}/{collectionPeriod}": {
      "post": {
        "summary": "Gets the FM36 earnings for the provider",
        "description": "Although this endpoint uses POST, it is used to retrieve data.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The UKPRN of the provider."
          },
          {
            "name": "collectionYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            },
            "description": "The collection year."
          },
          {
            "name": "collectionPeriod",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int8"
            },
            "description": "The collection period."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "description": "A list of learning keys (GUIDs) required for the FM36 data."
        },
        "responses": {
          "200": {
            "description": "Successful response containing the FM36 data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFm36DataResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetFm36DataResponse": {
        "type": "object",
        "description": "Response containing FM36 data for the provider.",
        "properties": {
          "data": {
            "type": "object",
            "additionalProperties": true,
            "description": "Dynamic structure containing FM36 earnings data."
          }
        }
      }
    }
  }
}
