{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Earnings API",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukprn}/fm36/{collectionYear}/{collectionPeriod}": {
      "post": {
        "summary": "Gets the FM36 earnings for the provider",
        "description": "Although this endpoint is a POST, it is used to retrieve FM36 data for a specified provider.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The UKPRN (UK Provider Reference Number) of the provider."
          },
          {
            "name": "collectionYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int16"
            },
            "description": "The collection year for the requested data."
          },
          {
            "name": "collectionPeriod",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int8"
            },
            "description": "The collection period for the requested data."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "description": "A list of learning keys (UUIDs) related to the provider's data."
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response containing FM36 earnings data.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFm36DataResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetFm36DataResponse": {
        "type": "object",
        "description": "The response payload containing the FM36 earnings data.",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  }
}
