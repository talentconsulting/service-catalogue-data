{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Earnings API",
    "description": "API for retrieving FM36 earnings for providers.",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukprn}/fm36/{collectionYear}/{collectionPeriod}": {
      "post": {
        "summary": "Gets the FM36 earnings for the provider",
        "description": "Although this endpoint is a POST, it is used to retrieve data.",
        "parameters": [
          {
            "name": "ukprn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The UKPRN of the provider."
          },
          {
            "name": "collectionYear",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The collection year for the FM36 data."
          },
          {
            "name": "collectionPeriod",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The collection period for the FM36 data."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          "description": "List of learning keys."
        },
        "responses": {
          "200": {
            "description": "The FM36 earnings data for the provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetFm36DataResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetFm36DataResponse": {
        "type": "object",
        "description": "The response containing FM36 earnings data.",
        "properties": {}
      }
    }
  }
}
