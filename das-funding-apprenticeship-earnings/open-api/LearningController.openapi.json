{
  "openapi": "3.1.0",
  "info": {
    "title": "LearningController API",
    "version": "1.0.0"
  },
  "paths": {
    "/learning": {
      "post": {
        "operationId": "CreateUnapprovedApprenticeshipLearning",
        "summary": "Create unapproved apprenticeship learning.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnapprovedApprenticeshipLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created unapproved apprenticeship learning."
          },
          "500": {
            "description": "Error occurred while creating unapproved apprenticeship learning."
          }
        }
      }
    },
    "/learning/{learningKey}/learning-support": {
      "put": {
        "operationId": "UpdateLearningSupport",
        "summary": "Update learning support for an apprenticeship.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprenticeship learning."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLearningSupportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated learning support."
          },
          "500": {
            "description": "Error occurred while updating learning support."
          }
        }
      }
    },
    "/learning/{learningKey}/english-and-maths": {
      "put": {
        "operationId": "SaveMathsAndEnglish",
        "summary": "Update English and Maths for an apprenticeship.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprenticeship learning."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEnglishAndMathsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated English and Maths."
          },
          "500": {
            "description": "Error occurred while updating English and Maths."
          }
        }
      }
    },
    "/learning/{learningKey}/on-programme": {
      "put": {
        "operationId": "UpdateOnProgramme",
        "summary": "Update on-programme information for an apprenticeship.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprenticeship learning."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOnProgrammeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully updated on-programme information."
          },
          "500": {
            "description": "Error occurred while updating on-programme information."
          }
        }
      }
    },
    "/learning/{learningKey}": {
      "delete": {
        "operationId": "RemoveLearner",
        "summary": "Remove a learner from an apprenticeship.",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Unique identifier for the apprenticeship learning."
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully removed learner."
          },
          "500": {
            "description": "Error occurred while removing learner."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUnapprovedApprenticeshipLearningRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "EpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "ApprovalsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "Learner": {
            "$ref": "#/components/schemas/DraftApprenticeshipLearner"
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/DraftApprenticeshipOnProgramme"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "AchievementDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "Prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningEpisodePrice"
            }
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipPeriodInLearningItem"
            }
          },
          "EnglishAndMaths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftEnglishAndMathsItem"
            }
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          }
        },
        "required": [
          "LearningKey",
          "EpisodeKey",
          "ApprovalsApprenticeshipId",
          "Learner",
          "OnProgramme"
        ]
      },
      "DraftApprenticeshipLearner": {
        "type": "object",
        "properties": {
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "Care": {
            "$ref": "#/components/schemas/DraftCare"
          }
        },
        "required": [
          "DateOfBirth",
          "Uln",
          "Care"
        ]
      },
      "DraftCare": {
        "type": "object",
        "properties": {
          "HasEHCP": {
            "type": "boolean"
          },
          "IsCareLeaver": {
            "type": "boolean"
          },
          "CareLeaverEmployerConsentGiven": {
            "type": "boolean"
          }
        },
        "required": [
          "HasEHCP",
          "IsCareLeaver",
          "CareLeaverEmployerConsentGiven"
        ]
      },
      "DraftApprenticeshipOnProgramme": {
        "type": "object",
        "properties": {
          "TrainingCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "FundingEmployerAccountId": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "LegalEntityName": {
            "type": "string"
          },
          "EmployerType": {
            "$ref": "#/components/schemas/EmployerType"
          },
          "FundingBandMaximum": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "required": [
          "TrainingCode",
          "Ukprn",
          "EmployerAccountId",
          "LegalEntityName",
          "EmployerType"
        ]
      },
      "LearningEpisodePrice": {
        "type": "object",
        "additionalProperties": true
      },
      "ApprenticeshipPeriodInLearningItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "OriginalExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "StartDate",
          "OriginalExpectedEndDate"
        ]
      },
      "DraftEnglishAndMathsItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Course": {
            "type": "string"
          },
          "LearnAimRef": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          },
          "CombinedFundingAdjustmentPercentage": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipPeriodInLearningItem"
            }
          }
        },
        "required": [
          "StartDate",
          "EndDate",
          "Course",
          "LearnAimRef",
          "Amount"
        ]
      },
      "LearningSupportItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "StartDate",
          "EndDate"
        ]
      },
      "EmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      },
      "UpdateLearningSupportRequest": {
        "type": "object",
        "properties": {
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          }
        },
        "required": [
          "LearningSupport"
        ]
      },
      "UpdateEnglishAndMathsRequest": {
        "type": "object",
        "properties": {
          "EnglishAndMaths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishAndMathsItem"
            }
          }
        },
        "required": [
          "EnglishAndMaths"
        ]
      },
      "EnglishAndMathsItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Course": {
            "type": "string"
          },
          "LearnAimRef": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          },
          "CombinedFundingAdjustmentPercentage": {
            "type": "number",
            "format": "decimal",
            "nullable": true
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodInLearningItem"
            }
          }
        },
        "required": [
          "StartDate",
          "EndDate",
          "Course",
          "LearnAimRef",
          "Amount"
        ]
      },
      "PeriodInLearningItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "OriginalExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "StartDate",
          "OriginalExpectedEndDate"
        ]
      },
      "UpdateOnProgrammeRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipEpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "AchievementDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "FundingBandMaximum": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "IncludesFundingBandMaximumUpdate": {
            "type": "boolean"
          },
          "Prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningEpisodePrice"
            }
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodInLearningItem"
            }
          },
          "Care": {
            "$ref": "#/components/schemas/Care"
          }
        },
        "required": [
          "ApprenticeshipEpisodeKey",
          "DateOfBirth",
          "IncludesFundingBandMaximumUpdate"
        ]
      },
      "Care": {
        "type": "object",
        "properties": {
          "HasEHCP": {
            "type": "boolean"
          },
          "IsCareLeaver": {
            "type": "boolean"
          },
          "CareLeaverEmployerConsentGiven": {
            "type": "boolean"
          }
        },
        "required": [
          "HasEHCP",
          "IsCareLeaver",
          "CareLeaverEmployerConsentGiven"
        ]
      }
    }
  }
}
