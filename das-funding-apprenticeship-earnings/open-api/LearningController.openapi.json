{
  "openapi": "3.1.0",
  "info": {
    "title": "Apprenticeship Learning API",
    "version": "1.0.0"
  },
  "paths": {
    "/learning": {
      "post": {
        "summary": "Create Unapproved Apprenticeship Learning",
        "operationId": "CreateUnapprovedApprenticeshipLearning",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnapprovedApprenticeshipLearningRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Error"
          }
        }
      }
    },
    "/learning/{learningKey}/learning-support": {
      "put": {
        "summary": "Update Learning Support",
        "operationId": "UpdateLearningSupport",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateLearningSupportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Error"
          }
        }
      }
    },
    "/learning/{learningKey}/english-and-maths": {
      "put": {
        "summary": "Update English and Maths",
        "operationId": "SaveMathsAndEnglish",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEnglishAndMathsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Error"
          }
        }
      }
    },
    "/learning/{learningKey}/on-programme": {
      "put": {
        "summary": "Update On Program Learning",
        "operationId": "UpdateOnProgramme",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOnProgrammeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Error"
          }
        }
      }
    },
    "/learning/{learningKey}": {
      "delete": {
        "summary": "Remove Learner",
        "operationId": "RemoveLearner",
        "parameters": [
          {
            "name": "learningKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "500": {
            "description": "Error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateUnapprovedApprenticeshipLearningRequest": {
        "type": "object",
        "properties": {
          "LearningKey": {
            "type": "string",
            "format": "uuid"
          },
          "EpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "ApprovalsApprenticeshipId": {
            "type": "integer",
            "format": "int64"
          },
          "Learner": {
            "$ref": "#/components/schemas/DraftApprenticeshipLearner"
          },
          "OnProgramme": {
            "$ref": "#/components/schemas/DraftApprenticeshipOnProgramme"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "AchievementDate": {
            "type": "string",
            "format": "date-time"
          },
          "Prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningEpisodePrice"
            }
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipPeriodInLearningItem"
            }
          },
          "EnglishAndMaths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DraftEnglishAndMathsItem"
            }
          },
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          }
        }
      },
      "DraftApprenticeshipLearner": {
        "type": "object",
        "properties": {
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "Uln": {
            "type": "string"
          },
          "Care": {
            "$ref": "#/components/schemas/DraftCare"
          }
        }
      },
      "DraftApprenticeshipOnProgramme": {
        "type": "object",
        "properties": {
          "TrainingCode": {
            "type": "string"
          },
          "Ukprn": {
            "type": "integer",
            "format": "int64"
          },
          "EmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "FundingEmployerAccountId": {
            "type": "integer",
            "format": "int64"
          },
          "LegalEntityName": {
            "type": "string"
          },
          "EmployerType": {
            "$ref": "#/components/schemas/EmployerType"
          },
          "FundingBandMaximum": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "EmployerType": {
        "type": "string",
        "enum": [
          "NonLevy",
          "Levy"
        ]
      },
      "LearningSupportItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LearningEpisodePrice": {
        "type": "object"
      },
      "ApprenticeshipPeriodInLearningItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "OriginalExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DraftCare": {
        "type": "object",
        "properties": {
          "HasEHCP": {
            "type": "boolean"
          },
          "IsCareLeaver": {
            "type": "boolean"
          },
          "CareLeaverEmployerConsentGiven": {
            "type": "boolean"
          }
        }
      },
      "DraftEnglishAndMathsItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Course": {
            "type": "string"
          },
          "LearnAimRef": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          },
          "CombinedFundingAdjustmentPercentage": {
            "type": "number",
            "format": "decimal"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprenticeshipPeriodInLearningItem"
            }
          }
        }
      },
      "UpdateLearningSupportRequest": {
        "type": "object",
        "properties": {
          "LearningSupport": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningSupportItem"
            }
          }
        }
      },
      "UpdateEnglishAndMathsRequest": {
        "type": "object",
        "properties": {
          "EnglishAndMaths": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnglishAndMathsItem"
            }
          }
        }
      },
      "EnglishAndMathsItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "Course": {
            "type": "string"
          },
          "LearnAimRef": {
            "type": "string"
          },
          "Amount": {
            "type": "number",
            "format": "decimal"
          },
          "CombinedFundingAdjustmentPercentage": {
            "type": "number",
            "format": "decimal"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodInLearningItem"
            }
          }
        }
      },
      "PeriodInLearningItem": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          },
          "OriginalExpectedEndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateOnProgrammeRequest": {
        "type": "object",
        "properties": {
          "ApprenticeshipEpisodeKey": {
            "type": "string",
            "format": "uuid"
          },
          "CompletionDate": {
            "type": "string",
            "format": "date-time"
          },
          "WithdrawalDate": {
            "type": "string",
            "format": "date-time"
          },
          "PauseDate": {
            "type": "string",
            "format": "date-time"
          },
          "AchievementDate": {
            "type": "string",
            "format": "date-time"
          },
          "DateOfBirth": {
            "type": "string",
            "format": "date-time"
          },
          "FundingBandMaximum": {
            "type": "integer",
            "format": "int32"
          },
          "IncludesFundingBandMaximumUpdate": {
            "type": "boolean"
          },
          "Prices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LearningEpisodePrice"
            }
          },
          "PeriodsInLearning": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PeriodInLearningItem"
            }
          },
          "Care": {
            "$ref": "#/components/schemas/Care"
          }
        }
      },
      "Care": {
        "type": "object",
        "properties": {
          "HasEHCP": {
            "type": "boolean"
          },
          "IsCareLeaver": {
            "type": "boolean"
          },
          "CareLeaverEmployerConsentGiven": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
