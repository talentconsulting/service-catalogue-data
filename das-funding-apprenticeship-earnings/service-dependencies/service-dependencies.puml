@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
LAYOUT_WITH_LEGEND()

System_Boundary(sys_SkillsFundingAgency_das_funding_apprenticeship_earnings, "Funding Apprenticeship Earnings") {
  Container(c_funding_apprenticeship_earnings, "Funding Apprenticeship Earnings", "API")
  Container(c_funding_apprenticeship_earnings_messagehandlers, "Funding Apprenticeship Earnings MessageHandlers", "Background Job")
}

System_Ext(d_cloud_service_application_insights, "Application Insights", "Azure")
System_Ext(d_cloud_service_azure_table_storage, "Azure Table Storage", "Azure")
SystemDb_Ext(d_database_apprenticeship_earnings_db, "Apprenticeship Earnings DB", "Entity Framework Core / SQL Server")
System_Ext(d_http_api_earnings_outer, "Earnings Outer", "HttpClient")
System_Ext(d_http_api_earnings_outer_api, "Earnings Outer API", "HttpClient")
SystemQueue_Ext(d_message_broker_azure_service_bus, "Azure Service Bus", "NServiceBus / Azure Service Bus")
SystemQueue_Ext(d_message_broker_nservicebus, "NServiceBus")

Rel(c_funding_apprenticeship_earnings_messagehandlers, d_cloud_service_application_insights, "Uses", "Azure")
Rel(c_funding_apprenticeship_earnings_messagehandlers, d_cloud_service_azure_table_storage, "Uses", "Azure")
Rel(c_funding_apprenticeship_earnings, d_database_apprenticeship_earnings_db, "Reads from and writes to", "Entity Framework Core / SQL Server")
Rel(c_funding_apprenticeship_earnings_messagehandlers, d_database_apprenticeship_earnings_db, "Reads from and writes to", "SQL Server")
Rel(c_funding_apprenticeship_earnings_messagehandlers, d_http_api_earnings_outer, "Calls the API of", "HttpClient")
Rel(c_funding_apprenticeship_earnings, d_http_api_earnings_outer_api, "Calls the API of", "HttpClient")
Rel(c_funding_apprenticeship_earnings, d_message_broker_azure_service_bus, "Publishes messages to and consumes messages from", "NServiceBus / Azure Service Bus")
Rel(c_funding_apprenticeship_earnings_messagehandlers, d_message_broker_nservicebus, "Publishes messages to and consumes messages from")

@enduml
