{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/signout": {
      "get": {
        "operationId": "signOutEmployer",
        "summary": "Sign out employer account",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful sign-out operation"
          }
        }
      }
    },
    "/signout": {
      "get": {
        "operationId": "signOutProvider",
        "summary": "Sign out provider account",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful sign-out operation"
          }
        }
      }
    },
    "/service/signout": {
      "get": {
        "operationId": "serviceSignOut",
        "summary": "Sign out from service",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful sign-out operation"
          }
        }
      }
    },
    "/p-signed-out": {
      "get": {
        "operationId": "providerSignedOut",
        "summary": "Provider signed out page",
        "responses": {
          "200": {
            "description": "Signed out or redirected to dashboard"
          }
        }
      }
    },
    "/signoutcleanup": {
      "post": {
        "operationId": "signOutCleanup",
        "summary": "Cleanup after sign out",
        "responses": {
          "204": {
            "description": "Sign-out cleanup completed"
          }
        }
      }
    },
    "/{employerAccountId}/service/password/change": {
      "get": {
        "operationId": "changePassword",
        "summary": "Redirect for employer password change",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to employer index"
          }
        }
      }
    },
    "/{employerAccountId}/service/email/change": {
      "get": {
        "operationId": "changeEmail",
        "summary": "Redirect for employer email change",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to employer index"
          }
        }
      }
    },
    "/{ukPrn}/notAvailable": {
      "get": {
        "operationId": "providerFeatureNotAvailable",
        "summary": "Feature not available for provider",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Displays feature not available page"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/notAvailable": {
      "get": {
        "operationId": "employerFeatureNotAvailable",
        "summary": "Feature not available for employer",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Displays feature not available page"
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "operationId": "dashboardRedirect",
        "summary": "Redirect to dashboard",
        "responses": {
          "301": {
            "description": "Permanent redirect to dashboard URL"
          }
        }
      }
    },
    "/SignIn-Stub": {
      "get": {
        "operationId": "signinStubPage",
        "summary": "Displays a stub sign-in page in debug mode",
        "responses": {
          "200": {
            "description": "Debug stub sign-in view loaded"
          }
        }
      },
      "post": {
        "operationId": "signinStub",
        "summary": "Handles stub sign-in in debug mode",
        "responses": {
          "302": {
            "description": "Redirects after stub sign-in"
          }
        }
      }
    },
    "/signed-in-stub": {
      "get": {
        "operationId": "signedInStub",
        "summary": "Displays signed-in stub in debug mode",
        "responses": {
          "200": {
            "description": "Signed-in stub view loaded"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "employerAccountId": {
            "type": "string"
          }
        },
        "required": [
          "employerAccountId"
        ]
      },
      "StubAuthUserDetails": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string",
            "format": "email"
          },
          "Id": {
            "type": "string"
          }
        },
        "required": [
          "Email",
          "Id"
        ]
      },
      "AutoSignOutViewModel": {
        "type": "object",
        "properties": {
          "DashboardUrl": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "DashboardUrl"
        ]
      }
    }
  }
}
