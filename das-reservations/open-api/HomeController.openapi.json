{
  "openapi": "3.1.0",
  "info": {
    "title": "DAS Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/signout": {
      "get": {
        "operationId": "employerSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully signed out"
          }
        }
      }
    },
    "/signout": {
      "get": {
        "operationId": "providerSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully signed out"
          }
        }
      }
    },
    "/service/signout": {
      "get": {
        "operationId": "serviceSignOut",
        "parameters": [
          {
            "name": "autoSignOut",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successfully signed out"
          }
        }
      }
    },
    "/p-signed-out": {
      "get": {
        "operationId": "providerSignedOut",
        "responses": {
          "200": {
            "description": "Provider signed out screen or redirect",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/signoutcleanup": {
      "get": {
        "operationId": "signOutCleanup",
        "responses": {
          "204": {
            "description": "Cookies cleaned up"
          }
        }
      }
    },
    "/{employerAccountId}/service/password/change": {
      "get": {
        "operationId": "employerChangePassword",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to employer index"
          }
        }
      }
    },
    "/{employerAccountId}/service/email/change": {
      "get": {
        "operationId": "employerChangeEmail",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "userCancelled",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to employer index"
          }
        }
      }
    },
    "/{ukPrn}/notAvailable": {
      "get": {
        "operationId": "providerFeatureNotAvailable",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider feature not available view",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/accounts/{employerAccountId}/notAvailable": {
      "get": {
        "operationId": "employerFeatureNotAvailable",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer feature not available view",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "responses": {
          "308": {
            "description": "Permanent redirect to dashboard URL"
          }
        }
      }
    },
    "/SignIn-Stub": {
      "get": {
        "description": "Available only in DEBUG mode",
        "operationId": "signinStubGet",
        "responses": {
          "200": {
            "description": "Stub sign-in view",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "description": "Available only in DEBUG mode",
        "operationId": "signinStubPost",
        "responses": {
          "302": {
            "description": "Redirect to signed-in stub route"
          }
        }
      }
    },
    "/signed-in-stub": {
      "get": {
        "description": "Requires authorization. Available only in DEBUG mode.",
        "operationId": "signedInStub",
        "responses": {
          "200": {
            "description": "Signed-in stub view",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AutoSignOutViewModel": {
        "type": "object",
        "properties": {
          "DashboardUrl": {
            "type": "string"
          }
        }
      },
      "ReservationsRouteModel": {
        "type": "object"
      },
      "StubAuthUserDetails": {
        "type": "object",
        "properties": {
          "Email": {
            "type": "string"
          },
          "Id": {
            "type": "string"
          }
        }
      }
    }
  }
}
