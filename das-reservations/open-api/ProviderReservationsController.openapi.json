{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukPrn}/reservations": {
      "get": {
        "tags": [
          "ProviderReservations"
        ],
        "summary": "Provider Reservations Index",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to start route or view result."
          }
        },
        "security": [
          {
            "HasProviderAccount": [],
            "HasProviderContributorOrHigherOrIsEmployer": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/start": {
      "get": {
        "tags": [
          "ProviderReservations"
        ],
        "summary": "Start Provider Reservations Workflow",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "isFromManage",
            "in": "query",
            "required": true,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Provider reservations start view.",
            "content": {
              "text/html": {}
            }
          }
        },
        "security": [
          {
            "HasProviderAccount": [],
            "HasProviderContributorOrHigherOrIsEmployer": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/choose-employer": {
      "get": {
        "tags": [
          "ProviderReservations"
        ],
        "summary": "Choose Employer for Reservation",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "reverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Choose employer view.",
            "content": {
              "text/html": {}
            }
          },
          "400": {
            "description": "Bad request if ukPrn is invalid."
          }
        },
        "security": [
          {
            "HasProviderAccount": [],
            "HasProviderContributorOrHigherOrIsEmployer": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/choose-employer-search": {
      "get": {
        "tags": [
          "ProviderReservations"
        ],
        "summary": "Search Employers for Reservation",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of matching employer names.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request if ukPrn is invalid."
          }
        },
        "security": [
          {
            "HasProviderAccount": [],
            "HasProviderContributorOrHigherOrIsEmployer": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/confirm-employer/{id}": {
      "get": {
        "tags": [
          "ProviderReservations"
        ],
        "summary": "Confirm Employer for Reservation",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Confirmation view.",
            "content": {
              "text/html": {}
            }
          }
        },
        "security": [
          {
            "HasProviderAccount": [],
            "HasProviderContributorOrHigherOrIsEmployer": []
          }
        ]
      },
      "post": {
        "tags": [
          "ProviderReservations"
        ],
        "summary": "Process Confirmation of Employer",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmEmployerViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirect to next steps or return to employer selection."
          },
          "400": {
            "description": "Invalid data provided in the confirmation form."
          }
        },
        "security": [
          {
            "HasProviderAccount": [],
            "HasProviderContributorOrHigherOrIsEmployer": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/employer-agreement-not-signed/{id}": {
      "get": {
        "tags": [
          "ProviderReservations"
        ],
        "summary": "View Unsigned Employer Agreement",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "AccountLegalEntityPublicHashedId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "View showing details of unsigned agreements.",
            "content": {
              "text/html": {}
            }
          }
        },
        "security": [
          {
            "HasProviderAccount": [],
            "HasProviderContributorOrHigherOrIsEmployer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmEmployerViewModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "uint32"
          },
          "AccountPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "Confirm": {
            "type": "boolean",
            "nullable": true
          },
          "Id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        }
      },
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "uint32",
            "nullable": true
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FromReview": {
            "type": "boolean",
            "nullable": true
          },
          "IsFromManage": {
            "type": "boolean",
            "nullable": true
          },
          "IsFromSelect": {
            "type": "boolean",
            "nullable": true
          },
          "PreviousPage": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "uint32",
            "nullable": true
          },
          "JourneyData": {
            "type": "string"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortField": {
            "type": "string"
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "UseLearnerData": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "HasProviderAccount": {
        "type": "http",
        "scheme": "bearer"
      },
      "HasProviderContributorOrHigherOrIsEmployer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
