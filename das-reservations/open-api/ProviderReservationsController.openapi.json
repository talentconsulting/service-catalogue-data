{
  "openapi": "3.1.0",
  "info": {
    "title": "Provider Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukPrn}/reservations": {
      "get": {
        "summary": "Provider Reservations Index",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "IsFromManage",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/{ukPrn}/reservations/start": {
      "get": {
        "summary": "Start Provider Reservation Process",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "isFromManage",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/{ukPrn}/reservations/choose-employer": {
      "get": {
        "summary": "Choose Employer",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/{ukPrn}/reservations/choose-employer-search": {
      "get": {
        "summary": "Search Employers",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/{ukPrn}/reservations/confirm-employer/{id}": {
      "get": {
        "summary": "Confirm Employer",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      },
      "post": {
        "summary": "Process Confirm Employer",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmEmployerViewModel"
              }
            }
          }
        },
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          },
          "400": {
            "description": "Validation failure"
          }
        }
      }
    },
    "/{ukPrn}/reservations/employer-agreement-not-signed/{id}": {
      "get": {
        "summary": "Employer Agreement Not Signed",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "AccountLegalEntityPublicHashedId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "IsFromSelect",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "PreviousPage",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmEmployerViewModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "uint32"
          },
          "AccountPublicHashedId": {
            "type": "string"
          },
          "AccountName": {
            "type": "string"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "Confirm": {
            "type": "boolean"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "UkPrn"
        ]
      },
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "uint32"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FromReview": {
            "type": "boolean"
          },
          "IsFromManage": {
            "type": "boolean"
          },
          "IsFromSelect": {
            "type": "boolean"
          },
          "PreviousPage": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "uint32"
          },
          "JourneyData": {
            "type": "string"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortField": {
            "type": "string"
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "UseLearnerData": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
