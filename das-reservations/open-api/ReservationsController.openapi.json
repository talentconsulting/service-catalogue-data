  "components": {
    "schemas": {
      "ApprenticeshipTrainingFormModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "description": "The start date of apprenticeship training.",
            "example": "01/01/2023"
          },
          "SelectedCourseId": {
            "type": "string",
            "description": "The ID of the selected course."
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string",
            "description": "The public hashed ID for the account legal entity."
          },
          "CohortRef": {
            "type": "string",
            "description": "Cohort reference for training."
          },
          "FromReview": {
            "type": "boolean",
            "description": "Indicates whether the reservation is from a review phase."
          }
        },
        "required": [
          "StartDate",
          "SelectedCourseId"
        ]
      },
      "FundingRestrictionNotificationViewModel": {
        "type": "object",
        "properties": {
          "RuleId": {
            "type": "integer"
          },
          "TypeOfRule": {
            "type": "string",
            "enum": [
              "None",
              "CourseRule",
              "GlobalRule"
            ]
          },
          "RestrictionStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "BackLink": {
            "type": "string"
          },
          "RouteName": {
            "type": "string"
          },
          "IsProvider": {
            "type": "boolean"
          },
          "PostRouteName": {
            "type": "string"
          },
          "MarkRuleAsRead": {
            "type": "boolean"
          }
        }
      }
    }
