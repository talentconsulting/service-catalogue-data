{
  "openapi": "3.1.0",
  "info": {
    "title": "ReservationsController API",
    "version": "1.0.0",
    "description": "API for managing reservations and related operations for employers and providers."
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/{id}/select-course-rule-check": {
      "get": {
        "operationId": "SelectCourseRuleCheckEmployer",
        "summary": "Handles course rule check for employer reservations.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the employer's account."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the next step in the employer reservation journey."
          }
        }
      }
    },
    "/{ukPrn}/reservations/{id}/select-course-rule-check": {
      "get": {
        "operationId": "SelectCourseRuleCheckProvider",
        "summary": "Handles course rule check for provider reservations.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The UK Provider Reference Number (UKPRN)."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirects to the next step in the provider reservation journey."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/saveRuleNotificationChoice": {
      "post": {
        "operationId": "SaveRuleNotificationChoiceEmployerNoReservation",
        "summary": "Handles saving rule notification choice for employer without reservation ID.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the employer's account."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FundingRestrictionNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the provided route from the view model."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/saveRuleNotificationChoice": {
      "post": {
        "operationId": "SaveRuleNotificationChoiceEmployer",
        "summary": "Handles saving rule notification choice for employer with reservation.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "The ID of the employer's account."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FundingRestrictionNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the provided route from the view model."
          }
        }
      }
    },
    "/{ukPrn}/reservations/saveRuleNotificationChoice": {
      "post": {
        "operationId": "SaveRuleNotificationChoiceProviderNoReservation",
        "summary": "Handles saving rule notification choice for provider without reservation ID.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The UK Provider Reference Number (UKPRN)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FundingRestrictionNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the provided route from the view model."
          }
        }
      }
    },
    "/{ukPrn}/reservations/{id}/saveRuleNotificationChoice": {
      "post": {
        "operationId": "SaveRuleNotificationChoiceProvider",
        "summary": "Handles saving rule notification choice for provider with reservation.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            },
            "description": "The UK Provider Reference Number (UKPRN)."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FundingRestrictionNotificationViewModel"
              }
            }
          }
        },
        "responses": {
          "302": {
            "description": "Redirects to the provided route from the view model."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FundingRestrictionNotificationViewModel": {
        "type": "object",
        "properties": {
          "RuleId": {
            "type": "integer",
            "format": "int64"
          },
          "TypeOfRule": {
            "type": "string",
            "enum": [
              "None",
              "CourseRule",
              "GlobalRule"
            ]
          },
          "RestrictionStartDate": {
            "type": "string",
            "format": "date-time"
          },
          "BackLink": {
            "type": "string"
          },
          "RouteName": {
            "type": "string"
          },
          "IsProvider": {
            "type": "boolean"
          },
          "PostRouteName": {
            "type": "string"
          },
          "MarkRuleAsRead": {
            "type": "boolean"
          }
        }
      },
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "int32"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FromReview": {
            "type": "boolean"
          },
          "IsFromManage": {
            "type": "boolean"
          },
          "IsFromSelect": {
            "type": "boolean"
          },
          "PreviousPage": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "int32"
          },
          "JourneyData": {
            "type": "string"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortField": {
            "type": "string"
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "UseLearnerData": {
            "type": "boolean"
          }
        }
      },
      "CompletedViewModel": {
        "type": "object",
        "properties": {
          "WhatsNext": {
            "type": "string",
            "enum": [
              "Homepage",
              "RecruitAnApprentice",
              "AddAnApprentice",
              "FindApprenticeshipTraining"
            ]
          },
          "TrainingDateDescription": {
            "type": "string"
          },
          "CourseDescription": {
            "type": "string"
          },
          "LearningType": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "CourseId": {
            "type": "string"
          },
          "UkPrn": {
            "type": "integer",
            "format": "int32"
          },
          "CohortRef": {
            "type": "string"
          },
          "JourneyData": {
            "type": "string"
          },
          "UseLearnerData": {
            "type": "boolean"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FindApprenticeshipTrainingUrl": {
            "type": "string"
          },
          "AddAnApprenticeUrl": {
            "type": "string"
          },
          "HomepageUrl": {
            "type": "string"
          },
          "RecruitUrl": {
            "type": "string"
          }
        }
      },
      "ApprenticeshipTrainingFormModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "description": "Start date of the apprenticeship training.",
            "example": "2023-10-01"
          },
          "SelectedCourseId": {
            "type": "string",
            "description": "The ID of the selected course."
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string",
            "description": "Hash ID of the account legal entity."
          },
          "CohortRef": {
            "type": "string",
            "description": "Reference to the cohort."
          },
          "FromReview": {
            "type": "boolean",
            "description": "Indicates whether the user comes from the review step."
          }
        },
        "required": [
          "StartDate",
          "SelectedCourseId"
        ]
      },
      "TrainingDateModel": {
        "type": "object",
        "properties": {
          "StartDate": {
            "type": "string",
            "format": "date-time"
          },
          "EndDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
