{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/start": {
      "get": {
        "summary": "Start the reservation process for an employer.",
        "operationId": "EmployerStart",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation successful."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/select-legal-entity/{id}": {
      "get": {
        "summary": "Select a legal entity for an employer's reservation.",
        "operationId": "EmployerSelectLegalEntityGet",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation successful."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "summary": "Submit the selected legal entity.",
        "operationId": "EmployerSelectLegalEntityPost",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation successful."
          },
          "400": {
            "description": "Bad request."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/select-course": {
      "get": {
        "summary": "Select an apprenticeship course for a reservation.",
        "operationId": "EmployerSelectCourseGet",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation successful."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "summary": "Submit the selected course.",
        "operationId": "EmployerSelectCoursePost",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostSelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation successful."
          },
          "400": {
            "description": "Bad request."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/course-guidance": {
      "get": {
        "summary": "Retrieve guidance for selecting a course.",
        "operationId": "EmployerCourseGuidance",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Operation successful."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "LegalEntity": {
            "type": "string",
            "description": "The selected legal entity for the employer."
          }
        },
        "required": [
          "LegalEntity"
        ]
      },
      "PostSelectCourseViewModel": {
        "type": "object",
        "properties": {
          "SelectedCourseId": {
            "type": "string",
            "description": "The ID of the selected apprenticeship course."
          },
          "ApprenticeTrainingKnown": {
            "type": "boolean",
            "description": "Whether or not the apprentice training program is known."
          }
        },
        "required": [
          "ApprenticeTrainingKnown"
        ]
      }
    }
  }
}
