{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/start": {
      "get": {
        "operationId": "EmployerStart",
        "summary": "Start the employer reservation process.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cohortReference",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The start page for employer reservation.",
            "content": {
              "text/html": {}
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/select-legal-entity/{id}": {
      "get": {
        "operationId": "EmployerSelectLegalEntity",
        "summary": "Select a legal entity for reservation.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Select legal entity page.",
            "content": {
              "text/html": {}
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "operationId": "PostEmployerSelectLegalEntity",
        "summary": "Submit selected legal entity for reservation.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Legal entity selection confirmation."
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/select-course": {
      "get": {
        "operationId": "EmployerSelectCourse",
        "summary": "Select a course for the reservation.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "in": "query",
            "name": "fromReview",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Select course page.",
            "content": {
              "text/html": {}
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "operationId": "PostEmployerSelectCourse",
        "summary": "Submit selected course for the reservation.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostSelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Course selection confirmation."
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/course-guidance": {
      "get": {
        "operationId": "EmployerCourseGuidance",
        "summary": "View guidance for selecting courses.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course guidance page.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/owner-sign-agreement": {
      "get": {
        "operationId": "EmployerOwnerSignAgreement",
        "summary": "Employer owner sign agreement page.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer owner sign agreement page.",
            "content": {
              "text/html": {}
            }
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/transactor-sign-agreement": {
      "get": {
        "operationId": "EmployerTransactorSignAgreement",
        "summary": "Employer transactor sign agreement page.",
        "parameters": [
          {
            "in": "path",
            "name": "employerAccountId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employer transactor sign agreement page.",
            "content": {
              "text/html": {}
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "LegalEntity": {
            "type": "string"
          }
        },
        "required": [
          "LegalEntity"
        ]
      },
      "PostSelectCourseViewModel": {
        "type": "object",
        "properties": {
          "SelectedCourseId": {
            "type": "string"
          },
          "ApprenticeTrainingKnown": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "ApprenticeTrainingKnown"
        ]
      }
    }
  }
}
