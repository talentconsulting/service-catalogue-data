{
  "openapi": "3.1.0",
  "info": {
    "title": "Employer Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{EmployerAccountId}/reservations/start": {
      "get": {
        "summary": "Start employer reservation process",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{EmployerAccountId}/reservations/select-legal-entity/{Id}": {
      "get": {
        "summary": "Select legal entity for reservation",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Post selected legal entity for reservation",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Id",
            "in": "path",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfirmLegalEntityViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success response"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/accounts/{EmployerAccountId}/reservations/{Id}/select-course": {
      "get": {
        "summary": "Select a course for reservation",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response"
          }
        }
      },
      "post": {
        "summary": "Post selected course for reservation",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostSelectCourseViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success response"
          }
        }
      }
    },
    "/accounts/{EmployerAccountId}/reservations/{Id}/course-guidance": {
      "get": {
        "summary": "View course guidance page",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response"
          }
        }
      }
    },
    "/accounts/{EmployerAccountId}/reservations/owner-sign-agreement": {
      "get": {
        "summary": "Redirect owner to sign agreement",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response"
          }
        }
      }
    },
    "/accounts/{EmployerAccountId}/reservations/transactor-sign-agreement": {
      "get": {
        "summary": "Redirect transactor to sign agreement",
        "parameters": [
          {
            "name": "EmployerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success response"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConfirmLegalEntityViewModel": {
        "type": "object",
        "properties": {
          "LegalEntity": {
            "type": "string"
          }
        },
        "required": [
          "LegalEntity"
        ]
      },
      "PostSelectCourseViewModel": {
        "type": "object",
        "properties": {
          "SelectedCourseId": {
            "type": "string"
          },
          "ApprenticeTrainingKnown": {
            "type": "boolean"
          }
        },
        "required": [
          "ApprenticeTrainingKnown"
        ]
      },
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "uint32"
          },
          "EmployerAccountId": {
            "type": "string"
          },
          "PublicHashedEmployerAccountId": {
            "type": "string"
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "AccountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "FromReview": {
            "type": "boolean"
          },
          "IsFromManage": {
            "type": "boolean"
          },
          "IsFromSelect": {
            "type": "boolean"
          },
          "PreviousPage": {
            "type": "string"
          },
          "CohortReference": {
            "type": "string"
          },
          "ProviderId": {
            "type": "integer",
            "format": "uint32"
          },
          "JourneyData": {
            "type": "string"
          },
          "SearchTerm": {
            "type": "string"
          },
          "SortField": {
            "type": "string"
          },
          "ReverseSort": {
            "type": "boolean"
          },
          "UseLearnerData": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
