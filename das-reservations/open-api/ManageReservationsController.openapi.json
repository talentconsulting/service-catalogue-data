{
  "openapi": "3.1.0",
  "info": {
    "title": "Manage Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/manage": {
      "get": {
        "operationId": "EmployerManage",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a view for managing employer reservations."
          }
        },
        "security": [
          {
            "HasEmployerViewerUserRoleOrIsProvider": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/manage": {
      "get": {
        "operationId": "ProviderManage",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "searchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedCourse",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedEmployer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedStartDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "selectedLearningType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "pageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a view for managing provider reservations."
          },
          "403": {
            "description": "Provider not authorized."
          }
        },
        "security": [
          {
            "HasProviderGotViewerOrHigherRoleOrIsEmployer": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/{id}/delete": {
      "get": {
        "operationId": "ProviderDelete",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns a view for deleting a provider reservation."
          },
          "400": {
            "description": "Bad request, reservation ID missing."
          }
        },
        "security": [
          {
            "HasProviderGotContributorOrHigherRoleOrIsEmployer": []
          },
          {
            "HasProviderOrEmployerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "PostProviderDelete",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reservation was successfully deleted."
          },
          "400": {
            "description": "Validation error or bad request."
          },
          "500": {
            "description": "Server error occurred."
          }
        },
        "security": [
          {
            "HasProviderGotContributorOrHigherRoleOrIsEmployer": []
          },
          {
            "HasProviderOrEmployerAccount": []
          }
        ]
      }
    },
