  "components": {
    "schemas": {
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "ukPrn": {
            "type": "integer",
            "nullable": true,
            "description": "Provider unique reference number."
          },
          "employerAccountId": {
            "type": "string",
            "nullable": true,
            "description": "Employer account ID."
          },
          "publicHashedEmployerAccountId": {
            "type": "string",
            "nullable": true,
            "description": "Public hashed employer account ID."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true,
            "description": "Reservation ID."
          },
          "accountLegalEntityPublicHashedId": {
            "type": "string",
            "nullable": true,
            "description": "Public hashed ID for the account legal entity."
          },
          "fromReview": {
            "type": "boolean",
            "nullable": true,
            "description": "Flag indicating if navigation came from review."
          },
          "isFromManage": {
            "type": "boolean",
            "nullable": true,
            "description": "Flag indicating if navigation came from manage page."
          },
          "isFromSelect": {
            "type": "boolean",
            "nullable": true,
            "description": "Flag indicating if navigation came from select page."
          },
          "previousPage": {
            "type": "string",
            "nullable": true,
            "description": "Previous page visited."
          },
          "cohortReference": {
            "type": "string",
            "nullable": true,
            "description": "Reference for the cohort."
          },
          "providerId": {
            "type": "integer",
            "nullable": true,
            "description": "Provider ID query parameter."
          },
          "journeyData": {
            "type": "string",
            "nullable": true,
            "description": "Additional journey data."
          },
          "searchTerm": {
            "type": "string",
            "nullable": true,
            "description": "Search term."
          },
          "sortField": {
            "type": "string",
            "nullable": true,
            "description": "Field to sort results by."
          },
          "reverseSort": {
            "type": "boolean",
            "nullable": false,
            "description": "Flag indicating if results should be sorted in reverse order."
          },
          "useLearnerData": {
            "type": "boolean",
            "nullable": true,
            "description": "Flag indicating whether to use learner data."
          }
        },
        "description": "Reservations route model."
      },
      "DeleteViewModel": {
        "type": "object",
        "properties": {
          "ukPrn": {
            "type": "integer",
            "nullable": true,
            "description": "Provider unique reference number."
          },
          "delete": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates if the item should be deleted."
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Reservation ID."
          },
          "startDateDescription": {
            "type": "string",
            "nullable": true,
            "description": "Description of the start date."
          },
          "courseDescription": {
            "type": "string",
            "nullable": true,
            "description": "Course description."
          },
          "accountLegalEntityName": {
            "type": "string",
            "nullable": true,
            "description": "Name of the legal entity associated with the account."
          },
          "learningType": {
            "type": "string",
            "nullable": true,
            "description": "Type of learning."
          }
        },
        "description": "Delete reservation view model."
      },
      "DeleteCompletedViewModel": {
        "type": "object",
        "properties": {
          "manage": {
            "type": "boolean",
            "nullable": true,
            "description": "Indicates next user action after deletion."
          }
        },
        "description": "Delete completed view model."
      }
    },
    "securitySchemes": {
      "HasEmployerViewerUserRoleOrIsProvider": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization for employer viewer user role or provider."
      },
      "HasProviderGotViewerOrHigherRoleOrIsEmployer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization for provider viewer or higher role or employer."
      },
      "HasProviderGotContributorOrHigherRoleOrIsEmployer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization for provider contributor or higher role or employer."
      },
      "HasProviderOrEmployerAccount": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authorization for provider or employer account."
      }
    }
  }
