            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reservation was successfully deleted."
          },
          "400": {
            "description": "Validation error or bad request."
          },
          "500": {
            "description": "Server error occurred."
          }
        },
        "security": [
          {
            "HasProviderGotContributorOrHigherRoleOrIsEmployer": []
