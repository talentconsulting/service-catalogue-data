{
  "openapi": "3.1.0",
  "info": {
    "title": "Manage Reservations API",
    "version": "1.0.0",
    "description": "API for managing apprenticeship reservations."
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/manage": {
      "get": {
        "operationId": "EmployerManage",
        "summary": "Manage reservations for an employer account.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the reservations management view."
          }
        }
      }
    },
    "/{ukPrn}/reservations/manage": {
      "get": {
        "operationId": "ProviderManage",
        "summary": "Manage reservations for a provider.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "CohortReference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "SortField",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ReverseSort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the provider reservations management view."
          },
          "403": {
            "description": "Provider not authorized to view manage page."
          }
        }
      }
    },
    "/{ukPrn}/reservations/{id}/delete": {
      "get": {
        "operationId": "ProviderDelete",
        "summary": "Prepare provider reservation for deletion.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the delete reservation view."
          }
        }
      },
      "post": {
        "operationId": "PostProviderDelete",
        "summary": "Delete a provider reservation.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reservation deleted successfully."
          },
          "400": {
            "description": "Validation error trying to delete the reservation."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/delete": {
      "get": {
        "operationId": "EmployerDelete",
        "summary": "Prepare employer reservation for deletion.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the delete reservation view."
          }
        }
      },
      "post": {
        "operationId": "PostEmployerDelete",
        "summary": "Delete an employer reservation.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Reservation deleted successfully."
          },
          "400": {
            "description": "Validation error trying to delete the reservation."
          }
        }
      }
    },
    "/{ukPrn}/reservations/{id}/delete-completed": {
      "post": {
        "operationId": "PostProviderDeleteCompleted",
        "summary": "Post deletion actions for provider reservation.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteCompletedViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post-deletion action processed successfully."
          }
        }
      },
      "get": {
        "operationId": "ProviderDeleteCompleted",
        "summary": "Delete completed view for provider.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the provider delete completed view."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{id}/delete-completed": {
      "post": {
        "operationId": "PostEmployerDeleteCompleted",
        "summary": "Post deletion actions for employer reservation.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteCompletedViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post-deletion action processed successfully."
          }
        }
      },
      "get": {
        "operationId": "EmployerDeleteCompleted",
        "summary": "Delete completed view for employer.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the employer delete completed view."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeleteViewModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "uint32",
            "nullable": true
          },
          "Delete": {
            "type": "boolean",
            "nullable": true
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "StartDateDescription": {
            "type": "string"
          },
          "CourseDescription": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DeleteCompletedViewModel": {
        "type": "object",
        "properties": {
          "Manage": {
            "type": "boolean",
            "nullable": true
          }
        },
        "required": [
          "Manage"
        ]
      }
    }
  }
}
