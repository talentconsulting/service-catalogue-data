  "components": {
    "schemas": {
      "DeleteViewModel": {
        "type": "object",
        "properties": {
          "UkPrn": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "Delete": {
            "type": "boolean",
            "nullable": true
          },
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "StartDateDescription": {
            "type": "string"
          },
          "CourseDescription": {
            "type": "string"
          },
          "AccountLegalEntityName": {
            "type": "string"
          },
          "LearningType": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DeleteCompletedViewModel": {
        "type": "object",
        "properties": {
          "Manage": {
            "type": "boolean",
            "nullable": true
          }
        }
      }
    },
    "securitySchemes": {
      "HasEmployerViewerUserRoleOrIsProvider": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://example.com/auth"
      },
      "HasProviderGotViewerOrHigherRoleOrIsEmployer": {
        "type": "openIdConnect",
