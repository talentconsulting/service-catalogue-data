{
  "openapi": "3.1.0",
  "info": {
    "title": "Manage Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/accounts/{employerAccountId}/reservations/manage": {
      "get": {
        "operationId": "EmployerManageReservations",
        "summary": "Get the manage reservations page for employer.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Employer account ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "HasEmployerViewerUserRoleOrIsProvider": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/manage": {
      "get": {
        "operationId": "ProviderManageReservations",
        "summary": "Get the manage reservations page for provider.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider unique reference number."
          },
          {
            "name": "SearchTerm",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Search term for filtering reservations."
          },
          {
            "name": "SelectedCourse",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Selected course for filtering reservations."
          },
          {
            "name": "SelectedEmployer",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Selected employer for filtering reservations."
          },
          {
            "name": "SelectedStartDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Selected start date for filtering reservations."
          },
          {
            "name": "PageNumber",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Page number for pagination."
          },
          {
            "name": "SelectedLearningType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "Selected learning type for filtering reservations."
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          },
          "403": {
            "description": "Provider does not have permissions to view manage reservations."
          }
        },
        "security": [
          {
            "HasProviderGotViewerOrHigherRoleOrIsEmployer": []
          }
        ]
      }
    },
    "/{ukPrn}/reservations/{id}/delete": {
      "get": {
        "operationId": "ProviderDeleteReservation",
        "summary": "Delete a reservation for a provider.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider unique reference number."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Reservation ID."
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "security": [
          {
            "HasProviderGotContributorOrHigherRoleOrIsEmployer": []
          },
          {
            "HasProviderOrEmployerAccount": []
          }
        ]
      },
      "post": {
        "operationId": "ProviderDeleteReservationPost",
        "summary": "Submit delete action for a reservation linked to a provider.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Provider unique reference number."
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Reservation ID."
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteViewModel"
              }
            }
          },
          "required": true
        },
        "responses": {
          "302": {
            "description": "Redirects to a different route after processing the delete action."
          },
          "400": {
            "description": "Validation error occurred."
          },
          "500": {
            "description": "Error occurred while processing the delete action."
          }
        },
        "security": [
          {
            "HasProviderGotContributorOrHigherRoleOrIsEmployer": []
          }
        ]
      }
    },
