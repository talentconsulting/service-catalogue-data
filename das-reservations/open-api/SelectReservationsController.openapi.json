  "components": {
    "schemas": {
      "ReservationsRouteModel": {
        "type": "object",
        "properties": {
          "ukPrn": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "employerAccountId": {
            "type": "string"
          },
          "publicHashedEmployerAccountId": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "accountLegalEntityPublicHashedId": {
            "type": "string"
          },
          "fromReview": {
            "type": "boolean",
            "nullable": true
          },
          "isFromManage": {
            "type": "boolean",
            "nullable": true
          },
          "isFromSelect": {
            "type": "boolean",
            "nullable": true
          },
          "previousPage": {
            "type": "string"
          },
          "cohortReference": {
            "type": "string",
            "nullable": true
          },
          "providerId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "journeyData": {
            "type": "string",
            "nullable": true
          },
          "searchTerm": {
            "type": "string",
            "nullable": true
          },
          "sortField": {
            "type": "string",
            "nullable": true
          },
          "reverseSort": {
            "type": "boolean"
          },
          "useLearnerData": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "SelectReservationViewModel": {
        "type": "object",
        "properties": {
          "cohortReference": {
            "type": "string",
            "nullable": true
          },
          "transferSenderId": {
            "type": "string",
            "nullable": true
          },
          "encodedPledgeApplicationId": {
            "type": "string",
            "nullable": true
          },
          "journeyData": {
            "type": "string",
            "nullable": true
          },
          "selectedReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "availableReservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailableReservationViewModel"
            }
          },
          "accountId": {
            "type": "integer",
            "format": "int64"
          },
          "backLink": {
            "type": "string"
          },
          "providerId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "moreReservationsAvailable": {
            "type": "boolean"
          },
          "apprenticeshipSessionKey": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "beforeProviderSelected": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "AvailableReservationViewModel": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "courseDescription": {
            "type": "string"
          },
          "trainingDateDescription": {
            "type": "string"
          },
          "createdDateDescription": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "HasProviderOrEmployerAccount": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
