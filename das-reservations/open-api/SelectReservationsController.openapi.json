{
  "openapi": "3.1.0",
  "info": {
    "title": "Select Reservations API",
    "version": "1.0.0",
    "description": "API for selecting reservations for employers and providers, supporting various operations related to reservations."
  },
  "paths": {
    "/{ukPrn}/reservations/{accountLegalEntityPublicHashedId}/select": {
      "get": {
        "summary": "Get reservation selection for providers",
        "operationId": "getProviderReservationSelection",
        "security": [
          {
            "HasProviderOrEmployerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "journeyData",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "useLearnerData",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response with reservation selection details.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SelectReservationViewModel"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden: access denied."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "summary": "Post reservation selection for providers",
        "operationId": "postProviderReservationSelection",
        "security": [
          {
            "HasProviderOrEmployerAccount": []
          }
        ],
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32",
              "nullable": true
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cohortReference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "providerId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "journeyData",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "useLearnerData",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "description": "Reservation selection and details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectReservationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully processed reservation selection."
          },
          "403": {
            "description": "Forbidden: access denied."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
