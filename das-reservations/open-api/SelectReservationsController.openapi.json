{
  "openapi": "3.1.0",
  "info": {
    "title": "Reservations API",
    "version": "1.0.0"
  },
  "paths": {
    "/{ukPrn}/reservations/{accountLegalEntityPublicHashedId}/select": {
      "get": {
        "tags": [
          "Reservations"
        ],
        "summary": "Select a reservation",
        "description": "Endpoint to select a reservation for providers.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "description": "The unique identifier for the provider.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "description": "The hashed ID of the account legal entity.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation selection page content"
          },
          "403": {
            "description": "Forbidden due to lack of permissions."
          },
          "404": {
            "description": "Not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "tags": [
          "Reservations"
        ],
        "summary": "Submit a selected reservation",
        "description": "Endpoint to submit the selected reservation for providers.",
        "parameters": [
          {
            "name": "ukPrn",
            "in": "path",
            "required": true,
            "description": "The unique identifier for the provider.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "description": "The hashed ID of the account legal entity.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectReservationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully submitted reservation selection."
          },
          "400": {
            "description": "Invalid request."
          },
          "403": {
            "description": "Forbidden due to lack of permissions."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    },
    "/accounts/{employerAccountId}/reservations/{accountLegalEntityPublicHashedId}/select": {
      "get": {
        "tags": [
