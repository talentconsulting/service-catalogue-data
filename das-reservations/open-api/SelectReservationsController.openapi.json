              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "description": "The hashed ID of the account legal entity.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Reservation selection page content"
          },
          "403": {
            "description": "Forbidden due to lack of permissions."
          },
          "404": {
            "description": "Not found."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      },
      "post": {
        "tags": [
          "Reservations"
        ],
        "summary": "Submit a selected reservation",
        "description": "Endpoint to submit the selected reservation for employers.",
        "parameters": [
          {
            "name": "employerAccountId",
            "in": "path",
            "required": true,
            "description": "The unique identifier for the employer account.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accountLegalEntityPublicHashedId",
            "in": "path",
            "required": true,
            "description": "The hashed ID of the account legal entity.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SelectReservationViewModel"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully submitted reservation selection."
          },
          "400": {
            "description": "Invalid request."
          },
          "403": {
            "description": "Forbidden due to lack of permissions."
          },
          "500": {
            "description": "Internal server error."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SelectReservationViewModel": {
        "type": "object",
        "properties": {
          "CohortReference": {
            "type": "string",
            "nullable": true
          },
          "TransferSenderId": {
            "type": "string",
            "nullable": true
          },
          "EncodedPledgeApplicationId": {
            "type": "string",
            "nullable": true
          },
          "JourneyData": {
            "type": "string",
            "nullable": true
          },
          "SelectedReservationId": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "AvailableReservations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailableReservationViewModel"
            },
            "nullable": true
          },
          "AccountId": {
            "type": "integer",
            "format": "int64"
          },
          "BackLink": {
            "type": "string",
            "nullable": true
          },
          "ProviderId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "MoreReservationsAvailable": {
            "type": "boolean"
          },
          "ApprenticeshipSessionKey": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "BeforeProviderSelected": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "AvailableReservationViewModel": {
        "type": "object",
        "properties": {
          "ReservationId": {
            "type": "string",
            "format": "uuid"
          },
          "CourseDescription": {
            "type": "string",
            "nullable": true
          },
          "TrainingDateDescription": {
            "type": "string",
            "nullable": true
          },
          "CreatedDateDescription": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
